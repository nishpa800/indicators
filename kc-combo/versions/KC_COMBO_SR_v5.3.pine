//@version=5
// TIME-CHART build (twin: kc-combo/tick_friendly/KC_COMBO_SR_TICKFRIENDLY_v5.3.pine).
// [v5.3 2026-08-20] KCC REQUIREMENT (operator order 2026-08-20, /goal): EVERY one of the 28 VPs now
//   requires FAUNA (same-side atom: sigFAUNABull / sigFAUNABear, FABLE QUAD v1.4 engine verbatim, in-study)
//   AND the candle body >= Min Body % of its high-low range (new IPSF kcc_bodyPctMin, default 75.0).
//   Gate = kccReqB / kccReqR AND-ed onto every sig_ boolean at its source, so VP, alertcondition and
//   alert() inherit it 1:1:1 (no lane fires without FAUNA + body). Read on the marked candle bar[0]
//   (all 28 dp offset 0). Unit count unchanged: 28 dp x 2 + 0 plot() + 8 alertcondition = 64/64.
// [v5.2 2026-08-14] +4 STRUCTURE+R+FAUNA lanes (operator order 2026-08-14): FLR.F / 2F.F
//   (bull) and ROOF.F / PH.F (bear) = structure atom + RVOL tier menu + ANY R-lane + FAUNA,
//   all on the same confirmed candle. 28 dp × 2 + 0 plot() + 8 alertcondition = 64/64 EXACT.
//   Visual-identity fix: PH+A was sharing flag/top with 2F+A (v5.1 defect) → triangledown/top.
// [v5.0 2026-08-11] KC COMBO SR — BULL+BEAR MERGED SINGLE STUDY (operator order 2026-08-11).
// ╔════════════════════════════════════════════════════════════════════════╗
// ║  KC COMBO SR v5.0 — BULL+BEAR IN ONE STUDY — 24 dp — chart_domain=time
// ║  Built from KC COMBO BULL v4.7.1 + KC COMBO BEAR v4.7.1 (byte-proven
// ║  shared engine base; side-specific slices carried verbatim from each).
// ║  KEEP-LIST (operator checkbox screenshots 2026-08-11) — 12 dp per side:
// ║  H.A, UC.A, SA.A/KR.A, 1X.A, GS.A/MB.A, N.A, HW.A (7 +ANY SR lanes),
// ║  R1/R2/R3 (coalescence window default 1 = same candle), FLR+A & 2F+A /
// ║  ROOF+A & PH+A (structure +ANY SR). ALL OTHER v4.7.1 LANES (12 MAIN
// ║  RS+RC combos, CS1.A, CS2.A, M.A, CC.A, A, 2+, 3+) ARE CALCULATION-ONLY:
// ║  their sig_ booleans and every engine remain byte-intact (the ANY SR
// ║  union that powers every kept lane is cnt>=1 over the 12 MAIN sig_),
// ║  but they render NO visual plot and emit NO alert.
// ║  ANY-SCOPING LAW (operator 2026-08-11): every ANY name token in this
// ║  study is the SR-scoped ANY and reads "+ANY SR" on every name surface.
// ║  UNIT LAW (TRUE TV LAW, proven by RE10140 integers 65/83 on 2026-08-12):
// ║  units = 2×(plotshape with text) + plot() + alertcondition. THIS STUDY:
// ║  28 dp × 2 + 0 plot() + 8 alertcondition = 64/64 EXACT. ZERO plot() lines BY LAW
// ║  (operator order 2026-08-12): NO diagnostic/count/readout/band plot()
// ║  lines EVER — KC bands, combo counts, DISP/HV/RVOL readout plots all
// ║  REMOVED in v5.1; the DISP/HV/RVOL numbers still ride in the alert() text.
// ║  R-LANE VAR SUFFIX: B = bull, R = bear (rbsJB/rbsJR, sig_r1B/sig_r1R…).
// ║  L-61 GRAPHIC-OBJECT INVENTORY: 0 (zero label/line/box/table/polyline).
// ║  OFFSET REGISTRY: all dp offset=0. Colors: bare #hex consts, COLOR=SIDE
// ║  (bull cool / bear hot), styles verbatim from each side's v4.7.1 build.
// ╚════════════════════════════════════════════════════════════════════════╝
import TradingView/ta/7 as tv_ta
indicator("KC COMBO SR (28 dp, BULL+BEAR, +ANY SR) v5.3", shorttitle="KCCSR28v53", overlay=true, max_bars_back=5000)
// ============================================================================
// SHARED — confirmed-bar gate
// ============================================================================
conf = barstate.isconfirmed

// ============================================================================
// INPUTS — OKEH Zoo Engine  (defaults preserved verbatim from PBJ PB CONSOL)
// ============================================================================
grp_eng = "OKEH — Zoo Engine"
zoo_ma_type   = input.string("VWMA", "Base MA Type", options=["VWMA","EMA","SMA","WMA","HMA"], group=grp_eng)
zoo_ma_len    = input.int(5, "Base MA Length", minval=1, group=grp_eng)
zoo_price_src = input.source(close, "Price Source", group=grp_eng)

grp_pbj_filter = "OKEH — PB&J Filter"
zoo_pbj_ma_period   = input.int(20,   "MA Period",          minval=1,  group=grp_pbj_filter)
zoo_pbj_atr_period  = input.int(14,   "ATR Period",         minval=1,  group=grp_pbj_filter)
zoo_pbj_hh_ll       = input.int(25,   "HH/LL Lookback",     minval=1,  group=grp_pbj_filter)
zoo_pbj_atr_mult    = input.float(3.0,"ATR Multiplier",     step=0.1,  group=grp_pbj_filter)
zoo_pbj_vol_period  = input.int(20,   "Volume MA Period",   minval=1,  group=grp_pbj_filter)
zoo_pbj_vol_mult    = input.float(0.1,"Volume Multiplier",  step=0.1,  group=grp_pbj_filter)

grp_st = "OKEH — Supertrend"
zoo_use_st    = input.bool(true,  "Apply ATR Supertrend", group=grp_st)
zoo_st_period = input.int(10,     "ATR Period",           group=grp_st)
zoo_st_mult   = input.float(2.0,  "Multiplier",           group=grp_st)

group_kc_indicator  = "KC: Indicator Settings"
string kc_maType     = input.string("EMA", "MA Type", options=["SMA", "EMA", "HMA", "VWMA", "LSMA"], group=group_kc_indicator)
int    kc_length     = input.int(20, "MA Length", minval=1, group=group_kc_indicator)
float  kc_mult       = input.float(2.0, "Multiplier", minval=0.001, group=group_kc_indicator)
kc_src               = input.source(close, "Source", group=group_kc_indicator)
string kc_bandsStyle = input.string("Average True Range", "Bands Style", options=["Average True Range", "True Range", "Range"], group=group_kc_indicator)
int    kc_atrLength  = input.int(10, "ATR Length", minval=1, group=group_kc_indicator)

group_kc_slope_calc = "KC: Slope Calculation Settings"
int   kc_slopeLookbackBars     = input.int(3, "Slope Lookback Bars", minval=1, group=group_kc_slope_calc)
float kc_bullishSlopeThreshold = input.float(title="Bullish Slope Threshold", defval=0.05, step=0.001, group=group_kc_slope_calc)
float kc_bearishSlopeThreshold = input.float(title="Bearish Slope Threshold", defval=0.05, step=0.001, group=group_kc_slope_calc)

grp_pp = "Pocket Pivot (PUP / PPD)"
barSize    = input.float(3.0, "% Change (Barsize)", minval=0.1, step=0.1, group=grp_pp)
ppLookback = input.int(10, "Lookback Days", minval=1, group=grp_pp)

grp_disp = "Displacement MEMBER engine (the D in combo names; NOT the per-dp gate)"
disp_type   = input.string("Open to Close", "Range Type", options=["Open to Close","High to Low"], group=grp_disp)
disp_len    = input.int(100, "Std Dev Length", minval=1, group=grp_disp)
disp_mult   = input.float(4.5, "Std Dev Multiplier (member D)", minval=0.1, step=0.1, group=grp_disp)

// ============================================================================
// ENGINE — Zoo Moving Average  (verbatim)
// ============================================================================
f_ma(src, len, t) =>
    switch t
        "EMA"  => ta.ema(src, len)
        "SMA"  => ta.sma(src, len)
        "WMA"  => ta.wma(src, len)
        "HMA"  => ta.hma(src, len)
        "VWMA" => ta.vwma(src, len)
        => ta.sma(src, len)

float base_ma = f_ma(zoo_price_src, zoo_ma_len, zoo_ma_type)

// ============================================================================
// ENGINE — Supertrend  (verbatim)
// ============================================================================
float st_atr     = zoo_st_mult * ta.atr(zoo_st_period)
float dyn_long   = base_ma - st_atr
float dyn_short  = base_ma + st_atr

var int st_dir   = 1
float sig_line   = 0.0
float curr_long  = 0.0
curr_long  := base_ma > nz(curr_long[1], dyn_long)   ? math.max(dyn_long, nz(curr_long[1]))   : dyn_long
float curr_short = 0.0
curr_short := base_ma < nz(curr_short[1], dyn_short) ? math.min(dyn_short, nz(curr_short[1])) : dyn_short

if zoo_use_st
    if nz(st_dir[1]) == -1 and zoo_price_src > nz(curr_short[1])
        st_dir := 1
    else if nz(st_dir[1]) == 1 and zoo_price_src < nz(curr_long[1])
        st_dir := -1
    sig_line := st_dir == 1 ? curr_long : curr_short
else
    sig_line := base_ma

// ============================================================================
// ENGINE — Crossovers & Re-acceleration  (verbatim)
// ============================================================================
bool buy_cross    = ta.crossover(zoo_price_src, sig_line)
bool sell_cross   = ta.crossunder(zoo_price_src, sig_line)
bool is_rising    = sig_line > nz(sig_line[1])
bool is_falling   = sig_line < nz(sig_line[1])
bool bull_reaccel = st_dir == 1  and is_rising  and nz(sig_line[1]) == nz(sig_line[2])
bool bear_reaccel = st_dir == -1 and is_falling and nz(sig_line[1]) == nz(sig_line[2])

// ============================================================================
// ENGINE — PB&J Filter  (verbatim)
// ============================================================================
float pbj_ma  = ta.ema(close, zoo_pbj_ma_period)
float pbj_atr = ta.atr(zoo_pbj_atr_period)
float avg_vol = ta.sma(volume, zoo_pbj_vol_period)
float thresh  = close == 0 ? 0 : (pbj_atr / close * zoo_pbj_atr_mult)

bool pbj_buy  = low  < pbj_ma * (1 - thresh) and low  == ta.lowest(low, zoo_pbj_hh_ll)   and volume > avg_vol * zoo_pbj_vol_mult
bool pbj_sell = high > pbj_ma * (1 + thresh) and high == ta.highest(high, zoo_pbj_hh_ll) and volume > avg_vol * zoo_pbj_vol_mult

// ============================================================================
// ENGINE — Level Management (PB zones)  (verbatim)
// ============================================================================
type lvl
    float upper
    float lower
    float vol
    bool  approached

float atr_pb = ta.atr(14) * 2.0

var bull_lvls = array.new<lvl>()
var bear_lvls = array.new<lvl>()

f_add_lvl(arr, up, lo, v) =>
    if math.abs(up - lo) >= syminfo.mintick
        array.push(arr, lvl.new(up, lo, v, false))

f_add_lander(is_bull, cross, arr) =>
    if cross
        float up = 0.0
        float lo = 0.0
        if is_bull
            up := math.max(open[1], close[1])
            lo := low[1]
            if up - lo < atr_pb * 0.5
                up := lo + atr_pb * 0.5
        else
            up := high[1]
            lo := math.min(open[1], close[1])
            if up - lo < atr_pb * 0.5
                lo := up - atr_pb * 0.5
        f_add_lvl(arr, up, lo, volume[1])

f_add_reaccel(is_bull, sig, arr) =>
    if sig and not na(sig_line)
        float p1 = sig_line
        float p2 = is_bull ? math.min(open, close) : math.max(open, close)
        f_add_lvl(arr, math.max(p1, p2), math.min(p1, p2), volume)

f_check_approach(arr, is_bull) =>
    bool approached = false
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            if i >= array.size(arr)
                continue
            l = array.get(arr, i)
            if is_bull and close < l.lower
                array.remove(arr, i)
                continue
            if not is_bull and close > l.upper
                array.remove(arr, i)
                continue
            float ap = is_bull ? l.upper * 1.005 : l.lower * 0.995
            if is_bull
                if not l.approached and low <= ap
                    approached := true
                    l.approached := true
                else if l.approached and low > l.upper
                    l.approached := false
            else
                if not l.approached and high >= ap
                    approached := true
                    l.approached := true
                else if l.approached and high < l.lower
                    l.approached := false
    approached

f_add_lander(true,  buy_cross,  bull_lvls)
f_add_lander(false, sell_cross, bear_lvls)
f_add_reaccel(true,  bull_reaccel, bull_lvls)
f_add_reaccel(false, bear_reaccel, bear_lvls)

var bool wait_buy      = false
var bool wait_sell     = false
var bool wait_pbj_buy  = false
var bool wait_pbj_sell = false

if barstate.isconfirmed
    if f_check_approach(bull_lvls, true)
        wait_buy := true
    if f_check_approach(bear_lvls, false)
        wait_sell := true

if pbj_buy
    wait_pbj_buy := true
if pbj_sell
    wait_pbj_sell := true

while array.size(bull_lvls) > 30
    array.shift(bull_lvls)
while array.size(bear_lvls) > 30
    array.shift(bear_lvls)

bool pre_pb_buy   = buy_cross and wait_buy
bool pre_pbj_buy  = buy_cross and wait_pbj_buy
bool pre_pb_sell  = sell_cross and wait_sell
bool pre_pbj_sell = sell_cross and wait_pbj_sell

if pre_pb_buy
    wait_buy     := false
if pre_pbj_buy
    wait_pbj_buy := false
if pre_pb_sell
    wait_sell     := false
if pre_pbj_sell
    wait_pbj_sell := false

bool sigBullPB  = barstate.isconfirmed and pre_pb_buy and not pre_pbj_buy
bool sigBullPBJ = barstate.isconfirmed and pre_pbj_buy
bool sigBearPB  = barstate.isconfirmed and pre_pb_sell and not pre_pbj_sell
bool sigBearPBJ = barstate.isconfirmed and pre_pbj_sell

// ============================================================================
// ENGINE — KC Basis and Bands  (KC Rev 8, verbatim)
// ============================================================================
kc_ma = switch kc_maType
    "SMA"  => ta.sma(kc_src, kc_length)
    "EMA"  => ta.ema(kc_src, kc_length)
    "HMA"  => ta.hma(kc_src, kc_length)
    "VWMA" => ta.vwma(kc_src, kc_length)
    "LSMA" => ta.linreg(kc_src, kc_length, 0)

kc_range_val = switch kc_bandsStyle
    "True Range"         => ta.tr(true)
    "Average True Range" => ta.atr(kc_atrLength)
    => ta.rma(high - low, kc_length)

kc_upper = kc_ma + kc_range_val * kc_mult
kc_lower = kc_ma - kc_range_val * kc_mult

kc_cross_above_basis      = ta.crossover(kc_src, kc_ma)
kc_cross_below_basis      = ta.crossunder(kc_src, kc_ma)
kc_reentry_from_above     = ta.crossunder(kc_src, kc_upper)
kc_reentry_from_below     = ta.crossover(kc_src, kc_lower)

kc_current_slope           = kc_ma - kc_ma[1]
kc_prior_trend_change      = kc_ma[1] - kc_ma[kc_slopeLookbackBars]
kc_midline_bullish_signal  = kc_current_slope > kc_bullishSlopeThreshold and kc_prior_trend_change < (kc_bullishSlopeThreshold / 2)
kc_midline_bearish_signal  = kc_current_slope < (-kc_bearishSlopeThreshold) and kc_prior_trend_change > (-kc_bearishSlopeThreshold / 2)

var waiting_for_bearish_cross = false
var waiting_for_bullish_cross = false

if kc_reentry_from_above
    waiting_for_bearish_cross := true
if kc_cross_above_basis
    waiting_for_bearish_cross := false
bearish_reentry_cross_signal = waiting_for_bearish_cross and kc_cross_below_basis
if bearish_reentry_cross_signal
    waiting_for_bearish_cross := false

if kc_reentry_from_below
    waiting_for_bullish_cross := true
if kc_cross_below_basis
    waiting_for_bullish_cross := false
bullish_reentry_cross_signal = waiting_for_bullish_cross and kc_cross_above_basis
if bullish_reentry_cross_signal
    waiting_for_bullish_cross := false

var waiting_for_slope_bearish = false
var waiting_for_slope_bullish = false

if kc_reentry_from_above
    waiting_for_slope_bearish := true
bearish_reentry_slope_signal = waiting_for_slope_bearish and kc_midline_bearish_signal
if bearish_reentry_slope_signal
    waiting_for_slope_bearish := false

if kc_reentry_from_below
    waiting_for_slope_bullish := true
bullish_reentry_slope_signal = waiting_for_slope_bullish and kc_midline_bullish_signal
if bullish_reentry_slope_signal
    waiting_for_slope_bullish := false

// DEVIATION-1 (disclosed): source master toggles showReentryCrosses/Slopes REMOVED —
// per-dp VP checkboxes are the ONLY visibility control in this study.
bool sigBullReCross = bullish_reentry_cross_signal
bool sigBearReCross = bearish_reentry_cross_signal
bool sigBullReSlope = bullish_reentry_slope_signal
bool sigBearReSlope = bearish_reentry_slope_signal

// ============================================================================
// ENGINE — Pocket Pivot (PUP / PPD)  (verbatim; master toggles removed, DEVIATION-2)
// ============================================================================
float redVol = close < open ? volume : 0.0
float greenVol = close > open ? volume : 0.0
float hiRedVol = ta.highest(redVol[1], ppLookback)
float hiGreenVol = ta.highest(greenVol[1], ppLookback)

bool priceUp = ((close - open) / open) * 100 > barSize
bool priceDn = ((open - close) / open) * 100 > barSize
bool volBull = volume > hiRedVol
bool volBear = volume > hiGreenVol

bool sPPBull = priceUp and volBull
bool sPPBear = priceDn and volBear

bool sigPUP = conf and sPPBull
bool sigPPD = conf and sPPBear

// ============================================================================
// ENGINE — Displacement MEMBER (the D in combo names; verbatim S11/S12 FVG form)
// ============================================================================
float disp_rng = disp_type == "Open to Close" ? math.abs(open - close) : high - low
float disp_std = ta.stdev(disp_rng, disp_len)
float disp_thresh = disp_std * disp_mult
bool  disp_prevDisp = disp_rng[1] > disp_thresh[1]
bool  disp_bullFVG  = low > high[2] and close[1] > open[1]
bool  disp_bearFVG  = high < low[2] and close[1] < open[1]

bool sigDispBull = conf and disp_prevDisp and disp_bullFVG
bool sigDispBear = conf and disp_prevDisp and disp_bearFVG

// ============================================================================
// ENGINE — Nagasaki (all-time-high volume; HW SINGLE construction)
// ============================================================================
var float navMaxVolEver = 0.0
bool isNaga = conf and volume > navMaxVolEver
if conf
    navMaxVolEver := math.max(navMaxVolEver, volume)

// [v4.4] GATES REMOVED — per-dp HV/DISP gate functions deleted in totality
// (operator order 2026-07-27); lanes fire on raw combo membership alone.


// ═══ PORTED ENGINE — CCC v1 (verbatim slice) ═══
grp_align = "Unified Combo — Alignment"
grpRV = "── RVOL ──"
int rv_avgLen = input.int(30, "RVOL Avg Length", group=grpRV)
int rv_smaLen = input.int(20, "RVOL SMA Length", group=grpRV)
groupReg = "RVOL - Reg @ Time"
reg_anchorTimeframe = input.timeframe("", "Anchor Timeframe (blank = chart)", group=groupReg)
reg_length = input.int(30, "Length", minval=1, group=groupReg)
reg_adjustRealtime = input.bool(true, "Adjust Unconfirmed", group=groupReg)
groupHybrid = "Hybrid LONG 1-5"
hyb_autoDerive = input.bool(true, "★ Auto-derive ALL Long thresholds (RVOL 1x → 2x ladder)", group=groupHybrid, tooltip="When ON, the 15 Reg/Cum/Body inputs below are IGNORED and the Reg floors are auto-computed as a linear ladder from RVOL 1x (Long 5) up to 2× RVOL 1x (Long 1). When OFF, the manual values below are used.")
hyb_addReg1 = input.float(5.0, "Long 1 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd1")
hyb_addCum1 = input.float(3.0, "Long 1 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd1")
hyb_bodyRat1 = input.float(0.74, "Long 1 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
hyb_addReg2 = input.float(5.0, "Long 2 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd2")
hyb_addCum2 = input.float(3.0, "Long 2 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd2")
hyb_bodyRat2 = input.float(0.74, "Long 2 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
hyb_addReg3 = input.float(5.0, "Long 3 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd3")
hyb_addCum3 = input.float(3.0, "Long 3 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd3")
hyb_bodyRat3 = input.float(0.74, "Long 3 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
hyb_addReg4 = input.float(5.0, "Long 4 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd4")
hyb_addCum4 = input.float(3.0, "Long 4 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd4")
hyb_bodyRat4 = input.float(0.74, "Long 4 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
hyb_addReg5 = input.float(5.0, "Long 5 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd5")
hyb_addCum5 = input.float(3.0, "Long 5 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd5")
hyb_bodyRat5 = input.float(0.74, "Long 5 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
i_req_fvg = input.bool(true, "Require FVG for Displacement", group=grp_align, tooltip="Fauna's master-offset switch. ON (fauna default): moff=1 — Musashi's PUP/Whale/PBJ legs and the Musashi first-bar check read bar[1]; plot offset -1. OFF: moff=0, all offset-0.")
grp_hgz = "Unified Combo — GZ1 / HV FVG"
hgz_auto = input.bool(true, "Auto FVG Threshold", group=grp_hgz)
hgz_threshPct = input.float(2, "FVG Threshold %", minval=0, maxval=100, step=0.1, group=grp_hgz)
hgz_dist = input.int(12, "GZ1 Max Bar Distance", minval=1, maxval=200, group=grp_hgz)
grp_matrix = "Unified Combo — Matrix / Momentum"
neo_len = input.int(67, "Matrix Number Lookback", minval=1, group=grp_matrix)
float ls_reg1 = input.float(10.0, "Momentum 1 Reg Floor", minval=0.5, step=0.1, group=grp_matrix), float ls_cum1 = input.float(5.0, "Momentum 1 Cum Floor", minval=0.5, step=0.1, group=grp_matrix), float ls_body1 = input.float(0.69, "Momentum 1 Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=grp_matrix)
float ls_reg2 = input.float(8.0, "Momentum 2 Reg Floor", minval=0.5, step=0.1, group=grp_matrix), float ls_cum2 = input.float(4.0, "Momentum 2 Cum Floor", minval=0.5, step=0.1, group=grp_matrix), float ls_body2 = input.float(0.69, "Momentum 2 Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=grp_matrix)
grp_cs = "Unified Combo — Combo Sets"
cs_bodyPct_FVG = input.float(0.74, "Min Body% FVG", minval=0.0, maxval=1.0, step=0.05, group=grp_cs)
cs_bodyPct_MAT = input.float(0.74, "Min Body% Matrix", minval=0.0, maxval=1.0, step=0.05, group=grp_cs)
cs_inc_pentagon_FVG = input.bool(true, "Pentagon in FVG Sets", group=grp_cs)
cs_inc_pentagon_MAT = input.bool(true, "Pentagon in Matrix Sets", group=grp_cs)
int _tfSecRaw = timeframe.in_seconds(timeframe.period)
bool _isTickChart = str.endswith(timeframe.period, "T") or na(_tfSecRaw) or _tfSecRaw <= 0
int tfSec = _isTickChart ? 10 : _tfSecRaw

bool is_new_day = ta.change(time("D")) != 0
bool is_new_sess = is_new_day

float _gapSize = math.abs(open - close[1])
float _barRange = high - low
string _FIRST = not is_new_sess ? "NOT !!!" : (_gapSize <= _barRange ? "FIRST !!!" : "FIRST XXX")

f_add(string base, string part) => base == "" ? part : base + " + " + part

// ENGINE: RVOL 0.56 (Pre-Mythos)
float rv_spike = math.abs(close - open)
float rv_avgSpike = ta.sma(rv_spike, rv_avgLen)[1]
float rv_normPrice = rv_spike / nz(rv_avgSpike, 1.0)
float rv_avgVol = ta.sma(volume, rv_avgLen)[1]
float rv_normVol = volume / nz(rv_avgVol, 1.0)
float rv_diff = rv_normPrice - rv_normVol
float rv_posDiff = rv_diff > 0 ? rv_diff : na
float rv_smaDiff = ta.sma(rv_posDiff, rv_smaLen)
bool rv_baseBull = (close > open) and (rv_posDiff > rv_smaDiff) and conf
bool rv_baseBear = (close < open) and (rv_posDiff > rv_smaDiff) and conf
f_th_1x(int _s) => _s <= 10 ? 38.0 : _s <= 15 ? 33.0 : _s <= 30 ? 28.0 : _s <= 45 ? 23.0 : _s <= 60 ? 20.0 : _s <= 120 ? 18.0 : _s <= 300 ? 13.0 : _s <= 360 ? 13.0 : _s <= 540 ? 11.0 : _s <= 600 ? 10.0 : _s <= 660 ? 9.0 : _s <= 900 ? 7.5 : _s <= 1560 ? 6.5 : _s <= 2340 ? 6.0 : _s <= 3600 ? 4.5 : _s <= 9000 ? 4.0 : _s <= 11700 ? 3.5 : _s < 259200 ? 1.8 : 1.0
f_th_gs(int _s) => _s < 60 ? f_th_1x(_s) * 3.0 : _s <= 300 ? 35.0 : _s <= 600 ? 25.0 : _s <= 1500 ? 20.0 : _s <= 3000 ? 20.0 : _s <= 7260 ? 10.0 : _s <= 11700 ? 8.0 : _s <= 86400 ? 7.5 : _s <= 259200 ? 3.5 : 3.0
f_th_saab(int _s) => f_th_1x(_s) * 0.56
f_th_wtc(int _s) => f_th_1x(_s) * 2.0
f_th_hiro(int _s) => _s < 60 ? f_th_1x(_s) * 3.0 : _s <= 300 ? 35.0 : _s <= 600 ? 25.0 : _s <= 1500 ? 25.0 : _s <= 3060 ? 20.0 : _s <= 7260 ? 10.0 : _s <= 11700 ? 8.0 : _s <= 86400 ? 7.5 : _s <= 259200 ? 5 : 3.5
float th_saab = f_th_saab(tfSec)
float th_1x = f_th_1x(tfSec)
float th_gs = f_th_gs(tfSec)
float th_wtc = f_th_wtc(tfSec)
float th_hiro = f_th_hiro(tfSec)
bool det_SAAB = rv_baseBull and rv_normPrice >= th_saab and rv_normPrice < th_1x
bool det_Kratos = rv_baseBear and rv_normPrice >= th_saab and rv_normPrice < th_1x
bool det_RVOL1xB = rv_baseBull and rv_normPrice >= th_1x and rv_normPrice < th_gs
bool det_RVOL1xR = rv_baseBear and rv_normPrice >= th_1x and rv_normPrice < th_gs
bool det_GrandSlam = rv_baseBull and rv_normPrice >= th_gs
bool det_MOAB = rv_baseBear and rv_normPrice >= th_gs

// ENGINE: RVOL REG @ TIME — WTC / Hiroshima
string reg_anchorSafe = ((reg_anchorTimeframe == "" and (str.endswith(timeframe.period, "T") or na(timeframe.in_seconds(timeframe.period)) or timeframe.in_seconds(timeframe.period) <= 0)) or str.endswith(reg_anchorTimeframe, "T")) ? "D" : reg_anchorTimeframe
[rv_curVol_reg, rv_pastVol_reg, _rv_u] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, true, reg_adjustRealtime)
float rv_relVolRatio = rv_curVol_reg / rv_pastVol_reg
bool det_WTC = conf and (rv_relVolRatio > th_wtc) and (rv_relVolRatio <= th_hiro)
bool det_Hiroshima = conf and (rv_relVolRatio > th_hiro)

// ENGINE: HYBRID MOMENTUM LONG 1-5 (feeds ls_regRatio / ls_cumRatio used by matrix Long/Short)
hybAutoReg5 = th_1x
hybAutoReg1 = th_1x * 2.0
hybAutoStep = (hybAutoReg1 - hybAutoReg5) / 4.0
hybAutoReg2 = hybAutoReg1 - 1.0 * hybAutoStep
hybAutoReg3 = hybAutoReg1 - 2.0 * hybAutoStep
hybAutoReg4 = hybAutoReg1 - 3.0 * hybAutoStep
float hybCumPhi = 1.398 * 1.33
hybAutoCum1 = hybCumPhi * math.sqrt(math.log(hybAutoReg1))
hybAutoCum2 = hybCumPhi * math.sqrt(math.log(hybAutoReg2))
hybAutoCum3 = hybCumPhi * math.sqrt(math.log(hybAutoReg3))
hybAutoCum4 = hybCumPhi * math.sqrt(math.log(hybAutoReg4))
hybAutoCum5 = hybCumPhi * math.sqrt(math.log(hybAutoReg5))
float hybAutoBody1 = 0.74
float hybAutoBody2 = 0.74
float hybAutoBody3 = 0.74
float hybAutoBody4 = 0.74
float hybAutoBody5 = 0.74
hybReg1Eff = hyb_autoDerive ? hybAutoReg1 : hyb_addReg1
hybReg2Eff = hyb_autoDerive ? hybAutoReg2 : hyb_addReg2
hybReg3Eff = hyb_autoDerive ? hybAutoReg3 : hyb_addReg3
hybReg4Eff = hyb_autoDerive ? hybAutoReg4 : hyb_addReg4
hybReg5Eff = hyb_autoDerive ? hybAutoReg5 : hyb_addReg5
hybCum1Eff = hyb_autoDerive ? hybAutoCum1 : hyb_addCum1
hybCum2Eff = hyb_autoDerive ? hybAutoCum2 : hyb_addCum2
hybCum3Eff = hyb_autoDerive ? hybAutoCum3 : hyb_addCum3
hybCum4Eff = hyb_autoDerive ? hybAutoCum4 : hyb_addCum4
hybCum5Eff = hyb_autoDerive ? hybAutoCum5 : hyb_addCum5
hybBody1Eff = hyb_autoDerive ? hybAutoBody1 : hyb_bodyRat1
hybBody2Eff = hyb_autoDerive ? hybAutoBody2 : hyb_bodyRat2
hybBody3Eff = hyb_autoDerive ? hybAutoBody3 : hyb_bodyRat3
hybBody4Eff = hyb_autoDerive ? hybAutoBody4 : hyb_bodyRat4
hybBody5Eff = hyb_autoDerive ? hybAutoBody5 : hyb_bodyRat5
[hybRegCur, hybRegPast, _hr] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, false, reg_adjustRealtime)
[hybCumCur, hybCumPast, _hc] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, true, reg_adjustRealtime)
hybRegRatio = hybRegCur / hybRegPast
hybCumRatio = hybCumCur / hybCumPast

moff = i_req_fvg ? 1 : 0
f_align(sig) => moff == 0 ? sig : sig[1]

// ══════════════════════════════════════════════════════════════════════════════
// [v4.5] PORTED ENGINES — FABLE QUAD v1.4 verbatim slices (Whale / FAUNA / GZ1 /
// Yin-Yang) feeding the HW.A heavy-weapons ANY-coincidence lane. DECLARED
// DEVIATIONS: (1) GZ1 mitigation render+prune block + its show-toggle removed
// (= locked to FQ default false; zero graphic objects, L-61); (2) engines
// compute both sides verbatim — this study consumes its own side only.
// ══════════════════════════════════════════════════════════════════════════════
bool anyBullPBJ = sigBullPBJ
bool anyBearPBJ = sigBearPBJ
// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: WHALE (Pocket Pivot + HV Milestone + PUP/PPD + PBJ) — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
grp_whale = "Whale Settings"
wh_lenBull = input.int(20, "Bull SMA Length", minval=1, group=grp_whale, inline="whs")
wh_lenBear = input.int(20, "Bear SMA Length", minval=1, group=grp_whale, inline="whs")
wh_useQ = input.bool(true, "Quarterly High (63d)", group=grp_whale, inline="whf")
wh_useY = input.bool(true, "Annual High (252d)", group=grp_whale, inline="whf")
wh_useATH = input.bool(true, "All-Time High", group=grp_whale, inline="whf")

f_whaleEngine() =>
    float wh_sma_bull = ta.sma(close, wh_lenBull)
    float wh_sma_bear = ta.sma(close, wh_lenBear)
    float wh_volAvg = ta.sma(volume, 50)
    float wh_hvy = ta.highest(volume, 252)
    float wh_hvq = ta.highest(volume, 63)
    var float wh_maxVolEver = 0.0
    if volume > wh_maxVolEver
        wh_maxVolEver := volume

    wh_dnVolArr = array.new_float()
    for i = 1 to wh_lenBull
        if close[i] < close[i + 1]
            array.push(wh_dnVolArr, volume[i])
    float wh_maxDnVol = array.size(wh_dnVolArr) > 0 ? array.max(wh_dnVolArr) : 0.0

    wh_upVolArr = array.new_float()
    for i = 1 to wh_lenBear
        if close[i] > close[i + 1]
            array.push(wh_upVolArr, volume[i])
    float wh_maxUpVol = array.size(wh_upVolArr) > 0 ? array.max(wh_upVolArr) : 0.0

    bool wh_isHV = (wh_useQ and volume == wh_hvq) or (wh_useY and volume == wh_hvy) or (wh_useATH and volume == wh_maxVolEver)

    bool wh_greenBar = close > close[1]
    bool wh_surgeonBull = wh_greenBar and (low <= wh_sma_bull) and (close > wh_sma_bull) and (volume > wh_maxDnVol) and (volume > wh_volAvg)
    bool wh_origBull = wh_greenBar and (low <= wh_sma_bull) and (volume > wh_maxDnVol)
    bool wh_pivotBull = wh_surgeonBull or wh_origBull

    bool wh_redBar = close < close[1]
    bool wh_surgeonBear = wh_redBar and (high >= wh_sma_bear) and (close < wh_sma_bear) and (volume > wh_maxUpVol) and (volume > wh_volAvg)
    bool wh_origBear = wh_redBar and (high >= wh_sma_bear) and (volume > wh_maxUpVol)
    bool wh_pivotBear = wh_surgeonBear or wh_origBear

    bool sigWhaleBull = conf and wh_pivotBull and wh_isHV and sigPUP and anyBullPBJ
    bool sigWhaleBear = conf and wh_pivotBear and wh_isHV and sigPPD and anyBearPBJ
    [sigWhaleBull, sigWhaleBear]

[sigWhaleBull, sigWhaleBear] = f_whaleEngine()

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: FAUNA (fauna variant, for TYPHOON) — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
f_faunaEngine() =>
    fauna_atr = ta.atr(14)
    fauna_avgVol = ta.sma(volume, 20)
    fauna_avgBody = ta.sma(math.abs(close - open), 20)
    fauna_avgRange = ta.sma(high - low, 20)
    fauna_avgDelta = ta.sma(math.abs(close - close[1]), 10)
    fauna_trendMA = ta.sma(close, 50)
    fauna_body = close - open
    fauna_rng = high - low
    fauna_bodySz = math.abs(fauna_body)
    fauna_bodyRat = fauna_rng == 0 ? 0 : fauna_bodySz / fauna_rng
    fauna_up = fauna_body > 0
    fauna_dn = fauna_body < 0

    MB_b = fauna_up and fauna_bodySz > 1.6 * fauna_atr and fauna_bodyRat > 0.7 and volume > 1.8 * fauna_avgVol
    RE_b = fauna_up and fauna_rng > 2.2 * fauna_atr and (high - close) < 0.15 * fauna_rng and volume > 1.8 * fauna_avgVol
    TA_b = fauna_trendMA > fauna_trendMA[1] and (close - close[1]) > 1.6 * fauna_avgDelta and fauna_up and volume > 1.8 * fauna_avgVol

    GG_b = (open - close[1]) > 0.9 * fauna_atr and fauna_up and low > close[1] and volume > 1.8 * fauna_avgVol
    fauna_prev_body = close[1] - open[1]
    fauna_prev_range = high[1] - low[1]
    fauna_StrongBear = close[1] < open[1] and math.abs(fauna_prev_body) > 1.5 * fauna_avgBody[1] and volume[1] > 1.5 * fauna_avgVol[1]
    fauna_WeakBear = close[1] < open[1] and (fauna_prev_range == 0 ? 0.0 : math.abs(fauna_prev_body) / fauna_prev_range) <= 0.2
    TR_b = fauna_WeakBear and (MB_b or RE_b or TA_b)
    ES_b = fauna_StrongBear and (MB_b or RE_b or TA_b)
    GDR_b = close[1] < open[1] and GG_b
    excluded_bull = GG_b or TR_b or ES_b or GDR_b

    sigFAUNABull = conf and (MB_b or RE_b or TA_b) and not excluded_bull

    MB_r = fauna_dn and fauna_bodySz > 1.6 * fauna_atr and fauna_bodyRat > 0.7 and volume > 1.8 * fauna_avgVol
    RE_r = fauna_dn and fauna_rng > 2.2 * fauna_atr and (close - low) < 0.15 * fauna_rng and volume > 1.8 * fauna_avgVol
    TA_r = fauna_trendMA < fauna_trendMA[1] and (close[1] - close) > 1.6 * fauna_avgDelta and fauna_dn and volume > 1.8 * fauna_avgVol

    GG_r = (close[1] - open) > 0.9 * fauna_atr and fauna_dn and high < close[1] and volume > 1.8 * fauna_avgVol
    fauna_StrongBull = close[1] > open[1] and math.abs(fauna_prev_body) > 1.5 * fauna_avgBody[1] and volume[1] > 1.5 * fauna_avgVol[1]
    fauna_WeakBull = close[1] > open[1] and (fauna_prev_range == 0 ? 0.0 : math.abs(fauna_prev_body) / fauna_prev_range) <= 0.2
    TR_r = fauna_WeakBull and (MB_r or RE_r or TA_r)
    ES_r = fauna_StrongBull and (MB_r or RE_r or TA_r)
    GDR_r = close[1] > open[1] and GG_r
    excluded_bear = GG_r or TR_r or ES_r or GDR_r

    sigFAUNABear = conf and (MB_r or RE_r or TA_r) and not excluded_bear
    [sigFAUNABull, sigFAUNABear]

[sigFAUNABull, sigFAUNABear] = f_faunaEngine()

// ============================================================================
// [v5.3] KCC REQUIREMENT — FAUNA + BODY % on ALL 28 VPs (operator order 2026-08-20)
// Every VP sig_ lane carries "and kccReqB" (bull) / "and kccReqR" (bear):
//   kccReqB = sigFAUNABull and kcc_bodyOK · kccReqR = sigFAUNABear and kcc_bodyOK
//   kcc_bodyOK = |close-open| / (high-low) x 100 >= Min Body % (default 75). Zero-range candle
//   (high == low) ⇒ body % = 0 ⇒ fails unless Min Body % = 0. Read on the marked candle bar[0].
// ============================================================================
grpKR = "★ KCC REQUIREMENT — FAUNA + BODY % (ALL 28 VPs) ★"
kcc_bodyPctMin = input.float(75.0, "Min Body % of candle (body ÷ high−low × 100)", minval=0.0, maxval=100.0, step=1.0, group=grpKR, tooltip="Candle body (|close − open|) as a percent of the full high−low range. EVERY VP in this study requires body % >= this value on the marked candle (bar[0]). Default 75 (operator 2026-08-20). 0 = body requirement off (FAUNA still required).")
float kcc_bodyPct = (high - low) > 0 ? math.abs(close - open) / (high - low) * 100.0 : 0.0
bool kcc_bodyOK = kcc_bodyPct >= kcc_bodyPctMin
bool kccReqB = sigFAUNABull and kcc_bodyOK
bool kccReqR = sigFAUNABear and kcc_bodyOK

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: GZ1 / HV FVG (for MUSASHI) — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
grp_gz1 = "GZ1 / HV Settings"
gz1_threshPct = input.float(2, "FVG Threshold %", minval=0, maxval=100, step=0.1, group=grp_gz1)
gz1_auto = input.bool(true, "Auto Threshold", group=grp_gz1)
gz1_dist = input.int(7, "GZ1 Max Bar Distance", minval=1, maxval=200, group=grp_gz1)

type gz_fvg
    float mx
    float mn
    bool bull
    int t
    int idx
    bool hv
f_gzEngine() =>

    // GZ1 HV Detection
    float gz_v1 = volume[1]
    float _hv5000 = ta.highest(volume, 5000)[1]
    float _hv252 = ta.highest(volume, 252)[1]
    bool gz_isHV = gz_v1 == _hv5000 or gz_v1 == _hv252

    // GZ1 FVG Detection
    float gz_thresh = gz1_auto ? ta.cum((high - low) / low) / bar_index : gz1_threshPct / 100
    bool gz_bFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > gz_thresh
    bool gz_sFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / high > gz_thresh

    var gz_fvgs = array.new<gz_fvg>(0)
    var int gz_lastT = 0
    bool gz_bullGZI = false, bool gz_bearGZI = false, bool gz_bullHV = false, bool gz_bearHV = false

    // Process Bull FVG
    if gz_bFVG and time != gz_lastT
        float mx = low, float mn = high[2]
        if gz_isHV
            gz_bullHV := true
        if gz_fvgs.size() > 0
            for i = 0 to gz_fvgs.size() - 1
                gz_fvg e = gz_fvgs.get(i)
                if e.bull and bar_index - e.idx <= gz1_dist
                    float ob = math.max(e.mn, mn), float ot = math.min(e.mx, mx)
                    if ob < ot or (ob <= ot and e.hv and gz_isHV)
                        gz_bullGZI := true
                        break
        gz_fvgs.unshift(gz_fvg.new(mx, mn, true, time, bar_index, gz_isHV))
        gz_lastT := time

    // Process Bear FVG
    if gz_sFVG and time != gz_lastT
        float mx = low[2], float mn = high
        if gz_isHV
            gz_bearHV := true
        if gz_fvgs.size() > 0
            for i = 0 to gz_fvgs.size() - 1
                gz_fvg e = gz_fvgs.get(i)
                if not e.bull and bar_index - e.idx <= gz1_dist
                    float ob = math.max(e.mn, mn), float ot = math.min(e.mx, mx)
                    if ob < ot or (ob <= ot and e.hv and gz_isHV)
                        gz_bearGZI := true
                        break
        gz_fvgs.unshift(gz_fvg.new(mx, mn, false, time, bar_index, gz_isHV))
        gz_lastT := time

    // [v4.5 DECLARED DEVIATION] FQ mitigation-line render+prune block (FQ v1.4
    // L615-624) + its show-toggle input REMOVED = locked to FQ default false;
    // graphic-object inventory stays 0 (L-61). Detection booleans untouched.
    if gz_fvgs.size() > 50
        gz_fvgs.pop()
    [gz_bullGZI, gz_bearGZI, gz_bullHV, gz_bearHV]

[gz_bullGZI, gz_bearGZI, gz_bullHV, gz_bearHV] = f_gzEngine()

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: YIN YANG SWING (for TYPHOON) — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
grp_yy_lb = "YY - Lookback Settings"
yy_leftBars = input.int(75, "Left Bars", minval=1, group=grp_yy_lb, tooltip="Minimum bars to the left to confirm a pivot")
yy_rightBars = input.int(1, "Right Bars", minval=1, group=grp_yy_lb, tooltip="Minimum bars to the right to confirm a pivot. Also determines plot offset.")
grp_yy_atr = "YY - ATR Filter Settings"
yy_atrLength = input.int(50, "ATR Length", minval=1, group=grp_yy_atr)
yy_atrMult = input.float(3.5, "ATR Multiplier", step=0.1, group=grp_yy_atr, tooltip="The new swing must be at least this many ATRs away from the previous valid swing level.")

type yy_sr
    float price
    bool isResistance

yy_isSufficientDistance(currentPrice, lastPrice, thr) =>
    na(lastPrice) ? true : math.abs(currentPrice - lastPrice) >= thr
f_yyEngine() =>
    var yy_srs = array.new<yy_sr>()
    var float yy_lastValidLevel = na

    float yy_atrValue = ta.atr(yy_atrLength)
    float yy_threshold = yy_atrValue * yy_atrMult

    float yy_rawHigh = ta.pivothigh(high, yy_leftBars, yy_rightBars)
    float yy_rawLow = ta.pivotlow(low, yy_leftBars, yy_rightBars)


    bool yy_validHigh = false
    if not na(yy_rawHigh) and conf
        if yy_isSufficientDistance(yy_rawHigh, yy_lastValidLevel, yy_threshold)
            yy_validHigh := true
            yy_lastValidLevel := yy_rawHigh
            array.push(yy_srs, yy_sr.new(yy_rawHigh, true))

    bool yy_validLow = false
    if not na(yy_rawLow) and conf
        if yy_isSufficientDistance(yy_rawLow, yy_lastValidLevel, yy_threshold)
            yy_validLow := true
            yy_lastValidLevel := yy_rawLow
            array.push(yy_srs, yy_sr.new(yy_rawLow, false))
    [yy_validHigh, yy_validLow]

[yy_validHigh, yy_validLow] = f_yyEngine()

al_PUP = f_align(sigPUP)
al_WhaleBull = f_align(sigWhaleBull)
al_anyBullPBJ = f_align(anyBullPBJ)
sigMusashiBull = conf and (gz_bullGZI or gz_bullHV) and al_PUP and al_WhaleBull and al_anyBullPBJ
bool typh_bull_extra = sigPUP[yy_rightBars] or (sigWhaleBull[yy_rightBars] and anyBullPBJ[yy_rightBars])
bool sigTyphoonBull = conf and yy_validLow and is_new_sess[yy_rightBars] and sigFAUNABull[yy_rightBars] and typh_bull_extra
bool det_HW_bull = sigTyphoonBull or sigMusashiBull or sigWhaleBull
al_PPD = f_align(sigPPD)
al_WhaleBear = f_align(sigWhaleBear)
al_anyBearPBJ = f_align(anyBearPBJ)
sigMusashiBear = conf and (gz_bearGZI or gz_bearHV) and al_PPD and al_WhaleBear and al_anyBearPBJ
bool typh_bear_extra = sigPPD[yy_rightBars] or (sigWhaleBear[yy_rightBars] and anyBearPBJ[yy_rightBars])
bool sigTyphoonBear = conf and yy_validHigh and is_new_sess[yy_rightBars] and sigFAUNABear[yy_rightBars] and typh_bear_extra
bool det_HW_bear = sigTyphoonBear or sigMusashiBear or sigWhaleBear

// ENGINE: u5 FAUNA (TNT OD variant)
f_u5FaunaEngine() =>
    float ATR14 = ta.atr(14)
    float u5_f_atr = ATR14, float u5_f_avgVol = ta.sma(volume, 20), float u5_f_avgBody = ta.sma(math.abs(close - open), 20)
    float u5_f_avgDelta = ta.sma(math.abs(close - close[1]), 10), float u5_f_trendMA = ta.sma(close, 50)
    float u5_f_body = close - open, float u5_f_rng = high - low, float u5_f_bodySz = math.abs(u5_f_body)
    float u5_f_bodyRat = u5_f_rng == 0 ? 0.0 : u5_f_bodySz / u5_f_rng
    bool u5_f_up = u5_f_body > 0, bool u5_f_dn = u5_f_body < 0
    float u5_f_prev_body = close[1] - open[1], float u5_f_prev_range = high[1] - low[1]
    bool u5_MB_b = u5_f_up and u5_f_bodySz > 1.6 * u5_f_atr and u5_f_bodyRat > 0.70 and volume > 1.8 * u5_f_avgVol
    bool u5_RE_b = u5_f_up and u5_f_rng > 2.2 * u5_f_atr and (high - close) < 0.15 * u5_f_rng and volume > 1.8 * u5_f_avgVol
    bool u5_TA_b = u5_f_trendMA > u5_f_trendMA[1] and (close - close[1]) > 1.6 * u5_f_avgDelta and u5_f_up and volume > 1.8 * u5_f_avgVol
    bool u5_GG_b = (open - close[1]) > 0.9 * u5_f_atr and u5_f_up and low > close[1] and volume > 1.8 * u5_f_avgVol
    bool u5_StrongBear = close[1] < open[1] and math.abs(u5_f_prev_body) > 1.5 * u5_f_avgBody[1] and volume[1] > 1.5 * u5_f_avgVol[1]
    bool u5_WeakBear = close[1] < open[1] and (u5_f_prev_range == 0 ? 0.0 : math.abs(u5_f_prev_body) / u5_f_prev_range) <= 0.2
    bool u5_TR_b = u5_WeakBear and (u5_MB_b or u5_RE_b or u5_TA_b), bool u5_ES_b = u5_StrongBear and (u5_MB_b or u5_RE_b or u5_TA_b), bool u5_GDR_b = close[1] < open[1] and u5_GG_b
    int u5_b_core = (u5_MB_b ? 1 : 0) + (u5_RE_b ? 1 : 0) + (u5_TA_b ? 1 : 0)
    bool u5_b_gg_exc = u5_GG_b and not ((u5_b_core >= 2) and (u5_f_bodyRat >= 0.80))
    bool u5_FAUNABull = barstate.isconfirmed and (u5_MB_b or u5_RE_b or u5_TA_b) and not (u5_TR_b or u5_ES_b or u5_GDR_b or u5_b_gg_exc)

    bool u5_MB_r = u5_f_dn and u5_f_bodySz > 1.6 * u5_f_atr and u5_f_bodyRat > 0.70 and volume > 1.8 * u5_f_avgVol
    bool u5_RE_r = u5_f_dn and u5_f_rng > 2.2 * u5_f_atr and (close - low) < 0.15 * u5_f_rng and volume > 1.8 * u5_f_avgVol
    bool u5_TA_r = u5_f_trendMA < u5_f_trendMA[1] and (close[1] - close) > 1.6 * u5_f_avgDelta and u5_f_dn and volume > 1.8 * u5_f_avgVol
    bool u5_GG_r = (close[1] - open) > 0.9 * u5_f_atr and u5_f_dn and high < close[1] and volume > 1.8 * u5_f_avgVol
    bool u5_StrongBull = close[1] > open[1] and math.abs(u5_f_prev_body) > 1.5 * u5_f_avgBody[1] and volume[1] > 1.5 * u5_f_avgVol[1]
    bool u5_WeakBull = close[1] > open[1] and (u5_f_prev_range == 0 ? 0.0 : math.abs(u5_f_prev_body) / u5_f_prev_range) <= 0.2
    bool u5_TR_r = u5_WeakBull and (u5_MB_r or u5_RE_r or u5_TA_r), bool u5_ES_r = u5_StrongBull and (u5_MB_r or u5_RE_r or u5_TA_r), bool u5_GDR_r = close[1] > open[1] and u5_GG_r
    int u5_s_core = (u5_MB_r ? 1 : 0) + (u5_RE_r ? 1 : 0) + (u5_TA_r ? 1 : 0)
    bool u5_s_gg_exc = u5_GG_r and not ((u5_s_core >= 2) and (u5_f_bodyRat >= 0.80))
    bool u5_FAUNABear = barstate.isconfirmed and (u5_MB_r or u5_RE_r or u5_TA_r) and not (u5_TR_r or u5_ES_r or u5_GDR_r or u5_s_gg_exc)
    [u5_FAUNABull, u5_FAUNABear]

[u5_FAUNABull, u5_FAUNABear] = f_u5FaunaEngine()

// NAGASAKI — SQUARIFY v3 parity (all-time-high volume on bar[0])
var float maxVol = 0.0
bool isNagasaki = false
if bar_index == 0
    maxVol := volume
else if volume > maxVol
    isNagasaki := true
    maxVol := volume
sigNagasaki = isNagasaki

// Pentagon (RVOL Reg@Time middle tier — needed by Unified Combo comboSets)
bool det_Pentagon = conf and (rv_relVolRatio >= th_1x) and (rv_relVolRatio <= th_wtc)

// GZ1 / HV FVG (HVD params: adds 63d HV tier, dist=12) — for Unified Combo comboSets
type hgz_fvg
    float mx
    float mn
    bool bull
    int t
    int idx
    bool hv
float hgz_v1 = volume[1]
float _hgz5000 = ta.highest(volume, 5000)[1]
float _hgz252 = ta.highest(volume, 252)[1]
float _hgz63 = ta.highest(volume, 63)[1]
bool hgz_isHV = (hgz_v1 == _hgz5000) or (hgz_v1 == _hgz252) or (hgz_v1 == _hgz63)
float hgz_thresh = hgz_auto ? ta.cum((high - low) / low) / bar_index : hgz_threshPct / 100
bool hgz_bFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > hgz_thresh
bool hgz_sFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / high > hgz_thresh
var hgz_fvgs = array.new<hgz_fvg>(0)
var int hgz_lastT = 0
bool hgz_bullGZI = false, bool hgz_bearGZI = false, bool hgz_bullHV = false, bool hgz_bearHV = false
if conf and hgz_bFVG and time != hgz_lastT
    float mx = low, float mn = high[2]
    if hgz_isHV
        hgz_bullHV := true
    if hgz_fvgs.size() > 0
        for i = 0 to hgz_fvgs.size() - 1
            hgz_fvg e = hgz_fvgs.get(i)
            if e.bull and bar_index - e.idx <= hgz_dist
                if math.max(e.mn, mn) < math.min(e.mx, mx) or (math.max(e.mn, mn) <= math.min(e.mx, mx) and e.hv and hgz_isHV)
                    hgz_bullGZI := true
                    break
    hgz_fvgs.unshift(hgz_fvg.new(mx, mn, true, time, bar_index, hgz_isHV))
    hgz_lastT := time
if conf and hgz_sFVG and time != hgz_lastT
    float mx = low[2], float mn = high
    if hgz_isHV
        hgz_bearHV := true
    if hgz_fvgs.size() > 0
        for i = 0 to hgz_fvgs.size() - 1
            hgz_fvg e = hgz_fvgs.get(i)
            if not e.bull and bar_index - e.idx <= hgz_dist
                if math.max(e.mn, mn) < math.min(e.mx, mx) or (math.max(e.mn, mn) <= math.min(e.mx, mx) and e.hv and hgz_isHV)
                    hgz_bearGZI := true
                    break
    hgz_fvgs.unshift(hgz_fvg.new(mx, mn, false, time, bar_index, hgz_isHV))
    hgz_lastT := time
if hgz_fvgs.size() > 0
    for i = hgz_fvgs.size() - 1 to 0
        hgz_fvg g = hgz_fvgs.get(i)
        if g.bull and close < g.mn
            hgz_fvgs.remove(i)
        else if not g.bull and close > g.mx
            hgz_fvgs.remove(i)
if hgz_fvgs.size() > 50
    hgz_fvgs.pop()

// Matrix Neo/Trinity + Long/Short momentum (reuses hybrid RVOL ratios)
bool is_matrix_number = volume == ta.highest(volume, neo_len)
bool sigNeoBull = conf and is_matrix_number and u5_FAUNABull
bool sigNeoBear = conf and is_matrix_number and u5_FAUNABear
bool sigTrinityBull = conf and is_matrix_number and not u5_FAUNABull and close > open
bool sigTrinityBear = conf and is_matrix_number and not u5_FAUNABear and close < open
float ls_regRatio = nz(hybRegRatio)
float ls_cumRatio = nz(hybCumRatio)
float ls_bodyRat = (high - low) == 0 ? 0.0 : math.abs(close - open) / (high - low)
bool sigLong1 = conf and ls_regRatio > ls_reg1 and ls_cumRatio > ls_cum1 and close > open and ls_bodyRat >= ls_body1
bool sigShort1 = conf and ls_regRatio > ls_reg1 and ls_cumRatio > ls_cum1 and close < open and ls_bodyRat >= ls_body1
bool sigLong2 = conf and ls_regRatio > ls_reg2 and ls_cumRatio > ls_cum2 and close > open and ls_bodyRat >= ls_body2
bool sigShort2 = conf and ls_regRatio > ls_reg2 and ls_cumRatio > ls_cum2 and close < open and ls_bodyRat >= ls_body2
bool neo_bull_aligned = sigNeoBull and (sigLong1 or sigLong2)
bool neo_bear_aligned = sigNeoBear and (sigShort1 or sigShort2)
bool trinity_bull_aligned = sigTrinityBull and (sigLong1 or sigLong2)
bool trinity_bear_aligned = sigTrinityBear and (sigShort1 or sigShort2)

// Combo Sets → csNew3 (Unified Combo base + CMB momentum term)
float cs_bp1 = high[1] - low[1] == 0 ? 0.0 : math.abs(close[1] - open[1]) / (high[1] - low[1])
bool cs_vb = cs_bp1 >= cs_bodyPct_FVG
bool comboSet1_Bull = conf and cs_vb and (hgz_bullHV or hgz_bullGZI) and (det_SAAB[1] or det_RVOL1xB[1] or det_GrandSlam[1])
bool comboSet1_Bear = conf and cs_vb and (hgz_bearHV or hgz_bearGZI) and (det_Kratos[1] or det_RVOL1xR[1] or det_MOAB[1])
bool comboSet2_Bull = conf and cs_vb and (hgz_bullHV or hgz_bullGZI) and ((cs_inc_pentagon_FVG and det_Pentagon[1]) or det_WTC[1] or det_Hiroshima[1] or sigNagasaki[1])
bool comboSet2_Bear = conf and cs_vb and (hgz_bearHV or hgz_bearGZI) and ((cs_inc_pentagon_FVG and det_Pentagon[1]) or det_WTC[1] or det_Hiroshima[1] or sigNagasaki[1])
bool cs_vm = ls_bodyRat >= cs_bodyPct_MAT
bool matrix_any_bull = sigNeoBull or sigTrinityBull or neo_bull_aligned or trinity_bull_aligned
bool matrix_any_bear = sigNeoBear or sigTrinityBear or neo_bear_aligned or trinity_bear_aligned
bool comboSet3_Bull = cs_vm and matrix_any_bull and (det_SAAB or det_RVOL1xB or det_GrandSlam)
bool comboSet3_Bear = cs_vm and matrix_any_bear and (det_Kratos or det_RVOL1xR or det_MOAB)
bool comboSet4_Bull = cs_vm and matrix_any_bull and ((cs_inc_pentagon_MAT and det_Pentagon) or det_WTC or det_Hiroshima or sigNagasaki)
bool comboSet4_Bear = cs_vm and matrix_any_bear and ((cs_inc_pentagon_MAT and det_Pentagon) or det_WTC or det_Hiroshima or sigNagasaki)
bool csNew1_Bull = comboSet1_Bull or comboSet2_Bull
bool csNew1_Bear = comboSet1_Bear or comboSet2_Bear
bool csNew2_Bull = comboSet3_Bull or comboSet4_Bull
bool csNew2_Bear = comboSet3_Bear or comboSet4_Bear
bool csNew3_Bull = csNew1_Bull and nz(csNew2_Bull[1])
bool csNew3_Bear = csNew1_Bear and nz(csNew2_Bear[1])

// ══ CCC v1 — UC_core (NEW DEF) + back-to-back Combo Chain (specs v1.0-v1.3) ══
bool uc_core_Bull = csNew3_Bull or (comboSet1_Bull and comboSet2_Bull)
bool uc_core_Bear = csNew3_Bear or (comboSet1_Bear and comboSet2_Bear)
bool cc_hit_bull = comboSet1_Bull or comboSet2_Bull or comboSet3_Bull or comboSet4_Bull or uc_core_Bull
bool cc_hit_bear = comboSet1_Bear or comboSet2_Bear or comboSet3_Bear or comboSet4_Bear or uc_core_Bear
bool det_CC_bull = conf and cc_hit_bull and nz(cc_hit_bull[1])
bool det_CC_bear = conf and cc_hit_bear and nz(cc_hit_bear[1])
bool det_MAT_bull = comboSet3_Bull or comboSet4_Bull
bool det_MAT_bear = comboSet3_Bear or comboSet4_Bear

// ═══ PORTED ENGINE — HVD BULL (verbatim slice) ═══
grp_hvd1 = "── HV+D: DISP BASE ──"
d1_type = input.string("Open to Close", "Range Type", options=["Open to Close","High to Low"], group=grp_hvd1)
d1_len  = input.int(100, "Std Dev Length", minval=1, group=grp_hvd1)
d1_mult = input.float(5.0, "Std Dev Multiplier", minval=0.1, step=0.1, group=grp_hvd1)

string grpHVBase = "── HV+D: BASE HV ──"
bool ub50   = input.bool(true,  "50-Bar",   group=grpHVBase)
bool ub75   = input.bool(true,  "75-Bar",   group=grpHVBase)
bool ub100  = input.bool(true,  "100-Bar",  group=grpHVBase)
bool ub150  = input.bool(true,  "150-Bar",  group=grpHVBase)
bool ub200  = input.bool(true,  "200-Bar",  group=grpHVBase)
bool ub250  = input.bool(true,  "250-Bar",  group=grpHVBase)
bool ub300  = input.bool(true,  "300-Bar",  group=grpHVBase)
bool ub350  = input.bool(true,  "350-Bar",  group=grpHVBase)
bool ub400  = input.bool(true,  "400-Bar",  group=grpHVBase)
bool ub450  = input.bool(true,  "450-Bar",  group=grpHVBase)
bool ub500  = input.bool(true,  "500-Bar",  group=grpHVBase)
bool ub550  = input.bool(true,  "550-Bar",  group=grpHVBase)
bool ub600  = input.bool(true,  "600-Bar",  group=grpHVBase)
bool ub650  = input.bool(true,  "650-Bar",  group=grpHVBase)
bool ub700  = input.bool(true,  "700-Bar",  group=grpHVBase)
bool ub750  = input.bool(true,  "750-Bar",  group=grpHVBase)
bool ub1000 = input.bool(true,  "1000-Bar", group=grpHVBase)
bool useHEV = input.bool(true,  "All-Time High Volume (HEV)", group=grpHVBase)

float d1_rng = d1_type == "Open to Close" ? math.abs(open - close) : high - low
float d1_std = ta.stdev(d1_rng, d1_len)
float d1_thresh = d1_std * d1_mult
bool  d1_prevDisp = d1_rng[1] > d1_thresh[1]
bool  d1_bullFVG  = low > high[2] and close[1] > open[1]
bool  d1_bearFVG  = high < low[2] and close[1] < open[1]
bool  d1_bull = conf and d1_prevDisp and d1_bullFVG
bool  d1_bear = conf and d1_prevDisp and d1_bearFVG

bool is50   = volume[1] == ta.highest(volume, 50)[1]
bool is75   = volume[1] == ta.highest(volume, 75)[1]
bool is100  = volume[1] == ta.highest(volume, 100)[1]
bool is150  = volume[1] == ta.highest(volume, 150)[1]
bool is200  = volume[1] == ta.highest(volume, 200)[1]
bool is250  = volume[1] == ta.highest(volume, 250)[1]
bool is300  = volume[1] == ta.highest(volume, 300)[1]
bool is350  = volume[1] == ta.highest(volume, 350)[1]
bool is400  = volume[1] == ta.highest(volume, 400)[1]
bool is450  = volume[1] == ta.highest(volume, 450)[1]
bool is500  = volume[1] == ta.highest(volume, 500)[1]
bool is550  = volume[1] == ta.highest(volume, 550)[1]
bool is600  = volume[1] == ta.highest(volume, 600)[1]
bool is650  = volume[1] == ta.highest(volume, 650)[1]
bool is700  = volume[1] == ta.highest(volume, 700)[1]
bool is750  = volume[1] == ta.highest(volume, 750)[1]
bool is1000 = volume[1] == ta.highest(volume, 1000)[1]

var float maxVolEver = 0.0
bool isHEV = false
if volume[1] > maxVolEver
    maxVolEver := volume[1]
    isHEV := true

int baseRank = is1000 ? 1000 : is750 ? 750 : is700 ? 700 : is650 ? 650 : is600 ? 600 : is550 ? 550 : is500 ? 500 : is450 ? 450 : is400 ? 400 : is350 ? 350 : is300 ? 300 : is250 ? 250 : is200 ? 200 : is150 ? 150 : is100 ? 100 : is75 ? 75 : is50 ? 50 : 0

bool base_enabled = (ub50 and baseRank == 50) or (ub75 and baseRank == 75) or (ub100 and baseRank == 100) or (ub150 and baseRank == 150) or (ub200 and baseRank == 200) or (ub250 and baseRank == 250) or (ub300 and baseRank == 300) or (ub350 and baseRank == 350) or (ub400 and baseRank == 400) or (ub450 and baseRank == 450) or (ub500 and baseRank == 500) or (ub550 and baseRank == 550) or (ub600 and baseRank == 600) or (ub650 and baseRank == 650) or (ub700 and baseRank == 700) or (ub750 and baseRank == 750) or (ub1000 and baseRank == 1000)
bool hev_hit = useHEV and isHEV
bool base_hv_hit = hev_hit or (base_enabled and not isHEV)
bool base_combo_bull = base_hv_hit and d1_bull

bool hvd_fire_bull = base_combo_bull
bool base_combo_bear = base_hv_hit and d1_bear
bool hvd_fire_bear = base_combo_bear
grpVP = "★ VP Checkboxes — show/hide visual (independent of alerts) ★"
va01 = input.bool(true, "VP H.A: BULL HVD+ANY SR", group=grpVP)
va02 = input.bool(true, "VP UC.A: BULL UC+ANY SR", group=grpVP)
va13 = input.bool(true, "VP SA.A: BULL SAAB+ANY SR", group=grpVP)
va14 = input.bool(true, "VP 1X.A: BULL RVOL 1X+ANY SR", group=grpVP)
va15 = input.bool(true, "VP GS.A: BULL GRAND SLAM+ANY SR", group=grpVP)
va16 = input.bool(true, "VP N.A: BULL NAGA+ANY SR", group=grpVP)
va17 = input.bool(true, "VP HW.A: BULL TYPH/MUSA/WHALE+ANY SR", group=grpVP)
va07 = input.bool(true, "VP H.A: BEAR HVD+ANY SR", group=grpVP)
va08 = input.bool(true, "VP UC.A: BEAR UC+ANY SR", group=grpVP)
va18 = input.bool(true, "VP KR.A: BEAR KRATOS+ANY SR", group=grpVP)
va19 = input.bool(true, "VP 1X.A: BEAR RVOL 1X+ANY SR", group=grpVP)
va20 = input.bool(true, "VP MB.A: BEAR MOAB+ANY SR", group=grpVP)
va21 = input.bool(true, "VP N.A: BEAR NAGA+ANY SR", group=grpVP)
va22 = input.bool(true, "VP HW.A: BEAR TYPH/MUSA/WHALE+ANY SR", group=grpVP)
grpAL = "★ Alert Checkboxes — include in alerts (independent of visuals) ★"
aa01 = input.bool(true, "ALERT H.A: BULL HVD+ANY SR", group=grpAL)
aa02 = input.bool(true, "ALERT UC.A: BULL UC+ANY SR", group=grpAL)
aa13 = input.bool(true, "ALERT SA.A: BULL SAAB+ANY SR", group=grpAL)
aa14 = input.bool(true, "ALERT 1X.A: BULL RVOL 1X+ANY SR", group=grpAL)
aa15 = input.bool(true, "ALERT GS.A: BULL GRAND SLAM+ANY SR", group=grpAL)
aa16 = input.bool(true, "ALERT N.A: BULL NAGA+ANY SR", group=grpAL)
aa17 = input.bool(true, "ALERT HW.A: BULL TYPH/MUSA/WHALE+ANY SR", group=grpAL)
aa07 = input.bool(true, "ALERT H.A: BEAR HVD+ANY SR", group=grpAL)
aa08 = input.bool(true, "ALERT UC.A: BEAR UC+ANY SR", group=grpAL)
aa18 = input.bool(true, "ALERT KR.A: BEAR KRATOS+ANY SR", group=grpAL)
aa19 = input.bool(true, "ALERT 1X.A: BEAR RVOL 1X+ANY SR", group=grpAL)
aa20 = input.bool(true, "ALERT MB.A: BEAR MOAB+ANY SR", group=grpAL)
aa21 = input.bool(true, "ALERT N.A: BEAR NAGA+ANY SR", group=grpAL)
aa22 = input.bool(true, "ALERT HW.A: BEAR TYPH/MUSA/WHALE+ANY SR", group=grpAL)
// ═══ DETECTION / FIRE / ALERT LANES — ALL sig_ kept (calculation law); fire/alf only for the 12 keeps per side ═══
bool sig_c03 = sigBullReCross and sigBullReSlope
bool sig_c06 = sigBullPB and sigBullReCross and sigBullReSlope
bool sig_c09 = sigBullPBJ and sigBullReCross and sigBullReSlope
bool sig_c12 = sigBullReCross and sigBullReSlope and sigPUP
bool sig_c13 = sigBullReCross and sigBullReSlope and sigDispBull
bool sig_c15 = sigBullPB and sigBullReCross and sigBullReSlope and sigPUP
bool sig_c16 = sigBullPB and sigBullReCross and sigBullReSlope and sigDispBull
bool sig_c18 = sigBullPBJ and sigBullReCross and sigBullReSlope and sigPUP
bool sig_c19 = sigBullPBJ and sigBullReCross and sigBullReSlope and sigDispBull
bool sig_c21 = sigBullReCross and sigBullReSlope and sigPUP and sigDispBull
bool sig_c22 = sigBullPB and sigBullReCross and sigBullReSlope and sigPUP and sigDispBull
bool sig_c23 = sigBullPBJ and sigBullReCross and sigBullReSlope and sigPUP and sigDispBull
int cntBULL = (sig_c03 ? 1 : 0) + (sig_c06 ? 1 : 0) + (sig_c09 ? 1 : 0) + (sig_c12 ? 1 : 0) + (sig_c13 ? 1 : 0) + (sig_c15 ? 1 : 0) + (sig_c16 ? 1 : 0) + (sig_c18 ? 1 : 0) + (sig_c19 ? 1 : 0) + (sig_c21 ? 1 : 0) + (sig_c22 ? 1 : 0) + (sig_c23 ? 1 : 0)
bool anyComboBULL = cntBULL >= 1
bool sig_a01 = hvd_fire_bull and anyComboBULL and kccReqB
bool fire_a01 = va01 and sig_a01
bool alf_a01 = aa01 and sig_a01
bool sig_a02 = uc_core_Bull and anyComboBULL and kccReqB
bool fire_a02 = va02 and sig_a02
bool alf_a02 = aa02 and sig_a02
bool sig_a03 = comboSet1_Bull and anyComboBULL
bool sig_a04 = comboSet2_Bull and anyComboBULL
bool sig_a05 = det_MAT_bull and anyComboBULL
bool sig_a06 = det_CC_bull and anyComboBULL
bool sig_a13 = det_SAAB and anyComboBULL and kccReqB
bool fire_a13 = va13 and sig_a13
bool alf_a13 = aa13 and sig_a13
bool sig_a14 = det_RVOL1xB and anyComboBULL and kccReqB
bool fire_a14 = va14 and sig_a14
bool alf_a14 = aa14 and sig_a14
bool sig_a15 = det_GrandSlam and anyComboBULL and kccReqB
bool fire_a15 = va15 and sig_a15
bool alf_a15 = aa15 and sig_a15
bool sig_a16 = isNaga and anyComboBULL and kccReqB
bool fire_a16 = va16 and sig_a16
bool alf_a16 = aa16 and sig_a16
bool sig_a17 = det_HW_bull and anyComboBULL and kccReqB
bool fire_a17 = va17 and sig_a17
bool alf_a17 = aa17 and sig_a17
bool sig_x01 = cntBULL >= 1
bool sig_x02 = cntBULL >= 2
bool sig_x03 = cntBULL >= 3
bool sig_c26 = sigBearReCross and sigBearReSlope
bool sig_c29 = sigBearPB and sigBearReCross and sigBearReSlope
bool sig_c32 = sigBearPBJ and sigBearReCross and sigBearReSlope
bool sig_c35 = sigBearReCross and sigBearReSlope and sigPPD
bool sig_c36 = sigBearReCross and sigBearReSlope and sigDispBear
bool sig_c38 = sigBearPB and sigBearReCross and sigBearReSlope and sigPPD
bool sig_c39 = sigBearPB and sigBearReCross and sigBearReSlope and sigDispBear
bool sig_c41 = sigBearPBJ and sigBearReCross and sigBearReSlope and sigPPD
bool sig_c42 = sigBearPBJ and sigBearReCross and sigBearReSlope and sigDispBear
bool sig_c44 = sigBearReCross and sigBearReSlope and sigPPD and sigDispBear
bool sig_c45 = sigBearPB and sigBearReCross and sigBearReSlope and sigPPD and sigDispBear
bool sig_c46 = sigBearPBJ and sigBearReCross and sigBearReSlope and sigPPD and sigDispBear
int cntBEAR = (sig_c26 ? 1 : 0) + (sig_c29 ? 1 : 0) + (sig_c32 ? 1 : 0) + (sig_c35 ? 1 : 0) + (sig_c36 ? 1 : 0) + (sig_c38 ? 1 : 0) + (sig_c39 ? 1 : 0) + (sig_c41 ? 1 : 0) + (sig_c42 ? 1 : 0) + (sig_c44 ? 1 : 0) + (sig_c45 ? 1 : 0) + (sig_c46 ? 1 : 0)
bool anyComboBEAR = cntBEAR >= 1
bool sig_a07 = hvd_fire_bear and anyComboBEAR and kccReqR
bool fire_a07 = va07 and sig_a07
bool alf_a07 = aa07 and sig_a07
bool sig_a08 = uc_core_Bear and anyComboBEAR and kccReqR
bool fire_a08 = va08 and sig_a08
bool alf_a08 = aa08 and sig_a08
bool sig_a09 = comboSet1_Bear and anyComboBEAR
bool sig_a10 = comboSet2_Bear and anyComboBEAR
bool sig_a11 = det_MAT_bear and anyComboBEAR
bool sig_a12 = det_CC_bear and anyComboBEAR
bool sig_a18 = det_Kratos and anyComboBEAR and kccReqR
bool fire_a18 = va18 and sig_a18
bool alf_a18 = aa18 and sig_a18
bool sig_a19 = det_RVOL1xR and anyComboBEAR and kccReqR
bool fire_a19 = va19 and sig_a19
bool alf_a19 = aa19 and sig_a19
bool sig_a20 = det_MOAB and anyComboBEAR and kccReqR
bool fire_a20 = va20 and sig_a20
bool alf_a20 = aa20 and sig_a20
bool sig_a21 = isNaga and anyComboBEAR and kccReqR
bool fire_a21 = va21 and sig_a21
bool alf_a21 = aa21 and sig_a21
bool sig_a22 = det_HW_bear and anyComboBEAR and kccReqR
bool fire_a22 = va22 and sig_a22
bool alf_a22 = aa22 and sig_a22
bool sig_x05 = cntBEAR >= 1
bool sig_x06 = cntBEAR >= 2
bool sig_x07 = cntBEAR >= 3
// ═══ [v4.7] PORTED VERBATIM from FABLE QUAD v1.6 — d9 slice + rf_ PING PONG SR
// (HVD PBJ PPD parity; closure-proven D_missing=0; ONE substitution: any_BULL -> anyComboBULL

grp_d9 = "Displacement 9"
i_d9_type = input.string("Open to Close", "Range Type", options=["Open to Close", "High to Low"], group=grp_d9)
i_d9_len = input.int(100, "Std Dev Length", minval=1, group=grp_d9)
i_d9_mult = input.float(5.0, "Std Dev Multiplier (σ strength)", minval=0.1, step=0.5, group=grp_d9, tooltip="MEASURED 2026-07-26 (162-cell census, 210,686 bars): events per 10,000 bars by sigma — 9.0=2.13 · 8.0=7.20 · 7.0=20.54 · 6.0=43.92 · 5.0=88.20. v1.2 default moved 9.0 -> 5.0 because sigma=9 fired ~twice per 10,000 bars, which disabled every lane gated on it.")
float d9_rng = i_d9_type == "Open to Close" ? math.abs(open - close) : high - low
float d9_std = ta.stdev(d9_rng, i_d9_len)
float d9_thresh = d9_std * i_d9_mult
bool d9_bull = conf and d9_rng > d9_thresh and close > open
bool d9_bear = conf and d9_rng > d9_thresh and close < open

// ENGINE: PING PONG SR — STRUCTURAL GRAVITY (rf_ prefix) — HVD PBJ PPD parity
// Verbatim port of HVD_PBJ_PPD_{BEARISH,BULLISH}_v1.pine "ENGINE 7: PING PONG SR"
// (L558-693) — the engine behind ROOF / PENTHOUSE / FLOOR / 2nd FLOOR.
// ONE DECLARED DEVIATION (T-INERT): the srLevel `line` bookkeeping field and its
// 7 line.* call sites are REMOVED. No detection boolean reads lnID — the lines are
// 100%-transparent decoration only — so every boolean below is bit-identical to the
// source while this study adds ZERO graphic objects (CARDINAL SIN #1 / L-61) and
// cannot exhaust TradingView's line-object cap.
// ══════════════════════════════════════════════════════════════════════════════
grp_rf = "★ ROOF / FLOOR — Ping Pong SR ★"
int rf_leftBars = input.int(5, "PP Swing — Left Bars", minval=1, group=grp_rf, tooltip="Pivot lookback used to promote a swing high/low into a structural level. HVD PBJ PPD default 5.")
int rf_rightBars = input.int(1, "PP Swing — Right Bars", minval=1, group=grp_rf, tooltip="Bars to the RIGHT required to confirm the pivot. HVD PBJ PPD default 1. Rolling — no fixed/anchored window.")
bool rf_useAtr = input.bool(true, "PP Swing — Use ATR Filter", group=grp_rf, tooltip="ON: a new swing level must sit at least (ATR × multiplier) away from the last accepted swing level, which stops level spam in chop.")
float rf_atrMult = input.float(2.0, "PP Swing — ATR Multiplier", step=0.1, group=grp_rf)
int rf_atrLen = input.int(100, "PP — ATR Length", minval=1, group=grp_rf)
int rf_minCandles = input.int(2, "PP — Flat-Level Candles", minval=1, group=grp_rf, tooltip="Consecutive candles whose body top (or bottom) agree within tolerance to mint a flat resistance (support) level.")
int rf_bufferTicks = input.int(10, "PP — Level Tolerance (ticks)", minval=1, group=grp_rf)
float rf_atrMultLv = input.float(2.0, "PP — Bounce Distance (ATR x)", step=0.1, group=grp_rf, tooltip="Distance price must travel away from a level before the move counts as a BOUNCE off that level.")
int rf_trendCnt = input.int(1, "PP — Bounce Candle Count", minval=1, group=grp_rf)
int rf_maxLevels = input.int(50, "PP — Max Levels", minval=1, group=grp_rf)
int rf_minCount = input.int(3, "PP — Min Gravity Count", minval=1, maxval=6, group=grp_rf, tooltip="How many of the 6 structural members must be true on the SAME candle for the side to carry structural gravity. HVD PBJ PPD default 3.")

type rf_srLevel
    float price
    int levelType
    int originType
    int state
    int count

var rf_levels = array.new<rf_srLevel>(0)
var int rf_lastBounceSide = 0
var string rf_lastBreakType = na
float rf_sig_bull_break = na, float rf_sig_bear_break = na
float rf_sig_res_bounce = na, float rf_sig_sup_bounce = na
float rf_sig_piv_bull = na, float rf_sig_piv_bear = na
float rf_sig_res_reject = na, float rf_sig_sup_reject = na
bool rf_bullRegime = false, bool rf_bearRegime = false

float rf_atr = ta.atr(rf_atrLen)
float rf_bodyTop = math.max(open, close), float rf_bodyBot = math.min(open, close)
float rf_tol = math.max(syminfo.mintick * rf_bufferTicks, syminfo.mintick / 10)
bool rf_newFlatRes = true, bool rf_newFlatSup = true
for i = 0 to rf_minCandles - 1
    if math.abs(math.max(open[i], close[i]) - rf_bodyTop) > rf_tol
        rf_newFlatRes := false
    if math.abs(math.min(open[i], close[i]) - rf_bodyBot) > rf_tol
        rf_newFlatSup := false

float rf_rawHigh = ta.pivothigh(high, rf_leftBars, rf_rightBars)
float rf_rawLow = ta.pivotlow(low, rf_leftBars, rf_rightBars)
var float rf_lastValidSwing = na
float rf_threshSwing = rf_useAtr ? (rf_atr * rf_atrMult) : 0

bool rf_validSwingHigh = false
if not na(rf_rawHigh)
    if na(rf_lastValidSwing) or math.abs(rf_rawHigh - rf_lastValidSwing) >= rf_threshSwing
        rf_validSwingHigh := true
        rf_lastValidSwing := rf_rawHigh
bool rf_validSwingLow = false
if not na(rf_rawLow)
    if na(rf_lastValidSwing) or math.abs(rf_rawLow - rf_lastValidSwing) >= rf_threshSwing
        rf_validSwingLow := true
        rf_lastValidSwing := rf_rawLow

rf_hasLevel(float _price, int _typeVal) =>
    bool found = false
    if array.size(rf_levels) > 0
        for i = 0 to array.size(rf_levels) - 1
            lv = array.get(rf_levels, i)
            if math.abs(lv.price - _price) <= rf_tol and lv.levelType == _typeVal
                found := true
                break
    found

if rf_newFlatRes and not rf_hasLevel(rf_bodyTop, 1)
    array.push(rf_levels, rf_srLevel.new(rf_bodyTop, 1, 0, 0, 0))
if rf_newFlatSup and not rf_hasLevel(rf_bodyBot, -1)
    array.push(rf_levels, rf_srLevel.new(rf_bodyBot, -1, 0, 0, 0))
if rf_validSwingHigh
    array.push(rf_levels, rf_srLevel.new(rf_rawHigh, 1, 1, 1, 0))
if rf_validSwingLow
    array.push(rf_levels, rf_srLevel.new(rf_rawLow, -1, 1, 1, 0))

if array.size(rf_levels) > 0
    for i = array.size(rf_levels) - 1 to 0
        lv = array.get(rf_levels, i)
        bool rf_removeLv = false
        if lv.levelType == 1
            if close > lv.price
                if lv.state == 1 or lv.originType == 1
                    rf_sig_bull_break := high
                    if rf_lastBreakType == "BD"
                        rf_bullRegime := true
                    rf_lastBreakType := "BO"
                rf_removeLv := true
            else
                if (lv.state == 1 or lv.originType == 1) and high >= lv.price
                    rf_sig_res_reject := high
                    lv.count := 0
                if lv.state == 0 or (lv.state == 1 and lv.count >= 0)
                    if close < open
                        lv.count += 1
                    if (lv.price - close) > (rf_atr * rf_atrMultLv) and lv.count >= rf_trendCnt
                        if lv.state == 0
                            lv.state := 1
                        lv.count := -1
                        rf_sig_res_bounce := high
                        if rf_lastBounceSide == 1
                            rf_sig_piv_bear := high
                        rf_lastBounceSide := -1
        else if lv.levelType == -1
            if close < lv.price
                if lv.state == 1 or lv.originType == 1
                    rf_sig_bear_break := low
                    if rf_lastBreakType == "BO"
                        rf_bearRegime := true
                    rf_lastBreakType := "BD"
                rf_removeLv := true
            else
                if (lv.state == 1 or lv.originType == 1) and low <= lv.price
                    rf_sig_sup_reject := low
                    lv.count := 0
                if lv.state == 0 or (lv.state == 1 and lv.count >= 0)
                    if close > open
                        lv.count += 1
                    if (close - lv.price) > (rf_atr * rf_atrMultLv) and lv.count >= rf_trendCnt
                        if lv.state == 0
                            lv.state := 1
                        lv.count := -1
                        rf_sig_sup_bounce := low
                        if rf_lastBounceSide == -1
                            rf_sig_piv_bull := low
                        rf_lastBounceSide := 1
        if rf_removeLv
            array.remove(rf_levels, i)

while array.size(rf_levels) > rf_maxLevels
    array.remove(rf_levels, 0)

int rf_bull_state = (rf_validSwingLow ? 32 : 0) + (not na(rf_sig_piv_bull) ? 16 : 0) + (rf_bullRegime ? 8 : 0) + (not na(rf_sig_sup_bounce) ? 4 : 0) + (not na(rf_sig_bull_break) ? 2 : 0) + (not na(rf_sig_res_reject) ? 1 : 0)
int rf_bull_cnt = (rf_validSwingLow ? 1 : 0) + (not na(rf_sig_piv_bull) ? 1 : 0) + (rf_bullRegime ? 1 : 0) + (not na(rf_sig_sup_bounce) ? 1 : 0) + (not na(rf_sig_bull_break) ? 1 : 0) + (not na(rf_sig_res_reject) ? 1 : 0)
bool rf_bull_gravity = (rf_bull_state % 8 >= 4) or (rf_bull_state % 32 >= 16) or (rf_bull_state >= 32)
int rf_bear_state = (rf_validSwingHigh ? 32 : 0) + (not na(rf_sig_piv_bear) ? 16 : 0) + (rf_bearRegime ? 8 : 0) + (not na(rf_sig_res_bounce) ? 4 : 0) + (not na(rf_sig_bear_break) ? 2 : 0) + (not na(rf_sig_sup_reject) ? 1 : 0)
int rf_bear_cnt = (rf_validSwingHigh ? 1 : 0) + (not na(rf_sig_piv_bear) ? 1 : 0) + (rf_bearRegime ? 1 : 0) + (not na(rf_sig_res_bounce) ? 1 : 0) + (not na(rf_sig_bear_break) ? 1 : 0) + (not na(rf_sig_sup_reject) ? 1 : 0)
bool rf_bear_gravity = (rf_bear_state % 8 >= 4) or (rf_bear_state % 32 >= 16) or (rf_bear_state >= 32)
bool rf_bull_pp = rf_bull_cnt >= rf_minCount and rf_bull_gravity and rf_bull_state > 0
bool rf_bear_pp = rf_bear_cnt >= rf_minCount and rf_bear_gravity and rf_bear_state > 0

// ROOF / PENTHOUSE / FLOOR / 2nd FLOOR — HVD PBJ PPD L737-745 parity, FABLE atom names.
// Side-symmetric 4-term root definitions (E-1: side comes from the explicit Bull/Bear key).
// The HVD bull-side extra gates (oneOfThese / cb1_pass) are NOT ported: their job was to
// demand a co-occurring qualifier, which the "+ ANY FABLE" conjunct below does natively —
// porting them would have broken bull/bear symmetry and dragged in ~15 bull-only engines.
bool rf_nag_dir_bull = det_RVOL1xB or det_GrandSlam or sigFAUNABull or d9_bull or sigBullPBJ or sigPUP or gz_bullHV or gz_bullGZI
bool rf_nag_dir_bear = det_RVOL1xR or det_MOAB or sigFAUNABear or d9_bear or sigBearPBJ or sigPPD or gz_bearHV or gz_bearGZI
bool rf_bull_hw_slot = det_RVOL1xB or det_GrandSlam or det_WTC or det_Hiroshima or (sigNagasaki and rf_nag_dir_bull)
bool rf_bear_hw_slot = det_RVOL1xR or det_MOAB or det_WTC or det_Hiroshima or (sigNagasaki and rf_nag_dir_bear)

// ═══ [v4.7] STRUCTURE+ANY SR LANES — FLOOR+ANY SR / 2F+ANY SR ═══
grpST = "★ STRUCTURE+ANY SR — FLOOR+ANY SR / 2F+ANY SR (rf_ engine) ★"
vsFLR = input.bool(true, "VP FLR+A: BULL FLOOR+ANY SR", group=grpST)
vs2F = input.bool(true, "VP 2F+A: BULL 2ND FLOOR+ANY SR", group=grpST)
asFLR = input.bool(true, "ALERT FLR+A: BULL FLOOR+ANY SR", group=grpST)
as2F = input.bool(true, "ALERT 2F+A: BULL 2ND FLOOR+ANY SR", group=grpST)
bool sig_sFLR = conf and rf_bull_pp and sigBullPBJ and rf_bull_hw_slot and anyComboBULL and kccReqB
bool fire_sFLR = vsFLR and sig_sFLR
bool alf_sFLR = asFLR and sig_sFLR
bool sig_s2F = conf and rf_bull_pp and sigBullPB and rf_bull_hw_slot and anyComboBULL and kccReqB
bool fire_s2F = vs2F and sig_s2F
bool alf_s2F = as2F and sig_s2F
// ═══ [v4.7] STRUCTURE+ANY SR LANES — ROOF+ANY SR / PH+ANY SR ═══
grpSTR = "★ STRUCTURE+ANY SR — ROOF+ANY SR / PH+ANY SR (rf_ engine) ★"
vsROOF = input.bool(true, "VP ROOF+A: BEAR ROOF+ANY SR", group=grpSTR)
vs2PH = input.bool(true, "VP PH+A: BEAR PENTHOUSE+ANY SR", group=grpSTR)
asROOF = input.bool(true, "ALERT ROOF+A: BEAR ROOF+ANY SR", group=grpSTR)
as2PH = input.bool(true, "ALERT PH+A: BEAR PENTHOUSE+ANY SR", group=grpSTR)
bool sig_sROOF = conf and rf_bear_pp and sigBearPBJ and rf_bear_hw_slot and anyComboBEAR and kccReqR
bool fire_sROOF = vsROOF and sig_sROOF
bool alf_sROOF = asROOF and sig_sROOF
bool sig_s2PH = conf and rf_bear_pp and sigBearPB and rf_bear_hw_slot and anyComboBEAR and kccReqR
bool fire_s2PH = vs2PH and sig_s2PH
bool alf_s2PH = as2PH and sig_s2PH
// ═══ [v5.2] STRUCTURE+R+FAUNA LANES (operator order 2026-08-14) — structure atom
// (FLOOR/2F = rf pocket-pivot + PBJ/PB bull; ROOF/PH = rf pocket-pivot + PBJ/PB bear)
// + RVOL tier menu (bull SAAB/1X/GS; bear KRATOS/1X/MOAB) + ANY R-lane (R1/R2/R3 same
// side) + FAUNA — every leg on the same confirmed candle. Sig bools live after the
// R-lane block (declaration order); inputs here with their structure siblings. ═══
grpSF = "★ STRUCTURE+R+FAUNA — FLR.F / 2F.F / ROOF.F / PH.F ★"
vfFLR = input.bool(true, "VP FLR.F: BULL FLOOR+SAAB/1X/GS+ANY R+FAUNA", group=grpSF)
vf2F = input.bool(true, "VP 2F.F: BULL 2ND FLOOR+SAAB/1X/GS+ANY R+FAUNA", group=grpSF)
afFLR = input.bool(true, "ALERT FLR.F: BULL FLOOR+SAAB/1X/GS+ANY R+FAUNA", group=grpSF)
af2F = input.bool(true, "ALERT 2F.F: BULL 2ND FLOOR+SAAB/1X/GS+ANY R+FAUNA", group=grpSF)
vfROOF = input.bool(true, "VP ROOF.F: BEAR ROOF+KRATOS/1X/MOAB+ANY R+FAUNA", group=grpSF)
vfPH = input.bool(true, "VP PH.F: BEAR PENTHOUSE+KRATOS/1X/MOAB+ANY R+FAUNA", group=grpSF)
afROOF = input.bool(true, "ALERT ROOF.F: BEAR ROOF+KRATOS/1X/MOAB+ANY R+FAUNA", group=grpSF)
afPH = input.bool(true, "ALERT PH.F: BEAR PENTHOUSE+KRATOS/1X/MOAB+ANY R+FAUNA", group=grpSF)
// ═══ VISUAL PLOTS — 28 dp (14 per side); + 8 alertcondition = 64/64 ═══
plotshape(fire_a01, title="BULL H.A: HVD+ANY SR", style=shape.arrowup, location=location.top, color=#66A3FF, size=size.small, text="H.A", textcolor=color.white, offset=0)
plotshape(fire_a02, title="BULL UC.A: UC+ANY SR", style=shape.arrowup, location=location.top, color=#528FEB, size=size.small, text="UC.A", textcolor=color.white, offset=0)
plotshape(fire_a13, title="BULL SA.A: SAAB+ANY SR", style=shape.arrowup, location=location.top, color=#99C2FF, size=size.small, text="SA.A", textcolor=color.white, offset=0)
plotshape(fire_a14, title="BULL 1X.A: RVOL 1X+ANY SR", style=shape.arrowup, location=location.top, color=#7FB0FF, size=size.small, text="1X.A", textcolor=color.white, offset=0)
plotshape(fire_a15, title="BULL GS.A: GRAND SLAM+ANY SR", style=shape.arrowup, location=location.top, color=#4785E0, size=size.small, text="GS.A", textcolor=color.white, offset=0)
plotshape(fire_a16, title="BULL N.A: NAGA+ANY SR", style=shape.arrowup, location=location.top, color=#1F5CB8, size=size.small, text="N.A", textcolor=color.white, offset=0)
plotshape(fire_a17, title="BULL HW.A: TYPH/MUSA/WHALE+ANY SR", style=shape.arrowup, location=location.top, color=#0A47A3, size=size.small, text="HW.A", textcolor=color.white, offset=0)
plotshape(fire_a07, title="BEAR H.A: HVD+ANY SR", style=shape.arrowdown, location=location.top, color=#FF33FF, size=size.small, text="H.A", textcolor=color.white, offset=0)
plotshape(fire_a08, title="BEAR UC.A: UC+ANY SR", style=shape.arrowdown, location=location.top, color=#E629E6, size=size.small, text="UC.A", textcolor=color.white, offset=0)
plotshape(fire_a18, title="BEAR KR.A: KRATOS+ANY SR", style=shape.arrowdown, location=location.top, color=#FF80FF, size=size.small, text="KR.A", textcolor=color.white, offset=0)
plotshape(fire_a19, title="BEAR 1X.A: RVOL 1X+ANY SR", style=shape.arrowdown, location=location.top, color=#DB4DDB, size=size.small, text="1X.A", textcolor=color.white, offset=0)
plotshape(fire_a20, title="BEAR MB.A: MOAB+ANY SR", style=shape.arrowdown, location=location.top, color=#A314A3, size=size.small, text="MB.A", textcolor=color.white, offset=0)
plotshape(fire_a21, title="BEAR N.A: NAGA+ANY SR", style=shape.arrowdown, location=location.top, color=#8A0F8A, size=size.small, text="N.A", textcolor=color.white, offset=0)
plotshape(fire_a22, title="BEAR HW.A: TYPH/MUSA/WHALE+ANY SR", style=shape.arrowdown, location=location.top, color=#5C005C, size=size.small, text="HW.A", textcolor=color.white, offset=0)
// ═══ [v5.0] R-LANES — PBJ+RS+RC × RVOL tier, BOTH SIDES (shared coalescence window) ═══
grpR = "★ R-LANES — PBJ+RS+RC × RVOL tier (coalescence window) ★"
int rWin = input.int(1, "R-lane coalescence window (bars; 1 = same candle)", minval=1, group=grpR, tooltip="All four legs (PBJ, RS, RC, RVOL tier) must have fired within the last N bars. Operator setting 2026-08-11: 1 = strict same-candle. Shared by both sides.")
vr1B = input.bool(true, "VP R1: BULL PBJ+RS+RC+SAAB", group=grpR)
vr2B = input.bool(true, "VP R2: BULL PBJ+RS+RC+RVOL 1X", group=grpR)
vr3B = input.bool(true, "VP R3: BULL PBJ+RS+RC+GRAND SLAM", group=grpR)
ar1B = input.bool(true, "ALERT R1: BULL PBJ+RS+RC+SAAB", group=grpR)
ar2B = input.bool(true, "ALERT R2: BULL PBJ+RS+RC+RVOL 1X", group=grpR)
ar3B = input.bool(true, "ALERT R3: BULL PBJ+RS+RC+GRAND SLAM", group=grpR)
vr1R = input.bool(true, "VP R1: BEAR PBJ+RS+RC+KRATOS", group=grpR)
vr2R = input.bool(true, "VP R2: BEAR PBJ+RS+RC+RVOL 1X", group=grpR)
vr3R = input.bool(true, "VP R3: BEAR PBJ+RS+RC+MOAB", group=grpR)
ar1R = input.bool(true, "ALERT R1: BEAR PBJ+RS+RC+KRATOS", group=grpR)
ar2R = input.bool(true, "ALERT R2: BEAR PBJ+RS+RC+RVOL 1X", group=grpR)
ar3R = input.bool(true, "ALERT R3: BEAR PBJ+RS+RC+MOAB", group=grpR)
int rbsJB = ta.barssince(sigBullPBJ)
int rbsSB = ta.barssince(sigBullReSlope)
int rbsCB = ta.barssince(sigBullReCross)
int rbsT1B = ta.barssince(det_SAAB)
int rbsT2B = ta.barssince(det_RVOL1xB)
int rbsT3B = ta.barssince(det_GrandSlam)
bool rRaw1B = rbsJB <= rWin - 1 and rbsSB <= rWin - 1 and rbsCB <= rWin - 1 and rbsT1B <= rWin - 1
bool rRaw2B = rbsJB <= rWin - 1 and rbsSB <= rWin - 1 and rbsCB <= rWin - 1 and rbsT2B <= rWin - 1
bool rRaw3B = rbsJB <= rWin - 1 and rbsSB <= rWin - 1 and rbsCB <= rWin - 1 and rbsT3B <= rWin - 1
bool sig_r1B = conf and rRaw1B and not rRaw1B[1] and kccReqB
bool fire_r1B = vr1B and sig_r1B
bool alf_r1B = ar1B and sig_r1B
bool sig_r2B = conf and rRaw2B and not rRaw2B[1] and kccReqB
bool fire_r2B = vr2B and sig_r2B
bool alf_r2B = ar2B and sig_r2B
bool sig_r3B = conf and rRaw3B and not rRaw3B[1] and kccReqB
bool fire_r3B = vr3B and sig_r3B
bool alf_r3B = ar3B and sig_r3B
int rbsJR = ta.barssince(sigBearPBJ)
int rbsSR = ta.barssince(sigBearReSlope)
int rbsCR = ta.barssince(sigBearReCross)
int rbsT1R = ta.barssince(det_Kratos)
int rbsT2R = ta.barssince(det_RVOL1xR)
int rbsT3R = ta.barssince(det_MOAB)
bool rRaw1R = rbsJR <= rWin - 1 and rbsSR <= rWin - 1 and rbsCR <= rWin - 1 and rbsT1R <= rWin - 1
bool rRaw2R = rbsJR <= rWin - 1 and rbsSR <= rWin - 1 and rbsCR <= rWin - 1 and rbsT2R <= rWin - 1
bool rRaw3R = rbsJR <= rWin - 1 and rbsSR <= rWin - 1 and rbsCR <= rWin - 1 and rbsT3R <= rWin - 1
bool sig_r1R = conf and rRaw1R and not rRaw1R[1] and kccReqR
bool fire_r1R = vr1R and sig_r1R
bool alf_r1R = ar1R and sig_r1R
bool sig_r2R = conf and rRaw2R and not rRaw2R[1] and kccReqR
bool fire_r2R = vr2R and sig_r2R
bool alf_r2R = ar2R and sig_r2R
bool sig_r3R = conf and rRaw3R and not rRaw3R[1] and kccReqR
bool fire_r3R = vr3R and sig_r3R
bool alf_r3R = ar3R and sig_r3R
// [v5.2] STRUCTURE+R+FAUNA sig bools — every leg same confirmed candle.
bool kcc_anyR_B = sig_r1B or sig_r2B or sig_r3B
bool kcc_anyR_R = sig_r1R or sig_r2R or sig_r3R
bool kcc_tierB = det_SAAB or det_RVOL1xB or det_GrandSlam
bool kcc_tierR = det_Kratos or det_RVOL1xR or det_MOAB
bool sig_fFLR = conf and rf_bull_pp and sigBullPBJ and kcc_tierB and kcc_anyR_B and sigFAUNABull and kccReqB
bool fire_fFLR = vfFLR and sig_fFLR
bool alf_fFLR = afFLR and sig_fFLR
bool sig_f2F = conf and rf_bull_pp and sigBullPB and kcc_tierB and kcc_anyR_B and sigFAUNABull and kccReqB
bool fire_f2F = vf2F and sig_f2F
bool alf_f2F = af2F and sig_f2F
bool sig_fROOF = conf and rf_bear_pp and sigBearPBJ and kcc_tierR and kcc_anyR_R and sigFAUNABear and kccReqR
bool fire_fROOF = vfROOF and sig_fROOF
bool alf_fROOF = afROOF and sig_fROOF
bool sig_fPH = conf and rf_bear_pp and sigBearPB and kcc_tierR and kcc_anyR_R and sigFAUNABear and kccReqR
bool fire_fPH = vfPH and sig_fPH
bool alf_fPH = afPH and sig_fPH
plotshape(fire_r1B, title="BULL R1: PBJ+RS+RC+SAAB", style=shape.circle, location=location.bottom, color=#00E5FF, size=size.small, text="R1", textcolor=color.white, offset=0)
plotshape(fire_r2B, title="BULL R2: PBJ+RS+RC+RVOL 1X", style=shape.diamond, location=location.bottom, color=#00B0FF, size=size.small, text="R2", textcolor=color.white, offset=0)
plotshape(fire_r3B, title="BULL R3: PBJ+RS+RC+GRAND SLAM", style=shape.square, location=location.bottom, color=#1DE9B6, size=size.small, text="R3", textcolor=color.white, offset=0)
plotshape(fire_r1R, title="BEAR R1: PBJ+RS+RC+KRATOS", style=shape.circle, location=location.top, color=#FF5252, size=size.small, text="R1", textcolor=color.white, offset=0)
plotshape(fire_r2R, title="BEAR R2: PBJ+RS+RC+RVOL 1X", style=shape.diamond, location=location.top, color=#FF4081, size=size.small, text="R2", textcolor=color.white, offset=0)
plotshape(fire_r3R, title="BEAR R3: PBJ+RS+RC+MOAB", style=shape.square, location=location.top, color=#D500F9, size=size.small, text="R3", textcolor=color.white, offset=0)
alertcondition(sig_r1B, title="BULL R1: PBJ+RS+RC+SAAB", message="R1 BULL PBJ+RS+RC+SAAB on {{ticker}}")
alertcondition(sig_r2B, title="BULL R2: PBJ+RS+RC+RVOL 1X", message="R2 BULL PBJ+RS+RC+RVOL 1X on {{ticker}}")
alertcondition(sig_r3B, title="BULL R3: PBJ+RS+RC+GRAND SLAM", message="R3 BULL PBJ+RS+RC+GRAND SLAM on {{ticker}}")
alertcondition(sig_r1R, title="BEAR R1: PBJ+RS+RC+KRATOS", message="R1 BEAR PBJ+RS+RC+KRATOS on {{ticker}}")
alertcondition(sig_r2R, title="BEAR R2: PBJ+RS+RC+RVOL 1X", message="R2 BEAR PBJ+RS+RC+RVOL 1X on {{ticker}}")
alertcondition(sig_r3R, title="BEAR R3: PBJ+RS+RC+MOAB", message="R3 BEAR PBJ+RS+RC+MOAB on {{ticker}}")
plotshape(fire_sFLR, title="BULL FLR+A: FLOOR+ANY SR", style=shape.labelup, location=location.top, color=#D6E8FF, size=size.small, text="FLR+A", textcolor=color.white, offset=0)
plotshape(fire_s2F, title="BULL 2F+A: 2ND FLOOR+ANY SR", style=shape.flag, location=location.top, color=#6FA8FF, size=size.small, text="2F+A", textcolor=color.white, offset=0)
plotshape(fire_sROOF, title="BEAR ROOF+A: ROOF+ANY SR", style=shape.labeldown, location=location.top, color=#FFB3C1, size=size.small, text="ROOF+A", textcolor=color.white, offset=0)
plotshape(fire_s2PH, title="BEAR PH+A: PENTHOUSE+ANY SR", style=shape.triangledown, location=location.top, color=#FF5C7A, size=size.small, text="PH+A", textcolor=color.white, offset=0)
// [v5.2] STRUCTURE+R+FAUNA — 4 new dp (belowbar/abovebar rows are unclaimed = zero identity collisions)
plotshape(fire_fFLR, title="BULL FLR.F: FLOOR+SAAB/1X/GS+ANY R+FAUNA", style=shape.labelup, location=location.belowbar, color=#2979FF, size=size.small, text="FLR.F", textcolor=color.white, offset=0)
plotshape(fire_f2F, title="BULL 2F.F: 2ND FLOOR+SAAB/1X/GS+ANY R+FAUNA", style=shape.triangleup, location=location.belowbar, color=#40C4FF, size=size.small, text="2F.F", textcolor=color.white, offset=0)
plotshape(fire_fROOF, title="BEAR ROOF.F: ROOF+KRATOS/1X/MOAB+ANY R+FAUNA", style=shape.labeldown, location=location.abovebar, color=#FF6090, size=size.small, text="ROOF.F", textcolor=color.white, offset=0)
plotshape(fire_fPH, title="BEAR PH.F: PENTHOUSE+KRATOS/1X/MOAB+ANY R+FAUNA", style=shape.triangledown, location=location.abovebar, color=#C51162, size=size.small, text="PH.F", textcolor=color.white, offset=0)
// ═══ [v5.0] NUMERIC READOUTS — abs values on fired candles (operator rounding law:
// DISP 1 decimal / HV 0 decimals / RVOL integer). Engine offsets disclosed: DISP reads
// the [1] displacement bar; HV deepest-N reads volume[1]; RVOL is current-bar rv_normPrice.
bool firedBULL = fire_a01 or fire_a02 or fire_a13 or fire_a14 or fire_a15 or fire_a16 or fire_a17 or fire_r1B or fire_r2B or fire_r3B or fire_sFLR or fire_s2F
bool firedBEAR = fire_a07 or fire_a08 or fire_a18 or fire_a19 or fire_a20 or fire_a21 or fire_a22 or fire_r1R or fire_r2R or fire_r3R or fire_sROOF or fire_s2PH
float kcDispQty = disp_std[1] > 0 ? math.round(math.abs(disp_rng[1] / disp_std[1]) * 10) / 10 : na
float kcHvQty = baseRank > 0 ? baseRank : na
float kcRvolQty = math.round(math.abs(rv_normPrice))
// ═══ ALERTS — 2 ANY SR alertconditions + consolidated per-side alert() (0 units) ═══
bool anyIncludedBULL = alf_a01 or alf_a02 or alf_a13 or alf_a14 or alf_a15 or alf_a16 or alf_a17 or alf_r1B or alf_r2B or alf_r3B or alf_sFLR or alf_s2F or alf_fFLR or alf_f2F
bool anyIncludedBEAR = alf_a07 or alf_a08 or alf_a18 or alf_a19 or alf_a20 or alf_a21 or alf_a22 or alf_r1R or alf_r2R or alf_r3R or alf_sROOF or alf_s2PH or alf_fROOF or alf_fPH
alertcondition(anyIncludedBULL, title="ANY SR BULL KC", message="ANY SR BULL KC (KC COMBO SR (28 dp, BULL+BEAR, +ANY SR) v5.3) fired on {{ticker}}")
alertcondition(anyIncludedBEAR, title="ANY SR BEAR KC", message="ANY SR BEAR KC (KC COMBO SR (28 dp, BULL+BEAR, +ANY SR) v5.3) fired on {{ticker}}")
