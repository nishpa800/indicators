f_bloomberg_t3(string sig, string tier, int sens_val, string dir, float bp, float sp, float slope_v) =>
    "T3_SIGNAL|SIG:" + sig + "|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:" + dir + "|TIER:" + tier + "|SENS:" + str.tostring(sens_val) + "|VOL:" + str.tostring(math.round(volume)) + "|POOL_BULL:" + str.tostring(math.round(bp)) + "|POOL_BEAR:" + str.tostring(math.round(sp)) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail

// T3 alert multiplexer
if al_t3_buy_a and sig_t3_buy_a
    alert(f_bloomberg_t3("T3_SUPER_BUY", "A", sens_a, "BULL", bpa, spa, slope_ema_a), alert.freq_once_per_bar_close)
if al_t3_sell_a and sig_t3_sell_a
    alert(f_bloomberg_t3("T3_SUPER_SELL", "A", sens_a, "BEAR", bpa, spa, slope_ema_a), alert.freq_once_per_bar_close)
if al_t3_buy_b and sig_t3_buy_b
