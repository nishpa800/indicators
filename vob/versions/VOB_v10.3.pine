bool any_zone = sig_zb_a or sig_zs_a or sig_zb_b or sig_zs_b or sig_zb_c or sig_zs_c or sig_zb_d or sig_zs_d or sig_zb_e or sig_zs_e or sig_zb_f or sig_zs_f
alertcondition(any_zone, "Any Zone Formation", "VOB zone formation event — new bullish or bearish zone created at any sensitivity tier")

// v10.2: per-tier zone-formation alerts (v11.2 alert approach) replace the
