    cd_zb_d := bar_index
if sig_zs_d
    cd_zs_d := bar_index
if sig_zb_e
    cd_zb_e := bar_index
if sig_zs_e
    cd_zs_e := bar_index
if sig_zb_f
    cd_zb_f := bar_index
if sig_zs_f
    cd_zs_f := bar_index

// History tracking
if sig_zb_a and lower_a.size() > 0
    level nz = lower_a.last()
    if not na(nz.vol)
        f_push_hist(hb_a, nz.vol, bpa, hist_depth)
if sig_zs_a and upper_a.size() > 0
    level nz = upper_a.last()
    if not na(nz.vol)
        f_push_hist(hs_a, nz.vol, spa, hist_depth)
if sig_zb_b and lower_b.size() > 0
