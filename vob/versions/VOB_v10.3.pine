if al_zb_a and sig_zb_a
    alert("ZONE_FORM_A_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|TIER:A|SENS:" + str.tostring(sens_a) + "|POOL:" + str.tostring(math.round(bpa)) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_zs_a and sig_zs_a
    alert("ZONE_FORM_A_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|TIER:A|SENS:" + str.tostring(sens_a) + "|POOL:" + str.tostring(math.round(spa)) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_zb_b and sig_zb_b
    alert("ZONE_FORM_B_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|TIER:B|SENS:" + str.tostring(sens_b) + "|POOL:" + str.tostring(math.round(bpb)) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
