bool vp_step_any_b    = input.bool(true, "Plot: Stepwise HV Bull (any depth ×3)",        group = GV, tooltip = "Three consecutive stepwise-RISING closes where EACH candle holds at least one of the 2K/3K/4K high-volume records (containment theorem: any-of ≡ 2K record). Fires on the third candle.")
bool vp_step_naga_b   = input.bool(true, "Plot: Stepwise HV + Nagasaki Bull",            group = GV, tooltip = "Stepwise HV Bull (any depth ×3) AND at least one of the three candles is the Nagasaki all-time-high volume event. Fires on the third candle.")
bool vp_step_strict_s = input.bool(true, "Plot: Stepwise HV Ladder Bear (2K→3K→4K)",     group = GV, tooltip = "Three consecutive stepwise-FALLING closes where the oldest candle is a 2K-bar high-volume record, the middle a 3K record, and this candle a 4K record. Fires on the third candle.")
bool vp_step_any_s    = input.bool(true, "Plot: Stepwise HV Bear (any depth ×3)",        group = GV, tooltip = "Three consecutive stepwise-FALLING closes where EACH candle holds at least one of the 2K/3K/4K high-volume records (containment theorem: any-of ≡ 2K record). Fires on the third candle.")
bool vp_step_naga_s   = input.bool(true, "Plot: Stepwise HV + Nagasaki Bear",            group = GV, tooltip = "Stepwise HV Bear (any depth ×3) AND at least one of the three candles is the Nagasaki all-time-high volume event. Fires on the third candle.")

