bool det_lvl3_b = lvl_match_b == 3 and barstate.isconfirmed and f_cd_ok(last_lvl3_b, cooldown_bars)
bool det_lvl4_b = lvl_match_b >= 4 and barstate.isconfirmed and f_cd_ok(last_lvl4_b, cooldown_bars)
bool det_lvl2_s = lvl_match_s == 2 and barstate.isconfirmed and f_cd_ok(last_lvl2_s, cooldown_bars)
bool det_lvl3_s = lvl_match_s == 3 and barstate.isconfirmed and f_cd_ok(last_lvl3_s, cooldown_bars)
bool det_lvl4_s = lvl_match_s >= 4 and barstate.isconfirmed and f_cd_ok(last_lvl4_s, cooldown_bars)
