// ═══════════════════════════════════════════════════════════════════════════════
// v10.3 STEPWISE HV LAYER — 6 new lanes (operator dictation 2026-08-07)
// ═══════════════════════════════════════════════════════════════════════════════
// DECLARED CONSTRUCTION (definitional referent — the definition IS the standard):
//   PATTERN WINDOW  = three consecutive confirmed candles: c2 (oldest), c1,
//                     c0 (this candle — the lane fires here).
//   STEPWISE RISING = close(c2) < close(c1) < close(c0), strict inequalities.
//                     Bear mirror: STEPWISE FALLING = close(c2) > close(c1) > close(c0).
//   HV RECORD(n)    = volume == ta.highest(volume, n), evaluated at that
//                     candle's own bar. 2K: n = n_2k. 3K: n = n_3k. 4K: n = n_4k.
//   CONTAINMENT THEOREM: 4K record ⟹ 3K record ⟹ 2K record (a volume equal to
//                     the 4000-bar max also equals the 3000- and 2000-bar max),
//                     so "any of 2K/3K/4K" ≡ "2K record". The union is still
//                     written out so the definition reads exactly as dictated.
//   NAGASAKI(c)     = volume(c) > maxVolEver at c — the all-time-high volume
//                     event, same record-keeper as the Nagasaki + ANY lane.
//
//   LANE 1 STRICT LADDER (2K→3K→4K): STEPWISE and c2 is a 2K record and c1 is
//          a 3K record and c0 is a 4K record — record depth escalates with price.
//   LANE 2 ANY ×3: STEPWISE and EVERY one of c2/c1/c0 holds ≥1 of the records.
//   LANE 3 +NAGASAKI: LANE 2 and at least one of c2/c1/c0 is NAGASAKI.
//
//   Each lane fires IFF its predicate holds (bar-close confirmed, study-wide
//   cooldown like every lane in this study). Lanes overlap by construction
//   (STRICT ⊂ ANY, NAGA ⊂ ANY): one candle can lawfully carry L + Y + N glyphs
//   stacked; the three glyphs are visually distinct (visual-identity law).

bool hv2k_now = volume == ta.highest(volume, n_2k)
bool hv3k_now = volume == ta.highest(volume, n_3k)
bool hv_any_now = hv2k_now or hv3k_now or hv4k_now

bool step_rise = close > close[1] and close[1] > close[2]
bool step_fall = close < close[1] and close[1] < close[2]
bool naga_any3 = nag_now or nag_now[1] or nag_now[2]

bool step_strict_b_raw = step_rise and hv2k_now[2] and hv3k_now[1] and hv4k_now
bool step_any_b_raw    = step_rise and hv_any_now[2] and hv_any_now[1] and hv_any_now
bool step_naga_b_raw   = step_any_b_raw and naga_any3
bool step_strict_s_raw = step_fall and hv2k_now[2] and hv3k_now[1] and hv4k_now
bool step_any_s_raw    = step_fall and hv_any_now[2] and hv_any_now[1] and hv_any_now
bool step_naga_s_raw   = step_any_s_raw and naga_any3

var int last_step_strict_b = na
var int last_step_any_b    = na
var int last_step_naga_b   = na
var int last_step_strict_s = na
var int last_step_any_s    = na
var int last_step_naga_s   = na

bool det_step_strict_b = step_strict_b_raw and barstate.isconfirmed and f_cd_ok(last_step_strict_b, cooldown_bars)
bool det_step_any_b    = step_any_b_raw    and barstate.isconfirmed and f_cd_ok(last_step_any_b,    cooldown_bars)
bool det_step_naga_b   = step_naga_b_raw   and barstate.isconfirmed and f_cd_ok(last_step_naga_b,   cooldown_bars)
bool det_step_strict_s = step_strict_s_raw and barstate.isconfirmed and f_cd_ok(last_step_strict_s, cooldown_bars)
bool det_step_any_s    = step_any_s_raw    and barstate.isconfirmed and f_cd_ok(last_step_any_s,    cooldown_bars)
bool det_step_naga_s   = step_naga_s_raw   and barstate.isconfirmed and f_cd_ok(last_step_naga_s,   cooldown_bars)

if det_step_strict_b
    last_step_strict_b := bar_index
if det_step_any_b
    last_step_any_b := bar_index
if det_step_naga_b
    last_step_naga_b := bar_index
if det_step_strict_s
    last_step_strict_s := bar_index
if det_step_any_s
    last_step_any_s := bar_index
if det_step_naga_s
    last_step_naga_s := bar_index

// ─── VISUAL PLOTCHARS — unique glyph + location per lane (visual-identity law)
// L = strict Ladder, Y = anY-depth, N = +Nagasaki. Bull below bar, bear above.
plotchar(det_step_strict_b and vp_step_strict_b, "Stepwise HV Ladder Bull (2K→3K→4K)", char = "L", location = location.belowbar, color = #00e676, size = size.large, text = "STEP HV\nBULL", textcolor = #00e676)
plotchar(det_step_any_b and vp_step_any_b,       "Stepwise HV Bull (any depth ×3)",    char = "Y", location = location.belowbar, color = #69f0ae, size = size.large, text = "STEP ANY\nBULL", textcolor = #69f0ae)
plotchar(det_step_naga_b and vp_step_naga_b,     "Stepwise HV + Nagasaki Bull",        char = "N", location = location.belowbar, color = #c6ff00, size = size.large, text = "STEP NAGA\nBULL", textcolor = #c6ff00)
plotchar(det_step_strict_s and vp_step_strict_s, "Stepwise HV Ladder Bear (2K→3K→4K)", char = "L", location = location.abovebar, color = #ff5252, size = size.large, text = "STEP HV\nBEAR", textcolor = #ff5252)
plotchar(det_step_any_s and vp_step_any_s,       "Stepwise HV Bear (any depth ×3)",    char = "Y", location = location.abovebar, color = #ff8a80, size = size.large, text = "STEP ANY\nBEAR", textcolor = #ff8a80)
plotchar(det_step_naga_s and vp_step_naga_s,     "Stepwise HV + Nagasaki Bear",        char = "N", location = location.abovebar, color = #ff6d00, size = size.large, text = "STEP NAGA\nBEAR", textcolor = #ff6d00)

// ─── ALERTCONDITIONS ────────────────────────────────────────────────────────
alertcondition(det_step_strict_b and al_step_strict_b, "Stepwise HV Ladder Bull (2K→3K→4K)", "BULLISH — three stepwise-rising closes; the oldest candle is a 2K high-volume record, the middle a 3K record, this candle a 4K record.")
alertcondition(det_step_any_b and al_step_any_b,       "Stepwise HV Bull (any depth ×3)",    "BULLISH — three stepwise-rising closes; every one of the three candles holds at least one of the 2K/3K/4K high-volume records.")
alertcondition(det_step_naga_b and al_step_naga_b,     "Stepwise HV + Nagasaki Bull",        "BULLISH — stepwise HV (any depth ×3) and at least one of the three candles is the Nagasaki all-time-high volume event.")
alertcondition(det_step_strict_s and al_step_strict_s, "Stepwise HV Ladder Bear (2K→3K→4K)", "BEARISH — three stepwise-falling closes; the oldest candle is a 2K high-volume record, the middle a 3K record, this candle a 4K record.")
alertcondition(det_step_any_s and al_step_any_s,       "Stepwise HV Bear (any depth ×3)",    "BEARISH — three stepwise-falling closes; every one of the three candles holds at least one of the 2K/3K/4K high-volume records.")
alertcondition(det_step_naga_s and al_step_naga_s,     "Stepwise HV + Nagasaki Bear",        "BEARISH — stepwise HV (any depth ×3) and at least one of the three candles is the Nagasaki all-time-high volume event.")

// ─── ALERT EMISSIONS — plain names, each candle's role spelled out ──────────
f_hv_depth_name(bool h4, bool h3, bool h2, bool ng) =>
    ng ? "Nagasaki all-time high" : h4 ? "4K high volume" : h3 ? "3K high volume" : h2 ? "2K high volume" : "no record"

f_step_candles() =>
    " Candles: " + str.tostring(math.round(close[2] * 100) / 100) + " (" + f_hv_depth_name(hv4k_now[2], hv3k_now[2], hv2k_now[2], nag_now[2]) + ", vol " + str.tostring(math.round(volume[2])) + ") → " + str.tostring(math.round(close[1] * 100) / 100) + " (" + f_hv_depth_name(hv4k_now[1], hv3k_now[1], hv2k_now[1], nag_now[1]) + ", vol " + str.tostring(math.round(volume[1])) + ") → " + str.tostring(math.round(close * 100) / 100) + " (" + f_hv_depth_name(hv4k_now, hv3k_now, hv2k_now, nag_now) + ", vol " + str.tostring(math.round(volume)) + ")."

if det_step_strict_b and al_step_strict_b
    alert("BULLISH — STEPWISE HV LADDER 2K→3K→4K. Three rising closes with escalating volume records." + f_step_candles(), alert.freq_once_per_bar_close)
if det_step_any_b and al_step_any_b
    alert("BULLISH — STEPWISE HV, any depth on all three. Three rising closes, every candle a 2K-or-deeper volume record." + f_step_candles(), alert.freq_once_per_bar_close)
if det_step_naga_b and al_step_naga_b
    alert("BULLISH — STEPWISE HV + NAGASAKI. Three rising closes, every candle a volume record, one of them the all-time high." + f_step_candles(), alert.freq_once_per_bar_close)
if det_step_strict_s and al_step_strict_s
    alert("BEARISH — STEPWISE HV LADDER 2K→3K→4K. Three falling closes with escalating volume records." + f_step_candles(), alert.freq_once_per_bar_close)
if det_step_any_s and al_step_any_s
    alert("BEARISH — STEPWISE HV, any depth on all three. Three falling closes, every candle a 2K-or-deeper volume record." + f_step_candles(), alert.freq_once_per_bar_close)
if det_step_naga_s and al_step_naga_s
    alert("BEARISH — STEPWISE HV + NAGASAKI. Three falling closes, every candle a volume record, one of them the all-time high." + f_step_candles(), alert.freq_once_per_bar_close)
