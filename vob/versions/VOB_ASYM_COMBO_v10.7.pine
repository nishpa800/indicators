bool det_trs4_b = tcnt_bull >= 4 and barstate.isconfirmed and f_cd_ok(last_trs4_b, cooldown_bars)
bool det_trs3_s = tcnt_bear >= 3 and tcnt_bear < 4 and barstate.isconfirmed and f_cd_ok(last_trs3_s, cooldown_bars)
bool det_trs4_s = tcnt_bear >= 4 and barstate.isconfirmed and f_cd_ok(last_trs4_s, cooldown_bars)
