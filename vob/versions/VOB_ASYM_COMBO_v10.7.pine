bool vp_c4k_s         = input.bool(true, "Plot: 4K + ANY Bear (tier OR zone birth)",     group = GV, tooltip = "4K high-volume record candle AND at least one bearish TIER SIGNAL or ZONE BIRTH on the same candle. The ANY families are the ONLY lanes where zone births count — the label says so.")
bool vp_cnag_b        = input.bool(true, "Plot: Nagasaki + ANY Bull (tier OR zone birth)", group = GV, tooltip = "Nagasaki all-time-high volume AND at least one bullish TIER SIGNAL or ZONE BIRTH on the same candle. ANY family — zone births count here, and only here.")
bool vp_cnag_s        = input.bool(true, "Plot: Nagasaki + ANY Bear (tier OR zone birth)", group = GV, tooltip = "Nagasaki all-time-high volume AND at least one bearish TIER SIGNAL or ZONE BIRTH on the same candle. ANY family — zone births count here, and only here.")
bool vp_trs3_b        = input.bool(true, "Plot: Tiers 3 Bull (exactly 3, same candle)",  group = GV, tooltip = "EXACTLY 3 of the six sensitivities fired a bullish TIER SIGNAL (T1 Asymmetric / T2 Pure / T3 Super) on this candle. TIER SIGNALS ONLY — zone births NEVER count here (operator law: tiers are not zones).")
bool vp_trs4_b        = input.bool(true, "Plot: Tiers 4+ Bull (same candle)",            group = GV, tooltip = "4 OR MORE sensitivities fired a bullish TIER SIGNAL on this candle. TIER SIGNALS ONLY — zone births NEVER count here.")
bool vp_trs3_s        = input.bool(true, "Plot: Tiers 3 Bear (exactly 3, same candle)",  group = GV, tooltip = "EXACTLY 3 of the six sensitivities fired a bearish TIER SIGNAL (T1 Asymmetric / T2 Pure / T3 Super) on this candle. TIER SIGNALS ONLY — zone births NEVER count here (operator law: tiers are not zones).")
bool vp_trs4_s        = input.bool(true, "Plot: Tiers 4+ Bear (same candle)",            group = GV, tooltip = "4 OR MORE sensitivities fired a bearish TIER SIGNAL on this candle. TIER SIGNALS ONLY — zone births NEVER count here.")
bool vp_lvl2_b        = input.bool(true, "Plot: Level 2 Bull (exact price)",             group = GV, tooltip = "EXACTLY 2 bullish tier-signal levels at the EXACT same price (zero buffer) within the level memory. Tier events only — zones never count.")
bool vp_lvl3_b        = input.bool(true, "Plot: Level 3 Bull (exact price)",             group = GV, tooltip = "EXACTLY 3 bullish tier-signal levels at the EXACT same price (zero buffer). Tier events only — zones never count.")
bool vp_lvl4_b        = input.bool(true, "Plot: Level 4+ Bull (exact price)",            group = GV, tooltip = "4 OR MORE bullish tier-signal levels at the EXACT same price (zero buffer). Tier events only — zones never count.")
bool vp_lvl2_s        = input.bool(true, "Plot: Level 2 Bear (exact price)",             group = GV, tooltip = "EXACTLY 2 bearish tier-signal levels at the EXACT same price (zero buffer) within the level memory. Tier events only — zones never count.")
bool vp_lvl3_s        = input.bool(true, "Plot: Level 3 Bear (exact price)",             group = GV, tooltip = "EXACTLY 3 bearish tier-signal levels at the EXACT same price (zero buffer). Tier events only — zones never count.")
bool vp_lvl4_s        = input.bool(true, "Plot: Level 4+ Bear (exact price)",            group = GV, tooltip = "4 OR MORE bearish tier-signal levels at the EXACT same price (zero buffer). Tier events only — zones never count.")
bool vp_diag_b        = input.bool(true, "Plot: Inst Diagonal Fade → BUY",               group = GV, tooltip = "Contrarian: descending bear tier levels kept stepping DOWN (institutional SELL pattern blowing through tiers) → BUY signal. Operator law: fade it.")
bool vp_diag_s        = input.bool(true, "Plot: Inst Diagonal Fade → SELL",              group = GV, tooltip = "Contrarian: ascending bull tier levels kept stepping UP (institutional BUY pattern blowing through tiers) → SELL signal. Operator law: fade it.")
