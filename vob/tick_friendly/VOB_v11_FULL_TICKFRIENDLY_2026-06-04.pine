// ─────────────────────────────────────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────

f_cd_ok(int last_bar, int cd) =>
    na(last_bar) or (bar_index - last_bar) > cd

f_fmt_vol(float v) =>
    if v >= 1000000
        str.tostring(math.round(v / 1000000)) + "M"
    else if v >= 1000
        str.tostring(math.round(v / 1000)) + "K"
    else
        str.tostring(math.round(v))

f_zones_overlap(float lo1, float hi1, float lo2, float hi2) =>
    not na(lo1) and not na(hi1) and not na(lo2) and not na(hi2) and lo1 < hi2 and hi1 > lo2

f_push_hist(array<hist_entry> arr, float vol, float pool, int max_depth) =>
    float pct = pool > 0 ? (vol / pool * 100) : 100.0
    string full_ds = str.format_time(time, "MM/dd HH:mm", syminfo.timezone)
    string ds = str.substring(full_ds, 0, str.length(full_ds) - 1)
    arr.push(hist_entry.new(time, vol, pct, ds))
    if arr.size() > max_depth
        arr.shift()

f_push_t3_hist(array<hist_entry> arr, int max_depth) =>
    string full_ds = str.format_time(time, "MM/dd HH:mm", syminfo.timezone)
    string ds = str.substring(full_ds, 0, str.length(full_ds) - 1)
    arr.push(hist_entry.new(time, volume, 0.0, ds))
    if arr.size() > max_depth
        arr.shift()

// ─────────────────────────────────────────────────────────────────────────────
// EMISSION HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────
// These help compute emission metrics without modifying signal logic.

// Count active (non-invalidated) zones in an array.
// An active zone has a non-na vol field.
f_count_active(array<level> arr) =>
    int c = 0
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            if not na(arr.get(i).vol)
                c += 1
    c

// Find the minimum distance (as percent of price) from close to any active
// zone's midpoint in the given array. Returns -1 if no active zones.
f_nearest_dist_pct(array<level> arr, float price) =>
    float best = -1.0
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid)
                float d = math.abs(price - l.mid) / price * 100
                if best < 0 or d < best
                    best := d
    best

// Count zones whose midpoint is within threshold_pct of current price.
// This is the "stacking near price" count — zones clustering around price.
f_stack_near(array<level> arr, float price, float thresh_pct) =>
    int c = 0
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid) and math.abs(price - l.mid) / price * 100 <= thresh_pct
                c += 1
    c

// Find distance (as percent) to the nearest opposing zone ABOVE price.
// Used for bull gap: how far can price go up before hitting a bear zone?
// Returns 100.0 if no opposing zones above.
f_nearest_above_pct(array<level> arr, float price) =>
    float best = 100.0
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid) and l.mid > price
                float d = (l.mid - price) / price * 100
                if d < best
                    best := d
    best

// Find distance (as percent) to the nearest opposing zone BELOW price.
// Used for bear gap: how far can price go down before hitting a bull zone?
f_nearest_below_pct(array<level> arr, float price) =>
    float best = 100.0
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid) and l.mid < price
                float d = (price - l.mid) / price * 100
                if d < best
                    best := d
    best

// Get the nearest active zone's midpoint price from an array.
f_nearest_mid(array<level> arr, float price) =>
    float best_mid = na
    float best_d   = 1e18
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid)
                float d = math.abs(price - l.mid)
                if d < best_d
                    best_d   := d
                    best_mid := l.mid
    best_mid

// Get the nearest active zone's volume from an array.
f_nearest_vol(array<level> arr, float price) =>
    float best_vol = na
    float best_d   = 1e18
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid)
                float d = math.abs(price - l.mid)
                if d < best_d
                    best_d   := d
                    best_vol := l.vol
    best_vol


// ─────────────────────────────────────────────────────────────────────────────
// CORE VOB FUNCTION — returns [t3_buy, t3_sell, bull_pool, bear_pool]
// ─────────────────────────────────────────────────────────────────────────────
// v10: level.new() calls extended to capture origin-bar OHLC at zone formation.
// Signal logic is otherwise PRESERVED EXACTLY from the original.

f_vob(int len1, array<level> up_lvl, array<level> lo_lvl, float atr_prox, float atr_adj, float sup_mult) =>
    int   len2    = len1 + 13
    float ema1    = ta.ema(close, len1)
    float ema2    = ta.ema(close, len2)
    bool  cup     = ta.crossover(ema1, ema2)  and barstate.isconfirmed
    bool  cdn     = ta.crossunder(ema1, ema2) and barstate.isconfirmed
    float lowest  = ta.lowest(len2)
    float highest = ta.highest(len2)

    if cup
        float vol = 0.0
        for i = 1 to len2
            if low[i] == lowest
                int index = time[i]
                for k = 0 to i
                    vol += volume[k]
                float src = math.min(open[i], close[i])
                src := (src - lowest) < atr_adj * 0.5 ? lowest + atr_adj * 0.5 : src
                float mid = math.avg(src, lowest)
                lo_lvl.push(level.new(index, src, lowest, mid, vol, open[i], high[i], low[i], close[i]))

    if cdn
        float vol = 0.0
        for i = 1 to len2
            if high[i] == highest
                int index = time[i]
                for k = 0 to i
                    vol += volume[k]
                float src = math.max(open[i], close[i])
                src := (highest - src) < atr_adj * 0.5 ? highest - atr_adj * 0.5 : src
                float mid = math.avg(src, highest)
                up_lvl.push(level.new(index, highest, src, mid, vol, open[i], high[i], low[i], close[i]))

    if lo_lvl.size() > 0
        for i = 0 to lo_lvl.size() - 1
            level l  = lo_lvl.get(i)
            level l1 = lo_lvl.get(i - 1)
            float mid  = l.mid
            float mid1 = l1.mid
            if math.abs(mid - mid1) < atr_prox
                lo_lvl.set(i - 1, level.new(na, na, na, na, na, na, na, na, na))
            if close < l.lower
                lo_lvl.set(i, level.new(na, na, na, na, na, na, na, na, na))
        if lo_lvl.size() > 15
            lo_lvl.shift()

    if up_lvl.size() > 0
        for i = 0 to up_lvl.size() - 1
            level l     = up_lvl.get(i)
            level l1    = up_lvl.get(i - 1)
            float upper = l.upper
            float mid   = l.mid
            float mid1  = l1.mid
            if math.abs(mid - mid1) < atr_prox
                up_lvl.set(i - 1, level.new(na, na, na, na, na, na, na, na, na))
            if close > upper
                up_lvl.set(i, level.new(na, na, na, na, na, na, na, na, na))
        if up_lvl.size() > 15
            up_lvl.shift()

    bool  t3_buy  = false
    bool  t3_sell = false
    float bp      = 0.0
    float sp      = 0.0

    if barstate.isconfirmed
        array<float> vbv = array.new<float>()
        array<float> vbl = array.new<float>()
        array<float> vbh = array.new<float>()
        if lo_lvl.size() > 0
            for i = 0 to lo_lvl.size() - 1
                level l = lo_lvl.get(i)
                if not na(l.vol)
                    vbv.push(l.vol)
                    vbl.push(l.lower)
                    vbh.push(l.upper)

        array<float> vav  = array.new<float>()
        array<float> val2 = array.new<float>()
        array<float> vah  = array.new<float>()
        if up_lvl.size() > 0
            for i = 0 to up_lvl.size() - 1
                level l = up_lvl.get(i)
                if not na(l.vol)
                    vav.push(l.vol)
                    val2.push(l.lower)
                    vah.push(l.upper)

        bp := vbv.size() > 0 ? vbv.sum() : 0.0
        sp := vav.size() > 0 ? vav.sum() : 0.0

        float db_vol = 0.0
        float db_low = 0.0
        float db_high = 0.0
        int bc = vbv.size()
        if bc > 0
            for i = 0 to bc - 1
                float v = vbv.get(i)
                if v > db_vol
                    db_vol  := v
                    db_low  := vbl.get(i)
                    db_high := vbh.get(i)

        float da_vol = 0.0
        float da_low = 0.0
        float da_high = 0.0
        int ac = vav.size()
        if ac > 0
            for i = 0 to ac - 1
                float v = vav.get(i)
                if v > da_vol
                    da_vol  := v
                    da_low  := val2.get(i)
                    da_high := vah.get(i)

        bool pat_bull = close >= db_low and close <= db_high
        bool pat_bear = close >= da_low and close <= da_high

        t3_buy  := bc == 1 and sp > 0 and db_vol > sp * sup_mult and pat_bull
        t3_sell := ac == 1 and bp > 0 and da_vol > bp * sup_mult and pat_bear

    [t3_buy, t3_sell, bp, sp]

// ─────────────────────────────────────────────────────────────────────────────
// FUNCTION CALLS — capture array sizes BEFORE for zone-creation detection
// ─────────────────────────────────────────────────────────────────────────────

int sz_la = lower_a.size()
int sz_ua = upper_a.size()
int sz_lb = lower_b.size()
int sz_ub = upper_b.size()
int sz_lc = lower_c.size()
int sz_uc = upper_c.size()
int sz_ld = lower_d.size()
int sz_ud = upper_d.size()
int sz_le = lower_e.size()
int sz_ue = upper_e.size()
int sz_lf = lower_f.size()
int sz_uf = upper_f.size()

[t3_buy_a, t3_sell_a, bpa, spa] = f_vob(sens_a, upper_a, lower_a, atr_proximity, atr_adjust, super_mult)
[t3_buy_b, t3_sell_b, bpb, spb] = f_vob(sens_b, upper_b, lower_b, atr_proximity, atr_adjust, super_mult)
[t3_buy_c, t3_sell_c, bpc, spc] = f_vob(sens_c, upper_c, lower_c, atr_proximity, atr_adjust, super_mult)
[t3_buy_d, t3_sell_d, bpd, spd] = f_vob(sens_d, upper_d, lower_d, atr_proximity, atr_adjust, super_mult)
[t3_buy_e, t3_sell_e, bpe, spe] = f_vob(sens_e, upper_e, lower_e, atr_proximity, atr_adjust, super_mult)
[t3_buy_f, t3_sell_f, bpf, spf] = f_vob(sens_f, upper_f, lower_f, atr_proximity, atr_adjust, super_mult)

// Zone-creation booleans (array grew = new zone pushed)
bool nzb_a = lower_a.size() > sz_la
bool nzs_a = upper_a.size() > sz_ua
bool nzb_b = lower_b.size() > sz_lb
bool nzs_b = upper_b.size() > sz_ub
bool nzb_c = lower_c.size() > sz_lc
bool nzs_c = upper_c.size() > sz_uc
bool nzb_d = lower_d.size() > sz_ld
bool nzs_d = upper_d.size() > sz_ud
bool nzb_e = lower_e.size() > sz_le
bool nzs_e = upper_e.size() > sz_ue
bool nzb_f = lower_f.size() > sz_lf
bool nzs_f = upper_f.size() > sz_uf

// ═══════════════════════════════════════════════════════════════════════════════
// EMISSION LAYER — ZONE METRICS COMPUTATION (moved here so alerts can use them)
// ═══════════════════════════════════════════════════════════════════════════════
// These DO NOT affect signal logic. Computed here (after f_vob populates zone
// arrays) so Bloomberg-format alert strings can reference them.

int cnt_ba = f_count_active(lower_a)
int cnt_sa = f_count_active(upper_a)
int cnt_bb = f_count_active(lower_b)
int cnt_sb = f_count_active(upper_b)
int cnt_bc = f_count_active(lower_c)
int cnt_sc = f_count_active(upper_c)
int cnt_bd = f_count_active(lower_d)
int cnt_sd = f_count_active(upper_d)
int cnt_be = f_count_active(lower_e)
int cnt_se = f_count_active(upper_e)
int cnt_bf = f_count_active(lower_f)
int cnt_sf = f_count_active(upper_f)
int cnt_bull_all = cnt_ba + cnt_bb + cnt_bc + cnt_bd + cnt_be + cnt_bf
int cnt_bear_all = cnt_sa + cnt_sb + cnt_sc + cnt_sd + cnt_se + cnt_sf

float nd_ba = f_nearest_dist_pct(lower_a, close)
float nd_sa = f_nearest_dist_pct(upper_a, close)
float nd_bb = f_nearest_dist_pct(lower_b, close)
float nd_sb = f_nearest_dist_pct(upper_b, close)
float nd_bc = f_nearest_dist_pct(lower_c, close)
float nd_sc = f_nearest_dist_pct(upper_c, close)
float nd_bd = f_nearest_dist_pct(lower_d, close)
float nd_sd = f_nearest_dist_pct(upper_d, close)
float nd_be = f_nearest_dist_pct(lower_e, close)
float nd_se = f_nearest_dist_pct(upper_e, close)
float nd_bf = f_nearest_dist_pct(lower_f, close)
float nd_sf = f_nearest_dist_pct(upper_f, close)

float nearest_bull_dist = math.min(nd_ba >= 0 ? nd_ba : 999, nd_bb >= 0 ? nd_bb : 999, nd_bc >= 0 ? nd_bc : 999, nd_bd >= 0 ? nd_bd : 999, nd_be >= 0 ? nd_be : 999, nd_bf >= 0 ? nd_bf : 999)
float nearest_bear_dist = math.min(nd_sa >= 0 ? nd_sa : 999, nd_sb >= 0 ? nd_sb : 999, nd_sc >= 0 ? nd_sc : 999, nd_sd >= 0 ? nd_sd : 999, nd_se >= 0 ? nd_se : 999, nd_sf >= 0 ? nd_sf : 999)
nearest_bull_dist := nearest_bull_dist >= 999 ? -1.0 : nearest_bull_dist
nearest_bear_dist := nearest_bear_dist >= 999 ? -1.0 : nearest_bear_dist

int stk_bull = f_stack_near(lower_a, close, stack_thresh_pct) + f_stack_near(lower_b, close, stack_thresh_pct) + f_stack_near(lower_c, close, stack_thresh_pct) + f_stack_near(lower_d, close, stack_thresh_pct) + f_stack_near(lower_e, close, stack_thresh_pct) + f_stack_near(lower_f, close, stack_thresh_pct)
int stk_bear = f_stack_near(upper_a, close, stack_thresh_pct) + f_stack_near(upper_b, close, stack_thresh_pct) + f_stack_near(upper_c, close, stack_thresh_pct) + f_stack_near(upper_d, close, stack_thresh_pct) + f_stack_near(upper_e, close, stack_thresh_pct) + f_stack_near(upper_f, close, stack_thresh_pct)

float opp_a = f_nearest_above_pct(upper_a, close)
float opp_b = f_nearest_above_pct(upper_b, close)
float opp_c = f_nearest_above_pct(upper_c, close)
float opp_d = f_nearest_above_pct(upper_d, close)
float opp_e = f_nearest_above_pct(upper_e, close)
float opp_f = f_nearest_above_pct(upper_f, close)
float bull_gap = math.min(opp_a, opp_b, opp_c, opp_d, opp_e, opp_f)
float opp_ba = f_nearest_below_pct(lower_a, close)
float opp_bb = f_nearest_below_pct(lower_b, close)
float opp_bc = f_nearest_below_pct(lower_c, close)
float opp_bd = f_nearest_below_pct(lower_d, close)
float opp_be = f_nearest_below_pct(lower_e, close)
float opp_bf = f_nearest_below_pct(lower_f, close)
float bear_gap = math.min(opp_ba, opp_bb, opp_bc, opp_bd, opp_be, opp_bf)

// ─────────────────────────────────────────────────────────────────────────────
// NAGASAKI — All-Time High Volume (PRESERVED EXACTLY)
// ─────────────────────────────────────────────────────────────────────────────

var float maxVolEver = 0.0
bool isNagasaki = false
if volume[1] > maxVolEver
    maxVolEver := volume[1]
    isNagasaki := true

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — ORIGINAL T3 SIGNAL CONDITIONS + COOLDOWN (PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

bool plot_t3_buy_a  = show_t3_buy_a  and t3_buy_a  and f_cd_ok(last_t3_buy_a,  cooldown_bars)
bool plot_t3_sell_a = show_t3_sell_a and t3_sell_a and f_cd_ok(last_t3_sell_a, cooldown_bars)
bool plot_t3_buy_b  = show_t3_buy_b  and t3_buy_b  and f_cd_ok(last_t3_buy_b,  cooldown_bars)
bool plot_t3_sell_b = show_t3_sell_b and t3_sell_b and f_cd_ok(last_t3_sell_b, cooldown_bars)
bool plot_t3_buy_c  = show_t3_buy_c  and t3_buy_c  and f_cd_ok(last_t3_buy_c,  cooldown_bars)
bool plot_t3_sell_c = show_t3_sell_c and t3_sell_c and f_cd_ok(last_t3_sell_c, cooldown_bars)
bool plot_t3_buy_d  = show_t3_buy_d  and t3_buy_d  and f_cd_ok(last_t3_buy_d,  cooldown_bars)
bool plot_t3_sell_d = show_t3_sell_d and t3_sell_d and f_cd_ok(last_t3_sell_d, cooldown_bars)
bool plot_t3_buy_e  = show_t3_buy_e  and t3_buy_e  and f_cd_ok(last_t3_buy_e,  cooldown_bars)
bool plot_t3_sell_e = show_t3_sell_e and t3_sell_e and f_cd_ok(last_t3_sell_e, cooldown_bars)
bool plot_t3_buy_f  = show_t3_buy_f  and t3_buy_f  and f_cd_ok(last_t3_buy_f,  cooldown_bars)
bool plot_t3_sell_f = show_t3_sell_f and t3_sell_f and f_cd_ok(last_t3_sell_f, cooldown_bars)
bool plot_nagasaki  = show_nagasaki  and isNagasaki and f_cd_ok(last_nagasaki, cooldown_bars)

// T3 cooldown stamps
if plot_t3_buy_a
    last_t3_buy_a := bar_index
if plot_t3_sell_a
    last_t3_sell_a := bar_index
if plot_t3_buy_b
    last_t3_buy_b := bar_index
if plot_t3_sell_b
    last_t3_sell_b := bar_index
if plot_t3_buy_c
    last_t3_buy_c := bar_index
if plot_t3_sell_c
    last_t3_sell_c := bar_index
if plot_t3_buy_d
    last_t3_buy_d := bar_index
if plot_t3_sell_d
    last_t3_sell_d := bar_index
if plot_t3_buy_e
    last_t3_buy_e := bar_index
if plot_t3_sell_e
    last_t3_sell_e := bar_index
if plot_t3_buy_f
    last_t3_buy_f := bar_index
if plot_t3_sell_f
    last_t3_sell_f := bar_index
if plot_nagasaki
    last_nagasaki := bar_index

// T3 + Nagasaki signal history tracking
if plot_t3_buy_a
    f_push_t3_hist(ht3ba, hist_depth)
if plot_t3_sell_a
    f_push_t3_hist(ht3sa, hist_depth)
if plot_t3_buy_b
    f_push_t3_hist(ht3bb, hist_depth)
if plot_t3_sell_b
    f_push_t3_hist(ht3sb, hist_depth)
if plot_t3_buy_c
    f_push_t3_hist(ht3bc, hist_depth)
if plot_t3_sell_c
    f_push_t3_hist(ht3sc, hist_depth)
if plot_t3_buy_d
    f_push_t3_hist(ht3bd, hist_depth)
if plot_t3_sell_d
    f_push_t3_hist(ht3sd, hist_depth)
if plot_t3_buy_e
    f_push_t3_hist(ht3be, hist_depth)
if plot_t3_sell_e
    f_push_t3_hist(ht3se, hist_depth)
if plot_t3_buy_f
    f_push_t3_hist(ht3bf, hist_depth)
if plot_t3_sell_f
    f_push_t3_hist(ht3sf, hist_depth)
if plot_nagasaki
    f_push_t3_hist(h_nag, hist_depth)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — ORIGINAL T3 PLOTSHAPES (13 total — PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

plotshape(plot_t3_buy_a,  "T3a Buy",  shape.circle, location.belowbar, color.new(#00e676, 0), size = size.large, text = "T3a", textcolor = color.new(#00e676, 0))
plotshape(plot_t3_buy_b,  "T3b Buy",  shape.circle, location.belowbar, color.new(#00bcd4, 0), size = size.large, text = "T3b", textcolor = color.new(#00bcd4, 0))
plotshape(plot_t3_buy_c,  "T3c Buy",  shape.circle, location.belowbar, color.new(#2196f3, 0), size = size.large, text = "T3c", textcolor = color.new(#2196f3, 0))
plotshape(plot_t3_buy_d,  "T3d Buy",  shape.circle, location.belowbar, color.new(#ffeb3b, 0), size = size.large, text = "T3d", textcolor = color.new(#ffeb3b, 0))
plotshape(plot_t3_buy_e,  "T3e Buy",  shape.circle, location.belowbar, color.new(#ff9800, 0), size = size.large, text = "T3e", textcolor = color.new(#ff9800, 0))
plotshape(plot_t3_buy_f,  "T3f Buy",  shape.circle, location.belowbar, color.new(#ffd700, 0), size = size.large, text = "T3f", textcolor = color.new(#ffd700, 0))

plotshape(plot_t3_sell_a, "T3a Sell", shape.circle, location.abovebar, color.new(#ff5252, 0), size = size.large, text = "T3a", textcolor = color.new(#ff5252, 0))
plotshape(plot_t3_sell_b, "T3b Sell", shape.circle, location.abovebar, color.new(#e91e63, 0), size = size.large, text = "T3b", textcolor = color.new(#e91e63, 0))
plotshape(plot_t3_sell_c, "T3c Sell", shape.circle, location.abovebar, color.new(#9c27b0, 0), size = size.large, text = "T3c", textcolor = color.new(#9c27b0, 0))
plotshape(plot_t3_sell_d, "T3d Sell", shape.circle, location.abovebar, color.new(#ff4400, 0), size = size.large, text = "T3d", textcolor = color.new(#ff4400, 0))
plotshape(plot_t3_sell_e, "T3e Sell", shape.circle, location.abovebar, color.new(#d50000, 0), size = size.large, text = "T3e", textcolor = color.new(#d50000, 0))
plotshape(plot_t3_sell_f, "T3f Sell", shape.circle, location.abovebar, color.new(#b71c1c, 0), size = size.large, text = "T3f", textcolor = color.new(#b71c1c, 0))

plotshape(plot_nagasaki,  "Nagasaki", shape.diamond, location.top, color.new(color.purple, 0), size = size.normal, text = "NAG", textcolor = color.purple, offset = -1)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — CONSOLIDATED ALERTCONDITIONS (2 total — each counts toward 64 limit)
// ═══════════════════════════════════════════════════════════════════════════════

bool any_t3 = plot_t3_buy_a or plot_t3_sell_a or plot_t3_buy_b or plot_t3_sell_b or plot_t3_buy_c or plot_t3_sell_c or plot_t3_buy_d or plot_t3_sell_d or plot_t3_buy_e or plot_t3_sell_e or plot_t3_buy_f or plot_t3_sell_f or plot_nagasaki
alertcondition(any_t3, "Any T3 Signal or Nagasaki", "VOB T3 SUPER signal or Nagasaki all-time-high volume fired")

// (Zone formation alertcondition uses any_zone bool defined later in the code)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — BLOOMBERG-FORMAT T3 ALERT STRINGS (alert() — does NOT count toward 64)
// ═══════════════════════════════════════════════════════════════════════════════

f_bloomberg_t3(string sig, string tier, int sens_val, string dir, float bp, float sp, float slope_v) =>
    "T3_SIGNAL" + "|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|SIGNAL:" + sig + "|TIER:" + tier + "|SENS:" + str.tostring(sens_val) + "|DIR:" + dir + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLPOOL:" + str.tostring(math.round(bp)) + "|BEARPOOL:" + str.tostring(math.round(sp)) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100) + "|NRBULLDIST:" + str.tostring(math.round(nearest_bull_dist * 100) / 100) + "|NRBEARDIST:" + str.tostring(math.round(nearest_bear_dist * 100) / 100) + "|SLOPE:" + str.tostring(math.round(slope_v * 10000) / 10000)

// T3 alert multiplexer
if plot_t3_buy_a
    alert(f_bloomberg_t3("T3_SUPER_BUY", "A", sens_a, "BULL", bpa, spa, slope_ema_a), alert.freq_once_per_bar_close)
if plot_t3_sell_a
    alert(f_bloomberg_t3("T3_SUPER_SELL", "A", sens_a, "BEAR", bpa, spa, slope_ema_a), alert.freq_once_per_bar_close)
if plot_t3_buy_b
    alert(f_bloomberg_t3("T3_SUPER_BUY", "B", sens_b, "BULL", bpb, spb, slope_ema_b), alert.freq_once_per_bar_close)
if plot_t3_sell_b
    alert(f_bloomberg_t3("T3_SUPER_SELL", "B", sens_b, "BEAR", bpb, spb, slope_ema_b), alert.freq_once_per_bar_close)
if plot_t3_buy_c
    alert(f_bloomberg_t3("T3_SUPER_BUY", "C", sens_c, "BULL", bpc, spc, slope_ema_c), alert.freq_once_per_bar_close)
if plot_t3_sell_c
    alert(f_bloomberg_t3("T3_SUPER_SELL", "C", sens_c, "BEAR", bpc, spc, slope_ema_c), alert.freq_once_per_bar_close)
if plot_t3_buy_d
    alert(f_bloomberg_t3("T3_SUPER_BUY", "D", sens_d, "BULL", bpd, spd, slope_ema_d), alert.freq_once_per_bar_close)
if plot_t3_sell_d
    alert(f_bloomberg_t3("T3_SUPER_SELL", "D", sens_d, "BEAR", bpd, spd, slope_ema_d), alert.freq_once_per_bar_close)
if plot_t3_buy_e
    alert(f_bloomberg_t3("T3_SUPER_BUY", "E", sens_e, "BULL", bpe, spe, slope_ema_e), alert.freq_once_per_bar_close)
if plot_t3_sell_e
    alert(f_bloomberg_t3("T3_SUPER_SELL", "E", sens_e, "BEAR", bpe, spe, slope_ema_e), alert.freq_once_per_bar_close)
if plot_t3_buy_f
    alert(f_bloomberg_t3("T3_SUPER_BUY", "F", sens_f, "BULL", bpf, spf, slope_ema_f), alert.freq_once_per_bar_close)
if plot_t3_sell_f
    alert(f_bloomberg_t3("T3_SUPER_SELL", "F", sens_f, "BEAR", bpf, spf, slope_ema_f), alert.freq_once_per_bar_close)
if plot_nagasaki
    alert("NAGASAKI_ATH_VOL|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|DIR:NEUTRAL|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|ATHVOL:" + str.tostring(math.round(maxVolEver)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count), alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 2 — ZONE-CREATION MARKERS + COOLDOWN + HISTORY (PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

bool fire_zb_a = en_zone_a and nzb_a and f_cd_ok(cd_zb_a, cooldown_bars)
bool fire_zs_a = en_zone_a and nzs_a and f_cd_ok(cd_zs_a, cooldown_bars)
bool fire_zb_b = en_zone_b and nzb_b and f_cd_ok(cd_zb_b, cooldown_bars)
bool fire_zs_b = en_zone_b and nzs_b and f_cd_ok(cd_zs_b, cooldown_bars)
bool fire_zb_c = en_zone_c and nzb_c and f_cd_ok(cd_zb_c, cooldown_bars)
bool fire_zs_c = en_zone_c and nzs_c and f_cd_ok(cd_zs_c, cooldown_bars)
bool fire_zb_d = en_zone_d and nzb_d and f_cd_ok(cd_zb_d, cooldown_bars)
bool fire_zs_d = en_zone_d and nzs_d and f_cd_ok(cd_zs_d, cooldown_bars)
bool fire_zb_e = en_zone_e and nzb_e and f_cd_ok(cd_zb_e, cooldown_bars)
bool fire_zs_e = en_zone_e and nzs_e and f_cd_ok(cd_zs_e, cooldown_bars)
bool fire_zb_f = en_zone_f and nzb_f and f_cd_ok(cd_zb_f, cooldown_bars)
bool fire_zs_f = en_zone_f and nzs_f and f_cd_ok(cd_zs_f, cooldown_bars)

if fire_zb_a
    cd_zb_a := bar_index
if fire_zs_a
    cd_zs_a := bar_index
if fire_zb_b
    cd_zb_b := bar_index
if fire_zs_b
    cd_zs_b := bar_index
if fire_zb_c
    cd_zb_c := bar_index
if fire_zs_c
    cd_zs_c := bar_index
if fire_zb_d
    cd_zb_d := bar_index
if fire_zs_d
    cd_zs_d := bar_index
if fire_zb_e
    cd_zb_e := bar_index
if fire_zs_e
    cd_zs_e := bar_index
if fire_zb_f
    cd_zb_f := bar_index
if fire_zs_f
    cd_zs_f := bar_index

// History tracking
if fire_zb_a and lower_a.size() > 0
    level nz = lower_a.last()
    if not na(nz.vol)
        f_push_hist(hb_a, nz.vol, bpa, hist_depth)
if fire_zs_a and upper_a.size() > 0
    level nz = upper_a.last()
    if not na(nz.vol)
        f_push_hist(hs_a, nz.vol, spa, hist_depth)
if fire_zb_b and lower_b.size() > 0
    level nz = lower_b.last()
    if not na(nz.vol)
        f_push_hist(hb_b, nz.vol, bpb, hist_depth)
if fire_zs_b and upper_b.size() > 0
    level nz = upper_b.last()
    if not na(nz.vol)
        f_push_hist(hs_b, nz.vol, spb, hist_depth)
if fire_zb_c and lower_c.size() > 0
    level nz = lower_c.last()
    if not na(nz.vol)
        f_push_hist(hb_c, nz.vol, bpc, hist_depth)
if fire_zs_c and upper_c.size() > 0
    level nz = upper_c.last()
    if not na(nz.vol)
        f_push_hist(hs_c, nz.vol, spc, hist_depth)
if fire_zb_d and lower_d.size() > 0
    level nz = lower_d.last()
    if not na(nz.vol)
        f_push_hist(hb_d, nz.vol, bpd, hist_depth)
if fire_zs_d and upper_d.size() > 0
    level nz = upper_d.last()
    if not na(nz.vol)
        f_push_hist(hs_d, nz.vol, spd, hist_depth)
if fire_zb_e and lower_e.size() > 0
    level nz = lower_e.last()
    if not na(nz.vol)
        f_push_hist(hb_e, nz.vol, bpe, hist_depth)
if fire_zs_e and upper_e.size() > 0
    level nz = upper_e.last()
    if not na(nz.vol)
        f_push_hist(hs_e, nz.vol, spe, hist_depth)
if fire_zb_f and lower_f.size() > 0
    level nz = lower_f.last()
    if not na(nz.vol)
        f_push_hist(hb_f, nz.vol, bpf, hist_depth)
if fire_zs_f and upper_f.size() > 0
    level nz = upper_f.last()
    if not na(nz.vol)
        f_push_hist(hs_f, nz.vol, spf, hist_depth)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 2 — ZONE-CREATION MARKER PLOTSHAPES (12 total — PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

plotshape(fire_zb_a, "ZoneBull A", shape.xcross, location.top,      col_bull_a, size=size.small, text="zA", textcolor=col_bull_a)
plotshape(fire_zb_b, "ZoneBull B", shape.xcross, location.abovebar, col_bull_b, size=size.small, text="zB", textcolor=col_bull_b)
plotshape(fire_zb_c, "ZoneBull C", shape.xcross, location.belowbar, col_bull_c, size=size.small, text="zC", textcolor=col_bull_c)
plotshape(fire_zb_d, "ZoneBull D", shape.xcross, location.bottom,   col_bull_d, size=size.small, text="zD", textcolor=col_bull_d)
plotshape(fire_zb_e, "ZoneBull E", shape.cross,  location.abovebar, col_bull_e, size=size.small, text="zE", textcolor=col_bull_e)
plotshape(fire_zb_f, "ZoneBull F", shape.cross,  location.belowbar, col_bull_f, size=size.small, text="zF", textcolor=col_bull_f)

plotshape(fire_zs_a, "ZoneBear A", shape.xcross, location.bottom,   col_bear_a, size=size.small, text="zA", textcolor=col_bear_a)
plotshape(fire_zs_b, "ZoneBear B", shape.xcross, location.belowbar, col_bear_b, size=size.small, text="zB", textcolor=col_bear_b)
plotshape(fire_zs_c, "ZoneBear C", shape.xcross, location.abovebar, col_bear_c, size=size.small, text="zC", textcolor=col_bear_c)
plotshape(fire_zs_d, "ZoneBear D", shape.xcross, location.top,      col_bear_d, size=size.small, text="zD", textcolor=col_bear_d)
plotshape(fire_zs_e, "ZoneBear E", shape.cross,  location.belowbar, col_bear_e, size=size.small, text="zE", textcolor=col_bear_e)
plotshape(fire_zs_f, "ZoneBear F", shape.cross,  location.abovebar, col_bear_f, size=size.small, text="zF", textcolor=col_bear_f)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 2 — MUTUALLY EXCLUSIVE OVERLAP ENGINE + LINE DRAWING (PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

var array<line>     drawn_lines = array.new<line>()
var array<linefill> drawn_fills = array.new<linefill>()

if drawn_lines.size() > 0
    for i = 0 to drawn_lines.size() - 1
        line.delete(drawn_lines.get(i))
drawn_lines.clear()
if drawn_fills.size() > 0
    for i = 0 to drawn_fills.size() - 1
        linefill.delete(drawn_fills.get(i))
drawn_fills.clear()

var array<float> ovlp_bull_lo = array.new<float>()
var array<float> ovlp_bull_hi = array.new<float>()
var array<float> ovlp_bear_lo = array.new<float>()
var array<float> ovlp_bear_hi = array.new<float>()
ovlp_bull_lo.clear()
ovlp_bull_hi.clear()
ovlp_bear_lo.clear()
ovlp_bear_hi.clear()

f_count_overlaps(array<float> trk_lo, array<float> trk_hi, float zlo, float zhi) =>
    int count = 0
    if trk_lo.size() > 0
        for i = 0 to trk_lo.size() - 1
            if f_zones_overlap(trk_lo.get(i), trk_hi.get(i), zlo, zhi)
                count += 1
    count

f_draw_zone(int origin_time, float z_upper, float z_lower, float z_mid, color col, int priority) =>
    if priority == 0
        line lt = line.new(origin_time, z_upper, time, z_upper, xloc.bar_time, extend.right, col, line.style_solid, 1)
        line lb = line.new(origin_time, z_lower, time, z_lower, xloc.bar_time, extend.right, col, line.style_solid, 1)
        line lm = line.new(origin_time, z_mid,   time, z_mid,   xloc.bar_time, extend.right, color.new(col, mid_transp), line.style_dashed, 1)
        linefill lf = linefill.new(lt, lb, color.new(col, fill_transp))
        drawn_lines.push(lt)
        drawn_lines.push(lb)
        drawn_lines.push(lm)
        drawn_fills.push(lf)
    else if priority == 1
        line lm = line.new(origin_time, z_mid, time, z_mid, xloc.bar_time, extend.right, col, line.style_solid, 2)
        drawn_lines.push(lm)
    else if priority == 2
        line lm = line.new(origin_time, z_mid, time, z_mid, xloc.bar_time, extend.right, col, line.style_dotted, 2)
        drawn_lines.push(lm)
    else
        line lm = line.new(origin_time, z_mid, time, z_mid, xloc.bar_time, extend.right, col, line.style_dotted, 1)
        drawn_lines.push(lm)

f_process_zones(array<level> lvl_arr, array<float> trk_lo, array<float> trk_hi, color col, bool enabled) =>
    if enabled and lvl_arr.size() > 0
        for i = 0 to lvl_arr.size() - 1
            level l = lvl_arr.get(i)
            if not na(l.vol) and not na(l.upper) and not na(l.lower) and not na(l.indx)
                int olaps = f_count_overlaps(trk_lo, trk_hi, l.lower, l.upper)
                f_draw_zone(l.indx, l.upper, l.lower, l.mid, col, olaps)
                trk_lo.push(l.lower)
                trk_hi.push(l.upper)

f_process_zones(lower_a, ovlp_bull_lo, ovlp_bull_hi, col_bull_a, en_zone_a)
f_process_zones(lower_b, ovlp_bull_lo, ovlp_bull_hi, col_bull_b, en_zone_b)
f_process_zones(lower_c, ovlp_bull_lo, ovlp_bull_hi, col_bull_c, en_zone_c)
f_process_zones(lower_d, ovlp_bull_lo, ovlp_bull_hi, col_bull_d, en_zone_d)
f_process_zones(lower_e, ovlp_bull_lo, ovlp_bull_hi, col_bull_e, en_zone_e)
f_process_zones(lower_f, ovlp_bull_lo, ovlp_bull_hi, col_bull_f, en_zone_f)
f_process_zones(upper_a, ovlp_bear_lo, ovlp_bear_hi, col_bear_a, en_zone_a)
f_process_zones(upper_b, ovlp_bear_lo, ovlp_bear_hi, col_bear_b, en_zone_b)
f_process_zones(upper_c, ovlp_bear_lo, ovlp_bear_hi, col_bear_c, en_zone_c)
f_process_zones(upper_d, ovlp_bear_lo, ovlp_bear_hi, col_bear_d, en_zone_d)
f_process_zones(upper_e, ovlp_bear_lo, ovlp_bear_hi, col_bear_e, en_zone_e)
f_process_zones(upper_f, ovlp_bear_lo, ovlp_bear_hi, col_bear_f, en_zone_f)


// ═══════════════════════════════════════════════════════════════════════════════
// EMISSION LAYER — ZONE FORMATION LABELS (data_get_pine_labels channel)
// ═══════════════════════════════════════════════════════════════════════════════

f_emit_label(bool fire, array<level> arr, string dir, string tier, int sens_val, float pool, float rsi_v, int sess_v, float slope_v) =>
    if en_emission_labels and fire and arr.size() > 0
        level nz = arr.last()
        if not na(nz.mid) and not na(nz.vol)
            string txt = dir + "|" + tier + "|SENS:" + str.tostring(sens_val) + "|VOL:" + f_fmt_vol(nz.vol) + "|POOL:" + f_fmt_vol(pool) + "|RSI:" + str.tostring(math.round(rsi_v)) + "|SESS:" + str.tostring(sess_v) + "|SLOPE:" + str.tostring(math.round(slope_v * 10000) / 10000)
            color lc = dir == "BULL" ? color.new(color.green, 60) : color.new(color.red, 60)
            label.new(bar_index, nz.mid, txt, xloc.bar_index, yloc.price, lc, label.style_label_left, color.white, size.tiny)

f_emit_label(nzb_a, lower_a, "BULL", "A", sens_a, bpa, rsi_14, sess_bar_count, slope_ema_a)
f_emit_label(nzs_a, upper_a, "BEAR", "A", sens_a, spa, rsi_14, sess_bar_count, slope_ema_a)
f_emit_label(nzb_b, lower_b, "BULL", "B", sens_b, bpb, rsi_14, sess_bar_count, slope_ema_b)
f_emit_label(nzs_b, upper_b, "BEAR", "B", sens_b, spb, rsi_14, sess_bar_count, slope_ema_b)
f_emit_label(nzb_c, lower_c, "BULL", "C", sens_c, bpc, rsi_14, sess_bar_count, slope_ema_c)
f_emit_label(nzs_c, upper_c, "BEAR", "C", sens_c, spc, rsi_14, sess_bar_count, slope_ema_c)
f_emit_label(nzb_d, lower_d, "BULL", "D", sens_d, bpd, rsi_14, sess_bar_count, slope_ema_d)
f_emit_label(nzs_d, upper_d, "BEAR", "D", sens_d, spd, rsi_14, sess_bar_count, slope_ema_d)
f_emit_label(nzb_e, lower_e, "BULL", "E", sens_e, bpe, rsi_14, sess_bar_count, slope_ema_e)
f_emit_label(nzs_e, upper_e, "BEAR", "E", sens_e, spe, rsi_14, sess_bar_count, slope_ema_e)
f_emit_label(nzb_f, lower_f, "BULL", "F", sens_f, bpf, rsi_14, sess_bar_count, slope_ema_f)
f_emit_label(nzs_f, upper_f, "BEAR", "F", sens_f, spf, rsi_14, sess_bar_count, slope_ema_f)


// ═══════════════════════════════════════════════════════════════════════════════
// EMISSION LAYER — BLOOMBERG-FORMAT ZONE AGGREGATOR ALERT + ALERTCONDITION
// ═══════════════════════════════════════════════════════════════════════════════

bool any_zone = fire_zb_a or fire_zs_a or fire_zb_b or fire_zs_b or fire_zb_c or fire_zs_c or fire_zb_d or fire_zs_d or fire_zb_e or fire_zs_e or fire_zb_f or fire_zs_f
alertcondition(any_zone, "Any Zone Formation", "VOB zone formation event — new bullish or bearish zone created at any sensitivity tier")

if any_zone
    string zmsg = "ZONE_FORMATION|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLPOOL_A:" + str.tostring(math.round(bpa)) + "|BEARPOOL_A:" + str.tostring(math.round(spa)) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100) + "|NRBULLDIST:" + str.tostring(math.round(nearest_bull_dist * 100) / 100) + "|NRBEARDIST:" + str.tostring(math.round(nearest_bear_dist * 100) / 100) + "|ZONES:"
    if fire_zb_a
        zmsg += "BULL-A(" + str.tostring(sens_a) + "),"
    if fire_zs_a
        zmsg += "BEAR-A(" + str.tostring(sens_a) + "),"
    if fire_zb_b
        zmsg += "BULL-B(" + str.tostring(sens_b) + "),"
    if fire_zs_b
        zmsg += "BEAR-B(" + str.tostring(sens_b) + "),"
    if fire_zb_c
        zmsg += "BULL-C(" + str.tostring(sens_c) + "),"
    if fire_zs_c
        zmsg += "BEAR-C(" + str.tostring(sens_c) + "),"
    if fire_zb_d
        zmsg += "BULL-D(" + str.tostring(sens_d) + "),"
    if fire_zs_d
        zmsg += "BEAR-D(" + str.tostring(sens_d) + "),"
    if fire_zb_e
        zmsg += "BULL-E(" + str.tostring(sens_e) + "),"
    if fire_zs_e
        zmsg += "BEAR-E(" + str.tostring(sens_e) + "),"
    if fire_zb_f
        zmsg += "BULL-F(" + str.tostring(sens_f) + "),"
    if fire_zs_f
        zmsg += "BEAR-F(" + str.tostring(sens_f) + "),"
    alert(zmsg, alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// EMISSION LAYER — log.info() STREAMING (pine_get_console channel)
// ═══════════════════════════════════════════════════════════════════════════════

if en_emission_logs and barstate.isconfirmed
    log.info("VOB_EMISSION|TICKER:{0}|TF:{1}|CLOSE:{2}|RSI:{3}|SESS:{4}|VOLRANK:{5}|VOL:{6}|ATHVOL:{7}|BULLZONES:{8}|BEARZONES:{9}|STKBULL:{10}|STKBEAR:{11}|GAPBULL:{12}|GAPBEAR:{13}|NRBULLDIST:{14}|NRBEARDIST:{15}|BPA:{16}|SPA:{17}|BPB:{18}|SPB:{19}|BPC:{20}|SPC:{21}|BPD:{22}|SPD:{23}|BPE:{24}|SPE:{25}|BPF:{26}|SPF:{27}|SLOPEA:{28}|SLOPEB:{29}|SLOPEC:{30}|SLOPED:{31}|SLOPEE:{32}|SLOPEF:{33}",
        syminfo.ticker, timeframe.period,
        str.tostring(close), str.tostring(math.round(rsi_14 * 100) / 100),
        str.tostring(sess_bar_count), str.tostring(math.round(vol_rank)),
        str.tostring(math.round(volume)), str.tostring(math.round(maxVolEver)),
        str.tostring(cnt_bull_all), str.tostring(cnt_bear_all),
        str.tostring(stk_bull), str.tostring(stk_bear),
        str.tostring(math.round(bull_gap * 100) / 100), str.tostring(math.round(bear_gap * 100) / 100),
        str.tostring(math.round(nearest_bull_dist * 100) / 100), str.tostring(math.round(nearest_bear_dist * 100) / 100),
        str.tostring(math.round(bpa)), str.tostring(math.round(spa)),
        str.tostring(math.round(bpb)), str.tostring(math.round(spb)),
        str.tostring(math.round(bpc)), str.tostring(math.round(spc)),
        str.tostring(math.round(bpd)), str.tostring(math.round(spd)),
        str.tostring(math.round(bpe)), str.tostring(math.round(spe)),
        str.tostring(math.round(bpf)), str.tostring(math.round(spf)),
        str.tostring(math.round(slope_ema_a * 10000) / 10000), str.tostring(math.round(slope_ema_b * 10000) / 10000),
        str.tostring(math.round(slope_ema_c * 10000) / 10000), str.tostring(math.round(slope_ema_d * 10000) / 10000),
        str.tostring(math.round(slope_ema_e * 10000) / 10000), str.tostring(math.round(slope_ema_f * 10000) / 10000))


// ═══════════════════════════════════════════════════════════════════════════════
// VLB STRICT LADDER DETECTION (v10) — bullish + bearish chronological F→A
// ═══════════════════════════════════════════════════════════════════════════════
// Requires the six zones to FORM in strict chronological order across bars,
// and at each step the new zone must touch or sit above (bull) / below (bear)
// the prior zone.
//
// BULL RULES (bear is the mirror):
//   1. Sequence:  F → E → D → C → B → A across bars (or same bar if multiple
//                 tiers form simultaneously, processed in F→A order).
//   2. Price:     at each step the new zone must satisfy new.high >= prior.low
//                 i.e. the new zone is NOT entirely below the prior one;
//                 fully-inside or fully-above both qualify.
//   3. Bearish kill: ANY bearish zone formation in ANY tier on a bar resets
//                 the in-progress bullish window; no new F can start on that
//                 same bar — the next F-start must be on a later bar.
//   4. Wrong-tier kill: a bullish zone whose tier does not match the expected
//                 next step (including a fresh F mid-ladder) kills the window.
//   5. Price-fail kill: the expected tier fires but new.high < prior.low.
//   6. Fire: on the bar where bullish A completes step 5→6 the detection
//            plotshape fires (one bar only) and an alert is emitted with
//            full per-tier OHLCV. Window then resets to wait for next F.
//
// All booleans drive both the plotshape AND the alert() in lockstep, gated by
// barstate.isconfirmed for non-repainting 1:1 visual/alert parity.

// ─── STATE ──────────────────────────────────────────────────────────────────
// vlb_*_state encodes "next expected tier":
//   0 = waiting for F  | 1 = waiting for E  | 2 = waiting for D
//   3 = waiting for C  | 4 = waiting for B  | 5 = waiting for A
// vlb_*_p_lo / p_hi store the most-recently-confirmed step's zone range.
var int   vlb_bull_state = 0
var float vlb_bull_p_lo  = na
var float vlb_bull_p_hi  = na
var int   vlb_bear_state = 0
var float vlb_bear_p_lo  = na
var float vlb_bear_p_hi  = na

// Per-step OHLCV snapshots — captured at each accepted step so the firing-bar
// alert reports the ORIGINAL OHLCV of the zone that triggered each step, even
// if that zone has since been invalidated by close-through.
var float vlb_bull_f_o = na, var float vlb_bull_f_h = na, var float vlb_bull_f_l = na, var float vlb_bull_f_c = na, var float vlb_bull_f_v = na
var float vlb_bull_e_o = na, var float vlb_bull_e_h = na, var float vlb_bull_e_l = na, var float vlb_bull_e_c = na, var float vlb_bull_e_v = na
var float vlb_bull_d_o = na, var float vlb_bull_d_h = na, var float vlb_bull_d_l = na, var float vlb_bull_d_c = na, var float vlb_bull_d_v = na
var float vlb_bull_c_o = na, var float vlb_bull_c_h = na, var float vlb_bull_c_l = na, var float vlb_bull_c_c = na, var float vlb_bull_c_v = na
var float vlb_bull_b_o = na, var float vlb_bull_b_h = na, var float vlb_bull_b_l = na, var float vlb_bull_b_c = na, var float vlb_bull_b_v = na
var float vlb_bull_a_o = na, var float vlb_bull_a_h = na, var float vlb_bull_a_l = na, var float vlb_bull_a_c = na, var float vlb_bull_a_v = na

var float vlb_bear_f_o = na, var float vlb_bear_f_h = na, var float vlb_bear_f_l = na, var float vlb_bear_f_c = na, var float vlb_bear_f_v = na
var float vlb_bear_e_o = na, var float vlb_bear_e_h = na, var float vlb_bear_e_l = na, var float vlb_bear_e_c = na, var float vlb_bear_e_v = na
var float vlb_bear_d_o = na, var float vlb_bear_d_h = na, var float vlb_bear_d_l = na, var float vlb_bear_d_c = na, var float vlb_bear_d_v = na
var float vlb_bear_c_o = na, var float vlb_bear_c_h = na, var float vlb_bear_c_l = na, var float vlb_bear_c_c = na, var float vlb_bear_c_v = na
var float vlb_bear_b_o = na, var float vlb_bear_b_h = na, var float vlb_bear_b_l = na, var float vlb_bear_b_c = na, var float vlb_bear_b_v = na
var float vlb_bear_a_o = na, var float vlb_bear_a_h = na, var float vlb_bear_a_l = na, var float vlb_bear_a_c = na, var float vlb_bear_a_v = na

// Last-fire bar tracking for cooldown parity.
var int last_vlb_b = na
var int last_vlb_r = na

// Fetch the just-pushed zone for a tier (the zone that formed this bar).
f_last_zone(array<level> arr) =>
    arr.size() > 0 ? arr.get(arr.size() - 1) : na

// ─── BULLISH LADDER PROCESSING ──────────────────────────────────────────────
bool vlb_bull_complete = false
bool any_bear_zone_bar = nzs_a or nzs_b or nzs_c or nzs_d or nzs_e or nzs_f
bool any_bull_zone_bar = nzb_a or nzb_b or nzb_c or nzb_d or nzb_e or nzb_f

if any_bear_zone_bar
    vlb_bull_state := 0
    vlb_bull_p_lo  := na
    vlb_bull_p_hi  := na
else if any_bull_zone_bar
    // F (expects state==0)
    if nzb_f
        if vlb_bull_state == 0
            level zf = f_last_zone(lower_f)
            vlb_bull_p_lo  := zf.lower
            vlb_bull_p_hi  := zf.upper
            vlb_bull_f_o   := zf.o
            vlb_bull_f_h   := zf.h
            vlb_bull_f_l   := zf.l
            vlb_bull_f_c   := zf.c
            vlb_bull_f_v   := zf.vol
            vlb_bull_state := 1
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // E (expects state==1)
    if nzb_e and vlb_bull_state > 0
        if vlb_bull_state == 1
            level ze = f_last_zone(lower_e)
            if ze.upper >= vlb_bull_p_lo
                vlb_bull_p_lo  := ze.lower
                vlb_bull_p_hi  := ze.upper
                vlb_bull_e_o   := ze.o
                vlb_bull_e_h   := ze.h
                vlb_bull_e_l   := ze.l
                vlb_bull_e_c   := ze.c
                vlb_bull_e_v   := ze.vol
                vlb_bull_state := 2
            else
                vlb_bull_state := 0
                vlb_bull_p_lo  := na
                vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // D (expects state==2)
    if nzb_d and vlb_bull_state > 0
        if vlb_bull_state == 2
            level zd = f_last_zone(lower_d)
            if zd.upper >= vlb_bull_p_lo
                vlb_bull_p_lo  := zd.lower
                vlb_bull_p_hi  := zd.upper
                vlb_bull_d_o   := zd.o
                vlb_bull_d_h   := zd.h
                vlb_bull_d_l   := zd.l
                vlb_bull_d_c   := zd.c
                vlb_bull_d_v   := zd.vol
                vlb_bull_state := 3
            else
                vlb_bull_state := 0
                vlb_bull_p_lo  := na
                vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // C (expects state==3)
    if nzb_c and vlb_bull_state > 0
        if vlb_bull_state == 3
            level zc = f_last_zone(lower_c)
            if zc.upper >= vlb_bull_p_lo
                vlb_bull_p_lo  := zc.lower
                vlb_bull_p_hi  := zc.upper
                vlb_bull_c_o   := zc.o
                vlb_bull_c_h   := zc.h
                vlb_bull_c_l   := zc.l
                vlb_bull_c_c   := zc.c
                vlb_bull_c_v   := zc.vol
                vlb_bull_state := 4
            else
                vlb_bull_state := 0
                vlb_bull_p_lo  := na
                vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // B (expects state==4)
    if nzb_b and vlb_bull_state > 0
        if vlb_bull_state == 4
            level zb = f_last_zone(lower_b)
            if zb.upper >= vlb_bull_p_lo
                vlb_bull_p_lo  := zb.lower
                vlb_bull_p_hi  := zb.upper
                vlb_bull_b_o   := zb.o
                vlb_bull_b_h   := zb.h
                vlb_bull_b_l   := zb.l
                vlb_bull_b_c   := zb.c
                vlb_bull_b_v   := zb.vol
                vlb_bull_state := 5
            else
                vlb_bull_state := 0
                vlb_bull_p_lo  := na
                vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // A (expects state==5) — ladder completion
    if nzb_a and vlb_bull_state > 0
        if vlb_bull_state == 5
            level za = f_last_zone(lower_a)
            if za.upper >= vlb_bull_p_lo
                vlb_bull_a_o      := za.o
                vlb_bull_a_h      := za.h
                vlb_bull_a_l      := za.l
                vlb_bull_a_c      := za.c
                vlb_bull_a_v      := za.vol
                vlb_bull_complete := true
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na

// ─── BEARISH LADDER PROCESSING (mirror — new.low <= prior.high) ─────────────
bool vlb_bear_complete = false

if any_bull_zone_bar
    vlb_bear_state := 0
    vlb_bear_p_lo  := na
    vlb_bear_p_hi  := na
else if any_bear_zone_bar
    if nzs_f
        if vlb_bear_state == 0
            level zf = f_last_zone(upper_f)
            vlb_bear_p_lo  := zf.lower
            vlb_bear_p_hi  := zf.upper
            vlb_bear_f_o   := zf.o
            vlb_bear_f_h   := zf.h
            vlb_bear_f_l   := zf.l
            vlb_bear_f_c   := zf.c
            vlb_bear_f_v   := zf.vol
            vlb_bear_state := 1
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_e and vlb_bear_state > 0
        if vlb_bear_state == 1
            level ze = f_last_zone(upper_e)
            if ze.lower <= vlb_bear_p_hi
                vlb_bear_p_lo  := ze.lower
                vlb_bear_p_hi  := ze.upper
                vlb_bear_e_o   := ze.o
                vlb_bear_e_h   := ze.h
                vlb_bear_e_l   := ze.l
                vlb_bear_e_c   := ze.c
                vlb_bear_e_v   := ze.vol
                vlb_bear_state := 2
            else
                vlb_bear_state := 0
                vlb_bear_p_lo  := na
                vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_d and vlb_bear_state > 0
        if vlb_bear_state == 2
            level zd = f_last_zone(upper_d)
            if zd.lower <= vlb_bear_p_hi
                vlb_bear_p_lo  := zd.lower
                vlb_bear_p_hi  := zd.upper
                vlb_bear_d_o   := zd.o
                vlb_bear_d_h   := zd.h
                vlb_bear_d_l   := zd.l
                vlb_bear_d_c   := zd.c
                vlb_bear_d_v   := zd.vol
                vlb_bear_state := 3
            else
                vlb_bear_state := 0
                vlb_bear_p_lo  := na
                vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_c and vlb_bear_state > 0
        if vlb_bear_state == 3
            level zc = f_last_zone(upper_c)
            if zc.lower <= vlb_bear_p_hi
                vlb_bear_p_lo  := zc.lower
                vlb_bear_p_hi  := zc.upper
                vlb_bear_c_o   := zc.o
                vlb_bear_c_h   := zc.h
                vlb_bear_c_l   := zc.l
                vlb_bear_c_c   := zc.c
                vlb_bear_c_v   := zc.vol
                vlb_bear_state := 4
            else
                vlb_bear_state := 0
                vlb_bear_p_lo  := na
                vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_b and vlb_bear_state > 0
        if vlb_bear_state == 4
            level zb = f_last_zone(upper_b)
            if zb.lower <= vlb_bear_p_hi
                vlb_bear_p_lo  := zb.lower
                vlb_bear_p_hi  := zb.upper
                vlb_bear_b_o   := zb.o
                vlb_bear_b_h   := zb.h
                vlb_bear_b_l   := zb.l
                vlb_bear_b_c   := zb.c
                vlb_bear_b_v   := zb.vol
                vlb_bear_state := 5
            else
                vlb_bear_state := 0
                vlb_bear_p_lo  := na
                vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_a and vlb_bear_state > 0
        if vlb_bear_state == 5
            level za = f_last_zone(upper_a)
            if za.lower <= vlb_bear_p_hi
                vlb_bear_a_o      := za.o
                vlb_bear_a_h      := za.h
                vlb_bear_a_l      := za.l
                vlb_bear_a_c      := za.c
                vlb_bear_a_v      := za.vol
                vlb_bear_complete := true
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na

// ─── GATING — barstate.isconfirmed + cooldown → 1:1 plot/alert parity ───────
bool plot_vlb_bull = show_vlb_bull and vlb_bull_complete and barstate.isconfirmed and f_cd_ok(last_vlb_b, cooldown_bars)
bool plot_vlb_bear = show_vlb_bear and vlb_bear_complete and barstate.isconfirmed and f_cd_ok(last_vlb_r, cooldown_bars)

if plot_vlb_bull
    last_vlb_b := bar_index
if plot_vlb_bear
    last_vlb_r := bar_index

// ─── VISUAL PLOTSHAPES (one bar only — exact zone-A completion bar) ─────────
// Bull: green up-triangle below the bar.  Bear: red down-triangle above the bar.
plotshape(plot_vlb_bull, "VLB Bull (strict F→A)", shape.triangleup,   location.belowbar, color.new(color.lime, 0), size = size.normal, text = "VLB↑", textcolor = color.lime)
plotshape(plot_vlb_bear, "VLB Bear (strict F→A)", shape.triangledown, location.abovebar, color.new(color.red,  0), size = size.normal, text = "VLB↓", textcolor = color.red)

// ─── ALERTCONDITION — single VLB consolidated channel ───────────────────────
alertcondition(plot_vlb_bull or plot_vlb_bear, "VLB Strict Ladder (v10)", "VOB v10 VLB strict-chronological-ladder detection fired — check alert() payload for direction, per-tier OHLCV, and market context")

// ─── BLOOMBERG-FORMAT ALERTS — 1:1 parity with plotshapes above ─────────────
// Schema: EVENT|TICKER|EXCHANGE|TF|DIR|CLOSE|SENS_A..F|
//         ZF_O|ZF_H|ZF_L|ZF_C|ZF_V| ... |ZA_O|ZA_H|ZA_L|ZA_C|ZA_V|
//         RSI|VOLRANK|SESS|BULLSTACK/BEARSTACK|BULLGAP/BEARGAP

f_vlb_fmt_p(float v) =>
    na(v) ? "na" : str.tostring(math.round(v * 100) / 100)
f_vlb_fmt_v(float v) =>
    na(v) ? "na" : str.tostring(math.round(v))

if plot_vlb_bull
    string vsb = "SENS_A:" + str.tostring(sens_a) + "|SENS_B:" + str.tostring(sens_b) + "|SENS_C:" + str.tostring(sens_c) + "|SENS_D:" + str.tostring(sens_d) + "|SENS_E:" + str.tostring(sens_e) + "|SENS_F:" + str.tostring(sens_f)
    string zf = "ZF_O:" + f_vlb_fmt_p(vlb_bull_f_o) + "|ZF_H:" + f_vlb_fmt_p(vlb_bull_f_h) + "|ZF_L:" + f_vlb_fmt_p(vlb_bull_f_l) + "|ZF_C:" + f_vlb_fmt_p(vlb_bull_f_c) + "|ZF_V:" + f_vlb_fmt_v(vlb_bull_f_v)
    string ze = "ZE_O:" + f_vlb_fmt_p(vlb_bull_e_o) + "|ZE_H:" + f_vlb_fmt_p(vlb_bull_e_h) + "|ZE_L:" + f_vlb_fmt_p(vlb_bull_e_l) + "|ZE_C:" + f_vlb_fmt_p(vlb_bull_e_c) + "|ZE_V:" + f_vlb_fmt_v(vlb_bull_e_v)
    string zd = "ZD_O:" + f_vlb_fmt_p(vlb_bull_d_o) + "|ZD_H:" + f_vlb_fmt_p(vlb_bull_d_h) + "|ZD_L:" + f_vlb_fmt_p(vlb_bull_d_l) + "|ZD_C:" + f_vlb_fmt_p(vlb_bull_d_c) + "|ZD_V:" + f_vlb_fmt_v(vlb_bull_d_v)
    string zc = "ZC_O:" + f_vlb_fmt_p(vlb_bull_c_o) + "|ZC_H:" + f_vlb_fmt_p(vlb_bull_c_h) + "|ZC_L:" + f_vlb_fmt_p(vlb_bull_c_l) + "|ZC_C:" + f_vlb_fmt_p(vlb_bull_c_c) + "|ZC_V:" + f_vlb_fmt_v(vlb_bull_c_v)
    string zb = "ZB_O:" + f_vlb_fmt_p(vlb_bull_b_o) + "|ZB_H:" + f_vlb_fmt_p(vlb_bull_b_h) + "|ZB_L:" + f_vlb_fmt_p(vlb_bull_b_l) + "|ZB_C:" + f_vlb_fmt_p(vlb_bull_b_c) + "|ZB_V:" + f_vlb_fmt_v(vlb_bull_b_v)
    string za = "ZA_O:" + f_vlb_fmt_p(vlb_bull_a_o) + "|ZA_H:" + f_vlb_fmt_p(vlb_bull_a_h) + "|ZA_L:" + f_vlb_fmt_p(vlb_bull_a_l) + "|ZA_C:" + f_vlb_fmt_p(vlb_bull_a_c) + "|ZA_V:" + f_vlb_fmt_v(vlb_bull_a_v)
    string tail = "RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100)
    alert("VLB_BULL|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|DIR:BULL|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|" + vsb + "|" + zf + "|" + ze + "|" + zd + "|" + zc + "|" + zb + "|" + za + "|" + tail, alert.freq_once_per_bar_close)

if plot_vlb_bear
    string vsb = "SENS_A:" + str.tostring(sens_a) + "|SENS_B:" + str.tostring(sens_b) + "|SENS_C:" + str.tostring(sens_c) + "|SENS_D:" + str.tostring(sens_d) + "|SENS_E:" + str.tostring(sens_e) + "|SENS_F:" + str.tostring(sens_f)
    string zf = "ZF_O:" + f_vlb_fmt_p(vlb_bear_f_o) + "|ZF_H:" + f_vlb_fmt_p(vlb_bear_f_h) + "|ZF_L:" + f_vlb_fmt_p(vlb_bear_f_l) + "|ZF_C:" + f_vlb_fmt_p(vlb_bear_f_c) + "|ZF_V:" + f_vlb_fmt_v(vlb_bear_f_v)
    string ze = "ZE_O:" + f_vlb_fmt_p(vlb_bear_e_o) + "|ZE_H:" + f_vlb_fmt_p(vlb_bear_e_h) + "|ZE_L:" + f_vlb_fmt_p(vlb_bear_e_l) + "|ZE_C:" + f_vlb_fmt_p(vlb_bear_e_c) + "|ZE_V:" + f_vlb_fmt_v(vlb_bear_e_v)
    string zd = "ZD_O:" + f_vlb_fmt_p(vlb_bear_d_o) + "|ZD_H:" + f_vlb_fmt_p(vlb_bear_d_h) + "|ZD_L:" + f_vlb_fmt_p(vlb_bear_d_l) + "|ZD_C:" + f_vlb_fmt_p(vlb_bear_d_c) + "|ZD_V:" + f_vlb_fmt_v(vlb_bear_d_v)
    string zc = "ZC_O:" + f_vlb_fmt_p(vlb_bear_c_o) + "|ZC_H:" + f_vlb_fmt_p(vlb_bear_c_h) + "|ZC_L:" + f_vlb_fmt_p(vlb_bear_c_l) + "|ZC_C:" + f_vlb_fmt_p(vlb_bear_c_c) + "|ZC_V:" + f_vlb_fmt_v(vlb_bear_c_v)
    string zb = "ZB_O:" + f_vlb_fmt_p(vlb_bear_b_o) + "|ZB_H:" + f_vlb_fmt_p(vlb_bear_b_h) + "|ZB_L:" + f_vlb_fmt_p(vlb_bear_b_l) + "|ZB_C:" + f_vlb_fmt_p(vlb_bear_b_c) + "|ZB_V:" + f_vlb_fmt_v(vlb_bear_b_v)
    string za = "ZA_O:" + f_vlb_fmt_p(vlb_bear_a_o) + "|ZA_H:" + f_vlb_fmt_p(vlb_bear_a_h) + "|ZA_L:" + f_vlb_fmt_p(vlb_bear_a_l) + "|ZA_C:" + f_vlb_fmt_p(vlb_bear_a_c) + "|ZA_V:" + f_vlb_fmt_v(vlb_bear_a_v)
    string tail = "RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|SESS:" + str.tostring(sess_bar_count) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100)
    alert("VLB_BEAR|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|DIR:BEAR|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|" + vsb + "|" + zf + "|" + ze + "|" + zd + "|" + zc + "|" + zb + "|" + za + "|" + tail, alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// MULTI-ZONE SAME-CANDLE DETECTION (v10 ADDITION) — 4 new plots + alerts
// ═══════════════════════════════════════════════════════════════════════════════
// Fires when 2 or 3+ zone-formation visual plots (zA / zB / zC / zD / zE / zF)
// appear on the SAME candle, separately for bullish and bearish.
//
//   Bull 2  = exactly 2 bullish zone-formation markers on this bar
//   Bull 3+ = 3 or more bullish zone-formation markers on this bar
//   Bear 2  = exactly 2 bearish zone-formation markers on this bar
//   Bear 3+ = 3 or more bearish zone-formation markers on this bar
//
// Mutual exclusivity: within a direction, only one of {2, 3+} can fire per bar.
// Across directions, a bull and a bear multi-zone can co-fire on the same bar.
//
// 1:1 parity + non-repainting:
//   The detection counts off fire_zb_* / fire_zs_*, which are the same booleans
//   that drive the on-chart zA…zF cross markers. Those booleans are gated on
//   bar close (zone formation is inside f_vob's barstate.isconfirmed branch),
//   so they never paint and then disappear. The plotshapes and alert() calls
//   below all read from a single boolean per detection (plot_mz_*), so what
//   the eye sees on the chart matches exactly what arrives in the alert inbox.

// ─── COUNTS — how many zone-formation markers fired on this bar ─────────────
int mz_bull_cnt = (fire_zb_a ? 1 : 0) + (fire_zb_b ? 1 : 0) + (fire_zb_c ? 1 : 0) + (fire_zb_d ? 1 : 0) + (fire_zb_e ? 1 : 0) + (fire_zb_f ? 1 : 0)
int mz_bear_cnt = (fire_zs_a ? 1 : 0) + (fire_zs_b ? 1 : 0) + (fire_zs_c ? 1 : 0) + (fire_zs_d ? 1 : 0) + (fire_zs_e ? 1 : 0) + (fire_zs_f ? 1 : 0)

// ─── GATED DETECTION BOOLS — toggle + count + barstate.isconfirmed + cooldown
bool plot_mz_b2 = show_multi_bull_2 and mz_bull_cnt == 2 and barstate.isconfirmed and f_cd_ok(last_mz_b2, cooldown_bars)
bool plot_mz_b3 = show_multi_bull_3 and mz_bull_cnt >= 3 and barstate.isconfirmed and f_cd_ok(last_mz_b3, cooldown_bars)
bool plot_mz_s2 = show_multi_bear_2 and mz_bear_cnt == 2 and barstate.isconfirmed and f_cd_ok(last_mz_s2, cooldown_bars)
bool plot_mz_s3 = show_multi_bear_3 and mz_bear_cnt >= 3 and barstate.isconfirmed and f_cd_ok(last_mz_s3, cooldown_bars)

if plot_mz_b2
    last_mz_b2 := bar_index
if plot_mz_b3
    last_mz_b3 := bar_index
if plot_mz_s2
    last_mz_s2 := bar_index
if plot_mz_s3
    last_mz_s3 := bar_index

// ─── VISUAL PLOTSHAPES — 1:1 parity with detection bools ────────────────────
// Bull markers below bar, bear markers above bar. Square = 2-zone (lighter
// confluence), flag = 3+-zone (heavier confluence).
plotshape(plot_mz_b2, "Multi-Zone Bull 2 (same candle)",  shape.square, location.belowbar, color.new(color.lime, 0), size = size.small,  text = "MZ2↑", textcolor = color.lime)
plotshape(plot_mz_b3, "Multi-Zone Bull 3+ (same candle)", shape.flag,   location.belowbar, color.new(color.lime, 0), size = size.normal, text = "MZ3↑", textcolor = color.lime)
plotshape(plot_mz_s2, "Multi-Zone Bear 2 (same candle)",  shape.square, location.abovebar, color.new(color.red,  0), size = size.small,  text = "MZ2↓", textcolor = color.red)
plotshape(plot_mz_s3, "Multi-Zone Bear 3+ (same candle)", shape.flag,   location.abovebar, color.new(color.red,  0), size = size.normal, text = "MZ3↓", textcolor = color.red)

// ─── ALERTCONDITIONS — one per detection so each can be subscribed ──────────
alertcondition(plot_mz_b2, "Multi-Zone Bull 2 (same candle)",  "VOB v10 — exactly 2 bullish zone-formation visual plots on the same candle")
alertcondition(plot_mz_b3, "Multi-Zone Bull 3+ (same candle)", "VOB v10 — 3 or more bullish zone-formation visual plots on the same candle")
alertcondition(plot_mz_s2, "Multi-Zone Bear 2 (same candle)",  "VOB v10 — exactly 2 bearish zone-formation visual plots on the same candle")
alertcondition(plot_mz_s3, "Multi-Zone Bear 3+ (same candle)", "VOB v10 — 3 or more bearish zone-formation visual plots on the same candle")

// ─── BLOOMBERG-FORMAT ALERTS — 1:1 with plotshapes, includes which tiers ────
// Tier strings are built lazily inside the firing-side if-block to avoid
// per-bar string concatenation when no multi-zone is firing.

if plot_mz_b2 or plot_mz_b3
    string tiers_b = ""
    if fire_zb_a
        tiers_b += "A(" + str.tostring(sens_a) + "),"
    if fire_zb_b
        tiers_b += "B(" + str.tostring(sens_b) + "),"
    if fire_zb_c
        tiers_b += "C(" + str.tostring(sens_c) + "),"
    if fire_zb_d
        tiers_b += "D(" + str.tostring(sens_d) + "),"
    if fire_zb_e
        tiers_b += "E(" + str.tostring(sens_e) + "),"
    if fire_zb_f
        tiers_b += "F(" + str.tostring(sens_f) + "),"
    string mz_b_tail = "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100) + "|NRBULLDIST:" + str.tostring(math.round(nearest_bull_dist * 100) / 100) + "|TIERS:" + tiers_b
    if plot_mz_b2
        alert("MULTI_ZONE_BULL_2|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|DIR:BULL|COUNT:" + str.tostring(mz_bull_cnt) + mz_b_tail, alert.freq_once_per_bar_close)
    if plot_mz_b3
        alert("MULTI_ZONE_BULL_3PLUS|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|DIR:BULL|COUNT:" + str.tostring(mz_bull_cnt) + mz_b_tail, alert.freq_once_per_bar_close)

if plot_mz_s2 or plot_mz_s3
    string tiers_s = ""
    if fire_zs_a
        tiers_s += "A(" + str.tostring(sens_a) + "),"
    if fire_zs_b
        tiers_s += "B(" + str.tostring(sens_b) + "),"
    if fire_zs_c
        tiers_s += "C(" + str.tostring(sens_c) + "),"
    if fire_zs_d
        tiers_s += "D(" + str.tostring(sens_d) + "),"
    if fire_zs_e
        tiers_s += "E(" + str.tostring(sens_e) + "),"
    if fire_zs_f
        tiers_s += "F(" + str.tostring(sens_f) + "),"
    string mz_s_tail = "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100) + "|NRBEARDIST:" + str.tostring(math.round(nearest_bear_dist * 100) / 100) + "|TIERS:" + tiers_s
    if plot_mz_s2
        alert("MULTI_ZONE_BEAR_2|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|DIR:BEAR|COUNT:" + str.tostring(mz_bear_cnt) + mz_s_tail, alert.freq_once_per_bar_close)
    if plot_mz_s3
        alert("MULTI_ZONE_BEAR_3PLUS|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|DIR:BEAR|COUNT:" + str.tostring(mz_bear_cnt) + mz_s_tail, alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// ███ v11 ADDITION — HW SINGLE v3 DETECTION ENGINE (EMBEDDED, READ-ONLY) ███
// ═══════════════════════════════════════════════════════════════════════════════
// This block is a READ-ONLY port of the detection logic from "Heavy Weapons
// Single v3" (HW Single v3). The standalone HW Single v3 indicator is NOT
// modified, replaced, or touched in any way — its math is replicated here only
// so this VOB indicator can know, on a given bar, whether ANY HW Single v3
// detection plot would have fired. All HW-Single visuals (plotshapes, info
// table, aggregated alert) are intentionally OMITTED — we keep only the boolean
// signals and collapse them into one master boolean: `hws_any`.
//
// Faithfulness notes:
//   • Signal math is transcribed verbatim from HW Single v3 (RVOL 0.56, Reg@Time
//     WTC/Hiroshima/Pentagon, Hybrid Momentum LONG/SHORT, Nagasaki, Displacement,
//     Sequences UU..DDDD, B2B, FAUNA, HV150..1000, HCT 15-combo, Pentagon specials).
//   • The per-plot visibility toggles (show_*) are dropped — a detection counts
//     toward `hws_any` whenever its SIGNAL + GATE fire, regardless of HW-Single
//     visibility. The numeric tuning inputs are exposed so they can be matched to
//     the live HW Single v3 settings per timeframe.
//   • Identifiers that collide with the VOB host (isNagasaki, vol, maxVol) are
//     renamed with an `hw_` prefix. Everything else keeps HW Single v3 names.
// ═══════════════════════════════════════════════════════════════════════════════

string GRP_HWS = "HW Single v3 Engine (embedded — read-only)"

// ── RVOL Bull/Bear ──
int   bb_avgLength = input.int(30, "HWS · RVOL Lookback",  minval=1, group=GRP_HWS)
int   bb_smaLength = input.int(20, "HWS · RVOL SMA Length", minval=1, group=GRP_HWS)
// ── Reg @ Time ──
string reg_anchorTimeframe = input.timeframe("", "HWS · Reg@Time Anchor (blank=chart)", group=GRP_HWS)
int    reg_length          = input.int(30, "HWS · Reg@Time Length", minval=1, group=GRP_HWS)
string reg_calculationMode = input.string("Cumulative", "HWS · Reg@Time Mode", options=["Cumulative","Regular"], group=GRP_HWS)
bool   reg_adjustRealtime  = input.bool(true, "HWS · Reg@Time Adjust Unconfirmed", group=GRP_HWS)
// ── Hybrid regime % ──
int reg_pct  = input.int(100, "HWS · Reg Floor %",  minval=0, group=GRP_HWS)
int cum_pct  = input.int(100, "HWS · Cum Floor %",  minval=0, group=GRP_HWS)
int body_pct = input.int(100, "HWS · Body Ratio %", minval=0, group=GRP_HWS)
// ── Nagasaki ──
bool enableNagasaki = input.bool(true, "HWS · Enable Nagasaki", group=GRP_HWS)
// ── Sequence lower thresholds ──
float th_low_UU_DD     = input.float(0.5, "HWS · Seq Lower (UU/DD)",     step=0.1, minval=0.5, group=GRP_HWS)
float th_low_UUU_DDD   = input.float(0.5, "HWS · Seq Lower (UUU/DDD)",   step=0.1, minval=0.5, group=GRP_HWS)
float th_low_UUUU_DDDD = input.float(0.5, "HWS · Seq Lower (UUUU/DDDD)", step=0.1, minval=0.5, group=GRP_HWS)
// ── Displacement StdDev ──
string i_disp_type           = input.string("Open to Close", "HWS · Disp Range Type", options=['Open to Close','High to Low'], group=GRP_HWS)
int    i_std_len             = input.int(100, "HWS · Disp Std Dev Length", minval=1, group=GRP_HWS)
float  i_disp_std_standalone = input.float(7.5, "HWS · Disp Standalone σ", minval=0, step=0.1, group=GRP_HWS)
float  i_disp_std_cdisp2     = input.float(5.0, "HWS · Disp Consec2 σ",    minval=0, step=0.1, group=GRP_HWS)
float  i_disp_std_cdisp3     = input.float(3.0, "HWS · Disp Consec3 σ",    minval=0, step=0.1, group=GRP_HWS)
float  i_disp_std_seq        = input.float(5.0, "HWS · Disp Seq/FAUNA σ",  minval=0, step=0.1, group=GRP_HWS)
// ── HCT displacement ──
float hct_disp_strength = input.float(6.0, "HWS · HCT Disp σ", minval=1.0, step=0.5, group=GRP_HWS)
int   hct_disp_lookback = input.int(100, "HWS · HCT Disp Lookback", minval=10, group=GRP_HWS)
float hct_threshPct     = input.float(2, "HWS · HCT FVG Threshold %", minval=0, maxval=100, step=0.1, group=GRP_HWS)
bool  hct_auto          = input.bool(true, "HWS · HCT Auto FVG Threshold", group=GRP_HWS)

// ── Threshold ladder (verbatim) ──
// TICK-FRIENDLY GUARD: timeframe.in_seconds() returns na on tick resolutions (e.g. "10T");
// that na would poison the entire HWS threshold ladder. Fall back to an assumed seconds/bar.
int tick_assumed_tfsec = input.int(60, "TICK MODE · Assumed seconds/bar for HWS thresholds (used when timeframe.in_seconds is na on tick charts)", minval=1, group=GRP_HWS)
float hws_tfSec_raw = timeframe.in_seconds(timeframe.period)
float hws_tfSec = na(hws_tfSec_raw) or hws_tfSec_raw == 0 ? tick_assumed_tfsec : hws_tfSec_raw
f_rvol_1x_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10 ? 38.0 : s <= 15 ? 33.0 : s <= 30 ? 28.0 : s <= 45 ? 23.0 : s <= 60 ? 20.0 : s <= 120 ? 19.0 : s <= 180 ? 17.0 : s <= 240 ? 16.0 : s <= 300 ? 15.0 : s <= 360 ? 14.0 : s <= 420 ? 12.0 : s <= 480 ? 11.0 : s <= 540 ? 10.0 : s <= 600 ? 10.0 : s <= 900 ? 8.4 : s <= 1800 ? 6.9 : s <= 3600 ? 5.9 : s <= 7200 ? 3.0 : 1.8
    th
f_saab_kratos_threshold(_tfSec) => f_rvol_1x_threshold(_tfSec) * 0.56
f_gs_moab_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10 ? 114.0 : s <= 15 ? 99.0 : s <= 30 ? 84.0 : s <= 45 ? 69.0 : s <= 60 ? 35.0 : s <= 300 ? 35.0 : s <= 600 ? 25.0 : s <= 900 ? 20.0 : s <= 3600 ? 10.0 : 8.0
    th
f_wtc_threshold(_tfSec) => f_rvol_1x_threshold(_tfSec) * 2.0
f_hiroshima_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10 ? 114.0 : s <= 15 ? 99.0 : s <= 30 ? 84.0 : s <= 45 ? 69.0 : s <= 60 ? 35.0 : s <= 300 ? 35.0 : s <= 600 ? 25.0 : s <= 900 ? 20.0 : s <= 3600 ? 10.0 : 8.0
    th
th_saab_kratos = f_saab_kratos_threshold(hws_tfSec)
th_1x          = f_rvol_1x_threshold(hws_tfSec)
th_gs_moab     = f_gs_moab_threshold(hws_tfSec)
th_wtc         = f_wtc_threshold(hws_tfSec)
th_hiroshima   = f_hiroshima_threshold(hws_tfSec)

// ── Hybrid momentum auto-derive ──
hybAutoReg1 = th_hiroshima * 2.85
hybAutoReg5 = th_hiroshima * 1.1875
hybAutoStep = (hybAutoReg1 - hybAutoReg5) / 4.0
hybAutoReg2 = hybAutoReg1 - 1.0 * hybAutoStep
hybAutoReg3 = hybAutoReg1 - 2.0 * hybAutoStep
hybAutoReg4 = hybAutoReg1 - 3.0 * hybAutoStep
float hybCumPhi = 1.398 * 1.33
hybAutoCum1 = hybCumPhi * math.sqrt(math.log(hybAutoReg1))
hybAutoCum2 = hybCumPhi * math.sqrt(math.log(hybAutoReg2))
hybAutoCum3 = hybCumPhi * math.sqrt(math.log(hybAutoReg3))
hybAutoCum4 = hybCumPhi * math.sqrt(math.log(hybAutoReg4))
hybAutoCum5 = hybCumPhi * math.sqrt(math.log(hybAutoReg5))
float hybAutoBody1 = 0.69, float hybAutoBody2 = 0.72, float hybAutoBody3 = 0.75, float hybAutoBody4 = 0.78, float hybAutoBody5 = 0.81
float regMult  = reg_pct  / 100.0
float cumMult  = cum_pct  / 100.0
float bodyMult = body_pct / 100.0
hybReg1Eff = hybAutoReg1*regMult, hybReg2Eff = hybAutoReg2*regMult, hybReg3Eff = hybAutoReg3*regMult, hybReg4Eff = hybAutoReg4*regMult, hybReg5Eff = hybAutoReg5*regMult
hybCum1Eff = hybAutoCum1*cumMult, hybCum2Eff = hybAutoCum2*cumMult, hybCum3Eff = hybAutoCum3*cumMult, hybCum4Eff = hybAutoCum4*cumMult, hybCum5Eff = hybAutoCum5*cumMult
hybBody1Eff = hybAutoBody1*bodyMult, hybBody2Eff = hybAutoBody2*bodyMult, hybBody3Eff = hybAutoBody3*bodyMult, hybBody4Eff = hybAutoBody4*bodyMult, hybBody5Eff = hybAutoBody5*bodyMult

// ── RVOL Bull/Bear signals ──
bb_spike = math.abs(close - open)
bb_avgSpikeDenom = ta.sma(bb_spike, bb_avgLength)[1]
bb_normalizedPrice = bb_spike / nz(bb_avgSpikeDenom, 1.0)
bb_avgVolDenom = ta.sma(volume, bb_avgLength)[1]
bb_normalizedVolume = volume / nz(bb_avgVolDenom, 1.0)
bb_diff = bb_normalizedPrice - bb_normalizedVolume
bb_positiveDiff = bb_diff > 0 ? bb_diff : na
bb_smaDiff = ta.sma(bb_positiveDiff, bb_smaLength)
bb_baseBullish = (close > open) and (bb_positiveDiff > bb_smaDiff)
bb_baseBearish = (close < open) and (bb_positiveDiff > bb_smaDiff)
bb_inRange(v, lowTh, highTh) => v >= lowTh and v < highTh
conf = barstate.isconfirmed
sigSAAB       = conf and bb_baseBullish and bb_inRange(bb_normalizedPrice, th_saab_kratos, th_1x)
sigKratos     = conf and bb_baseBearish and bb_inRange(bb_normalizedPrice, th_saab_kratos, th_1x)
sigBullRVOL1x = conf and bb_baseBullish and bb_inRange(bb_normalizedPrice, th_1x, th_gs_moab)
sigBearRVOL1x = conf and bb_baseBearish and bb_inRange(bb_normalizedPrice, th_1x, th_gs_moab)
sigGrandSlam  = conf and bb_baseBullish and (bb_normalizedPrice >= th_gs_moab)
sigMOAB       = conf and bb_baseBearish and (bb_normalizedPrice >= th_gs_moab)

// ── Reg@Time WTC/Hiroshima/Pentagon ──
[currentVolume_reg, pastVolume_reg, _hwsReg] = tv_ta.relativeVolume(reg_length, reg_anchorTimeframe, reg_calculationMode == "Cumulative", reg_adjustRealtime)
relVolRatio  = currentVolume_reg / pastVolume_reg
sigWTC       = conf and (relVolRatio > th_wtc) and (relVolRatio <= th_hiroshima)
sigHiroshima = conf and (relVolRatio > th_hiroshima)
sigPentagon  = conf and (relVolRatio >= th_1x) and (relVolRatio <= th_wtc)

// ── Hybrid momentum LONG/SHORT ──
[hybRegCur, hybRegPast, _hwsHr] = tv_ta.relativeVolume(reg_length, reg_anchorTimeframe, false, reg_adjustRealtime)
[hybCumCur, hybCumPast, _hwsHc] = tv_ta.relativeVolume(reg_length, reg_anchorTimeframe, true,  reg_adjustRealtime)
hybRegRatio = hybRegCur / hybRegPast
hybCumRatio = hybCumCur / hybCumPast
hybBodySz  = math.abs(close - open)
hybRange   = high - low
hybBodyRat = hybRange == 0 ? 0.0 : hybBodySz / hybRange
hybConvict1 = hybBodyRat >= hybBody1Eff
hybBull1 = (close > open) and hybConvict1
hybBear1 = (close < open) and hybConvict1
hybMom1 = conf and (hybRegRatio > hybReg1Eff) and (hybCumRatio > hybCum1Eff)
sigAddLong1  = hybMom1 and hybBull1
sigAddShort1 = hybMom1 and hybBear1
hybConvict2 = hybBodyRat >= hybBody2Eff
hybBull2 = (close > open) and hybConvict2
hybBear2 = (close < open) and hybConvict2
hybMom2 = conf and (hybRegRatio > hybReg2Eff) and (hybCumRatio > hybCum2Eff)
sigAddLong2  = hybMom2 and hybBull2
sigAddShort2 = hybMom2 and hybBear2
hybConvict3 = hybBodyRat >= hybBody3Eff
hybBull3 = (close > open) and hybConvict3
hybMom3 = conf and (hybRegRatio > hybReg3Eff) and (hybCumRatio > hybCum3Eff)
sigAddLong3  = hybMom3 and hybBull3
hybConvict4 = hybBodyRat >= hybBody4Eff
hybBull4 = (close > open) and hybConvict4
hybMom4 = conf and (hybRegRatio > hybReg4Eff) and (hybCumRatio > hybCum4Eff)
sigAddLong4  = hybMom4 and hybBull4
hybConvict5 = hybBodyRat >= hybBody5Eff
hybBull5 = (close > open) and hybConvict5
hybMom5 = conf and (hybRegRatio > hybReg5Eff) and (hybCumRatio > hybCum5Eff)
sigAddLong5  = hybMom5 and hybBull5

// ── Nagasaki (renamed to hw_*) ──
hw_vol = volume
var float hw_maxVol = 0.0
bool hw_isNagasaki = false
if conf
    if bar_index == 0
        hw_maxVol := hw_vol
    else if hw_vol > hw_maxVol
        hw_isNagasaki := true
        hw_maxVol := hw_vol
sigNagasaki = enableNagasaki and hw_isNagasaki

// ── Gating helpers ──
anyLong  = sigAddLong1 or sigAddLong2 or sigAddLong3 or sigAddLong4 or sigAddLong5
anyShort = sigAddShort1 or sigAddShort2
anyMom   = anyLong or anyShort
anyLong_1 = sigAddLong1[1] or sigAddLong2[1] or sigAddLong3[1] or sigAddLong4[1] or sigAddLong5[1]
anyHV_cur = conf and (volume == ta.highest(volume, 150))

// ── HCT displacement engine ──
float hct_thresh     = hct_auto ? ta.cum((high - low) / low) / bar_index : hct_threshPct / 100
bool  hct_bFVG       = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > hct_thresh
bool  hct_sFVG       = high < low[2] and close[1] < low[2] and (low[2] - high) / high > hct_thresh
float hct_barRange   = high[1] - low[1]
float hct_rangeStdev = ta.stdev(high - low, hct_disp_lookback)
bool  hct_dispMet    = hct_barRange > hct_disp_strength * nz(hct_rangeStdev[1])
bool hct_dispBull = conf and hct_dispMet and (close[1] > open[1]) and hct_bFVG
bool hct_dispBear = conf and hct_dispMet and (close[1] < open[1]) and hct_sFVG
bool hct_noDisp   = not hct_dispBull and not hct_dispBear

// ── HCT 15-combo ──
bool groupA_Bull = sigBullRVOL1x or sigGrandSlam
bool groupA_Bear = sigBearRVOL1x or sigMOAB
bool groupB      = sigPentagon or sigWTC or sigHiroshima
bool baseYinYang   = (groupA_Bull or groupA_Bear) and groupB
bool baseNagasaki  = sigNagasaki and (groupA_Bull or groupA_Bear)
bool baseNagasakiV = sigNagasaki and groupB
bool baseTrident   = sigNagasaki and (groupA_Bull or groupA_Bear) and groupB
bool baseNHx2      = (sigPentagon and sigWTC) or (sigPentagon and sigHiroshima) or (sigWTC and sigHiroshima)
bool sigHYYBull  = baseYinYang   and hct_dispBull
bool sigHYYBear  = baseYinYang   and hct_dispBear
bool sigHNBull   = baseNagasaki  and hct_dispBull
bool sigHNBear   = baseNagasaki  and hct_dispBear
bool sigHNVBull  = baseNagasakiV and hct_dispBull
bool sigHNVBear  = baseNagasakiV and hct_dispBear
bool sigHTBull   = baseTrident   and hct_dispBull
bool sigHTBear   = baseTrident   and hct_dispBear
bool sigNHx2Bull = baseNHx2      and hct_dispBull
bool sigNHx2Bear = baseNHx2      and hct_dispBear
bool sigHYYNDBull  = baseYinYang   and hct_noDisp and groupA_Bull
bool sigHYYNDBear  = baseYinYang   and hct_noDisp and groupA_Bear
bool sigHNNDBull   = baseNagasaki  and hct_noDisp and groupA_Bull
bool sigHNNDBear   = baseNagasaki  and hct_noDisp and groupA_Bear
bool sigHNVNDBull  = baseNagasakiV and hct_noDisp and (close > open)
bool sigHNVNDBear  = baseNagasakiV and hct_noDisp and (close < open)
bool sigHTNDBull   = baseTrident   and hct_noDisp and groupA_Bull
bool sigHTNDBear   = baseTrident   and hct_noDisp and groupA_Bear
bool sigNHx2NDBull = baseNHx2      and hct_noDisp and (close > open)
bool sigNHx2NDBear = baseNHx2      and hct_noDisp and (close < open)
bool hctMasterBull = sigHYYBull or sigHNBull or sigHNVBull or sigHTBull or sigNHx2Bull or sigHYYNDBull or sigHNNDBull or sigHNVNDBull or sigHTNDBull or sigNHx2NDBull
bool hctMasterBear = sigHYYBear or sigHNBear or sigHNVBear or sigHTBear or sigNHx2Bear or sigHYYNDBear or sigHNNDBear or sigHNVNDBear or sigHTNDBear or sigNHx2NDBear
bool anySinglesRaw = sigSAAB or sigKratos or sigBullRVOL1x or sigBearRVOL1x or sigGrandSlam or sigMOAB or sigWTC or sigHiroshima or sigNagasaki or anyLong or anyShort
bool hctGatedBull  = hctMasterBull and anySinglesRaw
bool hctGatedBear  = hctMasterBear and anySinglesRaw

// ── Pentagon specials ──
bool pentDisp5     = (high - low) > nz(hct_rangeStdev) * 5.0
bool sigPentHV1K   = conf and sigPentagon and (volume == ta.highest(volume, 1000))
bool sigPentHV500D = conf and sigPentagon and (volume == ta.highest(volume, 500)) and pentDisp5

// ── Displacement engine ──
disp_isBullishFVG = low > high[2] and open[1] < close[1]
disp_isBearishFVG = high < low[2] and open[1] > close[1]
disp_candle_range = i_disp_type == "Open to Close" ? math.abs(open - close) : high - low
disp_std_dev = ta.stdev(disp_candle_range, i_std_len)
disp_th_standalone = disp_std_dev * i_disp_std_standalone
disp_th_cdisp2     = disp_std_dev * i_disp_std_cdisp2
disp_th_cdisp3     = disp_std_dev * i_disp_std_cdisp3
disp_th_seq        = disp_std_dev * i_disp_std_seq
disp_cur_seq = disp_candle_range > disp_th_seq
disp_cur_any = disp_cur_seq
b2b_gate = anyHV_cur or disp_cur_any
disp_prev_standalone = disp_candle_range[1] > disp_th_standalone[1]
sigDispBull = disp_prev_standalone and disp_isBullishFVG
sigDispBear = disp_prev_standalone and disp_isBearishFVG
disp_prev_c2 = disp_candle_range[1] > disp_th_cdisp2[1]
sigDispBull_c2 = disp_prev_c2 and disp_isBullishFVG
sigDispBear_c2 = disp_prev_c2 and disp_isBearishFVG
var int disp_bullStreak_c2 = 0
var int disp_bearStreak_c2 = 0
disp_bullStreak_c2 := sigDispBull_c2 ? disp_bullStreak_c2 + 1 : 0
disp_bearStreak_c2 := sigDispBear_c2 ? disp_bearStreak_c2 + 1 : 0
sigCDispBull2 = sigDispBull_c2 and disp_bullStreak_c2 >= 2
sigCDispBear2 = sigDispBear_c2 and disp_bearStreak_c2 >= 2
disp_prev_c3 = disp_candle_range[1] > disp_th_cdisp3[1]
sigDispBull_c3 = disp_prev_c3 and disp_isBullishFVG
sigDispBear_c3 = disp_prev_c3 and disp_isBearishFVG
var int disp_bullStreak_c3 = 0
var int disp_bearStreak_c3 = 0
disp_bullStreak_c3 := sigDispBull_c3 ? disp_bullStreak_c3 + 1 : 0
disp_bearStreak_c3 := sigDispBear_c3 ? disp_bearStreak_c3 + 1 : 0
sigCDispBull3 = sigDispBull_c3 and disp_bullStreak_c3 >= 3
sigCDispBear3 = sigDispBear_c3 and disp_bearStreak_c3 >= 3

// ── Sequences ──
is_u_bar_UU   = bb_baseBullish and bb_normalizedPrice > th_low_UU_DD
is_u_bar_UUU  = bb_baseBullish and bb_normalizedPrice > th_low_UUU_DDD
is_u_bar_UUUU = bb_baseBullish and bb_normalizedPrice > th_low_UUUU_DDDD
is_d_bar_DD   = bb_baseBearish and bb_normalizedPrice > th_low_UU_DD
is_d_bar_DDD  = bb_baseBearish and bb_normalizedPrice > th_low_UUU_DDD
is_d_bar_DDDD = bb_baseBearish and bb_normalizedPrice > th_low_UUUU_DDDD
var float bull_seq_sum_UU = 0.0
var int   bull_seq_len_UU = 0
var int   bull_disp_UU    = 0
var float bear_seq_sum_DD = 0.0
var int   bear_seq_len_DD = 0
var int   bear_disp_DD    = 0
if conf
    if is_u_bar_UU
        bull_seq_len_UU += 1
        bull_seq_sum_UU += bb_normalizedPrice
        bull_disp_UU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UU := 0
        bull_seq_sum_UU := 0.0
        bull_disp_UU    := 0
    if is_d_bar_DD
        bear_seq_len_DD += 1
        bear_seq_sum_DD += bb_normalizedPrice
        bear_disp_DD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DD := 0
        bear_seq_sum_DD := 0.0
        bear_disp_DD    := 0
var float bull_seq_sum_UUU = 0.0
var int   bull_seq_len_UUU = 0
var int   bull_disp_UUU    = 0
var float bear_seq_sum_DDD = 0.0
var int   bear_seq_len_DDD = 0
var int   bear_disp_DDD    = 0
if conf
    if is_u_bar_UUU
        bull_seq_len_UUU += 1
        bull_seq_sum_UUU += bb_normalizedPrice
        bull_disp_UUU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UUU := 0
        bull_seq_sum_UUU := 0.0
        bull_disp_UUU    := 0
    if is_d_bar_DDD
        bear_seq_len_DDD += 1
        bear_seq_sum_DDD += bb_normalizedPrice
        bear_disp_DDD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DDD := 0
        bear_seq_sum_DDD := 0.0
        bear_disp_DDD    := 0
var float bull_seq_sum_UUUU = 0.0
var int   bull_seq_len_UUUU = 0
var int   bull_disp_UUUU    = 0
var float bear_seq_sum_DDDD = 0.0
var int   bear_seq_len_DDDD = 0
var int   bear_disp_DDDD    = 0
if conf
    if is_u_bar_UUUU
        bull_seq_len_UUUU += 1
        bull_seq_sum_UUUU += bb_normalizedPrice
        bull_disp_UUUU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UUUU := 0
        bull_seq_sum_UUUU := 0.0
        bull_disp_UUUU    := 0
    if is_d_bar_DDDD
        bear_seq_len_DDDD += 1
        bear_seq_sum_DDDD += bb_normalizedPrice
        bear_disp_DDDD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DDDD := 0
        bear_seq_sum_DDDD := 0.0
        bear_disp_DDDD    := 0
sig_bull_UU = conf and bull_seq_len_UU == 2 and bull_seq_sum_UU >= th_saab_kratos and bull_disp_UU >= 1
sig_bear_DD = conf and bear_seq_len_DD == 2 and bear_seq_sum_DD >= th_saab_kratos and bear_disp_DD >= 1
bool uu3_base     = conf and bull_seq_len_UUU == 3
bool uu3_override = uu3_base and bull_disp_UUU >= 2
bool uu3_normal   = uu3_base and bull_disp_UUU >= 1 and bull_seq_sum_UUU >= th_saab_kratos
sig_bull_UUU = uu3_override or uu3_normal
bool dd3_base     = conf and bear_seq_len_DDD == 3
bool dd3_override = dd3_base and bear_disp_DDD >= 2
bool dd3_normal   = dd3_base and bear_disp_DDD >= 1 and bear_seq_sum_DDD >= th_saab_kratos
sig_bear_DDD = dd3_override or dd3_normal
bool uu4_base     = conf and bull_seq_len_UUUU == 4
bool uu4_override = uu4_base and bull_disp_UUUU >= 2
bool uu4_normal   = uu4_base and bull_disp_UUUU >= 1 and bull_seq_sum_UUUU >= th_saab_kratos
sig_bull_UUUU = uu4_override or uu4_normal
bool dd4_base     = conf and bear_seq_len_DDDD == 4
bool dd4_override = dd4_base and bear_disp_DDDD >= 2
bool dd4_normal   = dd4_base and bear_disp_DDDD >= 1 and bear_seq_sum_DDDD >= th_saab_kratos
sig_bear_DDDD = dd4_override or dd4_normal

// ── B2B ──
sig_B2B_2xSAAB   = conf and sigSAAB[1]      and sigSAAB       and b2b_gate
sig_B2B_2xKratos = conf and sigKratos[1]     and sigKratos     and b2b_gate
sig_B2B_2xBull1x = conf and sigBullRVOL1x[1] and sigBullRVOL1x and b2b_gate
sig_B2B_2xBear1x = conf and sigBearRVOL1x[1] and sigBearRVOL1x and b2b_gate
sig_B2B_MidBull = conf and not sig_B2B_2xSAAB   and not sig_B2B_2xBull1x and ((sigSAAB[1] and sigBullRVOL1x) or (sigBullRVOL1x[1] and sigSAAB)) and b2b_gate
sig_B2B_MidBear = conf and not sig_B2B_2xKratos and not sig_B2B_2xBear1x and ((sigKratos[1] and sigBearRVOL1x) or (sigBearRVOL1x[1] and sigKratos)) and b2b_gate

// ── FAUNA (pattern booleans only; text ladder dropped — hws_any needs presence) ──
float fn_alpha_MB=1.6, float fn_beta_MB=0.70, float fn_delta_MB=1.8
int fn_atr_MB=14, int fn_vol_MB=20
float fn_gamma_RE=2.2, float fn_epsilon_RE=0.15, float fn_delta_RE=1.8, int fn_atr_RE=14
float fn_zeta_GG=0.9, float fn_delta_GG=1.8, int fn_atr_GG=14
float fn_theta_TA=1.6, float fn_delta_TA=1.8, int fn_trend_ma_len=50, int fn_avg_delta_len=10, int fn_atr_TA=14
float fn_alpha_SB=1.5, float fn_weak_ratio=0.2, int fn_body_avg=20, int fn_range_avg=20
fn_ATR      = ta.atr(fn_atr_MB)
fn_AvgVol   = ta.sma(volume, fn_vol_MB)
fn_AvgBody  = ta.sma(math.abs(close - open), fn_body_avg)
fn_AvgDelta = ta.sma(math.abs(close - close[1]), fn_avg_delta_len)
fn_TrendMA  = ta.sma(close, fn_trend_ma_len)
fn_body        = close - open
fn_candleRange = high - low
fn_body_up     = fn_body > 0
fn_body_dn     = fn_body < 0
fn_body_size   = math.abs(fn_body)
fn_body_ratio  = fn_candleRange == 0 ? 0.0 : fn_body_size / fn_candleRange
fn_MB_bull = fn_body_up and fn_body_size > fn_alpha_MB * fn_ATR and fn_body_ratio > fn_beta_MB and volume > fn_delta_MB * fn_AvgVol
fn_MB_bear = fn_body_dn and fn_body_size > fn_alpha_MB * fn_ATR and fn_body_ratio > fn_beta_MB and volume > fn_delta_MB * fn_AvgVol
fn_wide    = fn_candleRange > fn_gamma_RE * ta.atr(fn_atr_RE)
fn_RE_bull = fn_body_up and fn_wide and (high - close) < fn_epsilon_RE * fn_candleRange and volume > fn_delta_RE * fn_AvgVol
fn_RE_bear = fn_body_dn and fn_wide and (close - low) < fn_epsilon_RE * fn_candleRange and volume > fn_delta_RE * fn_AvgVol
fn_GG_bull = (open - close[1]) > fn_zeta_GG * ta.atr(fn_atr_GG) and fn_body_up and low > close[1] and volume > fn_delta_GG * fn_AvgVol
fn_GG_bear = (close[1] - open) > fn_zeta_GG * ta.atr(fn_atr_GG) and fn_body_dn and high < close[1] and volume > fn_delta_GG * fn_AvgVol
fn_up_trend = fn_TrendMA > fn_TrendMA[1]
fn_dn_trend = fn_TrendMA < fn_TrendMA[1]
fn_TA_bull = fn_up_trend and fn_body_up and (close - close[1]) > fn_theta_TA * fn_AvgDelta and volume > fn_delta_TA * fn_AvgVol
fn_TA_bear = fn_dn_trend and fn_body_dn and (close[1] - close) > fn_theta_TA * fn_AvgDelta and volume > fn_delta_TA * fn_AvgVol
fn_prev_body  = close[1] - open[1]
fn_prev_range = high[1] - low[1]
fn_StrongBear_pre = close[1] < open[1] and math.abs(fn_prev_body) > fn_alpha_SB * fn_AvgBody[1] and volume[1] > 1.5 * fn_AvgVol[1]
fn_WeakBear_pre   = close[1] < open[1] and (fn_prev_range == 0 ? 0.0 : math.abs(fn_prev_body) / fn_prev_range) <= fn_weak_ratio
fn_StrongBull_pre = close[1] > open[1] and math.abs(fn_prev_body) > fn_alpha_SB * fn_AvgBody[1] and volume[1] > 1.5 * fn_AvgVol[1]
fn_WeakBull_pre   = close[1] > open[1] and (fn_prev_range == 0 ? 0.0 : math.abs(fn_prev_body) / fn_prev_range) <= fn_weak_ratio
fn_TR_bull  = fn_WeakBear_pre   and (fn_MB_bull or fn_RE_bull or fn_TA_bull)
fn_ES_bull  = fn_StrongBear_pre and (fn_MB_bull or fn_RE_bull or fn_TA_bull)
fn_GDR_bull = close[1] < open[1] and fn_GG_bull
fn_TR_bear  = fn_WeakBull_pre   and (fn_MB_bear or fn_RE_bear or fn_TA_bear)
fn_ES_bear  = fn_StrongBull_pre and (fn_MB_bear or fn_RE_bear or fn_TA_bear)
fn_GDR_bear = close[1] > open[1] and fn_GG_bear
fn_anyBull = fn_MB_bull or fn_RE_bull or fn_GG_bull or fn_TA_bull or fn_TR_bull or fn_ES_bull or fn_GDR_bull
fn_anyBear = fn_MB_bear or fn_RE_bear or fn_GG_bear or fn_TA_bear or fn_TR_bear or fn_ES_bear or fn_GDR_bear
fn_bullActive = fn_anyBull and conf and disp_cur_seq and anyLong
fn_bearActive = fn_anyBear and conf and disp_cur_seq and anyShort

// ── HV 150..1000 (gated +LONG[1]) ──
bool is150Bar  = volume[1] == ta.highest(volume, 150)[1]
bool is250Bar  = volume[1] == ta.highest(volume, 250)[1]
bool is350Bar  = volume[1] == ta.highest(volume, 350)[1]
bool is500Bar  = volume[1] == ta.highest(volume, 500)[1]
bool is1000Bar = volume[1] == ta.highest(volume, 1000)[1]
bool raw_HV1000 = is1000Bar
bool raw_HV500  = is500Bar  and not is1000Bar
bool raw_HV350  = is350Bar  and not is500Bar and not is1000Bar
bool raw_HV250  = is250Bar  and not is350Bar and not is500Bar and not is1000Bar
bool raw_HV150  = is150Bar  and not is250Bar and not is350Bar and not is500Bar and not is1000Bar
bool plot_HV1000 = raw_HV1000 and anyLong_1
bool plot_HV500  = raw_HV500  and anyLong_1
bool plot_HV350  = raw_HV350  and anyLong_1
bool plot_HV250  = raw_HV250  and anyLong_1
bool plot_HV150  = raw_HV150  and anyLong_1

// ═══════════════════════════════════════════════════════════════════════════════
// MASTER HW-SINGLE-v3 BOOLEAN — fires if ANY HW Single v3 detection plot would fire
// ═══════════════════════════════════════════════════════════════════════════════
bool hws_bull = (sigSAAB and anyLong) or (sigBullRVOL1x and anyLong) or (sigGrandSlam and anyLong) or sig_bull_UU or sig_bull_UUU or sig_bull_UUUU or sig_B2B_2xSAAB or sig_B2B_2xBull1x or sig_B2B_MidBull or fn_bullActive or sigDispBull or sigCDispBull2 or sigCDispBull3 or sigAddLong1 or sigAddLong2 or sigAddLong3 or sigAddLong4 or sigAddLong5 or plot_HV150 or plot_HV250 or plot_HV350 or plot_HV500 or plot_HV1000 or hctGatedBull
bool hws_bear = (sigKratos and anyShort) or (sigBearRVOL1x and anyShort) or (sigMOAB and anyShort) or sig_bear_DD or sig_bear_DDD or sig_bear_DDDD or sig_B2B_2xKratos or sig_B2B_2xBear1x or sig_B2B_MidBear or fn_bearActive or sigDispBear or sigCDispBear2 or sigCDispBear3 or sigAddShort1 or sigAddShort2 or hctGatedBear
bool hws_neutral = (sigWTC and anyMom) or (sigHiroshima and anyMom) or (sigNagasaki and anyMom) or sigPentHV1K or sigPentHV500D
bool hws_any = hws_bull or hws_bear or hws_neutral


// ═══════════════════════════════════════════════════════════════════════════════
// ███ v11 NEW DETECTION PLOT #1 — T3 CLUSTER (2+ T3 same candle) ███
// ═══════════════════════════════════════════════════════════════════════════════
// Fires when 2 OR MORE of the six T3 tiers (buy or sell, any direction mix)
// paint on the SAME candle. Direction-agnostic: two bulls, two bears, or a
// bull+bear pair all qualify. One single plot. Counted off the gated plot_t3_*
// booleans (barstate.isconfirmed inside f_vob) so it is non-repainting with 1:1
// plot/alert parity.
bool show_tc_cluster = input.bool(true, "T3 Cluster (2+ T3 signals same candle)",
     group = "Detection — v11 New",
     tooltip = "Fires when 2 or more T3 tiers (T3a..T3f, buy OR sell) fire on the same candle. Direction-agnostic; one plot for any mix of bull/bear.")
var int last_tc_cluster = na
int tc_fire_cnt = (plot_t3_buy_a?1:0)+(plot_t3_sell_a?1:0)+(plot_t3_buy_b?1:0)+(plot_t3_sell_b?1:0)+(plot_t3_buy_c?1:0)+(plot_t3_sell_c?1:0)+(plot_t3_buy_d?1:0)+(plot_t3_sell_d?1:0)+(plot_t3_buy_e?1:0)+(plot_t3_sell_e?1:0)+(plot_t3_buy_f?1:0)+(plot_t3_sell_f?1:0)
int tc_bull_cnt = (plot_t3_buy_a?1:0)+(plot_t3_buy_b?1:0)+(plot_t3_buy_c?1:0)+(plot_t3_buy_d?1:0)+(plot_t3_buy_e?1:0)+(plot_t3_buy_f?1:0)
int tc_bear_cnt = (plot_t3_sell_a?1:0)+(plot_t3_sell_b?1:0)+(plot_t3_sell_c?1:0)+(plot_t3_sell_d?1:0)+(plot_t3_sell_e?1:0)+(plot_t3_sell_f?1:0)
bool plot_tc_cluster = show_tc_cluster and tc_fire_cnt >= 2 and barstate.isconfirmed and f_cd_ok(last_tc_cluster, cooldown_bars)
if plot_tc_cluster
    last_tc_cluster := bar_index
plotshape(plot_tc_cluster, "T3 Cluster (2+ same candle)", shape.flag, location.top, color.new(color.yellow, 0), size = size.normal, text = "T3x", textcolor = color.yellow)
alertcondition(plot_tc_cluster, "T3 Cluster (2+ T3 same candle)", "VOB v11 — 2 or more T3 tiers fired on the same candle")
if plot_tc_cluster
    alert("T3_CLUSTER|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|COUNT:" + str.tostring(tc_fire_cnt) + "|BULL:" + str.tostring(tc_bull_cnt) + "|BEAR:" + str.tostring(tc_bear_cnt) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BEARSTACK:" + str.tostring(stk_bear), alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// ███ v11 NEW DETECTION PLOT #2 — VOB × HW-SINGLE COINCIDENCE ███
// ═══════════════════════════════════════════════════════════════════════════════
// Fires when ANY VOB T3 (T3a..T3f) OR ANY VOB zone-formation marker (zA..zF),
// bullish OR bearish (direction is not filtered), lands on the SAME candle as
// ANY HW Single v3 detection (high-volume, displacement, or any other HWS plot
// — captured by hws_any above). One single plot; non-repainting; 1:1 alert.
bool show_vobhws = input.bool(true, "VOB × HW-Single Coincidence (TC/zone + any HWS same candle)",
     group = "Detection — v11 New",
     tooltip = "Fires when any VOB T3 or any VOB zone-formation marker (either direction) coincides on the same candle with ANY Heavy Weapons Single v3 detection (high volume, displacement, RVOL, sequence, B2B, FAUNA, HCT, Pentagon, HV). HW Single v3 itself is untouched — its detection math is embedded read-only.")
bool vob_tc_any = plot_t3_buy_a or plot_t3_sell_a or plot_t3_buy_b or plot_t3_sell_b or plot_t3_buy_c or plot_t3_sell_c or plot_t3_buy_d or plot_t3_sell_d or plot_t3_buy_e or plot_t3_sell_e or plot_t3_buy_f or plot_t3_sell_f
bool vob_left_side = vob_tc_any or any_zone
var int last_vobhws = na
bool plot_vobhws = show_vobhws and vob_left_side and hws_any and barstate.isconfirmed and f_cd_ok(last_vobhws, cooldown_bars)
if plot_vobhws
    last_vobhws := bar_index
plotshape(plot_vobhws, "VOB × HW-Single Coincidence", shape.labelup, location.top, color.new(#FF00FF, 0), size = size.normal, text = "V×HW", textcolor = color.white)
alertcondition(plot_vobhws, "VOB × HW-Single Coincidence", "VOB v11 — VOB T3/zone coincides with any HW Single v3 detection on the same candle")
if plot_vobhws
    string vh_src = (vob_tc_any ? "T3," : "") + (any_zone ? "ZONE," : "")
    string vh_hws = (hws_bull ? "HWS_BULL," : "") + (hws_bear ? "HWS_BEAR," : "") + (hws_neutral ? "HWS_NEU," : "")
    alert("VOB_X_HWS|TICKER:" + syminfo.ticker + "|EXCHANGE:" + syminfo.prefix + "|TF:" + timeframe.period + "|VOBSRC:" + vh_src + "|HWS:" + vh_hws + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100), alert.freq_once_per_bar_close)
