//@version=6
// =============================================================================
// VOB ASYMMETRIC SIGNALS + HV·DISP·TIER PROXIMITY v1.1 — 2026-08-19  (W-INDSTUDY create lane, L-49)
// v1.1 (operator ruling 2026-08-19, conflict row 5): when the DISPLACED candle is the LAST of the three
//   events, the VP sits ON the displaced candle (offset -1) — a second constant-offset plotshape per lane
//   (estate offset ontology: per-plot constant); same-candle dedup: a lane never marks/alerts one candle twice.
// TICK-CHART build [tick-friendly] (twin: vob/versions/VOB_ASYM_HDTPROX_v1.1.pine).
// RE10023 audit: tv_ta.relativeVolume anchor remapped to D on tick charts (base guard kept);
// no timeframe.in_seconds threshold ladders in this study. Logic BYTE-IDENTICAL to the time
// build below the indicator() line (only the log.info study tag differs).
// -----------------------------------------------------------------------------
// BASE (origin/main d8970ab, carried VERBATIM except the DECLARED edits below):
//   vob/versions/VOB_ASYM_HVPROX_v1.3.pine  sha256 0299a60102abaaa1b1d2ce93a5b4410dee9e66bee506edb16972bbad02cebdf6
//   (== operator file ~/Desktop/Mathematical Proof Wrapper/studies/VOB ASYM + HV PROXIMITY v1.3.txt)
//   -> Volume Order Blocks + Asymmetric Signals T1/T2/T3 engine, cooldown, order-block lines,
//      tier markers + tier alerts, Disp/RVOL alert-readout engines: UNCHANGED.
//   DECLARED EDITS: E1 indicator() title/shorttitle stamped; E2 the v1.3 two-way HV PROXIMITY
//   section (inputs, engine, lanes, chain, alerts, plots — 12 lanes) is REPLACED by the three-way
//   HV·DISP·TIER PROXIMITY section below (10 lanes). Nothing else touched.
// -----------------------------------------------------------------------------
// OPERATOR DICTATION (goal 2026-08-19, verbatim intent): "another indicator study. use T1, T2, T3
//   from VOB plus asymmetric. adjustable input parameter for the window. three requirements: a high
//   volume, a displacement, either T1, T2 or T3. the fourth input parameter = how many bars those
//   three need to be within." Answers 2026-08-19: W default 5; tiers 1K/2K/3K/4K/NAGA (5 bull + 5 bear).
// -----------------------------------------------------------------------------
// LANE DEFINITIONS (gate language; every term is a boolean below):
//   HV(T) candle     : volume >= highest volume of the last N_T bars (N default 1000/2000/3000/4000,
//                      editable; nested). NAGASAKI: volume > every prior CONFIRMED candle (all-time high).
//   DISPLACED candle : range[1] > stdev(range,len)[1] x sigma (default 9) AND fair-value gap confirmed
//                      on the next bar (bull: low > high[2], close[1] > open[1]; bear: high < low[2],
//                      close[1] < open[1]) — DISPLACEMENT-REQUIRES-FVG law; displaced candle = bar[1].
//   TIER BUY/SELL    : T1/T2/T3 Buy (Sell) PRINTED on the candle (post-cooldown booleans).
//   HV(T) BULL lane  : fires on bar t IFF the latest HV(T) candle, the latest BULL-displaced candle and
//                      the latest TIER BUY candle all lie within W bars of each other AND at least one
//                      of the three became known on t (the completing event). Formally, with
//                      h = last HV(T) bar, d = last bull-displaced bar, s = last TIER BUY bar:
//                      fire(t) = [max(h,d,s) - min(h,d,s) <= W] AND [t completes one of them].
//                      MARKER: on t when the HV candle or the tier fire completes the triple (offset 0);
//                      ON THE DISPLACED CANDLE t-1 (offset -1) when the displacement (FVG confirmed on t)
//                      completes it. DEDUP: if the lane already marked candle t-1 on the previous bar, the
//                      displacement-completion of t-1 does not mark/alert it again (one marker + one alert
//                      line per lane per candle). BEAR lanes identical with bear displacement + TIER SELL.
//   PRINT HIGHEST ONLY (default ON): per side per bar only the highest tier whose condition holds
//                      prints (NAGASAKI > 4K > 3K > 2K > 1K); OFF: every tier that holds prints.
//   Non-repainting   : every term is evaluated on the CONFIRMED bar only (barstate.isconfirmed).
// -----------------------------------------------------------------------------
// OUTPUT BUDGET (TV unit law 2026-08-12): 26 plotshapes x (1 + 1 input.color) = 52 + 2 base
//   fill-anchor plot() + 1 base fill = 55 / 64 (each lane = offset-0 plot + offset-(-1) plot). 0 alertcondition. Graphic objects: the base's
//   order-block line/label/linefill sites only (OB drawing, not VPs) — every VP is a REAL plotshape.
// ALERTS: alert() per lane (0 units). LINE (operator dictation 2026-08-19, nothing else):
//   "<BULL|BEAR>, <HV1000|HV2000|HV3000|HV4000|NAGA>, Disp <x.x>, RVOL <x.x>" — Disp = the HV
//   candle's achieved sigma, RVOL = the HV candle's Reg@Time ratio; tier name/gaps ride log.info.
//   Arm ONE TradingView alert: Alt+A -> this study -> "Any alert() function call".
// CHECKBOX LAW: two mirrored groups — VISUAL PLOTS (chart) and ALERTS (inbox); one job each.
// =============================================================================
indicator("Volume Order Blocks + Asymmetric Signals + HV·DISP·TIER Proximity v1.1 [TICK]", shorttitle="HDT1.1TICK", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)
import TradingView/ta/12 as tv_ta

// ─────────────────────────────────────────────────────────────────────────────
// UDT
// ─────────────────────────────────────────────────────────────────────────────

type level 
    int   indx
    float upper
    float lower 
    float mid 
    float vol

type draw 
    line     upper 
    line     lower 
    line     mid 
    linefill fill 
    label    vol

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

int   length1        = input.int(5,     "Sensitivity Detection")
int   length2        = length1 + 13
bool  mid_l          = input.bool(true, "Mid Line")
bool  trend_shadow   = input.bool(true, "Trend Shadow")
color col1           = input.color(#26ba9f, "", inline = "col")
color col2           = input.color(#6626ba, "", inline = "col")

// Signal inputs
float asym_threshold = input.float(50.0, "Tier 1 — Asymmetric % Threshold", minval = 1, step = 5,
     tooltip = "Dominant OB must hold at least this % of its pool to trigger Tier 1")
float super_mult     = input.float(1.0,  "Tier 3 — Super Volume Multiplier", step = 0.1,
     tooltip = "Dominant OB raw volume must exceed opposing pool total × this multiplier")
int   cooldown_bars  = input.int(20,    "Signal Cooldown (Bars)", minval = 0,
     tooltip = "Minimum number of bars to wait after any signal before allowing a new one")
// ─────────────────────────────────────────────────────────────────────────────
// HV·DISP·TIER PROXIMITY INPUTS (v1, operator 2026-08-19) — three events within W bars
// ─────────────────────────────────────────────────────────────────────────────
string grpH = "HV·DISP·TIER PROXIMITY — HV tier candle + DISPLACED candle + T1/T2/T3 fire, all within W bars"
int   hdt_W = input.int(5, "W — bars the three events must lie within", minval = 0, maxval = 500, group = grpH, tooltip = "A lane fires when the latest HV-tier candle, the latest displaced candle (same side) and the latest T1/T2/T3 fire (same side) all lie within W bars of each other, the moment the last of the three becomes known. 0 = all three on the same candle. Default 5 (operator 2026-08-19).")
int   hdt_n1K = input.int(1000, "1K lookback (bars)", minval = 1, maxval = 5000, group = grpH, tooltip = "HV 1K candle = volume >= highest volume of the last N bars (default 1000). Editable. Keep 1K < 2K < 3K < 4K.")
int   hdt_n2K = input.int(2000, "2K lookback (bars)", minval = 1, maxval = 5000, group = grpH)
int   hdt_n3K = input.int(3000, "3K lookback (bars)", minval = 1, maxval = 5000, group = grpH)
int   hdt_n4K = input.int(4000, "4K lookback (bars)", minval = 1, maxval = 5000, group = grpH, tooltip = "NAGASAKI has no number: all-time-high volume (strictly above every prior confirmed candle).")
float hdt_sigma = input.float(9.0, "Displacement sigma — default 9", minval = 0.1, step = 0.1, group = grpH, tooltip = "DISPLACED candle = range[1] > stdev(range, length)[1] x sigma AND a fair-value gap confirmed on the next bar (bull: low > high[2], close[1] > open[1]; bear: high < low[2], close[1] < open[1]). Range type / stdev length = the Disp readout settings below. Default 9.")
bool  hdt_excl = input.bool(true, "Print highest HV tier only (one marker per side per bar)", group = grpH, tooltip = "ON (default): per side per bar only the HIGHEST tier whose three-way condition holds prints — NAGASAKI > 4K > 3K > 2K > 1K. OFF: every tier that holds prints. Either way a lane never fires without its own three-way condition.")

// ── ALERT READOUTS — Disp (achieved sigma) + RVOL (Reg@Time ratio) of the HV candle ──
string grpR = "ALERT READOUTS (Disp / RVOL engines) — the alert line prints the HV candle values"
string d_type = input.string("Open to Close", "Disp — range type", options = ["Open to Close", "High to Low"], group = grpR, tooltip = "Displacement = candle range / stdev(range, length). The alert prints the ACHIEVED multiple (one decimal), never a threshold. Source default: Open to Close (body).")
int    d_len  = input.int(100, "Disp — stdev length", minval = 1, group = grpR)
int    rv_len = input.int(30, "RVOL — Reg@Time length (periods)", minval = 1, group = grpR, tooltip = "Relative volume = this candle cumulative session volume vs the average at the same time offset over N past anchor periods (TradingView/ta relativeVolume, cumulative, adjust realtime). Estate default 30.")
string rv_anchor = input.timeframe("", "RVOL — anchor timeframe (blank = chart)", group = grpR, tooltip = "Blank = the chart timeframe. On TICK charts a blank/tick anchor is remapped to D automatically (RE10023 guard).")

// ── VISUAL PLOTS (chart markers only) — one checkbox + one color swatch per lane (tiers + HV proximity) ──
string grpP = "VISUAL PLOTS (chart markers only)"
bool  en_t1_buy  = input.bool(true, "T1 Buy (Bull)", group = grpP, inline = "t1b")
color cl_t1_buy  = input.color(#26ba9f, "", group = grpP, inline = "t1b")
bool  en_t1_sell = input.bool(true, "T1 Sell (Bear)", group = grpP, inline = "t1s")
color cl_t1_sell = input.color(#6626ba, "", group = grpP, inline = "t1s")
bool  en_t2_buy  = input.bool(true, "T2 Buy (Bull)", group = grpP, inline = "t2b")
color cl_t2_buy  = input.color(#00e5ff, "", group = grpP, inline = "t2b")
bool  en_t2_sell = input.bool(true, "T2 Sell (Bear)", group = grpP, inline = "t2s")
color cl_t2_sell = input.color(#ff00e5, "", group = grpP, inline = "t2s")
bool  en_t3_buy  = input.bool(true, "T3 SUPER Buy (Bull)", group = grpP, inline = "t3b")
color cl_t3_buy  = input.color(#64DD17, "", group = grpP, inline = "t3b")
bool  en_t3_sell = input.bool(true, "T3 SUPER Sell (Bear)", group = grpP, inline = "t3s")
color cl_t3_sell = input.color(#ff4400, "", group = grpP, inline = "t3s")
bool  en_hdt1KBull = input.bool(true, "HV 1K·DISP·TIER Bull", group = grpP, inline = "h1Kb")
color cl_hdt1KBull = input.color(#B2FF59, "", group = grpP, inline = "h1Kb")
bool  en_hdt2KBull = input.bool(true, "HV 2K·DISP·TIER Bull", group = grpP, inline = "h2Kb")
color cl_hdt2KBull = input.color(#40C4FF, "", group = grpP, inline = "h2Kb")
bool  en_hdt3KBull = input.bool(true, "HV 3K·DISP·TIER Bull", group = grpP, inline = "h3Kb")
color cl_hdt3KBull = input.color(#2979FF, "", group = grpP, inline = "h3Kb")
bool  en_hdt4KBull = input.bool(true, "HV 4K·DISP·TIER Bull", group = grpP, inline = "h4Kb")
color cl_hdt4KBull = input.color(#00BFA5, "", group = grpP, inline = "h4Kb")
bool  en_hdtNagaBull = input.bool(true, "HV NAGASAKI·DISP·TIER Bull", group = grpP, inline = "hNagab")
color cl_hdtNagaBull = input.color(#00E676, "", group = grpP, inline = "hNagab")
bool  en_hdt1KBear = input.bool(true, "HV 1K·DISP·TIER Bear", group = grpP, inline = "h1Kb")
color cl_hdt1KBear = input.color(#FFAB40, "", group = grpP, inline = "h1Kb")
bool  en_hdt2KBear = input.bool(true, "HV 2K·DISP·TIER Bear", group = grpP, inline = "h2Kb")
color cl_hdt2KBear = input.color(#F50057, "", group = grpP, inline = "h2Kb")
bool  en_hdt3KBear = input.bool(true, "HV 3K·DISP·TIER Bear", group = grpP, inline = "h3Kb")
color cl_hdt3KBear = input.color(#FF4081, "", group = grpP, inline = "h3Kb")
bool  en_hdt4KBear = input.bool(true, "HV 4K·DISP·TIER Bear", group = grpP, inline = "h4Kb")
color cl_hdt4KBear = input.color(#FF6D00, "", group = grpP, inline = "h4Kb")
bool  en_hdtNagaBear = input.bool(true, "HV NAGASAKI·DISP·TIER Bear", group = grpP, inline = "hNagab")
color cl_hdtNagaBear = input.color(#FF1744, "", group = grpP, inline = "hNagab")

// ── ALERTS (inbox only) — one checkbox per lane; arm ONE alert: Any alert() function call ──
string grpA = "ALERTS (inbox only) — arm ONE alert on this study: Any alert() function call"
bool al_t1_buy  = input.bool(true, "🔔 T1 Buy (Bull)", group = grpA, inline = "at1")
bool al_t1_sell = input.bool(true, "🔔 T1 Sell (Bear)", group = grpA, inline = "at1")
bool al_t2_buy  = input.bool(true, "🔔 T2 Buy (Bull)", group = grpA, inline = "at2")
bool al_t2_sell = input.bool(true, "🔔 T2 Sell (Bear)", group = grpA, inline = "at2")
bool al_t3_buy  = input.bool(true, "🔔 T3 SUPER Buy (Bull)", group = grpA, inline = "at3")
bool al_t3_sell = input.bool(true, "🔔 T3 SUPER Sell (Bear)", group = grpA, inline = "at3")
bool al_hdt1KBull = input.bool(true, "🔔 HV 1K·DISP·TIER Bull", group = grpA, inline = "ah1K")
bool al_hdt2KBull = input.bool(true, "🔔 HV 2K·DISP·TIER Bull", group = grpA, inline = "ah2K")
bool al_hdt3KBull = input.bool(true, "🔔 HV 3K·DISP·TIER Bull", group = grpA, inline = "ah3K")
bool al_hdt4KBull = input.bool(true, "🔔 HV 4K·DISP·TIER Bull", group = grpA, inline = "ah4K")
bool al_hdtNagaBull = input.bool(true, "🔔 HV NAGASAKI·DISP·TIER Bull", group = grpA, inline = "ahNaga")
bool al_hdt1KBear = input.bool(true, "🔔 HV 1K·DISP·TIER Bear", group = grpA, inline = "ah1K")
bool al_hdt2KBear = input.bool(true, "🔔 HV 2K·DISP·TIER Bear", group = grpA, inline = "ah2K")
bool al_hdt3KBear = input.bool(true, "🔔 HV 3K·DISP·TIER Bear", group = grpA, inline = "ah3K")
bool al_hdt4KBear = input.bool(true, "🔔 HV 4K·DISP·TIER Bear", group = grpA, inline = "ah4K")
bool al_hdtNagaBear = input.bool(true, "🔔 HV NAGASAKI·DISP·TIER Bear", group = grpA, inline = "ahNaga")

// ─────────────────────────────────────────────────────────────────────────────
// CALCULATIONS (original — untouched)
// ─────────────────────────────────────────────────────────────────────────────

float ema1     = ta.ema(close, length1)
float ema2     = ta.ema(close, length2)

bool  cross_up = ta.crossover(ema1, ema2)  and barstate.isconfirmed
bool  cross_dn = ta.crossunder(ema1, ema2) and barstate.isconfirmed
float lowest   = ta.lowest(length2) 
float highest  = ta.highest(length2)

var upper_draw = array.new<draw>()
var lower_draw = array.new<draw>()

var upper_lvl  = array.new<level>()
var lower_lvl  = array.new<level>()

array_vol_upper = array.new<float>()
array_vol_lower = array.new<float>()

difff       = ema2 - ema1
color_trend = trend_shadow ? difff > 0 ? color.from_gradient(difff, 0, ta.highest(difff,100), color(na), col2) : color.from_gradient(difff, ta.lowest(difff,100), 0, col1, color(na)) : color(na)

p1 = plot(ema1, "", display = display.none, editable = false)
p2 = plot(ema2, "", display = display.none, editable = false)
fill(p1, p2, color_trend)

atr  = ta.highest(ta.atr(200), 200) * 3
atr1 = ta.highest(ta.atr(200), 200) * 2

f_clear_previous_lines(draw__) =>
    if draw__.size() > 0
        for l in draw__
            line.delete(l.upper)
            line.delete(l.lower)
            line.delete(l.mid)
            linefill.delete(l.fill)
            label.delete(l.vol)
        array.clear(draw__)

if cross_up
    var vol = 0.0
    vol := 0
    for i = 1 to length2
        int ii = math.min(i, 4999)  // explicit clamp: offset can never exceed the history buffer
        if low[ii] == lowest
            index = time[ii]
            src = math.min(open[ii], close[ii])
            for k = 0 to i
                int kk = math.min(k, 4999)  // explicit clamp: offset can never exceed the history buffer
                vol += volume[kk]
            src := (src - lowest) < atr1 * 0.5 ? lowest + atr1 * 0.5 : src
            mid = math.avg(src, lowest)    
            l = level.new(index, src, lowest, mid, vol)
            lower_lvl.push(l)

if cross_dn
    var vol = 0.0
    vol := 0
    for i = 1 to length2
        int ii = math.min(i, 4999)  // explicit clamp: offset can never exceed the history buffer
        if high[ii] == highest
            index = time[ii]
            src = math.max(open[ii], close[ii])
            for k = 0 to i
                int kk = math.min(k, 4999)  // explicit clamp: offset can never exceed the history buffer
                vol += volume[kk]
            src := (highest - src) < atr1 * 0.5 ? highest - atr1 * 0.5 : src
            mid = math.avg(src, highest) 
            l = level.new(index, highest, src, mid, vol)
            upper_lvl.push(l)

// ─────────────────────────────────────────────────────────────────────────────
// INVALIDATION (original — untouched)
// ─────────────────────────────────────────────────────────────────────────────

if lower_lvl.size() > 0
    for i = 0 to lower_lvl.size() - 1
        l  = lower_lvl.get(i)
        l1 = lower_lvl.get(i - 1)
        mid  = l.mid
        mid1 = l1.mid
        if math.abs(mid - mid1) < atr 
            l_ = level.new(na, na, na, na, na)
            lower_lvl.set(i - 1, l_)
        if close < l.lower
            l_ = level.new(na, na, na, na, na)
            lower_lvl.set(i, l_)
    if lower_lvl.size() > 15 
        lower_lvl.shift()

if upper_lvl.size() > 0
    for i = 0 to upper_lvl.size() - 1
        l     = upper_lvl.get(i)
        l1    = upper_lvl.get(i - 1)
        upper = l.upper
        mid   = l.mid
        mid1  = l1.mid
        if math.abs(mid - mid1) < atr 
            l_ = level.new(na, na, na, na, na)
            upper_lvl.set(i - 1, l_)
        if close > upper
            l_ = level.new(na, na, na, na, na)
            upper_lvl.set(i, l_)
    if upper_lvl.size() > 15 
        upper_lvl.shift()

// ─────────────────────────────────────────────────────────────────────────────
// ASYMMETRIC SIGNAL ENGINE
// ─────────────────────────────────────────────────────────────────────────────

// Pre-declare signal variables at GLOBAL scope (plotshape cannot be in local scope)
var bool sig_t1_buy  = false
var bool sig_t1_sell = false
var bool sig_t2_buy  = false
var bool sig_t2_sell = false
var bool sig_t3_buy  = false
var bool sig_t3_sell = false
var int  last_signal_bar = na

// Reset each bar
sig_t1_buy  := false
sig_t1_sell := false
sig_t2_buy  := false
sig_t2_sell := false
sig_t3_buy  := false
sig_t3_sell := false
// ─────────────────────────────────────────────────────────────────────────────
// HV·DISP·TIER PROXIMITY ENGINE (v1) — HV ladder (nested) + displacement + memory
// ta.* calls at GLOBAL scope (evaluated every bar); consumed on the CONFIRMED bar only.
// ─────────────────────────────────────────────────────────────────────────────
float hdt_h1K = ta.highest(volume, hdt_n1K)
bool  hdt_is1K = not na(hdt_h1K) and volume >= hdt_h1K
float hdt_h2K = ta.highest(volume, hdt_n2K)
bool  hdt_is2K = not na(hdt_h2K) and volume >= hdt_h2K
float hdt_h3K = ta.highest(volume, hdt_n3K)
bool  hdt_is3K = not na(hdt_h3K) and volume >= hdt_h3K
float hdt_h4K = ta.highest(volume, hdt_n4K)
bool  hdt_is4K = not na(hdt_h4K) and volume >= hdt_h4K

// alert-readout engines (global scope; consumed at emission through the HV candle offset)
float d_rng = d_type == "Open to Close" ? math.abs(open - close) : high - low
float d_std = ta.stdev(d_rng, d_len)
float dispSer = d_std > 0 ? d_rng / d_std : na
string rv_anchorSafe = ((rv_anchor == "" and (str.endswith(timeframe.period, "T") or na(timeframe.in_seconds(timeframe.period)) or timeframe.in_seconds(timeframe.period) <= 0)) or str.endswith(rv_anchor, "T")) ? "D" : rv_anchor
[rv_cur, rv_past, rv_ratio] = tv_ta.relativeVolume(rv_len, rv_anchorSafe, true, true)
float rvolSer = rv_ratio

// displacement (DISPLACEMENT-REQUIRES-FVG law): sigma-exceedance on bar[1] AND FVG confirmed on bar[0];
// the DISPLACED candle is bar[1]; evaluated at global scope, consumed on the confirmed bar
float hdt_thr = d_std * hdt_sigma
bool  hdt_prev = d_rng[1] > hdt_thr[1]
bool  hdt_dispBullRaw = hdt_prev and low > high[2] and close[1] > open[1]
bool  hdt_dispBearRaw = hdt_prev and high < low[2] and close[1] < open[1]

bool conf = barstate.isconfirmed
// same-bar event flags (assigned inside the confirmed block; read by the emission block below it)
bool hdt_tierBullNow = false
bool hdt_tierBearNow = false
bool hdt_isNaga      = false

// memory — written on CONFIRMED bars only (var state rolls back on the forming bar, commits at close)
var float  hdt_nagaMax      = 0.0
var int    hdt_lastTierBull = na
var int    hdt_lastTierBear = na
var string hdt_tierBullName = ""
var string hdt_tierBearName = ""
var int    hdt_last1K = na
var int    hdt_last2K = na
var int    hdt_last3K = na
var int    hdt_last4K = na
var int    hdt_lastNaga = na
var int    hdt_lastDispBull = na
var int    hdt_lastDispBear = na

// lane signals: sig_ = pure detection (three-way IFF + print-highest rule); fire_ = plot checkbox; alf_ = alert checkbox
bool sig_hdt1KBull = false
bool sig_hdt2KBull = false
bool sig_hdt3KBull = false
bool sig_hdt4KBull = false
bool sig_hdtNagaBull = false
bool sig_hdt1KBear = false
bool sig_hdt2KBear = false
bool sig_hdt3KBear = false
bool sig_hdt4KBear = false
bool sig_hdtNagaBear = false
// v1.1 split: sig_<lane>_N = completed by the HV candle / tier fire (marker offset 0) · sig_<lane>_D = completed by the
// displacement (marker offset -1 on the displaced candle), deduped against a same-candle N-fire on the previous bar
bool sig_hdt1KBull_N = false
bool sig_hdt2KBull_N = false
bool sig_hdt3KBull_N = false
bool sig_hdt4KBull_N = false
bool sig_hdtNagaBull_N = false
bool sig_hdt1KBear_N = false
bool sig_hdt2KBear_N = false
bool sig_hdt3KBear_N = false
bool sig_hdt4KBear_N = false
bool sig_hdtNagaBear_N = false
bool sig_hdt1KBull_D = false
bool sig_hdt2KBull_D = false
bool sig_hdt3KBull_D = false
bool sig_hdt4KBull_D = false
bool sig_hdtNagaBull_D = false
bool sig_hdt1KBear_D = false
bool sig_hdt2KBear_D = false
bool sig_hdt3KBear_D = false
bool sig_hdt4KBear_D = false
bool sig_hdtNagaBear_D = false

// three-way helpers (a never-seen event is infinitely far)
f_hdt_bar(int lastBar) =>
    na(lastBar) ? -1000000 : lastBar
f_hdt_prox(int lastHV, int lastDisp, int lastTier, bool anyNow, int w) =>
    int hi = math.max(f_hdt_bar(lastHV), math.max(f_hdt_bar(lastDisp), f_hdt_bar(lastTier)))
    int lo = math.min(f_hdt_bar(lastHV), math.min(f_hdt_bar(lastDisp), f_hdt_bar(lastTier)))
    anyNow and not na(lastHV) and not na(lastDisp) and not na(lastTier) and (hi - lo <= w)
f_hdt_msg(string side, string hvTok, int lastHV) =>
    // Disp/RVOL of the HV candle (read through its offset); clamp: offset never exceeds the history buffer
    int off = math.min(math.max(bar_index - lastHV, 0), 4999)
    float dsp = dispSer[off]
    float rvl = rvolSer[off]
    side + ", " + hvTok + ", Disp " + (na(dsp) ? "na" : str.tostring(dsp, "0.0")) + ", RVOL " + (na(rvl) ? "na" : str.tostring(rvl, "0.0"))

// Only run on confirmed bar close — guarantees non-repainting
if barstate.isconfirmed

    // ── Collect valid bullish OB volumes ──────────────────────────────────────
    valid_bull_vol  = array.new<float>()
    valid_bull_low  = array.new<float>()
    valid_bull_high = array.new<float>()

    if lower_lvl.size() > 0
        for i = 0 to lower_lvl.size() - 1
            l = lower_lvl.get(i)
            if not na(l.vol)
                valid_bull_vol.push(l.vol)
                valid_bull_low.push(l.lower)
                valid_bull_high.push(l.upper)

    // ── Collect valid bearish OB volumes ─────────────────────────────────────
    valid_bear_vol  = array.new<float>()
    valid_bear_low  = array.new<float>()
    valid_bear_high = array.new<float>()

    if upper_lvl.size() > 0
        for i = 0 to upper_lvl.size() - 1
            l = upper_lvl.get(i)
            if not na(l.vol)
                valid_bear_vol.push(l.vol)
                valid_bear_low.push(l.lower)
                valid_bear_high.push(l.upper)

    bull_pool_total = valid_bull_vol.size() > 0 ? valid_bull_vol.sum() : 0.0
    bear_pool_total = valid_bear_vol.size() > 0 ? valid_bear_vol.sum() : 0.0

    // ── Find dominant bullish OB (highest vol) ────────────────────────────────
    dom_bull_vol   = 0.0
    dom_bull_low   = 0.0
    dom_bull_high  = 0.0
    dom_bull_pct   = 0.0
    bull_count     = valid_bull_vol.size()

    if bull_count > 0
        for i = 0 to bull_count - 1
            v = valid_bull_vol.get(i)
            if v > dom_bull_vol
                dom_bull_vol  := v
                dom_bull_low  := valid_bull_low.get(i)
                dom_bull_high := valid_bull_high.get(i)
        dom_bull_pct := bull_pool_total > 0 ? dom_bull_vol / bull_pool_total * 100 : 0.0

    // ── Find dominant bearish OB (highest vol) ────────────────────────────────
    dom_bear_vol   = 0.0
    dom_bear_low   = 0.0
    dom_bear_high  = 0.0
    dom_bear_pct   = 0.0
    bear_count     = valid_bear_vol.size()

    if bear_count > 0
        for i = 0 to bear_count - 1
            v = valid_bear_vol.get(i)
            if v > dom_bear_vol
                dom_bear_vol  := v
                dom_bear_low  := valid_bear_low.get(i)
                dom_bear_high := valid_bear_high.get(i)
        dom_bear_pct := bear_pool_total > 0 ? dom_bear_vol / bear_pool_total * 100 : 0.0

    // ── Price at zone checks ──────────────────────────────────────────────────
    price_at_bull = close >= dom_bull_low  and close <= dom_bull_high
    price_at_bear = close >= dom_bear_low  and close <= dom_bear_high

    // ─────────────────────────────────────────────────────────────────────────
    // TIER 1 — ASYMMETRIC BUY
    // ─────────────────────────────────────────────────────────────────────────
    tier1_buy = dom_bull_pct >= asym_threshold
         and dom_bull_vol > dom_bear_vol
         and price_at_bull
         and bull_count > 0

    // ─────────────────────────────────────────────────────────────────────────
    // TIER 1 — ASYMMETRIC SELL
    // ─────────────────────────────────────────────────────────────────────────
    tier1_sell = dom_bear_pct >= asym_threshold
         and dom_bear_vol > dom_bull_vol
         and price_at_bear
         and bear_count > 0

    // ─────────────────────────────────────────────────────────────────────────
    // TIER 2 — PURE 100% BUY
    // ─────────────────────────────────────────────────────────────────────────
    tier2_buy  = bull_count == 1 and price_at_bull

    // ─────────────────────────────────────────────────────────────────────────
    // TIER 2 — PURE 100% SELL
    // ─────────────────────────────────────────────────────────────────────────
    tier2_sell = bear_count == 1 and price_at_bear

    // ─────────────────────────────────────────────────────────────────────────
    // TIER 3 — SUPER 100% BUY
    // ─────────────────────────────────────────────────────────────────────────
    tier3_buy  = bull_count == 1
         and bear_pool_total > 0
         and dom_bull_vol > bear_pool_total * super_mult
         and price_at_bull

    // ─────────────────────────────────────────────────────────────────────────
    // TIER 3 — SUPER 100% SELL
    // ─────────────────────────────────────────────────────────────────────────
    tier3_sell = bear_count == 1
         and bull_pool_total > 0
         and dom_bear_vol > bull_pool_total * super_mult
         and price_at_bear

    // ── Assign to global signal variables ────────────────────────────────────
    cooldown_ready = na(last_signal_bar) or (bar_index - last_signal_bar > cooldown_bars)

    raw_t1_buy  = tier1_buy  and not tier2_buy  and not tier3_buy
    raw_t1_sell = tier1_sell and not tier2_sell and not tier3_sell
    raw_t2_buy  = tier2_buy  and not tier3_buy
    raw_t2_sell = tier2_sell and not tier3_sell
    raw_t3_buy  = tier3_buy
    raw_t3_sell = tier3_sell

    sig_t1_buy  := cooldown_ready and raw_t1_buy
    sig_t1_sell := cooldown_ready and raw_t1_sell
    sig_t2_buy  := cooldown_ready and raw_t2_buy
    sig_t2_sell := cooldown_ready and raw_t2_sell
    sig_t3_buy  := cooldown_ready and raw_t3_buy
    sig_t3_sell := cooldown_ready and raw_t3_sell

    if sig_t1_buy or sig_t1_sell or sig_t2_buy or sig_t2_sell or sig_t3_buy or sig_t3_sell
        last_signal_bar := bar_index

    // ─────────────────────────────────────────────────────────────────────────
    // ALERTS — 1:1 parity with plots, all on bar close
    // ─────────────────────────────────────────────────────────────────────────

    if al_t1_buy and sig_t1_buy
        alert("T1 Asymmetric BUY — dom bull vol: " + str.tostring(dom_bull_vol, format.volume) + " vs bear: " + str.tostring(dom_bear_vol, format.volume), alert.freq_once_per_bar_close)

    if al_t1_sell and sig_t1_sell
        alert("T1 Asymmetric SELL — dom bear vol: " + str.tostring(dom_bear_vol, format.volume) + " vs bull: " + str.tostring(dom_bull_vol, format.volume), alert.freq_once_per_bar_close)

    if al_t2_buy and sig_t2_buy
        alert("T2 Pure 100% BUY — single bull block: " + str.tostring(dom_bull_vol, format.volume), alert.freq_once_per_bar_close)

    if al_t2_sell and sig_t2_sell
        alert("T2 Pure 100% SELL — single bear block: " + str.tostring(dom_bear_vol, format.volume), alert.freq_once_per_bar_close)

    if al_t3_buy and sig_t3_buy
        alert("T3 SUPER BUY — bull: " + str.tostring(dom_bull_vol, format.volume) + " vs entire bear pool: " + str.tostring(bear_pool_total, format.volume), alert.freq_once_per_bar_close)

    if al_t3_sell and sig_t3_sell
        alert("T3 SUPER SELL — bear: " + str.tostring(dom_bear_vol, format.volume) + " vs entire bull pool: " + str.tostring(bull_pool_total, format.volume), alert.freq_once_per_bar_close)
    // ─────────────────────────────────────────────────────────────────────────
    // HV·DISP·TIER PROXIMITY LANES (v1) — HV(T) candle + DISPLACED candle + T1/T2/T3 fire within W bars
    // ─────────────────────────────────────────────────────────────────────────
    hdt_tierBullNow := sig_t1_buy or sig_t2_buy or sig_t3_buy
    hdt_tierBearNow := sig_t1_sell or sig_t2_sell or sig_t3_sell
    if hdt_tierBullNow
        hdt_lastTierBull := bar_index
        hdt_tierBullName := sig_t1_buy ? "T1 ASYMMETRIC BUY" : sig_t2_buy ? "T2 PURE 100% BUY" : "T3 SUPER BUY"
    if hdt_tierBearNow
        hdt_lastTierBear := bar_index
        hdt_tierBearName := sig_t1_sell ? "T1 ASYMMETRIC SELL" : sig_t2_sell ? "T2 PURE 100% SELL" : "T3 SUPER SELL"
    // Nagasaki: all-time-high volume over CONFIRMED candles, strict > (canonical construction)
    hdt_isNaga := volume > hdt_nagaMax
    if hdt_isNaga
        hdt_nagaMax := volume
    if hdt_is1K
        hdt_last1K := bar_index
    if hdt_is2K
        hdt_last2K := bar_index
    if hdt_is3K
        hdt_last3K := bar_index
    if hdt_is4K
        hdt_last4K := bar_index
    if hdt_isNaga
        hdt_lastNaga := bar_index
    // displaced candle = bar[1] (FVG confirmed on this bar)
    bool hdt_dispBullNow = hdt_dispBullRaw
    bool hdt_dispBearNow = hdt_dispBearRaw
    if hdt_dispBullNow
        hdt_lastDispBull := bar_index - 1
    if hdt_dispBearNow
        hdt_lastDispBear := bar_index - 1
    // completing-event flags (something became known on THIS bar)
    bool hdt_nowBull = hdt_tierBullNow or hdt_dispBullNow
    bool hdt_nowBear = hdt_tierBearNow or hdt_dispBearNow
    // three-way proximity per tier per side (nested membership: an HV 4K candle is also HV 1K..3K)
    bool hdt_p1KBull = f_hdt_prox(hdt_last1K, hdt_lastDispBull, hdt_lastTierBull, hdt_nowBull or hdt_is1K, hdt_W)
    bool hdt_p2KBull = f_hdt_prox(hdt_last2K, hdt_lastDispBull, hdt_lastTierBull, hdt_nowBull or hdt_is2K, hdt_W)
    bool hdt_p3KBull = f_hdt_prox(hdt_last3K, hdt_lastDispBull, hdt_lastTierBull, hdt_nowBull or hdt_is3K, hdt_W)
    bool hdt_p4KBull = f_hdt_prox(hdt_last4K, hdt_lastDispBull, hdt_lastTierBull, hdt_nowBull or hdt_is4K, hdt_W)
    bool hdt_pNagaBull = f_hdt_prox(hdt_lastNaga, hdt_lastDispBull, hdt_lastTierBull, hdt_nowBull or hdt_isNaga, hdt_W)
    bool hdt_p1KBear = f_hdt_prox(hdt_last1K, hdt_lastDispBear, hdt_lastTierBear, hdt_nowBear or hdt_is1K, hdt_W)
    bool hdt_p2KBear = f_hdt_prox(hdt_last2K, hdt_lastDispBear, hdt_lastTierBear, hdt_nowBear or hdt_is2K, hdt_W)
    bool hdt_p3KBear = f_hdt_prox(hdt_last3K, hdt_lastDispBear, hdt_lastTierBear, hdt_nowBear or hdt_is3K, hdt_W)
    bool hdt_p4KBear = f_hdt_prox(hdt_last4K, hdt_lastDispBear, hdt_lastTierBear, hdt_nowBear or hdt_is4K, hdt_W)
    bool hdt_pNagaBear = f_hdt_prox(hdt_lastNaga, hdt_lastDispBear, hdt_lastTierBear, hdt_nowBear or hdt_isNaga, hdt_W)
    // print-highest rule (default ON): the highest tier whose condition holds prints; OFF: every tier prints
    sig_hdtNagaBull := hdt_pNagaBull
    sig_hdt4KBull := hdt_p4KBull and not (hdt_excl and (hdt_pNagaBull))
    sig_hdt3KBull := hdt_p3KBull and not (hdt_excl and (hdt_pNagaBull or hdt_p4KBull))
    sig_hdt2KBull := hdt_p2KBull and not (hdt_excl and (hdt_pNagaBull or hdt_p4KBull or hdt_p3KBull))
    sig_hdt1KBull := hdt_p1KBull and not (hdt_excl and (hdt_pNagaBull or hdt_p4KBull or hdt_p3KBull or hdt_p2KBull))
    sig_hdtNagaBear := hdt_pNagaBear
    sig_hdt4KBear := hdt_p4KBear and not (hdt_excl and (hdt_pNagaBear))
    sig_hdt3KBear := hdt_p3KBear and not (hdt_excl and (hdt_pNagaBear or hdt_p4KBear))
    sig_hdt2KBear := hdt_p2KBear and not (hdt_excl and (hdt_pNagaBear or hdt_p4KBear or hdt_p3KBear))
    sig_hdt1KBear := hdt_p1KBear and not (hdt_excl and (hdt_pNagaBear or hdt_p4KBear or hdt_p3KBear or hdt_p2KBear))
    // v1.1 N/D split (row-5 ruling): N = HV candle or tier fire completes the triple on THIS bar (marker offset 0);
    // D = displacement completes it (displaced candle = bar[1], marker offset -1); dedup: not sig_<lane>_N[1]
    sig_hdt1KBull_N := sig_hdt1KBull and (hdt_tierBullNow or hdt_is1K)
    sig_hdt2KBull_N := sig_hdt2KBull and (hdt_tierBullNow or hdt_is2K)
    sig_hdt3KBull_N := sig_hdt3KBull and (hdt_tierBullNow or hdt_is3K)
    sig_hdt4KBull_N := sig_hdt4KBull and (hdt_tierBullNow or hdt_is4K)
    sig_hdtNagaBull_N := sig_hdtNagaBull and (hdt_tierBullNow or hdt_isNaga)
    sig_hdt1KBear_N := sig_hdt1KBear and (hdt_tierBearNow or hdt_is1K)
    sig_hdt2KBear_N := sig_hdt2KBear and (hdt_tierBearNow or hdt_is2K)
    sig_hdt3KBear_N := sig_hdt3KBear and (hdt_tierBearNow or hdt_is3K)
    sig_hdt4KBear_N := sig_hdt4KBear and (hdt_tierBearNow or hdt_is4K)
    sig_hdtNagaBear_N := sig_hdtNagaBear and (hdt_tierBearNow or hdt_isNaga)
    sig_hdt1KBull_D := sig_hdt1KBull and not sig_hdt1KBull_N and hdt_dispBullNow and not sig_hdt1KBull_N[1]
    sig_hdt2KBull_D := sig_hdt2KBull and not sig_hdt2KBull_N and hdt_dispBullNow and not sig_hdt2KBull_N[1]
    sig_hdt3KBull_D := sig_hdt3KBull and not sig_hdt3KBull_N and hdt_dispBullNow and not sig_hdt3KBull_N[1]
    sig_hdt4KBull_D := sig_hdt4KBull and not sig_hdt4KBull_N and hdt_dispBullNow and not sig_hdt4KBull_N[1]
    sig_hdtNagaBull_D := sig_hdtNagaBull and not sig_hdtNagaBull_N and hdt_dispBullNow and not sig_hdtNagaBull_N[1]
    sig_hdt1KBear_D := sig_hdt1KBear and not sig_hdt1KBear_N and hdt_dispBearNow and not sig_hdt1KBear_N[1]
    sig_hdt2KBear_D := sig_hdt2KBear and not sig_hdt2KBear_N and hdt_dispBearNow and not sig_hdt2KBear_N[1]
    sig_hdt3KBear_D := sig_hdt3KBear and not sig_hdt3KBear_N and hdt_dispBearNow and not sig_hdt3KBear_N[1]
    sig_hdt4KBear_D := sig_hdt4KBear and not sig_hdt4KBear_N and hdt_dispBearNow and not sig_hdt4KBear_N[1]
    sig_hdtNagaBear_D := sig_hdtNagaBear and not sig_hdtNagaBear_N and hdt_dispBearNow and not sig_hdtNagaBear_N[1]

// ─────────────────────────────────────────────────────────────────────────────
// PLOTS — at GLOBAL scope (FIX: moved out of if block)
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// LANE CHAIN (v1.2) — fire_ = plot checkbox AND signal · alf_ = alert checkbox AND signal
// (checkbox law: one checkbox = one job; sig_ stays pure so chart and inbox can never disagree)
// ─────────────────────────────────────────────────────────────────────────────
bool fire_t1_buy  = en_t1_buy and sig_t1_buy
bool fire_t1_sell = en_t1_sell and sig_t1_sell
bool fire_t2_buy  = en_t2_buy and sig_t2_buy
bool fire_t2_sell = en_t2_sell and sig_t2_sell
bool fire_t3_buy  = en_t3_buy and sig_t3_buy
bool fire_t3_sell = en_t3_sell and sig_t3_sell
bool fire_hdt1KBull_N = en_hdt1KBull and sig_hdt1KBull_N
bool fire_hdt1KBull_D = en_hdt1KBull and sig_hdt1KBull_D
bool fire_hdt2KBull_N = en_hdt2KBull and sig_hdt2KBull_N
bool fire_hdt2KBull_D = en_hdt2KBull and sig_hdt2KBull_D
bool fire_hdt3KBull_N = en_hdt3KBull and sig_hdt3KBull_N
bool fire_hdt3KBull_D = en_hdt3KBull and sig_hdt3KBull_D
bool fire_hdt4KBull_N = en_hdt4KBull and sig_hdt4KBull_N
bool fire_hdt4KBull_D = en_hdt4KBull and sig_hdt4KBull_D
bool fire_hdtNagaBull_N = en_hdtNagaBull and sig_hdtNagaBull_N
bool fire_hdtNagaBull_D = en_hdtNagaBull and sig_hdtNagaBull_D
bool fire_hdt1KBear_N = en_hdt1KBear and sig_hdt1KBear_N
bool fire_hdt1KBear_D = en_hdt1KBear and sig_hdt1KBear_D
bool fire_hdt2KBear_N = en_hdt2KBear and sig_hdt2KBear_N
bool fire_hdt2KBear_D = en_hdt2KBear and sig_hdt2KBear_D
bool fire_hdt3KBear_N = en_hdt3KBear and sig_hdt3KBear_N
bool fire_hdt3KBear_D = en_hdt3KBear and sig_hdt3KBear_D
bool fire_hdt4KBear_N = en_hdt4KBear and sig_hdt4KBear_N
bool fire_hdt4KBear_D = en_hdt4KBear and sig_hdt4KBear_D
bool fire_hdtNagaBear_N = en_hdtNagaBear and sig_hdtNagaBear_N
bool fire_hdtNagaBear_D = en_hdtNagaBear and sig_hdtNagaBear_D
bool alf_hdt1KBull_N = al_hdt1KBull and sig_hdt1KBull_N
bool alf_hdt1KBull_D = al_hdt1KBull and sig_hdt1KBull_D
bool alf_hdt2KBull_N = al_hdt2KBull and sig_hdt2KBull_N
bool alf_hdt2KBull_D = al_hdt2KBull and sig_hdt2KBull_D
bool alf_hdt3KBull_N = al_hdt3KBull and sig_hdt3KBull_N
bool alf_hdt3KBull_D = al_hdt3KBull and sig_hdt3KBull_D
bool alf_hdt4KBull_N = al_hdt4KBull and sig_hdt4KBull_N
bool alf_hdt4KBull_D = al_hdt4KBull and sig_hdt4KBull_D
bool alf_hdtNagaBull_N = al_hdtNagaBull and sig_hdtNagaBull_N
bool alf_hdtNagaBull_D = al_hdtNagaBull and sig_hdtNagaBull_D
bool alf_hdt1KBear_N = al_hdt1KBear and sig_hdt1KBear_N
bool alf_hdt1KBear_D = al_hdt1KBear and sig_hdt1KBear_D
bool alf_hdt2KBear_N = al_hdt2KBear and sig_hdt2KBear_N
bool alf_hdt2KBear_D = al_hdt2KBear and sig_hdt2KBear_D
bool alf_hdt3KBear_N = al_hdt3KBear and sig_hdt3KBear_N
bool alf_hdt3KBear_D = al_hdt3KBear and sig_hdt3KBear_D
bool alf_hdt4KBear_N = al_hdt4KBear and sig_hdt4KBear_N
bool alf_hdt4KBear_D = al_hdt4KBear and sig_hdt4KBear_D
bool alf_hdtNagaBear_N = al_hdtNagaBear and sig_hdtNagaBear_N
bool alf_hdtNagaBear_D = al_hdtNagaBear and sig_hdtNagaBear_D

// ─────────────────────────────────────────────────────────────────────────────
// HV·DISP·TIER PROXIMITY ALERTS (v1) — one alert() line per firing lane (0 units), operator line:
// <BULL|BEAR>, <HV1000..HV4000|NAGA>, Disp <x.x>, RVOL <x.x> — nothing else. Tier name, HV/disp/tier bars,
// close, vol ride log.info only. Disp/RVOL = the HV candle's values (read through its offset).
// ─────────────────────────────────────────────────────────────────────────────
if conf
    if alf_hdt1KBull_N or alf_hdt1KBull_D
        string msg_hdt1KBull = f_hdt_msg("BULL", "HV1000", hdt_last1K)
        alert(msg_hdt1KBull, alert.freq_once_per_bar_close)
        log.info("HDT1.1TICK " + syminfo.ticker + " " + timeframe.period + " | " + msg_hdt1KBull + " | " + hdt_tierBullName + " hvBar=" + str.tostring(hdt_last1K) + " dispBar=" + str.tostring(hdt_lastDispBull) + " tierBar=" + str.tostring(hdt_lastTierBull) + " | close=" + str.tostring(close) + " vol=" + str.tostring(volume, format.volume) + " bar=" + str.tostring(bar_index))
    if alf_hdt2KBull_N or alf_hdt2KBull_D
        string msg_hdt2KBull = f_hdt_msg("BULL", "HV2000", hdt_last2K)
        alert(msg_hdt2KBull, alert.freq_once_per_bar_close)
        log.info("HDT1.1TICK " + syminfo.ticker + " " + timeframe.period + " | " + msg_hdt2KBull + " | " + hdt_tierBullName + " hvBar=" + str.tostring(hdt_last2K) + " dispBar=" + str.tostring(hdt_lastDispBull) + " tierBar=" + str.tostring(hdt_lastTierBull) + " | close=" + str.tostring(close) + " vol=" + str.tostring(volume, format.volume) + " bar=" + str.tostring(bar_index))
    if alf_hdt3KBull_N or alf_hdt3KBull_D
        string msg_hdt3KBull = f_hdt_msg("BULL", "HV3000", hdt_last3K)
        alert(msg_hdt3KBull, alert.freq_once_per_bar_close)
        log.info("HDT1.1TICK " + syminfo.ticker + " " + timeframe.period + " | " + msg_hdt3KBull + " | " + hdt_tierBullName + " hvBar=" + str.tostring(hdt_last3K) + " dispBar=" + str.tostring(hdt_lastDispBull) + " tierBar=" + str.tostring(hdt_lastTierBull) + " | close=" + str.tostring(close) + " vol=" + str.tostring(volume, format.volume) + " bar=" + str.tostring(bar_index))
    if alf_hdt4KBull_N or alf_hdt4KBull_D
        string msg_hdt4KBull = f_hdt_msg("BULL", "HV4000", hdt_last4K)
        alert(msg_hdt4KBull, alert.freq_once_per_bar_close)
        log.info("HDT1.1TICK " + syminfo.ticker + " " + timeframe.period + " | " + msg_hdt4KBull + " | " + hdt_tierBullName + " hvBar=" + str.tostring(hdt_last4K) + " dispBar=" + str.tostring(hdt_lastDispBull) + " tierBar=" + str.tostring(hdt_lastTierBull) + " | close=" + str.tostring(close) + " vol=" + str.tostring(volume, format.volume) + " bar=" + str.tostring(bar_index))
    if alf_hdtNagaBull_N or alf_hdtNagaBull_D
        string msg_hdtNagaBull = f_hdt_msg("BULL", "NAGA", hdt_lastNaga)
        alert(msg_hdtNagaBull, alert.freq_once_per_bar_close)
