// Tier 1 (E2: side-typed keys, white letter-codes; E5: input.color swatch per marker; shape+location = operator Style-tab defaults 2026-08-18)
plotshape(fire_t1_buy, title="T1 Buy (Bull)", style=shape.diamond, location=location.abovebar, color=cl_t1_buy, size=size.small, text="T1", textcolor=color.white)
plotshape(fire_t1_sell, title="T1 Sell (Bear)", style=shape.xcross, location=location.abovebar, color=cl_t1_sell, size=size.small, text="T1", textcolor=color.white)

// Tier 2 (operator Style-tab defaults 2026-08-18)
plotshape(fire_t2_buy, title="T2 Buy (Bull)", style=shape.circle, location=location.belowbar, color=cl_t2_buy, size=size.normal, text="T2", textcolor=color.white)
plotshape(fire_t2_sell, title="T2 Sell (Bear)", style=shape.xcross, location=location.belowbar, color=cl_t2_sell, size=size.normal, text="T2", textcolor=color.white)

// Tier 3 (operator Style-tab defaults 2026-08-18); Buy yellow -> green (yellow banned, law II V2)
plotshape(fire_t3_buy, title="T3 SUPER Buy (Bull)", style=shape.circle, location=location.top, color=cl_t3_buy, size=size.large, text="T3", textcolor=color.white)
plotshape(fire_t3_sell, title="T3 SUPER Sell (Bear)", style=shape.cross, location=location.bottom, color=cl_t3_sell, size=size.large, text="T3", textcolor=color.white)
// ─────────────────────────────────────────────────────────────────────────────
// HV·DISP·TIER PROXIMITY PLOTS (v1.1) — REAL plotshapes (CS-1); input.color swatch per marker; bull lanes
// TWO plots per lane: offset 0 (HV candle / tier fire completed the triple) and offset -1 (the displaced candle
// completed it — marker ON the displaced candle, operator ruling 2026-08-19 row 5); same colour, same glyph;// at the bottom band, bear lanes at the top band; no two lanes share shape+location; white text.
// ─────────────────────────────────────────────────────────────────────────────
plotshape(fire_hdt1KBull_N, title="HV 1K·DISP·TIER Bull", style=shape.cross, location=location.bottom, color=cl_hdt1KBull, size=size.small, text="1K·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdt1KBull_D, title="HV 1K·DISP·TIER Bull (disp last)", style=shape.cross, location=location.bottom, color=cl_hdt1KBull, size=size.small, text="1K·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdt2KBull_N, title="HV 2K·DISP·TIER Bull", style=shape.triangleup, location=location.bottom, color=cl_hdt2KBull, size=size.small, text="2K·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdt2KBull_D, title="HV 2K·DISP·TIER Bull (disp last)", style=shape.triangleup, location=location.bottom, color=cl_hdt2KBull, size=size.small, text="2K·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdt3KBull_N, title="HV 3K·DISP·TIER Bull", style=shape.square, location=location.bottom, color=cl_hdt3KBull, size=size.small, text="3K·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdt3KBull_D, title="HV 3K·DISP·TIER Bull (disp last)", style=shape.square, location=location.bottom, color=cl_hdt3KBull, size=size.small, text="3K·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdt4KBull_N, title="HV 4K·DISP·TIER Bull", style=shape.circle, location=location.bottom, color=cl_hdt4KBull, size=size.normal, text="4K·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdt4KBull_D, title="HV 4K·DISP·TIER Bull (disp last)", style=shape.circle, location=location.bottom, color=cl_hdt4KBull, size=size.normal, text="4K·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdtNagaBull_N, title="HV NAGASAKI·DISP·TIER Bull", style=shape.diamond, location=location.bottom, color=cl_hdtNagaBull, size=size.normal, text="NAGA·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdtNagaBull_D, title="HV NAGASAKI·DISP·TIER Bull (disp last)", style=shape.diamond, location=location.bottom, color=cl_hdtNagaBull, size=size.normal, text="NAGA·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdt1KBear_N, title="HV 1K·DISP·TIER Bear", style=shape.cross, location=location.top, color=cl_hdt1KBear, size=size.small, text="1K·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdt1KBear_D, title="HV 1K·DISP·TIER Bear (disp last)", style=shape.cross, location=location.top, color=cl_hdt1KBear, size=size.small, text="1K·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdt2KBear_N, title="HV 2K·DISP·TIER Bear", style=shape.triangledown, location=location.top, color=cl_hdt2KBear, size=size.small, text="2K·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdt2KBear_D, title="HV 2K·DISP·TIER Bear (disp last)", style=shape.triangledown, location=location.top, color=cl_hdt2KBear, size=size.small, text="2K·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdt3KBear_N, title="HV 3K·DISP·TIER Bear", style=shape.square, location=location.top, color=cl_hdt3KBear, size=size.small, text="3K·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdt3KBear_D, title="HV 3K·DISP·TIER Bear (disp last)", style=shape.square, location=location.top, color=cl_hdt3KBear, size=size.small, text="3K·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdt4KBear_N, title="HV 4K·DISP·TIER Bear", style=shape.circle, location=location.top, color=cl_hdt4KBear, size=size.normal, text="4K·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdt4KBear_D, title="HV 4K·DISP·TIER Bear (disp last)", style=shape.circle, location=location.top, color=cl_hdt4KBear, size=size.normal, text="4K·D·T", textcolor=color.white, offset=-1)
plotshape(fire_hdtNagaBear_N, title="HV NAGASAKI·DISP·TIER Bear", style=shape.diamond, location=location.top, color=cl_hdtNagaBear, size=size.normal, text="NAGA·D·T", textcolor=color.white, offset=0)
plotshape(fire_hdtNagaBear_D, title="HV NAGASAKI·DISP·TIER Bear (disp last)", style=shape.diamond, location=location.top, color=cl_hdtNagaBear, size=size.normal, text="NAGA·D·T", textcolor=color.white, offset=-1)

// ─────────────────────────────────────────────────────────────────────────────
// ORIGINAL PLOTS (untouched)
// ─────────────────────────────────────────────────────────────────────────────

if lower_lvl.size() > 0 and barstate.islast
    f_clear_previous_lines(lower_draw)
    for i = 0 to lower_lvl.size() - 1
        l = lower_lvl.get(i)
        array_vol_lower.push(l.vol)
    for i = 0 to lower_lvl.size() - 1
        l   = lower_lvl.get(i)
        txt = "⮜ " + str.tostring(l.vol / array_vol_lower.sum() * 100, format.percent) + " (" + str.tostring(l.vol, format.volume) + ")"
        l_1   = line.new(l.indx, l.upper, time, l.upper, color = col1, width = 2, xloc = xloc.bar_time)
        l_2   = line.new(l.indx, l.lower, time, l.lower, color = col1, width = 2, xloc = xloc.bar_time)
        l_mid = line.new(l.indx, l.mid,   time, l.mid,   color = mid_l ? col1 : color(na), style = line.style_dashed, xloc = xloc.bar_time)
        vol_l = label.new(time, l.mid, txt, style = label.style_label_left, color = color(na), textcolor = chart.fg_color, xloc = xloc.bar_time)
        fill  = linefill.new(l_1, l_2, color.new(col1, 90))
        draw_ = draw.new(l_1, l_2, l_mid, fill, vol_l)
        lower_draw.push(draw_)

if upper_lvl.size() > 0 and barstate.islast
    f_clear_previous_lines(upper_draw)
    for i = 0 to array.size(upper_lvl) - 1
        l = array.get(upper_lvl, i)
        array_vol_upper.push(l.vol) 
    for i = 0 to array.size(upper_lvl) - 1
        l   = array.get(upper_lvl, i)
        txt = "⮜ " + str.tostring(l.vol / array_vol_upper.sum() * 100, format.percent) + " (" + str.tostring(l.vol, format.volume) + ")"
        l_1   = line.new(l.indx, l.upper, time, l.upper, color = col2, width = 2, xloc = xloc.bar_time)
        l_2   = line.new(l.indx, l.lower, time, l.lower, color = col2, width = 2, xloc = xloc.bar_time)
        l_mid = line.new(l.indx, l.mid,   time, l.mid,   color = mid_l ? col2 : color(na), style = line.style_dashed, xloc = xloc.bar_time)
        vol_l = label.new(time, l.mid, txt, style = label.style_label_left, color = color(na), textcolor = chart.fg_color, xloc = xloc.bar_time)
        fill  = linefill.new(l_1, l_2, color.new(col2, 90))
        draw_ = draw.new(l_1, l_2, l_mid, fill, vol_l)
        upper_draw.push(draw_)
