// ─────────────────────────────────────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────

f_cd_ok(int last_bar, int cd) =>
    na(last_bar) or (bar_index - last_bar) > cd

f_fmt_vol(float v) =>
    if v >= 1000000
        str.tostring(math.round(v / 1000000)) + "M"
    else if v >= 1000
        str.tostring(math.round(v / 1000)) + "K"
    else
        str.tostring(math.round(v))

f_zones_overlap(float lo1, float hi1, float lo2, float hi2) =>
    not na(lo1) and not na(hi1) and not na(lo2) and not na(hi2) and lo1 < hi2 and hi1 > lo2

f_push_hist(array<hist_entry> arr, float vol, float pool, int max_depth) =>
    float pct = pool > 0 ? (vol / pool * 100) : 100.0
    string full_ds = str.format_time(time, "MM/dd HH:mm", syminfo.timezone)
    string ds = str.substring(full_ds, 0, str.length(full_ds) - 1)
    arr.push(hist_entry.new(time, vol, pct, ds))
    if arr.size() > max_depth
        arr.shift()

f_push_t3_hist(array<hist_entry> arr, int max_depth) =>
    string full_ds = str.format_time(time, "MM/dd HH:mm", syminfo.timezone)
    string ds = str.substring(full_ds, 0, str.length(full_ds) - 1)
    arr.push(hist_entry.new(time, volume, 0.0, ds))
    if arr.size() > max_depth
        arr.shift()

// ─────────────────────────────────────────────────────────────────────────────
// EMISSION HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────
// These help compute emission metrics without modifying signal logic.

// Count active (non-invalidated) zones in an array.
// An active zone has a non-na vol field.
f_count_active(array<level> arr) =>
    int c = 0
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            if not na(arr.get(i).vol)
                c += 1
    c

// Find the minimum distance (as percent of price) from close to any active
// zone's midpoint in the given array. Returns -1 if no active zones.
f_nearest_dist_pct(array<level> arr, float price) =>
    float best = -1.0
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid)
                float d = math.abs(price - l.mid) / price * 100
                if best < 0 or d < best
                    best := d
    best

// Count zones whose midpoint is within threshold_pct of current price.
// This is the "stacking near price" count — zones clustering around price.
f_stack_near(array<level> arr, float price, float thresh_pct) =>
    int c = 0
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid) and math.abs(price - l.mid) / price * 100 <= thresh_pct
                c += 1
    c

// Find distance (as percent) to the nearest opposing zone ABOVE price.
// Used for bull gap: how far can price go up before hitting a bear zone?
// Returns 100.0 if no opposing zones above.
f_nearest_above_pct(array<level> arr, float price) =>
    float best = 100.0
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid) and l.mid > price
                float d = (l.mid - price) / price * 100
                if d < best
                    best := d
    best

// Find distance (as percent) to the nearest opposing zone BELOW price.
// Used for bear gap: how far can price go down before hitting a bull zone?
f_nearest_below_pct(array<level> arr, float price) =>
    float best = 100.0
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid) and l.mid < price
                float d = (price - l.mid) / price * 100
                if d < best
                    best := d
    best

// Get the nearest active zone's midpoint price from an array.
f_nearest_mid(array<level> arr, float price) =>
    float best_mid = na
    float best_d   = 1e18
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid)
                float d = math.abs(price - l.mid)
                if d < best_d
                    best_d   := d
                    best_mid := l.mid
    best_mid

// Get the nearest active zone's volume from an array.
f_nearest_vol(array<level> arr, float price) =>
    float best_vol = na
    float best_d   = 1e18
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.mid)
                float d = math.abs(price - l.mid)
                if d < best_d
                    best_d   := d
                    best_vol := l.vol
    best_vol


// ═══════════════════════════════════════════════════════════════════════════════
// ZONE LIFECYCLE — DEATH EMISSION (operator survivorship mandate, 2026-07-23)
// The chart shows only survivors; every zone death was silent. VOB_ZONEKILL fires
// at all three death paths (BREACH / DEDUP / EVICT), completing the lifetime pair
// with VOB_ZONEFORM. Confirmed-bar gated: intrabar provisional kills never emit.
// ═══════════════════════════════════════════════════════════════════════════════

f_emit_zonekill(level victim, string side, int len1, string reason) =>
    if en_emission_logs and barstate.isconfirmed and not na(victim.vol)
        log.info("{0}", "VOB_ZONEKILL|T:" + str.tostring(time) + "|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|SIDE:" + side + "|SENS:" + str.tostring(len1) + "|ZLO:" + str.tostring(victim.lower) + "|ZHI:" + str.tostring(victim.upper) + "|MID:" + str.tostring(victim.mid) + "|ZVOL:" + str.tostring(math.round(victim.vol)) + "|BIRTH_T:" + str.tostring(victim.indx) + "|AGE_MS:" + str.tostring(time - victim.indx) + "|REASON:" + reason + "|CLOSE:" + str.tostring(close))

// ─────────────────────────────────────────────────────────────────────────────
// CORE VOB FUNCTION — returns [t3_buy, t3_sell, bull_pool, bear_pool]
// ─────────────────────────────────────────────────────────────────────────────
// v10: level.new() calls extended to capture origin-bar OHLC at zone formation.
// Signal logic is otherwise PRESERVED EXACTLY from the original.

f_vob(int len1, array<level> up_lvl, array<level> lo_lvl, float atr_prox, float atr_adj, float sup_mult) =>
    int   len2    = len1 + 13
    float ema1    = ta.ema(close, len1)
    float ema2    = ta.ema(close, len2)
    bool  cup     = ta.crossover(ema1, ema2)  and barstate.isconfirmed
    bool  cdn     = ta.crossunder(ema1, ema2) and barstate.isconfirmed
    float lowest  = ta.lowest(len2)
    float highest = ta.highest(len2)

    if cup
        float vol = 0.0
        for i = 1 to len2
            if low[i] == lowest
                int index = time[i]
                for k = 0 to i
                    vol += volume[k]
                float src = math.min(open[i], close[i])
                src := (src - lowest) < atr_adj * 0.5 ? lowest + atr_adj * 0.5 : src
                float mid = math.avg(src, lowest)
                lo_lvl.push(level.new(index, src, lowest, mid, vol, open[i], high[i], low[i], close[i]))

    if cdn
        float vol = 0.0
        for i = 1 to len2
            if high[i] == highest
                int index = time[i]
                for k = 0 to i
                    vol += volume[k]
                float src = math.max(open[i], close[i])
                src := (highest - src) < atr_adj * 0.5 ? highest - atr_adj * 0.5 : src
                float mid = math.avg(src, highest)
                up_lvl.push(level.new(index, highest, src, mid, vol, open[i], high[i], low[i], close[i]))

    if lo_lvl.size() > 0
        for i = 0 to lo_lvl.size() - 1
            level l = lo_lvl.get(i)
            if i > 0
                level l1 = lo_lvl.get(i - 1)
                if math.abs(l.mid - l1.mid) < atr_prox
                    f_emit_zonekill(l1, "BULL", len1, "DEDUP")
                    lo_lvl.set(i - 1, level.new(na, na, na, na, na, na, na, na, na))
            if close < l.lower
                f_emit_zonekill(l, "BULL", len1, "BREACH")
                lo_lvl.set(i, level.new(na, na, na, na, na, na, na, na, na))
        if lo_lvl.size() > 15
            f_emit_zonekill(lo_lvl.get(0), "BULL", len1, "EVICT")
            lo_lvl.shift()

    if up_lvl.size() > 0
        for i = 0 to up_lvl.size() - 1
            level l = up_lvl.get(i)
            if i > 0
                level l1 = up_lvl.get(i - 1)
                if math.abs(l.mid - l1.mid) < atr_prox
                    f_emit_zonekill(l1, "BEAR", len1, "DEDUP")
                    up_lvl.set(i - 1, level.new(na, na, na, na, na, na, na, na, na))
            if close > l.upper
                f_emit_zonekill(l, "BEAR", len1, "BREACH")
                up_lvl.set(i, level.new(na, na, na, na, na, na, na, na, na))
        if up_lvl.size() > 15
            f_emit_zonekill(up_lvl.get(0), "BEAR", len1, "EVICT")
            up_lvl.shift()

    bool  t3_buy  = false
    bool  t3_sell = false
    float bp      = 0.0
    float sp      = 0.0

    if barstate.isconfirmed
        array<float> vbv = array.new<float>()
        array<float> vbl = array.new<float>()
        array<float> vbh = array.new<float>()
        if lo_lvl.size() > 0
            for i = 0 to lo_lvl.size() - 1
                level l = lo_lvl.get(i)
                if not na(l.vol)
                    vbv.push(l.vol)
                    vbl.push(l.lower)
                    vbh.push(l.upper)

        array<float> vav  = array.new<float>()
        array<float> val2 = array.new<float>()
        array<float> vah  = array.new<float>()
        if up_lvl.size() > 0
            for i = 0 to up_lvl.size() - 1
                level l = up_lvl.get(i)
                if not na(l.vol)
                    vav.push(l.vol)
                    val2.push(l.lower)
                    vah.push(l.upper)

        bp := vbv.size() > 0 ? vbv.sum() : 0.0
        sp := vav.size() > 0 ? vav.sum() : 0.0

        float db_vol = 0.0
        float db_low = 0.0
        float db_high = 0.0
        int bc = vbv.size()
        if bc > 0
            for i = 0 to bc - 1
                float v = vbv.get(i)
                if v > db_vol
                    db_vol  := v
                    db_low  := vbl.get(i)
                    db_high := vbh.get(i)

        float da_vol = 0.0
        float da_low = 0.0
        float da_high = 0.0
        int ac = vav.size()
        if ac > 0
            for i = 0 to ac - 1
                float v = vav.get(i)
                if v > da_vol
                    da_vol  := v
                    da_low  := val2.get(i)
                    da_high := vah.get(i)

        bool pat_bull = close >= db_low and close <= db_high
        bool pat_bear = close >= da_low and close <= da_high

        t3_buy  := bc == 1 and sp > 0 and db_vol > sp * sup_mult and pat_bull
        t3_sell := ac == 1 and bp > 0 and da_vol > bp * sup_mult and pat_bear

    [t3_buy, t3_sell, bp, sp]

// ─────────────────────────────────────────────────────────────────────────────
// FUNCTION CALLS — capture array sizes BEFORE for zone-creation detection
// ─────────────────────────────────────────────────────────────────────────────

int sz_la = lower_a.size()
int sz_ua = upper_a.size()
int sz_lb = lower_b.size()
int sz_ub = upper_b.size()
int sz_lc = lower_c.size()
int sz_uc = upper_c.size()
int sz_ld = lower_d.size()
int sz_ud = upper_d.size()
int sz_le = lower_e.size()
int sz_ue = upper_e.size()
int sz_lf = lower_f.size()
int sz_uf = upper_f.size()

[t3_buy_a, t3_sell_a, bpa, spa] = f_vob(sens_a, upper_a, lower_a, atr_proximity, atr_adjust, super_mult)
[t3_buy_b, t3_sell_b, bpb, spb] = f_vob(sens_b, upper_b, lower_b, atr_proximity, atr_adjust, super_mult)
[t3_buy_c, t3_sell_c, bpc, spc] = f_vob(sens_c, upper_c, lower_c, atr_proximity, atr_adjust, super_mult)
[t3_buy_d, t3_sell_d, bpd, spd] = f_vob(sens_d, upper_d, lower_d, atr_proximity, atr_adjust, super_mult)
[t3_buy_e, t3_sell_e, bpe, spe] = f_vob(sens_e, upper_e, lower_e, atr_proximity, atr_adjust, super_mult)
[t3_buy_f, t3_sell_f, bpf, spf] = f_vob(sens_f, upper_f, lower_f, atr_proximity, atr_adjust, super_mult)

// Zone-creation booleans (array grew = new zone pushed)
bool nzb_a = lower_a.size() > sz_la
bool nzs_a = upper_a.size() > sz_ua
bool nzb_b = lower_b.size() > sz_lb
bool nzs_b = upper_b.size() > sz_ub
bool nzb_c = lower_c.size() > sz_lc
bool nzs_c = upper_c.size() > sz_uc
bool nzb_d = lower_d.size() > sz_ld
bool nzs_d = upper_d.size() > sz_ud
bool nzb_e = lower_e.size() > sz_le
bool nzs_e = upper_e.size() > sz_ue
bool nzb_f = lower_f.size() > sz_lf
bool nzs_f = upper_f.size() > sz_uf

// ═══════════════════════════════════════════════════════════════════════════════
// EMISSION LAYER — ZONE METRICS COMPUTATION (moved here so alerts can use them)
// ═══════════════════════════════════════════════════════════════════════════════
// These DO NOT affect signal logic. Computed here (after f_vob populates zone
// arrays) so Bloomberg-format alert strings can reference them.

int cnt_ba = f_count_active(lower_a)
int cnt_sa = f_count_active(upper_a)
int cnt_bb = f_count_active(lower_b)
int cnt_sb = f_count_active(upper_b)
int cnt_bc = f_count_active(lower_c)
int cnt_sc = f_count_active(upper_c)
int cnt_bd = f_count_active(lower_d)
int cnt_sd = f_count_active(upper_d)
int cnt_be = f_count_active(lower_e)
int cnt_se = f_count_active(upper_e)
int cnt_bf = f_count_active(lower_f)
int cnt_sf = f_count_active(upper_f)
int cnt_bull_all = cnt_ba + cnt_bb + cnt_bc + cnt_bd + cnt_be + cnt_bf
int cnt_bear_all = cnt_sa + cnt_sb + cnt_sc + cnt_sd + cnt_se + cnt_sf

float nd_ba = f_nearest_dist_pct(lower_a, close)
float nd_sa = f_nearest_dist_pct(upper_a, close)
float nd_bb = f_nearest_dist_pct(lower_b, close)
float nd_sb = f_nearest_dist_pct(upper_b, close)
float nd_bc = f_nearest_dist_pct(lower_c, close)
float nd_sc = f_nearest_dist_pct(upper_c, close)
float nd_bd = f_nearest_dist_pct(lower_d, close)
float nd_sd = f_nearest_dist_pct(upper_d, close)
float nd_be = f_nearest_dist_pct(lower_e, close)
float nd_se = f_nearest_dist_pct(upper_e, close)
float nd_bf = f_nearest_dist_pct(lower_f, close)
float nd_sf = f_nearest_dist_pct(upper_f, close)

float nearest_bull_dist = math.min(nd_ba >= 0 ? nd_ba : 999, nd_bb >= 0 ? nd_bb : 999, nd_bc >= 0 ? nd_bc : 999, nd_bd >= 0 ? nd_bd : 999, nd_be >= 0 ? nd_be : 999, nd_bf >= 0 ? nd_bf : 999)
float nearest_bear_dist = math.min(nd_sa >= 0 ? nd_sa : 999, nd_sb >= 0 ? nd_sb : 999, nd_sc >= 0 ? nd_sc : 999, nd_sd >= 0 ? nd_sd : 999, nd_se >= 0 ? nd_se : 999, nd_sf >= 0 ? nd_sf : 999)
nearest_bull_dist := nearest_bull_dist >= 999 ? -1.0 : nearest_bull_dist
nearest_bear_dist := nearest_bear_dist >= 999 ? -1.0 : nearest_bear_dist

int stk_bull = f_stack_near(lower_a, close, stack_thresh_pct) + f_stack_near(lower_b, close, stack_thresh_pct) + f_stack_near(lower_c, close, stack_thresh_pct) + f_stack_near(lower_d, close, stack_thresh_pct) + f_stack_near(lower_e, close, stack_thresh_pct) + f_stack_near(lower_f, close, stack_thresh_pct)
int stk_bear = f_stack_near(upper_a, close, stack_thresh_pct) + f_stack_near(upper_b, close, stack_thresh_pct) + f_stack_near(upper_c, close, stack_thresh_pct) + f_stack_near(upper_d, close, stack_thresh_pct) + f_stack_near(upper_e, close, stack_thresh_pct) + f_stack_near(upper_f, close, stack_thresh_pct)

float opp_a = f_nearest_above_pct(upper_a, close)
float opp_b = f_nearest_above_pct(upper_b, close)
float opp_c = f_nearest_above_pct(upper_c, close)
float opp_d = f_nearest_above_pct(upper_d, close)
float opp_e = f_nearest_above_pct(upper_e, close)
float opp_f = f_nearest_above_pct(upper_f, close)
float bull_gap = math.min(opp_a, opp_b, opp_c, opp_d, opp_e, opp_f)
float opp_ba = f_nearest_below_pct(lower_a, close)
float opp_bb = f_nearest_below_pct(lower_b, close)
float opp_bc = f_nearest_below_pct(lower_c, close)
float opp_bd = f_nearest_below_pct(lower_d, close)
float opp_be = f_nearest_below_pct(lower_e, close)
float opp_bf = f_nearest_below_pct(lower_f, close)
float bear_gap = math.min(opp_ba, opp_bb, opp_bc, opp_bd, opp_be, opp_bf)

// =============================================================================
// v11.4 — BIRTH-BAR REFERENCE ENGINE (ported from VOB v10.1, operator laws 2026-07-22)
// Birth level: bullish zone -> zone.lower (window-low swing anchor, D4 birth law);
// bearish zone -> zone.upper. Reference per side = NEAREST ACTIVE (actionability).
// EMANATE = side of the latest ACTIVE zone birth (flips only on opposite-side birth
// or full invalidation; tie -> BULL).
// =============================================================================

f_fmt_p2(float v) =>
    na(v) ? "na" : str.tostring(math.round(v * 100) / 100)

f_nb_lvl(array<level> arr, float price, bool is_bull) =>
    float best = na
    float bd   = 1e18
    if arr.size() > 0 and price > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.vol)
                float lvl = is_bull ? l.lower : l.upper
                float d = math.abs(price - lvl)
                if d < bd
                    bd   := d
                    best := lvl
    best

f_nearer(float cur, float cand, float price) =>
    na(cand) ? cur : na(cur) ? cand : math.abs(price - cand) < math.abs(price - cur) ? cand : cur

f_latest_t(array<level> arr) =>
    int best = na
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.vol) and not na(l.indx)
                if na(best) or l.indx > best
                    best := l.indx
    best

f_tmax(int a, int b) =>
    na(a) ? b : na(b) ? a : math.max(a, b)

float bb_bull = f_nb_lvl(lower_a, close, true)
bb_bull := f_nearer(bb_bull, f_nb_lvl(lower_b, close, true), close)
bb_bull := f_nearer(bb_bull, f_nb_lvl(lower_c, close, true), close)
bb_bull := f_nearer(bb_bull, f_nb_lvl(lower_d, close, true), close)
bb_bull := f_nearer(bb_bull, f_nb_lvl(lower_e, close, true), close)
bb_bull := f_nearer(bb_bull, f_nb_lvl(lower_f, close, true), close)
float bb_bear = f_nb_lvl(upper_a, close, false)
bb_bear := f_nearer(bb_bear, f_nb_lvl(upper_b, close, false), close)
bb_bear := f_nearer(bb_bear, f_nb_lvl(upper_c, close, false), close)
bb_bear := f_nearer(bb_bear, f_nb_lvl(upper_d, close, false), close)
bb_bear := f_nearer(bb_bear, f_nb_lvl(upper_e, close, false), close)
bb_bear := f_nearer(bb_bear, f_nb_lvl(upper_f, close, false), close)

float bb_bull_pct = na(bb_bull) or close == 0 ? na : (close - bb_bull) / close * 100
float bb_bear_pct = na(bb_bear) or close == 0 ? na : (bb_bear - close) / close * 100

int bbt_bull = f_tmax(f_tmax(f_tmax(f_latest_t(lower_a), f_latest_t(lower_b)), f_tmax(f_latest_t(lower_c), f_latest_t(lower_d))), f_tmax(f_latest_t(lower_e), f_latest_t(lower_f)))
int bbt_bear = f_tmax(f_tmax(f_tmax(f_latest_t(upper_a), f_latest_t(upper_b)), f_tmax(f_latest_t(upper_c), f_latest_t(upper_d))), f_tmax(f_latest_t(upper_e), f_latest_t(upper_f)))

string bb_closer  = na(bb_bull_pct) and na(bb_bear_pct) ? "NA" : na(bb_bear_pct) ? "BULL" : na(bb_bull_pct) ? "BEAR" : math.abs(bb_bull_pct) <= math.abs(bb_bear_pct) ? "BULL" : "BEAR"
string bb_emanate = na(bbt_bull) and na(bbt_bear) ? "NA" : na(bbt_bear) ? "BULL" : na(bbt_bull) ? "BEAR" : bbt_bull >= bbt_bear ? "BULL" : "BEAR"

// the slim human-alert tail every alert carries (T-ALERTMSG law)
string bb_tail = "|BB_BULL:" + f_fmt_p2(bb_bull) + "(" + f_fmt_p2(bb_bull_pct) + "%)|BB_BEAR:" + f_fmt_p2(bb_bear) + "(" + f_fmt_p2(bb_bear_pct) + "%)|CLOSER:" + bb_closer + "|EMANATE:" + bb_emanate

// ─────────────────────────────────────────────────────────────────────────────
// NAGASAKI — All-Time High Volume (PRESERVED EXACTLY)
// ─────────────────────────────────────────────────────────────────────────────

var float maxVolEver = 0.0
bool isNagasaki = false
if volume[1] > maxVolEver
    maxVolEver := volume[1]
    isNagasaki := true

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — ORIGINAL T3 SIGNAL CONDITIONS + COOLDOWN (PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

// ── v11.2 ALERT-DISPLAY DECOUPLING: one signal lane, two independent taps ──
// sig_* = dp criteria + shared cooldown (stamps its OWN cooldown, always)
// plot_* = show_* AND sig_*  (chart tap) · alert = al_* AND sig_* (inbox tap)
bool sig_t3_buy_a  = t3_buy_a  and f_cd_ok(last_t3_buy_a,  cooldown_bars)
bool sig_t3_sell_a = t3_sell_a and f_cd_ok(last_t3_sell_a, cooldown_bars)
bool sig_t3_buy_b  = t3_buy_b  and f_cd_ok(last_t3_buy_b,  cooldown_bars)
bool sig_t3_sell_b = t3_sell_b and f_cd_ok(last_t3_sell_b, cooldown_bars)
bool sig_t3_buy_c  = t3_buy_c  and f_cd_ok(last_t3_buy_c,  cooldown_bars)
bool sig_t3_sell_c = t3_sell_c and f_cd_ok(last_t3_sell_c, cooldown_bars)
bool sig_t3_buy_d  = t3_buy_d  and f_cd_ok(last_t3_buy_d,  cooldown_bars)
bool sig_t3_sell_d = t3_sell_d and f_cd_ok(last_t3_sell_d, cooldown_bars)
bool sig_t3_buy_e  = t3_buy_e  and f_cd_ok(last_t3_buy_e,  cooldown_bars)
bool sig_t3_sell_e = t3_sell_e and f_cd_ok(last_t3_sell_e, cooldown_bars)
bool sig_t3_buy_f  = t3_buy_f  and f_cd_ok(last_t3_buy_f,  cooldown_bars)
bool sig_t3_sell_f = t3_sell_f and f_cd_ok(last_t3_sell_f, cooldown_bars)
bool sig_nagasaki  = isNagasaki  // v11.10: NO cooldown — Nagasaki is an independent boolean (HV-law parity, operator 2026-08-19)
bool plot_nagasaki  = show_nagasaki  and sig_nagasaki

// T3 cooldown stamps
if sig_t3_buy_a
    last_t3_buy_a := bar_index
if sig_t3_sell_a
    last_t3_sell_a := bar_index
if sig_t3_buy_b
    last_t3_buy_b := bar_index
if sig_t3_sell_b
    last_t3_sell_b := bar_index
if sig_t3_buy_c
    last_t3_buy_c := bar_index
if sig_t3_sell_c
    last_t3_sell_c := bar_index
if sig_t3_buy_d
    last_t3_buy_d := bar_index
if sig_t3_sell_d
    last_t3_sell_d := bar_index
if sig_t3_buy_e
    last_t3_buy_e := bar_index
if sig_t3_sell_e
    last_t3_sell_e := bar_index
if sig_t3_buy_f
    last_t3_buy_f := bar_index
if sig_t3_sell_f
    last_t3_sell_f := bar_index
if sig_nagasaki
    last_nagasaki := bar_index

// T3 + Nagasaki signal history tracking
if sig_t3_buy_a
    f_push_t3_hist(ht3ba, hist_depth)
if sig_t3_sell_a
    f_push_t3_hist(ht3sa, hist_depth)
if sig_t3_buy_b
    f_push_t3_hist(ht3bb, hist_depth)
if sig_t3_sell_b
    f_push_t3_hist(ht3sb, hist_depth)
if sig_t3_buy_c
    f_push_t3_hist(ht3bc, hist_depth)
if sig_t3_sell_c
    f_push_t3_hist(ht3sc, hist_depth)
if sig_t3_buy_d
    f_push_t3_hist(ht3bd, hist_depth)
if sig_t3_sell_d
    f_push_t3_hist(ht3sd, hist_depth)
if sig_t3_buy_e
    f_push_t3_hist(ht3be, hist_depth)
if sig_t3_sell_e
    f_push_t3_hist(ht3se, hist_depth)
if sig_t3_buy_f
    f_push_t3_hist(ht3bf, hist_depth)
if sig_t3_sell_f
    f_push_t3_hist(ht3sf, hist_depth)
if sig_nagasaki
    f_push_t3_hist(h_nag, hist_depth)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — ORIGINAL T3 PLOTSHAPES (13 total — PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_buy_a,  "T3a Buy",  shape.circle, location.belowbar, color.new(#00e676, 0), size = size.large, text = "T3a", textcolor = color.new(#00e676, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_buy_b,  "T3b Buy",  shape.circle, location.belowbar, color.new(#00bcd4, 0), size = size.large, text = "T3b", textcolor = color.new(#00bcd4, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_buy_c,  "T3c Buy",  shape.circle, location.belowbar, color.new(#2196f3, 0), size = size.large, text = "T3c", textcolor = color.new(#2196f3, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_buy_d,  "T3d Buy",  shape.circle, location.belowbar, color.new(#ffeb3b, 0), size = size.large, text = "T3d", textcolor = color.new(#ffeb3b, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_buy_e,  "T3e Buy",  shape.circle, location.belowbar, color.new(#ff9800, 0), size = size.large, text = "T3e", textcolor = color.new(#ff9800, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_buy_f,  "T3f Buy",  shape.circle, location.belowbar, color.new(#ffd700, 0), size = size.large, text = "T3f", textcolor = color.new(#ffd700, 0))

// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_sell_a, "T3a Sell", shape.circle, location.abovebar, color.new(#ff5252, 0), size = size.large, text = "T3a", textcolor = color.new(#ff5252, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_sell_b, "T3b Sell", shape.circle, location.abovebar, color.new(#e91e63, 0), size = size.large, text = "T3b", textcolor = color.new(#e91e63, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_sell_c, "T3c Sell", shape.circle, location.abovebar, color.new(#9c27b0, 0), size = size.large, text = "T3c", textcolor = color.new(#9c27b0, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_sell_d, "T3d Sell", shape.circle, location.abovebar, color.new(#ff4400, 0), size = size.large, text = "T3d", textcolor = color.new(#ff4400, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_sell_e, "T3e Sell", shape.circle, location.abovebar, color.new(#d50000, 0), size = size.large, text = "T3e", textcolor = color.new(#d50000, 0))
// [v11 MULTIPLES-ONLY removed] plotshape(plot_t3_sell_f, "T3f Sell", shape.circle, location.abovebar, color.new(#b71c1c, 0), size = size.large, text = "T3f", textcolor = color.new(#b71c1c, 0))

plotshape(plot_nagasaki,  "Nagasaki", shape.flag, location.top, color.purple, size = size.normal, text = "NAG", textcolor = color.purple, offset = -1)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — CONSOLIDATED ALERTCONDITIONS (2 total — each counts toward 64 limit)
// ═══════════════════════════════════════════════════════════════════════════════

bool any_t3 = sig_t3_buy_a or sig_t3_sell_a or sig_t3_buy_b or sig_t3_sell_b or sig_t3_buy_c or sig_t3_sell_c or sig_t3_buy_d or sig_t3_sell_d or sig_t3_buy_e or sig_t3_sell_e or sig_t3_buy_f or sig_t3_sell_f or sig_nagasaki
// v11.9 KEEPER CUT: "Any T3" alertcondition REMOVED (calculator channel); any_t3 bool retained for composites.

// (Zone formation alertcondition uses any_zone bool defined later in the code)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — BLOOMBERG-FORMAT T3 ALERT STRINGS (alert() — does NOT count toward 64)
// ═══════════════════════════════════════════════════════════════════════════════

// v11.9 KEEPER CUT: per-tier T3 alert multiplexer + f_bloomberg_t3 REMOVED — T3 a-f are calculators (no checkbox / no vp / no alert). Signals still compute and feed T3 Cluster, X3/FO, BBP and every +ANY companion list.
if al_nagasaki and sig_nagasaki
    alert("NAGASAKI_ATH_VOL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:NEUTRAL|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|ATHVOL:" + str.tostring(math.round(maxVolEver)) + bb_tail, alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 2 — ZONE-CREATION MARKERS + COOLDOWN + HISTORY (PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

// ── v11.2: zone signal lane (raw + cooldown) feeding both taps ──
bool sig_zb_a = nzb_a and f_cd_ok(cd_zb_a, cooldown_bars)
bool sig_zs_a = nzs_a and f_cd_ok(cd_zs_a, cooldown_bars)
bool sig_zb_b = nzb_b and f_cd_ok(cd_zb_b, cooldown_bars)
bool sig_zs_b = nzs_b and f_cd_ok(cd_zs_b, cooldown_bars)
bool sig_zb_c = nzb_c and f_cd_ok(cd_zb_c, cooldown_bars)
bool sig_zs_c = nzs_c and f_cd_ok(cd_zs_c, cooldown_bars)
bool sig_zb_d = nzb_d and f_cd_ok(cd_zb_d, cooldown_bars)
bool sig_zs_d = nzs_d and f_cd_ok(cd_zs_d, cooldown_bars)
bool sig_zb_e = nzb_e and f_cd_ok(cd_zb_e, cooldown_bars)
bool sig_zs_e = nzs_e and f_cd_ok(cd_zs_e, cooldown_bars)
bool sig_zb_f = nzb_f and f_cd_ok(cd_zb_f, cooldown_bars)
bool sig_zs_f = nzs_f and f_cd_ok(cd_zs_f, cooldown_bars)

if sig_zb_a
    cd_zb_a := bar_index
if sig_zs_a
    cd_zs_a := bar_index
if sig_zb_b
    cd_zb_b := bar_index
if sig_zs_b
    cd_zs_b := bar_index
if sig_zb_c
    cd_zb_c := bar_index
if sig_zs_c
    cd_zs_c := bar_index
if sig_zb_d
    cd_zb_d := bar_index
if sig_zs_d
    cd_zs_d := bar_index
if sig_zb_e
    cd_zb_e := bar_index
if sig_zs_e
    cd_zs_e := bar_index
if sig_zb_f
    cd_zb_f := bar_index
if sig_zs_f
    cd_zs_f := bar_index

// History tracking
if sig_zb_a and lower_a.size() > 0
    level nz = lower_a.last()
    if not na(nz.vol)
        f_push_hist(hb_a, nz.vol, bpa, hist_depth)
if sig_zs_a and upper_a.size() > 0
    level nz = upper_a.last()
    if not na(nz.vol)
        f_push_hist(hs_a, nz.vol, spa, hist_depth)
if sig_zb_b and lower_b.size() > 0
    level nz = lower_b.last()
    if not na(nz.vol)
        f_push_hist(hb_b, nz.vol, bpb, hist_depth)
if sig_zs_b and upper_b.size() > 0
    level nz = upper_b.last()
    if not na(nz.vol)
        f_push_hist(hs_b, nz.vol, spb, hist_depth)
if sig_zb_c and lower_c.size() > 0
    level nz = lower_c.last()
    if not na(nz.vol)
        f_push_hist(hb_c, nz.vol, bpc, hist_depth)
if sig_zs_c and upper_c.size() > 0
    level nz = upper_c.last()
    if not na(nz.vol)
        f_push_hist(hs_c, nz.vol, spc, hist_depth)
if sig_zb_d and lower_d.size() > 0
    level nz = lower_d.last()
    if not na(nz.vol)
        f_push_hist(hb_d, nz.vol, bpd, hist_depth)
if sig_zs_d and upper_d.size() > 0
    level nz = upper_d.last()
    if not na(nz.vol)
        f_push_hist(hs_d, nz.vol, spd, hist_depth)
if sig_zb_e and lower_e.size() > 0
    level nz = lower_e.last()
    if not na(nz.vol)
        f_push_hist(hb_e, nz.vol, bpe, hist_depth)
if sig_zs_e and upper_e.size() > 0
    level nz = upper_e.last()
    if not na(nz.vol)
        f_push_hist(hs_e, nz.vol, spe, hist_depth)
if sig_zb_f and lower_f.size() > 0
    level nz = lower_f.last()
    if not na(nz.vol)
        f_push_hist(hb_f, nz.vol, bpf, hist_depth)
if sig_zs_f and upper_f.size() > 0
    level nz = upper_f.last()
    if not na(nz.vol)
        f_push_hist(hs_f, nz.vol, spf, hist_depth)

