indicator("VOB v11.10 TICK", shorttitle="VOB11.10T", overlay = true
             , max_lines_count = 500, max_bars_back = 5000)
import TradingView/ta/7 as tv_ta

// ═══════════════════════════════════════════════════════════════════════════════
// ARCHITECTURE — READ THIS FIRST (Claude Code: this is your dictionary)
// ═══════════════════════════════════════════════════════════════════════════════
//
// WHAT THIS INDICATOR DOES:
//   This indicator detects Volume Order Blocks (VOBs) — price zones where
//   significant volume accumulated during an EMA crossover event. These zones
//   act as support (bullish) or resistance (bearish) levels. When price returns
//   to a zone, it tends to bounce (support holds) or reject (resistance holds).
//
// HOW IT WORKS (the physical measurement):
//   1. Two Exponential Moving Averages (EMAs) are computed per sensitivity tier.
//      The fast EMA length = sensitivity value (e.g., 2500 bars for tier A).
//      The slow EMA length = sensitivity + 13.
//   2. When the fast EMA crosses ABOVE the slow EMA (bullish crossover), the
//      engine identifies the lowest price bar in the lookback window and creates
//      a BULLISH zone around that low point. Volume is accumulated from that
//      low bar to the crossover bar.
//   3. When the fast EMA crosses BELOW the slow EMA (bearish crossunder), the
//      engine identifies the highest price bar and creates a BEARISH zone around
//      that high point with accumulated volume.
//   4. Zones persist until INVALIDATED: a bullish zone is invalidated when price
//      closes BELOW the zone's lower boundary. A bearish zone is invalidated
//      when price closes ABOVE the zone's upper boundary.
//   5. Zones too close together (within 3× ATR) are deduplicated — the newer
//      zone replaces the older one.
//
// SIX SENSITIVITY TIERS (A through F):
//   A = highest sensitivity (longest EMA, slowest to trigger, fewest zones)
//   F = lowest sensitivity (shortest EMA, fastest to trigger, most zones)
//   Each tier runs its own independent VOB engine. Zones from different tiers
//   can overlap at the same price level — this is "stacking" and represents
//   extreme confluence.
//
// MUTUALLY EXCLUSIVE (MutEx) OVERLAP ENGINE:
//   When zones from different sensitivities overlap in price, the highest
//   sensitivity tier gets full visual treatment (top line + bottom line +
//   midline + shaded fill). Lower tiers get degraded to a single midline.
//   This prevents visual clutter while preserving all zone data.
//
// T3 SUPER SIGNALS:
//   A T3 signal fires when: exactly ONE zone exists in the dominant direction,
//   that zone's volume exceeds the opposing pool × super_mult, and current
//   price is inside that zone. This is the highest-conviction signal.
//
// NAGASAKI SIGNAL:
//   Fires when the previous bar's volume exceeds ALL prior volume ever seen
//   on this ticker/timeframe. All-time high volume event.
//
// MULTI-ZONE SAME-CANDLE DETECTION (v10 ADDITION):
//   Fires when 2 OR 3+ zone-formation visual plots (zA / zB / zC / zD / zE / zF)
//   appear on the SAME candle, separately for bullish and bearish. Four new
//   detection plots — Bull 2, Bull 3+, Bear 2, Bear 3+ — each with its own
//   alertcondition and Bloomberg-format alert() payload. The plot and alert
//   share a single barstate.isconfirmed-gated boolean so visual + inbox parity
//   is 1:1 and non-repainting.
//
// EMISSION LAYER (NEW — for Claude Code MCP reading):
//   This indicator emits data through ALL SIX channels Claude Code can read:
//   1. plot() → data_get_study_values: 37 numeric time series per bar
//   2. log.info() VOB_ZONEFORM lines — v11.4: the label channel is REMOVED
//      (pane labels killed in totality, operator order; zero graphic objects)
//   3. table.new() → data_get_pine_tables: comprehensive snapshot + definitions
//   4. log.info() → pine_get_console: per-bar structured streaming data
//   5. alert() → alert strings with all metadata fields
//   6. line.new() → data_get_pine_lines: zone boundary prices (existing)
//
// PLOT BUDGET (v10): 31 plotshapes + 7 alertconditions = 38 outputs / 64 budget.
//   (Adds 4 multi-zone plotshapes + 4 multi-zone alertconditions on top of v10
//    base. All three visual tables were removed in v10. VLB Bull + VLB Bear
//    plus the 4 new MZ plots all share the cooldown_bars parameter.)
//
// ═══════════════════════════════════════════════════════════════════════════════


// ─────────────────────────────────────────────────────────────────────────────
// UDTs — User-Defined Types (data structures)
// ─────────────────────────────────────────────────────────────────────────────
// "level" stores one VOB zone: its origin time, upper/lower price boundaries,
// midpoint, accumulated volume, plus the OHLC of the swing-origin bar (v10+).
// A zone with na fields has been invalidated.

type level
    int   indx    // Origin bar time (xloc.bar_time format). When the zone was born.
    float upper   // Upper price boundary of the zone.
    float lower   // Lower price boundary of the zone.
    float mid     // Midpoint price = average of upper and lower.
    float vol     // Total volume accumulated from the swing bar to the crossover bar.
    float o       // Origin (swing) bar open.  Captured at zone formation. v10+.
    float h       // Origin (swing) bar high.  Captured at zone formation. v10+.
    float l       // Origin (swing) bar low.   Captured at zone formation. v10+.
    float c       // Origin (swing) bar close. Captured at zone formation. v10+.

// "hist_entry" stores one historical zone/T3-fire event. Visual tables were
// removed in v10; the history-acquisition arrays remain for future consumers.
type hist_entry
    int   t       // Timestamp of the event.
    float vol     // Volume at the event bar.
    float pct     // Volume as percentage of total pool (zone events only).
    string date_s // Human-readable date string.


// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — Sensitivities
// ─────────────────────────────────────────────────────────────────────────────
// These control the EMA lengths for each of the 6 VOB engines.
// Higher value = longer EMA = slower to trigger = fewer but stronger zones.
// Lower value = shorter EMA = faster to trigger = more but weaker zones.
// Claude Code: these are the PRIMARY optimization targets per timeframe.

int sens_a = input.int(1900, "Sensitivity A (Highest — fewest, strongest zones)",  group = "Sensitivities", minval = 1)
int sens_b = input.int(1800, "Sensitivity B (second highest)",            group = "Sensitivities", minval = 1)
int sens_c = input.int(1700, "Sensitivity C (middle-high)",            group = "Sensitivities", minval = 1)
int sens_d = input.int(1600, "Sensitivity D (middle-low)",            group = "Sensitivities", minval = 1)
int sens_e = input.int(1500, "Sensitivity E (second lowest)",            group = "Sensitivities", minval = 1)
int sens_f = input.int(1400, "Sensitivity F (Lowest — most, weakest zones)",   group = "Sensitivities", minval = 1)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — T3 Signal Toggles (checkbox = plot + alert for T3 signals)
// ─────────────────────────────────────────────────────────────────────────────

bool show_nagasaki  = input.bool(true, "Nagasaki (All-Time High Volume)", group = "Nagasaki")

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — Zone Line + Marker Toggles
// ─────────────────────────────────────────────────────────────────────────────


// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — Signal Parameters
// ─────────────────────────────────────────────────────────────────────────────
// Claude Code: asym_threshold is reserved for future Tier 1 asymmetric signals.
// super_mult is the ACTIVE T3 signal threshold — dominant zone volume must
// exceed the opposing pool volume multiplied by this value.

float asym_threshold = input.float(50.0, "Tier 1 — Asymmetric Percent Threshold",
     minval = 0.1, step = 5,
     group = "Signal Parameters",
     tooltip = "Reserved for future Tier 1 asymmetric signals. T3 uses Super Mult only. No upper cap.")
float super_mult = input.float(0.5, "Tier 3 — Super Volume Multiplier",
     minval = 0.1, step = 0.1,
     group = "Signal Parameters",
     tooltip = "For T3 signals: dominant zone volume must exceed opposing pool times this multiplier. Higher = stricter = fewer signals. No upper cap.")

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — Cooldown
// ─────────────────────────────────────────────────────────────────────────────

int cooldown_bars = input.int(30, "Cooldown Bars", group = "Cooldown",
     minval = 0, step = 5,
     tooltip = "After a signal fires, suppress that SAME signal for this many bars. 0 = no cooldown. No upper cap.")

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — VLB Strict Ladder Detection (v10)
// ─────────────────────────────────────────────────────────────────────────────
// VLB requires the six zones to FORM in strict chronological order across
// bars (F → E → D → C → B → A), and at every step the new zone's price
// range must touch or sit above (bull) / below (bear) the prior zone.

bool show_vlb_bull = input.bool(true, "VLB Bull (strict F→A chronological + price-overlap)",
     group = "Detection — VLB Strict Ladder",
     tooltip = "Fires ONE plot on the bar where bullish zone-A completes the strict F→E→D→C→B→A chronological ladder. At every step the new zone's range must not be entirely below the prior zone (new.high >= prior.low). ANY bearish zone (any tier) or any wrong-tier bullish (including a fresh F mid-ladder) kills the in-progress window. After fire OR kill the window resets and waits for the next F.")
bool show_vlb_bear = input.bool(true, "VLB Bear (strict F→A chronological + price-overlap)",
     group = "Detection — VLB Strict Ladder",
     tooltip = "Mirror of VLB Bull. Fires on the bar where bearish zone-A completes the strict F→E→D→C→B→A chronological ladder. At every step the new zone's range must not be entirely above the prior zone (new.low <= prior.high). ANY bullish zone (any tier) or any wrong-tier bearish kills the in-progress window.")

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS — Multi-Zone Same-Candle Detection (v10 ADDITION)
// ─────────────────────────────────────────────────────────────────────────────
// Fires when 2 OR 3+ zone-formation visual plots (zA / zB / zC / zD / zE / zF)
// appear on the SAME candle. Counted off the same gated booleans that paint
// the existing zone-formation cross markers (fire_zb_* / fire_zs_*), so the
// multi-zone detection literally counts how many of those marker plots are
// visible on the bar. Mutually exclusive within direction: "Bull 2" fires when
// EXACTLY two bull tiers fired this bar; "Bull 3+" fires when THREE OR MORE
// bull tiers fired (so 4-, 5-, or 6-tier bars hit Bull 3+). Mirror for bear.
// Non-repainting (zone formation is barstate.isconfirmed inside f_vob) with
// 1:1 plot/alert parity (one shared boolean drives both).

bool show_multi_bull_2 = input.bool(true, "Multi-Zone Bull 2 (any 2 bull markers same candle)",
     group = "Detection — Multi-Zone Same Candle",
     tooltip = "Fires when EXACTLY 2 bullish zone-formation visual plots (zA / zB / zC / zD / zE / zF) appear on the same candle. Mutually exclusive with Multi-Zone Bull 3+.")
bool show_multi_bull_3 = input.bool(true, "Multi-Zone Bull 3+ (any 3 or more bull markers same candle)",
     group = "Detection — Multi-Zone Same Candle",
     tooltip = "Fires when 3 OR MORE bullish zone-formation visual plots appear on the same candle. Mutually exclusive with Multi-Zone Bull 2 (so 4-, 5-, or 6-tier same-candle bursts also hit this plot, not Bull 2).")
bool show_multi_bear_2 = input.bool(true, "Multi-Zone Bear 2 (any 2 bear markers same candle)",
     group = "Detection — Multi-Zone Same Candle",
     tooltip = "Mirror of Multi-Zone Bull 2 — fires when EXACTLY 2 bearish zone-formation visual plots appear on the same candle.")
bool show_multi_bear_3 = input.bool(true, "Multi-Zone Bear 3+ (any 3 or more bear markers same candle)",
     group = "Detection — Multi-Zone Same Candle",
     tooltip = "Mirror of Multi-Zone Bull 3+ — fires when 3 OR MORE bearish zone-formation visual plots appear on the same candle.")

// ─────────────────────────────────────────────────────────────────────────────
// 🔔 INPUTS — ALERTS SECTION (v11.2 — THE ALERT LAW)
// ─────────────────────────────────────────────────────────────────────────────
// LAW: an alert() fires IF AND ONLY IF its checkbox below is CHECKED and its
// dp criteria fire (confirmed bar + shared cooldown). These checkboxes are
// FULLY INDEPENDENT of every display toggle — hiding a plot never mutes its
// alert; showing a plot never forces one. Defaults: SINGULAR dp/vp = OFF;
// cluster / ladder / multi-dp-same-candle composites = ON.
// (alertcondition() entries are TV-native and opt-in per alert dialog; they
//  now read the raw signal lane, also display-independent.)
bool al_nagasaki = input.bool(true, "🔔 Nagasaki — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_vlb_bull = input.bool(true, "🔔 VLB Bull (strict F→A ladder) — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_vlb_bear = input.bool(true, "🔔 VLB Bear (strict F→A ladder) — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_mz_b2 = input.bool(true, "🔔 Multi-Zone Bull 2 — alert",  group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_mz_b3 = input.bool(true, "🔔 Multi-Zone Bull 3+ — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_mz_s2 = input.bool(true, "🔔 Multi-Zone Bear 2 — alert",  group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
