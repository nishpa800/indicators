// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 2 — MUTUALLY EXCLUSIVE OVERLAP ENGINE + LINE DRAWING (PRESERVED EXACTLY)
// ═══════════════════════════════════════════════════════════════════════════════

var array<line>     drawn_lines = array.new<line>()
var array<linefill> drawn_fills = array.new<linefill>()
var array<label>    drawn_tags  = array.new<label>()

if drawn_lines.size() > 0
    for i = 0 to drawn_lines.size() - 1
        line.delete(drawn_lines.get(i))
drawn_lines.clear()
if drawn_fills.size() > 0
    for i = 0 to drawn_fills.size() - 1
        linefill.delete(drawn_fills.get(i))
drawn_fills.clear()
if drawn_tags.size() > 0
    for i = 0 to drawn_tags.size() - 1
        label.delete(drawn_tags.get(i))
drawn_tags.clear()

var array<float> ovlp_bull_lo = array.new<float>()
var array<float> ovlp_bull_hi = array.new<float>()
var array<float> ovlp_bear_lo = array.new<float>()
var array<float> ovlp_bear_hi = array.new<float>()
ovlp_bull_lo.clear()
ovlp_bull_hi.clear()
ovlp_bear_lo.clear()
ovlp_bear_hi.clear()

f_count_overlaps(array<float> trk_lo, array<float> trk_hi, float zlo, float zhi) =>
    int count = 0
    if trk_lo.size() > 0
        for i = 0 to trk_lo.size() - 1
            if f_zones_overlap(trk_lo.get(i), trk_hi.get(i), zlo, zhi)
                count += 1
    count

f_draw_zone(int origin_time, float z_upper, float z_lower, float z_mid, color col, int priority) =>
    if priority == 0
        line lt = line.new(origin_time, z_upper, time, z_upper, xloc.bar_time, extend.right, col, line.style_solid, 1)
        line lb = line.new(origin_time, z_lower, time, z_lower, xloc.bar_time, extend.right, col, line.style_solid, 1)
        line lm = line.new(origin_time, z_mid,   time, z_mid,   xloc.bar_time, extend.right, color.new(col, mid_transp), line.style_dashed, 1)
        linefill lf = linefill.new(lt, lb, color.new(col, fill_transp))
        drawn_lines.push(lt)
        drawn_lines.push(lb)
        drawn_lines.push(lm)
        drawn_fills.push(lf)
    else if priority == 1
        line lm = line.new(origin_time, z_mid, time, z_mid, xloc.bar_time, extend.right, col, line.style_solid, 2)
        drawn_lines.push(lm)
    else if priority == 2
        line lm = line.new(origin_time, z_mid, time, z_mid, xloc.bar_time, extend.right, col, line.style_dotted, 2)
        drawn_lines.push(lm)
    else
        line lm = line.new(origin_time, z_mid, time, z_mid, xloc.bar_time, extend.right, col, line.style_dotted, 1)
        drawn_lines.push(lm)

f_process_zones(array<level> lvl_arr, array<float> trk_lo, array<float> trk_hi, color col, bool enabled, int sens_val) =>
    if enabled and lvl_arr.size() > 0
        for i = 0 to lvl_arr.size() - 1
            level l = lvl_arr.get(i)
            if not na(l.vol) and not na(l.upper) and not na(l.lower) and not na(l.indx)
                int olaps = f_count_overlaps(trk_lo, trk_hi, l.lower, l.upper)
                f_draw_zone(l.indx, l.upper, l.lower, l.mid, col, olaps)
                if show_sens_tags
                    drawn_tags.push(label.new(bar_index + sens_tag_off, l.mid, str.tostring(sens_val), xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_none, col, size.small))
                trk_lo.push(l.lower)
                trk_hi.push(l.upper)

f_process_zones(lower_a, ovlp_bull_lo, ovlp_bull_hi, col_bull_a, true, sens_a)
f_process_zones(lower_b, ovlp_bull_lo, ovlp_bull_hi, col_bull_b, true, sens_b)
f_process_zones(lower_c, ovlp_bull_lo, ovlp_bull_hi, col_bull_c, true, sens_c)
f_process_zones(lower_d, ovlp_bull_lo, ovlp_bull_hi, col_bull_d, true, sens_d)
f_process_zones(lower_e, ovlp_bull_lo, ovlp_bull_hi, col_bull_e, true, sens_e)
f_process_zones(lower_f, ovlp_bull_lo, ovlp_bull_hi, col_bull_f, true, sens_f)
f_process_zones(upper_a, ovlp_bear_lo, ovlp_bear_hi, col_bear_a, true, sens_a)
f_process_zones(upper_b, ovlp_bear_lo, ovlp_bear_hi, col_bear_b, true, sens_b)
f_process_zones(upper_c, ovlp_bear_lo, ovlp_bear_hi, col_bear_c, true, sens_c)
f_process_zones(upper_d, ovlp_bear_lo, ovlp_bear_hi, col_bear_d, true, sens_d)
f_process_zones(upper_e, ovlp_bear_lo, ovlp_bear_hi, col_bear_e, true, sens_e)
f_process_zones(upper_f, ovlp_bear_lo, ovlp_bear_hi, col_bear_f, true, sens_f)


// ═══════════════════════════════════════════════════════════════════════════════
// EMISSION LAYER — ZONE FORMATION log.info STREAM (pine_get_console channel)
// v11.4: REPLACES the label.new pane labels (REMOVED in totality — operator order:
// "no graphic-object pane labels, ever"). Identical payload plus zone geometry
// (ZLO/ZHI/BIRTH_T), zero graphic objects, gated by en_emission_logs.
// =============================================================================

f_emit_zoneform(bool fire, array<level> arr, string dir, string tier, int sens_val, float pool, float rsi_v, int sess_v, float slope_v) =>
    if en_emission_logs and fire and arr.size() > 0
        level nz = arr.last()
        if not na(nz.mid) and not na(nz.vol)
            log.info("{0}", "VOB_ZONEFORM|T:" + str.tostring(time) + "|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:" + dir + "|TIER:" + tier + "|SENS:" + str.tostring(sens_val) + "|ZVOL:" + f_fmt_vol(nz.vol) + "|ZVOL_RAW:" + str.tostring(math.round(nz.vol)) + "|POOL:" + str.tostring(math.round(pool)) + "|MID:" + str.tostring(nz.mid) + "|ZLO:" + str.tostring(nz.lower) + "|ZHI:" + str.tostring(nz.upper) + "|BIRTH_T:" + str.tostring(nz.indx) + "|RSI:" + str.tostring(math.round(rsi_v)) + "|SESS:" + str.tostring(sess_v) + "|SLOPE:" + str.tostring(math.round(slope_v * 10000) / 10000))

f_emit_zoneform(nzb_a, lower_a, "BULL", "A", sens_a, bpa, rsi_14, sess_bar_count, slope_ema_a)
f_emit_zoneform(nzs_a, upper_a, "BEAR", "A", sens_a, spa, rsi_14, sess_bar_count, slope_ema_a)
f_emit_zoneform(nzb_b, lower_b, "BULL", "B", sens_b, bpb, rsi_14, sess_bar_count, slope_ema_b)
f_emit_zoneform(nzs_b, upper_b, "BEAR", "B", sens_b, spb, rsi_14, sess_bar_count, slope_ema_b)
f_emit_zoneform(nzb_c, lower_c, "BULL", "C", sens_c, bpc, rsi_14, sess_bar_count, slope_ema_c)
f_emit_zoneform(nzs_c, upper_c, "BEAR", "C", sens_c, spc, rsi_14, sess_bar_count, slope_ema_c)
f_emit_zoneform(nzb_d, lower_d, "BULL", "D", sens_d, bpd, rsi_14, sess_bar_count, slope_ema_d)
f_emit_zoneform(nzs_d, upper_d, "BEAR", "D", sens_d, spd, rsi_14, sess_bar_count, slope_ema_d)
f_emit_zoneform(nzb_e, lower_e, "BULL", "E", sens_e, bpe, rsi_14, sess_bar_count, slope_ema_e)
f_emit_zoneform(nzs_e, upper_e, "BEAR", "E", sens_e, spe, rsi_14, sess_bar_count, slope_ema_e)
f_emit_zoneform(nzb_f, lower_f, "BULL", "F", sens_f, bpf, rsi_14, sess_bar_count, slope_ema_f)
f_emit_zoneform(nzs_f, upper_f, "BEAR", "F", sens_f, spf, rsi_14, sess_bar_count, slope_ema_f)


// ═══════════════════════════════════════════════════════════════════════════════
// EMISSION LAYER — BLOOMBERG-FORMAT ZONE AGGREGATOR ALERT + ALERTCONDITION
// ═══════════════════════════════════════════════════════════════════════════════

bool any_zone = sig_zb_a or sig_zs_a or sig_zb_b or sig_zs_b or sig_zb_c or sig_zs_c or sig_zb_d or sig_zs_d or sig_zb_e or sig_zs_e or sig_zb_f or sig_zs_f
// v11.9 KEEPER CUT: "Any Zone Formation" alertcondition REMOVED (calculator channel); any_zone bool retained for composites.

// v11.9 KEEPER CUT: Zone Formation aggregate alert REMOVED — calculator lane.


// ═══════════════════════════════════════════════════════════════════════════════
// EMISSION LAYER — log.info() STREAMING (pine_get_console channel)
// ═══════════════════════════════════════════════════════════════════════════════

if en_emission_logs and barstate.isconfirmed
    log.info("VOB_EMISSION|TICKER:{0}|TF:{1}|CLOSE:{2}|RSI:{3}|SESS:{4}|VOLRANK:{5}|VOL:{6}|ATHVOL:{7}|BULLZONES:{8}|BEARZONES:{9}|STKBULL:{10}|STKBEAR:{11}|GAPBULL:{12}|GAPBEAR:{13}|NRBULLDIST:{14}|NRBEARDIST:{15}|BPA:{16}|SPA:{17}|BPB:{18}|SPB:{19}|BPC:{20}|SPC:{21}|BPD:{22}|SPD:{23}|BPE:{24}|SPE:{25}|BPF:{26}|SPF:{27}|SLOPEA:{28}|SLOPEB:{29}|SLOPEC:{30}|SLOPED:{31}|SLOPEE:{32}|SLOPEF:{33}|T:{34}",
      syminfo.ticker, timeframe.period,
      str.tostring(close), str.tostring(math.round(rsi_14 * 100) / 100),
      str.tostring(sess_bar_count), str.tostring(math.round(vol_rank)),
      str.tostring(math.round(volume)), str.tostring(math.round(maxVolEver)),
      str.tostring(cnt_bull_all), str.tostring(cnt_bear_all),
      str.tostring(stk_bull), str.tostring(stk_bear),
      str.tostring(math.round(bull_gap * 100) / 100), str.tostring(math.round(bear_gap * 100) / 100),
      str.tostring(math.round(nearest_bull_dist * 100) / 100), str.tostring(math.round(nearest_bear_dist * 100) / 100),
      str.tostring(math.round(bpa)), str.tostring(math.round(spa)),
      str.tostring(math.round(bpb)), str.tostring(math.round(spb)),
      str.tostring(math.round(bpc)), str.tostring(math.round(spc)),
      str.tostring(math.round(bpd)), str.tostring(math.round(spd)),
      str.tostring(math.round(bpe)), str.tostring(math.round(spe)),
      str.tostring(math.round(bpf)), str.tostring(math.round(spf)),
      str.tostring(math.round(slope_ema_a * 10000) / 10000), str.tostring(math.round(slope_ema_b * 10000) / 10000),
      str.tostring(math.round(slope_ema_c * 10000) / 10000), str.tostring(math.round(slope_ema_d * 10000) / 10000),
      str.tostring(math.round(slope_ema_e * 10000) / 10000), str.tostring(math.round(slope_ema_f * 10000) / 10000), str.tostring(time))


// ═══════════════════════════════════════════════════════════════════════════════
// VLB STRICT LADDER DETECTION (v10) — bullish + bearish chronological F→A
// ═══════════════════════════════════════════════════════════════════════════════
// Requires the six zones to FORM in strict chronological order across bars,
// and at each step the new zone must touch or sit above (bull) / below (bear)
// the prior zone.
//
// BULL RULES (bear is the mirror):
//   1. Sequence:  F → E → D → C → B → A across bars (or same bar if multiple
//                 tiers form simultaneously, processed in F→A order).
//   2. Price:     at each step the new zone must satisfy new.high >= prior.low
//                 i.e. the new zone is NOT entirely below the prior one;
//                 fully-inside or fully-above both qualify.
//   3. Bearish kill: ANY bearish zone formation in ANY tier on a bar resets
//                 the in-progress bullish window; no new F can start on that
//                 same bar — the next F-start must be on a later bar.
//   4. Wrong-tier kill: a bullish zone whose tier does not match the expected
//                 next step (including a fresh F mid-ladder) kills the window.
//   5. Price-fail kill: the expected tier fires but new.high < prior.low.
//   6. Fire: on the bar where bullish A completes step 5→6 the detection
//            plotshape fires (one bar only) and an alert is emitted with
//            full per-tier OHLCV. Window then resets to wait for next F.
//
// All booleans drive both the plotshape AND the alert() in lockstep, gated by
// barstate.isconfirmed for non-repainting 1:1 visual/alert parity.

// ─── STATE ──────────────────────────────────────────────────────────────────
// vlb_*_state encodes "next expected tier":
//   0 = waiting for F  | 1 = waiting for E  | 2 = waiting for D
//   3 = waiting for C  | 4 = waiting for B  | 5 = waiting for A
// vlb_*_p_lo / p_hi store the most-recently-confirmed step's zone range.
var int   vlb_bull_state = 0
var float vlb_bull_p_lo  = na
var float vlb_bull_p_hi  = na
var int   vlb_bear_state = 0
var float vlb_bear_p_lo  = na
var float vlb_bear_p_hi  = na

// Per-step OHLCV snapshots — captured at each accepted step so the firing-bar
// alert reports the ORIGINAL OHLCV of the zone that triggered each step, even
// if that zone has since been invalidated by close-through.
var float vlb_bull_f_o = na, var float vlb_bull_f_h = na, var float vlb_bull_f_l = na, var float vlb_bull_f_c = na, var float vlb_bull_f_v = na
var float vlb_bull_e_o = na, var float vlb_bull_e_h = na, var float vlb_bull_e_l = na, var float vlb_bull_e_c = na, var float vlb_bull_e_v = na
var float vlb_bull_d_o = na, var float vlb_bull_d_h = na, var float vlb_bull_d_l = na, var float vlb_bull_d_c = na, var float vlb_bull_d_v = na
var float vlb_bull_c_o = na, var float vlb_bull_c_h = na, var float vlb_bull_c_l = na, var float vlb_bull_c_c = na, var float vlb_bull_c_v = na
var float vlb_bull_b_o = na, var float vlb_bull_b_h = na, var float vlb_bull_b_l = na, var float vlb_bull_b_c = na, var float vlb_bull_b_v = na
var float vlb_bull_a_o = na, var float vlb_bull_a_h = na, var float vlb_bull_a_l = na, var float vlb_bull_a_c = na, var float vlb_bull_a_v = na

var float vlb_bear_f_o = na, var float vlb_bear_f_h = na, var float vlb_bear_f_l = na, var float vlb_bear_f_c = na, var float vlb_bear_f_v = na
var float vlb_bear_e_o = na, var float vlb_bear_e_h = na, var float vlb_bear_e_l = na, var float vlb_bear_e_c = na, var float vlb_bear_e_v = na
var float vlb_bear_d_o = na, var float vlb_bear_d_h = na, var float vlb_bear_d_l = na, var float vlb_bear_d_c = na, var float vlb_bear_d_v = na
var float vlb_bear_c_o = na, var float vlb_bear_c_h = na, var float vlb_bear_c_l = na, var float vlb_bear_c_c = na, var float vlb_bear_c_v = na
var float vlb_bear_b_o = na, var float vlb_bear_b_h = na, var float vlb_bear_b_l = na, var float vlb_bear_b_c = na, var float vlb_bear_b_v = na
var float vlb_bear_a_o = na, var float vlb_bear_a_h = na, var float vlb_bear_a_l = na, var float vlb_bear_a_c = na, var float vlb_bear_a_v = na

// Last-fire bar tracking for cooldown parity.
var int last_vlb_b = na
var int last_vlb_r = na

// Fetch the just-pushed zone for a tier (the zone that formed this bar).
f_last_zone(array<level> arr) =>
    arr.size() > 0 ? arr.get(arr.size() - 1) : na

// ─── BULLISH LADDER PROCESSING ──────────────────────────────────────────────
bool vlb_bull_complete = false
bool any_bear_zone_bar = nzs_a or nzs_b or nzs_c or nzs_d or nzs_e or nzs_f
bool any_bull_zone_bar = nzb_a or nzb_b or nzb_c or nzb_d or nzb_e or nzb_f

if any_bear_zone_bar
    vlb_bull_state := 0
    vlb_bull_p_lo  := na
    vlb_bull_p_hi  := na
else if any_bull_zone_bar
    // F (expects state==0)
    if nzb_f
        if vlb_bull_state == 0
            level zf = f_last_zone(lower_f)
            vlb_bull_p_lo  := zf.lower
            vlb_bull_p_hi  := zf.upper
            vlb_bull_f_o   := zf.o
            vlb_bull_f_h   := zf.h
            vlb_bull_f_l   := zf.l
            vlb_bull_f_c   := zf.c
            vlb_bull_f_v   := zf.vol
            vlb_bull_state := 1
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // E (expects state==1)
    if nzb_e and vlb_bull_state > 0
        if vlb_bull_state == 1
            level ze = f_last_zone(lower_e)
            if ze.upper >= vlb_bull_p_lo
                vlb_bull_p_lo  := ze.lower
                vlb_bull_p_hi  := ze.upper
                vlb_bull_e_o   := ze.o
                vlb_bull_e_h   := ze.h
                vlb_bull_e_l   := ze.l
                vlb_bull_e_c   := ze.c
                vlb_bull_e_v   := ze.vol
                vlb_bull_state := 2
            else
                vlb_bull_state := 0
                vlb_bull_p_lo  := na
                vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // D (expects state==2)
    if nzb_d and vlb_bull_state > 0
        if vlb_bull_state == 2
            level zd = f_last_zone(lower_d)
            if zd.upper >= vlb_bull_p_lo
                vlb_bull_p_lo  := zd.lower
                vlb_bull_p_hi  := zd.upper
                vlb_bull_d_o   := zd.o
                vlb_bull_d_h   := zd.h
                vlb_bull_d_l   := zd.l
                vlb_bull_d_c   := zd.c
                vlb_bull_d_v   := zd.vol
                vlb_bull_state := 3
            else
                vlb_bull_state := 0
                vlb_bull_p_lo  := na
                vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // C (expects state==3)
    if nzb_c and vlb_bull_state > 0
        if vlb_bull_state == 3
            level zc = f_last_zone(lower_c)
            if zc.upper >= vlb_bull_p_lo
                vlb_bull_p_lo  := zc.lower
                vlb_bull_p_hi  := zc.upper
                vlb_bull_c_o   := zc.o
                vlb_bull_c_h   := zc.h
                vlb_bull_c_l   := zc.l
                vlb_bull_c_c   := zc.c
                vlb_bull_c_v   := zc.vol
                vlb_bull_state := 4
            else
                vlb_bull_state := 0
                vlb_bull_p_lo  := na
                vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // B (expects state==4)
    if nzb_b and vlb_bull_state > 0
        if vlb_bull_state == 4
            level zb = f_last_zone(lower_b)
            if zb.upper >= vlb_bull_p_lo
                vlb_bull_p_lo  := zb.lower
                vlb_bull_p_hi  := zb.upper
                vlb_bull_b_o   := zb.o
                vlb_bull_b_h   := zb.h
                vlb_bull_b_l   := zb.l
                vlb_bull_b_c   := zb.c
                vlb_bull_b_v   := zb.vol
                vlb_bull_state := 5
            else
                vlb_bull_state := 0
                vlb_bull_p_lo  := na
                vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
    // A (expects state==5) — ladder completion
    if nzb_a and vlb_bull_state > 0
        if vlb_bull_state == 5
            level za = f_last_zone(lower_a)
            if za.upper >= vlb_bull_p_lo
                vlb_bull_a_o      := za.o
                vlb_bull_a_h      := za.h
                vlb_bull_a_l      := za.l
                vlb_bull_a_c      := za.c
                vlb_bull_a_v      := za.vol
                vlb_bull_complete := true
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na
        else
            vlb_bull_state := 0
            vlb_bull_p_lo  := na
            vlb_bull_p_hi  := na

// ─── BEARISH LADDER PROCESSING (mirror — new.low <= prior.high) ─────────────
bool vlb_bear_complete = false

if any_bull_zone_bar
    vlb_bear_state := 0
    vlb_bear_p_lo  := na
    vlb_bear_p_hi  := na
else if any_bear_zone_bar
    if nzs_f
        if vlb_bear_state == 0
            level zf = f_last_zone(upper_f)
            vlb_bear_p_lo  := zf.lower
            vlb_bear_p_hi  := zf.upper
            vlb_bear_f_o   := zf.o
            vlb_bear_f_h   := zf.h
            vlb_bear_f_l   := zf.l
            vlb_bear_f_c   := zf.c
            vlb_bear_f_v   := zf.vol
            vlb_bear_state := 1
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_e and vlb_bear_state > 0
        if vlb_bear_state == 1
            level ze = f_last_zone(upper_e)
            if ze.lower <= vlb_bear_p_hi
                vlb_bear_p_lo  := ze.lower
                vlb_bear_p_hi  := ze.upper
                vlb_bear_e_o   := ze.o
                vlb_bear_e_h   := ze.h
                vlb_bear_e_l   := ze.l
                vlb_bear_e_c   := ze.c
                vlb_bear_e_v   := ze.vol
                vlb_bear_state := 2
            else
                vlb_bear_state := 0
                vlb_bear_p_lo  := na
                vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_d and vlb_bear_state > 0
        if vlb_bear_state == 2
            level zd = f_last_zone(upper_d)
            if zd.lower <= vlb_bear_p_hi
                vlb_bear_p_lo  := zd.lower
                vlb_bear_p_hi  := zd.upper
                vlb_bear_d_o   := zd.o
                vlb_bear_d_h   := zd.h
                vlb_bear_d_l   := zd.l
                vlb_bear_d_c   := zd.c
                vlb_bear_d_v   := zd.vol
                vlb_bear_state := 3
            else
                vlb_bear_state := 0
                vlb_bear_p_lo  := na
                vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_c and vlb_bear_state > 0
        if vlb_bear_state == 3
            level zc = f_last_zone(upper_c)
            if zc.lower <= vlb_bear_p_hi
                vlb_bear_p_lo  := zc.lower
                vlb_bear_p_hi  := zc.upper
                vlb_bear_c_o   := zc.o
                vlb_bear_c_h   := zc.h
                vlb_bear_c_l   := zc.l
                vlb_bear_c_c   := zc.c
                vlb_bear_c_v   := zc.vol
                vlb_bear_state := 4
            else
                vlb_bear_state := 0
                vlb_bear_p_lo  := na
                vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_b and vlb_bear_state > 0
        if vlb_bear_state == 4
            level zb = f_last_zone(upper_b)
            if zb.lower <= vlb_bear_p_hi
                vlb_bear_p_lo  := zb.lower
                vlb_bear_p_hi  := zb.upper
                vlb_bear_b_o   := zb.o
                vlb_bear_b_h   := zb.h
                vlb_bear_b_l   := zb.l
                vlb_bear_b_c   := zb.c
                vlb_bear_b_v   := zb.vol
                vlb_bear_state := 5
            else
                vlb_bear_state := 0
                vlb_bear_p_lo  := na
                vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
    if nzs_a and vlb_bear_state > 0
        if vlb_bear_state == 5
            level za = f_last_zone(upper_a)
            if za.lower <= vlb_bear_p_hi
                vlb_bear_a_o      := za.o
                vlb_bear_a_h      := za.h
                vlb_bear_a_l      := za.l
                vlb_bear_a_c      := za.c
                vlb_bear_a_v      := za.vol
                vlb_bear_complete := true
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na
        else
            vlb_bear_state := 0
            vlb_bear_p_lo  := na
            vlb_bear_p_hi  := na

// ─── GATING — barstate.isconfirmed + cooldown → 1:1 plot/alert parity ───────
bool sig_vlb_bull = vlb_bull_complete and barstate.isconfirmed and f_cd_ok(last_vlb_b, cooldown_bars)
bool sig_vlb_bear = vlb_bear_complete and barstate.isconfirmed and f_cd_ok(last_vlb_r, cooldown_bars)
bool plot_vlb_bull = show_vlb_bull and sig_vlb_bull
bool plot_vlb_bear = show_vlb_bear and sig_vlb_bear

if sig_vlb_bull
    last_vlb_b := bar_index
if sig_vlb_bear
    last_vlb_r := bar_index

// ─── VISUAL PLOTSHAPES (one bar only — exact zone-A completion bar) ─────────
// Bull: green up-triangle below the bar.  Bear: red down-triangle above the bar.
plotshape(plot_vlb_bull, "VLB Bull (strict F→A)", shape.triangleup,   location.belowbar, color.lime, size = size.normal, text = "VLB↑", textcolor = color.lime)
plotshape(plot_vlb_bear, "VLB Bear (strict F→A)", shape.triangledown, location.abovebar, color.red, size = size.normal, text = "VLB↓", textcolor = color.red)

// ─── ALERTCONDITION — single VLB consolidated channel ───────────────────────
alertcondition(sig_vlb_bull or sig_vlb_bear, "VLB Strict Ladder (v10)", "VOB v10 VLB strict-chronological-ladder detection fired — check alert() payload for direction, per-tier OHLCV, and market context")

// ─── BLOOMBERG-FORMAT ALERTS — 1:1 parity with plotshapes above ─────────────
// Schema: EVENT|TICKER|EXCHANGE|TF|DIR|CLOSE|SENS_A..F|
//         ZF_O|ZF_H|ZF_L|ZF_C|ZF_V| ... |ZA_O|ZA_H|ZA_L|ZA_C|ZA_V|
//         RSI|VOLRANK|SESS|BULLSTACK/BEARSTACK|BULLGAP/BEARGAP

f_vlb_fmt_p(float v) =>
    na(v) ? "na" : str.tostring(math.round(v * 100) / 100)
f_vlb_fmt_v(float v) =>
    na(v) ? "na" : str.tostring(math.round(v))

if al_vlb_bull and sig_vlb_bull
    string vsb = "SENS_A:" + str.tostring(sens_a) + "|SENS_B:" + str.tostring(sens_b) + "|SENS_C:" + str.tostring(sens_c) + "|SENS_D:" + str.tostring(sens_d) + "|SENS_E:" + str.tostring(sens_e) + "|SENS_F:" + str.tostring(sens_f)
    string zf = "ZF_O:" + f_vlb_fmt_p(vlb_bull_f_o) + "|ZF_H:" + f_vlb_fmt_p(vlb_bull_f_h) + "|ZF_L:" + f_vlb_fmt_p(vlb_bull_f_l) + "|ZF_C:" + f_vlb_fmt_p(vlb_bull_f_c) + "|ZF_V:" + f_vlb_fmt_v(vlb_bull_f_v)
    string ze = "ZE_O:" + f_vlb_fmt_p(vlb_bull_e_o) + "|ZE_H:" + f_vlb_fmt_p(vlb_bull_e_h) + "|ZE_L:" + f_vlb_fmt_p(vlb_bull_e_l) + "|ZE_C:" + f_vlb_fmt_p(vlb_bull_e_c) + "|ZE_V:" + f_vlb_fmt_v(vlb_bull_e_v)
    string zd = "ZD_O:" + f_vlb_fmt_p(vlb_bull_d_o) + "|ZD_H:" + f_vlb_fmt_p(vlb_bull_d_h) + "|ZD_L:" + f_vlb_fmt_p(vlb_bull_d_l) + "|ZD_C:" + f_vlb_fmt_p(vlb_bull_d_c) + "|ZD_V:" + f_vlb_fmt_v(vlb_bull_d_v)
    string zc = "ZC_O:" + f_vlb_fmt_p(vlb_bull_c_o) + "|ZC_H:" + f_vlb_fmt_p(vlb_bull_c_h) + "|ZC_L:" + f_vlb_fmt_p(vlb_bull_c_l) + "|ZC_C:" + f_vlb_fmt_p(vlb_bull_c_c) + "|ZC_V:" + f_vlb_fmt_v(vlb_bull_c_v)
    string zb = "ZB_O:" + f_vlb_fmt_p(vlb_bull_b_o) + "|ZB_H:" + f_vlb_fmt_p(vlb_bull_b_h) + "|ZB_L:" + f_vlb_fmt_p(vlb_bull_b_l) + "|ZB_C:" + f_vlb_fmt_p(vlb_bull_b_c) + "|ZB_V:" + f_vlb_fmt_v(vlb_bull_b_v)
    string za = "ZA_O:" + f_vlb_fmt_p(vlb_bull_a_o) + "|ZA_H:" + f_vlb_fmt_p(vlb_bull_a_h) + "|ZA_L:" + f_vlb_fmt_p(vlb_bull_a_l) + "|ZA_C:" + f_vlb_fmt_p(vlb_bull_a_c) + "|ZA_V:" + f_vlb_fmt_v(vlb_bull_a_v)
    string tail = "RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100)
    if en_emission_logs
        log.info("{0}", "VLB_BULL_DATA|T:" + str.tostring(time) + "|" + vsb + "|" + zf + "|" + ze + "|" + zd + "|" + zc + "|" + zb + "|" + za + "|" + tail)
    alert("VLB_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)

if al_vlb_bear and sig_vlb_bear
    string vsb = "SENS_A:" + str.tostring(sens_a) + "|SENS_B:" + str.tostring(sens_b) + "|SENS_C:" + str.tostring(sens_c) + "|SENS_D:" + str.tostring(sens_d) + "|SENS_E:" + str.tostring(sens_e) + "|SENS_F:" + str.tostring(sens_f)
    string zf = "ZF_O:" + f_vlb_fmt_p(vlb_bear_f_o) + "|ZF_H:" + f_vlb_fmt_p(vlb_bear_f_h) + "|ZF_L:" + f_vlb_fmt_p(vlb_bear_f_l) + "|ZF_C:" + f_vlb_fmt_p(vlb_bear_f_c) + "|ZF_V:" + f_vlb_fmt_v(vlb_bear_f_v)
    string ze = "ZE_O:" + f_vlb_fmt_p(vlb_bear_e_o) + "|ZE_H:" + f_vlb_fmt_p(vlb_bear_e_h) + "|ZE_L:" + f_vlb_fmt_p(vlb_bear_e_l) + "|ZE_C:" + f_vlb_fmt_p(vlb_bear_e_c) + "|ZE_V:" + f_vlb_fmt_v(vlb_bear_e_v)
    string zd = "ZD_O:" + f_vlb_fmt_p(vlb_bear_d_o) + "|ZD_H:" + f_vlb_fmt_p(vlb_bear_d_h) + "|ZD_L:" + f_vlb_fmt_p(vlb_bear_d_l) + "|ZD_C:" + f_vlb_fmt_p(vlb_bear_d_c) + "|ZD_V:" + f_vlb_fmt_v(vlb_bear_d_v)
    string zc = "ZC_O:" + f_vlb_fmt_p(vlb_bear_c_o) + "|ZC_H:" + f_vlb_fmt_p(vlb_bear_c_h) + "|ZC_L:" + f_vlb_fmt_p(vlb_bear_c_l) + "|ZC_C:" + f_vlb_fmt_p(vlb_bear_c_c) + "|ZC_V:" + f_vlb_fmt_v(vlb_bear_c_v)
    string zb = "ZB_O:" + f_vlb_fmt_p(vlb_bear_b_o) + "|ZB_H:" + f_vlb_fmt_p(vlb_bear_b_h) + "|ZB_L:" + f_vlb_fmt_p(vlb_bear_b_l) + "|ZB_C:" + f_vlb_fmt_p(vlb_bear_b_c) + "|ZB_V:" + f_vlb_fmt_v(vlb_bear_b_v)
    string za = "ZA_O:" + f_vlb_fmt_p(vlb_bear_a_o) + "|ZA_H:" + f_vlb_fmt_p(vlb_bear_a_h) + "|ZA_L:" + f_vlb_fmt_p(vlb_bear_a_l) + "|ZA_C:" + f_vlb_fmt_p(vlb_bear_a_c) + "|ZA_V:" + f_vlb_fmt_v(vlb_bear_a_v)
    string tail = "RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|SESS:" + str.tostring(sess_bar_count) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100)
    if en_emission_logs
        log.info("{0}", "VLB_BEAR_DATA|T:" + str.tostring(time) + "|" + vsb + "|" + zf + "|" + ze + "|" + zd + "|" + zc + "|" + zb + "|" + za + "|" + tail)
    alert("VLB_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// MULTI-ZONE SAME-CANDLE DETECTION (v10 ADDITION) — 4 new plots + alerts
// ═══════════════════════════════════════════════════════════════════════════════
// Fires when 2 or 3+ zone-formation visual plots (zA / zB / zC / zD / zE / zF)
// appear on the SAME candle, separately for bullish and bearish.
//
//   Bull 2  = exactly 2 bullish zone-formation markers on this bar
//   Bull 3+ = 3 or more bullish zone-formation markers on this bar
//   Bear 2  = exactly 2 bearish zone-formation markers on this bar
//   Bear 3+ = 3 or more bearish zone-formation markers on this bar
//
// Mutual exclusivity: within a direction, only one of {2, 3+} can fire per bar.
// Across directions, a bull and a bear multi-zone can co-fire on the same bar.
//
// 1:1 parity + non-repainting:
//   The detection counts off fire_zb_* / fire_zs_*, which are the same booleans
//   that drive the on-chart zA…zF cross markers. Those booleans are gated on
//   bar close (zone formation is inside f_vob's barstate.isconfirmed branch),
//   so they never paint and then disappear. The plotshapes and alert() calls
//   below all read from a single boolean per detection (plot_mz_*), so what
//   the eye sees on the chart matches exactly what arrives in the alert inbox.

// ─── COUNTS — how many zone-formation markers fired on this bar ─────────────
int mz_bull_cnt = (sig_zb_a ? 1 : 0) + (sig_zb_b ? 1 : 0) + (sig_zb_c ? 1 : 0) + (sig_zb_d ? 1 : 0) + (sig_zb_e ? 1 : 0) + (sig_zb_f ? 1 : 0)
int mz_bear_cnt = (sig_zs_a ? 1 : 0) + (sig_zs_b ? 1 : 0) + (sig_zs_c ? 1 : 0) + (sig_zs_d ? 1 : 0) + (sig_zs_e ? 1 : 0) + (sig_zs_f ? 1 : 0)

// ─── GATED DETECTION BOOLS — toggle + count + barstate.isconfirmed + cooldown
bool sig_mz_b2 = mz_bull_cnt == 2 and barstate.isconfirmed and f_cd_ok(last_mz_b2, cooldown_bars)
bool sig_mz_b3 = mz_bull_cnt >= 3 and barstate.isconfirmed and f_cd_ok(last_mz_b3, cooldown_bars)
bool sig_mz_s2 = mz_bear_cnt == 2 and barstate.isconfirmed and f_cd_ok(last_mz_s2, cooldown_bars)
bool sig_mz_s3 = mz_bear_cnt >= 3 and barstate.isconfirmed and f_cd_ok(last_mz_s3, cooldown_bars)
bool plot_mz_b2 = show_multi_bull_2 and sig_mz_b2
bool plot_mz_b3 = show_multi_bull_3 and sig_mz_b3
bool plot_mz_s2 = show_multi_bear_2 and sig_mz_s2
bool plot_mz_s3 = show_multi_bear_3 and sig_mz_s3

if sig_mz_b2
    last_mz_b2 := bar_index
if sig_mz_b3
    last_mz_b3 := bar_index
if sig_mz_s2
    last_mz_s2 := bar_index
if sig_mz_s3
    last_mz_s3 := bar_index

// ─── VISUAL PLOTSHAPES — 1:1 parity with detection bools ────────────────────
// Bull markers below bar, bear markers above bar. Square = 2-zone (lighter
// confluence), flag = 3+-zone (heavier confluence).
plotshape(plot_mz_b2, "Multi-Zone Bull 2 (same candle)",  shape.square, location.belowbar, color.lime, size = size.small,  text = "MZ2↑", textcolor = color.lime)
plotshape(plot_mz_b3, "Multi-Zone Bull 3+ (same candle)", shape.flag,   location.abovebar, color.lime, size = size.normal, text = "MZ3↑", textcolor = color.lime)
plotshape(plot_mz_s2, "Multi-Zone Bear 2 (same candle)",  shape.square, location.abovebar, color.red, size = size.small,  text = "MZ2↓", textcolor = color.red)
plotshape(plot_mz_s3, "Multi-Zone Bear 3+ (same candle)", shape.flag,   location.belowbar, color.red, size = size.normal, text = "MZ3↓", textcolor = color.red)

// ─── ALERTCONDITIONS — one per detection so each can be subscribed ──────────
alertcondition(sig_mz_b2, "Multi-Zone Bull 2 (same candle)",  "VOB v10 — exactly 2 bullish zone-formation visual plots on the same candle")
alertcondition(sig_mz_b3, "Multi-Zone Bull 3+ (same candle)", "VOB v10 — 3 or more bullish zone-formation visual plots on the same candle")
alertcondition(sig_mz_s2, "Multi-Zone Bear 2 (same candle)",  "VOB v10 — exactly 2 bearish zone-formation visual plots on the same candle")
alertcondition(sig_mz_s3, "Multi-Zone Bear 3+ (same candle)", "VOB v10 — 3 or more bearish zone-formation visual plots on the same candle")

// ─── BLOOMBERG-FORMAT ALERTS — 1:1 with plotshapes, includes which tiers ────
// Tier strings are built lazily inside the firing-side if-block to avoid
// per-bar string concatenation when no multi-zone is firing.

if (al_mz_b2 and sig_mz_b2) or (al_mz_b3 and sig_mz_b3)
    string tiers_b = ""
    if sig_zb_a
        tiers_b += "A(" + str.tostring(sens_a) + "),"
    if sig_zb_b
        tiers_b += "B(" + str.tostring(sens_b) + "),"
    if sig_zb_c
        tiers_b += "C(" + str.tostring(sens_c) + "),"
    if sig_zb_d
        tiers_b += "D(" + str.tostring(sens_d) + "),"
    if sig_zb_e
        tiers_b += "E(" + str.tostring(sens_e) + "),"
    if sig_zb_f
        tiers_b += "F(" + str.tostring(sens_f) + "),"
    if en_emission_logs
        log.info("{0}", "MZ_BULL_DATA|T:" + str.tostring(time) + "|COUNT:" + str.tostring(mz_bull_cnt) + "|TIERS:" + tiers_b + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100) + "|NRBULLDIST:" + str.tostring(math.round(nearest_bull_dist * 100) / 100))
    string mz_b_tail = "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|TIERS:" + tiers_b + bb_tail
    if al_mz_b2 and sig_mz_b2
        alert("MULTI_ZONE_BULL_2|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|COUNT:" + str.tostring(mz_bull_cnt) + mz_b_tail + bb_tail, alert.freq_once_per_bar_close)
    if al_mz_b3 and sig_mz_b3
        alert("MULTI_ZONE_BULL_3PLUS|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|COUNT:" + str.tostring(mz_bull_cnt) + mz_b_tail + bb_tail, alert.freq_once_per_bar_close)

if (al_mz_s2 and sig_mz_s2) or (al_mz_s3 and sig_mz_s3)
    string tiers_s = ""
    if sig_zs_a
        tiers_s += "A(" + str.tostring(sens_a) + "),"
    if sig_zs_b
        tiers_s += "B(" + str.tostring(sens_b) + "),"
    if sig_zs_c
        tiers_s += "C(" + str.tostring(sens_c) + "),"
    if sig_zs_d
        tiers_s += "D(" + str.tostring(sens_d) + "),"
    if sig_zs_e
        tiers_s += "E(" + str.tostring(sens_e) + "),"
    if sig_zs_f
        tiers_s += "F(" + str.tostring(sens_f) + "),"
    if en_emission_logs
        log.info("{0}", "MZ_BEAR_DATA|T:" + str.tostring(time) + "|COUNT:" + str.tostring(mz_bear_cnt) + "|TIERS:" + tiers_s + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100) + "|NRBEARDIST:" + str.tostring(math.round(nearest_bear_dist * 100) / 100))
    string mz_s_tail = "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|TIERS:" + tiers_s + bb_tail
    if al_mz_s2 and sig_mz_s2
        alert("MULTI_ZONE_BEAR_2|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|COUNT:" + str.tostring(mz_bear_cnt) + mz_s_tail + bb_tail, alert.freq_once_per_bar_close)
    if al_mz_s3 and sig_mz_s3
        alert("MULTI_ZONE_BEAR_3PLUS|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|COUNT:" + str.tostring(mz_bear_cnt) + mz_s_tail + bb_tail, alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// ███ v11 ADDITION — HW SINGLE v3 DETECTION ENGINE (EMBEDDED, READ-ONLY) ███
// ═══════════════════════════════════════════════════════════════════════════════
// This block is a READ-ONLY port of the detection logic from "Heavy Weapons
// Single v3" (HW Single v3). The standalone HW Single v3 indicator is NOT
// modified, replaced, or touched in any way — its math is replicated here only
// so this VOB indicator can know, on a given bar, whether ANY HW Single v3
// detection plot would have fired. All HW-Single visuals (plotshapes, info
// table, aggregated alert) are intentionally OMITTED — we keep only the boolean
// signals and collapse them into one master boolean: `hws_any`.
//
// Faithfulness notes:
//   • Signal math is transcribed verbatim from HW Single v3 (RVOL 0.56, Reg@Time
//     WTC/Hiroshima/Pentagon, Hybrid Momentum LONG/SHORT, Nagasaki, Displacement,
//     Sequences UU..DDDD, B2B, FAUNA, HV150..1000, HCT 15-combo, Pentagon specials).
//   • The per-plot visibility toggles (show_*) are dropped — a detection counts
//     toward `hws_any` whenever its SIGNAL + GATE fire, regardless of HW-Single
//     visibility. The numeric tuning inputs are exposed so they can be matched to
//     the live HW Single v3 settings per timeframe.
//   • Identifiers that collide with the VOB host (isNagasaki, vol, maxVol) are
//     renamed with an `hw_` prefix. Everything else keeps HW Single v3 names.
// ═══════════════════════════════════════════════════════════════════════════════

string GRP_HWS = "HW Single v3 Engine (embedded — read-only)"

// ── RVOL Bull/Bear ──
int   bb_avgLength = input.int(30, "HWS · RVOL Lookback",  minval=1, group=GRP_HWS)
int   bb_smaLength = input.int(20, "HWS · RVOL SMA Length", minval=1, group=GRP_HWS)
// ── Reg @ Time ──
string reg_anchorTimeframe = input.timeframe("", "HWS · Reg@Time Anchor (blank=chart)", group=GRP_HWS)
// TICK-FRIENDLY FIX (RE10023): blank anchor = chart TF; tick-based on tick charts → relativeVolume
// throws via timeframe.change(). Force "D" only on tick charts; time charts keep original behavior.
string reg_anchorSafe = ((reg_anchorTimeframe == "" and (str.endswith(timeframe.period, "T") or na(timeframe.in_seconds(timeframe.period)) or timeframe.in_seconds(timeframe.period) <= 0)) or str.endswith(reg_anchorTimeframe, "T")) ? "D" : reg_anchorTimeframe
int    reg_length          = input.int(30, "HWS · Reg@Time Length", minval=1, group=GRP_HWS)
string reg_calculationMode = input.string("Cumulative", "HWS · Reg@Time Mode", options=["Cumulative","Regular"], group=GRP_HWS)
bool   reg_adjustRealtime  = input.bool(true, "HWS · Reg@Time Adjust Unconfirmed", group=GRP_HWS)
// ── Hybrid regime % ──
int reg_pct  = input.int(62, "HWS · Reg Floor %",  minval=0, group=GRP_HWS)
int cum_pct  = input.int(62, "HWS · Cum Floor %",  minval=0, group=GRP_HWS)
int body_pct = input.int(80, "HWS · Body Ratio %", minval=0, group=GRP_HWS)
// ── Nagasaki ──
bool enableNagasaki = input.bool(true, "HWS · Enable Nagasaki", group=GRP_HWS)
// ── Sequence lower thresholds ──
float th_low_UU_DD     = input.float(2.0, "HWS · Seq Lower (UU/DD)",     step=0.1, minval=0.5, group=GRP_HWS)
float th_low_UUU_DDD   = input.float(2.0, "HWS · Seq Lower (UUU/DDD)",   step=0.1, minval=0.5, group=GRP_HWS)
float th_low_UUUU_DDDD = input.float(2.0, "HWS · Seq Lower (UUUU/DDDD)", step=0.1, minval=0.5, group=GRP_HWS)
// ── Displacement StdDev ──
string i_disp_type           = input.string("Open to Close", "HWS · Disp Range Type", options=['Open to Close','High to Low'], group=GRP_HWS)
int    i_std_len             = input.int(100, "HWS · Disp Std Dev Length", minval=1, group=GRP_HWS)
float  i_disp_std_standalone = input.float(7.0, "HWS · Disp Standalone σ", minval=0, step=0.1, group=GRP_HWS)
float  i_disp_std_cdisp2     = input.float(5.0, "HWS · Disp Consec2 σ",    minval=0, step=0.1, group=GRP_HWS)
float  i_disp_std_cdisp3     = input.float(3.0, "HWS · Disp Consec3 σ",    minval=0, step=0.1, group=GRP_HWS)
float  i_disp_std_seq        = input.float(5.0, "HWS · Disp Seq/FAUNA σ",  minval=0, step=0.1, group=GRP_HWS)
// ── HCT displacement ──
float hct_disp_strength = input.float(5.0, "HWS · HCT Disp σ", minval=1.0, step=0.5, group=GRP_HWS)
int   hct_disp_lookback = input.int(100, "HWS · HCT Disp Lookback", minval=10, group=GRP_HWS)
float hct_threshPct     = input.float(2, "HWS · HCT FVG Threshold %", minval=0, maxval=100, step=0.1, group=GRP_HWS)
bool  hct_auto          = input.bool(true, "HWS · HCT Auto FVG Threshold", group=GRP_HWS)

// ── Threshold ladder (verbatim) ──
// TICK-FRIENDLY GUARD: timeframe.in_seconds() returns na on tick resolutions (e.g. "10T");
// that na would poison the entire HWS threshold ladder. Fall back to an assumed seconds/bar.
int tick_assumed_tfsec = input.int(60, "TICK MODE · Assumed seconds/bar for HWS thresholds (used when timeframe.in_seconds is na on tick charts)", minval=1, group=GRP_HWS)
float hws_tfSec_raw = timeframe.in_seconds(timeframe.period)
float hws_tfSec = na(hws_tfSec_raw) or hws_tfSec_raw == 0 ? tick_assumed_tfsec : hws_tfSec_raw
f_rvol_1x_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10 ? 38.0 : s <= 15 ? 33.0 : s <= 30 ? 28.0 : s <= 45 ? 23.0 : s <= 60 ? 20.0 : s <= 120 ? 19.0 : s <= 180 ? 17.0 : s <= 240 ? 16.0 : s <= 300 ? 15.0 : s <= 360 ? 14.0 : s <= 420 ? 12.0 : s <= 480 ? 11.0 : s <= 540 ? 10.0 : s <= 600 ? 10.0 : s <= 900 ? 8.4 : s <= 1800 ? 6.9 : s <= 3600 ? 5.9 : s <= 7200 ? 3.0 : 1.8
    th
f_saab_kratos_threshold(_tfSec) => f_rvol_1x_threshold(_tfSec) * 0.56
f_gs_moab_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10 ? 114.0 : s <= 15 ? 99.0 : s <= 30 ? 84.0 : s <= 45 ? 69.0 : s <= 60 ? 35.0 : s <= 300 ? 35.0 : s <= 600 ? 25.0 : s <= 900 ? 20.0 : s <= 3600 ? 10.0 : 8.0
    th
f_wtc_threshold(_tfSec) => f_rvol_1x_threshold(_tfSec) * 2.0
f_hiroshima_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10 ? 114.0 : s <= 15 ? 99.0 : s <= 30 ? 84.0 : s <= 45 ? 69.0 : s <= 60 ? 35.0 : s <= 300 ? 35.0 : s <= 600 ? 25.0 : s <= 900 ? 20.0 : s <= 3600 ? 10.0 : 8.0
    th
th_saab_kratos = f_saab_kratos_threshold(hws_tfSec)
th_1x          = f_rvol_1x_threshold(hws_tfSec)
th_gs_moab     = f_gs_moab_threshold(hws_tfSec)
th_wtc         = f_wtc_threshold(hws_tfSec)
th_hiroshima   = f_hiroshima_threshold(hws_tfSec)

// ── Hybrid momentum auto-derive ──
hybAutoReg1 = th_hiroshima * 2.85
hybAutoReg5 = th_hiroshima * 1.1875
hybAutoStep = (hybAutoReg1 - hybAutoReg5) / 4.0
hybAutoReg2 = hybAutoReg1 - 1.0 * hybAutoStep
hybAutoReg3 = hybAutoReg1 - 2.0 * hybAutoStep
hybAutoReg4 = hybAutoReg1 - 3.0 * hybAutoStep
float hybCumPhi = 1.398 * 1.33
hybAutoCum1 = hybCumPhi * math.sqrt(math.log(hybAutoReg1))
hybAutoCum2 = hybCumPhi * math.sqrt(math.log(hybAutoReg2))
hybAutoCum3 = hybCumPhi * math.sqrt(math.log(hybAutoReg3))
hybAutoCum4 = hybCumPhi * math.sqrt(math.log(hybAutoReg4))
hybAutoCum5 = hybCumPhi * math.sqrt(math.log(hybAutoReg5))
float hybAutoBody1 = 0.69, float hybAutoBody2 = 0.72, float hybAutoBody3 = 0.75, float hybAutoBody4 = 0.78, float hybAutoBody5 = 0.81
float regMult  = reg_pct  / 100.0
float cumMult  = cum_pct  / 100.0
float bodyMult = body_pct / 100.0
hybReg1Eff = hybAutoReg1*regMult, hybReg2Eff = hybAutoReg2*regMult, hybReg3Eff = hybAutoReg3*regMult, hybReg4Eff = hybAutoReg4*regMult, hybReg5Eff = hybAutoReg5*regMult
hybCum1Eff = hybAutoCum1*cumMult, hybCum2Eff = hybAutoCum2*cumMult, hybCum3Eff = hybAutoCum3*cumMult, hybCum4Eff = hybAutoCum4*cumMult, hybCum5Eff = hybAutoCum5*cumMult
hybBody1Eff = hybAutoBody1*bodyMult, hybBody2Eff = hybAutoBody2*bodyMult, hybBody3Eff = hybAutoBody3*bodyMult, hybBody4Eff = hybAutoBody4*bodyMult, hybBody5Eff = hybAutoBody5*bodyMult

// ── RVOL Bull/Bear signals ──
bb_spike = math.abs(close - open)
bb_avgSpikeDenom = ta.sma(bb_spike, bb_avgLength)[1]
bb_normalizedPrice = bb_spike / nz(bb_avgSpikeDenom, 1.0)
bb_avgVolDenom = ta.sma(volume, bb_avgLength)[1]
bb_normalizedVolume = volume / nz(bb_avgVolDenom, 1.0)
bb_diff = bb_normalizedPrice - bb_normalizedVolume
bb_positiveDiff = bb_diff > 0 ? bb_diff : na
bb_smaDiff = ta.sma(bb_positiveDiff, bb_smaLength)
bb_baseBullish = (close > open) and (bb_positiveDiff > bb_smaDiff)
bb_baseBearish = (close < open) and (bb_positiveDiff > bb_smaDiff)
bb_inRange(v, lowTh, highTh) => v >= lowTh and v < highTh
conf = barstate.isconfirmed
sigSAAB       = conf and bb_baseBullish and bb_inRange(bb_normalizedPrice, th_saab_kratos, th_1x)
sigKratos     = conf and bb_baseBearish and bb_inRange(bb_normalizedPrice, th_saab_kratos, th_1x)
sigBullRVOL1x = conf and bb_baseBullish and bb_inRange(bb_normalizedPrice, th_1x, th_gs_moab)
sigBearRVOL1x = conf and bb_baseBearish and bb_inRange(bb_normalizedPrice, th_1x, th_gs_moab)
sigGrandSlam  = conf and bb_baseBullish and (bb_normalizedPrice >= th_gs_moab)
sigMOAB       = conf and bb_baseBearish and (bb_normalizedPrice >= th_gs_moab)

// ── Reg@Time WTC/Hiroshima/Pentagon ──
[currentVolume_reg, pastVolume_reg, _hwsReg] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, reg_calculationMode == "Cumulative", reg_adjustRealtime)
relVolRatio  = currentVolume_reg / pastVolume_reg
sigWTC       = conf and (relVolRatio > th_wtc) and (relVolRatio <= th_hiroshima)
sigHiroshima = conf and (relVolRatio > th_hiroshima)
sigPentagon  = conf and (relVolRatio >= th_1x) and (relVolRatio <= th_wtc)

// ── Hybrid momentum LONG/SHORT ──
[hybRegCur, hybRegPast, _hwsHr] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, false, reg_adjustRealtime)
[hybCumCur, hybCumPast, _hwsHc] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, true,  reg_adjustRealtime)
hybRegRatio = hybRegCur / hybRegPast
hybCumRatio = hybCumCur / hybCumPast
hybBodySz  = math.abs(close - open)
hybRange   = high - low
hybBodyRat = hybRange == 0 ? 0.0 : hybBodySz / hybRange
hybConvict1 = hybBodyRat >= hybBody1Eff
hybBull1 = (close > open) and hybConvict1
hybBear1 = (close < open) and hybConvict1
hybMom1 = conf and (hybRegRatio > hybReg1Eff) and (hybCumRatio > hybCum1Eff)
sigAddLong1  = hybMom1 and hybBull1
sigAddShort1 = hybMom1 and hybBear1
hybConvict2 = hybBodyRat >= hybBody2Eff
hybBull2 = (close > open) and hybConvict2
hybBear2 = (close < open) and hybConvict2
hybMom2 = conf and (hybRegRatio > hybReg2Eff) and (hybCumRatio > hybCum2Eff)
sigAddLong2  = hybMom2 and hybBull2
sigAddShort2 = hybMom2 and hybBear2
hybConvict3 = hybBodyRat >= hybBody3Eff
hybBull3 = (close > open) and hybConvict3
hybMom3 = conf and (hybRegRatio > hybReg3Eff) and (hybCumRatio > hybCum3Eff)
sigAddLong3  = hybMom3 and hybBull3
hybConvict4 = hybBodyRat >= hybBody4Eff
hybBull4 = (close > open) and hybConvict4
hybMom4 = conf and (hybRegRatio > hybReg4Eff) and (hybCumRatio > hybCum4Eff)
sigAddLong4  = hybMom4 and hybBull4
hybConvict5 = hybBodyRat >= hybBody5Eff
hybBull5 = (close > open) and hybConvict5
hybMom5 = conf and (hybRegRatio > hybReg5Eff) and (hybCumRatio > hybCum5Eff)
sigAddLong5  = hybMom5 and hybBull5

// ── Nagasaki (v11.10: ONE state — the HV-law engine maxVolEver above (bar[1] view isNagasaki); this is its bar[0] view,
//    conf-gated as before; same candle truth; the v11.9 hw-local running max + bar-0 seed are gone) ──
bool hw_isNagasaki = conf and volume > maxVolEver
sigNagasaki = enableNagasaki and hw_isNagasaki

// ── Gating helpers ──
anyLong  = sigAddLong1 or sigAddLong2 or sigAddLong3 or sigAddLong4 or sigAddLong5
anyShort = sigAddShort1 or sigAddShort2
anyMom   = anyLong or anyShort
anyLong_1 = sigAddLong1[1] or sigAddLong2[1] or sigAddLong3[1] or sigAddLong4[1] or sigAddLong5[1]
anyHV_cur = conf and (volume == ta.highest(volume, 150))

// ── HCT displacement engine ──
float hct_thresh     = hct_auto ? ta.cum((high - low) / low) / bar_index : hct_threshPct / 100
bool  hct_bFVG       = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > hct_thresh
bool  hct_sFVG       = high < low[2] and close[1] < low[2] and (low[2] - high) / high > hct_thresh
float hct_barRange   = high[1] - low[1]
float hct_rangeStdev = ta.stdev(high - low, hct_disp_lookback)
bool  hct_dispMet    = hct_barRange > hct_disp_strength * nz(hct_rangeStdev[1])
bool hct_dispBull = conf and hct_dispMet and (close[1] > open[1]) and hct_bFVG
bool hct_dispBear = conf and hct_dispMet and (close[1] < open[1]) and hct_sFVG
bool hct_noDisp   = not hct_dispBull and not hct_dispBear

// ── HCT 15-combo ──
bool groupA_Bull = sigBullRVOL1x or sigGrandSlam
bool groupA_Bear = sigBearRVOL1x or sigMOAB
bool groupB      = sigPentagon or sigWTC or sigHiroshima
bool baseYinYang   = (groupA_Bull or groupA_Bear) and groupB
bool baseNagasaki  = sigNagasaki and (groupA_Bull or groupA_Bear)
bool baseNagasakiV = sigNagasaki and groupB
bool baseTrident   = sigNagasaki and (groupA_Bull or groupA_Bear) and groupB
bool baseNHx2      = (sigPentagon and sigWTC) or (sigPentagon and sigHiroshima) or (sigWTC and sigHiroshima)
bool sigHYYBull  = baseYinYang   and hct_dispBull
bool sigHYYBear  = baseYinYang   and hct_dispBear
bool sigHNBull   = baseNagasaki  and hct_dispBull
bool sigHNBear   = baseNagasaki  and hct_dispBear
bool sigHNVBull  = baseNagasakiV and hct_dispBull
bool sigHNVBear  = baseNagasakiV and hct_dispBear
bool sigHTBull   = baseTrident   and hct_dispBull
bool sigHTBear   = baseTrident   and hct_dispBear
bool sigNHx2Bull = baseNHx2      and hct_dispBull
bool sigNHx2Bear = baseNHx2      and hct_dispBear
bool sigHYYNDBull  = baseYinYang   and hct_noDisp and groupA_Bull
bool sigHYYNDBear  = baseYinYang   and hct_noDisp and groupA_Bear
bool sigHNNDBull   = baseNagasaki  and hct_noDisp and groupA_Bull
bool sigHNNDBear   = baseNagasaki  and hct_noDisp and groupA_Bear
bool sigHNVNDBull  = baseNagasakiV and hct_noDisp and (close > open)
bool sigHNVNDBear  = baseNagasakiV and hct_noDisp and (close < open)
bool sigHTNDBull   = baseTrident   and hct_noDisp and groupA_Bull
bool sigHTNDBear   = baseTrident   and hct_noDisp and groupA_Bear
bool sigNHx2NDBull = baseNHx2      and hct_noDisp and (close > open)
bool sigNHx2NDBear = baseNHx2      and hct_noDisp and (close < open)
bool hctMasterBull = sigHYYBull or sigHNBull or sigHNVBull or sigHTBull or sigNHx2Bull or sigHYYNDBull or sigHNNDBull or sigHNVNDBull or sigHTNDBull or sigNHx2NDBull
bool hctMasterBear = sigHYYBear or sigHNBear or sigHNVBear or sigHTBear or sigNHx2Bear or sigHYYNDBear or sigHNNDBear or sigHNVNDBear or sigHTNDBear or sigNHx2NDBear
bool anySinglesRaw = sigSAAB or sigKratos or sigBullRVOL1x or sigBearRVOL1x or sigGrandSlam or sigMOAB or sigWTC or sigHiroshima or sigNagasaki or anyLong or anyShort
bool hctGatedBull  = hctMasterBull and anySinglesRaw
bool hctGatedBear  = hctMasterBear and anySinglesRaw

// ── Pentagon specials ──
bool pentDisp5     = (high - low) > nz(hct_rangeStdev) * 5.0
bool sigPentHV1K   = conf and sigPentagon and (volume == ta.highest(volume, 1000))
bool sigPentHV500D = conf and sigPentagon and (volume == ta.highest(volume, 500)) and pentDisp5

// ── Displacement engine ──
disp_isBullishFVG = low > high[2] and open[1] < close[1]
disp_isBearishFVG = high < low[2] and open[1] > close[1]
disp_candle_range = i_disp_type == "Open to Close" ? math.abs(open - close) : high - low
disp_std_dev = ta.stdev(disp_candle_range, i_std_len)
disp_th_standalone = disp_std_dev * i_disp_std_standalone
disp_th_cdisp2     = disp_std_dev * i_disp_std_cdisp2
disp_th_cdisp3     = disp_std_dev * i_disp_std_cdisp3
disp_th_seq        = disp_std_dev * i_disp_std_seq
disp_cur_seq = disp_candle_range > disp_th_seq
disp_cur_any = disp_cur_seq
b2b_gate = anyHV_cur or disp_cur_any
disp_prev_standalone = disp_candle_range[1] > disp_th_standalone[1]
sigDispBull = disp_prev_standalone and disp_isBullishFVG
sigDispBear = disp_prev_standalone and disp_isBearishFVG
disp_prev_c2 = disp_candle_range[1] > disp_th_cdisp2[1]
sigDispBull_c2 = disp_prev_c2 and disp_isBullishFVG
sigDispBear_c2 = disp_prev_c2 and disp_isBearishFVG
var int disp_bullStreak_c2 = 0
var int disp_bearStreak_c2 = 0
disp_bullStreak_c2 := sigDispBull_c2 ? disp_bullStreak_c2 + 1 : 0
disp_bearStreak_c2 := sigDispBear_c2 ? disp_bearStreak_c2 + 1 : 0
sigCDispBull2 = sigDispBull_c2 and disp_bullStreak_c2 >= 2
sigCDispBear2 = sigDispBear_c2 and disp_bearStreak_c2 >= 2
disp_prev_c3 = disp_candle_range[1] > disp_th_cdisp3[1]
sigDispBull_c3 = disp_prev_c3 and disp_isBullishFVG
sigDispBear_c3 = disp_prev_c3 and disp_isBearishFVG
var int disp_bullStreak_c3 = 0
var int disp_bearStreak_c3 = 0
disp_bullStreak_c3 := sigDispBull_c3 ? disp_bullStreak_c3 + 1 : 0
disp_bearStreak_c3 := sigDispBear_c3 ? disp_bearStreak_c3 + 1 : 0
sigCDispBull3 = sigDispBull_c3 and disp_bullStreak_c3 >= 3
sigCDispBear3 = sigDispBear_c3 and disp_bearStreak_c3 >= 3

// ── Sequences ──
is_u_bar_UU   = bb_baseBullish and bb_normalizedPrice > th_low_UU_DD
is_u_bar_UUU  = bb_baseBullish and bb_normalizedPrice > th_low_UUU_DDD
is_u_bar_UUUU = bb_baseBullish and bb_normalizedPrice > th_low_UUUU_DDDD
is_d_bar_DD   = bb_baseBearish and bb_normalizedPrice > th_low_UU_DD
is_d_bar_DDD  = bb_baseBearish and bb_normalizedPrice > th_low_UUU_DDD
is_d_bar_DDDD = bb_baseBearish and bb_normalizedPrice > th_low_UUUU_DDDD
var float bull_seq_sum_UU = 0.0
var int   bull_seq_len_UU = 0
var int   bull_disp_UU    = 0
var float bear_seq_sum_DD = 0.0
var int   bear_seq_len_DD = 0
var int   bear_disp_DD    = 0
if conf
    if is_u_bar_UU
        bull_seq_len_UU += 1
        bull_seq_sum_UU += bb_normalizedPrice
        bull_disp_UU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UU := 0
        bull_seq_sum_UU := 0.0
        bull_disp_UU    := 0
    if is_d_bar_DD
        bear_seq_len_DD += 1
        bear_seq_sum_DD += bb_normalizedPrice
        bear_disp_DD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DD := 0
        bear_seq_sum_DD := 0.0
        bear_disp_DD    := 0
var float bull_seq_sum_UUU = 0.0
var int   bull_seq_len_UUU = 0
var int   bull_disp_UUU    = 0
var float bear_seq_sum_DDD = 0.0
var int   bear_seq_len_DDD = 0
var int   bear_disp_DDD    = 0
if conf
    if is_u_bar_UUU
        bull_seq_len_UUU += 1
        bull_seq_sum_UUU += bb_normalizedPrice
        bull_disp_UUU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UUU := 0
        bull_seq_sum_UUU := 0.0
        bull_disp_UUU    := 0
    if is_d_bar_DDD
        bear_seq_len_DDD += 1
        bear_seq_sum_DDD += bb_normalizedPrice
        bear_disp_DDD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DDD := 0
        bear_seq_sum_DDD := 0.0
        bear_disp_DDD    := 0
var float bull_seq_sum_UUUU = 0.0
var int   bull_seq_len_UUUU = 0
var int   bull_disp_UUUU    = 0
var float bear_seq_sum_DDDD = 0.0
var int   bear_seq_len_DDDD = 0
var int   bear_disp_DDDD    = 0
if conf
    if is_u_bar_UUUU
        bull_seq_len_UUUU += 1
        bull_seq_sum_UUUU += bb_normalizedPrice
        bull_disp_UUUU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UUUU := 0
        bull_seq_sum_UUUU := 0.0
        bull_disp_UUUU    := 0
    if is_d_bar_DDDD
        bear_seq_len_DDDD += 1
        bear_seq_sum_DDDD += bb_normalizedPrice
        bear_disp_DDDD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DDDD := 0
        bear_seq_sum_DDDD := 0.0
        bear_disp_DDDD    := 0
sig_bull_UU = conf and bull_seq_len_UU == 2 and bull_seq_sum_UU >= th_saab_kratos and bull_disp_UU >= 1
sig_bear_DD = conf and bear_seq_len_DD == 2 and bear_seq_sum_DD >= th_saab_kratos and bear_disp_DD >= 1
bool uu3_base     = conf and bull_seq_len_UUU == 3
bool uu3_override = uu3_base and bull_disp_UUU >= 2
bool uu3_normal   = uu3_base and bull_disp_UUU >= 1 and bull_seq_sum_UUU >= th_saab_kratos
sig_bull_UUU = uu3_override or uu3_normal
bool dd3_base     = conf and bear_seq_len_DDD == 3
bool dd3_override = dd3_base and bear_disp_DDD >= 2
bool dd3_normal   = dd3_base and bear_disp_DDD >= 1 and bear_seq_sum_DDD >= th_saab_kratos
sig_bear_DDD = dd3_override or dd3_normal
bool uu4_base     = conf and bull_seq_len_UUUU == 4
bool uu4_override = uu4_base and bull_disp_UUUU >= 2
bool uu4_normal   = uu4_base and bull_disp_UUUU >= 1 and bull_seq_sum_UUUU >= th_saab_kratos
sig_bull_UUUU = uu4_override or uu4_normal
bool dd4_base     = conf and bear_seq_len_DDDD == 4
bool dd4_override = dd4_base and bear_disp_DDDD >= 2
bool dd4_normal   = dd4_base and bear_disp_DDDD >= 1 and bear_seq_sum_DDDD >= th_saab_kratos
sig_bear_DDDD = dd4_override or dd4_normal

// ── B2B ──
sig_B2B_2xSAAB   = conf and sigSAAB[1]      and sigSAAB       and b2b_gate
sig_B2B_2xKratos = conf and sigKratos[1]     and sigKratos     and b2b_gate
sig_B2B_2xBull1x = conf and sigBullRVOL1x[1] and sigBullRVOL1x and b2b_gate
sig_B2B_2xBear1x = conf and sigBearRVOL1x[1] and sigBearRVOL1x and b2b_gate
sig_B2B_MidBull = conf and not sig_B2B_2xSAAB   and not sig_B2B_2xBull1x and ((sigSAAB[1] and sigBullRVOL1x) or (sigBullRVOL1x[1] and sigSAAB)) and b2b_gate
sig_B2B_MidBear = conf and not sig_B2B_2xKratos and not sig_B2B_2xBear1x and ((sigKratos[1] and sigBearRVOL1x) or (sigBearRVOL1x[1] and sigKratos)) and b2b_gate

// ── FAUNA (pattern booleans only; text ladder dropped — hws_any needs presence) ──
float fn_alpha_MB=1.6, float fn_beta_MB=0.70, float fn_delta_MB=1.8
int fn_atr_MB=14, int fn_vol_MB=20
float fn_gamma_RE=2.2, float fn_epsilon_RE=0.15, float fn_delta_RE=1.8, int fn_atr_RE=14
float fn_zeta_GG=0.9, float fn_delta_GG=1.8, int fn_atr_GG=14
float fn_theta_TA=1.6, float fn_delta_TA=1.8, int fn_trend_ma_len=50, int fn_avg_delta_len=10, int fn_atr_TA=14
float fn_alpha_SB=1.5, float fn_weak_ratio=0.2, int fn_body_avg=20, int fn_range_avg=20
fn_ATR      = ta.atr(fn_atr_MB)
fn_AvgVol   = ta.sma(volume, fn_vol_MB)
fn_AvgBody  = ta.sma(math.abs(close - open), fn_body_avg)
fn_AvgDelta = ta.sma(math.abs(close - close[1]), fn_avg_delta_len)
fn_TrendMA  = ta.sma(close, fn_trend_ma_len)
fn_body        = close - open
fn_candleRange = high - low
fn_body_up     = fn_body > 0
fn_body_dn     = fn_body < 0
fn_body_size   = math.abs(fn_body)
fn_body_ratio  = fn_candleRange == 0 ? 0.0 : fn_body_size / fn_candleRange
fn_MB_bull = fn_body_up and fn_body_size > fn_alpha_MB * fn_ATR and fn_body_ratio > fn_beta_MB and volume > fn_delta_MB * fn_AvgVol
fn_MB_bear = fn_body_dn and fn_body_size > fn_alpha_MB * fn_ATR and fn_body_ratio > fn_beta_MB and volume > fn_delta_MB * fn_AvgVol
fn_wide    = fn_candleRange > fn_gamma_RE * ta.atr(fn_atr_RE)
fn_RE_bull = fn_body_up and fn_wide and (high - close) < fn_epsilon_RE * fn_candleRange and volume > fn_delta_RE * fn_AvgVol
fn_RE_bear = fn_body_dn and fn_wide and (close - low) < fn_epsilon_RE * fn_candleRange and volume > fn_delta_RE * fn_AvgVol
fn_GG_bull = (open - close[1]) > fn_zeta_GG * ta.atr(fn_atr_GG) and fn_body_up and low > close[1] and volume > fn_delta_GG * fn_AvgVol
fn_GG_bear = (close[1] - open) > fn_zeta_GG * ta.atr(fn_atr_GG) and fn_body_dn and high < close[1] and volume > fn_delta_GG * fn_AvgVol
fn_up_trend = fn_TrendMA > fn_TrendMA[1]
fn_dn_trend = fn_TrendMA < fn_TrendMA[1]
fn_TA_bull = fn_up_trend and fn_body_up and (close - close[1]) > fn_theta_TA * fn_AvgDelta and volume > fn_delta_TA * fn_AvgVol
fn_TA_bear = fn_dn_trend and fn_body_dn and (close[1] - close) > fn_theta_TA * fn_AvgDelta and volume > fn_delta_TA * fn_AvgVol
fn_prev_body  = close[1] - open[1]
fn_prev_range = high[1] - low[1]
fn_StrongBear_pre = close[1] < open[1] and math.abs(fn_prev_body) > fn_alpha_SB * fn_AvgBody[1] and volume[1] > 1.5 * fn_AvgVol[1]
fn_WeakBear_pre   = close[1] < open[1] and (fn_prev_range == 0 ? 0.0 : math.abs(fn_prev_body) / fn_prev_range) <= fn_weak_ratio
fn_StrongBull_pre = close[1] > open[1] and math.abs(fn_prev_body) > fn_alpha_SB * fn_AvgBody[1] and volume[1] > 1.5 * fn_AvgVol[1]
fn_WeakBull_pre   = close[1] > open[1] and (fn_prev_range == 0 ? 0.0 : math.abs(fn_prev_body) / fn_prev_range) <= fn_weak_ratio
fn_TR_bull  = fn_WeakBear_pre   and (fn_MB_bull or fn_RE_bull or fn_TA_bull)
fn_ES_bull  = fn_StrongBear_pre and (fn_MB_bull or fn_RE_bull or fn_TA_bull)
fn_GDR_bull = close[1] < open[1] and fn_GG_bull
fn_TR_bear  = fn_WeakBull_pre   and (fn_MB_bear or fn_RE_bear or fn_TA_bear)
fn_ES_bear  = fn_StrongBull_pre and (fn_MB_bear or fn_RE_bear or fn_TA_bear)
fn_GDR_bear = close[1] > open[1] and fn_GG_bear
fn_anyBull = fn_MB_bull or fn_RE_bull or fn_GG_bull or fn_TA_bull or fn_TR_bull or fn_ES_bull or fn_GDR_bull
fn_anyBear = fn_MB_bear or fn_RE_bear or fn_GG_bear or fn_TA_bear or fn_TR_bear or fn_ES_bear or fn_GDR_bear
fn_bullActive = fn_anyBull and conf and disp_cur_seq and anyLong
fn_bearActive = fn_anyBear and conf and disp_cur_seq and anyShort

// ── HV 150..1000 (gated +LONG[1]) ──
bool is150Bar  = volume[1] == ta.highest(volume, 150)[1]
bool is250Bar  = volume[1] == ta.highest(volume, 250)[1]
bool is350Bar  = volume[1] == ta.highest(volume, 350)[1]
bool is500Bar  = volume[1] == ta.highest(volume, 500)[1]
bool is1000Bar = volume[1] == ta.highest(volume, 1000)[1]
bool raw_HV1000 = is1000Bar
bool raw_HV500  = is500Bar  and not is1000Bar
bool raw_HV350  = is350Bar  and not is500Bar and not is1000Bar
bool raw_HV250  = is250Bar  and not is350Bar and not is500Bar and not is1000Bar
bool raw_HV150  = is150Bar  and not is250Bar and not is350Bar and not is500Bar and not is1000Bar
bool plot_HV1000 = raw_HV1000 and anyLong_1
bool plot_HV500  = raw_HV500  and anyLong_1
bool plot_HV350  = raw_HV350  and anyLong_1
bool plot_HV250  = raw_HV250  and anyLong_1
bool plot_HV150  = raw_HV150  and anyLong_1

// ═══════════════════════════════════════════════════════════════════════════════
// MASTER HW-SINGLE-v3 BOOLEAN — fires if ANY HW Single v3 detection plot would fire
// ═══════════════════════════════════════════════════════════════════════════════
bool hws_bull = (sigSAAB and anyLong) or (sigBullRVOL1x and anyLong) or (sigGrandSlam and anyLong) or sig_bull_UU or sig_bull_UUU or sig_bull_UUUU or sig_B2B_2xSAAB or sig_B2B_2xBull1x or sig_B2B_MidBull or fn_bullActive or sigDispBull or sigCDispBull2 or sigCDispBull3 or sigAddLong1 or sigAddLong2 or sigAddLong3 or sigAddLong4 or sigAddLong5 or plot_HV150 or plot_HV250 or plot_HV350 or plot_HV500 or plot_HV1000 or hctGatedBull
bool hws_bear = (sigKratos and anyShort) or (sigBearRVOL1x and anyShort) or (sigMOAB and anyShort) or sig_bear_DD or sig_bear_DDD or sig_bear_DDDD or sig_B2B_2xKratos or sig_B2B_2xBear1x or sig_B2B_MidBear or fn_bearActive or sigDispBear or sigCDispBear2 or sigCDispBear3 or sigAddShort1 or sigAddShort2 or hctGatedBear
bool hws_neutral = (sigWTC and anyMom) or (sigHiroshima and anyMom) or (sigNagasaki and anyMom) or sigPentHV1K or sigPentHV500D
bool hws_any = hws_bull or hws_bear or hws_neutral


// ═══════════════════════════════════════════════════════════════════════════════
// T3 SAME-CANDLE TIER COUNTS — feed the SIDE-TYPED clusters (v11.6)
// ═══════════════════════════════════════════════════════════════════════════════
// v11.6 AGNOSTIC-LANE KILL (operator order 2026-07-24): the direction-AGNOSTIC
// T3 Cluster dp/vp/alertcondition/alert is REMOVED IN TOTALITY. REDUNDANCY
// THEOREM: it fired only when tc_bull_cnt + tc_bear_cnt >= 2, i.e. only when
// >= 2 sided T3 sig lanes were true on the SAME candle — each already a
// directional dp/vp with its own plot, alertcondition and alert. A derived
// disjunction carries zero information its sided constituents do not. Mixed
// bull+bear pairs stay visible as their two sided T3 markers and are named
// T3_CLUSTER_MIXED in the NAG+ANY ANY: payload (side-typed vocabulary).
int tc_bull_cnt = (sig_t3_buy_a?1:0)+(sig_t3_buy_b?1:0)+(sig_t3_buy_c?1:0)+(sig_t3_buy_d?1:0)+(sig_t3_buy_e?1:0)+(sig_t3_buy_f?1:0)
int tc_bear_cnt = (sig_t3_sell_a?1:0)+(sig_t3_sell_b?1:0)+(sig_t3_sell_c?1:0)+(sig_t3_sell_d?1:0)+(sig_t3_sell_e?1:0)+(sig_t3_sell_f?1:0)


// ═══════════════════════════════════════════════════════════════════════════════
// v11.6 AGNOSTIC-LANE KILL: the direction-AGNOSTIC VOB × HW-Single lane is
// REMOVED IN TOTALITY (operator order 2026-07-24). REDUNDANCY THEOREM:
// sig agnostic == (bull constituents OR bear constituents) AND hws_any —
// exactly the disjunction of the side-typed Bull/Bear coincidence lanes below
// (side carried by the VOB constituent, E-1). Every agnostic fire candle
// ALWAYS carried its directional dp/vp by boolean construction.
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// v11.9 KEEPER CUT: 12 individual zone-formation alerts REMOVED — zone formations are calculators; they still compute and feed MZ counts, VLB, and every +ANY companion list.


// ═══════════════════════════════════════════════════════════════════════════════
// ███ v11.2 ADDITION #1 — SIDE-TYPED T3 CLUSTER (dedicated Bull VP + Bear VP) ███
// ═══════════════════════════════════════════════════════════════════════════════
// Bull = 2+ BULL T3 tiers on one candle; Bear = 2+ BEAR T3 tiers. v11.2: counted
// off the SIG lanes (raw + cooldown) so hiding individual T3 displays never
// starves the cluster. Display tap show_* / alert tap al_* fully independent.

bool show_tc_cluster_bull = input.bool(true, "T3 Cluster Bull (2+ bull T3 same candle)",
     group = "Detection — v11.2 New",
     tooltip = "Fires when 2 or more BULL T3 tiers (T3a..T3f Buy) fire on the same candle. Counted from raw T3 signals — individual display checkboxes do not affect it. Alert has its own 🔔 checkbox.")
bool show_tc_cluster_bear = input.bool(true, "T3 Cluster Bear (2+ bear T3 same candle)",
     group = "Detection — v11.2 New",
     tooltip = "Fires when 2 or more BEAR T3 tiers (T3a..T3f Sell) fire on the same candle. Counted from raw T3 signals — individual display checkboxes do not affect it. Alert has its own 🔔 checkbox.")

var int last_tc_cluster_bull = na
var int last_tc_cluster_bear = na
bool sig_tc_cluster_bull = tc_bull_cnt >= 2 and barstate.isconfirmed and f_cd_ok(last_tc_cluster_bull, cooldown_bars)
bool sig_tc_cluster_bear = tc_bear_cnt >= 2 and barstate.isconfirmed and f_cd_ok(last_tc_cluster_bear, cooldown_bars)
bool plot_tc_cluster_bull = show_tc_cluster_bull and sig_tc_cluster_bull
bool plot_tc_cluster_bear = show_tc_cluster_bear and sig_tc_cluster_bear
if sig_tc_cluster_bull
    last_tc_cluster_bull := bar_index
if sig_tc_cluster_bear
    last_tc_cluster_bear := bar_index

plotshape(plot_tc_cluster_bull, "T3 Cluster Bull (2+ bull T3 same candle)", shape.flag, location.belowbar, color.lime, size = size.normal, text = "T3x↑", textcolor = color.lime)
plotshape(plot_tc_cluster_bear, "T3 Cluster Bear (2+ bear T3 same candle)", shape.flag, location.abovebar, color.red, size = size.normal, text = "T3x↓", textcolor = color.red)
alertcondition(sig_tc_cluster_bull, "T3 Cluster Bull (2+ bull T3 same candle)", "VOB v11.2 — 2 or more BULL T3 tiers fired on the same candle")
alertcondition(sig_tc_cluster_bear, "T3 Cluster Bear (2+ bear T3 same candle)", "VOB v11.2 — 2 or more BEAR T3 tiers fired on the same candle")

if al_tc_cluster_bull and sig_tc_cluster_bull
    string tcb_tiers = (sig_t3_buy_a ? "A(" + str.tostring(sens_a) + ")," : "") + (sig_t3_buy_b ? "B(" + str.tostring(sens_b) + ")," : "") + (sig_t3_buy_c ? "C(" + str.tostring(sens_c) + ")," : "") + (sig_t3_buy_d ? "D(" + str.tostring(sens_d) + ")," : "") + (sig_t3_buy_e ? "E(" + str.tostring(sens_e) + ")," : "") + (sig_t3_buy_f ? "F(" + str.tostring(sens_f) + ")," : "")
    alert("T3_CLUSTER_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|COUNT:" + str.tostring(tc_bull_cnt) + "|TIERS:" + tcb_tiers + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_tc_cluster_bear and sig_tc_cluster_bear
    string tcs_tiers = (sig_t3_sell_a ? "A(" + str.tostring(sens_a) + ")," : "") + (sig_t3_sell_b ? "B(" + str.tostring(sens_b) + ")," : "") + (sig_t3_sell_c ? "C(" + str.tostring(sens_c) + ")," : "") + (sig_t3_sell_d ? "D(" + str.tostring(sens_d) + ")," : "") + (sig_t3_sell_e ? "E(" + str.tostring(sens_e) + ")," : "") + (sig_t3_sell_f ? "F(" + str.tostring(sens_f) + ")," : "")
    alert("T3_CLUSTER_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|COUNT:" + str.tostring(tc_bear_cnt) + "|TIERS:" + tcs_tiers + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// ███ v11.2 ADDITION #2 — SIDE-TYPED VOB × HW-SINGLE COINCIDENCE (Bull / Bear) ███
// ═══════════════════════════════════════════════════════════════════════════════
// Side carried by the VOB constituent (E-1). v11.2: constituents read the SIG
// lanes — display checkboxes never starve the coincidence. HWS side disclosed.

bool show_vobhws_bull = input.bool(true, "VOB × HW-Single Coincidence Bull (bull T3/zone + any HWS)",
     group = "Detection — v11.2 New",
     tooltip = "BULL VOB signal (any T3a..T3f Buy or bull zone formation, raw signal lane) + ANY HW Single v3 detection on the same candle. Alert has its own 🔔 checkbox.")
bool show_vobhws_bear = input.bool(true, "VOB × HW-Single Coincidence Bear (bear T3/zone + any HWS)",
     group = "Detection — v11.2 New",
     tooltip = "BEAR VOB signal (any T3a..T3f Sell or bear zone formation, raw signal lane) + ANY HW Single v3 detection on the same candle. Alert has its own 🔔 checkbox.")

bool vobhws_bull_left = sig_t3_buy_a or sig_t3_buy_b or sig_t3_buy_c or sig_t3_buy_d or sig_t3_buy_e or sig_t3_buy_f or sig_zb_a or sig_zb_b or sig_zb_c or sig_zb_d or sig_zb_e or sig_zb_f
bool vobhws_bear_left = sig_t3_sell_a or sig_t3_sell_b or sig_t3_sell_c or sig_t3_sell_d or sig_t3_sell_e or sig_t3_sell_f or sig_zs_a or sig_zs_b or sig_zs_c or sig_zs_d or sig_zs_e or sig_zs_f
var int last_vobhws_bull = na
var int last_vobhws_bear = na
bool sig_vobhws_bull = vobhws_bull_left and hws_any and barstate.isconfirmed and f_cd_ok(last_vobhws_bull, cooldown_bars)
bool sig_vobhws_bear = vobhws_bear_left and hws_any and barstate.isconfirmed and f_cd_ok(last_vobhws_bear, cooldown_bars)
bool plot_vobhws_bull = show_vobhws_bull and sig_vobhws_bull
bool plot_vobhws_bear = show_vobhws_bear and sig_vobhws_bear
if sig_vobhws_bull
    last_vobhws_bull := bar_index
if sig_vobhws_bear
    last_vobhws_bear := bar_index

plotshape(plot_vobhws_bull, "VOB × HW-Single Coincidence Bull", shape.labelup,   location.belowbar, #00C853, size = size.normal, text = "V×HW↑", textcolor = color.white)
plotshape(plot_vobhws_bear, "VOB × HW-Single Coincidence Bear", shape.labeldown, location.abovebar, #D50000, size = size.normal, text = "V×HW↓", textcolor = color.white)
alertcondition(sig_vobhws_bull, "VOB × HW-Single Coincidence Bull", "VOB v11.2 — BULL VOB T3/zone coincides with any HW Single v3 detection on the same candle")
alertcondition(sig_vobhws_bear, "VOB × HW-Single Coincidence Bear", "VOB v11.2 — BEAR VOB T3/zone coincides with any HW Single v3 detection on the same candle")

if al_vobhws_bull and sig_vobhws_bull
    string vhb_src = ((sig_t3_buy_a or sig_t3_buy_b or sig_t3_buy_c or sig_t3_buy_d or sig_t3_buy_e or sig_t3_buy_f) ? "T3_BULL," : "") + ((sig_zb_a or sig_zb_b or sig_zb_c or sig_zb_d or sig_zb_e or sig_zb_f) ? "ZONE_BULL," : "")
    string vhb_hws = (hws_bull ? "HWS_BULL," : "") + (hws_bear ? "HWS_BEAR," : "") + (hws_neutral ? "HWS_NEU," : "")
    alert("VOB_X_HWS_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|VOBSRC:" + vhb_src + "|HWS:" + vhb_hws + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BULLSTACK:" + str.tostring(stk_bull) + "|BULLGAP:" + str.tostring(math.round(bull_gap * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_vobhws_bear and sig_vobhws_bear
    string vhs_src = ((sig_t3_sell_a or sig_t3_sell_b or sig_t3_sell_c or sig_t3_sell_d or sig_t3_sell_e or sig_t3_sell_f) ? "T3_BEAR," : "") + ((sig_zs_a or sig_zs_b or sig_zs_c or sig_zs_d or sig_zs_e or sig_zs_f) ? "ZONE_BEAR," : "")
    string vhs_hws = (hws_bull ? "HWS_BULL," : "") + (hws_bear ? "HWS_BEAR," : "") + (hws_neutral ? "HWS_NEU," : "")
    alert("VOB_X_HWS_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|VOBSRC:" + vhs_src + "|HWS:" + vhs_hws + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + "|VOL:" + str.tostring(math.round(volume)) + "|VOLRANK:" + str.tostring(math.round(vol_rank)) + "|RSI:" + str.tostring(math.round(rsi_14 * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + "|BEARSTACK:" + str.tostring(stk_bear) + "|BEARGAP:" + str.tostring(math.round(bear_gap * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
// ███ v11.2 ADDITION #3 — NAGASAKI + ANY (companion dp/vp on the NAG candle) ███
// ═══════════════════════════════════════════════════════════════════════════════
// Fires IFF the ATH-volume candle (where the NAG diamond paints, offset -1) also
// carries >=1 companion detection. COUNTING LAW (operator): RAW signals — display
// toggles and 🔔 alert checkboxes of the companions never affect counting.
// THEOREM: every composite companion implies a raw T3 or zone signal on that
// candle, so fire ⟺ isNagasaki ∧ (raw T3[1] ∨ raw zone[1]).
// The alert payload's ANY: field NAMES every companion; HWS_CTX disclosed;
// REFBAR:-1 disclosed. Display tap show_nag_any / alert tap al_nag_any.

bool show_nag_any = input.bool(true, "Nagasaki + ANY vob v11.9 (companion dp/vp on the NAG candle)",
     group = "Detection — v11.2 New",
     tooltip = "Fires only when the Nagasaki all-time-high-volume candle also carries at least one companion detection (T3 a–f, zone formation a–f, VLB, Multi-Zone, T3 Cluster, VOB×HWS — RAW signals). The alert names every companion in its ANY: field and has its own 🔔 checkbox. Marker paints on the NAG candle (offset -1).")

int nag_mzb_cnt = (nzb_a[1] ? 1 : 0) + (nzb_b[1] ? 1 : 0) + (nzb_c[1] ? 1 : 0) + (nzb_d[1] ? 1 : 0) + (nzb_e[1] ? 1 : 0) + (nzb_f[1] ? 1 : 0)
int nag_mzs_cnt = (nzs_a[1] ? 1 : 0) + (nzs_b[1] ? 1 : 0) + (nzs_c[1] ? 1 : 0) + (nzs_d[1] ? 1 : 0) + (nzs_e[1] ? 1 : 0) + (nzs_f[1] ? 1 : 0)
int nag_tcb_cnt = (t3_buy_a[1] ? 1 : 0) + (t3_buy_b[1] ? 1 : 0) + (t3_buy_c[1] ? 1 : 0) + (t3_buy_d[1] ? 1 : 0) + (t3_buy_e[1] ? 1 : 0) + (t3_buy_f[1] ? 1 : 0)
int nag_tcs_cnt = (t3_sell_a[1] ? 1 : 0) + (t3_sell_b[1] ? 1 : 0) + (t3_sell_c[1] ? 1 : 0) + (t3_sell_d[1] ? 1 : 0) + (t3_sell_e[1] ? 1 : 0) + (t3_sell_f[1] ? 1 : 0)
bool nag_t3_any      = nag_tcb_cnt > 0 or nag_tcs_cnt > 0
bool nag_zone_any    = nag_mzb_cnt > 0 or nag_mzs_cnt > 0
bool nag_vobhws_bull = (nag_tcb_cnt > 0 or nag_mzb_cnt > 0) and hws_any[1]
bool nag_vobhws_bear = (nag_tcs_cnt > 0 or nag_mzs_cnt > 0) and hws_any[1]
bool nag_comp_any    = nag_t3_any or nag_zone_any

var int last_nag_any = na
bool sig_nag_any = isNagasaki and nag_comp_any and barstate.isconfirmed  // v11.10: no cooldown
bool plot_nag_any = show_nag_any and sig_nag_any
if sig_nag_any
    last_nag_any := bar_index

plotshape(plot_nag_any, "Nagasaki + ANY vob v11.9", shape.diamond, location.top, color.fuchsia, size = size.large, text = "NAG+", textcolor = color.fuchsia, offset = -1)
alertcondition(sig_nag_any, "Nagasaki + ANY vob v11.9", "VOB v11.2 — Nagasaki ATH-volume candle carries at least one companion dp/vp; the alert() payload names each companion in its ANY: field")

if al_nag_any and sig_nag_any
    string nag_list = ""
    nag_list += (t3_buy_a[1]  ? "T3A_BUY,"  : "") + (t3_buy_b[1]  ? "T3B_BUY,"  : "") + (t3_buy_c[1]  ? "T3C_BUY,"  : "") + (t3_buy_d[1]  ? "T3D_BUY,"  : "") + (t3_buy_e[1]  ? "T3E_BUY,"  : "") + (t3_buy_f[1]  ? "T3F_BUY,"  : "")
    nag_list += (t3_sell_a[1] ? "T3A_SELL," : "") + (t3_sell_b[1] ? "T3B_SELL," : "") + (t3_sell_c[1] ? "T3C_SELL," : "") + (t3_sell_d[1] ? "T3D_SELL," : "") + (t3_sell_e[1] ? "T3E_SELL," : "") + (t3_sell_f[1] ? "T3F_SELL," : "")
    nag_list += (nzb_a[1] ? "ZONE_A_BULL," : "") + (nzb_b[1] ? "ZONE_B_BULL," : "") + (nzb_c[1] ? "ZONE_C_BULL," : "") + (nzb_d[1] ? "ZONE_D_BULL," : "") + (nzb_e[1] ? "ZONE_E_BULL," : "") + (nzb_f[1] ? "ZONE_F_BULL," : "")
    nag_list += (nzs_a[1] ? "ZONE_A_BEAR," : "") + (nzs_b[1] ? "ZONE_B_BEAR," : "") + (nzs_c[1] ? "ZONE_C_BEAR," : "") + (nzs_d[1] ? "ZONE_D_BEAR," : "") + (nzs_e[1] ? "ZONE_E_BEAR," : "") + (nzs_f[1] ? "ZONE_F_BEAR," : "")
    nag_list += (vlb_bull_complete[1] ? "VLB_BULL," : "") + (vlb_bear_complete[1] ? "VLB_BEAR," : "")
    nag_list += (nag_mzb_cnt == 2 ? "MZ_BULL_2," : "") + (nag_mzb_cnt >= 3 ? "MZ_BULL_3PLUS," : "") + (nag_mzs_cnt == 2 ? "MZ_BEAR_2," : "") + (nag_mzs_cnt >= 3 ? "MZ_BEAR_3PLUS," : "")
    nag_list += (nag_tcb_cnt >= 2 ? "T3_CLUSTER_BULL," : "") + (nag_tcs_cnt >= 2 ? "T3_CLUSTER_BEAR," : "") + ((nag_tcb_cnt + nag_tcs_cnt) >= 2 and nag_tcb_cnt < 2 and nag_tcs_cnt < 2 ? "T3_CLUSTER_MIXED," : "")
    nag_list += (nag_vobhws_bull ? "VOBXHWS_BULL," : "") + (nag_vobhws_bear ? "VOBXHWS_BEAR," : "")
    string nag_hws_ctx = (hws_bull[1] ? "HWS_BULL," : "") + (hws_bear[1] ? "HWS_BEAR," : "") + (hws_neutral[1] ? "HWS_NEU," : "")
    alert("NAGASAKI_PLUS_ANY_VOB_V11.9|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:NEUTRAL|REFBAR:-1|ANY:" + nag_list + "|HWS_CTX:" + nag_hws_ctx + "|CLOSE:" + str.tostring(math.round(close[1] * 100) / 100) + "|VOL:" + str.tostring(math.round(volume[1])) + "|ATHVOL:" + str.tostring(math.round(maxVolEver)) + "|RSI:" + str.tostring(math.round(rsi_14[1] * 100) / 100) + "|SESS:" + str.tostring(sess_bar_count[1]) + "|BULLZONES:" + str.tostring(cnt_bull_all) + "|BEARZONES:" + str.tostring(cnt_bear_all) + bb_tail, alert.freq_once_per_bar_close)


// =============================================================================
// v11.4 PACK — INPUTS (Detection — v11.4 Pack + ALERTS additions)
// =============================================================================

bool show_x3_bull  = input.bool(true, "Tier Level X3 Bull (last 3 tier prints share a level)", group = "Detection — v11.4 Pack")
bool show_x3_bear  = input.bool(true, "Tier Level X3 Bear (last 3 tier prints share a level)", group = "Detection — v11.4 Pack")
bool show_fo_bull  = input.bool(true, "X3 Failed Overlap Bull (3 tier prints, no shared level)", group = "Detection — v11.4 Pack")
bool show_fo_bear  = input.bool(true, "X3 Failed Overlap Bear (3 tier prints, no shared level)", group = "Detection — v11.4 Pack")
bool show_bbp_bull = input.bool(true, "Birth Bar Proximity Bull (any dp near bull birth level)", group = "Detection — v11.4 Pack")
bool show_bbp_bear = input.bool(true, "Birth Bar Proximity Bear (any dp near bear birth level)", group = "Detection — v11.4 Pack")
float x3_buffer   = input.float(0.0, "X3 Level Buffer ($)", minval = 0.0, step = 0.01, group = "Detection — v11.4 Pack",
     tooltip = "Dollar buffer for the X3 common-band test: overlap iff max(lows) <= min(highs) + buffer. Touching counts. Default $0 (operator default 2026-08-11; dollar-buffer law — dollar buffer, NOT percent).")
int   x3_cooldown = input.int(0, "X3 / Failed-Overlap Cooldown Bars", minval = 0, group = "Detection — v11.4 Pack",
     tooltip = "0 = every qualifying tier print re-fires the X3/FO test (operator rolling-window law: no exclusion, the 4th/5th/6th print at the level keeps firing).")
float bbp_pct     = input.float(1.0, "Birth-Bar Proximity Percent", minval = 0.0, step = 0.1, group = "Detection — v11.4 Pack",
     tooltip = "Birth Bar Proximity fires when any sig lane prints while close is within this percent of the nearest active birth level on that side.")
bool al_x3_bull  = input.bool(true, "🔔 Tier Level X3 Bull — alert",     group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_x3_bear  = input.bool(true, "🔔 Tier Level X3 Bear — alert",     group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_fo_bull  = input.bool(true, "🔔 X3 Failed Overlap Bull — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_fo_bear  = input.bool(true, "🔔 X3 Failed Overlap Bear — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_bbp_bull = input.bool(true, "🔔 Birth Bar Proximity Bull — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_bbp_bear = input.bool(true, "🔔 Birth Bar Proximity Bear — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")

// =============================================================================
// v11.4 PACK — TIER LEVEL X3 + X3 FAILED OVERLAP (rolling last-3, common band)
// RANGE-DEFINITION LAW (operator 2026-07-22): BINDING range = dominant-zone bounds
// [zone.lower, zone.upper]. Considered + rejected for the binding role:
// (B) fire-candle [low, high]; (C) origin swing-bar [zone.l, zone.h]. All three
// margins are EMITTED per test (VOB_X3_TEST) so T-METALEARN re-decides the binding
// definition from collected evidence. End of story.
// WINDOW LAW: TRUE rolling window over the last 3 same-side tier prints — unbounded
// age, NO exclusion after a fire (each new print tests itself + its two most recent
// priors). OVERLAP LAW: common band, max(lo) <= min(hi) + buffer; touching counts.
// v11.2 composite rule: prints are counted on SIG lanes (display-independent).
// =============================================================================

var int last_x3_bull = na
var int last_x3_bear = na
var int last_fo_bull = na
var int last_fo_bear = na
var int last_bbp_bull = na
var int last_bbp_bear = na

var array<float>  x3b_lo   = array.new<float>()
var array<float>  x3b_hi   = array.new<float>()
var array<float>  x3b_clo  = array.new<float>()
var array<float>  x3b_chi  = array.new<float>()
var array<float>  x3b_olo  = array.new<float>()
var array<float>  x3b_ohi  = array.new<float>()
var array<int>    x3b_t    = array.new<int>()
var array<string> x3b_tier = array.new<string>()
var array<float>  x3s_lo   = array.new<float>()
var array<float>  x3s_hi   = array.new<float>()
var array<float>  x3s_clo  = array.new<float>()
var array<float>  x3s_chi  = array.new<float>()
var array<float>  x3s_olo  = array.new<float>()
var array<float>  x3s_ohi  = array.new<float>()
var array<int>    x3s_t    = array.new<int>()
var array<string> x3s_tier = array.new<string>()

f_x3_zone(array<level> arr) =>
    level r = na
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            level l = arr.get(i)
            if not na(l.vol)
                r := l
    r

f_x3_push(array<float> alo, array<float> ahi, array<float> clo, array<float> chi, array<float> olo, array<float> ohi, array<int> at, array<string> atier, array<level> zarr, string tier) =>
    level z = f_x3_zone(zarr)
    if not na(z)
        alo.push(z.lower), ahi.push(z.upper)
        clo.push(low), chi.push(high)
        olo.push(z.l), ohi.push(z.h)
        at.push(time), atier.push(tier)
        if alo.size() > 3
            alo.shift(), ahi.shift(), clo.shift(), chi.shift(), olo.shift(), ohi.shift(), at.shift(), atier.shift()

bool x3b_print = sig_t3_buy_a or sig_t3_buy_b or sig_t3_buy_c or sig_t3_buy_d or sig_t3_buy_e or sig_t3_buy_f
bool x3s_print = sig_t3_sell_a or sig_t3_sell_b or sig_t3_sell_c or sig_t3_sell_d or sig_t3_sell_e or sig_t3_sell_f

if sig_t3_buy_a
    f_x3_push(x3b_lo, x3b_hi, x3b_clo, x3b_chi, x3b_olo, x3b_ohi, x3b_t, x3b_tier, lower_a, "A")
if sig_t3_buy_b
    f_x3_push(x3b_lo, x3b_hi, x3b_clo, x3b_chi, x3b_olo, x3b_ohi, x3b_t, x3b_tier, lower_b, "B")
if sig_t3_buy_c
    f_x3_push(x3b_lo, x3b_hi, x3b_clo, x3b_chi, x3b_olo, x3b_ohi, x3b_t, x3b_tier, lower_c, "C")
if sig_t3_buy_d
    f_x3_push(x3b_lo, x3b_hi, x3b_clo, x3b_chi, x3b_olo, x3b_ohi, x3b_t, x3b_tier, lower_d, "D")
if sig_t3_buy_e
    f_x3_push(x3b_lo, x3b_hi, x3b_clo, x3b_chi, x3b_olo, x3b_ohi, x3b_t, x3b_tier, lower_e, "E")
if sig_t3_buy_f
    f_x3_push(x3b_lo, x3b_hi, x3b_clo, x3b_chi, x3b_olo, x3b_ohi, x3b_t, x3b_tier, lower_f, "F")
if sig_t3_sell_a
    f_x3_push(x3s_lo, x3s_hi, x3s_clo, x3s_chi, x3s_olo, x3s_ohi, x3s_t, x3s_tier, upper_a, "A")
if sig_t3_sell_b
    f_x3_push(x3s_lo, x3s_hi, x3s_clo, x3s_chi, x3s_olo, x3s_ohi, x3s_t, x3s_tier, upper_b, "B")
if sig_t3_sell_c
    f_x3_push(x3s_lo, x3s_hi, x3s_clo, x3s_chi, x3s_olo, x3s_ohi, x3s_t, x3s_tier, upper_c, "C")
if sig_t3_sell_d
    f_x3_push(x3s_lo, x3s_hi, x3s_clo, x3s_chi, x3s_olo, x3s_ohi, x3s_t, x3s_tier, upper_d, "D")
if sig_t3_sell_e
    f_x3_push(x3s_lo, x3s_hi, x3s_clo, x3s_chi, x3s_olo, x3s_ohi, x3s_t, x3s_tier, upper_e, "E")
if sig_t3_sell_f
    f_x3_push(x3s_lo, x3s_hi, x3s_clo, x3s_chi, x3s_olo, x3s_ohi, x3s_t, x3s_tier, upper_f, "F")

f_x3_margin(array<float> lo, array<float> hi, float buf) =>
    lo.size() == 3 ? (math.min(hi.get(0), math.min(hi.get(1), hi.get(2))) + buf) - math.max(lo.get(0), math.max(lo.get(1), lo.get(2))) : na

bool  x3b_ready = x3b_lo.size() == 3
bool  x3s_ready = x3s_lo.size() == 3
float x3b_mz = f_x3_margin(x3b_lo, x3b_hi, x3_buffer)
float x3b_mc = f_x3_margin(x3b_clo, x3b_chi, x3_buffer)
float x3b_mo = f_x3_margin(x3b_olo, x3b_ohi, x3_buffer)
float x3s_mz = f_x3_margin(x3s_lo, x3s_hi, x3_buffer)
float x3s_mc = f_x3_margin(x3s_clo, x3s_chi, x3_buffer)
float x3s_mo = f_x3_margin(x3s_olo, x3s_ohi, x3_buffer)
bool  x3b_pass = x3b_ready and not na(x3b_mz) and x3b_mz >= 0
bool  x3s_pass = x3s_ready and not na(x3s_mz) and x3s_mz >= 0

// three-lane law: sig (criteria+confirmed+cooldown, stamps itself) / plot = show and sig / alert iff al and sig
bool sig_x3_bull = x3b_print and x3b_ready and x3b_pass and barstate.isconfirmed and f_cd_ok(last_x3_bull, x3_cooldown)
bool sig_x3_bear = x3s_print and x3s_ready and x3s_pass and barstate.isconfirmed and f_cd_ok(last_x3_bear, x3_cooldown)
bool sig_fo_bull = x3b_print and x3b_ready and not x3b_pass and barstate.isconfirmed and f_cd_ok(last_fo_bull, x3_cooldown)
bool sig_fo_bear = x3s_print and x3s_ready and not x3s_pass and barstate.isconfirmed and f_cd_ok(last_fo_bear, x3_cooldown)

if sig_x3_bull
    last_x3_bull := bar_index
if sig_x3_bear
    last_x3_bear := bar_index
if sig_fo_bull
    last_fo_bull := bar_index
if sig_fo_bear
    last_fo_bear := bar_index

bool plot_x3_bull = show_x3_bull and sig_x3_bull
bool plot_x3_bear = show_x3_bear and sig_x3_bear
bool plot_fo_bull = show_fo_bull and sig_fo_bull
bool plot_fo_bear = show_fo_bear and sig_fo_bear

f_x3_tlist(array<string> atier) =>
    atier.size() == 3 ? atier.get(0) + "," + atier.get(1) + "," + atier.get(2) : ""

// =============================================================================
// v11.4 PACK — BIRTH BAR PROXIMITY (any sig lane arms; nearest-active birth ref)
// =============================================================================

bool any_sig_fired = any_zone or any_t3 or sig_vlb_bull or sig_vlb_bear or sig_mz_b2 or sig_mz_b3 or sig_mz_s2 or sig_mz_s3 or sig_tc_cluster_bull or sig_tc_cluster_bear or sig_vobhws_bull or sig_vobhws_bear or sig_nag_any or sig_x3_bull or sig_x3_bear or sig_fo_bull or sig_fo_bear

bool sig_bbp_bull = any_sig_fired and not na(bb_bull_pct) and math.abs(bb_bull_pct) <= bbp_pct and barstate.isconfirmed and f_cd_ok(last_bbp_bull, cooldown_bars)
bool sig_bbp_bear = any_sig_fired and not na(bb_bear_pct) and math.abs(bb_bear_pct) <= bbp_pct and barstate.isconfirmed and f_cd_ok(last_bbp_bear, cooldown_bars)

if sig_bbp_bull
    last_bbp_bull := bar_index
if sig_bbp_bear
    last_bbp_bear := bar_index

bool plot_bbp_bull = show_bbp_bull and sig_bbp_bull
bool plot_bbp_bear = show_bbp_bear and sig_bbp_bear

string bbp_armed = (any_zone ? "ZONE," : "") + (any_t3 ? "T3/NAG," : "") + (sig_vlb_bull or sig_vlb_bear ? "VLB," : "") + (sig_mz_b2 or sig_mz_b3 or sig_mz_s2 or sig_mz_s3 ? "MZ," : "") + (sig_tc_cluster_bull or sig_tc_cluster_bear ? "TC," : "") + (sig_vobhws_bull or sig_vobhws_bear ? "VXH," : "") + (sig_nag_any ? "NAG+," : "") + (sig_x3_bull or sig_x3_bear ? "X3," : "") + (sig_fo_bull or sig_fo_bear ? "FO," : "")

// =============================================================================
// v11.4 PACK — VISUAL PLOTSHAPES (6) + ALERTCONDITIONS (6) + IFF-GATED ALERTS
// =============================================================================

plotshape(plot_x3_bull,  "Tier Level X3 Bull",       shape.diamond, location.belowbar, color.lime, size = size.normal, text = "X3↑", textcolor = color.lime)
plotshape(plot_x3_bear,  "Tier Level X3 Bear",       shape.diamond, location.abovebar, color.red, size = size.normal, text = "X3↓", textcolor = color.red)
plotshape(plot_fo_bull,  "X3 Failed Overlap Bull",   shape.xcross,  location.belowbar, color.aqua, size = size.normal, text = "FO↑", textcolor = color.aqua)
plotshape(plot_fo_bear,  "X3 Failed Overlap Bear",   shape.xcross,  location.abovebar, color.fuchsia, size = size.normal, text = "FO↓", textcolor = color.fuchsia)
plotshape(plot_bbp_bull, "Birth Bar Proximity Bull", shape.circle,  location.belowbar, color.teal, size = size.small,  text = "BB↑", textcolor = color.teal)
plotshape(plot_bbp_bear, "Birth Bar Proximity Bear", shape.circle,  location.abovebar, color.maroon, size = size.small,  text = "BB↓", textcolor = color.maroon)

alertcondition(sig_x3_bull,  "Tier Level X3 Bull",       "VOB v11.4 — last 3 bullish tier prints share a level (common band, buffered)")
alertcondition(sig_x3_bear,  "Tier Level X3 Bear",       "VOB v11.4 — last 3 bearish tier prints share a level (common band, buffered)")
alertcondition(sig_fo_bull,  "X3 Failed Overlap Bull",   "VOB v11.4 — 3 bullish tier prints with NO shared level (staircase)")
alertcondition(sig_fo_bear,  "X3 Failed Overlap Bear",   "VOB v11.4 — 3 bearish tier prints with NO shared level (staircase)")
alertcondition(sig_bbp_bull, "Birth Bar Proximity Bull", "VOB v11.4 — a dp fired within the proximity percent of the bull birth level")
alertcondition(sig_bbp_bear, "Birth Bar Proximity Bear", "VOB v11.4 — a dp fired within the proximity percent of the bear birth level")

if al_x3_bull and sig_x3_bull
    alert("TIER_LEVEL_X3_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|TIERS:" + f_x3_tlist(x3b_tier) + "|BAND_LO:" + f_fmt_p2(math.max(x3b_lo.get(0), math.max(x3b_lo.get(1), x3b_lo.get(2)))) + "|BAND_HI:" + f_fmt_p2(math.min(x3b_hi.get(0), math.min(x3b_hi.get(1), x3b_hi.get(2)))) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_x3_bear and sig_x3_bear
    alert("TIER_LEVEL_X3_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|TIERS:" + f_x3_tlist(x3s_tier) + "|BAND_LO:" + f_fmt_p2(math.max(x3s_lo.get(0), math.max(x3s_lo.get(1), x3s_lo.get(2)))) + "|BAND_HI:" + f_fmt_p2(math.min(x3s_hi.get(0), math.min(x3s_hi.get(1), x3s_hi.get(2)))) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_fo_bull and sig_fo_bull
    alert("X3_FAILED_OVERLAP_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|TIERS:" + f_x3_tlist(x3b_tier) + "|GAP:" + f_fmt_p2(-x3b_mz) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_fo_bear and sig_fo_bear
    alert("X3_FAILED_OVERLAP_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|TIERS:" + f_x3_tlist(x3s_tier) + "|GAP:" + f_fmt_p2(-x3s_mz) + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_bbp_bull and sig_bbp_bull
    alert("BIRTH_PROX_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|ARMED:" + bbp_armed + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_bbp_bear and sig_bbp_bear
    alert("BIRTH_PROX_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|ARMED:" + bbp_armed + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)

// machine lane — X3 test emission on EVERY test (pass or fail): the T-METALEARN
// comparison dataset (margin under all three candidate range definitions).
f_x3_log(string side, bool ready, bool pass_, array<string> atier, array<int> at, array<float> alo, array<float> ahi, array<float> clo, array<float> chi, array<float> olo, array<float> ohi, float mz, float mc, float mo) =>
    if en_emission_logs and ready
        log.info("{0}", "VOB_X3_TEST|T:" + str.tostring(time) + "|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|SIDE:" + side + "|RESULT:" + (pass_ ? "PASS" : "FAIL") + "|TIERS:" + f_x3_tlist(atier) + "|PRINT_T:" + str.tostring(at.get(0)) + "," + str.tostring(at.get(1)) + "," + str.tostring(at.get(2)) + "|M_ZONE:" + f_fmt_p2(mz) + "|M_CANDLE:" + f_fmt_p2(mc) + "|M_ORIGIN:" + f_fmt_p2(mo) + "|BUF:" + str.tostring(x3_buffer) + "|ZLO:" + f_fmt_p2(alo.get(0)) + "," + f_fmt_p2(alo.get(1)) + "," + f_fmt_p2(alo.get(2)) + "|ZHI:" + f_fmt_p2(ahi.get(0)) + "," + f_fmt_p2(ahi.get(1)) + "," + f_fmt_p2(ahi.get(2)) + "|CLO:" + f_fmt_p2(clo.get(0)) + "," + f_fmt_p2(clo.get(1)) + "," + f_fmt_p2(clo.get(2)) + "|CHI:" + f_fmt_p2(chi.get(0)) + "," + f_fmt_p2(chi.get(1)) + "," + f_fmt_p2(chi.get(2)) + "|OLO:" + f_fmt_p2(olo.get(0)) + "," + f_fmt_p2(olo.get(1)) + "," + f_fmt_p2(olo.get(2)) + "|OHI:" + f_fmt_p2(ohi.get(0)) + "," + f_fmt_p2(ohi.get(1)) + "," + f_fmt_p2(ohi.get(2)) + "|CLOSE:" + str.tostring(close))

if x3b_print and barstate.isconfirmed
    f_x3_log("BULL", x3b_ready, x3b_pass, x3b_tier, x3b_t, x3b_lo, x3b_hi, x3b_clo, x3b_chi, x3b_olo, x3b_ohi, x3b_mz, x3b_mc, x3b_mo)
if x3s_print and barstate.isconfirmed
    f_x3_log("BEAR", x3s_ready, x3s_pass, x3s_tier, x3s_t, x3s_lo, x3s_hi, x3s_clo, x3s_chi, x3s_olo, x3s_ohi, x3s_mz, x3s_mc, x3s_mo)

if en_emission_logs and barstate.isconfirmed and (sig_bbp_bull or sig_bbp_bear)
    log.info("{0}", "VOB_BBP|T:" + str.tostring(time) + "|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|BULL_FIRE:" + (sig_bbp_bull ? "1" : "0") + "|BEAR_FIRE:" + (sig_bbp_bear ? "1" : "0") + "|ARMED:" + bbp_armed + "|PCT_IN:" + str.tostring(bbp_pct) + "|CLOSE:" + str.tostring(close))

// per-bar machine stream #2 — birth-bar geometry + X3 memory (joins VOB_EMISSION by T)
if en_emission_logs and barstate.isconfirmed
    log.info("{0}", "VOB_EMISSION2|T:" + str.tostring(time) + "|BB_BULL:" + f_fmt_p2(bb_bull) + "|BB_BULL_PCT:" + f_fmt_p2(bb_bull_pct) + "|BB_BEAR:" + f_fmt_p2(bb_bear) + "|BB_BEAR_PCT:" + f_fmt_p2(bb_bear_pct) + "|CLOSER:" + bb_closer + "|EMANATE:" + bb_emanate + "|X3B_N:" + str.tostring(x3b_lo.size()) + "|X3S_N:" + str.tostring(x3s_lo.size()) + "|X3B_MZ:" + f_fmt_p2(x3b_mz) + "|X3S_MZ:" + f_fmt_p2(x3s_mz) + "|TCB:" + str.tostring(tc_bull_cnt) + "|TCS:" + str.tostring(tc_bear_cnt))


// ═══════════════════════════════════════════════════════════════════════════════
// ███ v11.9 PACK — KEEPER-PACK CO-FIRE + HV(1K..4K) + ANY (operator order 2026-08-11) ███
// ═══════════════════════════════════════════════════════════════════════════════
// PACK = {T3 Cluster, Tier Level X3, X3 Failed Overlap, Birth Bar Proximity}, side-typed.
// MUTEX THEOREM: X3 and Failed Overlap are complementary verdicts of the same
// last-3-prints band test on the same candle — they can NEVER co-fire on one side,
// so 4-of-4 is unreachable and 3 is the maximum. Co-Fire = EXACTLY 2 members
// (MZ-law tiering, no double-fire with 3-of-4). Counted on SIG lanes (display-independent).
// HV + ANY: prior-candle volume is the highest of the trailing 1000/2000/3000/4000
// bars (TRUE rolling windows) AND that candle carries >=1 companion dp (NAG+ANY
// construction, REFBAR:-1). COMPANION UNIVERSE = RAW T3 a-f + zone formations a-f —
// the CALCULATORS count (no checkbox/plot/alert of their own, still companions);
// every keeper composite reduces to these constituents (NAG+ANY theorem).
// EXCLUSIVITY LADDER (windows nest, ATH ⊃ 4K ⊃ 3K ⊃ 2K ⊃ 1K): each candle fires
// ONLY its highest window lane — Nagasaki + ANY > 4K > 3K > 2K > 1K.
// NOTE: a window lane stays silent until its window has fully seeded (e.g. 4K needs
// 4000 bars of history on the chart).

bool show_pack2_bull = input.bool(true, "Pack Co-Fire Bull (exactly 2 of TC/X3/FO/BBP same candle)", group = "Detection — v11.9 Pack")
bool show_pack2_bear = input.bool(true, "Pack Co-Fire Bear (exactly 2 of TC/X3/FO/BBP same candle)", group = "Detection — v11.9 Pack")
bool show_pack3_bull = input.bool(true, "Pack 3-of-4 Bull (3 of TC/X3/FO/BBP same candle)", group = "Detection — v11.9 Pack")
bool show_pack3_bear = input.bool(true, "Pack 3-of-4 Bear (3 of TC/X3/FO/BBP same candle)", group = "Detection — v11.9 Pack")
bool show_hv4k_any = input.bool(true, "4K HV + ANY vob v11.9 (highest vol in 4000 bars + companion dp)", group = "Detection — v11.9 Pack")
bool show_hv3k_any = input.bool(true, "3K HV + ANY vob v11.9 (highest vol in 3000 bars + companion dp)", group = "Detection — v11.9 Pack")
bool show_hv2k_any = input.bool(true, "2K HV + ANY vob v11.9 (highest vol in 2000 bars + companion dp)", group = "Detection — v11.9 Pack")
bool show_hv1k_any = input.bool(true, "1K HV + ANY vob v11.9 (highest vol in 1000 bars + companion dp)", group = "Detection — v11.9 Pack")
bool al_pack2_bull = input.bool(true, "🔔 Pack Co-Fire Bull — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_pack2_bear = input.bool(true, "🔔 Pack Co-Fire Bear — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_pack3_bull = input.bool(true, "🔔 Pack 3-of-4 Bull — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_pack3_bear = input.bool(true, "🔔 Pack 3-of-4 Bear — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_hv4k_any = input.bool(true, "🔔 4K HV + ANY vob v11.9 — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_hv3k_any = input.bool(true, "🔔 3K HV + ANY vob v11.9 — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_hv2k_any = input.bool(true, "🔔 2K HV + ANY vob v11.9 — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")
bool al_hv1k_any = input.bool(true, "🔔 1K HV + ANY vob v11.9 — alert", group = "🔔 ALERTS — iff checked → alert fires (display-independent)")

var int last_pack2_bull = na
var int last_pack2_bear = na
var int last_pack3_bull = na
var int last_pack3_bear = na
var int last_hv4k_any = na
var int last_hv3k_any = na
var int last_hv2k_any = na
var int last_hv1k_any = na

// ── pack counts (constituent sigs are already confirmed-bar gated) ──
int pack_bull_cnt = (sig_tc_cluster_bull ? 1 : 0) + (sig_x3_bull ? 1 : 0) + (sig_fo_bull ? 1 : 0) + (sig_bbp_bull ? 1 : 0)
int pack_bear_cnt = (sig_tc_cluster_bear ? 1 : 0) + (sig_x3_bear ? 1 : 0) + (sig_fo_bear ? 1 : 0) + (sig_bbp_bear ? 1 : 0)
string pack_bull_members = (sig_tc_cluster_bull ? "T3_CLUSTER," : "") + (sig_x3_bull ? "TIER_X3," : "") + (sig_fo_bull ? "FAILED_OVERLAP," : "") + (sig_bbp_bull ? "BIRTH_PROX," : "")
string pack_bear_members = (sig_tc_cluster_bear ? "T3_CLUSTER," : "") + (sig_x3_bear ? "TIER_X3," : "") + (sig_fo_bear ? "FAILED_OVERLAP," : "") + (sig_bbp_bear ? "BIRTH_PROX," : "")

bool sig_pack2_bull = pack_bull_cnt == 2 and barstate.isconfirmed and f_cd_ok(last_pack2_bull, cooldown_bars)
bool sig_pack2_bear = pack_bear_cnt == 2 and barstate.isconfirmed and f_cd_ok(last_pack2_bear, cooldown_bars)
bool sig_pack3_bull = pack_bull_cnt >= 3 and barstate.isconfirmed and f_cd_ok(last_pack3_bull, cooldown_bars)
bool sig_pack3_bear = pack_bear_cnt >= 3 and barstate.isconfirmed and f_cd_ok(last_pack3_bear, cooldown_bars)

// ── HV window events (prior candle, mirrors the HW-engine HV construction) ──
bool hvtop_1k = volume[1] == ta.highest(volume, 1000)[1]
bool hvtop_2k = volume[1] == ta.highest(volume, 2000)[1]
bool hvtop_3k = volume[1] == ta.highest(volume, 3000)[1]
bool hvtop_4k = volume[1] == ta.highest(volume, 4000)[1]
bool ev_hv4k = hvtop_4k and not isNagasaki
bool ev_hv3k = hvtop_3k and not hvtop_4k
bool ev_hv2k = hvtop_2k and not hvtop_3k
bool ev_hv1k = hvtop_1k and not hvtop_2k

bool sig_hv4k_any = ev_hv4k and nag_comp_any and barstate.isconfirmed and f_cd_ok(last_hv4k_any, cooldown_bars)
bool sig_hv3k_any = ev_hv3k and nag_comp_any and barstate.isconfirmed and f_cd_ok(last_hv3k_any, cooldown_bars)
bool sig_hv2k_any = ev_hv2k and nag_comp_any and barstate.isconfirmed and f_cd_ok(last_hv2k_any, cooldown_bars)
bool sig_hv1k_any = ev_hv1k and nag_comp_any and barstate.isconfirmed and f_cd_ok(last_hv1k_any, cooldown_bars)

if sig_pack2_bull
    last_pack2_bull := bar_index
if sig_pack2_bear
    last_pack2_bear := bar_index
if sig_pack3_bull
    last_pack3_bull := bar_index
if sig_pack3_bear
    last_pack3_bear := bar_index
if sig_hv4k_any
    last_hv4k_any := bar_index
if sig_hv3k_any
    last_hv3k_any := bar_index
if sig_hv2k_any
    last_hv2k_any := bar_index
if sig_hv1k_any
    last_hv1k_any := bar_index

bool plot_pack2_bull = show_pack2_bull and sig_pack2_bull
bool plot_pack2_bear = show_pack2_bear and sig_pack2_bear
bool plot_pack3_bull = show_pack3_bull and sig_pack3_bull
bool plot_pack3_bear = show_pack3_bear and sig_pack3_bear
bool plot_hv4k_any = show_hv4k_any and sig_hv4k_any
bool plot_hv3k_any = show_hv3k_any and sig_hv3k_any
bool plot_hv2k_any = show_hv2k_any and sig_hv2k_any
bool plot_hv1k_any = show_hv1k_any and sig_hv1k_any

// ── companion list for the HV+ANY payloads (RAW prior-candle signals; calculators included) ──
bool any_hv_fire = sig_hv4k_any or sig_hv3k_any or sig_hv2k_any or sig_hv1k_any
string hv_any_list = ""
string hv_hws_ctx = ""
if any_hv_fire
    hv_any_list += (t3_buy_a[1] ? "T3A_BUY," : "") + (t3_buy_b[1] ? "T3B_BUY," : "") + (t3_buy_c[1] ? "T3C_BUY," : "") + (t3_buy_d[1] ? "T3D_BUY," : "") + (t3_buy_e[1] ? "T3E_BUY," : "") + (t3_buy_f[1] ? "T3F_BUY," : "")
    hv_any_list += (t3_sell_a[1] ? "T3A_SELL," : "") + (t3_sell_b[1] ? "T3B_SELL," : "") + (t3_sell_c[1] ? "T3C_SELL," : "") + (t3_sell_d[1] ? "T3D_SELL," : "") + (t3_sell_e[1] ? "T3E_SELL," : "") + (t3_sell_f[1] ? "T3F_SELL," : "")
    hv_any_list += (nzb_a[1] ? "ZONE_A_BULL," : "") + (nzb_b[1] ? "ZONE_B_BULL," : "") + (nzb_c[1] ? "ZONE_C_BULL," : "") + (nzb_d[1] ? "ZONE_D_BULL," : "") + (nzb_e[1] ? "ZONE_E_BULL," : "") + (nzb_f[1] ? "ZONE_F_BULL," : "")
    hv_any_list += (nzs_a[1] ? "ZONE_A_BEAR," : "") + (nzs_b[1] ? "ZONE_B_BEAR," : "") + (nzs_c[1] ? "ZONE_C_BEAR," : "") + (nzs_d[1] ? "ZONE_D_BEAR," : "") + (nzs_e[1] ? "ZONE_E_BEAR," : "") + (nzs_f[1] ? "ZONE_F_BEAR," : "")
    hv_any_list += (vlb_bull_complete[1] ? "VLB_BULL," : "") + (vlb_bear_complete[1] ? "VLB_BEAR," : "")
    hv_any_list += (nag_mzb_cnt == 2 ? "MZ_BULL_2," : "") + (nag_mzb_cnt >= 3 ? "MZ_BULL_3PLUS," : "") + (nag_mzs_cnt == 2 ? "MZ_BEAR_2," : "") + (nag_mzs_cnt >= 3 ? "MZ_BEAR_3PLUS," : "")
    hv_any_list += (nag_tcb_cnt >= 2 ? "T3_CLUSTER_BULL," : "") + (nag_tcs_cnt >= 2 ? "T3_CLUSTER_BEAR," : "") + ((nag_tcb_cnt + nag_tcs_cnt) >= 2 and nag_tcb_cnt < 2 and nag_tcs_cnt < 2 ? "T3_CLUSTER_MIXED," : "")
    hv_hws_ctx += (hws_bull[1] ? "HWS_BULL," : "") + (hws_bear[1] ? "HWS_BEAR," : "") + (hws_neutral[1] ? "HWS_NEU," : "")

// ── visual plotshapes (8 — distinct shape × location identities; bare const colors, RE10140 law) ──
plotshape(plot_pack2_bull, "Pack Co-Fire Bull (2 of 4)", shape.arrowup, location.belowbar, color.yellow, size = size.normal, text = "PK2↑", textcolor = color.yellow)
plotshape(plot_pack2_bear, "Pack Co-Fire Bear (2 of 4)", shape.arrowdown, location.abovebar, color.orange, size = size.normal, text = "PK2↓", textcolor = color.orange)
plotshape(plot_pack3_bull, "Pack 3-of-4 Bull", shape.cross, location.belowbar, color.white, size = size.large, text = "PK3↑", textcolor = color.white)
plotshape(plot_pack3_bear, "Pack 3-of-4 Bear", shape.cross, location.abovebar, color.silver, size = size.large, text = "PK3↓", textcolor = color.silver)
plotshape(plot_hv4k_any, "4K HV + ANY vob v11.9", shape.square, location.top, color.orange, size = size.normal, text = "4K+", textcolor = color.orange, offset = -1)
plotshape(plot_hv3k_any, "3K HV + ANY vob v11.9", shape.cross, location.top, color.yellow, size = size.normal, text = "3K+", textcolor = color.yellow, offset = -1)
plotshape(plot_hv2k_any, "2K HV + ANY vob v11.9", shape.xcross, location.top, color.aqua, size = size.normal, text = "2K+", textcolor = color.aqua, offset = -1)
plotshape(plot_hv1k_any, "1K HV + ANY vob v11.9", shape.circle, location.top, color.silver, size = size.normal, text = "1K+", textcolor = color.silver, offset = -1)

alertcondition(sig_pack2_bull, "Pack Co-Fire Bull (2 of 4)", "VOB v11.9 — exactly 2 of {T3 Cluster, Tier Level X3, X3 Failed Overlap, Birth Bar Proximity} Bull on the same candle")
alertcondition(sig_pack2_bear, "Pack Co-Fire Bear (2 of 4)", "VOB v11.9 — exactly 2 of {T3 Cluster, Tier Level X3, X3 Failed Overlap, Birth Bar Proximity} Bear on the same candle")
alertcondition(sig_pack3_bull, "Pack 3-of-4 Bull", "VOB v11.9 — 3 of the 4 pack members Bull on the same candle (the maximum; X3 and Failed Overlap are mutually exclusive)")
alertcondition(sig_pack3_bear, "Pack 3-of-4 Bear", "VOB v11.9 — 3 of the 4 pack members Bear on the same candle (the maximum; X3 and Failed Overlap are mutually exclusive)")
alertcondition(sig_hv4k_any, "4K HV + ANY vob v11.9", "VOB v11.9 — prior candle is the highest volume of the trailing 4000 bars (not ATH) and carries a companion dp; ANY: names each companion")
alertcondition(sig_hv3k_any, "3K HV + ANY vob v11.9", "VOB v11.9 — prior candle is the highest volume of the trailing 3000 bars (not 4K) and carries a companion dp; ANY: names each companion")
alertcondition(sig_hv2k_any, "2K HV + ANY vob v11.9", "VOB v11.9 — prior candle is the highest volume of the trailing 2000 bars (not 3K) and carries a companion dp; ANY: names each companion")
alertcondition(sig_hv1k_any, "1K HV + ANY vob v11.9", "VOB v11.9 — prior candle is the highest volume of the trailing 1000 bars (not 2K) and carries a companion dp; ANY: names each companion")

if al_pack2_bull and sig_pack2_bull
    alert("PACK_COFIRE_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|COUNT:" + str.tostring(pack_bull_cnt) + "|MEMBERS:" + pack_bull_members + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_pack2_bear and sig_pack2_bear
    alert("PACK_COFIRE_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|COUNT:" + str.tostring(pack_bear_cnt) + "|MEMBERS:" + pack_bear_members + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_pack3_bull and sig_pack3_bull
    alert("PACK_3OF4_BULL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BULL|COUNT:" + str.tostring(pack_bull_cnt) + "|MEMBERS:" + pack_bull_members + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_pack3_bear and sig_pack3_bear
    alert("PACK_3OF4_BEAR|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:BEAR|COUNT:" + str.tostring(pack_bear_cnt) + "|MEMBERS:" + pack_bear_members + "|CLOSE:" + str.tostring(math.round(close * 100) / 100) + bb_tail, alert.freq_once_per_bar_close)
if al_hv4k_any and sig_hv4k_any
    alert("HV4K_PLUS_ANY_VOB_V11.9|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:NEUTRAL|WINDOW:4000|REFBAR:-1|ANY:" + hv_any_list + "|HWS_CTX:" + hv_hws_ctx + "|CLOSE:" + str.tostring(math.round(close[1] * 100) / 100) + "|VOL:" + str.tostring(math.round(volume[1])) + bb_tail, alert.freq_once_per_bar_close)
if al_hv3k_any and sig_hv3k_any
    alert("HV3K_PLUS_ANY_VOB_V11.9|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:NEUTRAL|WINDOW:3000|REFBAR:-1|ANY:" + hv_any_list + "|HWS_CTX:" + hv_hws_ctx + "|CLOSE:" + str.tostring(math.round(close[1] * 100) / 100) + "|VOL:" + str.tostring(math.round(volume[1])) + bb_tail, alert.freq_once_per_bar_close)
if al_hv2k_any and sig_hv2k_any
    alert("HV2K_PLUS_ANY_VOB_V11.9|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:NEUTRAL|WINDOW:2000|REFBAR:-1|ANY:" + hv_any_list + "|HWS_CTX:" + hv_hws_ctx + "|CLOSE:" + str.tostring(math.round(close[1] * 100) / 100) + "|VOL:" + str.tostring(math.round(volume[1])) + bb_tail, alert.freq_once_per_bar_close)
if al_hv1k_any and sig_hv1k_any
    alert("HV1K_PLUS_ANY_VOB_V11.9|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|DIR:NEUTRAL|WINDOW:1000|REFBAR:-1|ANY:" + hv_any_list + "|HWS_CTX:" + hv_hws_ctx + "|CLOSE:" + str.tostring(math.round(close[1] * 100) / 100) + "|VOL:" + str.tostring(math.round(volume[1])) + bb_tail, alert.freq_once_per_bar_close)
