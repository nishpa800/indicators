//@version=5
// ╔════════════════════════════════════════════════════════════════════╗
// ║  COMBO CHAIN — BINARY-CORRECT (tick-friendly)                      ║
// ║  Source: BASE HV+D ↔ PBJ ↔ PPD v1 (no HTF)                         ║
// ║                                                                    ║
// ║  THE LAW (Anish, 2026-06-04):                                      ║
// ║   • Matrix combo counts.  Offset 0  (belongs to its own bar).      ║
// ║   • FVG combo counts.     Offset -1 (belongs to the bar before).   ║
// ║   • One physical bar = 1 or 0. NEVER more.                         ║
// ║   • Matrix AND FVG on the SAME physical bar = ONE hit, not two.    ║
// ║   • A 2-hit chain therefore requires TWO different bars.           ║
// ║                                                                    ║
// ║  ORIGINAL DEFECT (fixed here):                                     ║
// ║   Original loop: hv2 = comboMatrix[i] OR comboFVG[i-1]             ║
// ║   The [i-1] cross-bar shift let a single firing bar fill TWO       ║
// ║   slots (matrix(N) in slot 0, fvg(N) in slot 1) → count = 2 off    ║
// ║   ONE bar. That breaks the binary law.                            ║
// ║                                                                    ║
// ║  FIX: per_bar_hit[t] = comboMatrix[t] OR comboFVG[t]  (same bar,   ║
// ║       OR-collapsed to a single boolean) → count distinct bars.     ║
// ║                                                                    ║
// ║  TICK-FRIENDLY:                                                    ║
// ║   • No time-based session math required for the chain.            ║
// ║   • barstate.isconfirmed gates each bar (valid on tick charts).   ║
// ║   • Upstream Matrix / FVG / PBJ are fed via input.source() so this ║
// ║     consumes the REAL plotted booleans from the parent indicator   ║
// ║     on whatever (tick) chart it is applied to.                     ║
// ╚════════════════════════════════════════════════════════════════════╝
indicator("COMBO CHAIN — BINARY-CORRECT v2 (tick)", shorttitle="CC FIX TICK v2", overlay=true, max_labels_count=500)

// ── WIRE THESE TO THE PARENT INDICATOR'S PLOTTED SERIES ──
// On the chart: add the BASE HV+D indicator, then in these dropdowns pick
// its "CS2 MAT", "CS1 FVG", and PBJ plots. Any value > 0 is treated TRUE.
grpS = "Upstream plots (source)"
float src_matrix_bull = input.source(close, "Matrix Combo Bull plot", group=grpS)
float src_fvg_bull    = input.source(close, "FVG Combo Bull plot",    group=grpS)
float src_pbj_bull    = input.source(close, "PBJ/PB Bull plot",       group=grpS)
float src_matrix_bear = input.source(close, "Matrix Combo Bear plot", group=grpS)
float src_fvg_bear    = input.source(close, "FVG Combo Bear plot",    group=grpS)
float src_pbj_bear    = input.source(close, "PBJ/PB Bear plot",       group=grpS)

grpC = "Combo Chain"
int cc_min_hits = input.int(2, "Min Hits (distinct bars)", minval=1, group=grpC)
int cc_window   = input.int(2, "Within Bars", minval=1, group=grpC)
bool cc_demo    = input.bool(false, "Demo mode (treat sources as raw bools 0/1)", group=grpC, tooltip="Off: source>0 = true. On: source!=0 = true. Use for testing with constant feeds.")

// Coerce a plotted source into a boolean (nonzero & not na = fired)
f_b(float s) => not na(s) and (cc_demo ? s != 0 : s > 0)

bool matrix_bull = f_b(src_matrix_bull)
bool fvg_bull    = f_b(src_fvg_bull)
bool pbj_bull    = f_b(src_pbj_bull)
bool matrix_bear = f_b(src_matrix_bear)
bool fvg_bear    = f_b(src_fvg_bear)
bool pbj_bear    = f_b(src_pbj_bear)

bool conf = barstate.isconfirmed

// ── BINARY-CORRECT CHAIN COUNTER ──
// per_bar_hit[t] is ONE boolean for physical bar (N-t): Matrix OR FVG on
// that SAME bar. matrix=offset0, fvg=offset-1 are both anchored to the
// physical bar they fired on for COUNTING. Same bar with both = 1.
f_chain_count(bool _isBull) =>
    int _cnt = 0
    bool _pbj = false
    for i = 0 to cc_window - 1
        // FRAME FIX v2 (2026-07-28): the header LAW is right — "FVG belongs to the bar
        // before" — but the counter read both families at the SAME index [i], which compares
        // candle t-i (matrix) against candle t-i-1 (fvg). One physical candle carrying both
        // then filled TWO slots and counted 2. The [i-1] this study removed was the mechanism
        // that PREVENTED that. Restored: both families now name the SAME physical candle t-i.
        bool _m  = _isBull ? bool(matrix_bull[i]) : bool(matrix_bear[i])
        bool _f  = i >= 1 ? (_isBull ? bool(fvg_bull[i-1]) : bool(fvg_bear[i-1])) : false
        bool _hit = _m or _f                 // <-- SAME physical candle → max 1
        if _hit
            _cnt += 1                         // each i is a distinct bar
        bool _p  = _isBull ? bool(pbj_bull[i]) : bool(pbj_bear[i])
        if _p
            _pbj := true
    [_cnt, _pbj]

[cc_cnt_bull, cc_pbj_bull] = f_chain_count(true)
[cc_cnt_bear, cc_pbj_bear] = f_chain_count(false)

// Latch: clears when no combo present this bar; sets on a fresh valid chain.
var bool cc_bull_active = false
var bool cc_bear_active = false
if conf
    if not (matrix_bull or fvg_bull)
        cc_bull_active := false
    else if not cc_bull_active and cc_cnt_bull >= cc_min_hits and cc_pbj_bull
        cc_bull_active := true
    if not (matrix_bear or fvg_bear)
        cc_bear_active := false
    else if not cc_bear_active and cc_cnt_bear >= cc_min_hits and cc_pbj_bear
        cc_bear_active := true

bool sigCCBull = conf and cc_bull_active
bool sigCCBear = conf and cc_bear_active

// FVG belongs to bar-1: chain marker plotted at offset -1 (matches parent).
plotshape(sigCCBull, "CC Bull", shape.square, location.bottom, color.new(#00BFA5, 0), text="CC", textcolor=color.white, size=size.normal, offset=-1)
plotshape(sigCCBear, "CC Bear", shape.square, location.top,    color.new(#E91E63, 0), text="CC", textcolor=color.white, size=size.normal, offset=-1)

if sigCCBull
    alert("BULL | CC (binary) | hits=" + str.tostring(cc_cnt_bull), alert.freq_once_per_bar_close)
if sigCCBear
    alert("BEAR | CC (binary) | hits=" + str.tostring(cc_cnt_bear), alert.freq_once_per_bar_close)
