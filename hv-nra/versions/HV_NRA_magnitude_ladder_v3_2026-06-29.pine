    if sz900 > 0
        rel900 := volume[1] / array.median(hist900)
        recR900 := volume[1] >= array.max(hist900)
        int gt900 = 0
        for i = 0 to sz900 - 1
            if array.get(hist900, i) > volume[1]
                gt900 := gt900 + 1
        rank900 := gt900 + 1
    else
        recR900 := true
        rank900 := 1
    recE900 := volume[1] > ever900
    ever900 := math.max(ever900, volume[1])
    array.push(hist900, volume[1])
    if array.size(hist900) > math.max(1, int(mem900 * memMult))
        array.shift(hist900)
