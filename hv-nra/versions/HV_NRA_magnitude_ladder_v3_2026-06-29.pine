//@version=5
indicator("HV Magnitude Ladder (50..4999 / HEV / HS) NRA", overlay=true, max_bars_back=5000, max_labels_count=500)

// ============================================
// === NON-REPAINTING ARCHITECTURE ===
// ============================================
// All volume comparisons use [1] (prior CLOSED bar): volume[1] == ta.highest(volume,N)[1]
// can never change once the bar closes. Markers land on the [1] bar via offset=-1.
// Plot and alert conditions share the SAME plot_* booleans -> zero plot/alert drift.
//
// ============================================
// === v3: RECENCY (which tier) vs MAGNITUDE (how big) ===
// ============================================
// The tier label (50..4999) answers "how long since volume was this high?" - a
// RECENCY measure. It does NOT say how big the bar was: a quiet-stretch dud can
// be a "1000-high", and a monster can wear a "400" sticker if a bigger bar sits
// 401-450 bars back. v3 adds a MAGNITUDE layer so every high carries how big it
// actually was, in context:
//   pop              = volume[1] / sma(volume, popBaseLen)   (X * recent average)
//   relVsPriorHighs  = volume[1] / median(last K N-bar highs) (this 1k vs prior 1ks)
//   recRecent/recEver= is this the biggest N-high in memory / ever
//   rank             = place among the ring buffer (1 = biggest)
// Markers are colored by pop by default (impressive highs glow hot). Full metadata
// is emitted on the dynamic alert() message AND via {{plot(...)}} placeholders on
// the legacy alertcondition()s.
//
// pop is a PLAIN rolling ratio - NOT the suite's session-anchored
// tv_ta.relativeVolume(). Different metric, deliberately named 'pop'.
//
// LADDER: fine 50-step 50..1000 + coarse 2000/3000/4000/4999. Top=4999 keeps the
// deepest ...[1] reference at exactly the 5000 max_bars_back ceiling. Tiers are
// NESTED -> exactly ONE tier marker per bar (the deepest reached).
// ============================================


// ============================================
// === INPUTS: TIER TOGGLES ===
// ============================================
use50    = input.bool(true, "Show 50-Bar High Vol", group="Tiers")
use100   = input.bool(true, "Show 100-Bar High Vol", group="Tiers")
use150   = input.bool(true, "Show 150-Bar High Vol", group="Tiers")
use200   = input.bool(true, "Show 200-Bar High Vol", group="Tiers")
use250   = input.bool(true, "Show 250-Bar High Vol", group="Tiers")
use300   = input.bool(true, "Show 300-Bar High Vol", group="Tiers")
use350   = input.bool(true, "Show 350-Bar High Vol", group="Tiers")
use400   = input.bool(true, "Show 400-Bar High Vol", group="Tiers")
use450   = input.bool(true, "Show 450-Bar High Vol", group="Tiers")
use500   = input.bool(true, "Show 500-Bar High Vol", group="Tiers")
use550   = input.bool(true, "Show 550-Bar High Vol", group="Tiers")
use600   = input.bool(true, "Show 600-Bar High Vol", group="Tiers")
use650   = input.bool(true, "Show 650-Bar High Vol", group="Tiers")
use700   = input.bool(true, "Show 700-Bar High Vol", group="Tiers")
use750   = input.bool(true, "Show 750-Bar High Vol", group="Tiers")
use800   = input.bool(true, "Show 800-Bar High Vol", group="Tiers")
use850   = input.bool(true, "Show 850-Bar High Vol", group="Tiers")
use900   = input.bool(true, "Show 900-Bar High Vol", group="Tiers")
use950   = input.bool(true, "Show 950-Bar High Vol", group="Tiers")
use1000  = input.bool(true, "Show 1000-Bar High Vol", group="Tiers")
use2000  = input.bool(true, "Show 2000-Bar High Vol", group="Tiers")
use3000  = input.bool(true, "Show 3000-Bar High Vol", group="Tiers")
use4000  = input.bool(true, "Show 4000-Bar High Vol", group="Tiers")
use4999  = input.bool(true, "Show 4999-Bar High Vol", group="Tiers")
useHEV   = input.bool(true, "Show All-Time High Vol (HEV)", group="Tiers")
useHS    = input.bool(true, "Show Hot Spot Signals", group="Tiers")

// === INPUTS: MAGNITUDE LAYER ===
popBaseLen = input.int(50, "pop baseline length (X * avg of last N)", minval=2, group="Magnitude")
colByPop   = input.bool(true, "Color markers by magnitude (pop)", group="Magnitude")
popExtreme = input.float(8.0, "Extreme-pop star threshold (X avg)", minval=1.0, group="Magnitude")
memMult    = input.float(1.0, "Memory depth multiplier", minval=0.1, group="Magnitude")

// === INPUTS: MEMORY (ring-buffer depth per tier) ===
// Bigger window = rarer = keep fewer; smaller window = frequent = keep more.
mem50    = input.int(49, "50-high memory depth", minval=1, group="Memory")
mem100   = input.int(48, "100-high memory depth", minval=1, group="Memory")
mem150   = input.int(47, "150-high memory depth", minval=1, group="Memory")
mem200   = input.int(46, "200-high memory depth", minval=1, group="Memory")
mem250   = input.int(45, "250-high memory depth", minval=1, group="Memory")
mem300   = input.int(44, "300-high memory depth", minval=1, group="Memory")
mem350   = input.int(43, "350-high memory depth", minval=1, group="Memory")
mem400   = input.int(42, "400-high memory depth", minval=1, group="Memory")
mem450   = input.int(41, "450-high memory depth", minval=1, group="Memory")
mem500   = input.int(40, "500-high memory depth", minval=1, group="Memory")
mem550   = input.int(39, "550-high memory depth", minval=1, group="Memory")
mem600   = input.int(38, "600-high memory depth", minval=1, group="Memory")
mem650   = input.int(37, "650-high memory depth", minval=1, group="Memory")
mem700   = input.int(36, "700-high memory depth", minval=1, group="Memory")
mem750   = input.int(35, "750-high memory depth", minval=1, group="Memory")
mem800   = input.int(34, "800-high memory depth", minval=1, group="Memory")
mem850   = input.int(33, "850-high memory depth", minval=1, group="Memory")
mem900   = input.int(32, "900-high memory depth", minval=1, group="Memory")
mem950   = input.int(31, "950-high memory depth", minval=1, group="Memory")
mem1000  = input.int(30, "1000-high memory depth", minval=1, group="Memory")
mem2000  = input.int(25, "2000-high memory depth", minval=1, group="Memory")
mem3000  = input.int(20, "3000-high memory depth", minval=1, group="Memory")
mem4000  = input.int(15, "4000-high memory depth", minval=1, group="Memory")
mem4999  = input.int(10, "4999-high memory depth", minval=1, group="Memory")

// ============================================
// === VOLUME HIGH CALCULATIONS (CONFIRMED BARS ONLY) ===
// ============================================
bool is50Bar = volume[1] == ta.highest(volume, 50)[1]
bool is100Bar = volume[1] == ta.highest(volume, 100)[1]
bool is150Bar = volume[1] == ta.highest(volume, 150)[1]
bool is200Bar = volume[1] == ta.highest(volume, 200)[1]
bool is250Bar = volume[1] == ta.highest(volume, 250)[1]
bool is300Bar = volume[1] == ta.highest(volume, 300)[1]
bool is350Bar = volume[1] == ta.highest(volume, 350)[1]
bool is400Bar = volume[1] == ta.highest(volume, 400)[1]
bool is450Bar = volume[1] == ta.highest(volume, 450)[1]
bool is500Bar = volume[1] == ta.highest(volume, 500)[1]
bool is550Bar = volume[1] == ta.highest(volume, 550)[1]
bool is600Bar = volume[1] == ta.highest(volume, 600)[1]
bool is650Bar = volume[1] == ta.highest(volume, 650)[1]
bool is700Bar = volume[1] == ta.highest(volume, 700)[1]
bool is750Bar = volume[1] == ta.highest(volume, 750)[1]
bool is800Bar = volume[1] == ta.highest(volume, 800)[1]
bool is850Bar = volume[1] == ta.highest(volume, 850)[1]
bool is900Bar = volume[1] == ta.highest(volume, 900)[1]
bool is950Bar = volume[1] == ta.highest(volume, 950)[1]
bool is1000Bar = volume[1] == ta.highest(volume, 1000)[1]
bool is2000Bar = volume[1] == ta.highest(volume, 2000)[1]
bool is3000Bar = volume[1] == ta.highest(volume, 3000)[1]
bool is4000Bar = volume[1] == ta.highest(volume, 4000)[1]
bool is4999Bar = volume[1] == ta.highest(volume, 4999)[1]

// pop = magnitude vs recent average (single short baseline, comparable across tiers).
float popBase = ta.sma(volume, popBaseLen)[1]
float pop     = (na(popBase) or popBase == 0) ? na : volume[1] / popBase

// All-Time High Volume (HEV) - running max over CONFIRMED bars only.
var float maxVolEver = 0.0
bool isHEV = false
if volume[1] > maxVolEver
    maxVolEver := volume[1]
    isHEV := true

// ============================================
// === HOT SPOT - CALENDAR-BASED SIGNALS ===
// ============================================
// Fires 3-5 trading days BEFORE ~20 known recurring high-volume events/year.
// Calendar flags use [1] bar's date so the flag matches the drawn bar.
opExWindow = dayofmonth[1] >= 10 and dayofmonth[1] <= 17 and dayofweek[1] >= dayofweek.monday and dayofweek[1] <= dayofweek.wednesday
qtrEndWindow = (month[1] == 3 or month[1] == 6 or month[1] == 9 or month[1] == 12) and dayofmonth[1] >= 23 and dayofmonth[1] <= 27
russellWindow = month[1] == 6 and dayofmonth[1] >= 19 and dayofmonth[1] <= 24
taxLossWindow = month[1] == 12 and dayofmonth[1] >= 21 and dayofmonth[1] <= 26
janEffectWindow = month[1] == 12 and dayofmonth[1] >= 27 and dayofmonth[1] <= 30
hfRedemptionWindow = (month[1] == 5 or month[1] == 11) and dayofmonth[1] >= 10 and dayofmonth[1] <= 13
bool isHotSpot = opExWindow or qtrEndWindow or russellWindow or taxLossWindow or janEffectWindow or hfRedemptionWindow


// ============================================
// === MAGNITUDE MEMORY (per-tier ring buffers) ===
// ============================================
// On each N-bar high: compare volume[1] to the last K N-highs (median/max/rank),
// flag records, then push it into the buffer (capped at the memory-depth input).
var array<float> hist50 = array.new_float(0)
var float ever50 = 0.0
float rel50 = na
int rank50 = na
bool recR50 = false
bool recE50 = false
if is50Bar
    int sz50 = array.size(hist50)
    if sz50 > 0
        rel50 := volume[1] / array.median(hist50)
        recR50 := volume[1] >= array.max(hist50)
        int gt50 = 0
        for i = 0 to sz50 - 1
            if array.get(hist50, i) > volume[1]
                gt50 := gt50 + 1
        rank50 := gt50 + 1
    else
        recR50 := true
        rank50 := 1
    recE50 := volume[1] > ever50
    ever50 := math.max(ever50, volume[1])
    array.push(hist50, volume[1])
    if array.size(hist50) > math.max(1, int(mem50 * memMult))
        array.shift(hist50)
var array<float> hist100 = array.new_float(0)
var float ever100 = 0.0
float rel100 = na
int rank100 = na
bool recR100 = false
bool recE100 = false
if is100Bar
    int sz100 = array.size(hist100)
    if sz100 > 0
        rel100 := volume[1] / array.median(hist100)
        recR100 := volume[1] >= array.max(hist100)
        int gt100 = 0
        for i = 0 to sz100 - 1
            if array.get(hist100, i) > volume[1]
                gt100 := gt100 + 1
        rank100 := gt100 + 1
    else
        recR100 := true
        rank100 := 1
    recE100 := volume[1] > ever100
    ever100 := math.max(ever100, volume[1])
    array.push(hist100, volume[1])
    if array.size(hist100) > math.max(1, int(mem100 * memMult))
        array.shift(hist100)
