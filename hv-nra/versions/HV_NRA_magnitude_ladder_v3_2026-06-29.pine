alertcondition(plot_4000, "Vol: 4000-Bar", "4000-bar high vol | pop {{plot(\"pop\")}}x | rel {{plot(\"relPrior\")}}x prior 4000-highs")
alertcondition(plot_4999, "Vol: 4999-Bar", "4999-bar high vol | pop {{plot(\"pop\")}}x | rel {{plot(\"relPrior\")}}x prior 4999-highs")
alertcondition(plot_HS, "Hot Spot", "Approaching known high-volume date (confirmed)")

// ============================================
// === SIGNAL AGGREGATION + EXPORTS (For Combination Studies) ===
// ============================================
// activeVolSignals = how deep into the ladder this bar fired (0..24), + HEV.
int activeVolSignals = (is50Bar ? 1 : 0) + (is100Bar ? 1 : 0) + (is150Bar ? 1 : 0) + (is200Bar ? 1 : 0) + (is250Bar ? 1 : 0) + (is300Bar ? 1 : 0) + (is350Bar ? 1 : 0) + (is400Bar ? 1 : 0) + (is450Bar ? 1 : 0) + (is500Bar ? 1 : 0) + (is550Bar ? 1 : 0) + (is600Bar ? 1 : 0) + (is650Bar ? 1 : 0) + (is700Bar ? 1 : 0) + (is750Bar ? 1 : 0) + (is800Bar ? 1 : 0) + (is850Bar ? 1 : 0) + (is900Bar ? 1 : 0) + (is950Bar ? 1 : 0) + (is1000Bar ? 1 : 0) + (is2000Bar ? 1 : 0) + (is3000Bar ? 1 : 0) + (is4000Bar ? 1 : 0) + (is4999Bar ? 1 : 0) + (isHEV ? 1 : 0)

var array<bool> signalStates = array.new_bool(26, false)
array.set(signalStates, 0, is50Bar)
array.set(signalStates, 1, is100Bar)
array.set(signalStates, 2, is150Bar)
array.set(signalStates, 3, is200Bar)
array.set(signalStates, 4, is250Bar)
array.set(signalStates, 5, is300Bar)
array.set(signalStates, 6, is350Bar)
array.set(signalStates, 7, is400Bar)
array.set(signalStates, 8, is450Bar)
array.set(signalStates, 9, is500Bar)
array.set(signalStates, 10, is550Bar)
array.set(signalStates, 11, is600Bar)
array.set(signalStates, 12, is650Bar)
array.set(signalStates, 13, is700Bar)
array.set(signalStates, 14, is750Bar)
array.set(signalStates, 15, is800Bar)
array.set(signalStates, 16, is850Bar)
array.set(signalStates, 17, is900Bar)
array.set(signalStates, 18, is950Bar)
array.set(signalStates, 19, is1000Bar)
array.set(signalStates, 20, is2000Bar)
array.set(signalStates, 21, is3000Bar)
array.set(signalStates, 22, is4000Bar)
array.set(signalStates, 23, is4999Bar)
array.set(signalStates, 24, isHEV)
array.set(signalStates, 25, isHotSpot)

// EXPORTS:
//   Tiers (bool):       is50Bar .. is4999Bar (step 50 to 1000, then 2000/3000/4000/4999), isHEV, isHotSpot
//   Plot conditions:    plot_HEV, plot_4999 .. plot_50, plot_HS
//   Magnitude (float):  pop, dispRel; per-tier rel{N}, rank{N}; flags recR{N}/recE{N}
//   Displayed high:     dispN, dispTier, dispRel, dispRank, dispBuf, dispRecR, dispRecE
//   Aggregations:       activeVolSignals (0..25), signalStates[26]
