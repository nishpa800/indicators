        rel150 := volume[1] / array.median(hist150)
        recR150 := volume[1] >= array.max(hist150)
        int gt150 = 0
        for i = 0 to sz150 - 1
            if array.get(hist150, i) > volume[1]
                gt150 := gt150 + 1
        rank150 := gt150 + 1
    else
        recR150 := true
        rank150 := 1
    recE150 := volume[1] > ever150
    ever150 := math.max(ever150, volume[1])
    array.push(hist150, volume[1])
    if array.size(hist150) > math.max(1, int(mem150 * memMult))
        array.shift(hist150)
