//@version=5
// ============================================================================
// HV ROLL v2  --  15 CUMULATIVE rolling-window high-volume cluster detectors
// ============================================================================
// WHAT CHANGED vs the old "HV ROLLING CLUSTERS"
//   Every "only" band ("500 only", "250-or-500", "150 only") is REPLACED with a
//   CUMULATIVE ">= threshold" class. A "1000+" window counts every 1000-bar
//   high OR RARER (up to all-time). Strength never leaks out of a bucket: a
//   bigger high still counts in every smaller-or-equal window. Raw tiers come
//   from the full 50-step -> 4K mega ladder (50..1000 step 50, then
//   1500/2000/3000/4000, plus HEV all-time).
//
// THE 15 WINDOWS (all CUMULATIVE ">="; rarest -> most common)
//   W1  HEV (all-time-high vol / Nagasaki)   W9   400+
//   W2  4000+                                W10  300+
//   W3  3000+                                W11  250+
//   W4  2000+                                W12  200+
//   W5  1500+                                W13  150+
//   W6  1000+                                W14  100+
//   W7  750+                                 W15  50+
//   W8  500+
//   CUMULATIVE BY CONSTRUCTION: is{N}Bar == "volume[1] is the max of the last N
//   closed bars" is TRUE for an N-bar high OR anything rarer, so the raw nested
//   tier flag IS the ">=" class. NO "not is{bigger}Bar" subtraction (that is
//   what made the old "only" bands). Each window: "at least COUNT events of its
//   class within the last BARS bars?"  COUNT and BARS are inputs on EVERY window.
//
// DERIVATIVE / CALCULUS -> default window sizing
//   Model each ">= N" class as ~Poisson: P(a closed bar is a new N-bar high) ~ 1/N,
//   so it fires ~ once per N bars. The rolling count n_t is the moving SUM (a
//   discrete INTEGRAL) of that event stream; its 1st difference is clustering
//   VELOCITY, its 2nd difference is ACCELERATION (bursts). Random baseline in a
//   W-bar window is E[n] = W/N. Requiring a fire to mean "events D-times denser
//   than random" gives  W = round(COUNT * N / D).  Shipped D = 2 for all 15:
//   every fire == ~2x random density. Only the window length scales with tier
//   rarity. TIGHTER window / higher COUNT -> sharper derivative -> more motion.
//
// NON-REPAINTING (NRA) + CONSTITUTIONAL ROLLING WINDOWS
//   * Tiers compare the PRIOR CLOSED bar: volume[1] == ta.highest(volume,N)[1].
//   * Counting gated on barstate.isconfirmed (closed bars only).
//   * Each window is a TRUE SLIDING trailing-N moving sum (math.sum, O(1)/bar) --
//     NOT an anchored wait-N-then-reset window (passes check_no_fixed_windows.sh).
//   * Fire = LEADING EDGE of (n >= COUNT):  cond and not cond[1]  -> fires once,
//     then re-arms. Plot and alert share ONE boolean (1:1, can never desync).
//   * Markers plot offset=-1 onto the closed bar that completed the cluster.
//
// GENERATED by hv-nra/build_hv_roll_15.py -- edit the generator, not this file.
// ASCII-only source (TradingView's Pine lexer rejects non-ASCII punctuation).
// ============================================================================

indicator("HV ROLL 15 (cumulative >= 50-4K ladder) NRA", shorttitle="HV ROLL 15", overlay=true, max_bars_back=5000)

// --- Rolling SLIDING count: TRUE events over the trailing `len` bars (O(1)/bar,
// --- not anchored). nz() keeps early bars at 0 instead of na.
f_roll_count(cond, len) => nz(math.sum(cond ? 1.0 : 0.0, math.max(1, len)))


// ============================================================================
// === INPUTS -- per window: Enable + COUNT (events) + within BARS (window) ===
// ============================================================================
// Defaults derive from W = round(COUNT * N / 2) (fire == ~2x random density).
// Tune freely: smaller BARS or larger COUNT = tighter/faster = more motion.
grp1  = "W1: HEV / Nagasaki (all-time-high vol)"
w1_on  = input.bool(true, "Enable W1 HEV", group=grp1)
w1_cnt = input.int(2, "Count (events)", minval=1, inline="w1", group=grp1)
w1_win = input.int(1000, "within Bars", minval=1, maxval=5000, inline="w1", group=grp1)

grp2  = "W2: 4000-bar high or greater"
w2_on  = input.bool(true, "Enable W2 4K+", group=grp2)
w2_cnt = input.int(2, "Count (events)", minval=1, inline="w2", group=grp2)
w2_win = input.int(4000, "within Bars", minval=1, maxval=5000, inline="w2", group=grp2)

grp3  = "W3: 3000-bar high or greater"
w3_on  = input.bool(true, "Enable W3 3K+", group=grp3)
w3_cnt = input.int(2, "Count (events)", minval=1, inline="w3", group=grp3)
w3_win = input.int(3000, "within Bars", minval=1, maxval=5000, inline="w3", group=grp3)

grp4  = "W4: 2000-bar high or greater"
w4_on  = input.bool(true, "Enable W4 2K+", group=grp4)
w4_cnt = input.int(2, "Count (events)", minval=1, inline="w4", group=grp4)
w4_win = input.int(2000, "within Bars", minval=1, maxval=5000, inline="w4", group=grp4)

grp5  = "W5: 1500-bar high or greater"
w5_on  = input.bool(true, "Enable W5 1.5K+", group=grp5)
w5_cnt = input.int(2, "Count (events)", minval=1, inline="w5", group=grp5)
w5_win = input.int(1500, "within Bars", minval=1, maxval=5000, inline="w5", group=grp5)

grp6  = "W6: 1000-bar high or greater"
w6_on  = input.bool(true, "Enable W6 1K+", group=grp6)
w6_cnt = input.int(2, "Count (events)", minval=1, inline="w6", group=grp6)
w6_win = input.int(1000, "within Bars", minval=1, maxval=5000, inline="w6", group=grp6)

grp7  = "W7: 750-bar high or greater"
w7_on  = input.bool(true, "Enable W7 750+", group=grp7)
w7_cnt = input.int(2, "Count (events)", minval=1, inline="w7", group=grp7)
w7_win = input.int(750, "within Bars", minval=1, maxval=5000, inline="w7", group=grp7)

grp8  = "W8: 500-bar high or greater"
w8_on  = input.bool(true, "Enable W8 500+", group=grp8)
w8_cnt = input.int(3, "Count (events)", minval=1, inline="w8", group=grp8)
w8_win = input.int(750, "within Bars", minval=1, maxval=5000, inline="w8", group=grp8)

grp9  = "W9: 400-bar high or greater"
w9_on  = input.bool(true, "Enable W9 400+", group=grp9)
w9_cnt = input.int(3, "Count (events)", minval=1, inline="w9", group=grp9)
w9_win = input.int(600, "within Bars", minval=1, maxval=5000, inline="w9", group=grp9)

grp10  = "W10: 300-bar high or greater"
w10_on  = input.bool(true, "Enable W10 300+", group=grp10)
w10_cnt = input.int(3, "Count (events)", minval=1, inline="w10", group=grp10)
w10_win = input.int(450, "within Bars", minval=1, maxval=5000, inline="w10", group=grp10)

grp11  = "W11: 250-bar high or greater"
w11_on  = input.bool(true, "Enable W11 250+", group=grp11)
w11_cnt = input.int(3, "Count (events)", minval=1, inline="w11", group=grp11)
w11_win = input.int(375, "within Bars", minval=1, maxval=5000, inline="w11", group=grp11)

grp12  = "W12: 200-bar high or greater"
w12_on  = input.bool(true, "Enable W12 200+", group=grp12)
w12_cnt = input.int(4, "Count (events)", minval=1, inline="w12", group=grp12)
w12_win = input.int(400, "within Bars", minval=1, maxval=5000, inline="w12", group=grp12)

grp13  = "W13: 150-bar high or greater"
w13_on  = input.bool(true, "Enable W13 150+", group=grp13)
w13_cnt = input.int(4, "Count (events)", minval=1, inline="w13", group=grp13)
w13_win = input.int(300, "within Bars", minval=1, maxval=5000, inline="w13", group=grp13)

grp14  = "W14: 100-bar high or greater"
w14_on  = input.bool(true, "Enable W14 100+", group=grp14)
w14_cnt = input.int(4, "Count (events)", minval=1, inline="w14", group=grp14)
w14_win = input.int(200, "within Bars", minval=1, maxval=5000, inline="w14", group=grp14)

grp15  = "W15: 50-bar high or greater"
w15_on  = input.bool(true, "Enable W15 50+", group=grp15)
w15_cnt = input.int(5, "Count (events)", minval=1, inline="w15", group=grp15)
w15_win = input.int(125, "within Bars", minval=1, maxval=5000, inline="w15", group=grp15)

// ============================================================================
// === RAW TIER FLAGS (counting material only -- no own plot/alert) ===
// ============================================================================
// volume[1] == ta.highest(volume,N)[1] on the PRIOR CLOSED bar -> can never
// change once the bar closes (non-repainting). Each flag is already the
// CUMULATIVE ">= N" class (an N-bar high implies every shorter-tier high).
bool is50Bar = volume[1] == ta.highest(volume, 50)[1]
bool is100Bar = volume[1] == ta.highest(volume, 100)[1]
bool is150Bar = volume[1] == ta.highest(volume, 150)[1]
bool is200Bar = volume[1] == ta.highest(volume, 200)[1]
bool is250Bar = volume[1] == ta.highest(volume, 250)[1]
bool is300Bar = volume[1] == ta.highest(volume, 300)[1]
bool is400Bar = volume[1] == ta.highest(volume, 400)[1]
bool is500Bar = volume[1] == ta.highest(volume, 500)[1]
bool is750Bar = volume[1] == ta.highest(volume, 750)[1]
bool is1000Bar = volume[1] == ta.highest(volume, 1000)[1]
bool is1500Bar = volume[1] == ta.highest(volume, 1500)[1]
bool is2000Bar = volume[1] == ta.highest(volume, 2000)[1]
bool is3000Bar = volume[1] == ta.highest(volume, 3000)[1]
bool is4000Bar = volume[1] == ta.highest(volume, 4000)[1]

// All-time-high volume (HEV == Nagasaki) -- running max over CONFIRMED bars only.
var float maxVolEver = 0.0
bool isHEV = false
if volume[1] > maxVolEver
    maxVolEver := volume[1]
    isHEV := true
bool isNagasaki = isHEV

// ============================================================================
// === CLASS EVENTS (confirmed bars only) -- raw material each window counts ===
// ============================================================================
bool conf = barstate.isconfirmed
bool evt_W1 = conf and isHEV   // W1  HEV (>=)
bool evt_W2 = conf and is4000Bar   // W2  4K+ (>=)
bool evt_W3 = conf and is3000Bar   // W3  3K+ (>=)
bool evt_W4 = conf and is2000Bar   // W4  2K+ (>=)
bool evt_W5 = conf and is1500Bar   // W5  1.5K+ (>=)
bool evt_W6 = conf and is1000Bar   // W6  1K+ (>=)
bool evt_W7 = conf and is750Bar   // W7  750+ (>=)
bool evt_W8 = conf and is500Bar   // W8  500+ (>=)
bool evt_W9 = conf and is400Bar   // W9  400+ (>=)
bool evt_W10 = conf and is300Bar   // W10  300+ (>=)
bool evt_W11 = conf and is250Bar   // W11  250+ (>=)
bool evt_W12 = conf and is200Bar   // W12  200+ (>=)
bool evt_W13 = conf and is150Bar   // W13  150+ (>=)
bool evt_W14 = conf and is100Bar   // W14  100+ (>=)
bool evt_W15 = conf and is50Bar   // W15  50+ (>=)

// ============================================================================
// === ROLLING-WINDOW CLUSTER DETECTIONS (sliding trailing-N, leading-edge) ===
// ============================================================================
// nN = events of class in trailing winN bars.  cN = nN >= countN.
// fire_WN = leading edge of cN (fires once when the cluster completes).
float n1 = f_roll_count(evt_W1, w1_win)
float n2 = f_roll_count(evt_W2, w2_win)
float n3 = f_roll_count(evt_W3, w3_win)
float n4 = f_roll_count(evt_W4, w4_win)
float n5 = f_roll_count(evt_W5, w5_win)
float n6 = f_roll_count(evt_W6, w6_win)
float n7 = f_roll_count(evt_W7, w7_win)
float n8 = f_roll_count(evt_W8, w8_win)
float n9 = f_roll_count(evt_W9, w9_win)
float n10 = f_roll_count(evt_W10, w10_win)
float n11 = f_roll_count(evt_W11, w11_win)
float n12 = f_roll_count(evt_W12, w12_win)
float n13 = f_roll_count(evt_W13, w13_win)
float n14 = f_roll_count(evt_W14, w14_win)
float n15 = f_roll_count(evt_W15, w15_win)

bool c1 = n1 >= w1_cnt
bool c2 = n2 >= w2_cnt
bool c3 = n3 >= w3_cnt
bool c4 = n4 >= w4_cnt
bool c5 = n5 >= w5_cnt
bool c6 = n6 >= w6_cnt
bool c7 = n7 >= w7_cnt
bool c8 = n8 >= w8_cnt
bool c9 = n9 >= w9_cnt
bool c10 = n10 >= w10_cnt
bool c11 = n11 >= w11_cnt
bool c12 = n12 >= w12_cnt
bool c13 = n13 >= w13_cnt
bool c14 = n14 >= w14_cnt
bool c15 = n15 >= w15_cnt

bool fire_W1 = w1_on and c1 and not c1[1]
bool fire_W2 = w2_on and c2 and not c2[1]
bool fire_W3 = w3_on and c3 and not c3[1]
bool fire_W4 = w4_on and c4 and not c4[1]
bool fire_W5 = w5_on and c5 and not c5[1]
bool fire_W6 = w6_on and c6 and not c6[1]
bool fire_W7 = w7_on and c7 and not c7[1]
bool fire_W8 = w8_on and c8 and not c8[1]
bool fire_W9 = w9_on and c9 and not c9[1]
bool fire_W10 = w10_on and c10 and not c10[1]
bool fire_W11 = w11_on and c11 and not c11[1]
bool fire_W12 = w12_on and c12 and not c12[1]
bool fire_W13 = w13_on and c13 and not c13[1]
bool fire_W14 = w14_on and c14 and not c14[1]
bool fire_W15 = w15_on and c15 and not c15[1]

// ============================================================================
// === PLOTS -- 15 cumulative detectors (offset=-1 -> lands on the closed bar
// === that completed the cluster). Windows are independent: several scales
// === can light up on the same bar -- that overlap IS the multi-scale motion.
// ============================================================================
plotshape(fire_W1, "W1 HEV cumulative", shape.diamond, location.top, color.new(color.purple, 0), size=size.large, text="HEV", textcolor=color.white, offset=-1)
plotshape(fire_W2, "W2 4K+ cumulative", shape.circle, location.top, color.rgb(240, 45, 55, 0), size=size.large, text="4K+", textcolor=color.white, offset=-1)
plotshape(fire_W3, "W3 3K+ cumulative", shape.circle, location.top, color.rgb(224, 45, 71, 0), size=size.large, text="3K+", textcolor=color.white, offset=-1)
plotshape(fire_W4, "W4 2K+ cumulative", shape.circle, location.top, color.rgb(209, 45, 86, 0), size=size.large, text="2K+", textcolor=color.white, offset=-1)
plotshape(fire_W5, "W5 1.5K+ cumulative", shape.circle, location.top, color.rgb(194, 45, 101, 0), size=size.normal, text="1.5K+", textcolor=color.white, offset=-1)
plotshape(fire_W6, "W6 1K+ cumulative", shape.circle, location.top, color.rgb(178, 45, 117, 0), size=size.normal, text="1K+", textcolor=color.white, offset=-1)
plotshape(fire_W7, "W7 750+ cumulative", shape.circle, location.top, color.rgb(163, 45, 132, 0), size=size.normal, text="750+", textcolor=color.white, offset=-1)
plotshape(fire_W8, "W8 500+ cumulative", shape.circle, location.top, color.rgb(148, 45, 148, 0), size=size.small, text="500+", textcolor=color.white, offset=-1)
plotshape(fire_W9, "W9 400+ cumulative", shape.triangledown, location.bottom, color.rgb(132, 45, 163, 0), size=size.small, text="400+", textcolor=color.white, offset=-1)
plotshape(fire_W10, "W10 300+ cumulative", shape.triangledown, location.bottom, color.rgb(117, 45, 178, 0), size=size.small, text="300+", textcolor=color.white, offset=-1)
plotshape(fire_W11, "W11 250+ cumulative", shape.triangledown, location.bottom, color.rgb(101, 45, 194, 0), size=size.small, text="250+", textcolor=color.white, offset=-1)
plotshape(fire_W12, "W12 200+ cumulative", shape.triangledown, location.bottom, color.rgb(86, 45, 209, 0), size=size.tiny, text="200+", textcolor=color.white, offset=-1)
plotshape(fire_W13, "W13 150+ cumulative", shape.cross, location.bottom, color.rgb(71, 45, 224, 0), size=size.tiny, text="150+", textcolor=color.white, offset=-1)
plotshape(fire_W14, "W14 100+ cumulative", shape.cross, location.bottom, color.rgb(55, 45, 240, 0), size=size.tiny, text="100+", textcolor=color.white, offset=-1)
plotshape(fire_W15, "W15 50+ cumulative", shape.cross, location.bottom, color.rgb(40, 45, 255, 0), size=size.tiny, text="50+", textcolor=color.white, offset=-1)

// Numeric counts (data-window only -- helps tune COUNT/BARS).
plot(n1, "W1 count (HEV)", display=display.data_window)
plot(n2, "W2 count (4K+)", display=display.data_window)
plot(n3, "W3 count (3K+)", display=display.data_window)
plot(n4, "W4 count (2K+)", display=display.data_window)
plot(n5, "W5 count (1.5K+)", display=display.data_window)
plot(n6, "W6 count (1K+)", display=display.data_window)
plot(n7, "W7 count (750+)", display=display.data_window)
plot(n8, "W8 count (500+)", display=display.data_window)
plot(n9, "W9 count (400+)", display=display.data_window)
plot(n10, "W10 count (300+)", display=display.data_window)
plot(n11, "W11 count (250+)", display=display.data_window)
plot(n12, "W12 count (200+)", display=display.data_window)
plot(n13, "W13 count (150+)", display=display.data_window)
plot(n14, "W14 count (100+)", display=display.data_window)
plot(n15, "W15 count (50+)", display=display.data_window)

// ============================================================================
// === MOTION READOUTS (the calculus, on tap) -- data-window only ===
// ============================================================================
// clusterLoad = how many of the 15 scales are CURRENTLY in an active cluster
// state (c1..c15). Its 1st difference is motion VELOCITY, 2nd is ACCELERATION.
// When many scales light up together, that is strong coordinated motion.
int clusterLoad = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) + (c5 ? 1 : 0) + (c6 ? 1 : 0) + (c7 ? 1 : 0) + (c8 ? 1 : 0) + (c9 ? 1 : 0) + (c10 ? 1 : 0) + (c11 ? 1 : 0) + (c12 ? 1 : 0) + (c13 ? 1 : 0) + (c14 ? 1 : 0) + (c15 ? 1 : 0)
int activeWindows = (fire_W1 ? 1 : 0) + (fire_W2 ? 1 : 0) + (fire_W3 ? 1 : 0) + (fire_W4 ? 1 : 0) + (fire_W5 ? 1 : 0) + (fire_W6 ? 1 : 0) + (fire_W7 ? 1 : 0) + (fire_W8 ? 1 : 0) + (fire_W9 ? 1 : 0) + (fire_W10 ? 1 : 0) + (fire_W11 ? 1 : 0) + (fire_W12 ? 1 : 0) + (fire_W13 ? 1 : 0) + (fire_W14 ? 1 : 0) + (fire_W15 ? 1 : 0)
float motionVel = ta.change(clusterLoad)        // d(clusterLoad)/dbar  -- velocity
float motionAcc = ta.change(motionVel)          // d2(clusterLoad)/dbar2 -- acceleration
plot(clusterLoad,   "clusterLoad (0..15)",   color=color.white,  display=display.data_window)
plot(activeWindows, "activeWindows (0..15)", color=color.aqua,   display=display.data_window)
plot(motionVel,     "motion velocity",       color=color.lime,   display=display.data_window)
plot(motionAcc,     "motion acceleration",   color=color.orange, display=display.data_window)

// ============================================================================
// === ALERTS -- per-window (1:1 with plots), plus ANY + any-call() ===
// ============================================================================
alertcondition(fire_W1, "W1 HEV cumulative", "W1: HEV (>=) cluster on {{ticker}}")
alertcondition(fire_W2, "W2 4K+ cumulative", "W2: 4K+ (>=) cluster on {{ticker}}")
alertcondition(fire_W3, "W3 3K+ cumulative", "W3: 3K+ (>=) cluster on {{ticker}}")
alertcondition(fire_W4, "W4 2K+ cumulative", "W4: 2K+ (>=) cluster on {{ticker}}")
alertcondition(fire_W5, "W5 1.5K+ cumulative", "W5: 1.5K+ (>=) cluster on {{ticker}}")
alertcondition(fire_W6, "W6 1K+ cumulative", "W6: 1K+ (>=) cluster on {{ticker}}")
alertcondition(fire_W7, "W7 750+ cumulative", "W7: 750+ (>=) cluster on {{ticker}}")
alertcondition(fire_W8, "W8 500+ cumulative", "W8: 500+ (>=) cluster on {{ticker}}")
alertcondition(fire_W9, "W9 400+ cumulative", "W9: 400+ (>=) cluster on {{ticker}}")
alertcondition(fire_W10, "W10 300+ cumulative", "W10: 300+ (>=) cluster on {{ticker}}")
alertcondition(fire_W11, "W11 250+ cumulative", "W11: 250+ (>=) cluster on {{ticker}}")
alertcondition(fire_W12, "W12 200+ cumulative", "W12: 200+ (>=) cluster on {{ticker}}")
alertcondition(fire_W13, "W13 150+ cumulative", "W13: 150+ (>=) cluster on {{ticker}}")
alertcondition(fire_W14, "W14 100+ cumulative", "W14: 100+ (>=) cluster on {{ticker}}")
alertcondition(fire_W15, "W15 50+ cumulative", "W15: 50+ (>=) cluster on {{ticker}}")

bool any_fire = fire_W1 or fire_W2 or fire_W3 or fire_W4 or fire_W5 or fire_W6 or fire_W7 or fire_W8 or fire_W9 or fire_W10 or fire_W11 or fire_W12 or fire_W13 or fire_W14 or fire_W15
alertcondition(any_fire, "ANY HV cumulative cluster", "ANY HV cumulative rolling cluster fired on {{ticker}}")

// any-call alert() function: set ONE TradingView alert to "Any alert() function
// call" and it catches every window. Payload names which windows fired this bar.
if any_fire and conf
    string m = ""
    m := fire_W1 ? m + "HEV " : m
    m := fire_W2 ? m + "4K+ " : m
    m := fire_W3 ? m + "3K+ " : m
    m := fire_W4 ? m + "2K+ " : m
    m := fire_W5 ? m + "1.5K+ " : m
    m := fire_W6 ? m + "1K+ " : m
    m := fire_W7 ? m + "750+ " : m
    m := fire_W8 ? m + "500+ " : m
    m := fire_W9 ? m + "400+ " : m
    m := fire_W10 ? m + "300+ " : m
    m := fire_W11 ? m + "250+ " : m
    m := fire_W12 ? m + "200+ " : m
    m := fire_W13 ? m + "150+ " : m
    m := fire_W14 ? m + "100+ " : m
    m := fire_W15 ? m + "50+ " : m
    alert("HV_ROLL15|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|FIRED:" + m, alert.freq_once_per_bar_close)

// ============================================================================
// === EXPORTS (for combination / fire-matrix consumers) ===
// ============================================================================
// Raw tiers (bool, cumulative >=): is50Bar, is100Bar, is150Bar, is200Bar, is250Bar, is300Bar, is400Bar, is500Bar, is750Bar, is1000Bar, is1500Bar, is2000Bar, is3000Bar, is4000Bar, isHEV (== isNagasaki)
// Window fires (bool):   fire_W1 .. fire_W15
// Window counts (float): n1 .. n15
// Motion (int/float):    clusterLoad(0..15), activeWindows(0..15), motionVel, motionAcc
