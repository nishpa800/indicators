grp_fp_B = "FAUNA+ BRAVO — Disp Set 2"
fp_b_rng      = input.string("Open to Close", "Range Type", options=["Open to Close", "High to Low"], group=grp_fp_B)
fp_b_mult     = input.int(5, "Std Dev Multiplier", minval=0, group=grp_fp_B)
fp_b_req      = input.int(3, "Required Hits", minval=1, group=grp_fp_B)
fp_b_win      = input.int(3, "Within X Bars", minval=1, group=grp_fp_B)
fp_b_fb       = input.bool(false, "First Bar of Day Only", group=grp_fp_B)
fp_b_fauna_rq = input.int(0, "Require Fauna (0=off)", minval=0, group=grp_fp_B)
