grp_fp_E = "FAUNA+ ECHO — Disp Set 5"
fp_e_rng      = input.string("Open to Close", "Range Type", options=["Open to Close", "High to Low"], group=grp_fp_E)
fp_e_mult     = input.int(5, "Std Dev Multiplier", minval=0, group=grp_fp_E)
fp_e_req      = input.int(2, "Required Hits", minval=1, group=grp_fp_E)
fp_e_win      = input.int(4, "Within X Bars", minval=1, group=grp_fp_E)
fp_e_fb       = input.bool(false, "First Bar of Day Only", group=grp_fp_E)
fp_e_fauna_rq = input.int(0, "Require Fauna (0=off)", minval=0, group=grp_fp_E)
fp_e_pp_rq    = input.int(0, "Require PUP/PPD (0=off)", minval=0, group=grp_fp_E)
