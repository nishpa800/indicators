fp_c_win      = input.int(4, "Within X Bars", minval=1, group=grp_fp_C)
fp_c_fb       = input.bool(false, "First Bar of Day Only", group=grp_fp_C)
fp_c_fauna_rq = input.int(0, "Require Fauna (0=off)", minval=0, group=grp_fp_C)
fp_c_pp_rq    = input.int(0, "Require PUP/PPD (0=off)", minval=0, group=grp_fp_C)
