    string pbj_col = anyBearPBJ[1] ? "PBJ" : "No"
    string extras = ""
    if sigBearRVOL1x[1] or sigMOAB[1]
        extras += (sigMOAB[1] ? "MOAB" : "RVOL Bearish 1x") + ", "
    if sigWhaleBear[1]
        extras += "WHALE, "
    extras := str.length(extras) > 2 ? str.substring(extras, 0, str.length(extras) - 2) : extras
    alert("{{ticker}} | BEAR | " + pp_col + " | " + pbj_col + " | KATANA |  | " + extras + " | \"Session, FAUNA, HVFVG, GZI, PPD/PBJ\" | " + priceStr, alert.freq_once_per_bar_close)

// ===================== NAGASAKI (offset 0) =====================
if nag_gate_bull and sigNagasakiBull
    string pp_col = sigPUP ? "PUP" : "No"
    string pbj_col = anyBullPBJ ? "PBJ" : "No"
    string extras = ""
    if sigGrandSlam
        extras += "Grand Slam, "
    else if sigBullRVOL1x
        extras += "RVOL Bullish 1x, "
    if sigFAUNABull
        extras += "FAUNA, "
    if sigDISPBull
        extras += "DISP, "
    if gz_bullHV
        extras += "HVFVG, "
    if gz_bullGZI
        extras += "GZI, "
    if sigWhaleBull
        extras += "WHALE, "
    extras := str.length(extras) > 2 ? str.substring(extras, 0, str.length(extras) - 2) : extras
    alert("{{ticker}} | BULL | " + pp_col + " | " + pbj_col + " | NAGASAKI |  | " + extras + " | \"Highest Ever Volume\" | " + priceStr, alert.freq_once_per_bar_close)

if nag_gate_bear and sigNagasakiBear
    string pp_col = sigPPD ? "PPD" : "No"
    string pbj_col = anyBearPBJ ? "PBJ" : "No"
    string extras = ""
    if sigMOAB
        extras += "MOAB, "
    else if sigBearRVOL1x
        extras += "RVOL Bearish 1x, "
    if sigFAUNABear
        extras += "FAUNA, "
    if sigDISPBear
        extras += "DISP, "
    if gz_bearHV
        extras += "HVFVG, "
    if gz_bearGZI
        extras += "GZI, "
    if sigWhaleBear
        extras += "WHALE, "
    extras := str.length(extras) > 2 ? str.substring(extras, 0, str.length(extras) - 2) : extras
    alert("{{ticker}} | BEAR | " + pp_col + " | " + pbj_col + " | NAGASAKI |  | " + extras + " | \"Highest Ever Volume\" | " + priceStr, alert.freq_once_per_bar_close)

// ===================== PAF B2B (offset 0) =====================
if show_PAFBull and sigPAFBull
    string pbj_col = anyBullPBJ ? "PBJ" : "No"
    string extras = ""
    if sigBullRVOL1x or sigGrandSlam
        extras += f_rvol_name_bull_raw() + ", "
    if sigDISPBull
        extras += "DISP, "
    if gz_bullHV
        extras += "HVFVG, "
    if gz_bullGZI
        extras += "GZI, "
    if sigWhaleBull
        extras += "WHALE, "
    extras := str.length(extras) > 2 ? str.substring(extras, 0, str.length(extras) - 2) : extras
    alert("{{ticker}} | BULL | PUP | " + pbj_col + " | PAF PUP B2B |  | " + extras + " | \"PUP B2B, FAUNA B2B\" | " + priceStr, alert.freq_once_per_bar_close)

if show_PAFBear and sigPAFBear
    string pbj_col = anyBearPBJ ? "PBJ" : "No"
    string extras = ""
    if sigBearRVOL1x or sigMOAB
        extras += f_rvol_name_bear_raw() + ", "
    if sigDISPBear
        extras += "DISP, "
    if gz_bearHV
        extras += "HVFVG, "
    if gz_bearGZI
        extras += "GZI, "
    if sigWhaleBear
        extras += "WHALE, "
    extras := str.length(extras) > 2 ? str.substring(extras, 0, str.length(extras) - 2) : extras
    alert("{{ticker}} | BEAR | PPD | " + pbj_col + " | PAF PPD B2B |  | " + extras + " | \"PPD B2B, FAUNA B2B\" | " + priceStr, alert.freq_once_per_bar_close)

// ===================== FAUNA+ ALERTS (offset -1) =====================
// Aggregate FAUNA+ signal for single alert
bool anyFPBull = sigAlphaBull or sigBravoBull or sigCharlieBull or sigDeltaBull or sigEchoBull or sigFoxtrotBull or sigGolfBull or sigODBull
bool anyFPBear = sigAlphaBear or sigBravoBear or sigCharlieBear or sigDeltaBear or sigEchoBear or sigFoxtrotBear or sigGolfBear or sigODBear

if anyFPBull
    string pp_col = sigPUP[1] ? "PUP" : "No"
    string pbj_col = anyBullPBJ[1] ? "PBJ" : "No"
    string sig_name = sigAlphaBull ? "ALPHA" : sigBravoBull ? "BRAVO" : sigCharlieBull ? "CHARLIE" : sigDeltaBull ? "DELTA" : sigEchoBull ? "ECHO" : sigFoxtrotBull ? "FOXTROT" : sigGolfBull ? "GOLF" : "OPENING DRIVE"
    string extras = ""
    if sigBullRVOL1x[1] or sigGrandSlam[1]
        extras += (sigGrandSlam[1] ? "Grand Slam" : "RVOL Bullish 1x") + ", "
    if sigDISPBull[1]
        extras += "DISP, "
    if gz_bullHV[1]
        extras += "HVFVG, "
    if gz_bullGZI[1]
        extras += "GZI, "
    if sigWhaleBull[1]
        extras += "WHALE, "
    extras := str.length(extras) > 2 ? str.substring(extras, 0, str.length(extras) - 2) : extras
    alert("{{ticker}} | BULL | " + pp_col + " | " + pbj_col + " | " + sig_name + " |  | " + extras + " | \"FAUNA+ Density\" | " + priceStr, alert.freq_once_per_bar_close)

if anyFPBear
    string pp_col = sigPPD[1] ? "PPD" : "No"
    string pbj_col = anyBearPBJ[1] ? "PBJ" : "No"
    string sig_name = sigAlphaBear ? "ALPHA" : sigBravoBear ? "BRAVO" : sigCharlieBear ? "CHARLIE" : sigDeltaBear ? "DELTA" : sigEchoBear ? "ECHO" : sigFoxtrotBear ? "FOXTROT" : sigGolfBear ? "GOLF" : "OPENING DRIVE"
    string extras = ""
    if sigBearRVOL1x[1] or sigMOAB[1]
        extras += (sigMOAB[1] ? "MOAB" : "RVOL Bearish 1x") + ", "
    if sigDISPBear[1]
        extras += "DISP, "
    if gz_bearHV[1]
        extras += "HVFVG, "
    if gz_bearGZI[1]
        extras += "GZI, "
    if sigWhaleBear[1]
        extras += "WHALE, "
    extras := str.length(extras) > 2 ? str.substring(extras, 0, str.length(extras) - 2) : extras
    alert("{{ticker}} | BEAR | " + pp_col + " | " + pbj_col + " | " + sig_name + " |  | " + extras + " | \"FAUNA+ Density\" | " + priceStr, alert.freq_once_per_bar_close)

// ===================== PUP + ANY SIGNAL ALERT (offset 0) =====================
if show_PUP and sigPUP and fb0
    string sigs = ""
    if sigFAUNABull
        sigs += "FAUNA, "
    if sigDISPBull
        sigs += "DISP, "
    if sigGrandSlam
        sigs += "Grand Slam, "
    else if sigBullRVOL1x
        sigs += "RVOL Bullish 1x, "
    if sigSAAB
        sigs += "SAAB2, "
    if gz_bullHV
        sigs += "HVFVG, "
    if gz_bullGZI
        sigs += "GZI, "
    if sigWhaleBull
        sigs += "WHALE, "
    if sigHV
        sigs += "HV, "
    if sigNagasaki
        sigs += "NAGASAKI, "
    sigs := str.length(sigs) > 2 ? str.substring(sigs, 0, str.length(sigs) - 2) : sigs
    if str.length(sigs) > 0
        alert("{{ticker}} | BULL | PUP | " + (anyBullPBJ ? "PBJ" : "No") + " | PUP+ANY |  | " + sigs + " |  | " + priceStr, alert.freq_once_per_bar_close)

if show_PPD and sigPPD and fb0
    string sigs = ""
    if sigFAUNABear
        sigs += "FAUNA, "
    if sigDISPBear
        sigs += "DISP, "
    if sigMOAB
        sigs += "MOAB, "
    else if sigBearRVOL1x
        sigs += "RVOL Bearish 1x, "
    if sigKratos
        sigs += "KRATOS2, "
    if gz_bearHV
        sigs += "HVFVG, "
    if gz_bearGZI
        sigs += "GZI, "
    if sigWhaleBear
        sigs += "WHALE, "
    if sigHV
        sigs += "HV, "
    if sigNagasaki
        sigs += "NAGASAKI, "
    sigs := str.length(sigs) > 2 ? str.substring(sigs, 0, str.length(sigs) - 2) : sigs
    if str.length(sigs) > 0
        alert("{{ticker}} | BEAR | PPD | " + (anyBearPBJ ? "PBJ" : "No") + " | PPD+ANY |  | " + sigs + " |  | " + priceStr, alert.freq_once_per_bar_close)

// ===================== alertcondition() — STATIC ALERTS =====================
alertcondition(show_GrandSlam and sigGrandSlam and fb0, "Grand Slam", "Grand Slam fired")
alertcondition(show_MOAB and sigMOAB and fb0, "MOAB", "MOAB fired")
alertcondition(show_WhaleBull and sigWhaleBull, "Whale Bull", "Whale Bull fired")
alertcondition(show_WhaleBear and sigWhaleBear, "Whale Bear", "Whale Bear fired")
