indicator("Jumbo CIA ★ FIRST BAR ONLY FAUNA FIXED★", shorttitle="1st PUP FAUNA", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=1000)

import TradingView/ta/7 as tv_ta

