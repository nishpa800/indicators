alertcondition(show_DoubleDisp and sigDoubleDispBear, "Double Disp Bear", "Double Disp Bear fired")
alertcondition(show_PUP and sigPUPCombo, "PUP Combo", "PUP Combo fired")
alertcondition(show_PPD and sigPPDCombo, "PPD Combo", "PPD Combo fired")
alertcondition(show_FullStack and sigFullStackBull and fbm, "Full Stack Bull", "Full Stack Bull fired")
alertcondition(show_FullStack and sigFullStackBear and fbm, "Full Stack Bear", "Full Stack Bear fired")
alertcondition(show_FVGStack and sigFVGStackBull and fbm, "FVG Stack Bull", "FVG Stack Bull fired")
alertcondition(show_FVGStack and sigFVGStackBear and fbm, "FVG Stack Bear", "FVG Stack Bear fired")
alertcondition(show_SuperBull and sigAnySuperBull and fbm, "Super Bull", "Super Bull fired")
alertcondition(show_SuperBear and sigAnySuperBear and fbm, "Super Bear", "Super Bear fired")
alertcondition(nag_gate_bull and sigNagasakiBull, "Nagasaki Bull", "Nagasaki Bull fired")
alertcondition(nag_gate_bear and sigNagasakiBear, "Nagasaki Bear", "Nagasaki Bear fired")
alertcondition(show_PAFBull and sigPAFBull, "PAF PUP B2B", "PAF PUP B2B fired")
alertcondition(show_PAFBear and sigPAFBear, "PAF PPD B2B", "PAF PPD B2B fired")
alertcondition(anyFPBull, "FAUNA+ Bull", "FAUNA+ Bull fired")
alertcondition(anyFPBear, "FAUNA+ Bear", "FAUNA+ Bear fired")