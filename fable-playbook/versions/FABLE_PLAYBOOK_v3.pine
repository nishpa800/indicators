//@version=5
// ═════════════ FABLE PLAYBOOK v2 (2026-07-14) — the plays study ═════════════
// Houses the Fable Playbook v1 play TRIGGERS (contracts/playbook_v1.json; 50 plays,
// docs/2026-07-14_TV-TickBar-RE_FablePlaybook-v1-Top50Plays_v1.0.md). Engines are
// VERBATIM adaptations from FIRST_BAR_FABLE_v2.pine @ 0859d60 (RVOL Pre-Mythos tiers,
// Displacement family, PUP/PPD, FAUNA). MASS ladder per operator order: adjustable
// floor input (default 2000; 1500/1750/4000 selectable) + fixed 1000/2000/4000 flags.
// Detection window: first N bars of the session (default 3) — the playbook's opening
// window. Plots are DETECTION triggers for plays, not advice; evidence + entry/stop/
// target law live in the playbook JSON, never here. Rolling windows only; no vendor
// imports (tick-safe: no relativeVolume, no timeframe.change).
// v2: per-play ID mapping in tooltips; S17 Failed PUP short (BR-24); confluence plays
// (BL-19..21/BR-11..13) are SCANNER-SIDE (multi-frame) — marked in tooltips, not chart plots.
// Version control: fable-playbook/CHANGELOG.md · github.com/nishpa800/indicators
// ═══════════════════════════════════════════════════════════════════════════
indicator("Fable Playbook v3", shorttitle="FABLE PLAYS v3", overlay=true, max_labels_count=500, max_bars_back=4100)

conf = barstate.isconfirmed
int _tfSecRaw = timeframe.in_seconds(timeframe.period)
bool _isTickChart = str.endswith(timeframe.period, "T") or na(_tfSecRaw) or _tfSecRaw <= 0
int tfSec = _isTickChart ? 10 : _tfSecRaw

// ── session window ──
grpM = "★ PLAY WINDOW ★"
int i_window = input.int(3, "Opening window (bars of session)", minval=1, maxval=90, group=grpM)
bool is_new_sess = ta.change(time("D")) != 0
var int barInSess = 0
barInSess := is_new_sess ? 0 : barInSess + 1
bool inWindow = barInSess < i_window

// ── MASS ladder (operator: flexible floor) ──
grpHV = "★ MASS (HV ladder) ★"
int i_mass_floor = input.int(2000, "Mass floor (bars)", options=[1000, 1500, 1750, 2000, 4000], group=grpHV, tooltip="volume >= highest volume of the last N bars. Playbook default 2000; 1500/1750 selectable per operator order.")
bool hvFloor = conf and volume >= ta.highest(volume, i_mass_floor)
bool hv1000 = conf and volume >= ta.highest(volume, 1000)
bool hv2000 = conf and volume >= ta.highest(volume, 2000)
bool hv4000 = conf and volume >= ta.highest(volume, 4000)

// ── Displacement family (FBF v2 engine, sigma inputs) ──
grpD = "★ Displacement ★"
i_d_type = input.string("Open to Close", "Range Type", options=["Open to Close", "High to Low"], group=grpD)
i_d_len = input.int(100, "Std Dev Length", minval=1, group=grpD)
i_d9 = input.float(9.0, "Sigma (main)", minval=0.1, step=0.5, group=grpD)
i_d7 = input.float(7.0, "Sigma (secondary)", minval=0.1, step=0.5, group=grpD)
float d_rng = i_d_type == "Open to Close" ? math.abs(open - close) : high - low
float d_std = ta.stdev(d_rng, i_d_len)
bool d9_bull = conf and d_rng > d_std * i_d9 and close > open
bool d9_bear = conf and d_rng > d_std * i_d9 and close < open
bool d7_bull = conf and d_rng > d_std * i_d7 and close > open
bool d7_bear = conf and d_rng > d_std * i_d7 and close < open

// ── RVOL Pre-Mythos tiers (FBF v2 Engine E verbatim curve) ──
grpRV = "★ RVOL tiers ★"
int rv_avgLen = input.int(30, "RVOL Avg Length", group=grpRV)
int rv_smaLen = input.int(20, "RVOL SMA Length", group=grpRV)
float rv_spike = math.abs(close - open)
float rv_avgSpike = ta.sma(rv_spike, rv_avgLen)[1]
float rv_normPrice = rv_spike / nz(rv_avgSpike, 1.0)
float rv_avgVol = ta.sma(volume, rv_avgLen)[1]
float rv_normVol = volume / nz(rv_avgVol, 1.0)
float rv_diff = rv_normPrice - rv_normVol
float rv_posDiff = rv_diff > 0 ? rv_diff : na
float rv_smaDiff = ta.sma(rv_posDiff, rv_smaLen)
bool rv_baseBull = (close > open) and (rv_posDiff > rv_smaDiff) and conf
bool rv_baseBear = (close < open) and (rv_posDiff > rv_smaDiff) and conf
f_th_1x(int _s) => _s <= 10 ? 38.0 : _s <= 15 ? 33.0 : _s <= 30 ? 28.0 : _s <= 45 ? 23.0 : _s <= 60 ? 20.0 : _s <= 120 ? 18.0 : _s <= 300 ? 13.0 : _s <= 360 ? 13.0 : _s <= 540 ? 11.0 : _s <= 600 ? 10.0 : _s <= 660 ? 9.0 : _s <= 900 ? 7.5 : _s <= 1560 ? 6.5 : _s <= 2340 ? 6.0 : _s <= 3600 ? 4.5 : _s <= 9000 ? 4.0 : _s <= 11700 ? 3.5 : _s < 259200 ? 1.8 : 1.0
f_th_gs(int _s) => _s < 60 ? f_th_1x(_s) * 3.0 : _s <= 300 ? 35.0 : _s <= 600 ? 25.0 : _s <= 1500 ? 20.0 : _s <= 3000 ? 20.0 : _s <= 7260 ? 10.0 : _s <= 11700 ? 8.0 : _s <= 86400 ? 7.5 : _s <= 259200 ? 3.5 : 3.0
float th_1x = f_th_1x(tfSec)
float th_gs = f_th_gs(tfSec)
bool det_RVOL1xB = rv_baseBull and rv_normPrice >= th_1x and rv_normPrice < th_gs
bool det_RVOL1xR = rv_baseBear and rv_normPrice >= th_1x and rv_normPrice < th_gs
bool det_GS = rv_baseBull and rv_normPrice >= th_gs
bool det_MOAB = rv_baseBear and rv_normPrice >= th_gs
bool anyTier = det_RVOL1xB or det_RVOL1xR or det_GS or det_MOAB

// ── PUP / PPD (FBF v2 pocket pivot verbatim) ──
grpPP = "★ Pocket Pivot ★"
pp_barSize = input.float(3.0, "% Change (Barsize)", minval=0.1, step=0.1, group=grpPP)
pp_lookback = input.int(10, "Lookback", minval=1, group=grpPP)
float pp_redVol = close < open ? volume : 0.0
float pp_greenVol = close > open ? volume : 0.0
float pp_hiRedVol = ta.highest(pp_redVol[1], pp_lookback)
float pp_hiGreenVol = ta.highest(pp_greenVol[1], pp_lookback)
bool sigPUP = conf and ((close - open) / open) * 100 > pp_barSize and volume > pp_hiRedVol
bool sigPPD = conf and ((open - close) / open) * 100 > pp_barSize and volume > pp_hiGreenVol

// ── FAUNA (FBF v2 engine verbatim) ──
f_faunaEngine() =>
    fauna_atr = ta.atr(14)
    fauna_avgVol = ta.sma(volume, 20)
    fauna_avgBody = ta.sma(math.abs(close - open), 20)
    fauna_avgDelta = ta.sma(math.abs(close - close[1]), 10)
    fauna_trendMA = ta.sma(close, 50)
    fauna_body = close - open
    fauna_rng = high - low
    fauna_bodySz = math.abs(fauna_body)
    fauna_bodyRat = fauna_rng == 0 ? 0 : fauna_bodySz / fauna_rng
    fauna_up = fauna_body > 0
    fauna_dn = fauna_body < 0
    MB_b = fauna_up and fauna_bodySz > 1.6 * fauna_atr and fauna_bodyRat > 0.7 and volume > 1.8 * fauna_avgVol
    RE_b = fauna_up and fauna_rng > 2.2 * fauna_atr and (high - close) < 0.15 * fauna_rng and volume > 1.8 * fauna_avgVol
    TA_b = fauna_trendMA > fauna_trendMA[1] and (close - close[1]) > 1.6 * fauna_avgDelta and fauna_up and volume > 1.8 * fauna_avgVol
    GG_b = (open - close[1]) > 0.9 * fauna_atr and fauna_up and low > close[1] and volume > 1.8 * fauna_avgVol
    prev_body = close[1] - open[1]
    prev_range = high[1] - low[1]
    StrongBear = close[1] < open[1] and math.abs(prev_body) > 1.5 * fauna_avgBody[1] and volume[1] > 1.5 * fauna_avgVol[1]
    WeakBear = close[1] < open[1] and (prev_range == 0 ? 0.0 : math.abs(prev_body) / prev_range) <= 0.2
    excl_b = GG_b or (WeakBear and (MB_b or RE_b or TA_b)) or (StrongBear and (MB_b or RE_b or TA_b)) or (close[1] < open[1] and GG_b)
    sigB = conf and (MB_b or RE_b or TA_b) and not excl_b
    MB_r = fauna_dn and fauna_bodySz > 1.6 * fauna_atr and fauna_bodyRat > 0.7 and volume > 1.8 * fauna_avgVol
    RE_r = fauna_dn and fauna_rng > 2.2 * fauna_atr and (close - low) < 0.15 * fauna_rng and volume > 1.8 * fauna_avgVol
    TA_r = fauna_trendMA < fauna_trendMA[1] and (close[1] - close) > 1.6 * fauna_avgDelta and fauna_dn and volume > 1.8 * fauna_avgVol
    GG_r = (close[1] - open) > 0.9 * fauna_atr and fauna_dn and high < close[1] and volume > 1.8 * fauna_avgVol
    StrongBull = close[1] > open[1] and math.abs(prev_body) > 1.5 * fauna_avgBody[1] and volume[1] > 1.5 * fauna_avgVol[1]
    WeakBull = close[1] > open[1] and (prev_range == 0 ? 0.0 : math.abs(prev_body) / prev_range) <= 0.2
    excl_r = GG_r or (WeakBull and (MB_r or RE_r or TA_r)) or (StrongBull and (MB_r or RE_r or TA_r)) or (close[1] > open[1] and GG_r)
    sigR = conf and (MB_r or RE_r or TA_r) and not excl_r
    [sigB, sigR]
[faunaB, faunaR] = f_faunaEngine()

// ── PLAY TRIGGERS (numbered to the playbook; window-gated except noted) ──
grpS = "★ PLAY TOGGLES ★"
en_S1 = input.bool(true, "S1: Mass Bull Leg (BL-01..08)", group=grpS, tooltip="Plays BL-01..BL-08 (Mass Bull Leg family; MEASURED: 15s +15.0pts n=78 @10d). Swing 5-10 sessions.")
en_S2 = input.bool(true, "S2: Mass Bear Day Scalp (BR-01..06) — EOD MANDATORY", group=grpS, tooltip="Plays BR-01..BR-06 + BR-16..BR-20 (Mass Bear Day Scalp; MEASURED 10s +9.2 n=107). EOD MANDATORY — horizon data shows reversal.")
en_S3 = input.bool(true, "S3: PUP Runner (BL-09..11)", group=grpS, tooltip="BL-09..11 PUP Runner (MEASURED 2m/3m; 10d +7.7% avg)")
en_S4 = input.bool(true, "S4: PPD-Alone Fade->LONG (BL-16)", group=grpS, tooltip="BL-16 PPD-alone fade → LONG (MEASURED 5m +9.6 fade edge n=215)")
en_S5 = input.bool(true, "S5: Naked Spike Bull ->SHORT (BR-08/09)", group=grpS, tooltip="BR-08/09 Naked Spike Short (MEASURED n=423/627)")
en_S6 = input.bool(true, "S6: Naked Spike Bear ->fade LONG (BL-18)", group=grpS, tooltip="BL-18 vacuum bear fade long (CANDIDATE)")
en_S7 = input.bool(true, "S7: MOAB massless ->fade LONG (BL-14/15)", group=grpS, tooltip="BL-14/15 MOAB fade long (MEASURED 15s/10s)")
en_S8 = input.bool(true, "S8: GS unconfirmed ->2wk SHORT (BR-07)", group=grpS, tooltip="BR-07 GS Unconfirmed 2-week short (MEASURED +22.8 n=53)")
en_S9 = input.bool(true, "S9: GS mass-confirmed cont. (BL-25)", group=grpS, tooltip="BL-25 (CANDIDATE)")
en_S10 = input.bool(true, "S10: MOAB mass-confirmed SHORT (BR-23)", group=grpS, tooltip="BR-23 (CANDIDATE)")
en_S11 = input.bool(true, "S11: FAUNA Mass Long (BL-24)", group=grpS, tooltip="BL-24 (CANDIDATE)")
en_S12 = input.bool(true, "S12: PPD mass-confirmed SHORT (BR-21)", group=grpS, tooltip="BR-21 (CANDIDATE)")
en_S13 = input.bool(true, "S13: d7-extra Bear (BR-22)", group=grpS, tooltip="BR-22 d7-extra bear (MEASURED 3m +5.9 n=206)")
en_S14 = input.bool(true, "S14: Rocket-Fuel Fade core ->LONG (BL-12)", group=grpS, tooltip="BL-12 Rocket-Fuel Fade core (MEASURED 15s +13.0 n=70)")
en_S15 = input.bool(true, "S15: CORE Bull (confluence feed, BL-19..21)", group=grpS, tooltip="confluence FEEDS for BL-19..21 / BR-11..13 — cross-frame tally happens in the lake scanner, not on one chart")
en_S16 = input.bool(true, "S16: CORE Bear (confluence feed, BR-11..13)", group=grpS, tooltip="confluence FEEDS for BL-19..21 / BR-11..13 — cross-frame tally happens in the lake scanner, not on one chart")
en_S18 = input.bool(true, "S18: MASS PURE Bull (AB-01 arm B)", group=grpS, tooltip="Volume record WITHOUT displacement: hvFloor AND green bar AND NOT d9. THE LITERATURE ARM: Gervais-Kaniel-Mingelgrin (JF 2001) high-volume premium is STRONGER excluding extreme-return days. A/B vs S1 (mass+d9), settles on the forward ledger. CANDIDATE.")
en_S19 = input.bool(true, "S19: MASS PURE Bear (AB-01 mirror)", group=grpS, tooltip="hvFloor AND red bar AND NOT d9 — bear mirror of the AB-01 literature arm. CANDIDATE.")
en_S17 = input.bool(true, "S17: Failed PUP -> SHORT (BR-24)", group=grpS, tooltip="PUP fired within the last 3 bars, then price CLOSES below that PUP bar's low = failed pocket pivot. CANDIDATE.")

bool wg = inWindow
bool S1 = wg and hvFloor and d9_bull
bool S2 = wg and hvFloor and d9_bear
bool S3 = wg and sigPUP and not (d9_bull or d9_bear) and not hv1000
bool S4 = wg and sigPPD and not (d9_bull or d9_bear) and not hv1000
bool S5 = wg and d9_bull and det_RVOL1xB and not hv1000
bool S6 = wg and d9_bear and det_RVOL1xR and not hv1000
bool S7 = wg and det_MOAB and not hv1000
bool S8 = wg and det_GS and not hv1000
bool S9 = wg and det_GS and hv1000
bool S10 = wg and det_MOAB and hv1000
bool S11 = wg and hvFloor and d9_bull and faunaB
bool S12 = wg and hvFloor and d9_bear and sigPPD
bool S13 = wg and d7_bear and not d9_bear
bool S14 = wg and hv1000 and d9_bear and (sigPPD or faunaR)
bool S15 = wg and hvFloor and d9_bull and anyTier
bool S16 = wg and hvFloor and d9_bear and anyTier

// S17: Failed PUP -> SHORT (BR-24). NOTE: S17 is NOT window-gated — the failure can
// complete after the opening window.
var float pupLow = na
var int pupAge = 999
pupAge := sigPUP ? 0 : pupAge + 1
pupLow := sigPUP ? low : pupLow
bool S17 = conf and pupAge > 0 and pupAge <= 3 and not na(pupLow) and close < pupLow
bool S18 = wg and hvFloor and close > open and not d9_bull
bool S19 = wg and hvFloor and close < open and not d9_bear

plotshape(en_S1 and S1, "S1: Mass Bull Leg", shape.triangleup, location.belowbar, color.lime, 0, "MASS\nLEG", color.black, size=size.normal)
plotshape(en_S2 and S2, "S2: Mass Bear Day Scalp", shape.triangledown, location.abovebar, color.red, 0, "MASS\nSCALP", color.white, size=size.normal)
plotshape(en_S3 and S3, "S3: PUP Runner", shape.labelup, location.belowbar, color.green, 0, "PUP\nRUN", color.white, size=size.small)
plotshape(en_S4 and S4, "S4: PPD Fade Long", shape.labelup, location.belowbar, color.teal, 0, "PPD\nFADE", color.white, size=size.small)
plotshape(en_S5 and S5, "S5: Naked Spike Short", shape.labeldown, location.abovebar, color.maroon, 0, "SPIKE\nSHORT", color.white, size=size.small)
plotshape(en_S6 and S6, "S6: Naked Bear Fade Long", shape.labelup, location.belowbar, color.aqua, 0, "VAC\nFADE", color.black, size=size.small)
plotshape(en_S7 and S7, "S7: MOAB Fade Long", shape.labelup, location.belowbar, #00E676, 0, "MOAB\nFADE", color.black, size=size.small)
plotshape(en_S8 and S8, "S8: GS Unconfirmed Short", shape.labeldown, location.abovebar, #FF6F00, 0, "GS\nFADE", color.white, size=size.small)
plotshape(en_S9 and S9, "S9: GS Mass Continuation", shape.diamond, location.belowbar, color.yellow, 0, "GS\nMASS", color.black, size=size.small)
plotshape(en_S10 and S10, "S10: MOAB Mass Short", shape.diamond, location.abovebar, color.fuchsia, 0, "MOAB\nMASS", color.white, size=size.small)
plotshape(en_S11 and S11, "S11: FAUNA Mass Long", shape.triangleup, location.belowbar, #43A047, 0, "FAUNA\nMASS", color.white, size=size.small)
plotshape(en_S12 and S12, "S12: PPD Mass Short", shape.triangledown, location.abovebar, #9C27B0, 0, "PPD\nMASS", color.white, size=size.small)
plotshape(en_S13 and S13, "S13: d7-extra Bear", shape.xcross, location.abovebar, color.orange, 0, "D7\nBEAR", color.white, size=size.tiny)
plotshape(en_S14 and S14, "S14: Rocket-Fuel Fade Long", shape.labelup, location.belowbar, #FFD700, 0, "FUEL\nFADE", color.black, size=size.normal)
plotshape(en_S15 and S15, "S15: CORE Bull", shape.circle, location.belowbar, color.blue, 0, "CORE\nB", color.white, size=size.tiny)
plotshape(en_S16 and S16, "S16: CORE Bear", shape.circle, location.abovebar, color.navy, 0, "CORE\nR", color.white, size=size.tiny)
plotshape(en_S17 and S17, "S17: Failed PUP Short", shape.labeldown, location.abovebar, color.gray, 0, "FAIL\nPUP", color.white, size=size.small)
plotshape(en_S18 and S18, "S18: Mass Pure Bull", shape.square, location.belowbar, #00C853, 0, "MASS\nPURE", color.white, size=size.small)
plotshape(en_S19 and S19, "S19: Mass Pure Bear", shape.square, location.abovebar, #D50000, 0, "MASS\nPURE", color.white, size=size.small)

bool anyBull = (en_S1 and S1) or (en_S3 and S3) or (en_S4 and S4) or (en_S6 and S6) or (en_S7 and S7) or (en_S9 and S9) or (en_S11 and S11) or (en_S14 and S14) or (en_S15 and S15) or (en_S18 and S18)
bool anyBear = (en_S2 and S2) or (en_S5 and S5) or (en_S8 and S8) or (en_S10 and S10) or (en_S12 and S12) or (en_S13 and S13) or (en_S16 and S16) or (en_S17 and S17) or (en_S19 and S19)
alertcondition(anyBull, "PLAYBOOK BULL", "Fable Playbook v3: bullish play trigger")
alertcondition(anyBear, "PLAYBOOK BEAR", "Fable Playbook v3: bearish play trigger")
