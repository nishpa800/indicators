//@version=5
// ═════════════ FABLE PLAYBOOK v2 (2026-07-14) — the plays study ═════════════
// Houses the Fable Playbook v1 play TRIGGERS (contracts/playbook_v1.json; 50 plays,
// docs/2026-07-14_TV-TickBar-RE_FablePlaybook-v1-Top50Plays_v1.0.md). Engines are
// VERBATIM adaptations from FIRST_BAR_FABLE_v2.pine @ 0859d60 (RVOL Pre-Mythos tiers,
// Displacement family, PUP/PPD, FAUNA). MASS ladder per operator order: adjustable
// floor input (default 2000; 1500/1750/4000 selectable) + fixed 1000/2000/4000 flags.
// Detection window: first N bars of the session (default 3) — the playbook's opening
// window. Plots are DETECTION triggers for plays, not advice; evidence + entry/stop/
// target law live in the playbook JSON, never here. Rolling windows only; no vendor
// imports (tick-safe: no relativeVolume, no timeframe.change).
// v2: per-play ID mapping in tooltips; S17 Failed PUP short (BR-24); confluence plays
// (BL-19..21/BR-11..13) are SCANNER-SIDE (multi-frame) — marked in tooltips, not chart plots.
// Version control: fable-playbook/CHANGELOG.md · github.com/nishpa800/indicators
// ═══════════════════════════════════════════════════════════════════════════
indicator("Fable Playbook v4", shorttitle="FABLE PLAYS v4", overlay=true, max_labels_count=500, max_bars_back=4100)

conf = barstate.isconfirmed
int _tfSecRaw = timeframe.in_seconds(timeframe.period)
bool _isTickChart = str.endswith(timeframe.period, "T") or na(_tfSecRaw) or _tfSecRaw <= 0
int tfSec = _isTickChart ? 10 : _tfSecRaw

// ── session window ──
grpM = "★ PLAY WINDOW ★"
int i_window = input.int(3, "Opening window (bars of session)", minval=1, maxval=90, group=grpM)
bool is_new_sess = ta.change(time("D")) != 0
var int barInSess = 0
barInSess := is_new_sess ? 0 : barInSess + 1
bool inWindow = barInSess < i_window

// ── MASS ladder (operator: flexible floor) ──
grpHV = "★ MASS (HV ladder) ★"
int i_mass_floor = input.int(2000, "Mass floor (bars)", options=[1000, 1500, 1750, 2000, 4000], group=grpHV, tooltip="volume >= highest volume of the last N bars. Playbook default 2000; 1500/1750 selectable per operator order.")
bool hvFloor = conf and volume >= ta.highest(volume, i_mass_floor)
bool hv1000 = conf and volume >= ta.highest(volume, 1000)
bool hv2000 = conf and volume >= ta.highest(volume, 2000)
bool hv4000 = conf and volume >= ta.highest(volume, 4000)

// ── Displacement family (FBF v2 engine, sigma inputs) ──
grpD = "★ Displacement ★"
i_d_type = input.string("Open to Close", "Range Type", options=["Open to Close", "High to Low"], group=grpD)
i_d_len = input.int(100, "Std Dev Length", minval=1, group=grpD)
i_d9 = input.float(9.0, "Sigma (main)", minval=0.1, step=0.5, group=grpD)
i_d7 = input.float(7.0, "Sigma (secondary)", minval=0.1, step=0.5, group=grpD)
float d_rng = i_d_type == "Open to Close" ? math.abs(open - close) : high - low
float d_std = ta.stdev(d_rng, i_d_len)
bool d9_bull = conf and d_rng > d_std * i_d9 and close > open
bool d9_bear = conf and d_rng > d_std * i_d9 and close < open
bool d7_bull = conf and d_rng > d_std * i_d7 and close > open
bool d7_bear = conf and d_rng > d_std * i_d7 and close < open

// ── RVOL Pre-Mythos tiers (FBF v2 Engine E verbatim curve) ──
grpRV = "★ RVOL tiers ★"
int rv_avgLen = input.int(30, "RVOL Avg Length", group=grpRV)
int rv_smaLen = input.int(20, "RVOL SMA Length", group=grpRV)
float rv_spike = math.abs(close - open)
float rv_avgSpike = ta.sma(rv_spike, rv_avgLen)[1]
float rv_normPrice = rv_spike / nz(rv_avgSpike, 1.0)
float rv_avgVol = ta.sma(volume, rv_avgLen)[1]
float rv_normVol = volume / nz(rv_avgVol, 1.0)
float rv_diff = rv_normPrice - rv_normVol
float rv_posDiff = rv_diff > 0 ? rv_diff : na
float rv_smaDiff = ta.sma(rv_posDiff, rv_smaLen)
bool rv_baseBull = (close > open) and (rv_posDiff > rv_smaDiff) and conf
bool rv_baseBear = (close < open) and (rv_posDiff > rv_smaDiff) and conf
f_th_1x(int _s) => _s <= 10 ? 38.0 : _s <= 15 ? 33.0 : _s <= 30 ? 28.0 : _s <= 45 ? 23.0 : _s <= 60 ? 20.0 : _s <= 120 ? 18.0 : _s <= 300 ? 13.0 : _s <= 360 ? 13.0 : _s <= 540 ? 11.0 : _s <= 600 ? 10.0 : _s <= 660 ? 9.0 : _s <= 900 ? 7.5 : _s <= 1560 ? 6.5 : _s <= 2340 ? 6.0 : _s <= 3600 ? 4.5 : _s <= 9000 ? 4.0 : _s <= 11700 ? 3.5 : _s < 259200 ? 1.8 : 1.0
f_th_gs(int _s) => _s < 60 ? f_th_1x(_s) * 3.0 : _s <= 300 ? 35.0 : _s <= 600 ? 25.0 : _s <= 1500 ? 20.0 : _s <= 3000 ? 20.0 : _s <= 7260 ? 10.0 : _s <= 11700 ? 8.0 : _s <= 86400 ? 7.5 : _s <= 259200 ? 3.5 : 3.0
float th_1x = f_th_1x(tfSec)
float th_gs = f_th_gs(tfSec)
bool det_RVOL1xB = rv_baseBull and rv_normPrice >= th_1x and rv_normPrice < th_gs
bool det_RVOL1xR = rv_baseBear and rv_normPrice >= th_1x and rv_normPrice < th_gs
bool det_GS = rv_baseBull and rv_normPrice >= th_gs
bool det_MOAB = rv_baseBear and rv_normPrice >= th_gs
bool anyTier = det_RVOL1xB or det_RVOL1xR or det_GS or det_MOAB

// ── PUP / PPD (FBF v2 pocket pivot verbatim) ──
grpPP = "★ Pocket Pivot ★"
pp_barSize = input.float(3.0, "% Change (Barsize)", minval=0.1, step=0.1, group=grpPP)
pp_lookback = input.int(10, "Lookback", minval=1, group=grpPP)
float pp_redVol = close < open ? volume : 0.0
float pp_greenVol = close > open ? volume : 0.0
float pp_hiRedVol = ta.highest(pp_redVol[1], pp_lookback)
float pp_hiGreenVol = ta.highest(pp_greenVol[1], pp_lookback)
bool sigPUP = conf and ((close - open) / open) * 100 > pp_barSize and volume > pp_hiRedVol
bool sigPPD = conf and ((open - close) / open) * 100 > pp_barSize and volume > pp_hiGreenVol

// ── FAUNA (FBF v2 engine verbatim) ──
f_faunaEngine() =>
    fauna_atr = ta.atr(14)
    fauna_avgVol = ta.sma(volume, 20)
    fauna_avgBody = ta.sma(math.abs(close - open), 20)
    fauna_avgDelta = ta.sma(math.abs(close - close[1]), 10)
    fauna_trendMA = ta.sma(close, 50)
    fauna_body = close - open
    fauna_rng = high - low
    fauna_bodySz = math.abs(fauna_body)
    fauna_bodyRat = fauna_rng == 0 ? 0 : fauna_bodySz / fauna_rng
    fauna_up = fauna_body > 0
    fauna_dn = fauna_body < 0
    MB_b = fauna_up and fauna_bodySz > 1.6 * fauna_atr and fauna_bodyRat > 0.7 and volume > 1.8 * fauna_avgVol
    RE_b = fauna_up and fauna_rng > 2.2 * fauna_atr and (high - close) < 0.15 * fauna_rng and volume > 1.8 * fauna_avgVol
    TA_b = fauna_trendMA > fauna_trendMA[1] and (close - close[1]) > 1.6 * fauna_avgDelta and fauna_up and volume > 1.8 * fauna_avgVol
    GG_b = (open - close[1]) > 0.9 * fauna_atr and fauna_up and low > close[1] and volume > 1.8 * fauna_avgVol
    prev_body = close[1] - open[1]
    prev_range = high[1] - low[1]
    StrongBear = close[1] < open[1] and math.abs(prev_body) > 1.5 * fauna_avgBody[1] and volume[1] > 1.5 * fauna_avgVol[1]
    WeakBear = close[1] < open[1] and (prev_range == 0 ? 0.0 : math.abs(prev_body) / prev_range) <= 0.2
    excl_b = GG_b or (WeakBear and (MB_b or RE_b or TA_b)) or (StrongBear and (MB_b or RE_b or TA_b)) or (close[1] < open[1] and GG_b)
    sigB = conf and (MB_b or RE_b or TA_b) and not excl_b
    MB_r = fauna_dn and fauna_bodySz > 1.6 * fauna_atr and fauna_bodyRat > 0.7 and volume > 1.8 * fauna_avgVol
    RE_r = fauna_dn and fauna_rng > 2.2 * fauna_atr and (close - low) < 0.15 * fauna_rng and volume > 1.8 * fauna_avgVol
    TA_r = fauna_trendMA < fauna_trendMA[1] and (close[1] - close) > 1.6 * fauna_avgDelta and fauna_dn and volume > 1.8 * fauna_avgVol
    GG_r = (close[1] - open) > 0.9 * fauna_atr and fauna_dn and high < close[1] and volume > 1.8 * fauna_avgVol
    StrongBull = close[1] > open[1] and math.abs(prev_body) > 1.5 * fauna_avgBody[1] and volume[1] > 1.5 * fauna_avgVol[1]
    WeakBull = close[1] > open[1] and (prev_range == 0 ? 0.0 : math.abs(prev_body) / prev_range) <= 0.2
    excl_r = GG_r or (WeakBull and (MB_r or RE_r or TA_r)) or (StrongBull and (MB_r or RE_r or TA_r)) or (close[1] > open[1] and GG_r)
    sigR = conf and (MB_r or RE_r or TA_r) and not excl_r
    [sigB, sigR]
[faunaB, faunaR] = f_faunaEngine()

// ── PLAY TRIGGERS (numbered to the playbook; window-gated except noted) ──
grpS = "★ PLAY TOGGLES ★"
ab_1 = input.bool(false, "ⓘ ABOUT THIS PLAYBOOK (read tooltip)", group=grpS, tooltip="Chart arm of Fable Playbook v1.1 — 50 plays (25 bull/25 bear), 22 MEASURED / 28 CANDIDATE. This study DETECTS; entries/stops/sizes/caps live in contracts/playbook_v1.json (machine) + docs/2026-07-14_TV-TickBar-RE_FablePlaybook-v1-Top50Plays_v1.0.md (human). One play per symbol-day; max 6 concurrent, 2 per sector, 3R open risk; only AUTOMATABLE status may ever reach a broker — none qualify yet, by design.")
ab_2 = input.bool(false, "ⓘ EVIDENCE & LIMITS (read tooltip)", group=grpS, tooltip="Source: pre-registered first-15-min scan, top-750 x 8 frames x 3 months (2026-04-14..07-01), 111,265 signals vs 123,360 nulls/frame, +5/+10-session horizons. KEY: MASS divides trend from fade — record-volume displacement trends (bull legs strongest at 2 weeks), massless violence fades. LIMITS: single up-drift window; ~480 cells scanned so the best null cell is EXPECTED at 3.04 sigma; nothing here is VALIDATED yet (Harvey-Liu-Zhu t>=3 + Deflated Sharpe + PBO gates pend on new data).")
ab_3 = input.bool(false, "ⓘ SIZING & LIQUIDITY LAW (read tooltip)", group=grpS, tooltip="Risk-at-stop <= 0.25-0.5% of capital per play (quarter-Kelly on a shrunk edge; hard cap 1%) — Thorp/Chopra-Ziemba/Moreira-Muir. Position <= 1% of dollar-ADV at 20bps impact budget (square-root law, Toth/Almgren/Bucci); never >10% of ADV. CANDIDATE plays trade 0R (paper).")
en_S1 = input.bool(true, "S1: Mass Bull Leg (BL-01..08)", group=grpS, tooltip="BL-01..BL-08 [MEASURED, CANDIDATE] · Mass Bull Leg — THE sleeper: quiet same-day, strongest 2-week cell in scan (family — see playbook_v1.json for per-frame variants) ► TRIGGER: first-3 bars: hv2000 AND d9 AND close>open ► EVIDENCE: BL-01: 10d: 67.9% vs 53.0% null (+15.0), avg +4.30% vs +1.13%, n=78; BL-02: 5d: 65.5% vs 52.1% (+13.3), avg +3.24%, n=55; BL-03: 5d: 63.1% (+11.0), n=103; BL-04: 5d: 61.2% (+9.1), n=196; BL-05: 10d: 57.9% (+4.9), n=171 ► ENTRY: enter on breach of signal-bar extreme (high for long / low for short) within the next 3 bars; else NO TRADE ► STOP: stop = signal price -/+ 1.0x the first-15-min range. Hard. ► EXIT: 10 sessions hard ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S2 = input.bool(true, "S2: Mass Bear Day Scalp (BR-01..06) — EOD MANDATORY", group=grpS, tooltip="BR-01..BR-06,BR-16..BR-20 [MEASURED, CANDIDATE] · Mass Bear Day Scalp — the discipline play: the edge dies at the bell (family — see playbook_v1.json for per-frame variants) ► TRIGGER: first-3 bars: hv2000 AND d9 AND close<open ► EVIDENCE: BR-01: day: 60.8% vs 51.6% (+9.2), n=107; BR-02: day: 58.8% (+7.3), n=68; BR-03: day: 54.5% (+3.2), n=55; BR-04: day: 54.0% (+2.4), n=202 ► ENTRY: enter on breach of signal-bar extreme (high for long / low for short) within the next 3 bars; else NO TRADE ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY — HORIZON DATA ORDERS IT: same cells REVERSE UP over 5-10 sessions (-12.6 at 5d) ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S3 = input.bool(true, "S3: PUP Runner (BL-09..11)", group=grpS, tooltip="BL-09..BL-11 [MEASURED] · PUP Runner — best complete signal: day edge AND runs for weeks (family — see playbook_v1.json for per-frame variants) ► TRIGGER: first-3 bars: PUP (pocket pivot: +3% body, vol > 10-bar red-vol high) AND NOT d9 AND NOT hv1000 ► EVIDENCE: BL-09: 10d: 65.0% (+12.0), avg +7.70%, n=60; day +10.2, leg +4.5%; BL-10: day: 59.2% (+10.2), ret +1.29%, leg +4.5%, n=125; BL-11: 5d: 58.2% (+6.1), n=158 ► ENTRY: enter at next-bar open after signal bar confirms ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: 10 sessions hard ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S4 = input.bool(true, "S4: PPD-Alone Fade->LONG (BL-16)", group=grpS, tooltip="BL-16 [MEASURED] · Rocket-Fuel Fade — operator H3: failed bear = fuel; massless violence fades ► TRIGGER: first-3 bars BEARISH violence WITHOUT mass record: PPD alone (no d9, no hv1000); CONFIRM price holds above signal-bar low for 2 bars ► EVIDENCE: BL-16: fade wins (+9.6), avg +0.60%, n=215 ► ENTRY: enter long on reclaim of signal-bar midpoint ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S5 = input.bool(true, "S5: Naked Spike Bull ->SHORT (BR-08/09)", group=grpS, tooltip="BR-08..BR-09 [MEASURED] · Naked Spike Short (family — see playbook_v1.json for per-frame variants) ► TRIGGER: d9 AND rvol1x BULL side first-3 bars, NO hv flag (price violence without volume record) ► EVIDENCE: BR-08: bull side 37.8% (-10.6) => short wins, n=423 — the two biggest-n cells in the scan; BR-09: bull side 40.4% (-8.1) => short wins, n=627 — the two biggest-n cells in the scan ► ENTRY: short on first close below signal bar low ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S6 = input.bool(true, "S6: Naked Spike Bear ->fade LONG (BL-18)", group=grpS, tooltip="BL-18 [CANDIDATE] · Vacuum Spike Fade (long the failed bear-day) ► TRIGGER: d9 AND rvol1x BEAR side first-3 bars, no hv flag ► EVIDENCE: CANDIDATE — no n>=50 cell yet ► ENTRY: long on reclaim of open ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S7 = input.bool(true, "S7: MOAB massless ->fade LONG (BL-14/15)", group=grpS, tooltip="BL-14..BL-15 [MEASURED] · Rocket-Fuel Fade — operator H3: failed bear = fuel; massless violence fades (family — see playbook_v1.json for per-frame variants) ► TRIGGER: first-3 bars BEARISH violence WITHOUT mass record: MOAB; CONFIRM price holds above signal-bar low for 2 bars ► EVIDENCE: BL-14: fade wins (+12.1), avg +0.87%, n=71; BL-15: fade wins (+9.1), n=120 ► ENTRY: enter long on reclaim of signal-bar midpoint ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S8 = input.bool(true, "S8: GS unconfirmed ->2wk SHORT (BR-07)", group=grpS, tooltip="BR-07 [MEASURED] · Unconfirmed Euphoria Two-Week Short — strongest single fade cell in the scan ► TRIGGER: GS tier bull first-3 bars WITHOUT hv1000 (no mass record) ► EVIDENCE: BR-07: 10d: bull side 30.2% (n=53) => short edge +22.8 ► ENTRY: short on first close below signal-bar midpoint ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: 10 sessions hard ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S9 = input.bool(true, "S9: GS mass-confirmed cont. (BL-25)", group=grpS, tooltip="BL-25 [CANDIDATE] · GS With Mass Continuation ► TRIGGER: GS tier AND hv1000 first-3 bars (mass-CONFIRMED euphoria only) ► EVIDENCE: CANDIDATE — no n>=50 cell yet ► ENTRY: enter at next-bar open after signal bar confirms ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S10 = input.bool(true, "S10: MOAB mass-confirmed SHORT (BR-23)", group=grpS, tooltip="BR-23 [CANDIDATE] · MOAB With Mass Short ► TRIGGER: MOAB AND hv1000 (record volume + extreme bear tier) ► EVIDENCE: CANDIDATE — no n>=50 cell yet ► ENTRY: enter on breach of signal-bar extreme (high for long / low for short) within the next 3 bars; else NO TRADE ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S11 = input.bool(true, "S11: FAUNA Mass Long (BL-24)", group=grpS, tooltip="BL-24 [CANDIDATE] · FAUNA-Backed Mass Long ► TRIGGER: hv1500 AND d9 AND bull FAUNA first-3 bars ► EVIDENCE: CANDIDATE — no n>=50 cell yet ► ENTRY: enter on breach of signal-bar extreme (high for long / low for short) within the next 3 bars; else NO TRADE ► STOP: stop = signal price -/+ 1.0x the first-15-min range. Hard. ► EXIT: 5 sessions ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S12 = input.bool(true, "S12: PPD mass-confirmed SHORT (BR-21)", group=grpS, tooltip="BR-21 [CANDIDATE] · PPD With Mass Continuation ► TRIGGER: hv1500 AND d9 AND PPD first-3 bars (mass-CONFIRMED bear pivot) ► EVIDENCE: CANDIDATE — no n>=50 cell yet ► ENTRY: enter on breach of signal-bar extreme (high for long / low for short) within the next 3 bars; else NO TRADE ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S13 = input.bool(true, "S13: d7-extra Bear (BR-22)", group=grpS, tooltip="BR-22 [MEASURED] · d7-Extra Bear ► TRIGGER: d7 fires AND NOT d9 (the sigma-7 study's extra fires) first-3 bars bear ► EVIDENCE: BR-22: day: 56.8% (+5.9), n=206 — the one standalone d7 cell above null ► ENTRY: enter at next-bar open after signal bar confirms ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S14 = input.bool(true, "S14: Rocket-Fuel Fade core ->LONG (BL-12)", group=grpS, tooltip="BL-12 [MEASURED] · Rocket-Fuel Fade — operator H3: failed bear = fuel; massless violence fades ► TRIGGER: first-3 bars BEARISH violence WITHOUT mass record: hv1000 AND d9 AND (PPD or bear FAUNA); CONFIRM price holds above signal-bar low for 2 bars ► EVIDENCE: BL-12: same-day fade: signal-side hit 38.6% => fade wins 61.4% vs 48.4 (+13.0), avg day +0.58%, n=70 ► ENTRY: enter long on reclaim of signal-bar midpoint ► STOP: stop = opposite extreme of the signal bar (long: bar low; short: bar high). Hard, no widening. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S15 = input.bool(true, "S15: CORE Bull (confluence feed, BL-19..21)", group=grpS, tooltip="BL-19..BL-21 [CANDIDATE] · Multi-Frame Mass Confluence Long (>= 2 frames) — the operator's confluence tally play — needs n (family — see playbook_v1.json for per-frame variants) ► TRIGGER: CORE (mass AND d9 AND any RVOL tier) fires bull on >= 2 frames at bar 0 of the SAME session ► EVIDENCE: CANDIDATE — no n>=50 cell yet ► ENTRY: enter on breach of signal-bar extreme (high for long / low for short) within the next 3 bars; else NO TRADE ► STOP: stop = signal price -/+ 1.0x the first-15-min range. Hard. ► EXIT: 5 sessions ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
en_S16 = input.bool(true, "S16: CORE Bear (confluence feed, BR-11..13)", group=grpS, tooltip="BR-11..BR-13 [CANDIDATE] · Multi-Frame Mass Confluence Short (>= 2 frames) (family — see playbook_v1.json for per-frame variants) ► TRIGGER: CORE bear on >= 2 frames at bar 0 ► EVIDENCE: CANDIDATE — no n>=50 cell yet ► ENTRY: enter on breach of signal-bar extreme (high for long / low for short) within the next 3 bars; else NO TRADE ► STOP: stop = signal price -/+ 1.0x the first-15-min range. Hard. ► EXIT: EOD MANDATORY ► All figures ESTIMATED from the pre-registered 2026-07-14 scan (single 3-month up-drift window); promotion to VALIDATED only via t>=3 + DSR>=0.95 + PBO<=0.05 + forward ledger (playbook v1.1 laws).")
