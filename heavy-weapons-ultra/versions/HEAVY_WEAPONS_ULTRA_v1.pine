// =============================================================================
// HV+D ENGINE — HV TIER INPUTS
// =============================================================================
tfSec_hvd(string t) =>
    switch t
        "1 Min"   => 60
        "2 Min"   => 120
        "3 Min"   => 180
        "4 Min"   => 240
        "5 Min"   => 300
        "10 Min"  => 600
        "15 Min"  => 900
        "30 Min"  => 1800
        "1 Hour"  => 3600
        "2 Hour"  => 7200
        "3 Hour"  => 10800
        "4 Hour"  => 14400
        "1 Day"   => 86400
        "2 Day"   => 172800
        "3 Day"   => 259200
        "1 Week"  => 604800
        "1 Month" => 2592000
        "3 Month" => 7776000
        => 0

string grpHVBase = "── HV+D BASE TIERS (50–1000) ──"
