string grpHTF1 = "── HV+D HTF PROFILE 1 ──"
bool   h1On   = input.bool(false, "Enable HTF Profile 1", group=grpHTF1)
string h1From = input.string("15 Min", "From Timeframe", group=grpHTF1, options=["1 Min","2 Min","3 Min","4 Min","5 Min","10 Min","15 Min","30 Min","1 Hour","2 Hour","3 Hour","4 Hour","1 Day","2 Day","3 Day","1 Week","1 Month","3 Month"])
string h1To   = input.string("2 Hour", "To Timeframe",   group=grpHTF1, options=["1 Min","2 Min","3 Min","4 Min","5 Min","10 Min","15 Min","30 Min","1 Hour","2 Hour","3 Hour","4 Hour","1 Day","2 Day","3 Day","1 Week","1 Month","3 Month"])
bool uh1_5  = input.bool(true, "5-Bar",  group=grpHTF1, inline="h1a")
bool uh1_10 = input.bool(true, "10-Bar", group=grpHTF1, inline="h1a")
bool uh1_20 = input.bool(true, "20-Bar", group=grpHTF1, inline="h1a")
bool uh1_25 = input.bool(true, "25-Bar", group=grpHTF1, inline="h1b")
bool uh1_30 = input.bool(true, "30-Bar", group=grpHTF1, inline="h1b")
bool uh1_40 = input.bool(true, "40-Bar", group=grpHTF1, inline="h1b")
