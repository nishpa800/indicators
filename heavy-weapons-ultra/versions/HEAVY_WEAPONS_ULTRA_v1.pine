string grpHTF2 = "── HV+D HTF PROFILE 2 ──"
bool   h2On   = input.bool(false, "Enable HTF Profile 2", group=grpHTF2)
string h2From = input.string("3 Hour", "From Timeframe", group=grpHTF2, options=["1 Min","2 Min","3 Min","4 Min","5 Min","10 Min","15 Min","30 Min","1 Hour","2 Hour","3 Hour","4 Hour","1 Day","2 Day","3 Day","1 Week","1 Month","3 Month"])
string h2To   = input.string("3 Month","To Timeframe",   group=grpHTF2, options=["1 Min","2 Min","3 Min","4 Min","5 Min","10 Min","15 Min","30 Min","1 Hour","2 Hour","3 Hour","4 Hour","1 Day","2 Day","3 Day","1 Week","1 Month","3 Month"])
bool uh2_5  = input.bool(true, "5-Bar",  group=grpHTF2, inline="h2a")
bool uh2_10 = input.bool(true, "10-Bar", group=grpHTF2, inline="h2a")
