//@version=5
// =============================================================================
// Heavy Weapons ULTRA — Composite Architecture
// =============================================================================
indicator("Heavy Weapons ULTRA", shorttitle="HW ULTRA", overlay=true, max_labels_count=500, max_bars_back=5000)

import TradingView/ta/7 as tv_ta

// =============================================================================
// TIMEFRAME DETECTION + SUB-MINUTE CONFIG
// =============================================================================
int chartSec = timeframe.in_seconds(timeframe.period)

grp_tf = "★ TIMEFRAME GATES ★"
subMinThreshold   = input.int(60,   "Sub-Minute Threshold (seconds)", minval=1, group=grp_tf, tooltip="Timeframes below this get HV lookback multiplier applied")
hvMultiplier      = input.float(2.5, "HV Lookback Multiplier (sub-minute)", minval=1.0, step=0.1, group=grp_tf)
sub2MinThreshold  = input.int(120,  "Sub-2-Min Threshold (seconds)", minval=1, group=grp_tf, tooltip="Below this, PBJ in composites requires HVD+PBJ with floors")
sub2Min_hvFloor   = input.int(150,  "Sub-2-Min HV Rank Floor", minval=50, group=grp_tf)
sub2Min_dispFloor = input.float(5.0,"Sub-2-Min Disp Mult Floor", minval=0.1, step=0.1, group=grp_tf)

bool isSubMinute = chartSec < subMinThreshold
bool isSub2Min   = chartSec < sub2MinThreshold

int MBB = 5000
int hvMaxCap = math.floor(MBB * 0.9)

f_hvLen(int base) =>
    isSubMinute ? math.min(math.round(base * hvMultiplier), hvMaxCap) : base

