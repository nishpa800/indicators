//@version=5
indicator("PBJ PB Consolidated — PB/PBJ + KC Re-entry + PUP/PPD + Displacement", shorttitle="PBJ PB CONSOL", overlay=true, max_labels_count=500, max_bars_back=5000)

// ╔════════════════════════════════════════════════════════════════════════════╗
// ║  PBJ PB CONSOLIDATED v1 — ONE indicator study, four source engines       ║
// ╠════════════════════════════════════════════════════════════════════════════╣
// ║  BASE:  "PB & PBJ — 4 Signals" (OKEH Zoo Engine + PB&J Filter +          ║
// ║         OKEH Supertrend). ALL defaults preserved verbatim.               ║
// ║  ADD 1: KC Rev 8 — ONLY the four re-entry signals:                       ║
// ║         Bull/Bear Re-entry Cross, Bull/Bear Re-entry Slope.              ║
// ║         KC engine defaults preserved (EMA 20, mult 2.0, ATR 10,          ║
// ║         slope lookback 3, thresholds 0.05). No KC bands plotted,         ║
// ║         no volatility/cluster signals — re-entry family only.            ║
// ║  ADD 2: Anish 50% 1st Combo — ONLY PUP (Pocket Pivot Bull) and           ║
// ║         PPD (Pocket Pivot Bear). Ported v6 → v5, logic identical.        ║
// ║  ADD 3: Displacement — single engine, Std Dev Multiplier is an input     ║
// ║         field with DEFAULT 4.5 (step 0.1, continuous threshold).         ║
// ║                                                                          ║
// ║  ┌──────────────────────────────────────────────────────────────────┐     ║
// ║  │  SIGNAL REGISTRY                                                │     ║
// ║  │  ─────────────────                                              │     ║
// ║  │  S1:  Bull PB              │ offset  0 │ bottom   │ labelup aqua │     ║
// ║  │  S2:  Bull PBJ             │ offset  0 │ bottom   │ diamond yel  │     ║
// ║  │  S3:  Bear PB              │ offset  0 │ top      │ labeldn org  │     ║
// ║  │  S4:  Bear PBJ             │ offset  0 │ top      │ diamond red  │     ║
// ║  │  S5:  Bull Re-entry Cross  │ offset  0 │ belowbar │ labelup lime │     ║
// ║  │  S6:  Bear Re-entry Cross  │ offset  0 │ abovebar │ labeldn red  │     ║
// ║  │  S7:  Bull Re-entry Slope  │ offset  0 │ belowbar │ labelup teal │     ║
// ║  │  S8:  Bear Re-entry Slope  │ offset  0 │ abovebar │ labeldn mar  │     ║
// ║  │  S9:  PUP Pocket Pivot Bull│ offset  0 │ belowbar │ tri-up blue  │     ║
// ║  │  S10: PPD Pocket Pivot Bear│ offset  0 │ abovebar │ tri-dn red   │     ║
// ║  │  S11: Displacement Bull    │ offset -1 │ top      │ square green │     ║
// ║  │  S12: Displacement Bear    │ offset -1 │ top      │ square red   │     ║
// ║  └──────────────────────────────────────────────────────────────────┘     ║
// ║                                                                          ║
// ║  OFFSET REGISTRY:                                                        ║
// ║  • S1–S10: offset = 0. Plot bar === alert bar === condition bar.         ║
// ║  • S11/S12: offset = -1 — FVG confirmation occurs on bar[0] but the      ║
// ║    displaced candle (the large-body bar) is bar[1]. Any combo check       ║
// ║    against Displacement co-signals must compare against bar[1].          ║
// ║                                                                          ║
// ║  REPAINT DOCTRINE (per source, preserved verbatim):                      ║
// ║  • S1–S4 gated by barstate.isconfirmed (source guarantee).               ║
// ║  • S5–S8 NOT conf-gated — KC Rev 8 fires on raw crossovers, preserved    ║
// ║    verbatim for 1:1 parity with the standalone KC Rev 8 study.           ║
// ║  • S9/S10 gated by barstate.isconfirmed (source guarantee).              ║
// ║  • S11/S12 gated by barstate.isconfirmed (source guarantee).             ║
// ╚════════════════════════════════════════════════════════════════════════════╝


// ============================================================================
// INPUTS — OKEH Zoo Engine  (defaults preserved)
// ============================================================================
grp_eng = "OKEH — Zoo Engine"
zoo_ma_type   = input.string("VWMA", "Base MA Type", options=["VWMA","EMA","SMA","WMA","HMA"], group=grp_eng)
zoo_ma_len    = input.int(5, "Base MA Length", minval=1, group=grp_eng)
zoo_price_src = input.source(close, "Price Source", group=grp_eng)


// ============================================================================
// INPUTS — OKEH PB&J Filter  (defaults preserved)
// ============================================================================
grp_pbj_filter = "OKEH — PB&J Filter"
zoo_pbj_ma_period   = input.int(20,   "MA Period",          minval=1,          group=grp_pbj_filter)
zoo_pbj_atr_period  = input.int(14,   "ATR Period",         minval=1,          group=grp_pbj_filter)
zoo_pbj_hh_ll       = input.int(25,   "HH/LL Lookback",    minval=1,          group=grp_pbj_filter)
zoo_pbj_atr_mult    = input.float(3.0,"ATR Multiplier",     step=0.1,         group=grp_pbj_filter)
zoo_pbj_vol_period  = input.int(20,   "Volume MA Period",   minval=1,          group=grp_pbj_filter)
zoo_pbj_vol_mult    = input.float(0.1,"Volume Multiplier",  step=0.1,         group=grp_pbj_filter)


// ============================================================================
// INPUTS — OKEH Supertrend  (defaults preserved)
// ============================================================================
grp_st = "OKEH — Supertrend"
zoo_use_st    = input.bool(true,  "Apply ATR Supertrend", group=grp_st)
zoo_st_period = input.int(10,     "ATR Period",           group=grp_st)
zoo_st_mult   = input.float(2.0,  "Multiplier",           group=grp_st)


// ============================================================================
// INPUTS — KC: Indicator Settings  (KC Rev 8 defaults preserved)
// ============================================================================
group_kc_indicator  = "KC: Indicator Settings"
string kc_maType     = input.string("EMA", "MA Type", options=["SMA", "EMA", "HMA", "VWMA", "LSMA"], group=group_kc_indicator)
int    kc_length     = input.int(20, "MA Length", minval=1, group=group_kc_indicator)
float  kc_mult       = input.float(2.0, "Multiplier", minval=0.001, group=group_kc_indicator)
kc_src               = input.source(close, "Source", group=group_kc_indicator)
string kc_bandsStyle = input.string("Average True Range", "Bands Style", options=["Average True Range", "True Range", "Range"], group=group_kc_indicator)
int    kc_atrLength  = input.int(10, "ATR Length", minval=1, group=group_kc_indicator)


// ============================================================================
// INPUTS — KC: Slope Calculation Settings  (KC Rev 8 defaults preserved)
// ============================================================================
group_kc_slope_calc = "KC: Slope Calculation Settings"
int   kc_slopeLookbackBars     = input.int(3, "Slope Lookback Bars", minval=1, group=group_kc_slope_calc, tooltip="Number of prior bars to check to confirm the MA was flat/opposite before the strong slope begins.")
float kc_bullishSlopeThreshold = input.float(title="Bullish Slope Threshold", defval=0.05, step=0.001, group=group_kc_slope_calc, tooltip="Midline MA change must be ABOVE this positive value to trigger a signal.")
float kc_bearishSlopeThreshold = input.float(title="Bearish Slope Threshold", defval=0.05, step=0.001, group=group_kc_slope_calc, tooltip="Midline MA change must be BELOW the negative of this value to trigger a signal.")


// ============================================================================
// INPUTS — KC: Re-entry family toggles  (KC Rev 8 defaults preserved)
// ============================================================================
group_reentry_cross_rules = "KC: Re-entry Cross Signals"
group_reentry_slope_rules = "KC: Re-entry Slope Signals"
bool showReentryCrosses = input.bool(true, "Show Re-entry + Basis Cross Signals", group=group_reentry_cross_rules)
bool showReentrySlopes  = input.bool(true, "Show Re-entry + Slope Turn Signals", group=group_reentry_slope_rules)


// ============================================================================
// INPUTS — Pocket Pivot (PUP / PPD)  (Anish 50% 1st Combo defaults preserved)
// ============================================================================
grp_pp = "Pocket Pivot (PUP / PPD)"
barSize    = input.float(3.0, "% Change (Barsize)", minval=0.1, step=0.1, group=grp_pp)
ppLookback = input.int(10, "Lookback Days", minval=1, group=grp_pp)
show_PUP   = input.bool(true, "Show PUP", group=grp_pp, inline="ppt")
show_PPD   = input.bool(true, "Show PPD", group=grp_pp, inline="ppt")


// ============================================================================
// INPUTS — Displacement  (single engine, multiplier DEFAULT 4.5)
// ============================================================================
grp_disp = "Displacement"
disp_type   = input.string("Open to Close", "Range Type", options=["Open to Close","High to Low"], group=grp_disp)
disp_len    = input.int(100, "Std Dev Length", minval=1, group=grp_disp)
disp_mult   = input.float(4.5, "Std Dev Multiplier", minval=0.1, step=0.1, group=grp_disp)
disp_show_b = input.bool(true, "Show Bull", group=grp_disp, inline="dt")
disp_show_r = input.bool(true, "Show Bear", group=grp_disp, inline="dt")


// ============================================================================
// INPUTS — Plot Toggles (PB/PBJ)  (all ON by default)
// ============================================================================
grp_plots = "★ Signal Plot Toggles ★"
show_BullPB   = input.bool(true, "Plot: Bull PB",   group=grp_plots, inline="pt")
show_BullPBJ  = input.bool(true, "Plot: Bull PBJ",  group=grp_plots, inline="pt")
show_BearPB   = input.bool(true, "Plot: Bear PB",   group=grp_plots, inline="pt2")
show_BearPBJ  = input.bool(true, "Plot: Bear PBJ",  group=grp_plots, inline="pt2")


// ============================================================================
// INPUTS — Alert Toggles (PB/PBJ)  (all ON by default)
// ============================================================================
grp_alerts = "★ Signal Alert Toggles ★"
alert_BullPB   = input.bool(true, "Alert: Bull PB",   group=grp_alerts, inline="at")
alert_BullPBJ  = input.bool(true, "Alert: Bull PBJ",  group=grp_alerts, inline="at")
alert_BearPB   = input.bool(true, "Alert: Bear PB",   group=grp_alerts, inline="at2")
alert_BearPBJ  = input.bool(true, "Alert: Bear PBJ",  group=grp_alerts, inline="at2")


// ============================================================================
// INPUTS — Alert Multiplexer
// ============================================================================
grp_mux = "★ Alert Multiplexer ★"
mux_choice = input.string("All Signals", "Multiplexer Signal Select",
     options=["All Signals", "Bull PB", "Bull PBJ", "Bear PB", "Bear PBJ",
              "Bull Only", "Bear Only", "PB Only", "PBJ Only",
              "KC Re-entry Only", "PUP/PPD Only", "Displacement Only"],
     group=grp_mux,
     tooltip="Select which signal(s) the multiplexed alert() fires for.")


// ============================================================================
// SHARED — confirmed-bar gate
// ============================================================================
conf = barstate.isconfirmed


// ============================================================================
// ENGINE — Zoo Moving Average
// ============================================================================
f_ma(src, len, t) =>
    switch t
        "EMA"  => ta.ema(src, len)
        "SMA"  => ta.sma(src, len)
        "WMA"  => ta.wma(src, len)
        "HMA"  => ta.hma(src, len)
        "VWMA" => ta.vwma(src, len)
        => ta.sma(src, len)

float base_ma = f_ma(zoo_price_src, zoo_ma_len, zoo_ma_type)


// ============================================================================
// ENGINE — Supertrend
// ============================================================================
float st_atr     = zoo_st_mult * ta.atr(zoo_st_period)
float dyn_long   = base_ma - st_atr
float dyn_short  = base_ma + st_atr

var int st_dir   = 1
float sig_line   = 0.0
float curr_long  = 0.0
curr_long  := base_ma > nz(curr_long[1], dyn_long)   ? math.max(dyn_long, nz(curr_long[1]))   : dyn_long
float curr_short = 0.0
curr_short := base_ma < nz(curr_short[1], dyn_short) ? math.min(dyn_short, nz(curr_short[1])) : dyn_short

if zoo_use_st
    if nz(st_dir[1]) == -1 and zoo_price_src > nz(curr_short[1])
        st_dir := 1
    else if nz(st_dir[1]) == 1 and zoo_price_src < nz(curr_long[1])
        st_dir := -1
    sig_line := st_dir == 1 ? curr_long : curr_short
else
    sig_line := base_ma


// ============================================================================
// ENGINE — Crossovers & Re-acceleration
// ============================================================================
bool buy_cross    = ta.crossover(zoo_price_src, sig_line)
bool sell_cross   = ta.crossunder(zoo_price_src, sig_line)
bool is_rising    = sig_line > nz(sig_line[1])
bool is_falling   = sig_line < nz(sig_line[1])
bool bull_reaccel = st_dir == 1  and is_rising  and nz(sig_line[1]) == nz(sig_line[2])
bool bear_reaccel = st_dir == -1 and is_falling and nz(sig_line[1]) == nz(sig_line[2])


// ============================================================================
// ENGINE — PB&J Filter
// ============================================================================
float pbj_ma  = ta.ema(close, zoo_pbj_ma_period)
float pbj_atr = ta.atr(zoo_pbj_atr_period)
float avg_vol = ta.sma(volume, zoo_pbj_vol_period)
float thresh  = close == 0 ? 0 : (pbj_atr / close * zoo_pbj_atr_mult)

bool pbj_buy  = low  < pbj_ma * (1 - thresh) and low  == ta.lowest(low, zoo_pbj_hh_ll)   and volume > avg_vol * zoo_pbj_vol_mult
bool pbj_sell = high > pbj_ma * (1 + thresh) and high == ta.highest(high, zoo_pbj_hh_ll) and volume > avg_vol * zoo_pbj_vol_mult


// ============================================================================
// ENGINE — Level Management (PB zones)
// ============================================================================
type lvl
    float upper
    float lower
    float vol
    bool  approached

float atr_pb = ta.atr(14) * 2.0

var bull_lvls = array.new<lvl>()
var bear_lvls = array.new<lvl>()

f_add_lvl(arr, up, lo, v) =>
    if math.abs(up - lo) >= syminfo.mintick
        array.push(arr, lvl.new(up, lo, v, false))

f_add_lander(is_bull, cross, arr) =>
    if cross
        float up = 0.0
        float lo = 0.0
        if is_bull
            up := math.max(open[1], close[1])
            lo := low[1]
            if up - lo < atr_pb * 0.5
                up := lo + atr_pb * 0.5
        else
            up := high[1]
            lo := math.min(open[1], close[1])
            if up - lo < atr_pb * 0.5
                lo := up - atr_pb * 0.5
        f_add_lvl(arr, up, lo, volume[1])

f_add_reaccel(is_bull, sig, arr) =>
    if sig and not na(sig_line)
        float p1 = sig_line
        float p2 = is_bull ? math.min(open, close) : math.max(open, close)
        f_add_lvl(arr, math.max(p1, p2), math.min(p1, p2), volume)

f_check_approach(arr, is_bull) =>
    bool approached = false
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            if i >= array.size(arr)
                continue
            l = array.get(arr, i)
            if is_bull and close < l.lower
                array.remove(arr, i)
                continue
            if not is_bull and close > l.upper
                array.remove(arr, i)
                continue
            float ap = is_bull ? l.upper * 1.005 : l.lower * 0.995
            if is_bull
                if not l.approached and low <= ap
                    approached := true
                    l.approached := true
                else if l.approached and low > l.upper
                    l.approached := false
            else
                if not l.approached and high >= ap
                    approached := true
                    l.approached := true
                else if l.approached and high < l.lower
                    l.approached := false
    approached

f_add_lander(true,  buy_cross,  bull_lvls)
f_add_lander(false, sell_cross, bear_lvls)
f_add_reaccel(true,  bull_reaccel, bull_lvls)
f_add_reaccel(false, bear_reaccel, bear_lvls)

var bool wait_buy      = false
var bool wait_sell     = false
var bool wait_pbj_buy  = false
var bool wait_pbj_sell = false

if barstate.isconfirmed
    if f_check_approach(bull_lvls, true)
        wait_buy := true
    if f_check_approach(bear_lvls, false)
        wait_sell := true

if pbj_buy
    wait_pbj_buy := true
if pbj_sell
    wait_pbj_sell := true

while array.size(bull_lvls) > 30
    array.shift(bull_lvls)
while array.size(bear_lvls) > 30
    array.shift(bear_lvls)


// ============================================================================
// RAW SIGNAL BOOLS (pre-confirmation intermediate)
// ============================================================================
bool sig_pb_buy   = buy_cross and wait_buy
bool sig_pbj_buy  = buy_cross and wait_pbj_buy
bool sig_pb_sell  = sell_cross and wait_sell
bool sig_pbj_sell = sell_cross and wait_pbj_sell

if sig_pb_buy
    wait_buy     := false
if sig_pbj_buy
    wait_pbj_buy := false
if sig_pb_sell
    wait_sell     := false
if sig_pbj_sell
    wait_pbj_sell := false


// ──────────────────────────────────────────────────────────────────────────────
// S1 — BULL PB  │  offset = 0  │  bottom  │  labelup  │  aqua
// ──────────────────────────────────────────────────────────────────────────────
bool sigBullPB  = barstate.isconfirmed and sig_pb_buy and not sig_pbj_buy

// ──────────────────────────────────────────────────────────────────────────────
// S2 — BULL PBJ  │  offset = 0  │  bottom  │  diamond  │  yellow
// ──────────────────────────────────────────────────────────────────────────────
bool sigBullPBJ = barstate.isconfirmed and sig_pbj_buy

// ──────────────────────────────────────────────────────────────────────────────
// S3 — BEAR PB  │  offset = 0  │  top  │  labeldown  │  orange
// ──────────────────────────────────────────────────────────────────────────────
bool sigBearPB  = barstate.isconfirmed and sig_pb_sell and not sig_pbj_sell

// ──────────────────────────────────────────────────────────────────────────────
// S4 — BEAR PBJ  │  offset = 0  │  top  │  diamond  │  red
// ──────────────────────────────────────────────────────────────────────────────
bool sigBearPBJ = barstate.isconfirmed and sig_pbj_sell


// ============================================================================
// ENGINE — KC Basis and Bands  (KC Rev 8, verbatim)
// ============================================================================
kc_ma = switch kc_maType
    "SMA"  => ta.sma(kc_src, kc_length)
    "EMA"  => ta.ema(kc_src, kc_length)
    "HMA"  => ta.hma(kc_src, kc_length)
    "VWMA" => ta.vwma(kc_src, kc_length)
    "LSMA" => ta.linreg(kc_src, kc_length, 0)

kc_range_val = switch kc_bandsStyle
    "True Range"         => ta.tr(true)
    "Average True Range" => ta.atr(kc_atrLength)
    => ta.rma(high - low, kc_length)

kc_upper = kc_ma + kc_range_val * kc_mult
kc_lower = kc_ma - kc_range_val * kc_mult

// --- Base Signal Detections (used by re-entry families) ---
kc_cross_above_basis      = ta.crossover(kc_src, kc_ma)
kc_cross_below_basis      = ta.crossunder(kc_src, kc_ma)
kc_reentry_from_above     = ta.crossunder(kc_src, kc_upper)
kc_reentry_from_below     = ta.crossover(kc_src, kc_lower)

// --- Slope Signal Calculations (Inflection Point with Tolerance) ---
kc_current_slope           = kc_ma - kc_ma[1]
kc_prior_trend_change      = kc_ma[1] - kc_ma[kc_slopeLookbackBars]
kc_midline_bullish_signal  = kc_current_slope > kc_bullishSlopeThreshold and kc_prior_trend_change < (kc_bullishSlopeThreshold / 2)
kc_midline_bearish_signal  = kc_current_slope < (-kc_bearishSlopeThreshold) and kc_prior_trend_change > (-kc_bearishSlopeThreshold / 2)

// --- Re-entry Cross Signal Logic (Midline Cross after Band Re-entry) ---
var waiting_for_bearish_cross = false
var waiting_for_bullish_cross = false

// Bearish Re-entry Cross
if kc_reentry_from_above
    waiting_for_bearish_cross := true
if kc_cross_above_basis
    waiting_for_bearish_cross := false
bearish_reentry_cross_signal = waiting_for_bearish_cross and kc_cross_below_basis
if bearish_reentry_cross_signal
    waiting_for_bearish_cross := false

// Bullish Re-entry Cross
if kc_reentry_from_below
    waiting_for_bullish_cross := true
if kc_cross_below_basis
    waiting_for_bullish_cross := false
bullish_reentry_cross_signal = waiting_for_bullish_cross and kc_cross_above_basis
if bullish_reentry_cross_signal
    waiting_for_bullish_cross := false

// --- Re-entry Slope Signal Logic (Slope Turn after Band Re-entry) ---
var waiting_for_slope_bearish = false
var waiting_for_slope_bullish = false

// Bearish Re-entry Slope
if kc_reentry_from_above
    waiting_for_slope_bearish := true
bearish_reentry_slope_signal = waiting_for_slope_bearish and kc_midline_bearish_signal
if bearish_reentry_slope_signal
    waiting_for_slope_bearish := false

// Bullish Re-entry Slope
if kc_reentry_from_below
    waiting_for_slope_bullish := true
bullish_reentry_slope_signal = waiting_for_slope_bullish and kc_midline_bullish_signal
if bullish_reentry_slope_signal
    waiting_for_slope_bullish := false


// ──────────────────────────────────────────────────────────────────────────────
// S5 — BULL RE-ENTRY CROSS  │  offset = 0  │  belowbar  │  labelup  │  lime
// S6 — BEAR RE-ENTRY CROSS  │  offset = 0  │  abovebar  │  labeldown  │  red
// S7 — BULL RE-ENTRY SLOPE  │  offset = 0  │  belowbar  │  labelup  │  teal
// S8 — BEAR RE-ENTRY SLOPE  │  offset = 0  │  abovebar  │  labeldown  │  maroon
// ──────────────────────────────────────────────────────────────────────────────
bool sigBullReCross = showReentryCrosses and bullish_reentry_cross_signal
bool sigBearReCross = showReentryCrosses and bearish_reentry_cross_signal
bool sigBullReSlope = showReentrySlopes  and bullish_reentry_slope_signal
bool sigBearReSlope = showReentrySlopes  and bearish_reentry_slope_signal


// ============================================================================
// ENGINE — Pocket Pivot (PUP / PPD)  (Anish 50% 1st Combo, v6→v5 port)
// ============================================================================
float redVol = close < open ? volume : 0.0
float greenVol = close > open ? volume : 0.0
float hiRedVol = ta.highest(redVol[1], ppLookback)
float hiGreenVol = ta.highest(greenVol[1], ppLookback)

bool priceUp = ((close - open) / open) * 100 > barSize
bool priceDn = ((open - close) / open) * 100 > barSize
bool volBull = volume > hiRedVol
bool volBear = volume > hiGreenVol

bool sPPBull = priceUp and volBull
bool sPPBear = priceDn and volBear

// ──────────────────────────────────────────────────────────────────────────────
// S9  — PUP (Pocket Pivot Bull)  │  offset = 0  │  belowbar  │  triangleup  │  blue
// S10 — PPD (Pocket Pivot Bear)  │  offset = 0  │  abovebar  │  triangledown │  red
// ──────────────────────────────────────────────────────────────────────────────
bool sigPUP = conf and sPPBull
bool sigPPD = conf and sPPBear


// ============================================================================
// ENGINE — Displacement  (single engine, mult default 4.5)
// ============================================================================
float disp_rng = disp_type == "Open to Close" ? math.abs(open - close) : high - low
float disp_std = ta.stdev(disp_rng, disp_len)
float disp_thresh = disp_std * disp_mult
bool  disp_prevDisp = disp_rng[1] > disp_thresh[1]
bool  disp_bullFVG  = low > high[2] and close[1] > open[1]
bool  disp_bearFVG  = high < low[2] and close[1] < open[1]

// ──────────────────────────────────────────────────────────────────────────────
// S11 — DISPLACEMENT BULL  │  offset = -1  │  top  │  square  │  green
// S12 — DISPLACEMENT BEAR  │  offset = -1  │  top  │  square  │  red
// ──────────────────────────────────────────────────────────────────────────────
bool sigDispBull = conf and disp_prevDisp and disp_bullFVG
bool sigDispBear = conf and disp_prevDisp and disp_bearFVG


// ============================================================================
// sigAny — UNIFIED ANY-SIGNAL FLAG (all twelve)
// ============================================================================
bool sigAny = sigBullPB or sigBullPBJ or sigBearPB or sigBearPBJ or
     sigBullReCross or sigBearReCross or sigBullReSlope or sigBearReSlope or
     sigPUP or sigPPD or sigDispBull or sigDispBear


// ============================================================================
// PLOTS — SOVEREIGN SHAPES  (shapes/colors/locations preserved from sources)
// ============================================================================

// S1 — BULL PB  │  offset = 0
plotshape(show_BullPB  and sigBullPB,  title="S1: Bull PB",  style=shape.labelup,   location=location.bottom, color=color.new(color.aqua, 75),   size=size.small,  text="PB",  textcolor=color.white, offset=0)

// S2 — BULL PBJ  │  offset = 0
plotshape(show_BullPBJ and sigBullPBJ, title="S2: Bull PBJ", style=shape.diamond,   location=location.bottom, color=color.new(color.yellow, 25), size=size.normal, text="PBJ", textcolor=color.white, offset=0)

// S3 — BEAR PB  │  offset = 0
plotshape(show_BearPB  and sigBearPB,  title="S3: Bear PB",  style=shape.labeldown, location=location.top, color=color.new(color.orange, 75),  size=size.small,  text="PB",  textcolor=color.white, offset=0)

// S4 — BEAR PBJ  │  offset = 0
plotshape(show_BearPBJ and sigBearPBJ, title="S4: Bear PBJ", style=shape.diamond, location=location.top, color=color.new(color.red, 25),     size=size.normal, text="PBJ", textcolor=color.white, offset=0)

// S5/S6 — KC Re-entry Cross  │  offset = 0
plotshape(sigBullReCross, title="S5: Bull Re-entry Cross", style=shape.labelup,   location=location.belowbar, color=color.new(color.lime, 0),   size=size.small, text="R-C", offset=0)
plotshape(sigBearReCross, title="S6: Bear Re-entry Cross", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),    size=size.small, text="R-C", offset=0)

// S7/S8 — KC Re-entry Slope  │  offset = 0
plotshape(sigBullReSlope, title="S7: Bull Re-entry Slope", style=shape.labelup,   location=location.belowbar, color=color.new(color.teal, 0),   size=size.small, text="R-S", offset=0)
plotshape(sigBearReSlope, title="S8: Bear Re-entry Slope", style=shape.labeldown, location=location.abovebar, color=color.new(color.maroon, 0), size=size.small, text="R-S", offset=0)

// S9/S10 — Pocket Pivot  │  offset = 0
plotshape(show_PUP and sigPUP, title="S9: PUP Pocket Pivot Bull",  style=shape.triangleup,   location=location.belowbar, color=color.blue, size=size.normal, text="PUP", offset=0)
plotshape(show_PPD and sigPPD, title="S10: PPD Pocket Pivot Bear", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.normal, text="PPD", offset=0)

// S11/S12 — Displacement  │  offset = -1 (plots on the displaced candle, bar[1])
plotshape(disp_show_b and sigDispBull, title="S11: Displacement Bull", style=shape.square, location=location.top, color=color.new(#00FF00, 0), text="D", textcolor=color.white, size=size.small, offset=-1)
plotshape(disp_show_r and sigDispBear, title="S12: Displacement Bear", style=shape.square, location=location.top, color=color.new(#FF0000, 0), text="D", textcolor=color.white, size=size.small, offset=-1)


// ============================================================================
// INDIVIDUAL ALERTS — alertcondition() per signal (same booleans as plots)
// ============================================================================
alertcondition(alert_BullPB  and sigBullPB,  title="S1: Bull PB",  message="🟢 Bull PB fired")
alertcondition(alert_BullPBJ and sigBullPBJ, title="S2: Bull PBJ", message="🟢 Bull PBJ fired")
alertcondition(alert_BearPB  and sigBearPB,  title="S3: Bear PB",  message="🔴 Bear PB fired")
alertcondition(alert_BearPBJ and sigBearPBJ, title="S4: Bear PBJ", message="🔴 Bear PBJ fired")
alertcondition(sigBullReCross, title="S5: Bull Re-entry Cross", message="{{ticker}}: Bullish Reversal (Re-entry & Basis Cross Up)")
alertcondition(sigBearReCross, title="S6: Bear Re-entry Cross", message="{{ticker}}: Bearish Reversal (Re-entry & Basis Cross Down)")
alertcondition(sigBullReSlope, title="S7: Bull Re-entry Slope", message="{{ticker}}: Bullish Reversal (Re-entry & Slope Turn Up)")
alertcondition(sigBearReSlope, title="S8: Bear Re-entry Slope", message="{{ticker}}: Bearish Reversal (Re-entry & Slope Turn Down)")
alertcondition(show_PUP and sigPUP, title="S9: PUP Pocket Pivot Bull",  message="Bullish Pocket Pivot on {{ticker}}")
alertcondition(show_PPD and sigPPD, title="S10: PPD Pocket Pivot Bear", message="Bearish Pocket Pivot on {{ticker}}")
alertcondition(disp_show_b and sigDispBull, title="S11: Displacement Bull", message="Displacement Bull on {{ticker}}")
alertcondition(disp_show_r and sigDispBear, title="S12: Displacement Bear", message="Displacement Bear on {{ticker}}")
alertcondition(sigAny, title="ANY Signal", message="Signal fired — check chart")


// ============================================================================
// f_getAny() — Returns true if ANY signal fired this bar
// ============================================================================
f_getAny() =>
    sigAny


// ============================================================================
// f_getAll() — Returns full name string + count of every signal that fired
// ============================================================================
f_getAll() =>
    int   _count = 0
    string _msg  = ""
    if sigBullPB
        _count += 1
        _msg   += "S1 Bull PB | "
    if sigBullPBJ
        _count += 1
        _msg   += "S2 Bull PBJ | "
    if sigBearPB
        _count += 1
        _msg   += "S3 Bear PB | "
    if sigBearPBJ
        _count += 1
        _msg   += "S4 Bear PBJ | "
    if sigBullReCross
        _count += 1
        _msg   += "S5 Bull Re-entry Cross | "
    if sigBearReCross
        _count += 1
        _msg   += "S6 Bear Re-entry Cross | "
    if sigBullReSlope
        _count += 1
        _msg   += "S7 Bull Re-entry Slope | "
    if sigBearReSlope
        _count += 1
        _msg   += "S8 Bear Re-entry Slope | "
    if sigPUP
        _count += 1
        _msg   += "S9 PUP | "
    if sigPPD
        _count += 1
        _msg   += "S10 PPD | "
    if sigDispBull
        _count += 1
        _msg   += "S11 Displacement Bull | "
    if sigDispBear
        _count += 1
        _msg   += "S12 Displacement Bear | "
    [_msg, _count]


// ============================================================================
// AGGREGATED ALERT — dynamic alert() with full detail string
// Fires alert.freq_once_per_bar_close — 1:1 parity with plot.
// ============================================================================
[allMsg, allCount] = f_getAll()

if allCount > 0
    alert("CONSOL [" + str.tostring(allCount) + "] → " + allMsg, alert.freq_once_per_bar_close)


// ============================================================================
// MULTIPLEXER ALERT — fires only for the user-selected signal(s)
// Uses alert.freq_once_per_bar_close — 1:1 parity guaranteed.
// ============================================================================
bool mux_fire = switch mux_choice
    "Bull PB"           => alert_BullPB  and sigBullPB
    "Bull PBJ"          => alert_BullPBJ and sigBullPBJ
    "Bear PB"           => alert_BearPB  and sigBearPB
    "Bear PBJ"          => alert_BearPBJ and sigBearPBJ
    "Bull Only"         => (alert_BullPB and sigBullPB) or (alert_BullPBJ and sigBullPBJ)
    "Bear Only"         => (alert_BearPB and sigBearPB) or (alert_BearPBJ and sigBearPBJ)
    "PB Only"           => (alert_BullPB and sigBullPB) or (alert_BearPB and sigBearPB)
    "PBJ Only"          => (alert_BullPBJ and sigBullPBJ) or (alert_BearPBJ and sigBearPBJ)
    "KC Re-entry Only"  => sigBullReCross or sigBearReCross or sigBullReSlope or sigBearReSlope
    "PUP/PPD Only"      => (show_PUP and sigPUP) or (show_PPD and sigPPD)
    "Displacement Only" => (disp_show_b and sigDispBull) or (disp_show_r and sigDispBear)
    "All Signals"       => sigAny
    => sigAny

string mux_msg = ""
if mux_fire
    if mux_choice == "All Signals" or mux_choice == "Bull Only" or mux_choice == "Bear Only" or mux_choice == "PB Only" or mux_choice == "PBJ Only" or mux_choice == "KC Re-entry Only" or mux_choice == "PUP/PPD Only" or mux_choice == "Displacement Only"
        mux_msg := allMsg
    else
        mux_msg := mux_choice
    mux_msg

if mux_fire and mux_msg != ""
    alert("MUX [" + mux_choice + "] → " + mux_msg, alert.freq_once_per_bar_close)


// ============================================================================
// NOTE: Supertrend calculation is fully active (sig_line, st_dir, curr_long,
// curr_short, buy_cross, sell_cross, bull_reaccel, bear_reaccel).
// No plotted line — by design. The engine runs; the line does not draw.
// KC bands (kc_ma / kc_upper / kc_lower) likewise calculate but do not draw —
// only the four re-entry signals from KC Rev 8 are included in this study.
// ============================================================================
