//@version=5
// ============================================================================
// HV ROLLING CLUSTERS NRA  --  rolling-window high-volume CLUSTER detectors
// ============================================================================
// WHAT THIS IS
//   Rolling-window CLUSTER detectors over a clean "N-bar-high AND ABOVE" ladder.
//   The individual volume tiers (50/150/250/500/1000/1500/2000/2500/3000/4000-bar
//   highs, and the all-time high = Nagasaki/HEV) are STILL computed -- they are
//   the raw material the windows count -- but they no longer paint per-tier
//   markers or fire per-tier alerts. ONLY the 11 cluster windows plot and alert.
//
//   Each window answers one question:
//     "Did at least <COUNT> events of <CLASS> occur within the last <BARS> bars?"
//   COUNT (events) and BARS (window length) are user inputs on EVERY window.
//
// THE LADDER  (every window is a pure "N and above" rung -- no "only"/"band")
//   W1  Nagasaki    all-time-high volume (== HEV; the rarest "and above")
//   W2  4000+       a 4000-bar volume high or rarer
//   W3  3000+       a 3000-bar high or rarer
//   W4  2500+       a 2500-bar high or rarer
//   W5  2000+       a 2000-bar high or rarer
//   W6  1500+       a 1500-bar high or rarer
//   W7  1000+       a 1000-bar high or rarer
//   W8  500+        a 500-bar high or rarer
//   W9  250+        a 250-bar high or rarer
//   W10 150+        a 150-bar high or rarer
//   W11 50+         a 50-bar high or rarer (ANY high-volume tier)
//
//   NESTING makes "N and above" trivial: a 1000-bar high is automatically a
//   500/250/150/50-bar high, so the raw is{N}Bar flag ALREADY means "N or rarer".
//   No "only"/"band" subtraction anywhere -- that arbitrary logic is gone.
//
// NON-REPAINTING (NRA) + CONSTITUTIONAL ROLLING WINDOWS
//   * Every tier compares the PRIOR CLOSED bar: volume[1] == ta.highest(volume,N)[1].
//   * Each window is a TRUE SLIDING trailing-N count via f_sum_true(), with the
//     base event gated on barstate.isconfirmed (closed bars only). No anchored
//     "wait N bars then reset" window anywhere.
//   * Fire = LEADING EDGE of (count >= COUNT):  cond and not cond[1]  -- fires once
//     when the cluster completes, then re-arms automatically.
//   * Plot and alert for each window share ONE boolean -> 1:1, can never desync.
//   * Markers plot with offset=-1 onto the closed bar that completed the cluster.
//
// ALERTS
//   * One alertcondition per window (11), plus one "ANY" alertcondition, plus one
//     alert() function call (the "any-call") whose payload names which windows fired.
//
// (Hot Spot calendar signals were REMOVED in this build.)
// ASCII-ONLY source (TradingView's Pine lexer rejects non-ASCII punctuation).
// ============================================================================

indicator("HV ROLLING CLUSTERS (Nagasaki + 50-4000 ladder) NRA", shorttitle="HV ROLL", overlay=true, max_bars_back=5000)

// --- Canonical suite helper: count TRUE over a trailing SLIDING window of len bars.
f_sum_true(cond, len) =>
    float s = 0.0
    int L = math.max(1, len)
    for i = 0 to L - 1
        s += (cond[i] ? 1.0 : 0.0)
    s


// ============================================================================
// === INPUTS -- per window: Enable + COUNT (events) + within BARS (window) ===
// ============================================================================
grp1  = "W1: Nagasaki / all-time-high volume"
w1_on  = input.bool(true, "Enable W1 NAG", group=grp1)
w1_cnt = input.int(2, "Count (events)", minval=1, inline="w1", group=grp1)
w1_win = input.int(250, "within Bars", minval=1, maxval=5000, inline="w1", group=grp1)

grp2  = "W2: 4000-bar high and above"
w2_on  = input.bool(true, "Enable W2 4000", group=grp2)
w2_cnt = input.int(2, "Count (events)", minval=1, inline="w2", group=grp2)
w2_win = input.int(250, "within Bars", minval=1, maxval=5000, inline="w2", group=grp2)

grp3  = "W3: 3000-bar high and above"
w3_on  = input.bool(true, "Enable W3 3000", group=grp3)
w3_cnt = input.int(2, "Count (events)", minval=1, inline="w3", group=grp3)
w3_win = input.int(200, "within Bars", minval=1, maxval=5000, inline="w3", group=grp3)

grp4  = "W4: 2500-bar high and above"
w4_on  = input.bool(true, "Enable W4 2500", group=grp4)
w4_cnt = input.int(2, "Count (events)", minval=1, inline="w4", group=grp4)
w4_win = input.int(200, "within Bars", minval=1, maxval=5000, inline="w4", group=grp4)

grp5  = "W5: 2000-bar high and above"
w5_on  = input.bool(true, "Enable W5 2000", group=grp5)
w5_cnt = input.int(2, "Count (events)", minval=1, inline="w5", group=grp5)
w5_win = input.int(175, "within Bars", minval=1, maxval=5000, inline="w5", group=grp5)

grp6  = "W6: 1500-bar high and above"
w6_on  = input.bool(true, "Enable W6 1500", group=grp6)
w6_cnt = input.int(2, "Count (events)", minval=1, inline="w6", group=grp6)
w6_win = input.int(150, "within Bars", minval=1, maxval=5000, inline="w6", group=grp6)

grp7  = "W7: 1000-bar high and above"
w7_on  = input.bool(true, "Enable W7 1000", group=grp7)
w7_cnt = input.int(2, "Count (events)", minval=1, inline="w7", group=grp7)
w7_win = input.int(150, "within Bars", minval=1, maxval=5000, inline="w7", group=grp7)

grp8  = "W8: 500-bar high and above"
w8_on  = input.bool(true, "Enable W8 500", group=grp8)
w8_cnt = input.int(2, "Count (events)", minval=1, inline="w8", group=grp8)
w8_win = input.int(100, "within Bars", minval=1, maxval=5000, inline="w8", group=grp8)

grp9  = "W9: 250-bar high and above"
w9_on  = input.bool(true, "Enable W9 250", group=grp9)
w9_cnt = input.int(3, "Count (events)", minval=1, inline="w9", group=grp9)
w9_win = input.int(75, "within Bars", minval=1, maxval=5000, inline="w9", group=grp9)

grp10  = "W10: 150-bar high and above"
w10_on  = input.bool(true, "Enable W10 150", group=grp10)
w10_cnt = input.int(3, "Count (events)", minval=1, inline="w10", group=grp10)
w10_win = input.int(50, "within Bars", minval=1, maxval=5000, inline="w10", group=grp10)

grp11  = "W11: 50-bar high and above (any HV tier)"
w11_on  = input.bool(true, "Enable W11 50", group=grp11)
w11_cnt = input.int(4, "Count (events)", minval=1, inline="w11", group=grp11)
w11_win = input.int(30, "within Bars", minval=1, maxval=5000, inline="w11", group=grp11)

// ============================================================================
// === INDIVIDUAL TIER CALCULATIONS  (kept for COUNTING only -- no own plot/alert)
// ============================================================================
// All comparisons use [1] (prior CLOSED bar): volume[1] == ta.highest(volume,N)[1]
// can never change once the bar closes -> non-repainting by construction.
bool is50Bar = volume[1] == ta.highest(volume, 50)[1]
bool is150Bar = volume[1] == ta.highest(volume, 150)[1]
bool is250Bar = volume[1] == ta.highest(volume, 250)[1]
bool is500Bar = volume[1] == ta.highest(volume, 500)[1]
bool is1000Bar = volume[1] == ta.highest(volume, 1000)[1]
bool is1500Bar = volume[1] == ta.highest(volume, 1500)[1]
bool is2000Bar = volume[1] == ta.highest(volume, 2000)[1]
bool is2500Bar = volume[1] == ta.highest(volume, 2500)[1]
bool is3000Bar = volume[1] == ta.highest(volume, 3000)[1]
bool is4000Bar = volume[1] == ta.highest(volume, 4000)[1]

// All-time-high volume (HEV) -- running max over CONFIRMED bars only.
// HEV == Nagasaki (the Heavy Weapons all-time-high-volume signal).
var float maxVolEver = 0.0
bool isHEV = false
if volume[1] > maxVolEver
    maxVolEver := volume[1]
    isHEV := true
bool isNagasaki = isHEV

// ============================================================================
// === CLASS EVENTS (confirmed bars only) -- the raw material each window counts
// ============================================================================
// Every class is a pure ladder rung: the raw is{N}Bar flag == "N and above".
bool conf = barstate.isconfirmed
bool evt_nag = conf and isHEV
bool evt_4000 = conf and is4000Bar
bool evt_3000 = conf and is3000Bar
bool evt_2500 = conf and is2500Bar
bool evt_2000 = conf and is2000Bar
bool evt_1500 = conf and is1500Bar
bool evt_1000 = conf and is1000Bar
bool evt_500 = conf and is500Bar
bool evt_250 = conf and is250Bar
bool evt_150 = conf and is150Bar
bool evt_50 = conf and is50Bar

// ============================================================================
// === ROLLING-WINDOW CLUSTER DETECTIONS (sliding trailing-N, leading-edge fire)
// ============================================================================
// nN = events of the class in trailing winN bars.  condN = nN >= countN.
// fire_WN = leading edge of condN (fires once when the cluster completes).
float n1 = f_sum_true(evt_nag, w1_win)
float n2 = f_sum_true(evt_4000, w2_win)
float n3 = f_sum_true(evt_3000, w3_win)
float n4 = f_sum_true(evt_2500, w4_win)
float n5 = f_sum_true(evt_2000, w5_win)
float n6 = f_sum_true(evt_1500, w6_win)
float n7 = f_sum_true(evt_1000, w7_win)
float n8 = f_sum_true(evt_500, w8_win)
float n9 = f_sum_true(evt_250, w9_win)
float n10 = f_sum_true(evt_150, w10_win)
float n11 = f_sum_true(evt_50, w11_win)

bool c1 = n1 >= w1_cnt
bool c2 = n2 >= w2_cnt
bool c3 = n3 >= w3_cnt
bool c4 = n4 >= w4_cnt
bool c5 = n5 >= w5_cnt
bool c6 = n6 >= w6_cnt
bool c7 = n7 >= w7_cnt
bool c8 = n8 >= w8_cnt
bool c9 = n9 >= w9_cnt
bool c10 = n10 >= w10_cnt
bool c11 = n11 >= w11_cnt

bool fire_W1 = w1_on and c1 and not c1[1]
bool fire_W2 = w2_on and c2 and not c2[1]
bool fire_W3 = w3_on and c3 and not c3[1]
bool fire_W4 = w4_on and c4 and not c4[1]
bool fire_W5 = w5_on and c5 and not c5[1]
bool fire_W6 = w6_on and c6 and not c6[1]
bool fire_W7 = w7_on and c7 and not c7[1]
bool fire_W8 = w8_on and c8 and not c8[1]
bool fire_W9 = w9_on and c9 and not c9[1]
bool fire_W10 = w10_on and c10 and not c10[1]
bool fire_W11 = w11_on and c11 and not c11[1]

// ============================================================================
// === PLOTS -- the cluster detection plots (offset=-1 -> lands on the closed bar
// === that completed the cluster). No individual-tier shapes anymore.
// ============================================================================
plotshape(fire_W1, "W1 NAG cluster", shape.diamond, location.top, color.new(color.purple, 0), size=size.normal, text="NAG", textcolor=color.white, offset=-1)
plotshape(fire_W2, "W2 4000 cluster", shape.circle, location.top, color.rgb(255, 45, 40, 0), size=size.large, text="4000", textcolor=color.white, offset=-1)
plotshape(fire_W3, "W3 3000 cluster", shape.circle, location.top, color.rgb(231, 45, 64, 0), size=size.large, text="3000", textcolor=color.white, offset=-1)
plotshape(fire_W4, "W4 2500 cluster", shape.circle, location.top, color.rgb(207, 45, 88, 0), size=size.normal, text="2500", textcolor=color.white, offset=-1)
plotshape(fire_W5, "W5 2000 cluster", shape.circle, location.top, color.rgb(183, 45, 112, 0), size=size.normal, text="2000", textcolor=color.white, offset=-1)
plotshape(fire_W6, "W6 1500 cluster", shape.circle, location.top, color.rgb(159, 45, 136, 0), size=size.normal, text="1500", textcolor=color.white, offset=-1)
plotshape(fire_W7, "W7 1000 cluster", shape.circle, location.top, color.rgb(136, 45, 159, 0), size=size.small, text="1000", textcolor=color.white, offset=-1)
plotshape(fire_W8, "W8 500 cluster", shape.circle, location.top, color.rgb(112, 45, 183, 0), size=size.small, text="500", textcolor=color.white, offset=-1)
plotshape(fire_W9, "W9 250 cluster", shape.circle, location.top, color.rgb(88, 45, 207, 0), size=size.tiny, text="250", textcolor=color.white, offset=-1)
plotshape(fire_W10, "W10 150 cluster", shape.circle, location.top, color.rgb(64, 45, 231, 0), size=size.tiny, text="150", textcolor=color.white, offset=-1)
plotshape(fire_W11, "W11 50 cluster", shape.circle, location.top, color.rgb(40, 45, 255, 0), size=size.tiny, text="50", textcolor=color.white, offset=-1)

// Numeric counts (data-window only -- helps tune COUNT/BARS; no chart clutter).
plot(n1, "W1 count (NAG)", display=display.data_window)
plot(n2, "W2 count (4000)", display=display.data_window)
plot(n3, "W3 count (3000)", display=display.data_window)
plot(n4, "W4 count (2500)", display=display.data_window)
plot(n5, "W5 count (2000)", display=display.data_window)
plot(n6, "W6 count (1500)", display=display.data_window)
plot(n7, "W7 count (1000)", display=display.data_window)
plot(n8, "W8 count (500)", display=display.data_window)
plot(n9, "W9 count (250)", display=display.data_window)
plot(n10, "W10 count (150)", display=display.data_window)
plot(n11, "W11 count (50)", display=display.data_window)

// ============================================================================
// === ALERTS -- per-window (1:1 with plots), plus ANY alertcondition + any-call()
// ============================================================================
alertcondition(fire_W1, "W1 NAG cluster", "W1: Nagasaki / all-time-high volume cluster on {{ticker}}")
alertcondition(fire_W2, "W2 4000 cluster", "W2: 4000-bar high and above cluster on {{ticker}}")
alertcondition(fire_W3, "W3 3000 cluster", "W3: 3000-bar high and above cluster on {{ticker}}")
alertcondition(fire_W4, "W4 2500 cluster", "W4: 2500-bar high and above cluster on {{ticker}}")
alertcondition(fire_W5, "W5 2000 cluster", "W5: 2000-bar high and above cluster on {{ticker}}")
alertcondition(fire_W6, "W6 1500 cluster", "W6: 1500-bar high and above cluster on {{ticker}}")
alertcondition(fire_W7, "W7 1000 cluster", "W7: 1000-bar high and above cluster on {{ticker}}")
alertcondition(fire_W8, "W8 500 cluster", "W8: 500-bar high and above cluster on {{ticker}}")
alertcondition(fire_W9, "W9 250 cluster", "W9: 250-bar high and above cluster on {{ticker}}")
alertcondition(fire_W10, "W10 150 cluster", "W10: 150-bar high and above cluster on {{ticker}}")
alertcondition(fire_W11, "W11 50 cluster", "W11: 50-bar high and above (any HV tier) cluster on {{ticker}}")

bool any_fire = fire_W1 or fire_W2 or fire_W3 or fire_W4 or fire_W5 or fire_W6 or fire_W7 or fire_W8 or fire_W9 or fire_W10 or fire_W11
alertcondition(any_fire, "ANY HV rolling cluster", "ANY HV rolling-window cluster fired on {{ticker}}")

// any-call alert(): set ONE TradingView alert to "Any alert() function call"
// and it catches every window. Payload names which windows fired this bar.
if any_fire and conf
    string m = ""
    m := fire_W1 ? m + "NAG " : m
    m := fire_W2 ? m + "4000 " : m
    m := fire_W3 ? m + "3000 " : m
    m := fire_W4 ? m + "2500 " : m
    m := fire_W5 ? m + "2000 " : m
    m := fire_W6 ? m + "1500 " : m
    m := fire_W7 ? m + "1000 " : m
    m := fire_W8 ? m + "500 " : m
    m := fire_W9 ? m + "250 " : m
    m := fire_W10 ? m + "150 " : m
    m := fire_W11 ? m + "50 " : m
    alert("HV_ROLL|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|FIRED:" + m, alert.freq_once_per_bar_close)

// ============================================================================
// === EXPORTS (for combination / fire-matrix consumers)
// ============================================================================
// Individual tiers (bool): is50Bar, is150Bar, is250Bar, is500Bar, is1000Bar, is1500Bar, is2000Bar, is2500Bar, is3000Bar, is4000Bar,
//                          isHEV (== isNagasaki)   (calc/export only)
// Window fires (bool):     fire_W1 .. fire_W11
// Window counts (float):   n1 .. n11
// Aggregate:               activeWindows = how many windows fired this bar (0..11)
int activeWindows = (fire_W1?1:0)+(fire_W2?1:0)+(fire_W3?1:0)+(fire_W4?1:0)+(fire_W5?1:0)+(fire_W6?1:0)+(fire_W7?1:0)+(fire_W8?1:0)+(fire_W9?1:0)+(fire_W10?1:0)+(fire_W11?1:0)
plot(activeWindows, "activeWindows (0..11)", color=color.white, display=display.data_window)
