//@version=5
// ═════════ ALERT GRAMMAR v3 UPGRADE — First Bar Fable v2 NTS (L-49 wave, 2026-07-15) ═════════
// Alert-layer ONLY: plot-key-first grammar, measured Displacement (D=, one decimal),
// VRANK (ATH/YH/QH/MH/WH calendar record-high) + NTH ordinals, CO same-bar co-fires.
// Every alert keeps its EXACT checkbox/first-bar guard (biconditional law preserved);
// no plot, checkbox, or engine logic touched. Base: first-bar-fable/versions/FIRST_BAR_FABLE_v2_NTS.pine @ 6aa1791
// (sha256 11de65276dc1eb91fa497f1be5b7bc33356f236c37255d8b1a872cb5c22ec9ce).
// Version control: first-bar-fable/CHANGELOG.md · github.com/nishpa800/indicators
// ═══════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════
// FIRST BAR FABLE v1 — in homage of Fable
// ──────────────────────────────────────────────────────────────────────────────
// Composite detection study. Every engine below is a VERBATIM port from its
// canonical suite source (no re-derivation):
//   • RVOL 0.56 engine (SAAB/Kratos/1X/GS/MOAB, Pre-Mythos curve) — B2B PUP v5.4
//     Engine E L266-289 (identical curve in SQUARIFY v3 L497-517)
//   • WTC / Hiroshima (RVOL Reg@Time)                — B2B PUP v5.4 L290-294
//   • Displacement 9 (disp_rng > disp_std*9.0)       — SQUARIFY v3 L2237-2238
//     (bear side = natural mirror; SQUARIFY defines bull only)
//   • PBJ engine (zoo/supertrend latch)              — 1st PUP FAUNA L556-720
//   • PUP / PPD pocket pivot                         — 1st PUP FAUNA L491-503
//     (== B2B PUP v5.4 Engine A L74-80, same math/defaults)
//   • Whale (pivot + HV milestone + PUP + PBJ)       — 1st PUP FAUNA L519-552, L722-726
//   • FAUNA (fauna variant, for Typhoon)             — 1st PUP FAUNA L340-388
//   • GZ1 / HV FVG engine (for Musashi)              — 1st PUP FAUNA L200-268
//   • Yin Yang swing engine (for Typhoon)            — 1st PUP FAUNA L415-443
//   • TYPHOON / MUSASHI / alignment layer            — 1st PUP FAUNA L751-798, L836-863
//   • B2B SAAB / B2B KRATOS (S5 composites)          — B2B PUP v5.4 L970-984
//   • u5 FAUNA (TNT variant, for DYNAMITE)           — TNT OD v3 L755-782
//   • DYNAMITE (dedicated 100-bar σ engine)          — TNT OD v3 L960-975
//   • TNT OD core (VOB/ANISH/FLUX/zones/charge/cont) — TNT OD v3 L377-696 (tod_ prefix)
//   • IGNITE (TNT+CONT / NPM+CONT)                   — TNT OD v3 L1201-1205
//   • B2B NAPALM Engine G                            — B2B PUP v5.4 L334-690 (tnt_ prefix)
//   • Hybrid Momentum LONG 1-5                       — Heavy Weapons Singles v2 L83-351
//   • Nagasaki (all-time-high volume)                — SQUARIFY v3 L525-532
// Visual-only members (line/label/box) stripped from ported zone types; all
// booleans and state mutation order preserved exactly.
//
// FIRST BAR MASTER (default ON): every detection requires its REFERENCE bar
// (the bar the shape anchors to, honoring plot offset) to be the first bar of
// the session (ta.change(time("D")) != 0 — fauna/squarify anchor). Two-bar B2B
// patterns pass when the pair TOUCHES the first bar (B2B PUP g01 semantics).
// Unchecked = detections fire on any bar.
// Each S<N> checkbox gates BOTH the plot AND the alert for that detection.
//
// INTERPRETATIONS (flagged for review):
//   • S9/S10 "one of the first two bars must be displacement 9" = Disp9 on
//     bar[0] or bar[1] (the two bars of the B2B pattern).
//   • S15 "on the first bar" is baked into the signal itself (first-bar
//     required even when the master toggle is OFF), like fauna's Typhoon.
//   • "long (1-5)" = Hybrid Momentum LONG 1-5 tiers (Heavy Weapons Singles v2).
// ──────────────────────────────────────────────────────────────────────────────
// v2 ADDITIONS: S18 B2B PUP+Disp9, S19 B2B PPD+Disp9, S20/S21 B2B FC Cluster
//   (Ultra v57; ALWAYS fires on any bar — OVERRIDES the First Bar Master),
//   S22/S23 D9 Bull/Bear Study (HW v3), S24/S25 Unified Combo+Disp9 (HVD), and
//   the HVD PBJ PPD groups: Pipeline D CO co-occurrence, Back-to-Back HV+D,
//   HV+D Momentum co-occ (bull+bear). HVD Group 1 CO's USE gate is rebuilt from
//   this study's ROLLING signals (source used fixed-window OD/Alpha-Strike).
// ──────────────────────────────────────────────────────────────────────────────
// DISPLACEMENT MAP (every displacement engine is adjustable; each drives ONLY):
//   • "Displacement 9" (σ=9, len=100) → S1, S2, S9, S10, S15, S18, S19,
//       S22/S23 (D9 studies), S24/S25 (Unified Combo's Disp9 requirement).
//   • "Displacement — HV+D" (σ=5, len=100) → ALL HVD PBJ PPD plots
//       (CO, B2B HV+D, HV+D Momentum). Also feeds hvd_fire.
//   • "DYNAMITE" (σ=5, len=100 hardcoded) → S11/S12 only.
//   • "TNT OD Engine (Ignite)" (σ=5) → S13/S14 only.
//   • "TNT Engine (B2B Napalm)" (σ=5) → S16/S17 only.
//   FC cluster (S20/S21) has no σ-displacement engine.
// ══════════════════════════════════════════════════════════════════════════════
indicator("First Bar Fable v2 NTS", shorttitle="1st BAR FABLE v2 NTS", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=2500)

import TradingView/ta/7 as tv_ta

// ══════════════════════════════════════════════════════════════════════════════
// MASTER
// ══════════════════════════════════════════════════════════════════════════════
grpM = "★ MASTER ★"
firstBarOnly = input.bool(true, "★ FIRST BAR MASTER ★", group=grpM, tooltip="ON (default): every detection only fires when its reference bar is the FIRST BAR of the session (day change). Two-bar B2B patterns pass when the pair touches the first bar. OFF: detections fire on any bar.")
en_aggAlerts = input.bool(true, "Aggregate Alerts", group=grpM, tooltip="ON: one combined alert per direction per bar. OFF: individual alert per detection. Checked detection boxes below gate both plots AND alerts.")

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL TOGGLES — checkbox = plot + alert
// ══════════════════════════════════════════════════════════════════════════════
grpSIG = "★ SIGNAL TOGGLES ★"
en_S1  = input.bool(true, "S1: Bull RVOL 1X/GS + Disp9 + PBJ",   group=grpSIG, tooltip="Bullish RVOL 1X OR Grand Slam, + Displacement 9, + PBJ Bull. Offset 0.")
en_S2  = input.bool(true, "S2: Bear RVOL 1X/MOAB + Disp9 + PBJ", group=grpSIG, tooltip="Bearish RVOL 1X OR MOAB, + Displacement 9, + PBJ Bear. Offset 0.")
en_S3  = input.bool(true, "S3: Typhoon Bull",                    group=grpSIG, tooltip="1st PUP FAUNA parity: swing low + first bar + FAUNA + (PUP or Whale+PBJ) on the pivot bar. Offset -Right Bars.")
en_S4  = input.bool(true, "S4: Typhoon Bear",                    group=grpSIG, tooltip="1st PUP FAUNA parity: swing high + first bar + FAUNA + (PPD or Whale+PBJ) on the pivot bar. Offset -Right Bars.")
en_S5  = input.bool(true, "S5: Musashi Bull",                    group=grpSIG, tooltip="1st PUP FAUNA parity: (GZI or HV FVG) + aligned PUP + Whale + PBJ. Offset -moff.")
en_S6  = input.bool(true, "S6: Musashi Bear",                    group=grpSIG, tooltip="1st PUP FAUNA parity: (GZI or HV FVG) + aligned PPD + Whale + PBJ. Offset -moff.")
en_S7  = input.bool(true, "S7: Whale+PUP Bull",                  group=grpSIG, tooltip="1st PUP FAUNA parity: whale pivot + HV milestone + PUP + PBJ. Offset 0.")
en_S8  = input.bool(true, "S8: Whale+PPD Bear",                  group=grpSIG, tooltip="1st PUP FAUNA parity: whale pivot + HV milestone + PPD + PBJ. Offset 0.")
en_S9  = input.bool(true, "S9: B2B KRATOS + Disp9",              group=grpSIG, tooltip="B2B PUP v5.4 S5 bear parity (B2B PPD + Kratos-family RVOL on both bars) + Displacement 9 on one of the two pattern bars. Offset 0.")
en_S10 = input.bool(true, "S10: B2B SAAB + Disp9",               group=grpSIG, tooltip="B2B PUP v5.4 S5 bull parity (B2B PUP + SAAB-family RVOL on both bars) + Displacement 9 on one of the two pattern bars. Offset 0.")
en_S11 = input.bool(true, "S11: Dynamite Bull",                  group=grpSIG, tooltip="TNT OD v3 parity: B2B displacement bar[1]+bar[2] same bull color + FAUNA both + bar[0] bullish FVG. Offset -1.")
en_S12 = input.bool(true, "S12: Dynamite Bear",                  group=grpSIG, tooltip="TNT OD v3 parity: bearish mirror of S11. Offset -1.")
en_S13 = input.bool(true, "S13: Ignite Bull",                    group=grpSIG, tooltip="TNT OD v3 parity: (TNT + CONT, offset 0) OR (NPM + CONT, offset -1) same visual bar.")
en_S14 = input.bool(true, "S14: Ignite Bear",                    group=grpSIG, tooltip="TNT OD v3 parity: bearish mirror of S13.")
en_S15 = input.bool(true, "S15: Nagasaki 1stBar+",               group=grpSIG, tooltip="Nagasaki (all-time-high volume) + any of LONG 1-5 / PBJ Bull / Disp9 / Bullish RVOL 1X / Grand Slam — all on the FIRST BAR (first-bar requirement is baked in). Offset 0.")
en_S16 = input.bool(true, "S16: B2B Napalm Bull",                group=grpSIG, tooltip="B2B PUP v5.4 parity: (Napalm or Charge) on bar[0] AND bar[1]. Offset 0.")
en_S17 = input.bool(true, "S17: B2B Napalm Bear",                group=grpSIG, tooltip="B2B PUP v5.4 parity: bearish mirror of S16. Offset 0.")

// ══════════════════════════════════════════════════════════════════════════════
// SHARED GLOBALS + SESSION BOUNDARY
// ══════════════════════════════════════════════════════════════════════════════
conf = barstate.isconfirmed
// tfSec guard (suite tick doctrine): timeframe.in_seconds() is na/0 on tick charts →
// threshold ladders silently die without a fallback. Fallback 10s per SQUARIFY tick_friendly.
// Time charts: tfSec = raw value, zero parity change.
// NON-TICK-FRIENDLY TWIN (L-49 TWIN MANDATE, 2026-07-14): raw tfSec, no tick guard.
// THEOREM T-NTS: on time intervals the removed guard was inert => identical equations
// to the tick-friendly build. DO NOT LOAD ON A TICK CHART (thresholds die on na tfSec).
int tfSec = timeframe.in_seconds(timeframe.period)

// Session boundary (1st PUP FAUNA / SQUARIFY anchor)
bool is_new_day = ta.change(time("D")) != 0
bool is_new_sess = is_new_day

// Gap qualifier for alert strings (SQUARIFY v3 pattern)
float _gapSize = math.abs(open - close[1])
float _barRange = high - low
string _FIRST = not is_new_sess ? "NOT !!!" : (_gapSize <= _barRange ? "FIRST !!!" : "FIRST XXX")

f_add(string base, string part) => base == "" ? part : base + " + " + part

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: RVOL 0.56 (Pre-Mythos) — B2B PUP v5.4 Engine E parity
// SAAB / KRATOS / RVOL 1X / GRAND SLAM / MOAB threshold on NORMALIZED PRICE SPIKE
// ══════════════════════════════════════════════════════════════════════════════
grpRV = "── RVOL ──"
int rv_avgLen = input.int(30, "RVOL Avg Length", group=grpRV)
int rv_smaLen = input.int(20, "RVOL SMA Length", group=grpRV)
float rv_spike = math.abs(close - open)
float rv_avgSpike = ta.sma(rv_spike, rv_avgLen)[1]
float rv_normPrice = rv_spike / nz(rv_avgSpike, 1.0)
float rv_avgVol = ta.sma(volume, rv_avgLen)[1]
float rv_normVol = volume / nz(rv_avgVol, 1.0)
float rv_diff = rv_normPrice - rv_normVol
float rv_posDiff = rv_diff > 0 ? rv_diff : na
float rv_smaDiff = ta.sma(rv_posDiff, rv_smaLen)
bool rv_baseBull = (close > open) and (rv_posDiff > rv_smaDiff) and conf
bool rv_baseBear = (close < open) and (rv_posDiff > rv_smaDiff) and conf
// Pre-Mythos thresholds (B2B PUP v5.4 / SQUARIFY v3 shared curve)
f_th_1x(int _s) => _s <= 10 ? 38.0 : _s <= 15 ? 33.0 : _s <= 30 ? 28.0 : _s <= 45 ? 23.0 : _s <= 60 ? 20.0 : _s <= 120 ? 18.0 : _s <= 300 ? 13.0 : _s <= 360 ? 13.0 : _s <= 540 ? 11.0 : _s <= 600 ? 10.0 : _s <= 660 ? 9.0 : _s <= 900 ? 7.5 : _s <= 1560 ? 6.5 : _s <= 2340 ? 6.0 : _s <= 3600 ? 4.5 : _s <= 9000 ? 4.0 : _s <= 11700 ? 3.5 : _s < 259200 ? 1.8 : 1.0
f_th_gs(int _s) => _s < 60 ? f_th_1x(_s) * 3.0 : _s <= 300 ? 35.0 : _s <= 600 ? 25.0 : _s <= 1500 ? 20.0 : _s <= 3000 ? 20.0 : _s <= 7260 ? 10.0 : _s <= 11700 ? 8.0 : _s <= 86400 ? 7.5 : _s <= 259200 ? 3.5 : 3.0
f_th_saab(int _s) => f_th_1x(_s) * 0.56
f_th_wtc(int _s) => f_th_1x(_s) * 2.0
f_th_hiro(int _s) => _s < 60 ? f_th_1x(_s) * 3.0 : _s <= 300 ? 35.0 : _s <= 600 ? 25.0 : _s <= 1500 ? 25.0 : _s <= 3060 ? 20.0 : _s <= 7260 ? 10.0 : _s <= 11700 ? 8.0 : _s <= 86400 ? 7.5 : _s <= 259200 ? 5 : 3.5
float th_saab = f_th_saab(tfSec)
float th_1x = f_th_1x(tfSec)
float th_gs = f_th_gs(tfSec)
float th_wtc = f_th_wtc(tfSec)
float th_hiro = f_th_hiro(tfSec)
bool det_SAAB = rv_baseBull and rv_normPrice >= th_saab and rv_normPrice < th_1x
bool det_Kratos = rv_baseBear and rv_normPrice >= th_saab and rv_normPrice < th_1x
bool det_RVOL1xB = rv_baseBull and rv_normPrice >= th_1x and rv_normPrice < th_gs
bool det_RVOL1xR = rv_baseBear and rv_normPrice >= th_1x and rv_normPrice < th_gs
bool det_GrandSlam = rv_baseBull and rv_normPrice >= th_gs
bool det_MOAB = rv_baseBear and rv_normPrice >= th_gs

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: RVOL REG @ TIME — WTC / Hiroshima (B2B PUP v5.4 parity) + tick-safe anchor
// ══════════════════════════════════════════════════════════════════════════════
groupReg = "RVOL - Reg @ Time"
reg_anchorTimeframe = input.timeframe("", "Anchor Timeframe (blank = chart)", group=groupReg)
reg_length = input.int(30, "Length", minval=1, group=groupReg)
reg_adjustRealtime = input.bool(true, "Adjust Unconfirmed", group=groupReg)
// TICK-FRIENDLY FIX (RE10023): force "D" anchor only on tick charts; time charts keep "" (no parity change off tick).
string reg_anchorSafe = reg_anchorTimeframe   // NTS twin: raw anchor, no RE10023 forcing
[rv_curVol_reg, rv_pastVol_reg, _rv_u] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, true, reg_adjustRealtime)
float rv_relVolRatio = rv_curVol_reg / rv_pastVol_reg
bool det_WTC = conf and (rv_relVolRatio > th_wtc) and (rv_relVolRatio <= th_hiro)
bool det_Hiroshima = conf and (rv_relVolRatio > th_hiro)

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: HYBRID MOMENTUM LONG 1-5 — Heavy Weapons Singles v2 parity
// ══════════════════════════════════════════════════════════════════════════════
groupHybrid = "Hybrid LONG 1-5"
hyb_autoDerive = input.bool(true, "★ Auto-derive ALL Long thresholds (RVOL 1x → 2x ladder)", group=groupHybrid, tooltip="When ON, the 15 Reg/Cum/Body inputs below are IGNORED and the Reg floors are auto-computed as a linear ladder from RVOL 1x (Long 5) up to 2× RVOL 1x (Long 1). When OFF, the manual values below are used.")
hyb_addReg1 = input.float(5.0, "Long 1 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd1")
hyb_addCum1 = input.float(3.0, "Long 1 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd1")
hyb_bodyRat1 = input.float(0.74, "Long 1 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
hyb_addReg2 = input.float(5.0, "Long 2 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd2")
hyb_addCum2 = input.float(3.0, "Long 2 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd2")
hyb_bodyRat2 = input.float(0.74, "Long 2 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
hyb_addReg3 = input.float(5.0, "Long 3 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd3")
hyb_addCum3 = input.float(3.0, "Long 3 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd3")
hyb_bodyRat3 = input.float(0.74, "Long 3 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
hyb_addReg4 = input.float(5.0, "Long 4 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd4")
hyb_addCum4 = input.float(3.0, "Long 4 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd4")
hyb_bodyRat4 = input.float(0.74, "Long 4 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)
hyb_addReg5 = input.float(5.0, "Long 5 Reg Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd5")
hyb_addCum5 = input.float(3.0, "Long 5 Cum Floor", minval=0.5, step=0.1, group=groupHybrid, inline="hadd5")
hyb_bodyRat5 = input.float(0.74, "Long 5 Min Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=groupHybrid)

// Auto-derive ladder: Reg floors ramp from RVOL 1x (Long 5) up to 2× RVOL 1x (Long 1).
// th_1x = the Pre-Mythos RVOL 1x threshold for this TF (defined in the RVOL engine above).
hybAutoReg5 = th_1x            // Long 5 = RVOL 1x
hybAutoReg1 = th_1x * 2.0      // Long 1 = 2× RVOL 1x (RVOL 2x), and fires above
hybAutoStep = (hybAutoReg1 - hybAutoReg5) / 4.0
hybAutoReg2 = hybAutoReg1 - 1.0 * hybAutoStep   // 1.75× RVOL 1x
hybAutoReg3 = hybAutoReg1 - 2.0 * hybAutoStep   // 1.50× RVOL 1x
hybAutoReg4 = hybAutoReg1 - 3.0 * hybAutoStep   // 1.25× RVOL 1x
float hybCumPhi = 1.398 * 1.33
hybAutoCum1 = hybCumPhi * math.sqrt(math.log(hybAutoReg1))
hybAutoCum2 = hybCumPhi * math.sqrt(math.log(hybAutoReg2))
hybAutoCum3 = hybCumPhi * math.sqrt(math.log(hybAutoReg3))
hybAutoCum4 = hybCumPhi * math.sqrt(math.log(hybAutoReg4))
hybAutoCum5 = hybCumPhi * math.sqrt(math.log(hybAutoReg5))
// Body ratio: 0.74 across the board (all five Long tiers)
float hybAutoBody1 = 0.74
float hybAutoBody2 = 0.74
float hybAutoBody3 = 0.74
float hybAutoBody4 = 0.74
float hybAutoBody5 = 0.74
hybReg1Eff = hyb_autoDerive ? hybAutoReg1 : hyb_addReg1
hybReg2Eff = hyb_autoDerive ? hybAutoReg2 : hyb_addReg2
hybReg3Eff = hyb_autoDerive ? hybAutoReg3 : hyb_addReg3
hybReg4Eff = hyb_autoDerive ? hybAutoReg4 : hyb_addReg4
hybReg5Eff = hyb_autoDerive ? hybAutoReg5 : hyb_addReg5
hybCum1Eff = hyb_autoDerive ? hybAutoCum1 : hyb_addCum1
hybCum2Eff = hyb_autoDerive ? hybAutoCum2 : hyb_addCum2
hybCum3Eff = hyb_autoDerive ? hybAutoCum3 : hyb_addCum3
hybCum4Eff = hyb_autoDerive ? hybAutoCum4 : hyb_addCum4
hybCum5Eff = hyb_autoDerive ? hybAutoCum5 : hyb_addCum5
hybBody1Eff = hyb_autoDerive ? hybAutoBody1 : hyb_bodyRat1
hybBody2Eff = hyb_autoDerive ? hybAutoBody2 : hyb_bodyRat2
hybBody3Eff = hyb_autoDerive ? hybAutoBody3 : hyb_bodyRat3
hybBody4Eff = hyb_autoDerive ? hybAutoBody4 : hyb_bodyRat4
hybBody5Eff = hyb_autoDerive ? hybAutoBody5 : hyb_bodyRat5

[hybRegCur, hybRegPast, _hr] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, false, reg_adjustRealtime)
[hybCumCur, hybCumPast, _hc] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, true, reg_adjustRealtime)
hybRegRatio = hybRegCur / hybRegPast
hybCumRatio = hybCumCur / hybCumPast
hybBodySz = math.abs(close - open)
hybRange = high - low
hybBodyRat = hybRange == 0 ? 0.0 : hybBodySz / hybRange
hybConvict1 = hybBodyRat >= hybBody1Eff
hybBull1 = (close > open) and hybConvict1
hybMom1 = conf and (hybRegRatio > hybReg1Eff) and (hybCumRatio > hybCum1Eff)
sigAddLong1 = hybMom1 and hybBull1
hybConvict2 = hybBodyRat >= hybBody2Eff
hybBull2 = (close > open) and hybConvict2
hybMom2 = conf and (hybRegRatio > hybReg2Eff) and (hybCumRatio > hybCum2Eff)
sigAddLong2 = hybMom2 and hybBull2
hybConvict3 = hybBodyRat >= hybBody3Eff
hybBull3 = (close > open) and hybConvict3
hybMom3 = conf and (hybRegRatio > hybReg3Eff) and (hybCumRatio > hybCum3Eff)
sigAddLong3 = hybMom3 and hybBull3
hybConvict4 = hybBodyRat >= hybBody4Eff
hybBull4 = (close > open) and hybConvict4
hybMom4 = conf and (hybRegRatio > hybReg4Eff) and (hybCumRatio > hybCum4Eff)
sigAddLong4 = hybMom4 and hybBull4
hybConvict5 = hybBodyRat >= hybBody5Eff
hybBull5 = (close > open) and hybConvict5
hybMom5 = conf and (hybRegRatio > hybReg5Eff) and (hybCumRatio > hybCum5Eff)
sigAddLong5 = hybMom5 and hybBull5
anyLong = sigAddLong1 or sigAddLong2 or sigAddLong3 or sigAddLong4 or sigAddLong5

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: DISPLACEMENT 9 — SQUARIFY v3 d9 parity (multiplier exposed, default 9.0)
// ══════════════════════════════════════════════════════════════════════════════
grp_d9 = "Displacement 9"
i_d9_type = input.string("Open to Close", "Range Type", options=["Open to Close", "High to Low"], group=grp_d9)
i_d9_len = input.int(100, "Std Dev Length", minval=1, group=grp_d9)
i_d9_mult = input.float(9.0, "Std Dev Multiplier (9 strength)", minval=0.1, step=0.5, group=grp_d9)
float d9_rng = i_d9_type == "Open to Close" ? math.abs(open - close) : high - low
float d9_std = ta.stdev(d9_rng, i_d9_len)
float d9_thresh = d9_std * i_d9_mult
bool d9_bull = conf and d9_rng > d9_thresh and close > open
bool d9_bear = conf and d9_rng > d9_thresh and close < open

// ══════════════ ALERT GRAMMAR v3 HELPERS (L-49 wave, 2026-07-15) ══════════════
// Measured Displacement (D=, one decimal), VRANK calendar record-highs, NTH ordinals,
// CO same-bar co-fires. TICK-SAFE: calendar trackers key off bar time only — no anchored
// windows, no bar_index anchors. Alert-layer helpers only; no engine/plot touched.
f1(float x) => str.tostring(x, "#.#")
f_cat(string base, string part) => base == "" ? part : base + "," + part
f_coTail(string all, string me) =>
    string acc = ""
    if all != ""
        array<string> parts = str.split(all, ",")
        for k in parts
            if k != me and k != ""
                acc := acc == "" ? k : acc + "," + k
    acc == "" ? "" : " CO=" + acc
float d9_sigma  = nz(d9_std) == 0 ? 0.0 : d9_rng / d9_std
float d9_sigma1 = nz(d9_std[1]) == 0 ? 0.0 : nz(d9_rng[1]) / d9_std[1]
string fbYN = is_new_sess ? "Y" : "N"
var float vmax_all = na
var float vmax_y = na
var float vmax_q = na
var float vmax_m = na
var float vmax_w = na
var int nth_y = 0
var int nth_q = 0
var int nth_m = 0
var int _v_py = na
var int _v_pq = na
var int _v_pm = na
var int _v_pw = na
string vrank = ""
string nthTxt = ""
if conf
    int _cy = year(time)
    int _cq = int(math.ceil(month(time) / 3.0))
    int _cm = month(time)
    int _cw = weekofyear(time)
    if not na(_v_py) and _cy != _v_py
        vmax_y := na
        nth_y := 0
    if not na(_v_pq) and _cq != _v_pq
        vmax_q := na
        nth_q := 0
    if not na(_v_pm) and _cm != _v_pm
        vmax_m := na
        nth_m := 0
    if not na(_v_pw) and _cw != _v_pw
        vmax_w := na
    _v_py := _cy
    _v_pq := _cq
    _v_pm := _cm
    _v_pw := _cw
    vrank := (na(vmax_all) or volume >= vmax_all) ? "ATH" : (not na(vmax_y) and volume >= vmax_y) ? "YH" : (not na(vmax_q) and volume >= vmax_q) ? "QH" : (not na(vmax_m) and volume >= vmax_m) ? "MH" : (not na(vmax_w) and volume >= vmax_w) ? "WH" : ""
    bool _newATH = na(vmax_all) or volume > vmax_all
    if _newATH
        nth_y := nth_y + 1
        nth_q := nth_q + 1
        nth_m := nth_m + 1
    vmax_all := na(vmax_all) ? volume : math.max(vmax_all, volume)
    vmax_y := na(vmax_y) ? volume : math.max(vmax_y, volume)
    vmax_q := na(vmax_q) ? volume : math.max(vmax_q, volume)
    vmax_m := na(vmax_m) ? volume : math.max(vmax_m, volume)
    vmax_w := na(vmax_w) ? volume : math.max(vmax_w, volume)
    nthTxt := "Y" + str.tostring(nth_y) + ",Q" + str.tostring(nth_q) + ",M" + str.tostring(nth_m)


// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: PBJ (zoo / supertrend latch) — 1st PUP FAUNA parity
// (PB level-approach path omitted: independent state, no PBJ output impact)
// ══════════════════════════════════════════════════════════════════════════════
grp_zoo = "PBJ Engine"
zoo_ma_type = input.string("VWMA", "Signal MA Type", options=["EMA", "SMA", "WMA", "HMA", "VWMA"], group=grp_zoo)
zoo_ma_len = input.int(5, "Signal MA Length", minval=1, group=grp_zoo)
zoo_price_src = input.source(close, "Price Source", group=grp_zoo)
zoo_use_st = input.bool(true, "Use Supertrend Line", group=grp_zoo)
zoo_st_period = input.int(10, "Supertrend ATR Period", minval=1, group=grp_zoo)
zoo_st_mult = input.float(2.0, "Supertrend ATR Mult", minval=0.1, step=0.1, group=grp_zoo)
zoo_pbj_ma_period = input.int(20, "PBJ EMA Period", minval=1, group=grp_zoo)
zoo_pbj_atr_period = input.int(14, "PBJ ATR Period", minval=1, group=grp_zoo)
zoo_pbj_hh_ll = input.int(25, "PBJ HH/LL Lookback", minval=1, group=grp_zoo)
zoo_pbj_atr_mult = input.float(3.0, "PBJ ATR Mult", minval=0.1, step=0.1, group=grp_zoo)
zoo_pbj_vol_period = input.int(20, "PBJ Vol SMA Period", minval=1, group=grp_zoo)
zoo_pbj_vol_mult = input.float(0.1, "PBJ Vol Mult", minval=0.0, step=0.05, group=grp_zoo)

type pbjLvl
    float upper
    float lower
    float vol
    bool approached

f_ma(src, len, t) =>
    switch t
        "EMA" => ta.ema(src, len)
        "SMA" => ta.sma(src, len)
        "WMA" => ta.wma(src, len)
        "HMA" => ta.hma(src, len)
        "VWMA" => ta.vwma(src, len)
        => ta.sma(src, len)

f_add_lvl(arr, up, lo, v) =>
    if math.abs(up - lo) >= syminfo.mintick
        array.push(arr, pbjLvl.new(up, lo, v, false))
f_add_lander(is_bull, cross_sig, arr, atr_pb) =>
    if cross_sig
        float up = 0.0, float lo = 0.0
        if is_bull
            up := math.max(open[1], close[1]), lo := low[1]
            if up - lo < atr_pb * 0.5
                up := lo + atr_pb * 0.5
        else
            up := high[1], lo := math.min(open[1], close[1])
            if up - lo < atr_pb * 0.5
                lo := up - atr_pb * 0.5
        f_add_lvl(arr, up, lo, volume[1])
f_add_reaccel(is_bull, sig, arr, sig_line) =>
    if sig and not na(sig_line)
        float p1 = sig_line, float p2 = is_bull ? math.min(open, close) : math.max(open, close)
        f_add_lvl(arr, math.max(p1, p2), math.min(p1, p2), volume)
f_check_approach(arr, is_bull) =>
    bool approached = false
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            if i >= array.size(arr)
                continue
            l = array.get(arr, i)
            if is_bull and close < l.lower
                array.remove(arr, i)
                continue
            if not is_bull and close > l.upper
                array.remove(arr, i)
                continue
            float ap = is_bull ? l.upper * 1.005 : l.lower * 0.995
            if is_bull
                if not l.approached and low <= ap
                    approached := true
                    l.approached := true
                else if l.approached and low > l.upper
                    l.approached := false
            else
                if not l.approached and high >= ap
                    approached := true
                    l.approached := true
                else if l.approached and high < l.lower
                    l.approached := false
    approached
f_pbjEngine() =>
    float base_ma = f_ma(zoo_price_src, zoo_ma_len, zoo_ma_type)
    float st_atr = zoo_st_mult * ta.atr(zoo_st_period)
    float dyn_long = base_ma - st_atr
    float dyn_short = base_ma + st_atr

    var int st_dir = 1
    float sig_line = 0.0
    float curr_long = 0.0
    curr_long := base_ma > nz(curr_long[1], dyn_long) ? math.max(dyn_long, nz(curr_long[1])) : dyn_long
    float curr_short = 0.0
    curr_short := base_ma < nz(curr_short[1], dyn_short) ? math.min(dyn_short, nz(curr_short[1])) : dyn_short

    if zoo_use_st
        if nz(st_dir[1]) == -1 and zoo_price_src > nz(curr_short[1])
            st_dir := 1
        else if nz(st_dir[1]) == 1 and zoo_price_src < nz(curr_long[1])
            st_dir := -1
        sig_line := st_dir == 1 ? curr_long : curr_short
    else
        sig_line := base_ma

    bool buy_cross = ta.crossover(zoo_price_src, sig_line)
    bool sell_cross = ta.crossunder(zoo_price_src, sig_line)
    bool bull_reaccel = st_dir == 1 and sig_line > nz(sig_line[1]) and nz(sig_line[1]) == nz(sig_line[2])
    bool bear_reaccel = st_dir == -1 and sig_line < nz(sig_line[1]) and nz(sig_line[1]) == nz(sig_line[2])

    float pbj_ma = ta.ema(close, zoo_pbj_ma_period)
    float pbj_atr = ta.atr(zoo_pbj_atr_period)
    float avg_vol = ta.sma(volume, zoo_pbj_vol_period)
    float thresh = close == 0 ? 0 : (pbj_atr / close * zoo_pbj_atr_mult)
    float _pbjLowest = ta.lowest(low, zoo_pbj_hh_ll)
    float _pbjHighest = ta.highest(high, zoo_pbj_hh_ll)
    bool pbj_buy = low < pbj_ma * (1 - thresh) and low == _pbjLowest and volume > avg_vol * zoo_pbj_vol_mult
    bool pbj_sell = high > pbj_ma * (1 + thresh) and high == _pbjHighest and volume > avg_vol * zoo_pbj_vol_mult

    // PB level-approach path (1st PUP FAUNA / HVD parity — required for the HVD "+PB" plots)
    bool enable_PB = true
    float atr_pb = ta.atr(14) * 2.0
    var bull_lvls = array.new<pbjLvl>()
    var bear_lvls = array.new<pbjLvl>()

    f_add_lander(true, buy_cross, bull_lvls, atr_pb)
    f_add_lander(false, sell_cross, bear_lvls, atr_pb)
    f_add_reaccel(true, bull_reaccel, bull_lvls, sig_line)
    f_add_reaccel(false, bear_reaccel, bear_lvls, sig_line)

    var bool wait_buy = false
    var bool wait_sell = false
    var bool wait_pbj_buy = false
    var bool wait_pbj_sell = false
    if conf
        if f_check_approach(bull_lvls, true)
            wait_buy := true
        if f_check_approach(bear_lvls, false)
            wait_sell := true
    if pbj_buy
        wait_pbj_buy := true
    if pbj_sell
        wait_pbj_sell := true
    while array.size(bull_lvls) > 30
        array.shift(bull_lvls)
    while array.size(bear_lvls) > 30
        array.shift(bear_lvls)

    bool sig_pbj_buy = buy_cross and wait_pbj_buy
    bool sig_pb_buy = buy_cross and wait_buy
    bool sig_pbj_sell = sell_cross and wait_pbj_sell
    bool sig_pb_sell = sell_cross and wait_sell
    if sig_pb_buy
        wait_buy := false
    if sig_pbj_buy
        wait_pbj_buy := false
    if sig_pb_sell
        wait_sell := false
    if sig_pbj_sell
        wait_pbj_sell := false

    bool sigBullPBJ = barstate.isconfirmed and sig_pbj_buy
    bool sigBearPBJ = barstate.isconfirmed and sig_pbj_sell
    bool sigBullPB = barstate.isconfirmed and enable_PB and sig_pb_buy and not sig_pbj_buy
    bool sigBearPB = barstate.isconfirmed and enable_PB and sig_pb_sell and not sig_pbj_sell
    [sigBullPBJ, sigBearPBJ, sigBullPB, sigBearPB]

[sigBullPBJ, sigBearPBJ, sigBullPB, sigBearPB] = f_pbjEngine()
// FUTURE-PROOF PBJ WRAPPERS (fauna parity)
bool anyBullPBJ = sigBullPBJ
bool anyBearPBJ = sigBearPBJ

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: POCKET PIVOT (PUP / PPD) — 1st PUP FAUNA / B2B PUP shared math
// ══════════════════════════════════════════════════════════════════════════════
grp_pp = "Pocket Pivot Settings"
pp_barSize = input.float(3.0, "% Change (Barsize)", minval=0.1, step=0.1, group=grp_pp)
pp_lookback = input.int(10, "Lookback Days", minval=1, group=grp_pp)
float pp_redVol = close < open ? volume : 0.0
float pp_greenVol = close > open ? volume : 0.0
float pp_hiRedVol = ta.highest(pp_redVol[1], pp_lookback)
float pp_hiGreenVol = ta.highest(pp_greenVol[1], pp_lookback)
bool pp_priceUp = ((close - open) / open) * 100 > pp_barSize
bool pp_priceDn = ((open - close) / open) * 100 > pp_barSize
bool pp_volBull = volume > pp_hiRedVol
bool pp_volBear = volume > pp_hiGreenVol
bool sigPUP = conf and pp_priceUp and pp_volBull
bool sigPPD = conf and pp_priceDn and pp_volBear

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: WHALE (Pocket Pivot + HV Milestone + PUP/PPD + PBJ) — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
grp_whale = "Whale Settings"
wh_lenBull = input.int(20, "Bull SMA Length", minval=1, group=grp_whale, inline="whs")
wh_lenBear = input.int(20, "Bear SMA Length", minval=1, group=grp_whale, inline="whs")
wh_useQ = input.bool(true, "Quarterly High (63d)", group=grp_whale, inline="whf")
wh_useY = input.bool(true, "Annual High (252d)", group=grp_whale, inline="whf")
wh_useATH = input.bool(true, "All-Time High", group=grp_whale, inline="whf")

f_whaleEngine() =>
    float wh_sma_bull = ta.sma(close, wh_lenBull)
    float wh_sma_bear = ta.sma(close, wh_lenBear)
    float wh_volAvg = ta.sma(volume, 50)
    float wh_hvy = ta.highest(volume, 252)
    float wh_hvq = ta.highest(volume, 63)
    var float wh_maxVolEver = 0.0
    if volume > wh_maxVolEver
        wh_maxVolEver := volume

    wh_dnVolArr = array.new_float()
    for i = 1 to wh_lenBull
        if close[i] < close[i + 1]
            array.push(wh_dnVolArr, volume[i])
    float wh_maxDnVol = array.size(wh_dnVolArr) > 0 ? array.max(wh_dnVolArr) : 0.0

    wh_upVolArr = array.new_float()
    for i = 1 to wh_lenBear
        if close[i] > close[i + 1]
            array.push(wh_upVolArr, volume[i])
    float wh_maxUpVol = array.size(wh_upVolArr) > 0 ? array.max(wh_upVolArr) : 0.0

    bool wh_isHV = (wh_useQ and volume == wh_hvq) or (wh_useY and volume == wh_hvy) or (wh_useATH and volume == wh_maxVolEver)

    bool wh_greenBar = close > close[1]
    bool wh_surgeonBull = wh_greenBar and (low <= wh_sma_bull) and (close > wh_sma_bull) and (volume > wh_maxDnVol) and (volume > wh_volAvg)
    bool wh_origBull = wh_greenBar and (low <= wh_sma_bull) and (volume > wh_maxDnVol)
    bool wh_pivotBull = wh_surgeonBull or wh_origBull

    bool wh_redBar = close < close[1]
    bool wh_surgeonBear = wh_redBar and (high >= wh_sma_bear) and (close < wh_sma_bear) and (volume > wh_maxUpVol) and (volume > wh_volAvg)
    bool wh_origBear = wh_redBar and (high >= wh_sma_bear) and (volume > wh_maxUpVol)
    bool wh_pivotBear = wh_surgeonBear or wh_origBear

    bool sigWhaleBull = conf and wh_pivotBull and wh_isHV and sigPUP and anyBullPBJ
    bool sigWhaleBear = conf and wh_pivotBear and wh_isHV and sigPPD and anyBearPBJ
    [sigWhaleBull, sigWhaleBear]

[sigWhaleBull, sigWhaleBear] = f_whaleEngine()

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: FAUNA (fauna variant, for TYPHOON) — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
f_faunaEngine() =>
    fauna_atr = ta.atr(14)
    fauna_avgVol = ta.sma(volume, 20)
    fauna_avgBody = ta.sma(math.abs(close - open), 20)
    fauna_avgRange = ta.sma(high - low, 20)
    fauna_avgDelta = ta.sma(math.abs(close - close[1]), 10)
    fauna_trendMA = ta.sma(close, 50)
    fauna_body = close - open
    fauna_rng = high - low
    fauna_bodySz = math.abs(fauna_body)
    fauna_bodyRat = fauna_rng == 0 ? 0 : fauna_bodySz / fauna_rng
    fauna_up = fauna_body > 0
    fauna_dn = fauna_body < 0

    MB_b = fauna_up and fauna_bodySz > 1.6 * fauna_atr and fauna_bodyRat > 0.7 and volume > 1.8 * fauna_avgVol
    RE_b = fauna_up and fauna_rng > 2.2 * fauna_atr and (high - close) < 0.15 * fauna_rng and volume > 1.8 * fauna_avgVol
    TA_b = fauna_trendMA > fauna_trendMA[1] and (close - close[1]) > 1.6 * fauna_avgDelta and fauna_up and volume > 1.8 * fauna_avgVol

    GG_b = (open - close[1]) > 0.9 * fauna_atr and fauna_up and low > close[1] and volume > 1.8 * fauna_avgVol
    fauna_prev_body = close[1] - open[1]
    fauna_prev_range = high[1] - low[1]
    fauna_StrongBear = close[1] < open[1] and math.abs(fauna_prev_body) > 1.5 * fauna_avgBody[1] and volume[1] > 1.5 * fauna_avgVol[1]
    fauna_WeakBear = close[1] < open[1] and (fauna_prev_range == 0 ? 0.0 : math.abs(fauna_prev_body) / fauna_prev_range) <= 0.2
    TR_b = fauna_WeakBear and (MB_b or RE_b or TA_b)
    ES_b = fauna_StrongBear and (MB_b or RE_b or TA_b)
    GDR_b = close[1] < open[1] and GG_b
    excluded_bull = GG_b or TR_b or ES_b or GDR_b

    sigFAUNABull = conf and (MB_b or RE_b or TA_b) and not excluded_bull

    MB_r = fauna_dn and fauna_bodySz > 1.6 * fauna_atr and fauna_bodyRat > 0.7 and volume > 1.8 * fauna_avgVol
    RE_r = fauna_dn and fauna_rng > 2.2 * fauna_atr and (close - low) < 0.15 * fauna_rng and volume > 1.8 * fauna_avgVol
    TA_r = fauna_trendMA < fauna_trendMA[1] and (close[1] - close) > 1.6 * fauna_avgDelta and fauna_dn and volume > 1.8 * fauna_avgVol

    GG_r = (close[1] - open) > 0.9 * fauna_atr and fauna_dn and high < close[1] and volume > 1.8 * fauna_avgVol
    fauna_StrongBull = close[1] > open[1] and math.abs(fauna_prev_body) > 1.5 * fauna_avgBody[1] and volume[1] > 1.5 * fauna_avgVol[1]
    fauna_WeakBull = close[1] > open[1] and (fauna_prev_range == 0 ? 0.0 : math.abs(fauna_prev_body) / fauna_prev_range) <= 0.2
    TR_r = fauna_WeakBull and (MB_r or RE_r or TA_r)
    ES_r = fauna_StrongBull and (MB_r or RE_r or TA_r)
    GDR_r = close[1] > open[1] and GG_r
    excluded_bear = GG_r or TR_r or ES_r or GDR_r

    sigFAUNABear = conf and (MB_r or RE_r or TA_r) and not excluded_bear
    [sigFAUNABull, sigFAUNABear]

[sigFAUNABull, sigFAUNABear] = f_faunaEngine()

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: GZ1 / HV FVG (for MUSASHI) — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
grp_gz1 = "GZ1 / HV Settings"
gz1_threshPct = input.float(2, "FVG Threshold %", minval=0, maxval=100, step=0.1, group=grp_gz1)
gz1_auto = input.bool(true, "Auto Threshold", group=grp_gz1)
gz1_dist = input.int(7, "GZ1 Max Bar Distance", minval=1, maxval=200, group=grp_gz1)
gz1_mitLvl = input.bool(false, "Show Mitigation Lines", group=grp_gz1)

type gz_fvg
    float mx
    float mn
    bool bull
    int t
    int idx
    bool hv
f_gzEngine() =>

    // GZ1 HV Detection
    float gz_v1 = volume[1]
    float _hv5000 = ta.highest(volume, 5000)[1]
    float _hv252 = ta.highest(volume, 252)[1]
    bool gz_isHV = gz_v1 == _hv5000 or gz_v1 == _hv252

    // GZ1 FVG Detection
    float gz_thresh = gz1_auto ? ta.cum((high - low) / low) / bar_index : gz1_threshPct / 100
    bool gz_bFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > gz_thresh
    bool gz_sFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / high > gz_thresh

    var gz_fvgs = array.new<gz_fvg>(0)
    var int gz_lastT = 0
    bool gz_bullGZI = false, bool gz_bearGZI = false, bool gz_bullHV = false, bool gz_bearHV = false

    // Process Bull FVG
    if gz_bFVG and time != gz_lastT
        float mx = low, float mn = high[2]
        if gz_isHV
            gz_bullHV := true
        if gz_fvgs.size() > 0
            for i = 0 to gz_fvgs.size() - 1
                gz_fvg e = gz_fvgs.get(i)
                if e.bull and bar_index - e.idx <= gz1_dist
                    float ob = math.max(e.mn, mn), float ot = math.min(e.mx, mx)
                    if ob < ot or (ob <= ot and e.hv and gz_isHV)
                        gz_bullGZI := true
                        break
        gz_fvgs.unshift(gz_fvg.new(mx, mn, true, time, bar_index, gz_isHV))
        gz_lastT := time

    // Process Bear FVG
    if gz_sFVG and time != gz_lastT
        float mx = low[2], float mn = high
        if gz_isHV
            gz_bearHV := true
        if gz_fvgs.size() > 0
            for i = 0 to gz_fvgs.size() - 1
                gz_fvg e = gz_fvgs.get(i)
                if not e.bull and bar_index - e.idx <= gz1_dist
                    float ob = math.max(e.mn, mn), float ot = math.min(e.mx, mx)
                    if ob < ot or (ob <= ot and e.hv and gz_isHV)
                        gz_bearGZI := true
                        break
        gz_fvgs.unshift(gz_fvg.new(mx, mn, false, time, bar_index, gz_isHV))
        gz_lastT := time

    // Mitigation Lines (Optional)
    if gz_fvgs.size() > 0 and gz1_mitLvl
        for i = gz_fvgs.size() - 1 to 0
            gz_fvg g = gz_fvgs.get(i)
            if g.bull and close < g.mn
                line.new(g.t, g.mn, time, g.mn, xloc.bar_time, color=color.new(#089981, 70), style=line.style_dashed)
                gz_fvgs.remove(i)
            else if not g.bull and close > g.mx
                line.new(g.t, g.mx, time, g.mx, xloc.bar_time, color=color.new(#f23645, 70), style=line.style_dashed)
                gz_fvgs.remove(i)
    if gz_fvgs.size() > 50
        gz_fvgs.pop()
    [gz_bullGZI, gz_bearGZI, gz_bullHV, gz_bearHV]

[gz_bullGZI, gz_bearGZI, gz_bullHV, gz_bearHV] = f_gzEngine()

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: YIN YANG SWING (for TYPHOON) — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
grp_yy_lb = "YY - Lookback Settings"
yy_leftBars = input.int(75, "Left Bars", minval=1, group=grp_yy_lb, tooltip="Minimum bars to the left to confirm a pivot")
yy_rightBars = input.int(1, "Right Bars", minval=1, group=grp_yy_lb, tooltip="Minimum bars to the right to confirm a pivot. Also determines plot offset.")
grp_yy_atr = "YY - ATR Filter Settings"
yy_atrLength = input.int(50, "ATR Length", minval=1, group=grp_yy_atr)
yy_atrMult = input.float(3.5, "ATR Multiplier", step=0.1, group=grp_yy_atr, tooltip="The new swing must be at least this many ATRs away from the previous valid swing level.")

type yy_sr
    float price
    bool isResistance

yy_isSufficientDistance(currentPrice, lastPrice, thr) =>
    na(lastPrice) ? true : math.abs(currentPrice - lastPrice) >= thr
f_yyEngine() =>
    var yy_srs = array.new<yy_sr>()
    var float yy_lastValidLevel = na

    float yy_atrValue = ta.atr(yy_atrLength)
    float yy_threshold = yy_atrValue * yy_atrMult

    float yy_rawHigh = ta.pivothigh(high, yy_leftBars, yy_rightBars)
    float yy_rawLow = ta.pivotlow(low, yy_leftBars, yy_rightBars)


    bool yy_validHigh = false
    if not na(yy_rawHigh) and conf
        if yy_isSufficientDistance(yy_rawHigh, yy_lastValidLevel, yy_threshold)
            yy_validHigh := true
            yy_lastValidLevel := yy_rawHigh
            array.push(yy_srs, yy_sr.new(yy_rawHigh, true))

    bool yy_validLow = false
    if not na(yy_rawLow) and conf
        if yy_isSufficientDistance(yy_rawLow, yy_lastValidLevel, yy_threshold)
            yy_validLow := true
            yy_lastValidLevel := yy_rawLow
            array.push(yy_srs, yy_sr.new(yy_rawLow, false))
    [yy_validHigh, yy_validLow]

[yy_validHigh, yy_validLow] = f_yyEngine()

// ══════════════════════════════════════════════════════════════════════════════
// MASTER OFFSET ALIGNMENT — 1st PUP FAUNA parity (moff drives Musashi anchoring)
// ══════════════════════════════════════════════════════════════════════════════
grp_align = "Alignment (Fauna parity)"
i_req_fvg = input.bool(true, "Require FVG for Displacement", group=grp_align, tooltip="Fauna's master-offset switch. ON (fauna default): moff=1 — Musashi's PUP/Whale/PBJ legs and the Musashi first-bar check read bar[1]; plot offset -1. OFF: moff=0, all offset-0.")
moff = i_req_fvg ? 1 : 0

f_align(sig) => moff == 0 ? sig : sig[1]

al_anyBullPBJ = f_align(anyBullPBJ)
al_anyBearPBJ = f_align(anyBearPBJ)
al_PUP = f_align(sigPUP)
al_PPD = f_align(sigPPD)
al_WhaleBull = f_align(sigWhaleBull)
al_WhaleBear = f_align(sigWhaleBear)
al_isFirstBar = f_align(is_new_sess)

// ══════════════════════════════════════════════════════════════════════════════
// TYPHOON + MUSASHI — 1st PUP FAUNA parity
// ══════════════════════════════════════════════════════════════════════════════
// MUSASHI — (GZI OR HV FVG) + PUP/PPD + Whale + anyPBJ (FVG legs RAW, rest ALIGNED — fauna asymmetry preserved)
sigMusashiBull = conf and (gz_bullGZI or gz_bullHV) and al_PUP and al_WhaleBull and al_anyBullPBJ
sigMusashiBear = conf and (gz_bearGZI or gz_bearHV) and al_PPD and al_WhaleBear and al_anyBearPBJ

// TYPHOON — swing + first bar + FAUNA + (PUP/PPD OR (Whale + anyPBJ)) on the pivot bar
bool typh_bull_extra = sigPUP[yy_rightBars] or (sigWhaleBull[yy_rightBars] and anyBullPBJ[yy_rightBars])
bool typh_bear_extra = sigPPD[yy_rightBars] or (sigWhaleBear[yy_rightBars] and anyBearPBJ[yy_rightBars])
bool sigTyphoonBull = conf and yy_validLow and is_new_sess[yy_rightBars] and sigFAUNABull[yy_rightBars] and typh_bull_extra
bool sigTyphoonBear = conf and yy_validHigh and is_new_sess[yy_rightBars] and sigFAUNABear[yy_rightBars] and typh_bear_extra

// ══════════════════════════════════════════════════════════════════════════════
// B2B SAAB / B2B KRATOS — B2B PUP v5.4 S5 parity + Disp9-on-pattern constraint
// ══════════════════════════════════════════════════════════════════════════════
bool det_b2bPUP = sigPUP and nz(sigPUP[1])
bool det_b2bPPD = sigPPD and nz(sigPPD[1])

bool saab_dir_b = det_SAAB or det_RVOL1xB or det_GrandSlam
bool saab_neut = det_WTC or det_Hiroshima
bool saab_dir_b1 = nz(det_SAAB[1]) or nz(det_RVOL1xB[1]) or nz(det_GrandSlam[1])
bool saab_neut1 = nz(det_WTC[1]) or nz(det_Hiroshima[1])
bool det_S5_bull = det_b2bPUP and ((saab_dir_b and (saab_dir_b1 or saab_neut1)) or ((saab_dir_b or saab_neut) and saab_dir_b1))
bool krat_dir = det_Kratos or det_RVOL1xR or det_MOAB
bool krat_dir1 = nz(det_Kratos[1]) or nz(det_RVOL1xR[1]) or nz(det_MOAB[1])
bool det_S5_bear = det_b2bPPD and ((krat_dir and (krat_dir1 or saab_neut1)) or ((krat_dir or saab_neut) and krat_dir1))

// NEW CONSTRAINT: Disp9 on one of the two pattern bars (bar[0] or bar[1])
bool det_S9_kratos = det_S5_bear and (d9_bear or nz(d9_bear[1]))
bool det_S10_saab = det_S5_bull and (d9_bull or nz(d9_bull[1]))

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: u5 FAUNA (TNT OD variant, for DYNAMITE) — TNT OD v3 parity
// ══════════════════════════════════════════════════════════════════════════════
f_u5FaunaEngine() =>
    float ATR14 = ta.atr(14)
    float u5_f_atr = ATR14, float u5_f_avgVol = ta.sma(volume, 20), float u5_f_avgBody = ta.sma(math.abs(close - open), 20)
    float u5_f_avgDelta = ta.sma(math.abs(close - close[1]), 10), float u5_f_trendMA = ta.sma(close, 50)
    float u5_f_body = close - open, float u5_f_rng = high - low, float u5_f_bodySz = math.abs(u5_f_body)
    float u5_f_bodyRat = u5_f_rng == 0 ? 0.0 : u5_f_bodySz / u5_f_rng
    bool u5_f_up = u5_f_body > 0, bool u5_f_dn = u5_f_body < 0
    float u5_f_prev_body = close[1] - open[1], float u5_f_prev_range = high[1] - low[1]
    bool u5_MB_b = u5_f_up and u5_f_bodySz > 1.6 * u5_f_atr and u5_f_bodyRat > 0.70 and volume > 1.8 * u5_f_avgVol
    bool u5_RE_b = u5_f_up and u5_f_rng > 2.2 * u5_f_atr and (high - close) < 0.15 * u5_f_rng and volume > 1.8 * u5_f_avgVol
    bool u5_TA_b = u5_f_trendMA > u5_f_trendMA[1] and (close - close[1]) > 1.6 * u5_f_avgDelta and u5_f_up and volume > 1.8 * u5_f_avgVol
    bool u5_GG_b = (open - close[1]) > 0.9 * u5_f_atr and u5_f_up and low > close[1] and volume > 1.8 * u5_f_avgVol
    bool u5_StrongBear = close[1] < open[1] and math.abs(u5_f_prev_body) > 1.5 * u5_f_avgBody[1] and volume[1] > 1.5 * u5_f_avgVol[1]
    bool u5_WeakBear = close[1] < open[1] and (u5_f_prev_range == 0 ? 0.0 : math.abs(u5_f_prev_body) / u5_f_prev_range) <= 0.2
    bool u5_TR_b = u5_WeakBear and (u5_MB_b or u5_RE_b or u5_TA_b), bool u5_ES_b = u5_StrongBear and (u5_MB_b or u5_RE_b or u5_TA_b), bool u5_GDR_b = close[1] < open[1] and u5_GG_b
    int u5_b_core = (u5_MB_b ? 1 : 0) + (u5_RE_b ? 1 : 0) + (u5_TA_b ? 1 : 0)
    bool u5_b_gg_exc = u5_GG_b and not ((u5_b_core >= 2) and (u5_f_bodyRat >= 0.80))
    bool u5_FAUNABull = barstate.isconfirmed and (u5_MB_b or u5_RE_b or u5_TA_b) and not (u5_TR_b or u5_ES_b or u5_GDR_b or u5_b_gg_exc)

    bool u5_MB_r = u5_f_dn and u5_f_bodySz > 1.6 * u5_f_atr and u5_f_bodyRat > 0.70 and volume > 1.8 * u5_f_avgVol
    bool u5_RE_r = u5_f_dn and u5_f_rng > 2.2 * u5_f_atr and (close - low) < 0.15 * u5_f_rng and volume > 1.8 * u5_f_avgVol
    bool u5_TA_r = u5_f_trendMA < u5_f_trendMA[1] and (close[1] - close) > 1.6 * u5_f_avgDelta and u5_f_dn and volume > 1.8 * u5_f_avgVol
    bool u5_GG_r = (close[1] - open) > 0.9 * u5_f_atr and u5_f_dn and high < close[1] and volume > 1.8 * u5_f_avgVol
    bool u5_StrongBull = close[1] > open[1] and math.abs(u5_f_prev_body) > 1.5 * u5_f_avgBody[1] and volume[1] > 1.5 * u5_f_avgVol[1]
    bool u5_WeakBull = close[1] > open[1] and (u5_f_prev_range == 0 ? 0.0 : math.abs(u5_f_prev_body) / u5_f_prev_range) <= 0.2
    bool u5_TR_r = u5_WeakBull and (u5_MB_r or u5_RE_r or u5_TA_r), bool u5_ES_r = u5_StrongBull and (u5_MB_r or u5_RE_r or u5_TA_r), bool u5_GDR_r = close[1] > open[1] and u5_GG_r
    int u5_s_core = (u5_MB_r ? 1 : 0) + (u5_RE_r ? 1 : 0) + (u5_TA_r ? 1 : 0)
    bool u5_s_gg_exc = u5_GG_r and not ((u5_s_core >= 2) and (u5_f_bodyRat >= 0.80))
    bool u5_FAUNABear = barstate.isconfirmed and (u5_MB_r or u5_RE_r or u5_TA_r) and not (u5_TR_r or u5_ES_r or u5_GDR_r or u5_s_gg_exc)
    [u5_FAUNABull, u5_FAUNABear]

[u5_FAUNABull, u5_FAUNABear] = f_u5FaunaEngine()

// ══════════════════════════════════════════════════════════════════════════════
// DYNAMITE — TNT OD v3 parity (dedicated 100-bar σ engine)
// ══════════════════════════════════════════════════════════════════════════════
grpDyn = "★ DYNAMITE ★ (Displacement — DEDICATED to DYNAMITE only)"
float dynStdMult = input.float(5.0, "Displacement Std Dev Multiplier (DYNAMITE-only)", minval=1.0, step=0.5, group=grpDyn, tooltip="σ-multiplier used ONLY by the DYNAMITE detection (B2B σ-range + FVG check). Hard-coded 100-bar stdev lookback.")
float dyn_disp = math.abs(open - close)
float dyn_std = ta.stdev(dyn_disp, 100)
bool dyn_disp_b1 = dyn_disp[1] > nz(dyn_std[1]) * dynStdMult
bool dyn_disp_b2 = dyn_disp[2] > nz(dyn_std[2]) * dynStdMult
bool dyn_bullFVG = low > high[2] and close[1] > open[1]
bool dyn_bearFVG = high < low[2] and close[1] < open[1]
bool dyn_bull_dir = close[1] > open[1] and close[2] > open[2]
bool dyn_bear_dir = close[1] < open[1] and close[2] < open[2]
bool dyn_fauna_bull = nz(u5_FAUNABull[1]) and nz(u5_FAUNABull[2])
bool dyn_fauna_bear = nz(u5_FAUNABear[1]) and nz(u5_FAUNABear[2])
bool det_dynamiteBull = barstate.isconfirmed and dyn_disp_b1 and dyn_disp_b2 and dyn_bull_dir and dyn_fauna_bull and dyn_bullFVG
bool det_dynamiteBear = barstate.isconfirmed and dyn_disp_b1 and dyn_disp_b2 and dyn_bear_dir and dyn_fauna_bear and dyn_bearFVG

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: TNT OD v3 CORE (tod_ prefix; for IGNITE) — VOB + ANISH + FLUX + TNT +
// zones + charge + return + displacement + napalm + sudden change. Visual line/
// label/box members stripped from types; all state logic verbatim.
// ══════════════════════════════════════════════════════════════════════════════
grpE = "TNT OD Engine (Ignite)"
int tod_SENS = input.int(100, "Sensitivity", minval=1, group=grpE)
int tod_SWING_LEN = input.int(10, "Swing Length", minval=3, group=grpE)
string tod_DISP_TYPE = input.string("Open to Close", "Range Type", options=["Open to Close", "High to Low"], group=grpE)
int tod_DISP_STD_LEN = input.int(100, "Disp Std Dev Length", minval=1, group=grpE)
int tod_DISP_STD_X = input.int(5, "Disp Std Dev Mult", minval=0, group=grpE)
float tod_RET_TNT_PCT = input.float(100.0, "Return to TNT %", minval=-10, step=0.1, group=grpE)
int tod_SUDDEN_PROX = input.int(3, "Sudden Change Max Bar Distance", minval=1, group=grpE)
int tod_maxZones = input.int(30, "Max TNT 1.0 Zones", minval=1, group=grpE)
int tod_maxSuperZones = input.int(30, "Max TNT 2.0 Zones", minval=1, group=grpE)

type tod_Zone
    int originIdx
    int confirmIdx
    float upper
    float lower
    float level
    float vol
    bool isBull
    bool isActive = true
    bool returnFired = false

type tod_SuperZone
    int formBar
    float zoneTop
    float zoneBtm
    float returnLevel
    bool isBull
    bool isActive = true
    bool returnFired = false

type tod_SwingPoint
    float val = na
    int idx = na
    bool crossed = false

type tod_BullBearEvent
    int barIdx
    float level
    float upper
    float lower
    bool isBull
    bool isTrue

type tod_ChargeLevel
    float level
    bool isBull
    int barIdx
    bool violated = false

int tod_EMA_FAST = tod_SENS, int tod_EMA_SLOW = tod_SENS + 13
float tod_ATR_VAL = ta.atr(200)
float tod_ATR_MULT = 3.5, float tod_ATR_MIN = 0.5
int tod_MIN_SIG_GAP = tod_EMA_SLOW
int tod_CONF_WINDOW = tod_EMA_SLOW * 2
float ema_fast = ta.ema(close, tod_EMA_FAST), float ema_slow = ta.ema(close, tod_EMA_SLOW)
float tod_volMedian = ta.median(volume, tod_EMA_SLOW), float tod_emaSlope = ema_fast - ema_fast[5], float tod_rsiVal = ta.rsi(close, 14)
f_tod_temporal_ok(int a, int b, int c) =>
    int mn = math.min(a, math.min(b, c)), int mx = math.max(a, math.max(b, c))
    mx - mn <= tod_CONF_WINDOW and mn > 0
f_tod_zones_overlap(float u1, float l1, float u2, float l2) => not na(u1) and not na(u2) and u1 >= l2 and u2 >= l1
f_tod_synergy_bull(float vV, float vU, float vL, float aU, float aL) => vV > tod_volMedian * tod_EMA_SLOW * 0.5 and tod_emaSlope > 0 and tod_rsiVal < 80 and (math.min(vU - vL, aU - aL) > 0 ? math.max(0, math.min(vU, aU) - math.max(vL, aL)) / math.min(vU - vL, aU - aL) > 0.3 : false)
f_tod_synergy_bear(float vV, float vU, float vL, float aU, float aL) => vV > tod_volMedian * tod_EMA_SLOW * 0.5 and tod_emaSlope < 0 and tod_rsiVal > 20 and (math.min(vU - vL, aU - aL) > 0 ? math.max(0, math.min(vU, aU) - math.max(vL, aL)) / math.min(vU - vL, aU - aL) > 0.3 : false)
f_tod_engine() =>

    // ENGINE 1: VOB
    bool vob_bull_cross = ta.crossover(ema_fast, ema_slow) and barstate.isconfirmed
    bool vob_bear_cross = ta.crossunder(ema_fast, ema_slow) and barstate.isconfirmed
    var float vob_bull_upper = na, var float vob_bull_lower = na, var int vob_bull_origin = na, var float vob_bull_vol = na, var bool vob_bull_new = false
    var float vob_bear_upper = na, var float vob_bear_lower = na, var int vob_bear_origin = na, var float vob_bear_vol = na, var bool vob_bear_new = false
    float atr_hi = ta.highest(tod_ATR_VAL, 200) * 2.0
    if vob_bull_cross
        float cumVol = 0.0, int originBar = bar_index, float originLow = low
        for i = 1 to tod_EMA_SLOW
            if low[i] <= originLow
                originLow := low[i], originBar := bar_index - i
            cumVol += volume[i]
        float src = math.min(open[bar_index - originBar], close[bar_index - originBar])
        src := (src - originLow) < atr_hi * 0.5 ? originLow + atr_hi * 0.5 : src
        vob_bull_upper := src, vob_bull_lower := originLow, vob_bull_origin := originBar, vob_bull_vol := cumVol, vob_bull_new := true
    else
        vob_bull_new := false
    if vob_bear_cross
        float cumVol = 0.0, int originBar = bar_index, float originHigh = high
        for i = 1 to tod_EMA_SLOW
            if high[i] >= originHigh
                originHigh := high[i], originBar := bar_index - i
            cumVol += volume[i]
        float src = math.max(open[bar_index - originBar], close[bar_index - originBar])
        src := (originHigh - src) < atr_hi * 0.5 ? originHigh - atr_hi * 0.5 : src
        vob_bear_upper := originHigh, vob_bear_lower := src, vob_bear_origin := originBar, vob_bear_vol := cumVol, vob_bear_new := true
    else
        vob_bear_new := false

    // SWING + ENGINE 2: ANISH
    var int swingState = 0
    var tod_SwingPoint swHigh = tod_SwingPoint.new(na, na), var tod_SwingPoint swLow = tod_SwingPoint.new(na, na)
    float sw_upper = ta.highest(high, tod_SWING_LEN), float sw_lower = ta.lowest(low, tod_SWING_LEN)
    swingState := high[tod_SWING_LEN] > sw_upper ? 0 : low[tod_SWING_LEN] < sw_lower ? 1 : swingState
    if swingState == 0 and swingState[1] != 0
        swHigh := tod_SwingPoint.new(high[tod_SWING_LEN], bar_index[tod_SWING_LEN])
    if swingState == 1 and swingState[1] != 1
        swLow := tod_SwingPoint.new(low[tod_SWING_LEN], bar_index[tod_SWING_LEN])

    var float anish_bull_ob_upper = na, var float anish_bull_ob_lower = na, var int anish_bull_ob_idx = na
    var float anish_bull_prev_upper = na, var float anish_bull_prev_lower = na, var int anish_bull_prev_idx = na, var bool anish_bull_new = false
    var float anish_bear_ob_upper = na, var float anish_bear_ob_lower = na, var int anish_bear_ob_idx = na
    var float anish_bear_prev_upper = na, var float anish_bear_prev_lower = na, var int anish_bear_prev_idx = na, var bool anish_bear_new = false

    if close > swHigh.val and not swHigh.crossed and barstate.isconfirmed and not na(swHigh.val)
        swHigh.crossed := true
        float obLow = low[1], float obHigh = high[1], int obIdx = bar_index - 1
        int lookback = bar_index - swHigh.idx
        if lookback > 1
            for i = 1 to lookback - 1
                if open[i] > close[i] and low[i] <= obLow
                    obLow := low[i], obHigh := high[i], obIdx := bar_index - i
        anish_bull_prev_upper := anish_bull_ob_upper, anish_bull_prev_lower := anish_bull_ob_lower, anish_bull_prev_idx := anish_bull_ob_idx
        anish_bull_ob_upper := obHigh, anish_bull_ob_lower := obLow, anish_bull_ob_idx := obIdx
        anish_bull_new := not na(anish_bull_prev_upper) and obIdx <= nz(anish_bull_prev_idx, 0) + tod_EMA_SLOW and obHigh > nz(anish_bull_prev_lower, na) and obLow < nz(anish_bull_prev_upper, na)
    else
        anish_bull_new := false

    if close < swLow.val and not swLow.crossed and barstate.isconfirmed and not na(swLow.val)
        swLow.crossed := true
        float obLow = low[1], float obHigh = high[1], int obIdx = bar_index - 1
        int lookback = bar_index - swLow.idx
        if lookback > 1
            for i = 1 to lookback - 1
                if open[i] < close[i] and high[i] >= obHigh
                    obHigh := high[i], obLow := low[i], obIdx := bar_index - i
        anish_bear_prev_upper := anish_bear_ob_upper, anish_bear_prev_lower := anish_bear_ob_lower, anish_bear_prev_idx := anish_bear_ob_idx
        anish_bear_ob_upper := obHigh, anish_bear_ob_lower := obLow, anish_bear_ob_idx := obIdx
        anish_bear_new := not na(anish_bear_prev_lower) and obIdx <= nz(anish_bear_prev_idx, 0) + tod_EMA_SLOW and obLow < nz(anish_bear_prev_upper, na) and obHigh > nz(anish_bear_prev_lower, na)
    else
        anish_bear_new := false

    // ENGINE 3: FLUX
    var float flux_bull_ob_top = na, var float flux_bull_ob_btm = na, var int flux_bull_ob_time = na
    var bool flux_bull_ob_active = false, var bool flux_bull_pb_new = false, var int flux_bull_pb_idx = na
    var float flux_bear_ob_top = na, var float flux_bear_ob_btm = na, var int flux_bear_ob_time = na
    var bool flux_bear_ob_active = false, var bool flux_bear_pb_new = false, var int flux_bear_pb_idx = na
    var tod_SwingPoint flux_swH = tod_SwingPoint.new(na, na), var tod_SwingPoint flux_swL = tod_SwingPoint.new(na, na)
    if swingState == 0 and swingState[1] != 0
        flux_swH := tod_SwingPoint.new(high[tod_SWING_LEN], bar_index[tod_SWING_LEN])
    if swingState == 1 and swingState[1] != 1
        flux_swL := tod_SwingPoint.new(low[tod_SWING_LEN], bar_index[tod_SWING_LEN])
    if close > flux_swH.val and not flux_swH.crossed and barstate.isconfirmed and not na(flux_swH.val)
        flux_swH.crossed := true
        float boxBtm = math.min(open[1], close[1]), float boxTop = math.max(open[1], close[1]), int boxIdx = bar_index - 1
        int lookback = bar_index - flux_swH.idx
        if lookback > 1
            for i = 1 to lookback - 1
                if math.min(open[i], close[i]) < boxBtm
                    boxBtm := math.min(open[i], close[i]), boxTop := math.max(open[i], close[i]), boxIdx := bar_index - i
        float obSize = math.abs(boxTop - boxBtm)
        if obSize <= tod_ATR_VAL * tod_ATR_MULT and obSize > tod_ATR_VAL * tod_ATR_MIN
            flux_bull_ob_top := boxTop, flux_bull_ob_btm := boxBtm, flux_bull_ob_time := boxIdx, flux_bull_ob_active := true
    if close < flux_swL.val and not flux_swL.crossed and barstate.isconfirmed and not na(flux_swL.val)
        flux_swL.crossed := true
        float boxTop = math.max(open[1], close[1]), float boxBtm = math.min(open[1], close[1]), int boxIdx = bar_index - 1
        int lookback = bar_index - flux_swL.idx
        if lookback > 1
            for i = 1 to lookback - 1
                if math.max(open[i], close[i]) > boxTop
                    boxTop := math.max(open[i], close[i]), boxBtm := math.min(open[i], close[i]), boxIdx := bar_index - i
        float obSize = math.abs(boxTop - boxBtm)
        if obSize <= tod_ATR_VAL * tod_ATR_MULT and obSize > tod_ATR_VAL * tod_ATR_MIN
            flux_bear_ob_top := boxTop, flux_bear_ob_btm := boxBtm, flux_bear_ob_time := boxIdx, flux_bear_ob_active := true
    flux_bull_pb_new := false
    if flux_bull_ob_active and barstate.isconfirmed
        if close < flux_bull_ob_btm
            flux_bull_ob_active := false
        else if low[1] < flux_bull_ob_top and low[1] > flux_bull_ob_btm and close > open and close > high[1]
            flux_bull_pb_new := true, flux_bull_pb_idx := flux_bull_ob_time
    flux_bear_pb_new := false
    if flux_bear_ob_active and barstate.isconfirmed
        if close > flux_bear_ob_top
            flux_bear_ob_active := false
        else if high[1] > flux_bear_ob_btm and high[1] < flux_bear_ob_top and close < open and close < low[1]
            flux_bear_pb_new := true, flux_bear_pb_idx := flux_bear_ob_time

    // CONFLUENCE → TNT 1.0
    var int vob_bull_conf_bar = 0, var int anish_bull_conf_bar = 0, var int flux_bull_conf_bar = 0
    var int vob_bear_conf_bar = 0, var int anish_bear_conf_bar = 0, var int flux_bear_conf_bar = 0
    var float vob_bull_u = na, var float vob_bull_l = na, var float vob_bear_u = na, var float vob_bear_l = na
    if vob_bull_new
        vob_bull_conf_bar := bar_index, vob_bull_u := vob_bull_upper, vob_bull_l := vob_bull_lower
    if vob_bear_new
        vob_bear_conf_bar := bar_index, vob_bear_u := vob_bear_upper, vob_bear_l := vob_bear_lower
    if anish_bull_new
        anish_bull_conf_bar := bar_index
    if anish_bear_new
        anish_bear_conf_bar := bar_index
    if flux_bull_pb_new
        flux_bull_conf_bar := bar_index
    if flux_bear_pb_new
        flux_bear_conf_bar := bar_index


    var tod_tnt_zones = array.new<tod_Zone>(0)
    var int tod_lastBullSigBar = 0, var int tod_lastBearSigBar = 0
    bool tod_bullConf = f_tod_temporal_ok(vob_bull_conf_bar, anish_bull_conf_bar, flux_bull_conf_bar) and f_tod_zones_overlap(vob_bull_u, vob_bull_l, anish_bull_ob_upper, anish_bull_ob_lower)
    bool tod_bearConf = f_tod_temporal_ok(vob_bear_conf_bar, anish_bear_conf_bar, flux_bear_conf_bar) and f_tod_zones_overlap(vob_bear_u, vob_bear_l, anish_bear_ob_upper, anish_bear_ob_lower)
    bool tod_raw_bullTNT = tod_bullConf and f_tod_synergy_bull(nz(vob_bull_vol), nz(vob_bull_u), nz(vob_bull_l), nz(anish_bull_ob_upper), nz(anish_bull_ob_lower)) and barstate.isconfirmed and (bar_index - tod_lastBullSigBar) > tod_MIN_SIG_GAP
    bool tod_raw_bearTNT = tod_bearConf and f_tod_synergy_bear(nz(vob_bear_vol), nz(vob_bear_u), nz(vob_bear_l), nz(anish_bear_ob_upper), nz(anish_bear_ob_lower)) and barstate.isconfirmed and (bar_index - tod_lastBearSigBar) > tod_MIN_SIG_GAP


    var tod_charge_levels = array.new<tod_ChargeLevel>(0)
    if tod_raw_bullTNT
        tod_lastBullSigBar := bar_index
        int _bullOrg = math.min(nz(vob_bull_origin, bar_index), math.min(nz(anish_bull_ob_idx, bar_index), nz(flux_bull_pb_idx, bar_index)))
        int origin = _bullOrg > 0 ? _bullOrg : bar_index
        float oU = math.min(nz(vob_bull_u, high), nz(anish_bull_ob_upper, high)), float oL = math.max(nz(vob_bull_l, low), nz(anish_bull_ob_lower, low)), float lvl = math.avg(oU, oL)
        tod_tnt_zones.push(tod_Zone.new(origin, bar_index, oU, oL, lvl, nz(vob_bull_vol), true, true, false))
        tod_charge_levels.push(tod_ChargeLevel.new(lvl, true, bar_index))
    if tod_raw_bearTNT
        tod_lastBearSigBar := bar_index
        int _bearOrg = math.min(nz(vob_bear_origin, bar_index), math.min(nz(anish_bear_ob_idx, bar_index), nz(flux_bear_pb_idx, bar_index)))
        int origin = _bearOrg > 0 ? _bearOrg : bar_index
        float oU = math.min(nz(vob_bear_u, high), nz(anish_bear_ob_upper, high)), float oL = math.max(nz(vob_bear_l, low), nz(anish_bear_ob_lower, low)), float lvl = math.avg(oU, oL)
        tod_tnt_zones.push(tod_Zone.new(origin, bar_index, oU, oL, lvl, nz(vob_bear_vol), false, true, false))
        tod_charge_levels.push(tod_ChargeLevel.new(lvl, false, bar_index))

    // Return + zone lifecycle
    bool tod_raw_retBullTNT = false, bool tod_raw_retBearTNT = false
    if tod_tnt_zones.size() > 0
        for i = tod_tnt_zones.size() - 1 to 0
            tod_Zone z = tod_tnt_zones.get(i)
            if z.isActive
                if z.isBull and close < z.lower
                    z.isActive := false
                if not z.isBull and close > z.upper
                    z.isActive := false
                if z.isActive and not z.returnFired and barstate.isconfirmed and bar_index > z.confirmIdx
                    float zH = z.upper - z.lower
                    if z.isBull
                        float retLvl = z.lower + zH * (tod_RET_TNT_PCT / 100.0)
                        if low <= retLvl and close > z.lower
                            z.returnFired := true, tod_raw_retBullTNT := true
                    if not z.isBull
                        float retLvl = z.upper - zH * (tod_RET_TNT_PCT / 100.0)
                        if high >= retLvl and close < z.upper
                            z.returnFired := true, tod_raw_retBearTNT := true
        while tod_tnt_zones.size() > tod_maxZones
            tod_tnt_zones.shift()

    // Displacement (Engine #1)
    float tod_disp_range = tod_DISP_TYPE == "Open to Close" ? math.abs(open - close) : high - low
    float tod_disp_std = ta.stdev(tod_disp_range, tod_DISP_STD_LEN), float tod_disp_threshold = tod_disp_std * tod_DISP_STD_X
    bool tod_isBullishFVG = low > high[2] and open[1] < close[1], bool tod_isBearishFVG = high < low[2] and open[1] > close[1]
    bool tod_prevBarDisplaced = tod_disp_range[1] > tod_disp_threshold[1]
    bool tod_dispSignal = tod_prevBarDisplaced and (tod_isBullishFVG or tod_isBearishFVG) and barstate.isconfirmed
    bool tod_dispBull = tod_dispSignal and close[1] > open[1], bool tod_dispBear = tod_dispSignal and close[1] < open[1]

    // Napalm + Charge
    bool tod_raw_napalmBull = false, bool tod_raw_napalmBear = false
    float tod_pseudoBullLevel = na, float tod_pseudoBearLevel = na
    if barstate.isconfirmed and tod_tnt_zones.size() > 0
        if tod_dispBull
            for i = tod_tnt_zones.size() - 1 to 0
                tod_Zone z = tod_tnt_zones.get(i)
                if not z.isBull and z.isActive and low[1] > z.level
                    tod_raw_napalmBull := true, tod_pseudoBullLevel := z.level
                    break
        if tod_dispBear
            for i = tod_tnt_zones.size() - 1 to 0
                tod_Zone z = tod_tnt_zones.get(i)
                if z.isBull and z.isActive and high[1] < z.level
                    tod_raw_napalmBear := true, tod_pseudoBearLevel := z.level
                    break
    bool tod_raw_bullCharge = false, bool tod_raw_bearCharge = false
    float tod_chargeBullLevel = na, float tod_chargeBearLevel = na
    if barstate.isconfirmed and tod_charge_levels.size() > 0
        if tod_dispBull
            for i = tod_charge_levels.size() - 1 to 0
                tod_ChargeLevel cl = tod_charge_levels.get(i)
                if not cl.isBull and not cl.violated and close[1] > cl.level
                    cl.violated := true, tod_raw_bullCharge := true, tod_chargeBullLevel := cl.level
                    tod_charge_levels.push(tod_ChargeLevel.new(low[1], true, bar_index))
                    break
        if tod_dispBear
            for i = tod_charge_levels.size() - 1 to 0
                tod_ChargeLevel cl = tod_charge_levels.get(i)
                if cl.isBull and not cl.violated and close[1] < cl.level
                    cl.violated := true, tod_raw_bearCharge := true, tod_chargeBearLevel := cl.level
                    tod_charge_levels.push(tod_ChargeLevel.new(high[1], false, bar_index))
                    break
    while tod_charge_levels.size() > 100
        tod_charge_levels.shift()

    // Super Charge + Super TNT (internal)
    bool tod_raw_superTNTBull = tod_raw_bullTNT and tod_raw_bearCharge, bool tod_raw_superTNTBear = tod_raw_bearTNT and tod_raw_bullCharge

    // Event log + TNT 2.0 (compact)
    var tod_bull_events = array.new<tod_BullBearEvent>(0), var tod_bear_events = array.new<tod_BullBearEvent>(0)
    bool tod_effectiveBullCharge = tod_raw_bullCharge and not tod_raw_bearTNT, bool tod_effectiveBearCharge = tod_raw_bearCharge and not tod_raw_bullTNT
    bool tod_anyBullEvent = tod_raw_bullTNT or tod_raw_napalmBull or tod_effectiveBullCharge, bool tod_anyBearEvent = tod_raw_bearTNT or tod_raw_napalmBear or tod_effectiveBearCharge
    if tod_anyBullEvent
        int evtBar = tod_raw_bullTNT ? bar_index : bar_index - 1
        float evtLvl = tod_raw_bullTNT ? math.avg(math.min(nz(vob_bull_u, high), nz(anish_bull_ob_upper, high)), math.max(nz(vob_bull_l, low), nz(anish_bull_ob_lower, low))) : tod_raw_napalmBull ? tod_pseudoBullLevel : tod_chargeBullLevel
        tod_bull_events.push(tod_BullBearEvent.new(evtBar, evtLvl, high, low, true, tod_raw_bullTNT))
        tod_bear_events.clear()
        while tod_bull_events.size() > 20
            tod_bull_events.shift()
    if tod_anyBearEvent and not tod_anyBullEvent
        int evtBar = tod_raw_bearTNT ? bar_index : bar_index - 1
        float evtLvl = tod_raw_bearTNT ? math.avg(math.min(nz(vob_bear_u, high), nz(anish_bear_ob_upper, high)), math.max(nz(vob_bear_l, low), nz(anish_bear_ob_lower, low))) : tod_raw_napalmBear ? tod_pseudoBearLevel : tod_chargeBearLevel
        tod_bear_events.push(tod_BullBearEvent.new(evtBar, evtLvl, high, low, false, tod_raw_bearTNT))
        tod_bull_events.clear()
        while tod_bear_events.size() > 20
            tod_bear_events.shift()

    var tod_super_zones = array.new<tod_SuperZone>(0)
    var int tod_lastSuperBullBar = 0, var int tod_lastSuperBearBar = 0
    bool tod_raw_bullTNT2 = false, bool tod_raw_bearTNT2 = false
    if tod_bull_events.size() >= 2 and tod_anyBullEvent and barstate.isconfirmed and (bar_index - tod_lastSuperBullBar) > tod_MIN_SIG_GAP
        tod_raw_bullTNT2 := true, tod_lastSuperBullBar := bar_index
    if tod_bear_events.size() >= 2 and tod_anyBearEvent and not tod_anyBullEvent and barstate.isconfirmed and (bar_index - tod_lastSuperBearBar) > tod_MIN_SIG_GAP
        tod_raw_bearTNT2 := true, tod_lastSuperBearBar := bar_index

    // Return TNT 2.0 (compact — source parity: no SuperZone constructor exists in TNT OD v3, array stays empty)
    bool tod_raw_retBullTNT2 = false, bool tod_raw_retBearTNT2 = false
    if tod_super_zones.size() > 0 and barstate.isconfirmed
        for i = tod_super_zones.size() - 1 to 0
            tod_SuperZone sz = tod_super_zones.get(i)
            if sz.isActive and not sz.returnFired
                if sz.isBull and low <= sz.returnLevel and close > sz.zoneBtm
                    sz.returnFired := true, tod_raw_retBullTNT2 := true
                if not sz.isBull and high >= sz.returnLevel and close < sz.zoneTop
                    sz.returnFired := true, tod_raw_retBearTNT2 := true
        while tod_super_zones.size() > tod_maxSuperZones
            tod_super_zones.shift()

    // Sudden Change — Continuous only
    var int tod_sc_lastBullChargeBar = na, var int tod_sc_lastBearChargeBar = na
    var int tod_sc_lastRetBullBar = na, var int tod_sc_lastRetBearBar = na
    var int tod_sc_lastBullTNTBar = na, var int tod_sc_lastBearTNTBar = na
    var int tod_sc_lastBullTNT2Bar = na, var int tod_sc_lastBearTNT2Bar = na
    bool tod_raw_contBull = (tod_raw_bullCharge and not na(tod_sc_lastRetBullBar) and (bar_index - 1 - tod_sc_lastRetBullBar) <= tod_SUDDEN_PROX) or ((tod_raw_bullTNT or tod_raw_bullTNT2) and not na(tod_sc_lastBullChargeBar) and (bar_index - tod_sc_lastBullChargeBar) <= tod_SUDDEN_PROX) or (tod_raw_bullCharge and ((not na(tod_sc_lastBullTNTBar) and (bar_index - 1 - tod_sc_lastBullTNTBar) <= tod_SUDDEN_PROX) or (not na(tod_sc_lastBullTNT2Bar) and (bar_index - 1 - tod_sc_lastBullTNT2Bar) <= tod_SUDDEN_PROX)))
    bool tod_raw_contBear = (tod_raw_bearCharge and not na(tod_sc_lastRetBearBar) and (bar_index - 1 - tod_sc_lastRetBearBar) <= tod_SUDDEN_PROX) or ((tod_raw_bearTNT or tod_raw_bearTNT2) and not na(tod_sc_lastBearChargeBar) and (bar_index - tod_sc_lastBearChargeBar) <= tod_SUDDEN_PROX) or (tod_raw_bearCharge and ((not na(tod_sc_lastBearTNTBar) and (bar_index - 1 - tod_sc_lastBearTNTBar) <= tod_SUDDEN_PROX) or (not na(tod_sc_lastBearTNT2Bar) and (bar_index - 1 - tod_sc_lastBearTNT2Bar) <= tod_SUDDEN_PROX)))
    if tod_raw_bullCharge
        tod_sc_lastBullChargeBar := bar_index - 1
    if tod_raw_bearCharge
        tod_sc_lastBearChargeBar := bar_index - 1
    if tod_raw_retBullTNT or tod_raw_retBullTNT2
        tod_sc_lastRetBullBar := bar_index
    if tod_raw_retBearTNT or tod_raw_retBearTNT2
        tod_sc_lastRetBearBar := bar_index
    if tod_raw_bullTNT
        tod_sc_lastBullTNTBar := bar_index
    if tod_raw_bearTNT
        tod_sc_lastBearTNTBar := bar_index
    if tod_raw_bullTNT2
        tod_sc_lastBullTNT2Bar := bar_index
    if tod_raw_bearTNT2
        tod_sc_lastBearTNT2Bar := bar_index

    // Consolidated detection (TNT OD v3 parity)
    bool tod_det_bullTNT = tod_raw_bullTNT or tod_raw_bullTNT2 or tod_raw_superTNTBull
    bool tod_det_bearTNT = tod_raw_bearTNT or tod_raw_bearTNT2 or tod_raw_superTNTBear
    bool tod_det_bullNapalm = tod_raw_napalmBull or tod_raw_bullCharge
    bool tod_det_bearNapalm = tod_raw_napalmBear or tod_raw_bearCharge
    bool tod_det_contBull = tod_raw_contBull, bool tod_det_contBear = tod_raw_contBear
    [tod_det_bullTNT, tod_det_bearTNT, tod_det_bullNapalm, tod_det_bearNapalm, tod_det_contBull, tod_det_contBear, tod_raw_retBullTNT, tod_raw_retBullTNT2, tod_raw_retBearTNT, tod_raw_retBearTNT2, tod_disp_range, tod_isBullishFVG, tod_isBearishFVG]

[tod_det_bullTNT, tod_det_bearTNT, tod_det_bullNapalm, tod_det_bearNapalm, tod_det_contBull, tod_det_contBear, tod_raw_retBullTNT, tod_raw_retBullTNT2, tod_raw_retBearTNT, tod_raw_retBearTNT2, tod_disp_range, tod_isBullishFVG, tod_isBearishFVG] = f_tod_engine()

// ══════════════════════════════════════════════════════════════════════════════
// IGNITE — TNT OD v3 parity: (TNT or NPM) + Continuous same visual bar
// ══════════════════════════════════════════════════════════════════════════════
bool ign_tc_bull = tod_det_bullTNT and tod_det_contBull, bool ign_tc_bear = tod_det_bearTNT and tod_det_contBear
bool ign_nc_bull = tod_det_bullNapalm and (tod_det_contBull[1] == true), bool ign_nc_bear = tod_det_bearNapalm and (tod_det_contBear[1] == true)
bool det_igniteBull = ign_tc_bull or ign_nc_bull, bool det_igniteBear = ign_tc_bear or ign_nc_bear

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: B2B PUP v5.4 ENGINE G (tnt_ prefix; for B2B NAPALM) — verbatim port
// ══════════════════════════════════════════════════════════════════════════════
grpTNT = "── TNT Engine (B2B Napalm) ──"
int tnt_SENS = input.int(100, "Sensitivity", minval=1, group=grpTNT)
int tnt_SWING_LEN = input.int(10, "Swing Length", minval=3, group=grpTNT)
int tnt_DISP_STD_X = input.int(5, "Disp Std Dev Mult", minval=0, group=grpTNT)
int tnt_SUDDEN_PROX = input.int(3, "Sudden Change Max Bars", minval=1, group=grpTNT)
int tnt_MAX_ZONES = input.int(30, "Max TNT Zones", minval=1, maxval=200, group=grpTNT, tooltip="How many active TNT zones to keep tracking for Napalm/Charge/Return scans.")
float tnt_RET_PCT = input.float(100.0, "Return to TNT %", minval=-10, step=0.1, group=grpTNT)

int tnt_EMA_FAST = tnt_SENS, int tnt_EMA_SLOW = tnt_SENS + 13
float tnt_ATR_VAL = ta.atr(200), float tnt_ATR_MULT = 3.5, float tnt_ATR_MIN = 0.5
int tnt_MIN_SIG_GAP = tnt_EMA_SLOW, int tnt_CW = tnt_EMA_SLOW * 2
float tnt_ef = ta.ema(close, tnt_EMA_FAST), float tnt_es = ta.ema(close, tnt_EMA_SLOW)

type tnt_SP
    float val = na
    int idx = na
    bool crossed = false
type TntZone
    int confirmIdx
    float upper
    float lower
    float level
    bool isBull
    bool isActive = true
    bool returnFired = false
type ChargeLvl
    float level
    bool isBull
    int barIdx
    bool violated = false
f_tnt_tok(int a, int b, int c) =>
    int mn = math.min(a, math.min(b, c)), int mx = math.max(a, math.max(b, c))
    mx - mn <= tnt_CW and mn > 0
f_tnt_zov(float u1, float l1, float u2, float l2) => not na(u1) and not na(u2) and u1 >= l2 and u2 >= l1
float tnt_vMed = ta.median(volume, tnt_EMA_SLOW), float tnt_eSl = tnt_ef - tnt_ef[5], float tnt_rsi = ta.rsi(close, 14)
f_tnt_sb(float vV, float vU, float vL, float aU, float aL) => vV > tnt_vMed * tnt_EMA_SLOW * 0.5 and tnt_eSl > 0 and tnt_rsi < 80 and (math.min(vU - vL, aU - aL) > 0 ? math.max(0, math.min(vU, aU) - math.max(vL, aL)) / math.min(vU - vL, aU - aL) > 0.3 : false)
f_tnt_ss(float vV, float vU, float vL, float aU, float aL) => vV > tnt_vMed * tnt_EMA_SLOW * 0.5 and tnt_eSl < 0 and tnt_rsi > 20 and (math.min(vU - vL, aU - aL) > 0 ? math.max(0, math.min(vU, aU) - math.max(vL, aL)) / math.min(vU - vL, aU - aL) > 0.3 : false)
f_b2bNapalmEngine() =>
    bool tnt_vbc = ta.crossover(tnt_ef, tnt_es) and conf, bool tnt_vsc = ta.crossunder(tnt_ef, tnt_es) and conf
    var float tnt_vbu = na, var float tnt_vbl = na, var float tnt_vbv = na, var bool tnt_vbn = false
    var float tnt_vsu = na, var float tnt_vsl = na, var float tnt_vsv = na, var bool tnt_vsn = false
    float tnt_ahi = ta.highest(tnt_ATR_VAL, 200) * 2.0
    if tnt_vbc
        float cv = 0.0, float ol = low
        for i = 1 to tnt_EMA_SLOW
            if low[i] <= ol
                ol := low[i]
            cv += volume[i]
        float s = math.min(open, close)
        s := (s - ol) < tnt_ahi * 0.5 ? ol + tnt_ahi * 0.5 : s
        tnt_vbu := s, tnt_vbl := ol, tnt_vbv := cv, tnt_vbn := true
    else
        tnt_vbn := false
    if tnt_vsc
        float cv = 0.0, float oh = high
        for i = 1 to tnt_EMA_SLOW
            if high[i] >= oh
                oh := high[i]
            cv += volume[i]
        float s = math.max(open, close)
        s := (oh - s) < tnt_ahi * 0.5 ? oh - tnt_ahi * 0.5 : s
        tnt_vsu := oh, tnt_vsl := s, tnt_vsv := cv, tnt_vsn := true
    else
        tnt_vsn := false

    var int tnt_swSt = 0
    var tnt_SP tnt_swH = tnt_SP.new(na, na), var tnt_SP tnt_swL = tnt_SP.new(na, na)
    float tnt_swU = ta.highest(high, tnt_SWING_LEN), float tnt_swLL = ta.lowest(low, tnt_SWING_LEN)
    tnt_swSt := high[tnt_SWING_LEN] > tnt_swU ? 0 : low[tnt_SWING_LEN] < tnt_swLL ? 1 : tnt_swSt
    if tnt_swSt == 0 and tnt_swSt[1] != 0
        tnt_swH := tnt_SP.new(high[tnt_SWING_LEN], bar_index[tnt_SWING_LEN])
    if tnt_swSt == 1 and tnt_swSt[1] != 1
        tnt_swL := tnt_SP.new(low[tnt_SWING_LEN], bar_index[tnt_SWING_LEN])
    var float tnt_abu = na, var float tnt_abl = na, var int tnt_abi = na, var float tnt_apu = na, var float tnt_apl = na, var int tnt_api = na, var bool tnt_abn = false
    var float tnt_asu = na, var float tnt_asl = na, var int tnt_asi = na, var float tnt_aspu = na, var float tnt_aspl = na, var int tnt_aspi = na, var bool tnt_asn = false
    if close > tnt_swH.val and not tnt_swH.crossed and conf and not na(tnt_swH.val)
        tnt_swH.crossed := true
        float oL = low[1], float oH = high[1], int oI = bar_index - 1
        int lb = bar_index - tnt_swH.idx
        if lb > 1
            for i = 1 to lb - 1
                if open[i] > close[i] and low[i] <= oL
                    oL := low[i], oH := high[i], oI := bar_index - i
        tnt_apu := tnt_abu, tnt_apl := tnt_abl, tnt_api := tnt_abi
        tnt_abu := oH, tnt_abl := oL, tnt_abi := oI
        tnt_abn := not na(tnt_apu) and oI <= nz(tnt_api, 0) + tnt_EMA_SLOW and oH > nz(tnt_apl, na) and oL < nz(tnt_apu, na)
    else
        tnt_abn := false
    if close < tnt_swL.val and not tnt_swL.crossed and conf and not na(tnt_swL.val)
        tnt_swL.crossed := true
        float oL = low[1], float oH = high[1], int oI = bar_index - 1
        int lb = bar_index - tnt_swL.idx
        if lb > 1
            for i = 1 to lb - 1
                if open[i] < close[i] and high[i] >= oH
                    oH := high[i], oL := low[i], oI := bar_index - i
        tnt_aspu := tnt_asu, tnt_aspl := tnt_asl, tnt_aspi := tnt_asi
        tnt_asu := oH, tnt_asl := oL, tnt_asi := oI
        tnt_asn := not na(tnt_aspl) and oI <= nz(tnt_aspi, 0) + tnt_EMA_SLOW and oL < nz(tnt_aspu, na) and oH > nz(tnt_aspl, na)
    else
        tnt_asn := false

    var float tnt_fbu = na, var float tnt_fbl = na, var bool tnt_fba = false, var bool tnt_fbpn = false
    var float tnt_fsu = na, var float tnt_fsl = na, var bool tnt_fsa = false, var bool tnt_fspn = false
    var tnt_SP tnt_fswH = tnt_SP.new(na, na), var tnt_SP tnt_fswL = tnt_SP.new(na, na)
    if tnt_swSt == 0 and tnt_swSt[1] != 0
        tnt_fswH := tnt_SP.new(high[tnt_SWING_LEN], bar_index[tnt_SWING_LEN])
    if tnt_swSt == 1 and tnt_swSt[1] != 1
        tnt_fswL := tnt_SP.new(low[tnt_SWING_LEN], bar_index[tnt_SWING_LEN])
    if close > tnt_fswH.val and not tnt_fswH.crossed and conf and not na(tnt_fswH.val)
        tnt_fswH.crossed := true
        float bB = math.min(open[1], close[1]), float bT = math.max(open[1], close[1])
        int lb = bar_index - tnt_fswH.idx
        if lb > 1
            for i = 1 to lb - 1
                if math.min(open[i], close[i]) < bB
                    bB := math.min(open[i], close[i]), bT := math.max(open[i], close[i])
        float os = math.abs(bT - bB)
        if os <= tnt_ATR_VAL * tnt_ATR_MULT and os > tnt_ATR_VAL * tnt_ATR_MIN
            tnt_fbu := bT, tnt_fbl := bB, tnt_fba := true
    if close < tnt_fswL.val and not tnt_fswL.crossed and conf and not na(tnt_fswL.val)
        tnt_fswL.crossed := true
        float bT = math.max(open[1], close[1]), float bB = math.min(open[1], close[1])
        int lb = bar_index - tnt_fswL.idx
        if lb > 1
            for i = 1 to lb - 1
                if math.max(open[i], close[i]) > bT
                    bT := math.max(open[i], close[i]), bB := math.min(open[i], close[i])
        float os = math.abs(bT - bB)
        if os <= tnt_ATR_VAL * tnt_ATR_MULT and os > tnt_ATR_VAL * tnt_ATR_MIN
            tnt_fsu := bT, tnt_fsl := bB, tnt_fsa := true
    tnt_fbpn := false
    if tnt_fba and conf
        if close < tnt_fbl
            tnt_fba := false
        else if low[1] < tnt_fbu and low[1] > tnt_fbl and close > open and close > high[1]
            tnt_fbpn := true
    tnt_fspn := false
    if tnt_fsa and conf
        if close > tnt_fsu
            tnt_fsa := false
        else if high[1] > tnt_fsl and high[1] < tnt_fsu and close < open and close < low[1]
            tnt_fspn := true

    var int tnt_vcb = 0, var int tnt_acb = 0, var int tnt_fcb = 0, var int tnt_vcs = 0, var int tnt_acs = 0, var int tnt_fcs = 0
    var float tnt_vcu = na, var float tnt_vcl = na, var float tnt_vdu = na, var float tnt_vdl = na
    if tnt_vbn
        tnt_vcb := bar_index, tnt_vcu := tnt_vbu, tnt_vcl := tnt_vbl
    if tnt_vsn
        tnt_vcs := bar_index, tnt_vdu := tnt_vsu, tnt_vdl := tnt_vsl
    if tnt_abn
        tnt_acb := bar_index
    if tnt_asn
        tnt_acs := bar_index
    if tnt_fbpn
        tnt_fcb := bar_index
    if tnt_fspn
        tnt_fcs := bar_index

    var int tnt_lBSB = 0, var int tnt_lSSB = 0
    bool tnt_bConf = f_tnt_tok(tnt_vcb, tnt_acb, tnt_fcb) and f_tnt_zov(tnt_vcu, tnt_vcl, tnt_abu, tnt_abl)
    bool tnt_sConf = f_tnt_tok(tnt_vcs, tnt_acs, tnt_fcs) and f_tnt_zov(tnt_vdu, tnt_vdl, tnt_asu, tnt_asl)
    bool det_bullTNT_raw = tnt_bConf and f_tnt_sb(nz(tnt_vbv), nz(tnt_vcu), nz(tnt_vcl), nz(tnt_abu), nz(tnt_abl)) and conf and (bar_index - tnt_lBSB) > tnt_MIN_SIG_GAP
    bool det_bearTNT_raw = tnt_sConf and f_tnt_ss(nz(tnt_vsv), nz(tnt_vdu), nz(tnt_vdl), nz(tnt_asu), nz(tnt_asl)) and conf and (bar_index - tnt_lSSB) > tnt_MIN_SIG_GAP
    if det_bullTNT_raw
        tnt_lBSB := bar_index
    if det_bearTNT_raw
        tnt_lSSB := bar_index

    // ── ZONE TRACKING (for Napalm + Charge + Return) ──

    var bull_tnt_zones = array.new<TntZone>(0)
    var bear_tnt_zones = array.new<TntZone>(0)

    if det_bullTNT_raw
        float oU = math.min(nz(tnt_vcu, high), nz(tnt_abu, high))
        float oL = math.max(nz(tnt_vcl, low), nz(tnt_abl, low))
        float lvl = math.avg(oU, oL)
        bull_tnt_zones.push(TntZone.new(bar_index, oU, oL, lvl, true, true, false))
    if det_bearTNT_raw
        float oU = math.min(nz(tnt_vdu, high), nz(tnt_asu, high))
        float oL = math.max(nz(tnt_vdl, low), nz(tnt_asl, low))
        float lvl = math.avg(oU, oL)
        bear_tnt_zones.push(TntZone.new(bar_index, oU, oL, lvl, false, true, false))

    // Invalidate zones whose levels close has fully broken
    if bull_tnt_zones.size() > 0
        for i = bull_tnt_zones.size() - 1 to 0
            if i < bull_tnt_zones.size()
                TntZone z = bull_tnt_zones.get(i)
                if z.isActive and close < z.lower
                    z.isActive := false
    if bear_tnt_zones.size() > 0
        for i = bear_tnt_zones.size() - 1 to 0
            if i < bear_tnt_zones.size()
                TntZone z = bear_tnt_zones.get(i)
                if z.isActive and close > z.upper
                    z.isActive := false

    while bull_tnt_zones.size() > tnt_MAX_ZONES
        bull_tnt_zones.shift()
    while bear_tnt_zones.size() > tnt_MAX_ZONES
        bear_tnt_zones.shift()

    // Return-to-TNT
    bool det_retBullTNT = false
    bool det_retBearTNT = false
    if conf
        if bull_tnt_zones.size() > 0
            for i = bull_tnt_zones.size() - 1 to 0
                if i < bull_tnt_zones.size()
                    TntZone z = bull_tnt_zones.get(i)
                    if z.isActive and not z.returnFired and bar_index > z.confirmIdx
                        float zH = z.upper - z.lower
                        float retLvl = z.lower + zH * (tnt_RET_PCT / 100.0)
                        if low <= retLvl and close > z.lower
                            z.returnFired := true
                            det_retBullTNT := true
        if bear_tnt_zones.size() > 0
            for i = bear_tnt_zones.size() - 1 to 0
                if i < bear_tnt_zones.size()
                    TntZone z = bear_tnt_zones.get(i)
                    if z.isActive and not z.returnFired and bar_index > z.confirmIdx
                        float zH = z.upper - z.lower
                        float retLvl = z.upper - zH * (tnt_RET_PCT / 100.0)
                        if high >= retLvl and close < z.upper
                            z.returnFired := true
                            det_retBearTNT := true

    // TNT internal displacement
    float tnt_dr = math.abs(open - close), float tnt_ds = ta.stdev(tnt_dr, 100), float tnt_dt = tnt_ds * tnt_DISP_STD_X
    bool tnt_dBull = conf and tnt_dr[1] > tnt_dt[1] and low > high[2] and close[1] > open[1]
    bool tnt_dBear = conf and tnt_dr[1] > tnt_dt[1] and high < low[2] and close[1] < open[1]

    // ── NAPALM (scans ALL active opposing zones) ──
    bool det_bullNapalm = false
    bool det_bearNapalm = false
    if conf and tnt_dBull and bear_tnt_zones.size() > 0
        for i = bear_tnt_zones.size() - 1 to 0
            if i < bear_tnt_zones.size()
                TntZone z = bear_tnt_zones.get(i)
                if z.isActive and low[1] > z.level
                    det_bullNapalm := true
                    break
    if conf and tnt_dBear and bull_tnt_zones.size() > 0
        for i = bull_tnt_zones.size() - 1 to 0
            if i < bull_tnt_zones.size()
                TntZone z = bull_tnt_zones.get(i)
                if z.isActive and high[1] < z.level
                    det_bearNapalm := true
                    break

    // ── CHARGE (multi-level array) ──

    var charge_lvls = array.new<ChargeLvl>(0)
    if det_bullTNT_raw
        float lvl = math.avg(math.min(nz(tnt_vcu, high), nz(tnt_abu, high)), math.max(nz(tnt_vcl, low), nz(tnt_abl, low)))
        charge_lvls.push(ChargeLvl.new(lvl, true, bar_index, false))
    if det_bearTNT_raw
        float lvl = math.avg(math.min(nz(tnt_vdu, high), nz(tnt_asu, high)), math.max(nz(tnt_vdl, low), nz(tnt_asl, low)))
        charge_lvls.push(ChargeLvl.new(lvl, false, bar_index, false))

    bool det_bullCharge = false
    bool det_bearCharge = false
    if conf and tnt_dBull and charge_lvls.size() > 0
        for i = charge_lvls.size() - 1 to 0
            if i < charge_lvls.size()
                ChargeLvl cl = charge_lvls.get(i)
                if not cl.isBull and not cl.violated and close[1] > cl.level
                    cl.violated := true
                    det_bullCharge := true
                    break
    if conf and tnt_dBear and charge_lvls.size() > 0
        for i = charge_lvls.size() - 1 to 0
            if i < charge_lvls.size()
                ChargeLvl cl = charge_lvls.get(i)
                if cl.isBull and not cl.violated and close[1] < cl.level
                    cl.violated := true
                    det_bearCharge := true
                    break

    while charge_lvls.size() > 100
        charge_lvls.shift()

    // Backwards-compat aggregates → B2B NAPALM
    bool det_bullNapCons = det_bullNapalm or det_bullCharge
    bool det_bearNapCons = det_bearNapalm or det_bearCharge
    bool det_b2bBullNapalm = det_bullNapCons and nz(det_bullNapCons[1])
    bool det_b2bBearNapalm = det_bearNapCons and nz(det_bearNapCons[1])
    [det_b2bBullNapalm, det_b2bBearNapalm]

[det_b2bBullNapalm, det_b2bBearNapalm] = f_b2bNapalmEngine()

// ══════════════════════════════════════════════════════════════════════════════
// NAGASAKI — SQUARIFY v3 parity (all-time-high volume on bar[0])
// ══════════════════════════════════════════════════════════════════════════════
var float maxVol = 0.0
bool isNagasaki = false
if bar_index == 0
    maxVol := volume
else if volume > maxVol
    isNagasaki := true
    maxVol := volume
sigNagasaki = isNagasaki

// ══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════  v2 ADDITIONS  ══════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════
// Pentagon (RVOL Reg@Time middle tier — needed by Unified Combo comboSets)
bool det_Pentagon = conf and (rv_relVolRatio >= th_1x) and (rv_relVolRatio <= th_wtc)

// ══════════════════════════════════════════════════════════════════════════════
// TNT OD v3 — TIER 2 ENRICHED (TNT ENR / NPM ENR) + v3 CONDITIONAL GATE
// Verbatim port. u5 atoms that are token-identical to engines already in this
// file are REUSED: u5_RVOL1x/GS/MOAB/SAAB/Kratos ≡ det_* (same Pre-Mythos curve),
// u5_Pentagon/WTC/Hiroshima ≡ det_* (same curves + same relativeVolume ratio),
// u5_PUP/PPD ≡ sigPUP/sigPPD (3%/10 defaults), u5_PBJ ≡ sigBullPBJ/sigBearPBJ
// (identical zoo defaults), u5_Nagasaki ≡ sigNagasaki, u5_FAUNA/DYNAMITE ≡ ported.
// ══════════════════════════════════════════════════════════════════════════════
// WMD + HV1000 (TNT OD v3 L750, L752-753)
bool u5_WMD = det_Pentagon or det_WTC or det_Hiroshima or sigNagasaki
bool u5_HV1000 = conf and volume >= ta.highest(volume, 1000)[1]

// CS1 (FVG Combo) + its own GZI sub-engine (TNT OD v3 L897-945; dist=7, 63d tier, body 0.85)
type u5_fvg_s
    float mx
    float mn
    bool bull
    int t
    int idx
    bool hv
float u5_gz_v1 = volume[1], float u5_hv5k = ta.highest(volume, 5000)[1], float u5_hv252 = ta.highest(volume, 252)[1], float u5_hv63 = ta.highest(volume, 63)[1]
bool u5_gz_isHV = (u5_gz_v1 == u5_hv5k) or (u5_gz_v1 == u5_hv252) or (u5_gz_v1 == u5_hv63)
float u5_gz_thresh = ta.cum((high - low) / low) / bar_index
bool u5_gz_bFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > u5_gz_thresh
bool u5_gz_sFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / high > u5_gz_thresh
var u5_gz_fvgs = array.new<u5_fvg_s>(0)
var int u5_gz_lastT = 0
bool u5_gz_bullGZI = false, bool u5_gz_bearGZI = false, bool u5_gz_bullHV = false, bool u5_gz_bearHV = false
if conf and u5_gz_bFVG and time != u5_gz_lastT
    float mx = low, float mn = high[2]
    if u5_gz_isHV
        u5_gz_bullHV := true
    if u5_gz_fvgs.size() > 0
        for i = 0 to u5_gz_fvgs.size() - 1
            u5_fvg_s e = u5_gz_fvgs.get(i)
            if e.bull and bar_index - e.idx <= 7 and (math.max(e.mn, mn) < math.min(e.mx, mx) or (math.max(e.mn, mn) <= math.min(e.mx, mx) and e.hv and u5_gz_isHV))
                u5_gz_bullGZI := true
                break
    u5_gz_fvgs.unshift(u5_fvg_s.new(mx, mn, true, time, bar_index, u5_gz_isHV))
    u5_gz_lastT := time
if conf and u5_gz_sFVG and time != u5_gz_lastT
    float mx = low[2], float mn = high
    if u5_gz_isHV
        u5_gz_bearHV := true
    if u5_gz_fvgs.size() > 0
        for i = 0 to u5_gz_fvgs.size() - 1
            u5_fvg_s e = u5_gz_fvgs.get(i)
            if not e.bull and bar_index - e.idx <= 7 and (math.max(e.mn, mn) < math.min(e.mx, mx) or (math.max(e.mn, mn) <= math.min(e.mx, mx) and e.hv and u5_gz_isHV))
                u5_gz_bearGZI := true
                break
    u5_gz_fvgs.unshift(u5_fvg_s.new(mx, mn, false, time, bar_index, u5_gz_isHV))
    u5_gz_lastT := time
if u5_gz_fvgs.size() > 0
    for i = u5_gz_fvgs.size() - 1 to 0
        u5_fvg_s g = u5_gz_fvgs.get(i)
        if (g.bull and close < g.mn) or (not g.bull and close > g.mx)
            u5_gz_fvgs.remove(i)
if u5_gz_fvgs.size() > 50
    u5_gz_fvgs.pop()

float u5_cs_bp1 = high[1] - low[1] == 0 ? 0.0 : math.abs(close[1] - open[1]) / (high[1] - low[1])
bool u5_cs_vb = u5_cs_bp1 >= 0.85
bool u5_CS1_Bull = conf and u5_cs_vb and (u5_gz_bullHV or u5_gz_bullGZI) and (nz(det_SAAB[1]) or nz(det_RVOL1xB[1]) or nz(det_GrandSlam[1]) or nz(det_Pentagon[1]) or nz(det_WTC[1]) or nz(det_Hiroshima[1]) or nz(sigNagasaki[1]))
bool u5_CS1_Bear = conf and u5_cs_vb and (u5_gz_bearHV or u5_gz_bearGZI) and (nz(det_Kratos[1]) or nz(det_RVOL1xR[1]) or nz(det_MOAB[1]) or nz(det_Pentagon[1]) or nz(det_WTC[1]) or nz(det_Hiroshima[1]) or nz(sigNagasaki[1]))

// ── HCT ENGINE (Displacement #4, TNT OD v3 L1041-1118; its OWN curves — do NOT unify) ──
grpHCT = "★ HCT (Displacement #4 — v3 gate) ★"
float hct_disp_strength = input.float(6.0, "HCT Disp σ-mult", minval=1.0, step=0.5, group=grpHCT, tooltip="HCT's own displacement engine — INDEPENDENT of every other displacement. Feeds the v3 gate (→ TNT ENR / NPM ENR / S26/S27).")
int hct_disp_lookback = input.int(100, "HCT Disp Lookback", minval=10, group=grpHCT)
float hct_threshPct = input.float(2.0, "HCT FVG Threshold % (when Auto OFF)", minval=0, maxval=100, step=0.1, group=grpHCT)
bool hct_auto = input.bool(true, "HCT Auto FVG Threshold", group=grpHCT)
f_hct_1x(int _s) => _s <= 10 ? 38.0 : _s <= 15 ? 33.0 : _s <= 30 ? 28.0 : _s <= 45 ? 23.0 : _s <= 60 ? 20.0 : _s <= 120 ? 19.0 : _s <= 180 ? 17.0 : _s <= 240 ? 16.0 : _s <= 300 ? 15.0 : _s <= 360 ? 14.0 : _s <= 420 ? 12.0 : _s <= 480 ? 11.0 : _s <= 540 ? 10.0 : _s <= 600 ? 10.0 : _s <= 900 ? 8.4 : _s <= 1800 ? 6.9 : _s <= 3600 ? 5.9 : _s <= 7200 ? 3.0 : 1.8
f_hct_gs(int _s) => _s <= 10 ? 114.0 : _s <= 15 ? 99.0 : _s <= 30 ? 84.0 : _s <= 45 ? 69.0 : _s <= 60 ? 35.0 : _s <= 300 ? 35.0 : _s <= 600 ? 25.0 : _s <= 900 ? 20.0 : _s <= 3600 ? 10.0 : 8.0
f_hct_wtc(int _s) => f_hct_1x(_s) * 2.0
f_hct_hiro(int _s) => f_hct_gs(_s)
float hct_th_1x = f_hct_1x(tfSec)
float hct_th_gs = f_hct_gs(tfSec)
float hct_th_wtc = f_hct_wtc(tfSec)
float hct_th_hiro = f_hct_hiro(tfSec)
bool hct_BullRVOL1x = rv_baseBull and rv_normPrice >= hct_th_1x and rv_normPrice < hct_th_gs
bool hct_BearRVOL1x = rv_baseBear and rv_normPrice >= hct_th_1x and rv_normPrice < hct_th_gs
bool hct_GrandSlam = rv_baseBull and rv_normPrice >= hct_th_gs
bool hct_MOAB = rv_baseBear and rv_normPrice >= hct_th_gs
bool hct_Pentagon = conf and rv_relVolRatio >= hct_th_1x and rv_relVolRatio <= hct_th_wtc
bool hct_WTC = conf and rv_relVolRatio > hct_th_wtc and rv_relVolRatio <= hct_th_hiro
bool hct_Hiroshima = conf and rv_relVolRatio > hct_th_hiro
float hct_thresh = hct_auto ? ta.cum((high - low) / low) / bar_index : hct_threshPct / 100.0
bool hct_bFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > hct_thresh
bool hct_sFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / high > hct_thresh
float hct_barRange = high[1] - low[1]
float hct_rangeStdev = ta.stdev(high - low, hct_disp_lookback)
bool hct_dispCandleMet = hct_barRange > hct_disp_strength * nz(hct_rangeStdev[1])
bool hct_dispBull = conf and hct_dispCandleMet and (close[1] > open[1]) and hct_bFVG
bool hct_dispBear = conf and hct_dispCandleMet and (close[1] < open[1]) and hct_sFVG
bool hct_noDisp = (not hct_dispBull) and (not hct_dispBear)
bool hct_groupA_Bull = hct_BullRVOL1x or hct_GrandSlam
bool hct_groupA_Bear = hct_BearRVOL1x or hct_MOAB
bool hct_groupB = hct_Pentagon or hct_WTC or hct_Hiroshima
bool hct_baseYY = (hct_groupA_Bull or hct_groupA_Bear) and hct_groupB
bool hct_baseN = sigNagasaki and (hct_groupA_Bull or hct_groupA_Bear)
bool hct_baseNV = sigNagasaki and hct_groupB
bool hct_baseT = sigNagasaki and (hct_groupA_Bull or hct_groupA_Bear) and hct_groupB
bool hct_baseNH = (hct_Pentagon and hct_WTC) or (hct_Pentagon and hct_Hiroshima) or (hct_WTC and hct_Hiroshima)
bool hct_baseAny = hct_baseYY or hct_baseN or hct_baseNV or hct_baseT or hct_baseNH
bool hct_bull = hct_baseAny and hct_dispBull
bool hct_bear = hct_baseAny and hct_dispBear

// ── UC placeholder (TNT OD v3 L1132-1135, ported as-is for v3 parity) ──
int uc_bull_count = (u5_FAUNABull ? 1 : 0) + ((det_RVOL1xB or det_GrandSlam or det_SAAB) ? 1 : 0) + (u5_WMD ? 1 : 0) + (sigPUP ? 1 : 0) + (u5_CS1_Bull ? 1 : 0)
int uc_bear_count = (u5_FAUNABear ? 1 : 0) + ((det_RVOL1xR or det_MOAB or det_Kratos) ? 1 : 0) + (u5_WMD ? 1 : 0) + (sigPPD ? 1 : 0) + (u5_CS1_Bear ? 1 : 0)
bool uc_bull = conf and uc_bull_count >= 2
bool uc_bear = conf and uc_bear_count >= 2

// ── NagAny (TNT OD v3 L1142-1143) ──
bool nagAny_bull = conf and sigNagasaki and (det_Pentagon or det_WTC or det_Hiroshima or det_RVOL1xB or det_GrandSlam or det_SAAB)
bool nagAny_bear = conf and sigNagasaki and (det_Pentagon or det_WTC or det_Hiroshima or det_RVOL1xR or det_MOAB or det_Kratos)

// ── Gate displacement (Engine #5) + master v3 gate (TNT OD v3 L1153-1168) ──
grpGate = "★ v3 GATE (→ TNT ENR / NPM ENR / S26/S27) ★"
en_newGate = input.bool(true, "✓ Apply v3 conditional gate", group=grpGate, tooltip="TNT OD v3 parity: TNT ENR / NPM ENR (and therefore S26/S27) additionally require ANY of: RVOL 1x / Grand Slam (MOAB) / UC / Nagasaki+Any / HCT / Displacement ≥ gate σ-mult. OFF = legacy v2 behavior.")
float gateStdMult = input.float(6.5, "Gate Displacement Std Dev Mult (Engine #5)", minval=1.0, step=0.1, group=grpGate, tooltip="σ-multiplier DEDICATED to the v3 gate. Reuses the TNT OD Engine #1 stdev length (100). Affects ONLY the gate (→ TNT ENR / NPM ENR / S26/S27).")
float gate_disp_std = ta.stdev(tod_disp_range, tod_DISP_STD_LEN)
float gate_disp_threshold = gate_disp_std * gateStdMult
bool gate_disp_bull = conf and (tod_disp_range[1] > nz(gate_disp_threshold[1])) and tod_isBullishFVG and (close[1] > open[1])
bool gate_disp_bear = conf and (tod_disp_range[1] > nz(gate_disp_threshold[1])) and tod_isBearishFVG and (close[1] < open[1])
bool gate_bull_raw = det_RVOL1xB or det_GrandSlam or uc_bull or nagAny_bull or hct_bull or gate_disp_bull
bool gate_bear_raw = det_RVOL1xR or det_MOAB or uc_bear or nagAny_bear or hct_bear or gate_disp_bear
bool gate_bull = (not en_newGate) or gate_bull_raw
bool gate_bear = (not en_newGate) or gate_bear_raw

// ── Suppression combos (TNT OD v3 L1175-1184, L1216-1219) ──
grpT2 = "Tier 2 Signals (enrichment required)"
en_rcNTBull = input.bool(true, "✓ RC NPM+TNT Bull", group=grpT2, tooltip="Rare Combo: Napalm AND TNT on the same visual bar (suppresses TNT/NPM ENR when it fires). Offset = -1.")
en_rcNTBear = input.bool(true, "✓ RC NPM+TNT Bear", group=grpT2, tooltip="Bearish mirror.")
en_t2tntBull = input.bool(true, "✓ TNT Enriched Bull", group=grpT2, tooltip="Raw TNT detection PLUS at least one enrichment co-signal on same bar (RVOL1x / GrandSlam / PUP / CS1 / FAUNA / WMD / HV1000 / DYNAMITE). Hard-gated — never fires without enrichment. Offset = 0.")
en_t2tntBear = input.bool(true, "✓ TNT Enriched Bear", group=grpT2, tooltip="Bearish raw TNT + bearish enrichment co-signal. Hard-gated. Offset = 0.")
en_t2npmBull = input.bool(true, "✓ NPM Enriched Bull", group=grpT2, tooltip="Raw Napalm PLUS enrichment co-signal on visual bar 1 (bar[1] of detection time). Hard-gated. Offset = -1.")
en_t2npmBear = input.bool(true, "✓ NPM Enriched Bear", group=grpT2, tooltip="Bearish raw Napalm + bearish enrichment on visual bar 1. Hard-gated. Offset = -1.")
bool tod_det_bullRetTNT = tod_raw_retBullTNT or tod_raw_retBullTNT2
bool tod_det_bearRetTNT = tod_raw_retBearTNT or tod_raw_retBearTNT2
bool sig_rcNTBull = tod_det_bullNapalm and (tod_det_bullTNT[1] == true) and en_rcNTBull and nz(gate_bull[1])
bool sig_rcNTBear = tod_det_bearNapalm and (tod_det_bearTNT[1] == true) and en_rcNTBear and nz(gate_bear[1])
bool det_rcTRBull = tod_det_bullTNT and tod_det_bullRetTNT, bool det_rcTRBear = tod_det_bearTNT and tod_det_bearRetTNT
bool det_rcRNBull = tod_det_bullNapalm and (tod_det_bullRetTNT[1] == true), bool det_rcRNBear = tod_det_bearNapalm and (tod_det_bearRetTNT[1] == true)
bool det_pnBull = tod_det_bullNapalm and (sigBullPBJ[1] == true), bool det_pnBear = tod_det_bearNapalm and (sigBearPBJ[1] == true)
bool det_ptBull = tod_det_bullTNT and sigBullPBJ, bool det_ptBear = tod_det_bearTNT and sigBearPBJ
bool supp_bullNPM = sig_rcNTBull or det_rcRNBull or det_pnBull
bool supp_bearNPM = sig_rcNTBear or det_rcRNBear or det_pnBear
bool supp_bullTNT = sig_rcNTBull or det_rcTRBull or det_ptBull
bool supp_bearTNT = sig_rcNTBear or det_rcTRBear or det_ptBear

// ── Enrichment gates (TNT OD v3 L1228-1231; N vs N1 asymmetry preserved) ──
bool enrichBull_N = det_RVOL1xB or det_GrandSlam or sigPUP or u5_CS1_Bull or u5_FAUNABull or u5_WMD or u5_HV1000
bool enrichBear_N = det_RVOL1xR or det_MOAB or sigPPD or u5_CS1_Bear or u5_FAUNABear or u5_WMD or u5_HV1000
bool enrichBull_N1 = nz(det_RVOL1xB[1]) or nz(det_GrandSlam[1]) or nz(sigPUP[1]) or nz(u5_CS1_Bull[1]) or nz(u5_FAUNABull[1]) or nz(det_Pentagon[1]) or nz(det_WTC[1]) or nz(det_Hiroshima[1]) or nz(sigNagasaki[1]) or nz(u5_HV1000[1]) or det_dynamiteBull or nz(det_dynamiteBull[1])
bool enrichBear_N1 = nz(det_RVOL1xR[1]) or nz(det_MOAB[1]) or nz(sigPPD[1]) or nz(u5_CS1_Bear[1]) or nz(u5_FAUNABear[1]) or nz(det_Pentagon[1]) or nz(det_WTC[1]) or nz(det_Hiroshima[1]) or nz(sigNagasaki[1]) or nz(u5_HV1000[1]) or det_dynamiteBear or nz(det_dynamiteBear[1])

// ── THE TWO VISUAL PLOTS (TNT OD v3 L1260-1263) ──
// TNT ENR: boolean fires bar N → VISUAL bar N (offset 0)
// NPM ENR: boolean fires bar N → VISUAL bar N-1 (offset -1)
bool p_t2tntBull = tod_det_bullTNT and not supp_bullTNT and enrichBull_N and en_t2tntBull and gate_bull
bool p_t2tntBear = tod_det_bearTNT and not supp_bearTNT and enrichBear_N and en_t2tntBear and gate_bear
bool p_t2npmBull = tod_det_bullNapalm and not supp_bullNPM and enrichBull_N1 and en_t2npmBull and nz(gate_bull[1])
bool p_t2npmBear = tod_det_bearNapalm and not supp_bearNPM and enrichBear_N1 and en_t2npmBear and nz(gate_bear[1])

// ── S26/S27: B2B TNT ENR ↔ NPM ENR (VISUAL back-to-back, either order) ──
// Case B (NPM visual first, TNT visual second): both booleans fire the SAME bar
//   → visuals land on bar[1] (NPM) and bar[0] (TNT). Render offset 0.
// Case A (TNT visual first, NPM visual second): TNT fires, NPM fires 2 bars later
//   → visuals land on bar[2] (TNT) and bar[1] (NPM). Render offset -1.
bool enrB2B_bull_sameBar = p_t2tntBull and p_t2npmBull
bool enrB2B_bull_tntFirst = p_t2npmBull and nz(p_t2tntBull[2])
bool enrB2B_bear_sameBar = p_t2tntBear and p_t2npmBear
bool enrB2B_bear_tntFirst = p_t2npmBear and nz(p_t2tntBear[2])
bool det_S26 = enrB2B_bull_sameBar or enrB2B_bull_tntFirst
bool det_S27 = enrB2B_bear_sameBar or enrB2B_bear_tntFirst

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: HV+D DISPLACEMENT — HVD PBJ PPD parity (DRIVES ALL HVD PBJ PPD PLOTS)
// Adjustable displacement engine. Range type / stdev length / σ-multiplier below.
// ══════════════════════════════════════════════════════════════════════════════
grp_hvd1 = "Displacement — HV+D (→ ALL HVD PBJ PPD plots: CO, B2B HV+D, HV+D Momentum)"
d1_type = input.string("Open to Close", "HV+D Range Type", options=["Open to Close", "High to Low"], group=grp_hvd1)
d1_len = input.int(100, "HV+D Std Dev Length", minval=1, group=grp_hvd1)
d1_mult = input.float(5.0, "HV+D Std Dev Multiplier", minval=0.1, step=0.1, group=grp_hvd1, tooltip="σ-multiplier for the HV+D displacement engine. Drives EVERY HVD PBJ PPD detection plot.")
float d1_rng = d1_type == "Open to Close" ? math.abs(open - close) : high - low
float d1_std = ta.stdev(d1_rng, d1_len)
float d1_thresh = d1_std * d1_mult
bool d1_prevDisp = d1_rng[1] > d1_thresh[1]
bool d1_bullFVG = low > high[2] and close[1] > open[1]
bool d1_bearFVG = high < low[2] and close[1] < open[1]
bool d1_bull = conf and d1_prevDisp and d1_bullFVG
bool d1_bear = conf and d1_prevDisp and d1_bearFVG

grpHVBase = "HV+D: Base HV tiers (rolling highest-volume)"
bool ub50 = input.bool(true, "50-Bar", group=grpHVBase), bool ub75 = input.bool(true, "75-Bar", group=grpHVBase), bool ub100 = input.bool(true, "100-Bar", group=grpHVBase), bool ub150 = input.bool(true, "150-Bar", group=grpHVBase), bool ub200 = input.bool(true, "200-Bar", group=grpHVBase), bool ub250 = input.bool(true, "250-Bar", group=grpHVBase), bool ub300 = input.bool(true, "300-Bar", group=grpHVBase)
bool ub350 = input.bool(true, "350-Bar", group=grpHVBase), bool ub400 = input.bool(true, "400-Bar", group=grpHVBase), bool ub450 = input.bool(true, "450-Bar", group=grpHVBase), bool ub500 = input.bool(true, "500-Bar", group=grpHVBase), bool ub550 = input.bool(true, "550-Bar", group=grpHVBase), bool ub600 = input.bool(true, "600-Bar", group=grpHVBase), bool ub650 = input.bool(true, "650-Bar", group=grpHVBase), bool ub700 = input.bool(true, "700-Bar", group=grpHVBase), bool ub750 = input.bool(true, "750-Bar", group=grpHVBase), bool ub1000 = input.bool(true, "1000-Bar", group=grpHVBase)
useHEV = input.bool(true, "All-Time High Volume (HEV)", group=grpHVBase)
bool is50 = volume[1] == ta.highest(volume, 50)[1], bool is75 = volume[1] == ta.highest(volume, 75)[1], bool is100 = volume[1] == ta.highest(volume, 100)[1], bool is150 = volume[1] == ta.highest(volume, 150)[1], bool is200 = volume[1] == ta.highest(volume, 200)[1], bool is250 = volume[1] == ta.highest(volume, 250)[1], bool is300 = volume[1] == ta.highest(volume, 300)[1], bool is350 = volume[1] == ta.highest(volume, 350)[1], bool is400 = volume[1] == ta.highest(volume, 400)[1]
bool is450 = volume[1] == ta.highest(volume, 450)[1], bool is500 = volume[1] == ta.highest(volume, 500)[1], bool is550 = volume[1] == ta.highest(volume, 550)[1], bool is600 = volume[1] == ta.highest(volume, 600)[1], bool is650 = volume[1] == ta.highest(volume, 650)[1], bool is700 = volume[1] == ta.highest(volume, 700)[1], bool is750 = volume[1] == ta.highest(volume, 750)[1], bool is1000 = volume[1] == ta.highest(volume, 1000)[1]
var float maxVolEver = 0.0
bool isHEV = false
if volume[1] > maxVolEver
    maxVolEver := volume[1]
    isHEV := true
int baseRank = is1000 ? 1000 : is750 ? 750 : is700 ? 700 : is650 ? 650 : is600 ? 600 : is550 ? 550 : is500 ? 500 : is450 ? 450 : is400 ? 400 : is350 ? 350 : is300 ? 300 : is250 ? 250 : is200 ? 200 : is150 ? 150 : is100 ? 100 : is75 ? 75 : is50 ? 50 : 0
bool base_enabled = (ub50 and baseRank == 50) or (ub75 and baseRank == 75) or (ub100 and baseRank == 100) or (ub150 and baseRank == 150) or (ub200 and baseRank == 200) or (ub250 and baseRank == 250) or (ub300 and baseRank == 300) or (ub350 and baseRank == 350) or (ub400 and baseRank == 400) or (ub450 and baseRank == 450) or (ub500 and baseRank == 500) or (ub550 and baseRank == 550) or (ub600 and baseRank == 600) or (ub650 and baseRank == 650) or (ub700 and baseRank == 700) or (ub750 and baseRank == 750) or (ub1000 and baseRank == 1000)
bool hev_hit = useHEV and isHEV
bool base_hv_hit = hev_hit or (base_enabled and not isHEV)
bool hvd_fire_bull = base_hv_hit and d1_bull
bool hvd_fire_bear = base_hv_hit and d1_bear

// ── GZ1 / HV FVG (HVD params: adds 63d HV tier, dist=12) — for Unified Combo comboSets ──
grp_hgz = "Unified Combo — GZ1 / HV FVG"
hgz_auto = input.bool(true, "Auto FVG Threshold", group=grp_hgz)
hgz_threshPct = input.float(2, "FVG Threshold %", minval=0, maxval=100, step=0.1, group=grp_hgz)
hgz_dist = input.int(12, "GZ1 Max Bar Distance", minval=1, maxval=200, group=grp_hgz)
type hgz_fvg
    float mx
    float mn
    bool bull
    int t
    int idx
    bool hv
float hgz_v1 = volume[1]
float _hgz5000 = ta.highest(volume, 5000)[1]
float _hgz252 = ta.highest(volume, 252)[1]
float _hgz63 = ta.highest(volume, 63)[1]
bool hgz_isHV = (hgz_v1 == _hgz5000) or (hgz_v1 == _hgz252) or (hgz_v1 == _hgz63)
float hgz_thresh = hgz_auto ? ta.cum((high - low) / low) / bar_index : hgz_threshPct / 100
bool hgz_bFVG = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > hgz_thresh
bool hgz_sFVG = high < low[2] and close[1] < low[2] and (low[2] - high) / high > hgz_thresh
var hgz_fvgs = array.new<hgz_fvg>(0)
var int hgz_lastT = 0
bool hgz_bullGZI = false, bool hgz_bearGZI = false, bool hgz_bullHV = false, bool hgz_bearHV = false
if conf and hgz_bFVG and time != hgz_lastT
    float mx = low, float mn = high[2]
    if hgz_isHV
        hgz_bullHV := true
    if hgz_fvgs.size() > 0
        for i = 0 to hgz_fvgs.size() - 1
            hgz_fvg e = hgz_fvgs.get(i)
            if e.bull and bar_index - e.idx <= hgz_dist
                if math.max(e.mn, mn) < math.min(e.mx, mx) or (math.max(e.mn, mn) <= math.min(e.mx, mx) and e.hv and hgz_isHV)
                    hgz_bullGZI := true
                    break
    hgz_fvgs.unshift(hgz_fvg.new(mx, mn, true, time, bar_index, hgz_isHV))
    hgz_lastT := time
if conf and hgz_sFVG and time != hgz_lastT
    float mx = low[2], float mn = high
    if hgz_isHV
        hgz_bearHV := true
    if hgz_fvgs.size() > 0
        for i = 0 to hgz_fvgs.size() - 1
            hgz_fvg e = hgz_fvgs.get(i)
            if not e.bull and bar_index - e.idx <= hgz_dist
                if math.max(e.mn, mn) < math.min(e.mx, mx) or (math.max(e.mn, mn) <= math.min(e.mx, mx) and e.hv and hgz_isHV)
                    hgz_bearGZI := true
                    break
    hgz_fvgs.unshift(hgz_fvg.new(mx, mn, false, time, bar_index, hgz_isHV))
    hgz_lastT := time
if hgz_fvgs.size() > 0
    for i = hgz_fvgs.size() - 1 to 0
        hgz_fvg g = hgz_fvgs.get(i)
        if g.bull and close < g.mn
            hgz_fvgs.remove(i)
        else if not g.bull and close > g.mx
            hgz_fvgs.remove(i)
if hgz_fvgs.size() > 50
    hgz_fvgs.pop()

// ── Matrix Neo/Trinity + Long/Short momentum (reuses hybrid RVOL ratios) ──
grp_matrix = "Unified Combo — Matrix / Momentum"
neo_len = input.int(67, "Matrix Number Lookback", minval=1, group=grp_matrix)
float ls_reg1 = input.float(10.0, "Momentum 1 Reg Floor", minval=0.5, step=0.1, group=grp_matrix), float ls_cum1 = input.float(5.0, "Momentum 1 Cum Floor", minval=0.5, step=0.1, group=grp_matrix), float ls_body1 = input.float(0.69, "Momentum 1 Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=grp_matrix)
float ls_reg2 = input.float(8.0, "Momentum 2 Reg Floor", minval=0.5, step=0.1, group=grp_matrix), float ls_cum2 = input.float(4.0, "Momentum 2 Cum Floor", minval=0.5, step=0.1, group=grp_matrix), float ls_body2 = input.float(0.69, "Momentum 2 Body Ratio", minval=0.0, maxval=1.0, step=0.01, group=grp_matrix)
bool is_matrix_number = volume == ta.highest(volume, neo_len)
bool sigNeoBull = conf and is_matrix_number and u5_FAUNABull
bool sigNeoBear = conf and is_matrix_number and u5_FAUNABear
bool sigTrinityBull = conf and is_matrix_number and not u5_FAUNABull and close > open
bool sigTrinityBear = conf and is_matrix_number and not u5_FAUNABear and close < open
float ls_regRatio = nz(hybRegRatio)
float ls_cumRatio = nz(hybCumRatio)
float ls_bodyRat = (high - low) == 0 ? 0.0 : math.abs(close - open) / (high - low)
bool sigLong1 = conf and ls_regRatio > ls_reg1 and ls_cumRatio > ls_cum1 and close > open and ls_bodyRat >= ls_body1
bool sigShort1 = conf and ls_regRatio > ls_reg1 and ls_cumRatio > ls_cum1 and close < open and ls_bodyRat >= ls_body1
bool sigLong2 = conf and ls_regRatio > ls_reg2 and ls_cumRatio > ls_cum2 and close > open and ls_bodyRat >= ls_body2
bool sigShort2 = conf and ls_regRatio > ls_reg2 and ls_cumRatio > ls_cum2 and close < open and ls_bodyRat >= ls_body2
bool neo_bull_aligned = sigNeoBull and (sigLong1 or sigLong2)
bool neo_bear_aligned = sigNeoBear and (sigShort1 or sigShort2)
bool trinity_bull_aligned = sigTrinityBull and (sigLong1 or sigLong2)
bool trinity_bear_aligned = sigTrinityBear and (sigShort1 or sigShort2)

// ── Combo Sets → csNew3 (Unified Combo base + CMB momentum term) ──
grp_cs = "Unified Combo — Combo Sets"
cs_bodyPct_FVG = input.float(0.74, "Min Body% FVG", minval=0.0, maxval=1.0, step=0.05, group=grp_cs)
cs_bodyPct_MAT = input.float(0.74, "Min Body% Matrix", minval=0.0, maxval=1.0, step=0.05, group=grp_cs)
cs_inc_pentagon_FVG = input.bool(true, "Pentagon in FVG Sets", group=grp_cs)
cs_inc_pentagon_MAT = input.bool(true, "Pentagon in Matrix Sets", group=grp_cs)
float cs_bp1 = high[1] - low[1] == 0 ? 0.0 : math.abs(close[1] - open[1]) / (high[1] - low[1])
bool cs_vb = cs_bp1 >= cs_bodyPct_FVG
bool comboSet1_Bull = conf and cs_vb and (hgz_bullHV or hgz_bullGZI) and (det_SAAB[1] or det_RVOL1xB[1] or det_GrandSlam[1])
bool comboSet1_Bear = conf and cs_vb and (hgz_bearHV or hgz_bearGZI) and (det_Kratos[1] or det_RVOL1xR[1] or det_MOAB[1])
bool comboSet2_Bull = conf and cs_vb and (hgz_bullHV or hgz_bullGZI) and ((cs_inc_pentagon_FVG and det_Pentagon[1]) or det_WTC[1] or det_Hiroshima[1] or sigNagasaki[1])
bool comboSet2_Bear = conf and cs_vb and (hgz_bearHV or hgz_bearGZI) and ((cs_inc_pentagon_FVG and det_Pentagon[1]) or det_WTC[1] or det_Hiroshima[1] or sigNagasaki[1])
bool cs_vm = ls_bodyRat >= cs_bodyPct_MAT
bool matrix_any_bull = sigNeoBull or sigTrinityBull or neo_bull_aligned or trinity_bull_aligned
bool matrix_any_bear = sigNeoBear or sigTrinityBear or neo_bear_aligned or trinity_bear_aligned
bool comboSet3_Bull = cs_vm and matrix_any_bull and (det_SAAB or det_RVOL1xB or det_GrandSlam)
bool comboSet3_Bear = cs_vm and matrix_any_bear and (det_Kratos or det_RVOL1xR or det_MOAB)
bool comboSet4_Bull = cs_vm and matrix_any_bull and ((cs_inc_pentagon_MAT and det_Pentagon) or det_WTC or det_Hiroshima or sigNagasaki)
bool comboSet4_Bear = cs_vm and matrix_any_bear and ((cs_inc_pentagon_MAT and det_Pentagon) or det_WTC or det_Hiroshima or sigNagasaki)
bool csNew1_Bull = comboSet1_Bull or comboSet2_Bull
bool csNew1_Bear = comboSet1_Bear or comboSet2_Bear
bool csNew2_Bull = comboSet3_Bull or comboSet4_Bull
bool csNew2_Bear = comboSet3_Bear or comboSet4_Bear
bool csNew3_Bull = csNew1_Bull and nz(csNew2_Bull[1])
bool csNew3_Bear = csNew1_Bear and nz(csNew2_Bear[1])

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE: FC CLUSTER (Ultra v57 parity) — for B2B FC Cluster (fc_ prefix)
// ══════════════════════════════════════════════════════════════════════════════
fc_b1_inRng(v) => v > 2.9 and v < 1000000.0
fc_b1_chk(loA, hiA, loB, hiB) => loA <= hiB and loB <= hiA
fc_b4_inRng(v) => v > 2.9 and v < 1000000.0
fc_b4_chk(loA, hiA, loB, hiB) => loA <= hiB and loB <= hiA
f_fcEngine() =>
    float fc_atr14 = ta.atr(14)
    float fc_avgVol20 = ta.sma(volume, 20)
    float fc_avgDelta = ta.sma(math.abs(close - close[1]), 10)
    float fc_trendMA = ta.sma(close, 50)
    float fc_body = close - open
    float fc_rng = high - low
    float fc_bodySize = math.abs(fc_body)
    float fc_bodyRatio = fc_rng == 0 ? 0 : fc_bodySize / fc_rng
    bool fc_bodyUp = fc_body > 0
    bool fc_bodyDn = fc_body < 0
    bool fc_wide = fc_rng > 2.2 * fc_atr14
    bool fc_upTrend = fc_trendMA > fc_trendMA[1]
    bool fc_dnTrend = fc_trendMA < fc_trendMA[1]
    bool fc_inSession = not na(time(timeframe.period, "0930-1600", "America/New_York"))
    bool fc_bull_MB = conf and fc_bodyUp and fc_bodySize > 1.6 * fc_atr14 and fc_bodyRatio > 0.7 and volume > 1.8 * fc_avgVol20
    bool fc_bull_RE = conf and fc_bodyUp and fc_wide and (high - close) < 0.15 * fc_rng and volume > 1.8 * fc_avgVol20
    bool fc_bull_TA = conf and fc_upTrend and (close - close[1]) > 1.6 * fc_avgDelta and fc_bodyUp and volume > 1.8 * fc_avgVol20
    bool fc_bear_MB = conf and fc_bodyDn and fc_bodySize > 1.6 * fc_atr14 and fc_bodyRatio > 0.7 and volume > 1.8 * fc_avgVol20
    bool fc_bear_RE = conf and fc_bodyDn and fc_wide and (close - low) < 0.15 * fc_rng and volume > 1.8 * fc_avgVol20
    bool fc_bear_TA = conf and fc_dnTrend and (close[1] - close) > 1.6 * fc_avgDelta and fc_bodyDn and volume > 1.8 * fc_avgVol20
    // bull cluster
    var int fc_b1_s1 = 0
    fc_b1_s1 := fc_bull_MB ? fc_b1_s1 + 1 : 0
    bool fc_b1_ind1 = fc_bull_MB and fc_b1_s1 >= 2
    bool fc_b1_ev2 = fc_bull_MB or fc_bull_RE or fc_bull_TA
    var int fc_b1_s2 = 0
    if ta.change(dayofmonth) != 0
        fc_b1_s2 := 0
    else if not fc_b1_ev2
        fc_b1_s2 := 0
    if fc_b1_ev2
        fc_b1_s2 += 1
    bool fc_b1_ind2 = fc_b1_ev2 and fc_b1_s2 >= 2
    bool fc_b1_ev3 = (fc_bull_MB or fc_bull_RE) and fc_inSession
    var int fc_b1_s3 = 0
    fc_b1_s3 := fc_b1_ev3 ? fc_b1_s3 + 1 : 0
    bool fc_b1_ind3 = fc_b1_ev3 and fc_b1_s3 >= 2
    bool fc_b1_2of3 = (fc_b1_ind1 ? 1 : 0) + (fc_b1_ind2 ? 1 : 0) + (fc_b1_ind3 ? 1 : 0) >= 2
    float fc_b1_spk = math.abs(fc_body)
    float fc_b1_avgSpk = ta.sma(fc_b1_spk, 30)[1]
    float fc_b1_rvolP = fc_b1_spk / nz(fc_b1_avgSpk, 1)
    float fc_b1_avgVolD = ta.sma(volume, 30)[1]
    float fc_b1_rvolV = volume / nz(fc_b1_avgVolD, 1)
    float fc_b1_diff = fc_b1_rvolP - fc_b1_rvolV
    float fc_b1_pos = fc_b1_diff > 0 ? fc_b1_diff : na
    float fc_b1_smaP = ta.sma(fc_b1_pos, 20)
    bool fc_b1_base = fc_bodyUp and nz(fc_b1_pos) > nz(fc_b1_smaP)
    bool fc_b1_thEv = fc_b1_base and fc_b1_inRng(fc_b1_rvolP) and conf
    bool fc_b1_uBar = fc_b1_base and fc_b1_inRng(fc_b1_rvolP)
    var float fc_b1_sum = 0.0
    var int fc_b1_len = 0
    if fc_b1_uBar
        fc_b1_len += 1
        fc_b1_sum += fc_b1_rvolP
    else
        fc_b1_len := 0
        fc_b1_sum := 0.0
    bool fc_b1_seqEv = (fc_b1_len >= 2 and fc_b1_sum >= 0.1) and conf
    var int[] fc_b1_thIdx = array.new_int()
    var float[] fc_b1_thHi = array.new_float()
    var float[] fc_b1_thLo = array.new_float()
    var int[] fc_b1_sqIdx = array.new_int()
    var float[] fc_b1_sqHi = array.new_float()
    var float[] fc_b1_sqLo = array.new_float()
    bool fc_b1_ovlp = false
    if array.size(fc_b1_thIdx) > 0
        while bar_index - array.get(fc_b1_thIdx, 0) > 20
            array.shift(fc_b1_thIdx)
            array.shift(fc_b1_thHi)
            array.shift(fc_b1_thLo)
            if array.size(fc_b1_thIdx) == 0
                break
    if array.size(fc_b1_sqIdx) > 0
        while bar_index - array.get(fc_b1_sqIdx, 0) > 20
            array.shift(fc_b1_sqIdx)
            array.shift(fc_b1_sqHi)
            array.shift(fc_b1_sqLo)
            if array.size(fc_b1_sqIdx) == 0
                break
    if fc_b1_thEv
        array.push(fc_b1_thIdx, bar_index)
        array.push(fc_b1_thHi, high)
        array.push(fc_b1_thLo, low)
        if array.size(fc_b1_sqIdx) > 0
            for i = 0 to array.size(fc_b1_sqIdx) - 1
                if fc_b1_chk(low, high, array.get(fc_b1_sqLo, i), array.get(fc_b1_sqHi, i))
                    fc_b1_ovlp := true
                    break
    if fc_b1_seqEv and not fc_b1_ovlp
        array.push(fc_b1_sqIdx, bar_index)
        array.push(fc_b1_sqHi, high)
        array.push(fc_b1_sqLo, low)
        if array.size(fc_b1_thIdx) > 0
            for i = 0 to array.size(fc_b1_thIdx) - 1
                if fc_b1_chk(low, high, array.get(fc_b1_thLo, i), array.get(fc_b1_thHi, i))
                    fc_b1_ovlp := true
                    break
    bool sBullFC = conf and fc_b1_2of3 and fc_b1_ovlp
    // bear cluster (asymmetries preserved: fc_b4_neg has extra bodyDn guard; fc_b4_sum >= 0.5)
    var int fc_b4_s1 = 0
    fc_b4_s1 := fc_bear_MB ? fc_b4_s1 + 1 : 0
    bool fc_b4_ind1 = fc_bear_MB and fc_b4_s1 >= 2
    bool fc_b4_ev2 = fc_bear_MB or fc_bear_RE or fc_bear_TA
    var int fc_b4_s2 = 0
    if ta.change(dayofmonth) != 0
        fc_b4_s2 := 0
    else if not fc_b4_ev2
        fc_b4_s2 := 0
    if fc_b4_ev2
        fc_b4_s2 += 1
    bool fc_b4_ind2 = fc_b4_ev2 and fc_b4_s2 >= 2
    bool fc_b4_ev3 = (fc_bear_MB or fc_bear_RE) and fc_inSession
    var int fc_b4_s3 = 0
    fc_b4_s3 := fc_b4_ev3 ? fc_b4_s3 + 1 : 0
    bool fc_b4_ind3 = fc_b4_ev3 and fc_b4_s3 >= 2
    bool fc_b4_2of3 = (fc_b4_ind1 ? 1 : 0) + (fc_b4_ind2 ? 1 : 0) + (fc_b4_ind3 ? 1 : 0) >= 2
    float fc_b4_spk = math.abs(fc_body)
    float fc_b4_avgSpk = ta.sma(fc_b4_spk, 30)[1]
    float fc_b4_rvolP = fc_b4_spk / nz(fc_b4_avgSpk, 1)
    float fc_b4_avgVolD = ta.sma(volume, 30)[1]
    float fc_b4_rvolV = volume / nz(fc_b4_avgVolD, 1)
    float fc_b4_diff = fc_b4_rvolP - fc_b4_rvolV
    float fc_b4_neg = (fc_b4_diff > 0 and fc_bodyDn) ? fc_b4_diff : na
    float fc_b4_smaN = ta.sma(fc_b4_neg, 20)
    bool fc_b4_base = fc_bodyDn and nz(fc_b4_neg) > nz(fc_b4_smaN)
    bool fc_b4_thEv = fc_b4_base and fc_b4_inRng(fc_b4_rvolP) and conf
    bool fc_b4_dBar = fc_b4_base and fc_b4_inRng(fc_b4_rvolP)
    var float fc_b4_sum = 0.0
    var int fc_b4_len = 0
    if fc_b4_dBar
        fc_b4_len += 1
        fc_b4_sum += fc_b4_rvolP
    else
        fc_b4_len := 0
        fc_b4_sum := 0.0
    bool fc_b4_seqEv = (fc_b4_len >= 2 and fc_b4_sum >= 0.5) and conf
    var int[] fc_b4_thIdx = array.new_int()
    var float[] fc_b4_thHi = array.new_float()
    var float[] fc_b4_thLo = array.new_float()
    var int[] fc_b4_sqIdx = array.new_int()
    var float[] fc_b4_sqHi = array.new_float()
    var float[] fc_b4_sqLo = array.new_float()
    bool fc_b4_ovlp = false
    if array.size(fc_b4_thIdx) > 0
        while bar_index - array.get(fc_b4_thIdx, 0) > 20
            array.shift(fc_b4_thIdx)
            array.shift(fc_b4_thHi)
            array.shift(fc_b4_thLo)
            if array.size(fc_b4_thIdx) == 0
                break
    if array.size(fc_b4_sqIdx) > 0
        while bar_index - array.get(fc_b4_sqIdx, 0) > 20
            array.shift(fc_b4_sqIdx)
            array.shift(fc_b4_sqHi)
            array.shift(fc_b4_sqLo)
            if array.size(fc_b4_sqIdx) == 0
                break
    if fc_b4_thEv
        array.push(fc_b4_thIdx, bar_index)
        array.push(fc_b4_thHi, high)
        array.push(fc_b4_thLo, low)
        if array.size(fc_b4_sqIdx) > 0
            for i = 0 to array.size(fc_b4_sqIdx) - 1
                if fc_b4_chk(low, high, array.get(fc_b4_sqLo, i), array.get(fc_b4_sqHi, i))
                    fc_b4_ovlp := true
                    break
    if fc_b4_seqEv and not fc_b4_ovlp
        array.push(fc_b4_sqIdx, bar_index)
        array.push(fc_b4_sqHi, high)
        array.push(fc_b4_sqLo, low)
        if array.size(fc_b4_thIdx) > 0
            for i = 0 to array.size(fc_b4_thIdx) - 1
                if fc_b4_chk(low, high, array.get(fc_b4_thLo, i), array.get(fc_b4_thHi, i))
                    fc_b4_ovlp := true
                    break
    bool sBearFC = conf and fc_b4_2of3 and fc_b4_ovlp
    [sBullFC, sBearFC]

[sBullFC, sBearFC] = f_fcEngine()

// ══════════════════════════════════════════════════════════════════════════════
// HVD GROUP 2 — BACK-TO-BACK HV+D
// ══════════════════════════════════════════════════════════════════════════════
bool b2b_bull_raw = hvd_fire_bull and nz(hvd_fire_bull[1])
bool b2b_bull_pbj = b2b_bull_raw and (nz(sigBullPBJ[1]) or nz(sigBullPBJ[2]))
bool b2b_bull_pb = b2b_bull_raw and (nz(sigBullPB[1]) or nz(sigBullPB[2])) and not b2b_bull_pbj
bool b2b_bull_nopb = b2b_bull_raw and not b2b_bull_pbj and not b2b_bull_pb
bool b2b_bear_raw = hvd_fire_bear and nz(hvd_fire_bear[1])
bool b2b_bear_pbj = b2b_bear_raw and (nz(sigBearPBJ[1]) or nz(sigBearPBJ[2]))
bool b2b_bear_pb = b2b_bear_raw and (nz(sigBearPB[1]) or nz(sigBearPB[2])) and not b2b_bear_pbj
bool b2b_bear_nopb = b2b_bear_raw and not b2b_bear_pbj and not b2b_bear_pb

// ══════════════════════════════════════════════════════════════════════════════
// HVD GROUP 3 — HV+D MOMENTUM CO-OCC
// ══════════════════════════════════════════════════════════════════════════════
bool _m_pup1 = nz(sigPUP[1])
bool _m_ppd1 = nz(sigPPD[1])
bool _m_rv1b = nz(det_RVOL1xB[1]) or nz(det_GrandSlam[1])
bool _m_rv1r = nz(det_RVOL1xR[1]) or nz(det_MOAB[1])
bool _m_cb1b = csNew3_Bull
bool _m_cb1r = csNew3_Bear
bool _m_pj1b = nz(sigBullPBJ[1])
bool _m_pj1r = nz(sigBearPBJ[1])
bool hvdm_pup_nopbj_b = hvd_fire_bull and _m_pup1 and not _m_pj1b
bool hvdm_pbjpup_b = hvd_fire_bull and _m_pj1b and _m_pup1
bool hvdm_rvol_nopbj_b = hvd_fire_bull and _m_rv1b and not _m_pj1b
bool hvdm_pbjrvol_b = hvd_fire_bull and _m_pj1b and _m_rv1b
bool hvdm_cmb_nopbj_b = hvd_fire_bull and _m_cb1b and not _m_pj1b
bool hvdm_pbjcmb_b = hvd_fire_bull and _m_pj1b and _m_cb1b
int hvdm_b_cnt = (_m_pup1 ? 1 : 0) + (_m_rv1b ? 1 : 0) + (_m_cb1b ? 1 : 0)
bool hvdm_2of3_b_raw = hvd_fire_bull and _m_pj1b and hvdm_b_cnt >= 2
bool hvdm_3of3_b = hvd_fire_bull and _m_pj1b and _m_pup1 and _m_rv1b and _m_cb1b
bool hvdm_2of3_b = hvdm_2of3_b_raw and not hvdm_3of3_b
bool hvdm_vis_pbjpup_b = hvdm_pbjpup_b and not hvdm_2of3_b_raw
bool hvdm_vis_pbjrvol_b = hvdm_pbjrvol_b and not hvdm_2of3_b_raw
bool hvdm_vis_pbjcmb_b = hvdm_pbjcmb_b and not hvdm_2of3_b_raw
bool hvdm_ppd_nopbj_r = hvd_fire_bear and _m_ppd1 and not _m_pj1r
bool hvdm_pbjppd_r = hvd_fire_bear and _m_pj1r and _m_ppd1
bool hvdm_rvol_nopbj_r = hvd_fire_bear and _m_rv1r and not _m_pj1r
bool hvdm_pbjrvol_r = hvd_fire_bear and _m_pj1r and _m_rv1r
bool hvdm_cmb_nopbj_r = hvd_fire_bear and _m_cb1r and not _m_pj1r
bool hvdm_pbjcmb_r = hvd_fire_bear and _m_pj1r and _m_cb1r
int hvdm_r_cnt = (_m_ppd1 ? 1 : 0) + (_m_rv1r ? 1 : 0) + (_m_cb1r ? 1 : 0)
bool hvdm_2of3_r_raw = hvd_fire_bear and _m_pj1r and hvdm_r_cnt >= 2
bool hvdm_3of3_r = hvd_fire_bear and _m_pj1r and _m_ppd1 and _m_rv1r and _m_cb1r
bool hvdm_2of3_r = hvdm_2of3_r_raw and not hvdm_3of3_r
bool hvdm_vis_pbjppd_r = hvdm_pbjppd_r and not hvdm_2of3_r_raw
bool hvdm_vis_pbjrvol_r = hvdm_pbjrvol_r and not hvdm_2of3_r_raw
bool hvdm_vis_pbjcmb_r = hvdm_pbjcmb_r and not hvdm_2of3_r_raw

// ══════════════════════════════════════════════════════════════════════════════
// HVD GROUP 1 — PIPELINE D TRIPLE CO-OCCURRENCE (rolling-only USE gate)
// NOTE: the source's use_any_* gate pulled in FIXED-SESSION-WINDOW signals
// (Opening Drive sessionBarCount, Alpha Strike firstOfDay). Per this study's
// rolling-only rule those are dropped; use_any_* is rebuilt from First Bar
// Fable's own ROLLING detections. Deliberate deviation — documented in CHANGELOG.
// ══════════════════════════════════════════════════════════════════════════════
bool use_any_bull = det_S10_saab or det_dynamiteBull or det_igniteBull or det_b2bBullNapalm or sigTyphoonBull or sigMusashiBull or sigWhaleBull or det_GrandSlam or det_RVOL1xB or det_SAAB or sigPUP or sigFAUNABull or csNew1_Bull or csNew2_Bull or csNew3_Bull or sBullFC or hvd_fire_bull
bool use_any_bear = det_S9_kratos or det_dynamiteBear or det_igniteBear or det_b2bBearNapalm or sigTyphoonBear or sigMusashiBear or sigWhaleBear or det_MOAB or det_RVOL1xR or det_Kratos or sigPPD or sigFAUNABear or csNew1_Bear or csNew2_Bear or csNew3_Bear or sBearFC or hvd_fire_bear
bool co_bull_pbj = hvd_fire_bull and nz(sigBullPBJ[1]) and nz(use_any_bull[1])
bool co_bull_pb = hvd_fire_bull and nz(sigBullPB[1]) and nz(use_any_bull[1])
bool co_bear_pbj = hvd_fire_bear and nz(sigBearPBJ[1]) and nz(use_any_bear[1])
bool co_bear_pb = hvd_fire_bear and nz(sigBearPB[1]) and nz(use_any_bear[1])

// ══════════════════════════════════════════════════════════════════════════════
// NEW DETECTION BOOLEANS
// ══════════════════════════════════════════════════════════════════════════════
// Unified Combo + Disp9 (csNew3 AND displacement-9, matching direction)
bool det_UC_bull = csNew3_Bull and d9_bull
bool det_UC_bear = csNew3_Bear and d9_bear
// B2B PUP / PPD + Disp9 on one of the two pattern bars (bar[0] or bar[1])
bool det_b2bPUP_d9 = det_b2bPUP and (d9_bull or nz(d9_bull[1]))
bool det_b2bPPD_d9 = det_b2bPPD and (d9_bear or nz(d9_bear[1]))
// B2B FC Cluster — FC cluster on two consecutive bars (ALWAYS fires on any bar; overrides first-bar mode)
bool det_b2bFC_bull = sBullFC and nz(sBullFC[1])
bool det_b2bFC_bear = sBearFC and nz(sBearFC[1])
// D9 Bull/Bear Study (HW v3 parity): disp≥9σ AND (RVOL1x or GS/MOAB) AND (HV500 or HV1000 or Nagasaki), same confirmed bar
bool hv500_raw = volume == ta.highest(volume, 500)
bool hv1000_raw = volume == ta.highest(volume, 1000)
bool det_D9bull = conf and d9_bull and (det_RVOL1xB or det_GrandSlam) and (hv500_raw or hv1000_raw or sigNagasaki)
bool det_D9bear = conf and d9_bear and (det_RVOL1xR or det_MOAB) and (hv500_raw or hv1000_raw or sigNagasaki)

// ── v2 detection toggles (checkbox = plot + alert) ──
grpSIG2 = "★ SIGNAL TOGGLES (v2) ★"
en_S18 = input.bool(true, "S18: B2B PUP + Disp9", group=grpSIG2, tooltip="Back-to-back PUP (bar[0]+bar[1]) with Displacement 9 on one of the two pattern bars. Offset 0.")
en_S19 = input.bool(true, "S19: B2B PPD + Disp9", group=grpSIG2, tooltip="Bear mirror of S18. Offset 0.")
en_S20 = input.bool(true, "S20: B2B FC Cluster Bull ⚠ALWAYS ANY BAR", group=grpSIG2, tooltip="B2B FC Cluster (Ultra v57 FC cluster on two consecutive bars). ⚠ OVERRIDES the First Bar Master — this plot ALWAYS fires on any bar, even when First Bar Mode is ON. Offset 0.")
en_S21 = input.bool(true, "S21: B2B FC Cluster Bear ⚠ALWAYS ANY BAR", group=grpSIG2, tooltip="Bear mirror of S20. ⚠ OVERRIDES the First Bar Master — ALWAYS fires on any bar. Offset 0.")
en_S22 = input.bool(true, "S22: D9 Bull Study", group=grpSIG2, tooltip="HW v3 parity: displacement ≥ 9σ AND (Bull RVOL 1x OR Grand Slam) AND (HV500 OR HV1000 OR Nagasaki), all same confirmed bar. Offset 0.")
en_S23 = input.bool(true, "S23: D9 Bear Study", group=grpSIG2, tooltip="Bear mirror of S22 (MOAB instead of GS). Offset 0.")
en_S24 = input.bool(true, "S24: Unified Combo Bull + Disp9", group=grpSIG2, tooltip="HVD Unified Combo (csNew3) AND Displacement 9. Offset -1.")
en_S25 = input.bool(true, "S25: Unified Combo Bear + Disp9", group=grpSIG2, tooltip="Bear mirror of S24. Offset -1.")
en_S26 = input.bool(true, "S26: B2B TNT ENR ↔ NPM ENR Bull", group=grpSIG2, tooltip="TNT Enriched and NPM Enriched VISUAL plots on two consecutive bars, either order (TNT OD v3 Tier 2 parity, incl. v3 gate + suppression). Renders on the pair's SECOND visual bar (offset 0 or -1 by case). First-bar mode passes when either visual bar of the pair is the session's first bar.")
en_S27 = input.bool(true, "S27: B2B TNT ENR ↔ NPM ENR Bear", group=grpSIG2, tooltip="Bear mirror of S26.")

grp_co = "★ HVD — Pipeline D Triple Co-occurrence ★"
co_en_bullPBJ = input.bool(true, "Bull PBJ co-occurrence", group=grp_co, inline="co1")
co_en_bullPB = input.bool(true, "Bull PB co-occurrence", group=grp_co, inline="co1")
co_en_bearPBJ = input.bool(true, "Bear PBJ co-occurrence", group=grp_co, inline="co2")
co_en_bearPB = input.bool(true, "Bear PB co-occurrence", group=grp_co, inline="co2")

grp_b2b = "★ HVD — Back-to-Back HV+D ★"
b2b_en_bull = input.bool(true, "B2B HV+D Bull", group=grp_b2b, inline="b1")
b2b_en_bull_pbj = input.bool(true, "B2B HV+D+PBJ Bull", group=grp_b2b, inline="b2")
b2b_en_bull_pb = input.bool(true, "B2B HV+D+PB Bull", group=grp_b2b, inline="b3")
b2b_en_bear = input.bool(true, "B2B HV+D Bear", group=grp_b2b, inline="b1")
b2b_en_bear_pbj = input.bool(true, "B2B HV+D+PBJ Bear", group=grp_b2b, inline="b2")
b2b_en_bear_pb = input.bool(true, "B2B HV+D+PB Bear", group=grp_b2b, inline="b3")

grp_hvdm = "★ HVD — HV+D Momentum Co-occ ★"
en_hvdm_pup_bull = input.bool(true, "HV+D+PUP Bull", group=grp_hvdm, inline="m1")
en_hvdm_rvol_bull = input.bool(true, "HV+D+RVOL Bull", group=grp_hvdm, inline="m2")
en_hvdm_cmb_bull = input.bool(true, "HV+D+CMB Bull", group=grp_hvdm, inline="m3")
en_hvdm_2of3_bull = input.bool(true, "2of3 Bull", group=grp_hvdm, inline="m4")
en_hvdm_3of3_bull = input.bool(true, "3of3 Bull", group=grp_hvdm, inline="m5")
en_hvdm_ppd_bear = input.bool(true, "HV+D+PPD Bear", group=grp_hvdm, inline="m1")
en_hvdm_rvol_bear = input.bool(true, "HV+D+RVOL Bear", group=grp_hvdm, inline="m2")
en_hvdm_cmb_bear = input.bool(true, "HV+D+CMB Bear", group=grp_hvdm, inline="m3")
en_hvdm_2of3_bear = input.bool(true, "2of3 Bear", group=grp_hvdm, inline="m4")
en_hvdm_3of3_bear = input.bool(true, "3of3 Bear", group=grp_hvdm, inline="m5")

// ══════════════════════════════════════════════════════════════════════════════
// DETECTIONS
// ══════════════════════════════════════════════════════════════════════════════
// S1/S2 — RVOL tier + Disp9 + PBJ
bool det_S1 = conf and (det_RVOL1xB or det_GrandSlam) and d9_bull and anyBullPBJ
bool det_S2 = conf and (det_RVOL1xR or det_MOAB) and d9_bear and anyBearPBJ

// S15 — Nagasaki + any bullish qualifier, ON THE FIRST BAR (baked in)
bool det_S15 = conf and is_new_sess and sigNagasaki and (anyLong or anyBullPBJ or d9_bull or det_RVOL1xB or det_GrandSlam)

// ══════════════════════════════════════════════════════════════════════════════
// FIRST BAR MASTER GATES (per reference bar / offset)
// ══════════════════════════════════════════════════════════════════════════════
bool fb0 = not firstBarOnly or is_new_sess
bool fb1 = not firstBarOnly or nz(is_new_sess[1])
bool fb01 = not firstBarOnly or is_new_sess or nz(is_new_sess[1])
bool fbs = not firstBarOnly or nz(is_new_sess[yy_rightBars])
bool fbm = not firstBarOnly or al_isFirstBar
bool fb12 = not firstBarOnly or nz(is_new_sess[1]) or nz(is_new_sess[2])

// ══════════════════════════════════════════════════════════════════════════════
// FIRE BOOLEANS — checkbox + detection + first-bar gate (drive plots AND alerts)
// ══════════════════════════════════════════════════════════════════════════════
bool fire_S1 = en_S1 and det_S1 and fb0
bool fire_S2 = en_S2 and det_S2 and fb0
bool fire_S3 = en_S3 and sigTyphoonBull and fbs
bool fire_S4 = en_S4 and sigTyphoonBear and fbs
bool fire_S5 = en_S5 and sigMusashiBull and fbm
bool fire_S6 = en_S6 and sigMusashiBear and fbm
bool fire_S7 = en_S7 and sigWhaleBull and fb0
bool fire_S8 = en_S8 and sigWhaleBear and fb0
bool fire_S9 = en_S9 and det_S9_kratos and fb01
bool fire_S10 = en_S10 and det_S10_saab and fb01
bool fire_S11 = en_S11 and det_dynamiteBull and fb1
bool fire_S12 = en_S12 and det_dynamiteBear and fb1
bool fire_S13_tc = en_S13 and ign_tc_bull and fb0
bool fire_S13_nc = en_S13 and ign_nc_bull and fb1
bool fire_S13 = fire_S13_tc or fire_S13_nc
bool fire_S14_tc = en_S14 and ign_tc_bear and fb0
bool fire_S14_nc = en_S14 and ign_nc_bear and fb1
bool fire_S14 = fire_S14_tc or fire_S14_nc
bool fire_S15 = en_S15 and det_S15 and fb0
bool fire_S16 = en_S16 and det_b2bBullNapalm and fb01
bool fire_S17 = en_S17 and det_b2bBearNapalm and fb01
// v2 fire booleans
bool fire_S18 = en_S18 and det_b2bPUP_d9 and fb01
bool fire_S19 = en_S19 and det_b2bPPD_d9 and fb01
// S20/S21 B2B FC Cluster — OVERRIDE first-bar mode (NO fb gate; always any bar)
bool fire_S20 = en_S20 and det_b2bFC_bull
bool fire_S21 = en_S21 and det_b2bFC_bear
bool fire_S22 = en_S22 and det_D9bull and fb0
bool fire_S23 = en_S23 and det_D9bear and fb0
bool fire_S24 = en_S24 and det_UC_bull and fb1
bool fire_S25 = en_S25 and det_UC_bear and fb1
// S26/S27 — first-bar gate per VISUAL pair: same-bar case visuals = bars[1,0] → fb01;
// tnt-first case visuals = bars[2,1] → fb12. Pair passes when either visual bar is the first bar.
bool fire_S26_same = en_S26 and enrB2B_bull_sameBar and fb01
bool fire_S26_tnt1 = en_S26 and enrB2B_bull_tntFirst and fb12
bool fire_S26 = fire_S26_same or fire_S26_tnt1
bool fire_S27_same = en_S27 and enrB2B_bear_sameBar and fb01
bool fire_S27_tnt1 = en_S27 and enrB2B_bear_tntFirst and fb12
bool fire_S27 = fire_S27_same or fire_S27_tnt1
// HVD Group 1 — CO co-occurrence (offset -1 → fb1)
bool fire_co_bull_pbj = co_en_bullPBJ and co_bull_pbj and fb1
bool fire_co_bull_pb = co_en_bullPB and co_bull_pb and fb1
bool fire_co_bear_pbj = co_en_bearPBJ and co_bear_pbj and fb1
bool fire_co_bear_pb = co_en_bearPB and co_bear_pb and fb1
// HVD Group 2 — B2B HV+D (offset -1 → fb1)
bool fire_b2b_bull_nopb = b2b_en_bull and b2b_bull_nopb and fb1
bool fire_b2b_bull_pbj = b2b_en_bull_pbj and b2b_bull_pbj and fb1
bool fire_b2b_bull_pb = b2b_en_bull_pb and b2b_bull_pb and fb1
bool fire_b2b_bear_nopb = b2b_en_bear and b2b_bear_nopb and fb1
bool fire_b2b_bear_pbj = b2b_en_bear_pbj and b2b_bear_pbj and fb1
bool fire_b2b_bear_pb = b2b_en_bear_pb and b2b_bear_pb and fb1
// HVD Group 3 — HV+D Momentum (offset -1 → fb1)
bool fire_hvdm_pup_b = en_hvdm_pup_bull and hvdm_pup_nopbj_b and fb1
bool fire_hvdm_rvol_b = en_hvdm_rvol_bull and hvdm_rvol_nopbj_b and fb1
bool fire_hvdm_cmb_b = en_hvdm_cmb_bull and hvdm_cmb_nopbj_b and fb1
bool fire_hvdm_pbjpup_b = en_hvdm_pup_bull and hvdm_vis_pbjpup_b and fb1
bool fire_hvdm_pbjrvol_b = en_hvdm_rvol_bull and hvdm_vis_pbjrvol_b and fb1
bool fire_hvdm_pbjcmb_b = en_hvdm_cmb_bull and hvdm_vis_pbjcmb_b and fb1
bool fire_hvdm_2of3_b = en_hvdm_2of3_bull and hvdm_2of3_b and fb1
bool fire_hvdm_3of3_b = en_hvdm_3of3_bull and hvdm_3of3_b and fb1
bool fire_hvdm_ppd_r = en_hvdm_ppd_bear and hvdm_ppd_nopbj_r and fb1
bool fire_hvdm_rvol_r = en_hvdm_rvol_bear and hvdm_rvol_nopbj_r and fb1
bool fire_hvdm_cmb_r = en_hvdm_cmb_bear and hvdm_cmb_nopbj_r and fb1
bool fire_hvdm_pbjppd_r = en_hvdm_ppd_bear and hvdm_vis_pbjppd_r and fb1
bool fire_hvdm_pbjrvol_r = en_hvdm_rvol_bear and hvdm_vis_pbjrvol_r and fb1
bool fire_hvdm_pbjcmb_r = en_hvdm_cmb_bear and hvdm_vis_pbjcmb_r and fb1
bool fire_hvdm_2of3_r = en_hvdm_2of3_bear and hvdm_2of3_r and fb1
bool fire_hvdm_3of3_r = en_hvdm_3of3_bear and hvdm_3of3_r and fb1

// ══════════════════════════════════════════════════════════════════════════════
// PLOTS
// (colors are compile-time constants so each plotshape counts as 1 plot toward
//  the 64-output limit — color.new(...) series colors would double the count.)
// ══════════════════════════════════════════════════════════════════════════════
color c_ty_bull = color.new(color.aqua, 75)
color c_ty_bear = color.new(color.orange, 75)
color c_mu_bull = color.new(#FFD700, 75)
color c_mu_bear = color.new(#FF4500, 75)
color c_wh_bear = color.new(#DC143C, 75)
plotshape(fire_S1, "S1: Bull RVOL 1X/GS + Disp9 + PBJ", shape.triangleup, location.belowbar, color.new(color.aqua, 50), 0, "1X/GS\nD9 PBJ", color.white, size=size.large)
plotshape(fire_S2, "S2: Bear RVOL 1X/MOAB + Disp9 + PBJ", shape.triangledown, location.abovebar, color.new(color.fuchsia, 50), 0, "1X/MOAB\nD9 PBJ", color.white, size=size.large)
plotshape(fire_S3, "S3: Typhoon Bull", shape.labelup, location.belowbar, color.new(c_ty_bull, 50), -yy_rightBars, "TYPHOON+", color.white, size=size.large)
plotshape(fire_S4, "S4: Typhoon Bear", shape.labeldown, location.abovebar, color.new(c_ty_bear, 50), -yy_rightBars, "TYPHOON-", color.white, size=size.large)
plotshape(fire_S5, "S5: Musashi Bull", shape.labelup, location.belowbar, color.new(c_mu_bull, 50), -moff, "+ Musashi", color.white, size=size.large)
plotshape(fire_S6, "S6: Musashi Bear", shape.labeldown, location.abovebar, color.new(c_mu_bear, 50), -moff, "- Musashi", color.white, size=size.large)
plotshape(fire_S7, "S7: Whale+PUP Bull", shape.cross, location.belowbar, color.new(c_mu_bull, 50), 0, "WH+PUP", color.white, size=size.large)
plotshape(fire_S8, "S8: Whale+PPD Bear", shape.cross, location.abovebar, color.new(c_wh_bear, 50), 0, "WH+PPD", color.white, size=size.large)
plotshape(fire_S9, "S9: B2B KRATOS + Disp9", shape.diamond, location.abovebar, color.new(#FF6F00, 50), 0, "B2B\nKRAT D9", color.white, size=size.large)
plotshape(fire_S10, "S10: B2B SAAB + Disp9", shape.diamond, location.belowbar, color.new(#FFD700, 50), 0, "B2B\nSAAB D9", color.white, size=size.large)
plotshape(fire_S11, "S11: Dynamite Bull", shape.labelup, location.belowbar, color.new(#FF0000, 50), -1, "★ DYNAMITE", color.white, size=size.normal)
plotshape(fire_S12, "S12: Dynamite Bear", shape.labeldown, location.abovebar, color.new(#FF0000, 50), -1, "★ DYNAMITE", color.white, size=size.normal)
plotshape(fire_S13_tc, "S13: Ignite Bull (T+C)", shape.labelup, location.belowbar, color.new(#76ff03, 50), 0, "IGNITE T+C", color.white, size=size.large)
plotshape(fire_S13_nc, "S13: Ignite Bull (N+C)", shape.labelup, location.belowbar, color.new(#76ff03, 50), -1, "IGNITE N+C", color.white, size=size.large)
plotshape(fire_S14_tc, "S14: Ignite Bear (T+C)", shape.labeldown, location.abovebar, color.new(#d500f9, 50), 0, "IGNITE T+C", color.white, size=size.large)
plotshape(fire_S14_nc, "S14: Ignite Bear (N+C)", shape.labeldown, location.abovebar, color.new(#d500f9, 50), -1, "IGNITE N+C", color.white, size=size.large)
plotshape(fire_S15, "S15: Nagasaki 1stBar+", shape.labelup, location.abovebar, color.new(#FF00FF, 50), 0, "NAG+", color.white, size=size.normal)
plotshape(fire_S16, "S16: B2B Napalm Bull", shape.labelup, location.belowbar, color.new(#1DE9B6, 50), 0, "NPM\nB2B", color.white, size=size.large)
plotshape(fire_S17, "S17: B2B Napalm Bear", shape.labeldown, location.abovebar, color.new(#FF1744, 50), 0, "NPM\nB2B", color.white, size=size.large)
// v2 plots
plotshape(fire_S18, "S18: B2B PUP + Disp9", shape.diamond, location.belowbar, color.new(#00E676, 50), 0, "B2B PUP\nD9", color.white, size=size.large)
plotshape(fire_S19, "S19: B2B PPD + Disp9", shape.diamond, location.abovebar, color.new(#FF1744, 50), 0, "B2B PPD\nD9", color.white, size=size.large)
plotshape(fire_S20, "S20: B2B FC Cluster Bull", shape.flag, location.belowbar, color.new(#00BFA5, 50), 0, "B2B\nFC", color.white, size=size.large)
plotshape(fire_S21, "S21: B2B FC Cluster Bear", shape.flag, location.abovebar, color.new(#C2185B, 50), 0, "B2B\nFC", color.white, size=size.large)
plotshape(fire_S22, "S22: D9 Bull Study", shape.triangleup, location.belowbar, color.new(#1B5E20, 50), 0, "D9\nSTUDY", color.white, size=size.normal)
plotshape(fire_S23, "S23: D9 Bear Study", shape.triangledown, location.abovebar, color.new(#B71C1C, 50), 0, "D9\nSTUDY", color.white, size=size.normal)
plotshape(fire_S24, "S24: Unified Combo Bull + Disp9", shape.labelup, location.belowbar, color.new(#43A047, 50), -1, "UC\nD9", color.white, size=size.huge)
plotshape(fire_S25, "S25: Unified Combo Bear + Disp9", shape.labeldown, location.abovebar, color.new(#9C27B0, 50), -1, "UC\nD9", color.white, size=size.huge)
// S26/S27 render on the pair's SECOND visual bar: same-bar case → offset 0; tnt-first case → offset -1
plotshape(fire_S26_same, "S26: B2B TNT/NPM ENR Bull", shape.labelup, location.belowbar, color.new(#089981, 50), 0, "ENR\nB2B", color.white, size=size.huge)
plotshape(fire_S26_tnt1, "S26: B2B TNT/NPM ENR Bull (T1st)", shape.labelup, location.belowbar, color.new(#089981, 50), -1, "ENR\nB2B", color.white, size=size.huge)
plotshape(fire_S27_same, "S27: B2B TNT/NPM ENR Bear", shape.labeldown, location.abovebar, color.new(#f23645, 50), 0, "ENR\nB2B", color.white, size=size.huge)
plotshape(fire_S27_tnt1, "S27: B2B TNT/NPM ENR Bear (T1st)", shape.labeldown, location.abovebar, color.new(#f23645, 50), -1, "ENR\nB2B", color.white, size=size.huge)
// HVD Group 1 — Pipeline D CO co-occurrence (offset -1)
plotshape(fire_co_bull_pbj, "CO: HV+D+PBJ+USE Bull", shape.diamond, location.top, color.new(#FFD700, 50), -1, "CO\nPBJ", color.white, size=size.huge)
plotshape(fire_co_bull_pb, "CO: HV+D+PB+USE Bull", shape.triangleup, location.top, color.new(#00E5FF, 50), -1, "CO\nPB", color.white, size=size.huge)
plotshape(fire_co_bear_pbj, "CO: HV+D+PBJ+USE Bear", shape.diamond, location.belowbar, color.new(#FF1744, 50), -1, "CO\nPBJ", color.white, size=size.huge)
plotshape(fire_co_bear_pb, "CO: HV+D+PB+USE Bear", shape.triangledown, location.belowbar, color.new(#FF6D00, 50), -1, "CO\nPB", color.white, size=size.huge)
// HVD Group 2 — Back-to-Back HV+D (offset -1)
plotshape(fire_b2b_bull_nopb, "B2B HV+D Bull", shape.flag, location.belowbar, color.new(#00E676, 50), -1, "B2B", color.white, size=size.large)
plotshape(fire_b2b_bull_pbj, "B2B HV+D+PBJ Bull", shape.flag, location.bottom, color.new(#FFD700, 50), -1, "B2B\nPBJ", color.white, size=size.huge)
plotshape(fire_b2b_bull_pb, "B2B HV+D+PB Bull", shape.flag, location.bottom, color.new(#00E5FF, 50), -1, "B2B\nPB", color.white, size=size.large)
plotshape(fire_b2b_bear_nopb, "B2B HV+D Bear", shape.flag, location.abovebar, color.new(#FF1744, 50), -1, "B2B", color.white, size=size.large)
plotshape(fire_b2b_bear_pbj, "B2B HV+D+PBJ Bear", shape.flag, location.top, color.new(#FF1744, 50), -1, "B2B\nPBJ", color.white, size=size.huge)
plotshape(fire_b2b_bear_pb, "B2B HV+D+PB Bear", shape.flag, location.top, color.new(#FF6D00, 50), -1, "B2B\nPB", color.white, size=size.large)
// HVD Group 3 — HV+D Momentum Co-occ (offset -1)
plotshape(fire_hvdm_pup_b, "HV+D+PUP Bull", shape.triangleup, location.top, color.new(#00E676, 50), -1, "HVD\nPUP", color.white, size=size.large)
plotshape(fire_hvdm_rvol_b, "HV+D+RVOL Bull", shape.triangleup, location.top, color.new(#00BCD4, 50), -1, "HVD\nRVOL", color.white, size=size.large)
plotshape(fire_hvdm_cmb_b, "HV+D+CMB Bull", shape.triangleup, location.top, color.new(#43A047, 50), -1, "HVD\nCMB", color.white, size=size.large)
plotshape(fire_hvdm_pbjpup_b, "HV+D+PBJ+PUP Bull", shape.diamond, location.top, color.new(#FFD700, 50), -1, "HVD+PBJ\nPUP", color.white, size=size.large)
plotshape(fire_hvdm_pbjrvol_b, "HV+D+PBJ+RVOL Bull", shape.diamond, location.top, color.new(#E040FB, 50), -1, "HVD+PBJ\nRVOL", color.white, size=size.large)
plotshape(fire_hvdm_pbjcmb_b, "HV+D+PBJ+CMB Bull", shape.diamond, location.top, color.new(#7C4DFF, 50), -1, "HVD+PBJ\nCMB", color.white, size=size.large)
plotshape(fire_hvdm_2of3_b, "HV+D+PBJ 2of3 Bull", shape.labelup, location.top, color.new(#FF6D00, 50), -1, "HVD+PBJ\n2of3", color.white, size=size.large)
plotshape(fire_hvdm_3of3_b, "HV+D+PBJ 3of3 Bull", shape.labelup, location.top, color.new(#FFD700, 50), -1, "HVD+PBJ\n3of3", color.white, size=size.large)
plotshape(fire_hvdm_ppd_r, "HV+D+PPD Bear", shape.triangledown, location.bottom, color.new(#FF1744, 50), -1, "HVD\nPPD", color.white, size=size.large)
plotshape(fire_hvdm_rvol_r, "HV+D+RVOL Bear", shape.triangledown, location.bottom, color.new(#FF6D00, 50), -1, "HVD\nRVOL", color.white, size=size.large)
plotshape(fire_hvdm_cmb_r, "HV+D+CMB Bear", shape.triangledown, location.bottom, color.new(#9C27B0, 50), -1, "HVD\nCMB", color.white, size=size.large)
plotshape(fire_hvdm_pbjppd_r, "HV+D+PBJ+PPD Bear", shape.diamond, location.belowbar, color.new(#FF1744, 50), -1, "HVD+PBJ\nPPD", color.white, size=size.large)
plotshape(fire_hvdm_pbjrvol_r, "HV+D+PBJ+RVOL Bear", shape.diamond, location.belowbar, color.new(#E040FB, 50), -1, "HVD+PBJ\nRVOL", color.white, size=size.large)
plotshape(fire_hvdm_pbjcmb_r, "HV+D+PBJ+CMB Bear", shape.diamond, location.belowbar, color.new(#7C4DFF, 50), -1, "HVD+PBJ\nCMB", color.white, size=size.large)
plotshape(fire_hvdm_2of3_r, "HV+D+PBJ 2of3 Bear", shape.labeldown, location.belowbar, color.new(#FF6D00, 50), -1, "HVD+PBJ\n2of3", color.white, size=size.large)
plotshape(fire_hvdm_3of3_r, "HV+D+PBJ 3of3 Bear", shape.labeldown, location.belowbar, color.new(#FFD700, 50), -1, "HVD+PBJ\n3of3", color.white, size=size.large)

// ══════════════════════════════════════════════════════════════════════════════
// ALERTS — dynamic alert() only (alertcondition counts toward the 64-plot limit — suite standard).
// In TradingView create the alert with Condition = this indicator + "Any alert() function call".
// ══════════════════════════════════════════════════════════════════════════════

if conf
    string bs = ""
    string rs = ""
    string mHead = " | {{ticker}} {{interval}} |"
    string dT = " D=" + f1(d9_sigma)
    string dT1 = " D=" + f1(math.max(d9_sigma, d9_sigma1))
    string rT = " RVOL=" + f1(rv_normPrice)
    string vT = vrank != "" ? " VRANK=" + vrank : ""
    if fire_S1
        bs := f_cat(bs, "RVOL1X/GS+D9+PBJ")
    if fire_S2
        rs := f_cat(rs, "RVOL1X/MOAB+D9+PBJ")
    if fire_S3
        bs := f_cat(bs, "TYPHOON")
    if fire_S4
        rs := f_cat(rs, "TYPHOON")
    if fire_S5
        bs := f_cat(bs, "MUSASHI")
    if fire_S6
        rs := f_cat(rs, "MUSASHI")
    if fire_S7
        bs := f_cat(bs, "WHALE+PUP")
    if fire_S8
        rs := f_cat(rs, "WHALE+PPD")
    if fire_S9
        rs := f_cat(rs, "B2B_KRATOS+D9")
    if fire_S10
        bs := f_cat(bs, "B2B_SAAB+D9")
    if fire_S11
        bs := f_cat(bs, "DYNAMITE")
    if fire_S12
        rs := f_cat(rs, "DYNAMITE")
    if fire_S13
        bs := f_cat(bs, "IGNITE")
    if fire_S14
        rs := f_cat(rs, "IGNITE")
    if fire_S15
        bs := f_cat(bs, "NAG")
    if fire_S16
        bs := f_cat(bs, "B2B_NPM")
    if fire_S17
        rs := f_cat(rs, "B2B_NPM")
    if fire_S18
        bs := f_cat(bs, "B2B_PUP+D9")
    if fire_S19
        rs := f_cat(rs, "B2B_PPD+D9")
    if fire_S20
        bs := f_cat(bs, "B2B_FC")
    if fire_S21
        rs := f_cat(rs, "B2B_FC")
    if fire_S22
        bs := f_cat(bs, "D9_STUDY")
    if fire_S23
        rs := f_cat(rs, "D9_STUDY")
    if fire_S24
        bs := f_cat(bs, "UC+D9")
    if fire_S25
        rs := f_cat(rs, "UC+D9")
    if fire_S26
        bs := f_cat(bs, "B2B_ENR")
    if fire_S27
        rs := f_cat(rs, "B2B_ENR")
    if fire_co_bull_pbj
        bs := f_cat(bs, "CO_HVD+PBJ")
    if fire_co_bull_pb
        bs := f_cat(bs, "CO_HVD+PB")
    if fire_co_bear_pbj
        rs := f_cat(rs, "CO_HVD+PBJ")
    if fire_co_bear_pb
        rs := f_cat(rs, "CO_HVD+PB")
    if fire_b2b_bull_nopb
        bs := f_cat(bs, "B2B_HVD")
    if fire_b2b_bull_pbj
        bs := f_cat(bs, "B2B_HVD+PBJ")
    if fire_b2b_bull_pb
        bs := f_cat(bs, "B2B_HVD+PB")
    if fire_b2b_bear_nopb
        rs := f_cat(rs, "B2B_HVD")
    if fire_b2b_bear_pbj
        rs := f_cat(rs, "B2B_HVD+PBJ")
    if fire_b2b_bear_pb
        rs := f_cat(rs, "B2B_HVD+PB")
    if fire_hvdm_pup_b
        bs := f_cat(bs, "HVD+PUP")
    if fire_hvdm_rvol_b
        bs := f_cat(bs, "HVD+RVOL")
    if fire_hvdm_cmb_b
        bs := f_cat(bs, "HVD+CMB")
    if fire_hvdm_pbjpup_b
        bs := f_cat(bs, "HVD+PBJ+PUP")
    if fire_hvdm_pbjrvol_b
        bs := f_cat(bs, "HVD+PBJ+RVOL")
    if fire_hvdm_pbjcmb_b
        bs := f_cat(bs, "HVD+PBJ+CMB")
    if fire_hvdm_2of3_b
        bs := f_cat(bs, "HVD+PBJ_2of3")
    if fire_hvdm_3of3_b
        bs := f_cat(bs, "HVD+PBJ_3of3")
    if fire_hvdm_ppd_r
        rs := f_cat(rs, "HVD+PPD")
    if fire_hvdm_rvol_r
        rs := f_cat(rs, "HVD+RVOL")
    if fire_hvdm_cmb_r
        rs := f_cat(rs, "HVD+CMB")
    if fire_hvdm_pbjppd_r
        rs := f_cat(rs, "HVD+PBJ+PPD")
    if fire_hvdm_pbjrvol_r
        rs := f_cat(rs, "HVD+PBJ+RVOL")
    if fire_hvdm_pbjcmb_r
        rs := f_cat(rs, "HVD+PBJ+CMB")
    if fire_hvdm_2of3_r
        rs := f_cat(rs, "HVD+PBJ_2of3")
    if fire_hvdm_3of3_r
        rs := f_cat(rs, "HVD+PBJ_3of3")
    string coAll = bs == "" ? rs : (rs == "" ? bs : bs + "," + rs)
    if en_aggAlerts
        if str.length(bs) > 0
            alert(bs + " Bull" + mHead + vT + " FB=" + fbYN + (rs != "" ? " CO=" + rs : ""), alert.freq_once_per_bar_close)
        if str.length(rs) > 0
            alert(rs + " Bear" + mHead + vT + " FB=" + fbYN + (bs != "" ? " CO=" + bs : ""), alert.freq_once_per_bar_close)
    else
        if fire_S1
