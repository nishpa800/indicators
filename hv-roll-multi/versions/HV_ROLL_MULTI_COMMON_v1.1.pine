// ============================================================================
// === RAW TIER FLAGS (counting material only -- no own plot/alert) ===
// ============================================================================
// volume[1] == ta.highest(volume,N)[1] on the PRIOR CLOSED bar (non-repainting).
// Each flag is already the CUMULATIVE ">= N" class.
bool is50Bar = volume[1] == ta.highest(volume, 50)[1]
bool is100Bar = volume[1] == ta.highest(volume, 100)[1]
bool is150Bar = volume[1] == ta.highest(volume, 150)[1]
bool is200Bar = volume[1] == ta.highest(volume, 200)[1]
bool is250Bar = volume[1] == ta.highest(volume, 250)[1]
bool is300Bar = volume[1] == ta.highest(volume, 300)[1]
bool is400Bar = volume[1] == ta.highest(volume, 400)[1]
bool is500Bar = volume[1] == ta.highest(volume, 500)[1]
bool is750Bar = volume[1] == ta.highest(volume, 750)[1]
bool is1500Bar = volume[1] == ta.highest(volume, 1500)[1]

// ============================================================================
// === CLASS EVENTS (confirmed bars only) -- shared by every lane of a tier ===
// ============================================================================
bool conf = barstate.isconfirmed
bool evt_W5 = conf and is1500Bar   // W5 1.5K+ (>=)
bool evt_W7 = conf and is750Bar   // W7 750+ (>=)
bool evt_W8 = conf and is500Bar   // W8 500+ (>=)
bool evt_W9 = conf and is400Bar   // W9 400+ (>=)
bool evt_W10 = conf and is300Bar   // W10 300+ (>=)
bool evt_W11 = conf and is250Bar   // W11 250+ (>=)
bool evt_W12 = conf and is200Bar   // W12 200+ (>=)
bool evt_W13 = conf and is150Bar   // W13 150+ (>=)
bool evt_W14 = conf and is100Bar   // W14 100+ (>=)
bool evt_W15 = conf and is50Bar   // W15 50+ (>=)

// ============================================================================
// === ROLLING-WINDOW CLUSTER LANES (sliding trailing-N, leading-edge) ===
// ============================================================================
// nXy = events of the tier class in trailing wXy_win bars.  cXy = nXy >= count.
// fire_WXy = leading edge of cXy (fires once when that lane's cluster completes).
float n5a = f_roll_count(evt_W5, w5a_win)
float n5b = f_roll_count(evt_W5, w5b_win)
float n7a = f_roll_count(evt_W7, w7a_win)
float n7b = f_roll_count(evt_W7, w7b_win)
float n8a = f_roll_count(evt_W8, w8a_win)
float n8b = f_roll_count(evt_W8, w8b_win)
float n9a = f_roll_count(evt_W9, w9a_win)
float n9b = f_roll_count(evt_W9, w9b_win)
float n10a = f_roll_count(evt_W10, w10a_win)
float n10b = f_roll_count(evt_W10, w10b_win)
float n11a = f_roll_count(evt_W11, w11a_win)
float n11b = f_roll_count(evt_W11, w11b_win)
float n12a = f_roll_count(evt_W12, w12a_win)
float n12b = f_roll_count(evt_W12, w12b_win)
float n13a = f_roll_count(evt_W13, w13a_win)
float n13b = f_roll_count(evt_W13, w13b_win)
float n14a = f_roll_count(evt_W14, w14a_win)
float n14b = f_roll_count(evt_W14, w14b_win)
float n15a = f_roll_count(evt_W15, w15a_win)
float n15b = f_roll_count(evt_W15, w15b_win)

bool c5a = n5a >= w5a_cnt
bool c5b = n5b >= w5b_cnt
bool c7a = n7a >= w7a_cnt
bool c7b = n7b >= w7b_cnt
bool c8a = n8a >= w8a_cnt
bool c8b = n8b >= w8b_cnt
bool c9a = n9a >= w9a_cnt
bool c9b = n9b >= w9b_cnt
bool c10a = n10a >= w10a_cnt
bool c10b = n10b >= w10b_cnt
bool c11a = n11a >= w11a_cnt
bool c11b = n11b >= w11b_cnt
bool c12a = n12a >= w12a_cnt
bool c12b = n12b >= w12b_cnt
bool c13a = n13a >= w13a_cnt
bool c13b = n13b >= w13b_cnt
bool c14a = n14a >= w14a_cnt
bool c14b = n14b >= w14b_cnt
bool c15a = n15a >= w15a_cnt
bool c15b = n15b >= w15b_cnt

bool fire_W5a = w5a_on and c5a and not c5a[1]
bool fire_W5b = w5b_on and c5b and not c5b[1]
bool fire_W7a = w7a_on and c7a and not c7a[1]
bool fire_W7b = w7b_on and c7b and not c7b[1]
bool fire_W8a = w8a_on and c8a and not c8a[1]
bool fire_W8b = w8b_on and c8b and not c8b[1]
bool fire_W9a = w9a_on and c9a and not c9a[1]
bool fire_W9b = w9b_on and c9b and not c9b[1]
bool fire_W10a = w10a_on and c10a and not c10a[1]
bool fire_W10b = w10b_on and c10b and not c10b[1]
bool fire_W11a = w11a_on and c11a and not c11a[1]
bool fire_W11b = w11b_on and c11b and not c11b[1]
bool fire_W12a = w12a_on and c12a and not c12a[1]
bool fire_W12b = w12b_on and c12b and not c12b[1]
bool fire_W13a = w13a_on and c13a and not c13a[1]
bool fire_W13b = w13b_on and c13b and not c13b[1]
bool fire_W14a = w14a_on and c14a and not c14a[1]
bool fire_W14b = w14b_on and c14b and not c14b[1]
bool fire_W15a = w15a_on and c15a and not c15a[1]
bool fire_W15b = w15b_on and c15b and not c15b[1]

// ============================================================================
// === PLOTS -- every lane is a REAL plotshape (dp:vp 1:1; offset=-1 lands on
// === the closed bar that completed the cluster). Lanes are independent:
// === several can light the same bar -- that overlap IS the motion signal.
// ============================================================================
plotshape(fire_W5a, "W5a 1.5K+ 2x", shape.circle, location.bottom, w5a_col, size=size.small, text="1.5K+", textcolor=color.white, offset=-1)
plotshape(fire_W5b, "W5b 1.5K+ 4x", shape.circle, location.belowbar, w5b_col, size=size.tiny, text="1.5K+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W7a, "W7a 750+ 2x", shape.square, location.bottom, w7a_col, size=size.small, text="750+", textcolor=color.white, offset=-1)
plotshape(fire_W7b, "W7b 750+ 4x", shape.square, location.belowbar, w7b_col, size=size.tiny, text="750+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W8a, "W8a 500+ 2x", shape.triangleup, location.bottom, w8a_col, size=size.small, text="500+", textcolor=color.white, offset=-1)
plotshape(fire_W8b, "W8b 500+ 4x", shape.triangleup, location.belowbar, w8b_col, size=size.tiny, text="500+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W9a, "W9a 400+ 2x", shape.triangledown, location.bottom, w9a_col, size=size.small, text="400+", textcolor=color.white, offset=-1)
plotshape(fire_W9b, "W9b 400+ 4x", shape.triangledown, location.belowbar, w9b_col, size=size.tiny, text="400+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W10a, "W10a 300+ 2x", shape.cross, location.bottom, w10a_col, size=size.small, text="300+", textcolor=color.white, offset=-1)
plotshape(fire_W10b, "W10b 300+ 4x", shape.cross, location.belowbar, w10b_col, size=size.tiny, text="300+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W11a, "W11a 250+ 2x", shape.xcross, location.bottom, w11a_col, size=size.small, text="250+", textcolor=color.white, offset=-1)
plotshape(fire_W11b, "W11b 250+ 4x", shape.xcross, location.belowbar, w11b_col, size=size.tiny, text="250+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W12a, "W12a 200+ 2x", shape.flag, location.bottom, w12a_col, size=size.small, text="200+", textcolor=color.white, offset=-1)
plotshape(fire_W12b, "W12b 200+ 4x", shape.flag, location.belowbar, w12b_col, size=size.tiny, text="200+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W13a, "W13a 150+ 2x", shape.arrowup, location.bottom, w13a_col, size=size.small, text="150+", textcolor=color.white, offset=-1)
plotshape(fire_W13b, "W13b 150+ 4x", shape.arrowup, location.belowbar, w13b_col, size=size.tiny, text="150+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W14a, "W14a 100+ 2x", shape.arrowdown, location.bottom, w14a_col, size=size.small, text="100+", textcolor=color.white, offset=-1)
plotshape(fire_W14b, "W14b 100+ 4x", shape.arrowdown, location.belowbar, w14b_col, size=size.tiny, text="100+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W15a, "W15a 50+ 2x", shape.diamond, location.bottom, w15a_col, size=size.small, text="50+", textcolor=color.white, offset=-1)
plotshape(fire_W15b, "W15b 50+ 4x", shape.diamond, location.belowbar, w15b_col, size=size.tiny, text="50+ 4x", textcolor=color.white, offset=-1)

// ============================================================================
// === ALERTS -- one per lane (1:1 with plots), plus ANY + any-call() ===
// ============================================================================
alertcondition(fire_W5a, "W5a 1.5K+ baseline 2x-density cluster", "W5a: 1.5K+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W5b, "W5b 1.5K+ tight 4x-density cluster", "W5b: 1.5K+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W7a, "W7a 750+ baseline 2x-density cluster", "W7a: 750+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W7b, "W7b 750+ tight 4x-density cluster", "W7b: 750+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W8a, "W8a 500+ baseline 2x-density cluster", "W8a: 500+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W8b, "W8b 500+ tight 4x-density cluster", "W8b: 500+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W9a, "W9a 400+ baseline 2x-density cluster", "W9a: 400+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W9b, "W9b 400+ tight 4x-density cluster", "W9b: 400+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W10a, "W10a 300+ baseline 2x-density cluster", "W10a: 300+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W10b, "W10b 300+ tight 4x-density cluster", "W10b: 300+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W11a, "W11a 250+ baseline 2x-density cluster", "W11a: 250+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W11b, "W11b 250+ tight 4x-density cluster", "W11b: 250+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W12a, "W12a 200+ baseline 2x-density cluster", "W12a: 200+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W12b, "W12b 200+ tight 4x-density cluster", "W12b: 200+ tight 4x-density cluster on {{ticker}}")
