alertcondition(fire_W15b, "W15b 50+ tight 4x-density cluster", "W15b: 50+ tight 4x-density cluster on {{ticker}}")

bool any_fire = fire_W5a or fire_W5b or fire_W7a or fire_W7b or fire_W8a or fire_W8b or fire_W9a or fire_W9b or fire_W10a or fire_W10b or fire_W11a or fire_W11b or fire_W12a or fire_W12b or fire_W13a or fire_W13b or fire_W14a or fire_W14b or fire_W15a or fire_W15b
alertcondition(any_fire, "ANY HVRM COMMON lane", "ANY HVRM COMMON HV rolling-cluster lane fired on {{ticker}}")

// any-call alert() function: set ONE TradingView alert to "Any alert() function
// call" and it catches every lane. Payload names which lanes fired this bar.
if any_fire and conf
    string m = ""
    m := fire_W5a ? m + "1.5K+(2x) " : m
    m := fire_W5b ? m + "1.5K+(4x) " : m
    m := fire_W7a ? m + "750+(2x) " : m
    m := fire_W7b ? m + "750+(4x) " : m
    m := fire_W8a ? m + "500+(2x) " : m
    m := fire_W8b ? m + "500+(4x) " : m
    m := fire_W9a ? m + "400+(2x) " : m
    m := fire_W9b ? m + "400+(4x) " : m
    m := fire_W10a ? m + "300+(2x) " : m
    m := fire_W10b ? m + "300+(4x) " : m
    m := fire_W11a ? m + "250+(2x) " : m
    m := fire_W11b ? m + "250+(4x) " : m
    m := fire_W12a ? m + "200+(2x) " : m
    m := fire_W12b ? m + "200+(4x) " : m
    m := fire_W13a ? m + "150+(2x) " : m
    m := fire_W13b ? m + "150+(4x) " : m
    m := fire_W14a ? m + "100+(2x) " : m
    m := fire_W14b ? m + "100+(4x) " : m
    m := fire_W15a ? m + "50+(2x) " : m
    m := fire_W15b ? m + "50+(4x) " : m
    alert("HV_ROLL_COMMON|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|FIRED:" + m, alert.freq_once_per_bar_close)

