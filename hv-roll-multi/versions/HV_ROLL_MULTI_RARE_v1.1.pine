//@version=5
// [v1.1 2026-08-12] ALL diagnostic plot() count lines REMOVED (operator order; RE10140 65/83 refused v1). TRUE TV UNIT LAW: 2×text-plotshape + plot() + alertcondition ≤ 64. NO diagnostic/count plot() lines EVER AGAIN.
// ============================================================================
// HV ROLL MULTI -- RARE member: 5 rare tiers x 3 lanes = 15 dp:vp
// ============================================================================
// PAIR MEMBER 1 (RARE) of the HV ROLL MULTI study pair (split mandated by the
// 64-output budget: 35 text-bearing plotshapes = 70 TV output units in one
// study -- a plotshape carrying text counts as 2 units (P-011) -- so the
// lawful design is a STUDY SPLIT, L-61 precedent, never a pane label).
//   RARE   member: W1 HEV, W2 4K+, W3 3K+, W4 2K+, W6 1K+  -- 3 lanes each.
//   COMMON member: W5 1.5K+, W7 750+ .. W15 50+            -- 2 lanes each.
//
// LANES PER TIER (every lane = its own dp:vp:alert conglomeration -- one
// boolean drives plot AND alert, 1:1, can never desync):
//   a  "2x"  BASELINE -- OG defaults: COUNT events in W = round(COUNT*N/2)
//            bars == ~2x random density (Poisson: P(N-bar high) ~ 1/N).
//   b  "4x"  TIGHT    -- same COUNT, HALF the window == ~4x random density.
//            Sharper burst; fires only on violent clustering.
//   c  "3ev" SUSTAINED -- COUNT+1 events in W = round((COUNT+1)*N/2) bars:
//            a longer campaign at 2x density (4K+ window capped at 5000 by
//            max_bars_back).
//
// VISUAL IDENTITY (no two lanes anywhere in the pair share shape+location;
// every visual plot has its own input.color):
//   W1a  HEV 2x    shape.diamond      location.top       size.large
//   W1b  HEV 4x    shape.diamond      location.abovebar  size.small
//   W1c  HEV 3ev   shape.labelup      location.top       size.normal
//   W2a  4K+ 2x    shape.circle       location.top       size.large
//   W2b  4K+ 4x    shape.circle       location.abovebar  size.small
//   W2c  4K+ 3ev   shape.flag         location.top       size.normal
//   W3a  3K+ 2x    shape.square       location.top       size.large
//   W3b  3K+ 4x    shape.square       location.abovebar  size.small
//   W3c  3K+ 3ev   shape.xcross       location.top       size.normal
//   W4a  2K+ 2x    shape.triangleup   location.top       size.large
//   W4b  2K+ 4x    shape.triangleup   location.abovebar  size.small
//   W4c  2K+ 3ev   shape.triangledown location.top       size.normal
//   W6a  1K+ 2x    shape.cross        location.top       size.large
//   W6b  1K+ 4x    shape.cross        location.abovebar  size.small
//   W6c  1K+ 3ev   shape.arrowup      location.top       size.normal
//
// NON-REPAINTING (NRA) + CONSTITUTIONAL ROLLING WINDOWS -- unchanged from OG:
//   * Tiers compare the PRIOR CLOSED bar: volume[1] == ta.highest(volume,N)[1].
//   * Counting gated on barstate.isconfirmed (closed bars only).
//   * TRUE SLIDING trailing-N moving sum (math.sum, O(1)/bar), never anchored.
//   * Fire = LEADING EDGE of (n >= COUNT): cond and not cond[1].
//   * Markers plot offset=-1 onto the closed bar that completed the cluster.
//   * Chart domain: DUAL (time and tick) -- pure volume/bar-count logic, no
//     session or clock anchors, so the build is identical on both chart types.
//
// OUTPUT BUDGET (P-011 unit math: plotshape+text=2, ac=0):
//   15 detection plotshapes x2 = 30 / 64 (NOTHING else plotted)
// ZERO plain plot() lines by LAW: no data-window count/motion telemetry plots,
// ever -- they burn Style-tab rows and plot budget (operator ban 2026-08-12).
// Every output unit in this study is a dp:vp detection marker. Nothing else.
//
// GENERATED by gen_hv_roll_multi.py (scratchpad) from "hv roll OG.txt" --
// edit the generator, not this file. ASCII-only source.
// ============================================================================

indicator("HV ROLL MULTI RARE (HEV/4K/3K/2K/1K x3 lanes) NRA", shorttitle="HVRM RARE", overlay=true, max_bars_back=5000)

// --- Rolling SLIDING count: TRUE events over the trailing `len` bars.
f_roll_count(cond, len) => nz(math.sum(cond ? 1.0 : 0.0, math.max(1, len)))

// ============================================================================
// === INPUTS -- per lane: Enable + COUNT + within BARS + Color ===
// ============================================================================
// a lanes ship the OG defaults (2x density). b lanes = half window (4x).
// c lanes = COUNT+1 within round((COUNT+1)*N/2) bars (sustained campaign).
grp1 = "W1: HEV / Nagasaki (all-time-high vol) -- 3 lanes"
w1a_on  = input.bool(true, "Enable HEV 2x", group=grp1)
w1a_cnt = input.int(2, "Count (events)", minval=1, inline="w1a", group=grp1)
w1a_win = input.int(1000, "within Bars", minval=1, maxval=5000, inline="w1a", group=grp1)
w1a_col = input.color(color.rgb(156, 39, 176), "", inline="w1a", group=grp1)
w1b_on  = input.bool(true, "Enable HEV 4x", group=grp1)
w1b_cnt = input.int(2, "Count (events)", minval=1, inline="w1b", group=grp1)
w1b_win = input.int(500, "within Bars", minval=1, maxval=5000, inline="w1b", group=grp1)
w1b_col = input.color(color.rgb(201, 84, 221), "", inline="w1b", group=grp1)
w1c_on  = input.bool(true, "Enable HEV 3ev", group=grp1)
w1c_cnt = input.int(3, "Count (events)", minval=1, inline="w1c", group=grp1)
w1c_win = input.int(1500, "within Bars", minval=1, maxval=5000, inline="w1c", group=grp1)
w1c_col = input.color(color.rgb(111, 0, 131), "", inline="w1c", group=grp1)
grp2 = "W2: 4000-bar high or greater -- 3 lanes"
w2a_on  = input.bool(true, "Enable 4K+ 2x", group=grp2)
w2a_cnt = input.int(2, "Count (events)", minval=1, inline="w2a", group=grp2)
w2a_win = input.int(4000, "within Bars", minval=1, maxval=5000, inline="w2a", group=grp2)
w2a_col = input.color(color.rgb(240, 45, 55), "", inline="w2a", group=grp2)
w2b_on  = input.bool(true, "Enable 4K+ 4x", group=grp2)
w2b_cnt = input.int(2, "Count (events)", minval=1, inline="w2b", group=grp2)
w2b_win = input.int(2000, "within Bars", minval=1, maxval=5000, inline="w2b", group=grp2)
w2b_col = input.color(color.rgb(255, 90, 100), "", inline="w2b", group=grp2)
w2c_on  = input.bool(true, "Enable 4K+ 3ev", group=grp2)
w2c_cnt = input.int(3, "Count (events)", minval=1, inline="w2c", group=grp2)
w2c_win = input.int(5000, "within Bars", minval=1, maxval=5000, inline="w2c", group=grp2)
w2c_col = input.color(color.rgb(195, 0, 10), "", inline="w2c", group=grp2)
grp3 = "W3: 3000-bar high or greater -- 3 lanes"
w3a_on  = input.bool(true, "Enable 3K+ 2x", group=grp3)
w3a_cnt = input.int(2, "Count (events)", minval=1, inline="w3a", group=grp3)
w3a_win = input.int(3000, "within Bars", minval=1, maxval=5000, inline="w3a", group=grp3)
w3a_col = input.color(color.rgb(224, 45, 71), "", inline="w3a", group=grp3)
w3b_on  = input.bool(true, "Enable 3K+ 4x", group=grp3)
w3b_cnt = input.int(2, "Count (events)", minval=1, inline="w3b", group=grp3)
w3b_win = input.int(1500, "within Bars", minval=1, maxval=5000, inline="w3b", group=grp3)
w3b_col = input.color(color.rgb(255, 90, 116), "", inline="w3b", group=grp3)
w3c_on  = input.bool(true, "Enable 3K+ 3ev", group=grp3)
w3c_cnt = input.int(3, "Count (events)", minval=1, inline="w3c", group=grp3)
w3c_win = input.int(4500, "within Bars", minval=1, maxval=5000, inline="w3c", group=grp3)
w3c_col = input.color(color.rgb(179, 0, 26), "", inline="w3c", group=grp3)
grp4 = "W4: 2000-bar high or greater -- 3 lanes"
w4a_on  = input.bool(true, "Enable 2K+ 2x", group=grp4)
w4a_cnt = input.int(2, "Count (events)", minval=1, inline="w4a", group=grp4)
w4a_win = input.int(2000, "within Bars", minval=1, maxval=5000, inline="w4a", group=grp4)
w4a_col = input.color(color.rgb(209, 45, 86), "", inline="w4a", group=grp4)
w4b_on  = input.bool(true, "Enable 2K+ 4x", group=grp4)
w4b_cnt = input.int(2, "Count (events)", minval=1, inline="w4b", group=grp4)
w4b_win = input.int(1000, "within Bars", minval=1, maxval=5000, inline="w4b", group=grp4)
w4b_col = input.color(color.rgb(254, 90, 131), "", inline="w4b", group=grp4)
w4c_on  = input.bool(true, "Enable 2K+ 3ev", group=grp4)
w4c_cnt = input.int(3, "Count (events)", minval=1, inline="w4c", group=grp4)
w4c_win = input.int(3000, "within Bars", minval=1, maxval=5000, inline="w4c", group=grp4)
w4c_col = input.color(color.rgb(164, 0, 41), "", inline="w4c", group=grp4)
grp6 = "W6: 1000-bar high or greater -- 3 lanes"
w6a_on  = input.bool(true, "Enable 1K+ 2x", group=grp6)
w6a_cnt = input.int(2, "Count (events)", minval=1, inline="w6a", group=grp6)
w6a_win = input.int(1000, "within Bars", minval=1, maxval=5000, inline="w6a", group=grp6)
w6a_col = input.color(color.rgb(178, 45, 117), "", inline="w6a", group=grp6)
w6b_on  = input.bool(true, "Enable 1K+ 4x", group=grp6)
w6b_cnt = input.int(2, "Count (events)", minval=1, inline="w6b", group=grp6)
w6b_win = input.int(500, "within Bars", minval=1, maxval=5000, inline="w6b", group=grp6)
w6b_col = input.color(color.rgb(223, 90, 162), "", inline="w6b", group=grp6)
w6c_on  = input.bool(true, "Enable 1K+ 3ev", group=grp6)
w6c_cnt = input.int(3, "Count (events)", minval=1, inline="w6c", group=grp6)
w6c_win = input.int(1500, "within Bars", minval=1, maxval=5000, inline="w6c", group=grp6)
w6c_col = input.color(color.rgb(133, 0, 72), "", inline="w6c", group=grp6)

// ============================================================================
// === RAW TIER FLAGS (counting material only -- no own plot/alert) ===
// ============================================================================
// volume[1] == ta.highest(volume,N)[1] on the PRIOR CLOSED bar (non-repainting).
// Each flag is already the CUMULATIVE ">= N" class.
bool is1000Bar = volume[1] == ta.highest(volume, 1000)[1]
bool is2000Bar = volume[1] == ta.highest(volume, 2000)[1]
bool is3000Bar = volume[1] == ta.highest(volume, 3000)[1]
bool is4000Bar = volume[1] == ta.highest(volume, 4000)[1]

// All-time-high volume (HEV == Nagasaki) -- running max over CONFIRMED bars only.
var float maxVolEver = 0.0
bool isHEV = false
if volume[1] > maxVolEver
    maxVolEver := volume[1]
    isHEV := true
bool isNagasaki = isHEV

// ============================================================================
// === CLASS EVENTS (confirmed bars only) -- shared by every lane of a tier ===
// ============================================================================
bool conf = barstate.isconfirmed
bool evt_W1 = conf and isHEV   // W1 HEV (>=)
bool evt_W2 = conf and is4000Bar   // W2 4K+ (>=)
bool evt_W3 = conf and is3000Bar   // W3 3K+ (>=)
bool evt_W4 = conf and is2000Bar   // W4 2K+ (>=)
bool evt_W6 = conf and is1000Bar   // W6 1K+ (>=)

// ============================================================================
// === ROLLING-WINDOW CLUSTER LANES (sliding trailing-N, leading-edge) ===
// ============================================================================
// nXy = events of the tier class in trailing wXy_win bars.  cXy = nXy >= count.
// fire_WXy = leading edge of cXy (fires once when that lane's cluster completes).
float n1a = f_roll_count(evt_W1, w1a_win)
float n1b = f_roll_count(evt_W1, w1b_win)
float n1c = f_roll_count(evt_W1, w1c_win)
float n2a = f_roll_count(evt_W2, w2a_win)
float n2b = f_roll_count(evt_W2, w2b_win)
float n2c = f_roll_count(evt_W2, w2c_win)
float n3a = f_roll_count(evt_W3, w3a_win)
float n3b = f_roll_count(evt_W3, w3b_win)
float n3c = f_roll_count(evt_W3, w3c_win)
float n4a = f_roll_count(evt_W4, w4a_win)
float n4b = f_roll_count(evt_W4, w4b_win)
float n4c = f_roll_count(evt_W4, w4c_win)
float n6a = f_roll_count(evt_W6, w6a_win)
float n6b = f_roll_count(evt_W6, w6b_win)
float n6c = f_roll_count(evt_W6, w6c_win)

bool c1a = n1a >= w1a_cnt
bool c1b = n1b >= w1b_cnt
bool c1c = n1c >= w1c_cnt
bool c2a = n2a >= w2a_cnt
bool c2b = n2b >= w2b_cnt
bool c2c = n2c >= w2c_cnt
bool c3a = n3a >= w3a_cnt
bool c3b = n3b >= w3b_cnt
bool c3c = n3c >= w3c_cnt
bool c4a = n4a >= w4a_cnt
bool c4b = n4b >= w4b_cnt
bool c4c = n4c >= w4c_cnt
bool c6a = n6a >= w6a_cnt
bool c6b = n6b >= w6b_cnt
bool c6c = n6c >= w6c_cnt

bool fire_W1a = w1a_on and c1a and not c1a[1]
bool fire_W1b = w1b_on and c1b and not c1b[1]
bool fire_W1c = w1c_on and c1c and not c1c[1]
bool fire_W2a = w2a_on and c2a and not c2a[1]
bool fire_W2b = w2b_on and c2b and not c2b[1]
bool fire_W2c = w2c_on and c2c and not c2c[1]
bool fire_W3a = w3a_on and c3a and not c3a[1]
bool fire_W3b = w3b_on and c3b and not c3b[1]
bool fire_W3c = w3c_on and c3c and not c3c[1]
bool fire_W4a = w4a_on and c4a and not c4a[1]
bool fire_W4b = w4b_on and c4b and not c4b[1]
bool fire_W4c = w4c_on and c4c and not c4c[1]
bool fire_W6a = w6a_on and c6a and not c6a[1]
bool fire_W6b = w6b_on and c6b and not c6b[1]
bool fire_W6c = w6c_on and c6c and not c6c[1]

// ============================================================================
// === PLOTS -- every lane is a REAL plotshape (dp:vp 1:1; offset=-1 lands on
// === the closed bar that completed the cluster). Lanes are independent:
// === several can light the same bar -- that overlap IS the motion signal.
// ============================================================================
plotshape(fire_W1a, "W1a HEV 2x", shape.diamond, location.top, w1a_col, size=size.large, text="HEV", textcolor=color.white, offset=-1)
plotshape(fire_W1b, "W1b HEV 4x", shape.diamond, location.abovebar, w1b_col, size=size.small, text="HEV 4x", textcolor=color.white, offset=-1)
plotshape(fire_W1c, "W1c HEV 3ev", shape.labelup, location.top, w1c_col, size=size.normal, text="HEV 3ev", textcolor=color.white, offset=-1)
plotshape(fire_W2a, "W2a 4K+ 2x", shape.circle, location.top, w2a_col, size=size.large, text="4K+", textcolor=color.white, offset=-1)
plotshape(fire_W2b, "W2b 4K+ 4x", shape.circle, location.abovebar, w2b_col, size=size.small, text="4K+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W2c, "W2c 4K+ 3ev", shape.flag, location.top, w2c_col, size=size.normal, text="4K+ 3ev", textcolor=color.white, offset=-1)
plotshape(fire_W3a, "W3a 3K+ 2x", shape.square, location.top, w3a_col, size=size.large, text="3K+", textcolor=color.white, offset=-1)
plotshape(fire_W3b, "W3b 3K+ 4x", shape.square, location.abovebar, w3b_col, size=size.small, text="3K+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W3c, "W3c 3K+ 3ev", shape.xcross, location.top, w3c_col, size=size.normal, text="3K+ 3ev", textcolor=color.white, offset=-1)
plotshape(fire_W4a, "W4a 2K+ 2x", shape.triangleup, location.top, w4a_col, size=size.large, text="2K+", textcolor=color.white, offset=-1)
plotshape(fire_W4b, "W4b 2K+ 4x", shape.triangleup, location.abovebar, w4b_col, size=size.small, text="2K+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W4c, "W4c 2K+ 3ev", shape.triangledown, location.top, w4c_col, size=size.normal, text="2K+ 3ev", textcolor=color.white, offset=-1)
plotshape(fire_W6a, "W6a 1K+ 2x", shape.cross, location.top, w6a_col, size=size.large, text="1K+", textcolor=color.white, offset=-1)
plotshape(fire_W6b, "W6b 1K+ 4x", shape.cross, location.abovebar, w6b_col, size=size.small, text="1K+ 4x", textcolor=color.white, offset=-1)
plotshape(fire_W6c, "W6c 1K+ 3ev", shape.arrowup, location.top, w6c_col, size=size.normal, text="1K+ 3ev", textcolor=color.white, offset=-1)

// ============================================================================
// === ALERTS -- one per lane (1:1 with plots), plus ANY + any-call() ===
// ============================================================================
alertcondition(fire_W1a, "W1a HEV baseline 2x-density cluster", "W1a: HEV baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W1b, "W1b HEV tight 4x-density cluster", "W1b: HEV tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W1c, "W1c HEV sustained 3-event cluster", "W1c: HEV sustained 3-event cluster on {{ticker}}")
alertcondition(fire_W2a, "W2a 4K+ baseline 2x-density cluster", "W2a: 4K+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W2b, "W2b 4K+ tight 4x-density cluster", "W2b: 4K+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W2c, "W2c 4K+ sustained 3-event cluster", "W2c: 4K+ sustained 3-event cluster on {{ticker}}")
alertcondition(fire_W3a, "W3a 3K+ baseline 2x-density cluster", "W3a: 3K+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W3b, "W3b 3K+ tight 4x-density cluster", "W3b: 3K+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W3c, "W3c 3K+ sustained 3-event cluster", "W3c: 3K+ sustained 3-event cluster on {{ticker}}")
alertcondition(fire_W4a, "W4a 2K+ baseline 2x-density cluster", "W4a: 2K+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W4b, "W4b 2K+ tight 4x-density cluster", "W4b: 2K+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W4c, "W4c 2K+ sustained 3-event cluster", "W4c: 2K+ sustained 3-event cluster on {{ticker}}")
alertcondition(fire_W6a, "W6a 1K+ baseline 2x-density cluster", "W6a: 1K+ baseline 2x-density cluster on {{ticker}}")
alertcondition(fire_W6b, "W6b 1K+ tight 4x-density cluster", "W6b: 1K+ tight 4x-density cluster on {{ticker}}")
alertcondition(fire_W6c, "W6c 1K+ sustained 3-event cluster", "W6c: 1K+ sustained 3-event cluster on {{ticker}}")

bool any_fire = fire_W1a or fire_W1b or fire_W1c or fire_W2a or fire_W2b or fire_W2c or fire_W3a or fire_W3b or fire_W3c or fire_W4a or fire_W4b or fire_W4c or fire_W6a or fire_W6b or fire_W6c
alertcondition(any_fire, "ANY HVRM RARE lane", "ANY HVRM RARE HV rolling-cluster lane fired on {{ticker}}")

// any-call alert() function: set ONE TradingView alert to "Any alert() function
// call" and it catches every lane. Payload names which lanes fired this bar.
if any_fire and conf
    string m = ""
    m := fire_W1a ? m + "HEV(2x) " : m
    m := fire_W1b ? m + "HEV(4x) " : m
    m := fire_W1c ? m + "HEV(3ev) " : m
    m := fire_W2a ? m + "4K+(2x) " : m
    m := fire_W2b ? m + "4K+(4x) " : m
    m := fire_W2c ? m + "4K+(3ev) " : m
    m := fire_W3a ? m + "3K+(2x) " : m
    m := fire_W3b ? m + "3K+(4x) " : m
    m := fire_W3c ? m + "3K+(3ev) " : m
    m := fire_W4a ? m + "2K+(2x) " : m
    m := fire_W4b ? m + "2K+(4x) " : m
    m := fire_W4c ? m + "2K+(3ev) " : m
    m := fire_W6a ? m + "1K+(2x) " : m
    m := fire_W6b ? m + "1K+(4x) " : m
    m := fire_W6c ? m + "1K+(3ev) " : m
    alert("HV_ROLL_RARE|TICKER:" + syminfo.ticker + "|TF:" + timeframe.period + "|FIRED:" + m, alert.freq_once_per_bar_close)

// ============================================================================
// === EXPORTS (for combination / fire-matrix consumers) ===
// ============================================================================
// Lane fires (bool):   fire_W1a, fire_W1b, fire_W1c, fire_W2a, fire_W2b, fire_W2c, fire_W3a, fire_W3b, fire_W3c, fire_W4a, fire_W4b, fire_W4c, fire_W6a, fire_W6b, fire_W6c
// Lane counts (float, internal series only -- NOT plotted): n1a, n1b, n1c, n2a, n2b, n2c, n3a, n3b, n3c, n4a, n4b, n4c, n6a, n6b, n6c
