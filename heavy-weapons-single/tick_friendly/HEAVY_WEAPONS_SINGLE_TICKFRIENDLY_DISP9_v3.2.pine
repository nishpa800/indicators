plotshape(fn_bullActive, title="FAUNA Bull +disp+LONG", style=shape.labelup,   location=location.belowbar, size=size.normal, color=fn_bullColor, text="FN +disp+LONG", textcolor=color.white)
plotshape(fn_bearActive, title="FAUNA Bear +disp+SHORT", style=shape.labeldown, location=location.abovebar, size=size.normal, color=fn_bearColor, text="FN +disp+SHORT", textcolor=color.white)

// =============================================================================
// PLOTS — DISPLACEMENT (standalone, offset=-1 to mark the displaced bar)
