//@version=5
// =============================================================================
// VERSION: Heavy Weapons Single v3.2 [tick-friendly] DISP 9 (2026-08-18) — W-INDSTUDY transform (L-49 lane).
// Base: heavy-weapons-single/sources/HW_v3_TF9_DISP9_operator-live_2026-07-23.txt
//   = the operator's LIVE "HW v3 TF 9" export (CRLF sha256 16b547d942ef5dad3ba4310cf838e6913e9c2d9d39f5cdc6bbecba34927f2d62), CRLF->LF normalized at intake
//   (LF sha256 7433cce8fc7eeab21c2d098aa5f123d7601c41537cc86669b0e89f61a7dd0824). LINEAGE NOTE: this is the DISP-9 build (D9 studies + Pent+D), NOT the june7-based
//   v3.1 — v3.1's master 4K/NAGA VP gate is NOT carried; nothing beyond the list below was changed.
// THE v3.2 WAVE (operator order 2026-08-18):
//   1. ALERT IFF CHECKBOX — every alert line is emitted IFF its lane checkbox is ON. Base defect: four
//      alert branches (HCT Bull, HCT Bear, PENT+HV1K+DISP, PENT+HV500+DISP) carried NO checkbox term —
//      the operator received Pentagon alerts with both boxes unchecked. Every alert branch now carries
//      the IDENTICAL boolean as its plotshape (chart == alert, L-63); gate: hw_alert_iff_gate.py.
//   2. Pent+HV1K+D  -> Pent+4K+D   (4K = bar[0] volume == highest(volume, 4K lookback), default 4000, editable).
//   3. Pent+HV500+D -> Pent+NAGA+D (Nagasaki = all-time-high volume on bar[0]).
//   4. NEW Naga + ANY Bull / Naga + ANY Bear — Nagasaki + >=1 same-candle bullish/bearish HW detection
//      (partners read at DETECTION level, checkbox-independent); the alert line NAMES every partner.
//   5. DEFAULTS = the operator's screenshots (2026-08-18 10:07:42 / 10:08:02); census gate:
//      validation/wrappers/study_defaults_gate.py + validation/indstudy/hw_v32_defaults_expected.json.
// Version control: heavy-weapons-single/CHANGELOG.md - github.com/nishpa800/indicators
// =============================================================================
// Pine is a Pine Editor tick-friendly
// NINE NINES tick-friendly conversion of "Heavy Weapons Single v3".
// RE10023 guards added: tv_ta.relativeVolume anchor forced to "D" on tick charts,
// and timeframe.in_seconds() given a tick fallback. Detection plots unchanged.
indicator("Heavy Weapons Single v3.2 [tick-friendly] DISP 9", shorttitle="HW3.2TF D9", overlay=true, max_bars_back=5000)

import TradingView/ta/7 as tv_ta

// ── RE10023 TICK GUARDS ──────────────────────────────────────────────────────
// Detect a tick chart by the "T" suffix on timeframe.period (authoritative: on a
// 1000T chart timeframe.in_seconds returns a POSITIVE number, so in_seconds alone
// silently fails). On tick, coerce a blank/tick anchor to "D"; on time charts keep
// the original anchor so time-chart parity is preserved.
int    nn_tfSecRaw   = timeframe.in_seconds(timeframe.period)
bool   nn_isTick     = str.endswith(timeframe.period, "T") or na(nn_tfSecRaw) or nn_tfSecRaw <= 0
int    nn_TICK_FB    = 10

// =============================================================================
// GLOBAL PLOT/ALERT TOGGLES
// =============================================================================
grp_global = "★ GLOBAL PLOT/ALERT TOGGLES ★"

show_SAAB       = input.bool(false, "SAAB", group=grp_global, inline="rv1")
show_Kratos     = input.bool(false, "Kratos", group=grp_global, inline="rv1")
show_BullRVOL1x = input.bool(false, "Bull RVOL 1x", group=grp_global, inline="rv1")
show_BearRVOL1x = input.bool(false, "Bear RVOL 1x", group=grp_global, inline="rv1", tooltip="★ GATE REFERENCE — every detection plot and what gates it ★\n(GATE = what else must fire on the same bar for the plot to show.)\n\n— RVOL 0.56 —\nSAAB → +LONG\nKratos → +SHORT\nBull RVOL 1x → +LONG\nBear RVOL 1x → +SHORT\nGrand Slam → +LONG\nMOAB → +SHORT\nWTC → +LONG or +SHORT\nHiroshima → +LONG or +SHORT\nNagasaki → +LONG or +SHORT\n\n— MOMENTUM —\nLONG 1-5, SHORT 1-2 → NO GATE (these ARE the gate)\n\n— HIGH VOLUME —\nHV 150/250/350/500/1000 → +LONG[1]\n\n— DISPLACEMENT —\nDisp Bull/Bear → NO GATE\nConsec Disp 2+/3+ → NO GATE\n\n— SEQUENCES —\nUU/UUU/UUUU → displacement in streak\nDD/DDD/DDDD → displacement in streak\n\n— B2B —\n2x SAAB/Kratos/Bull1x/Bear1x → HV150+ or displacement\nB2B Mid Bull/Bear → HV150+ or displacement\n\n— FAUNA —\nFAUNA Bull → displacement + LONG\nFAUNA Bear → displacement + SHORT\n\n— HCT COMBOS —\nHCT Bull → ANY coincident Singles signal\nHCT Bear → ANY coincident Singles signal\n\n— PENTAGON (v3.2) —\nPent+4K+D → Pentagon + 4K (bar[0] volume == highest of last 4K-lookback bars, default 4000) + displacement, same candle\nPent+NAGA+D → Pentagon + Nagasaki (all-time-high volume) + displacement, same candle\nD9 Bull Study → Disp strength 9 + (Bull RVOL 1x OR Grand Slam) + (HV500 OR HV1000 OR Nagasaki)\nD9 Bear Study → Disp strength 9 + (Bear RVOL 1x OR MOAB) + (HV500 OR HV1000 OR Nagasaki)\n\n— NAGASAKI + ANY (v3.2) —\nNaga + ANY Bull → Nagasaki + >=1 same-candle BULLISH detection; alert names every partner\nNaga + ANY Bear → Nagasaki + >=1 same-candle BEARISH detection; alert names every partner\n\n— ALERT LAW (v3.2) —\nAn alert line is emitted IFF its checkbox is ON. Unchecked = silent, always.")
show_GrandSlam  = input.bool(false, "Grand Slam", group=grp_global, inline="rv2")
show_MOAB       = input.bool(false, "MOAB", group=grp_global, inline="rv2")
show_WTC        = input.bool(false, "WTC", group=grp_global, inline="rv2")
show_Hiroshima  = input.bool(false, "Hiroshima", group=grp_global, inline="rv2", tooltip="RVOL EXTREMES + REG@TIME (this row):\n\n• Grand Slam — Bullish extreme. normalizedPrice ≥ GS/MOAB_th. GATE: +LONG.\n• MOAB — Bearish extreme. normalizedPrice ≥ GS/MOAB_th. GATE: +SHORT.\n• WTC — RVOL Reg@Time mid-tier. relVolRatio ∈ (WTC_th, Hiroshima_th]. GATE: +LONG or +SHORT.\n• Hiroshima — RVOL Reg@Time top-tier. relVolRatio > Hiroshima_th. GATE: +LONG or +SHORT.\n\nAll bar[0], confirmed only.")
show_Nagasaki   = input.bool(true, "Nagasaki", group=grp_global, inline="rv3", tooltip="Nagasaki: All-time high volume. bar[0] volume exceeds ALL prior bars' max volume ever. GATE: +LONG or +SHORT.")
show_NagaAnyBull = input.bool(true, "Naga + ANY Bull", group=grp_global, inline="rv4")
show_NagaAnyBear = input.bool(true, "Naga + ANY Bear", group=grp_global, inline="rv4", tooltip="NAGASAKI + ANY (this row, v3.2):\n\n• Naga + ANY Bull — Nagasaki (all-time-high volume, bar[0]) AND at least one BULLISH HW detection on the SAME candle: SAAB+LONG, Bull RVOL 1x+LONG, Grand Slam+LONG, WTC/Hiroshima with LONG, LONG 1-5, UU/UUU/UUUU, 2x SAAB, 2x Bull 1x, B2B Mid Bull, FAUNA Bull, D9 Bull Study.\n• Naga + ANY Bear — Nagasaki AND at least one BEARISH HW detection on the same candle: Kratos+SHORT, Bear RVOL 1x+SHORT, MOAB+SHORT, WTC/Hiroshima with SHORT, SHORT 1-2, DD/DDD/DDDD, 2x Kratos, 2x Bear 1x, B2B Mid Bear, FAUNA Bear, D9 Bear Study.\n\nPartners are read at the DETECTION level (their own checkboxes do not matter). The alert line NAMES every partner that fired. NOT partners: HCT composites, Pentagon specials, and offset −1 lanes (HV 150-1000, Disp, Consec Disp — those mark bar[1]). Alert emitted IFF this checkbox is ON.")
cl_NagaAnyBull   = input.color(#8A2BE2, "Naga + ANY Bull color", group=grp_global, inline="rv5")
cl_NagaAnyBear   = input.color(#C71585, "Naga + ANY Bear color", group=grp_global, inline="rv5")

show_Long1      = input.bool(true, "LONG 1", group=grp_global, inline="hy1")
show_Short1     = input.bool(true, "SHORT 1", group=grp_global, inline="hy1", tooltip="MOMENTUM TIER 1 (this row):\n\n• LONG 1 — Bullish. close > open, hybRegRatio ≥ M1_Reg, hybCumRatio ≥ M1_Cum, hybBodyRat ≥ M1_Body. No gate — LONG IS the gate for SAAB/RVOL1x/GS/WTC/H/N/HV.\n• SHORT 1 — Bearish. close < open, same 3 thresholds. No gate — SHORT IS the gate for Kratos/BearRVOL1x/MOAB/WTC/H/N.")
show_Long2      = input.bool(false, "LONG 2", group=grp_global, inline="hy2")
show_Short2     = input.bool(false, "SHORT 2", group=grp_global, inline="hy2", tooltip="MOMENTUM TIER 2 (this row):\n\n• LONG 2 — Bullish. M2 thresholds, AND NOT LONG 1. Fires only if weaker than tier 1.\n• SHORT 2 — Bearish. M2 thresholds, AND NOT SHORT 1.")
show_Long3      = input.bool(false, "LONG 3", group=grp_global, inline="hy3")
show_Long4      = input.bool(false, "LONG 4", group=grp_global, inline="hy3")
show_Long5      = input.bool(false, "LONG 5", group=grp_global, inline="hy3", tooltip="MOMENTUM TIERS 3-5 (this row):\n\n• LONG 3 — Bullish. M3 thresholds, NOT LONG 1/2.\n• LONG 4 — Bullish. M4 thresholds, NOT LONG 1/2/3.\n• LONG 5 — Bullish. M5 thresholds, NOT LONG 1/2/3/4.\nLong-only tiers (no SHORT 3-5). Each tier = hybRegRatio ≥ Reg floor AND hybCumRatio ≥ Cum floor AND hybBodyRat ≥ Body ratio.")

show_HV150      = input.bool(false, "HV 150", group=grp_global, inline="hv1")
show_HV250      = input.bool(false, "HV 250", group=grp_global, inline="hv1")
show_HV350      = input.bool(false, "HV 350", group=grp_global, inline="hv1", tooltip="HIGH VOLUME 150/250/350 (this row):\n\n• HV 150 — volume[1] == highest(volume, 150)[1], NOT HV250+.\n• HV 250 — volume[1] == highest(volume, 250)[1], NOT HV350+.\n• HV 350 — volume[1] == highest(volume, 350)[1], NOT HV500+.\n\nAll GATE: +LONG[1]. Offset: −1 (plots on bar[1]). Exclusive tiers — only the highest fires.")
show_HV500      = input.bool(false, "HV 500", group=grp_global, inline="hv2")
show_HV1000     = input.bool(true, "HV 1000", group=grp_global, inline="hv2", tooltip="HIGH VOLUME 500/1000 (this row):\n\n• HV 500 — volume[1] == highest(volume, 500)[1], NOT HV1000.\n• HV 1000 — volume[1] == highest(volume, 1000)[1].\n\nAll GATE: +LONG[1]. Offset: −1. Exclusive tiers.")

grp_global2 = "★ GLOBAL TOGGLES — DISP / SEQ / B2B ★"

show_DispBull        = input.bool(false, "Disp Bull", group=grp_global2, inline="di1")
show_DispBear        = input.bool(false, "Disp Bear", group=grp_global2, inline="di1", tooltip="DISPLACEMENT (this row):\n\n• Disp Bull — bar[1] range > StdDev × standalone multiplier, close[1] > open[1], bullish FVG on bar[0] (low > high[2]). Offset: −1.\n• Disp Bear — bar[1] range > StdDev × standalone multiplier, close[1] < open[1], bearish FVG (high < low[2]). Offset: −1.\n\nNo additional gate. Range type configurable (Open-Close or High-Low).")
show_CDispBull2      = input.bool(true, "Consec Disp Bull 2+", group=grp_global2, inline="di2")
show_CDispBear2      = input.bool(true, "Consec Disp Bear 2+", group=grp_global2, inline="di2", tooltip="CONSECUTIVE DISPLACEMENT 2+ (this row):\n\n• CDisp Bull 2+ — 2+ back-to-back bullish displacements. StdDev × CDisp2 multiplier.\n• CDisp Bear 2+ — 2+ back-to-back bearish displacements. StdDev × CDisp2 multiplier.\n\nOffset: −1. Streak resets on direction change or gap.")
show_CDispBull3      = input.bool(true, "Consec Disp Bull 3+", group=grp_global2, inline="di3")
show_CDispBear3      = input.bool(true, "Consec Disp Bear 3+", group=grp_global2, inline="di3", tooltip="CONSECUTIVE DISPLACEMENT 3+ (this row):\n\n• CDisp Bull 3+ — 3+ back-to-back bullish displacements. StdDev × CDisp3 multiplier.\n• CDisp Bear 3+ — 3+ back-to-back bearish displacements. StdDev × CDisp3 multiplier.\n\nOffset: −1.")

show_UU   = input.bool(false, "UU", group=grp_global2, inline="sq1")
show_UUU  = input.bool(false, "UUU", group=grp_global2, inline="sq1")
show_UUUU = input.bool(false, "UUUU", group=grp_global2, inline="sq1", tooltip="BULLISH SEQUENCES (this row):\n\n• UU — 2 consecutive LONGs. Sum of normalizedPrices ≥ SAAB/Krat threshold.\n• UUU — 3 consecutive LONGs. Sum ≥ threshold OR 2+ displacements in streak.\n• UUUU — 4 consecutive LONGs. Sum ≥ threshold OR 2+ displacements.\n\nAll GATE: displacement (StdDev × Seq multiplier) must occur within the streak. Each bar must also pass the lower threshold floor.")
show_DD   = input.bool(false, "DD", group=grp_global2, inline="sq2")
show_DDD  = input.bool(false, "DDD", group=grp_global2, inline="sq2")
show_DDDD = input.bool(false, "DDDD", group=grp_global2, inline="sq2", tooltip="BEARISH SEQUENCES (this row):\n\n• DD — 2 consecutive SHORTs. Sum ≥ SAAB/Krat threshold.\n• DDD — 3 consecutive SHORTs. Sum ≥ threshold OR 2+ displacements.\n• DDDD — 4 consecutive SHORTs. Sum ≥ threshold OR 2+ displacements.\n\nAll GATE: displacement (StdDev × Seq multiplier) within the streak. Lower threshold floor applies per bar.")

show_B2B_2xSAAB       = input.bool(false, "2x SAAB", group=grp_global2, inline="b2b1")
show_B2B_2xKratos     = input.bool(false, "2x Kratos", group=grp_global2, inline="b2b1", tooltip="B2B SAME-TIER (this row):\n\n• 2x SAAB — SAAB on bar[0] AND bar[1].\n• 2x Kratos — Kratos on bar[0] AND bar[1].\n\nGATE: HV150+ or displacement on bar[0] or bar[1].")
show_B2B_2xBull1x     = input.bool(false, "2x Bull 1x", group=grp_global2, inline="b2b2")
show_B2B_2xBear1x     = input.bool(false, "2x Bear 1x", group=grp_global2, inline="b2b2", tooltip="B2B SAME-TIER 1x (this row):\n\n• 2x Bull 1x — BullRVOL1x on bar[0] AND bar[1].\n• 2x Bear 1x — BearRVOL1x on bar[0] AND bar[1].\n\nGATE: HV150+ or displacement.")
show_B2B_MidBull      = input.bool(false, "B2B Mid Bull", group=grp_global2, inline="b2b3")
show_B2B_MidBear      = input.bool(false, "B2B Mid Bear", group=grp_global2, inline="b2b3", tooltip="B2B MIXED-TIER (this row):\n\n• B2B Mid Bull — Two different bullish RVOL tiers on consecutive bars (e.g. SAAB bar[1] + BullRVOL1x bar[0]).\n• B2B Mid Bear — Two different bearish RVOL tiers on consecutive bars.\n\nGATE: HV150+ or displacement.")

show_FaunaBull = input.bool(false, "FAUNA Bullish", group=grp_global2, inline="fn1")
show_FaunaBear = input.bool(false, "FAUNA Bearish", group=grp_global2, inline="fn1", tooltip="FAUNA (this row):\n\n• FAUNA Bull — Named bullish pattern combo (MadBull+TA, MadBull+GG, MadBull+TR, MadBull+ES, MadBull+GDR, MB+TA, MB+GG, MB+TR, MB+ES, MB+GDR). Label shows which pair hit.\n• FAUNA Bear — Same 10 named bearish combos.\n\nGATE: displacement (StdDev × Seq multiplier) AND LONG (bull) or SHORT (bear) on same bar.")

grp_info = "★ INFO PANEL (Live Threshold Values) ★"
show_InfoPanel     = input.bool(false,           "Show Info Panel",   group=grp_info, inline="ip1")
infoPanelPosition  = input.string("Bottom Right","Position",         group=grp_info, inline="ip1", options=["Top Right","Bottom Right","Top Left","Bottom Left","Middle Right","Middle Left"])
infoPanelTextSize  = input.string("Small",      "Text Size",         group=grp_info, inline="ip2", options=["Tiny","Small","Normal","Large"])

// =============================================================================
// RVOL 0.56 SETTINGS
// =============================================================================
groupBullBear = "RVOL - Bull/Bear Calculation"
bb_avgLength  = input.int(30, "Lookback Length", minval=1, group=groupBullBear, tooltip="Lookback for normalizing price spike and volume. Used by SAAB/Kratos/RVOL1x/GrandSlam/MOAB.")
bb_smaLength  = input.int(20, "SMA Length", minval=1, group=groupBullBear, tooltip="SMA period for the positive diff filter. Bar's normalized diff must exceed this SMA to qualify.")

groupReg = "RVOL - Reg @ Time Calculation"
reg_anchorTimeframe  = input.timeframe("", "Anchor Timeframe (blank = chart)", group=groupReg, tooltip="Anchor timeframe for RVOL Reg@Time. Blank = chart timeframe. Used by Pentagon/WTC/Hiroshima and Hybrid Momentum.")
reg_length           = input.int(30, "Length", minval=1, group=groupReg, tooltip="Lookback length for tv_ta.relativeVolume() — how many anchor-period sessions to average.")
reg_calculationMode  = input.string("Cumulative", "Calculation Mode", options=["Cumulative", "Regular"], group=groupReg, tooltip="Cumulative: volume since session open vs avg. Regular: per-bar volume vs avg at same time.")
reg_adjustRealtime   = input.bool(true, "Adjust Unconfirmed", group=groupReg, tooltip="When ON, adjusts the current unconfirmed bar's volume estimate for partial-bar comparison.")

groupHybrid = "RVOL - Hybrid Regime Settings"

reg_pct  = input.int(85, "Reg Floor %",  minval=0, group=groupHybrid, tooltip="Percentage multiplier applied uniformly to ALL 5 auto-derived Reg floors (M1-M5). 100 = use auto-derived as-is. 90 = 90% of auto-derived. No max cap.")
cum_pct  = input.int(85, "Cum Floor %",  minval=0, group=groupHybrid, tooltip="Percentage multiplier applied uniformly to ALL 5 auto-derived Cum floors. 100 = default.")
body_pct = input.int(85, "Body Ratio %", minval=0, group=groupHybrid, tooltip="Percentage multiplier applied uniformly to ALL 5 auto-derived Body ratios. 100 = default.")

groupNaga = "RVOL - Nagasaki"
enableNagasaki = input.bool(true, "Enable Nagasaki", group=groupNaga, tooltip="Nagasaki: fires when current bar's volume exceeds ALL prior bars' volume (all-time high). Gated by LONG or SHORT.")

// =============================================================================
// SEQUENCE — BAR LOWER THRESHOLDS (min 0.5, no max)
// =============================================================================
grp_seq = "Sequence — Bar Lower Thresholds"
th_low_UU_DD     = input.float(7.0, step=0.1, title="Lower Threshold (UU / DD)",     minval=0.5, group=grp_seq, tooltip="Minimum bar lower bound for each bar in a UU/DD sequence. Bars with normalizedPrice below this are excluded from the streak.")
th_low_UUU_DDD   = input.float(7.0, step=0.1, title="Lower Threshold (UUU / DDD)",   minval=0.5, group=grp_seq, tooltip="Minimum bar lower bound for UUU/DDD sequences.")
th_low_UUUU_DDDD = input.float(7.0, step=0.1, title="Lower Threshold (UUUU / DDDD)", minval=0.5, group=grp_seq, tooltip="Minimum bar lower bound for UUUU/DDDD sequences.")

// =============================================================================
// DISPLACEMENT — PER-CONSUMER StdDev THRESHOLDS
// =============================================================================
grp_disp = "Displacement — StdDev Thresholds"
i_disp_type          = input.string("Open to Close", "Range Type", options = ['Open to Close', 'High to Low'], group=grp_disp, tooltip="How bar range is measured for Singles displacement: |open−close| or high−low.")
i_std_len            = input.int(100, minval = 1, title = "Std Dev Length", group=grp_disp, tooltip="Lookback length for standard deviation of bar ranges in Singles displacement engine.")
i_disp_std_standalone = input.float(9.0, "Disp Bull/Bear — StdDev Min",     minval=0, step=0.1, group=grp_disp, tooltip="StdDev multiplier for standalone Displacement Bull/Bear plots. Higher = fewer signals.")
i_disp_std_cdisp2    = input.float(8.0, "Consec Disp 2+ — StdDev Min",     minval=0, step=0.1, group=grp_disp, tooltip="StdDev multiplier for consecutive displacement 2+ streak.")
i_disp_std_cdisp3    = input.float(7.0, "Consec Disp 3+ — StdDev Min",     minval=0, step=0.1, group=grp_disp, tooltip="StdDev multiplier for consecutive displacement 3+ streak.")
i_disp_std_seq       = input.float(9.0, "Sequences & FAUNA — StdDev Min",  minval=0, step=0.1, group=grp_disp, tooltip="StdDev multiplier for displacement gating on sequences (U2-U4, D2-D4) and FAUNA signals.")

// =============================================================================
// FAUNA SETTINGS — COLORS ONLY
// =============================================================================
fn_grp_global   = "FAUNA — Colors"
fn_bullColor    = input.color(color.new(#00C800, 0), "▲ Bull Color", group=fn_grp_global)
fn_bearColor    = input.color(color.new(#FF2020, 0), "▼ Bear Color", group=fn_grp_global)

// =============================================================================
// HCT COMBO ELIGIBILITY (15) — No-Disp combos route to Bull/Bear by direction
// =============================================================================
grp_hct = "★ HCT COMBO ELIGIBILITY (15) ★"
hct_ref = input.bool(false, "ⓘ HCT Master Reference (all 15 combos)", group=grp_hct, tooltip="ALL 15 HCT COMBOS — MASTER REFERENCE\n\ngroupA_Bull = BullRVOL1x OR GrandSlam\ngroupA_Bear = BearRVOL1x OR MOAB\ngroupB = Pentagon OR WTC OR Hiroshima\nPentagon = RVOL Reg@Time ratio ∈ [1x_th, WTC_th]\n\n1. HYY Bull: groupA AND groupB AND HCT bullish disp\n2. HYY Bear: groupA AND groupB AND HCT bearish disp\n3. HYY No-Disp: groupA AND groupB, no disp → Bull if groupA_Bull, Bear if groupA_Bear\n4. HN Bull: Nagasaki AND groupA AND HCT bull disp\n5. HN Bear: Nagasaki AND groupA AND HCT bear disp\n6. HN No-Disp: Nag AND groupA, no disp → direction from groupA\n7. HNV Bull: Nag AND groupB AND HCT bull disp\n8. HNV Bear: Nag AND groupB AND HCT bear disp\n9. HNV No-Disp: Nag AND groupB, no disp → close>open=Bull, close<open=Bear\n10. HT Bull: Nag AND groupA AND groupB AND bull disp\n11. HT Bear: Nag AND groupA AND groupB AND bear disp\n12. HT No-Disp: Nag AND groupA AND groupB, no disp → direction from groupA\n13. NHx2 Bull: 2+ of (Pentagon,WTC,Hiroshima) AND bull disp\n14. NHx2 Bear: 2+ of (Pentagon,WTC,Hiroshima) AND bear disp\n15. NHx2 No-Disp: 2+ of groupB, no disp → candle direction\n\nMASTER GATE: all HCT plots require ANY coincident Singles signal (SAAB/Kratos/RVOL1x/GS/MOAB/WTC/H/N/LONG/SHORT).")
en_HYYBull    = input.bool(false, "HYY Bull",     group=grp_hct, inline="hyy")
en_HYYBear    = input.bool(false, "HYY Bear",     group=grp_hct, inline="hyy")
en_HYYNoDisp  = input.bool(false, "HYY No-Disp",  group=grp_hct, inline="hyy", tooltip="HEAVY YIN-YANG (this row):\nBase: groupA (BullRVOL1x/GS/BearRVOL1x/MOAB) AND groupB (Pentagon/WTC/Hiroshima).\n\n• Bull — base AND HCT bullish displacement.\n• Bear — base AND HCT bearish displacement.\n• No-Disp — base, NO displacement. Routes to Bull if groupA_Bull fired, Bear if groupA_Bear fired.")
en_HNBull     = input.bool(false, "HN Bull",      group=grp_hct, inline="hn")
en_HNBear     = input.bool(false, "HN Bear",      group=grp_hct, inline="hn")
en_HNNoDisp   = input.bool(false, "HN No-Disp",   group=grp_hct, inline="hn", tooltip="HEAVY NAGASAKI (this row):\nBase: Nagasaki (ATH volume) AND groupA.\n\n• Bull — base AND HCT bullish displacement.\n• Bear — base AND HCT bearish displacement.\n• No-Disp — base, NO disp. Routes via groupA direction.")
en_HNVBull    = input.bool(false, "HNV Bull",     group=grp_hct, inline="hnv")
en_HNVBear    = input.bool(false, "HNV Bear",     group=grp_hct, inline="hnv")
en_HNVNoDisp  = input.bool(false, "HNV No-Disp",  group=grp_hct, inline="hnv", tooltip="HEAVY NAGASAKI VOL (this row):\nBase: Nagasaki AND groupB (Pentagon/WTC/Hiroshima).\n\n• Bull — base AND HCT bullish displacement.\n• Bear — base AND HCT bearish displacement.\n• No-Disp — base, NO disp. Routes via candle direction (close > open → Bull).")
en_HTBull     = input.bool(false, "HT Bull",      group=grp_hct, inline="ht")
en_HTBear     = input.bool(false, "HT Bear",      group=grp_hct, inline="ht")
en_HTNoDisp   = input.bool(false, "HT No-Disp",   group=grp_hct, inline="ht", tooltip="HEAVY TRIDENT (this row):\nBase: Nagasaki AND groupA AND groupB — the full trifecta.\n\n• Bull — base AND HCT bullish displacement.\n• Bear — base AND HCT bearish displacement.\n• No-Disp — base, NO disp. Routes via groupA direction.")
en_NHx2Bull   = input.bool(false, "NHx2 Bull",    group=grp_hct, inline="nhx")
en_NHx2Bear   = input.bool(false, "NHx2 Bear",    group=grp_hct, inline="nhx")
en_NHx2NoDisp = input.bool(false, "NHx2 No-Disp", group=grp_hct, inline="nhx", tooltip="NEUTRAL HEAVY x2 (this row):\nBase: 2+ of (Pentagon, WTC, Hiroshima) firing simultaneously.\n\n• Bull — base AND HCT bullish displacement.\n• Bear — base AND HCT bearish displacement.\n• No-Disp — base, NO disp. Routes via candle direction (close > open → Bull).")

show_HCTBull      = input.bool(false, "HCT Bull",   group=grp_hct, inline="hctm")
show_HCTBear      = input.bool(false, "HCT Bear",   group=grp_hct, inline="hctm", tooltip="HCT MASTER PLOTS (this row):\n\n• HCT Bull — OR of all eligible bull combos (disp-bull + no-disp routed bull). Plots HC▲.\n• HCT Bear — OR of all eligible bear combos (disp-bear + no-disp routed bear). Plots HC▼.\n\nMASTER GATE: must have ANY coincident Singles signal (SAAB/Kratos/RVOL1x/GS/MOAB/WTC/H/N/LONG/SHORT) on the same bar.")
show_Pent4KD      = input.bool(false, "Pent+4K+D",   group=grp_hct, inline="pent")
show_PentNagaD    = input.bool(false, "Pent+NAGA+D", group=grp_hct, inline="pent", tooltip="PENTAGON SPECIALS (this row, v3.2):\n\nPentagon = RVOL Reg@Time ratio ∈ [1x_th, WTC_th] (between 1x and WTC).\n\n• Pent+4K+D — Pentagon AND bar[0] volume == highest(volume, 4K Lookback) AND bar[0] range > 5× StdDev. Same candle.\n• Pent+NAGA+D — Pentagon AND Nagasaki (bar[0] volume exceeds every prior bar — all-time high) AND bar[0] range > 5× StdDev. Same candle.\n\nBoth Pentagon specials require same-candle displacement. Alert line emitted IFF the checkbox is ON.")
hv4k_len          = input.int(4000, "4K Lookback (bars)", minval=1, maxval=5000, group=grp_hct, tooltip="4K = bar[0] volume is the highest of the last N bars (default 4000, editable up or down). Feeds Pent+4K+D. max_bars_back is 5000, so 5000 is the ceiling.")

grp_d9 = "★ DISPLACEMENT STRENGTH 9 STUDIES ★"
show_D9BullStudy = input.bool(true, "D9 Bull Study", group=grp_d9, inline="d9a")
show_D9BearStudy = input.bool(true, "D9 Bear Study", group=grp_d9, inline="d9a", tooltip="D9 composite studies.\n\n• D9 Bull Study — displacement strength ≥ 9σ AND (Bull RVOL 1x OR Grand Slam) AND (HV500 OR HV1000 OR Nagasaki).\n• D9 Bear Study — displacement strength ≥ 9σ AND (Bear RVOL 1x OR MOAB) AND (HV500 OR HV1000 OR Nagasaki).\n\nAll conditions are evaluated on the same confirmed bar. HV500/HV1000 here are raw same-candle highest-volume checks, not the offset HV plots.")
d9_disp_strength = input.float(9.9, "D9 Strength (σ multiplier)", minval=1.0, step=0.1, group=grp_d9, tooltip="Requested default is 9.0σ. Uses same-candle high-low range compared against recent high-low standard deviation.")
d9_disp_lookback = input.int(100, "D9 Lookback Length", minval=10, group=grp_d9, tooltip="Lookback length for the D9 same-candle high-low standard deviation calculation.")

grp_hctd = "★ HCT DISPLACEMENT ★"
hct_disp_strength = input.float(9.0, "Strength (σ multiplier)", minval=1.0, step=0.5, group=grp_hctd, tooltip="Bar[1] range must exceed this many standard deviations of recent bar ranges to qualify as a HCT displacement candle.")
hct_disp_lookback = input.int(100, "Lookback Length", minval=10, group=grp_hctd, tooltip="Number of bars for bar-range standard deviation calculation in HCT displacement engine.")
hct_threshPct     = input.float(2, "FVG Threshold %", minval=0, maxval=100, step=0.1, group=grp_hctd)
hct_auto          = input.bool(true, "Auto FVG Threshold", group=grp_hctd)

// =============================================================================
// RVOL 0.56 CALCULATIONS
// =============================================================================
tfSec = nn_isTick ? nn_TICK_FB : nn_tfSecRaw   // tick fallback so threshold tables don't silently die
// anchorSafe: blank/tick anchor -> "D" ONLY on tick charts (preserves time-chart "" semantics)
string reg_anchorSafe = ((reg_anchorTimeframe == "" and nn_isTick) or str.endswith(reg_anchorTimeframe, "T")) ? "D" : reg_anchorTimeframe

f_rvol_1x_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10   ? 38.0 :
               s <= 15   ? 33.0 :
               s <= 30   ? 28.0 :
               s <= 45   ? 23.0 :
               s <= 60   ? 20.0 :
               s <= 120  ? 19.0 :
               s <= 180  ? 17.0 :
               s <= 240  ? 16.0 :
               s <= 300  ? 15.0 :
               s <= 360  ? 14.0 :
               s <= 420  ? 12.0 :
               s <= 480  ? 11.0 :
               s <= 540  ? 10.0 :
               s <= 600  ? 10.0 :
               s <= 900  ? 8.4 :
               s <= 1800 ? 6.9 :
               s <= 3600 ? 5.9 :
               s <= 7200 ? 3.0 :
               1.8
    th

f_saab_kratos_threshold(_tfSec) =>
    f_rvol_1x_threshold(_tfSec) * 0.56

f_gs_moab_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10   ? 114.0 :
               s <= 15   ? 99.0 :
               s <= 30   ? 84.0 :
               s <= 45   ? 69.0 :
               s <= 60   ? 35.0 :
               s <= 300  ? 35.0 :
               s <= 600  ? 25.0 :
               s <= 900  ? 20.0 :
               s <= 3600 ? 10.0 :
               8.0
    th

f_wtc_threshold(_tfSec) =>
    f_rvol_1x_threshold(_tfSec) * 2.0

f_hiroshima_threshold(_tfSec) =>
    float s = _tfSec
    float th = s <= 10   ? 114.0 :
               s <= 15   ? 99.0 :
               s <= 30   ? 84.0 :
               s <= 45   ? 69.0 :
               s <= 60   ? 35.0 :
               s <= 300  ? 35.0 :
               s <= 600  ? 25.0 :
               s <= 900  ? 20.0 :
               s <= 3600 ? 10.0 :
               8.0
    th

th_saab_kratos = f_saab_kratos_threshold(tfSec)
th_1x          = f_rvol_1x_threshold(tfSec)
th_gs_moab     = f_gs_moab_threshold(tfSec)
th_wtc         = f_wtc_threshold(tfSec)
th_hiroshima   = f_hiroshima_threshold(tfSec)

// ── HYBRID MOMENTUM AUTO-DERIVE LADDER (from Hiroshima) ──────────────────────
hybAutoReg1 = th_hiroshima * 2.85
hybAutoReg5 = th_hiroshima * 1.1875
hybAutoStep = (hybAutoReg1 - hybAutoReg5) / 4.0
hybAutoReg2 = hybAutoReg1 - 1.0 * hybAutoStep
hybAutoReg3 = hybAutoReg1 - 2.0 * hybAutoStep
hybAutoReg4 = hybAutoReg1 - 3.0 * hybAutoStep

float hybCumPhi = 1.398 * 1.33
hybAutoCum1 = hybCumPhi * math.sqrt(math.log(hybAutoReg1))
hybAutoCum2 = hybCumPhi * math.sqrt(math.log(hybAutoReg2))
hybAutoCum3 = hybCumPhi * math.sqrt(math.log(hybAutoReg3))
hybAutoCum4 = hybCumPhi * math.sqrt(math.log(hybAutoReg4))
hybAutoCum5 = hybCumPhi * math.sqrt(math.log(hybAutoReg5))

float hybAutoBody1 = 0.69
float hybAutoBody2 = 0.72
float hybAutoBody3 = 0.75
float hybAutoBody4 = 0.78
float hybAutoBody5 = 0.81

float regMult  = reg_pct  / 100.0
float cumMult  = cum_pct  / 100.0
float bodyMult = body_pct / 100.0

hybReg1Eff  = hybAutoReg1  * regMult
hybReg2Eff  = hybAutoReg2  * regMult
hybReg3Eff  = hybAutoReg3  * regMult
hybReg4Eff  = hybAutoReg4  * regMult
hybReg5Eff  = hybAutoReg5  * regMult

hybCum1Eff  = hybAutoCum1  * cumMult
hybCum2Eff  = hybAutoCum2  * cumMult
hybCum3Eff  = hybAutoCum3  * cumMult
hybCum4Eff  = hybAutoCum4  * cumMult
hybCum5Eff  = hybAutoCum5  * cumMult

hybBody1Eff = hybAutoBody1 * bodyMult
hybBody2Eff = hybAutoBody2 * bodyMult
hybBody3Eff = hybAutoBody3 * bodyMult
hybBody4Eff = hybAutoBody4 * bodyMult
hybBody5Eff = hybAutoBody5 * bodyMult

// =============================================================================
// RVOL 0.56 — BULL/BEAR SIGNALS
// =============================================================================
bb_spike = math.abs(close - open)
bb_avgSpikeDenom = ta.sma(bb_spike, bb_avgLength)[1]
bb_normalizedPrice = bb_spike / nz(bb_avgSpikeDenom, 1.0)

bb_avgVolDenom = ta.sma(volume, bb_avgLength)[1]
bb_normalizedVolume = volume / nz(bb_avgVolDenom, 1.0)

bb_diff = bb_normalizedPrice - bb_normalizedVolume
bb_positiveDiff = bb_diff > 0 ? bb_diff : na
bb_smaDiff = ta.sma(bb_positiveDiff, bb_smaLength)

bb_baseBullish = (close > open) and (bb_positiveDiff > bb_smaDiff)
bb_baseBearish = (close < open) and (bb_positiveDiff > bb_smaDiff)

bb_inRange(v, lowTh, highTh) => v >= lowTh and v < highTh

conf = barstate.isconfirmed

sigSAAB = conf and bb_baseBullish and bb_inRange(bb_normalizedPrice, th_saab_kratos, th_1x)
sigKratos = conf and bb_baseBearish and bb_inRange(bb_normalizedPrice, th_saab_kratos, th_1x)
sigBullRVOL1x = conf and bb_baseBullish and bb_inRange(bb_normalizedPrice, th_1x, th_gs_moab)
sigBearRVOL1x = conf and bb_baseBearish and bb_inRange(bb_normalizedPrice, th_1x, th_gs_moab)
sigGrandSlam = conf and bb_baseBullish and (bb_normalizedPrice >= th_gs_moab)
sigMOAB = conf and bb_baseBearish and (bb_normalizedPrice >= th_gs_moab)

// =============================================================================
// RVOL REG @ TIME — WTC / Hiroshima
// =============================================================================
[currentVolume_reg, pastVolume_reg, _] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, reg_calculationMode == "Cumulative", reg_adjustRealtime)
relVolRatio = currentVolume_reg / pastVolume_reg

sigWTC = conf and (relVolRatio > th_wtc) and (relVolRatio <= th_hiroshima)
sigHiroshima = conf and (relVolRatio > th_hiroshima)
sigPentagon  = conf and (relVolRatio >= th_1x) and (relVolRatio <= th_wtc)

// =============================================================================
// HYBRID RVOL — MOMENTUM REGIMES (LONG/SHORT signals)
// =============================================================================
[hybRegCur, hybRegPast, _hr] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, false, reg_adjustRealtime)
[hybCumCur, hybCumPast, _hc] = tv_ta.relativeVolume(reg_length, reg_anchorSafe, true, reg_adjustRealtime)

hybRegRatio = hybRegCur / hybRegPast
hybCumRatio = hybCumCur / hybCumPast

hybBodySz  = math.abs(close - open)
hybRange   = high - low
hybBodyRat = hybRange == 0 ? 0.0 : hybBodySz / hybRange

hybConvict1  = hybBodyRat >= hybBody1Eff
hybBull1     = (close > open) and hybConvict1
hybBear1     = (close < open) and hybConvict1
hybMom1      = conf and (hybRegRatio > hybReg1Eff) and (hybCumRatio > hybCum1Eff)
sigAddLong1  = hybMom1 and hybBull1
sigAddShort1 = hybMom1 and hybBear1

hybConvict2  = hybBodyRat >= hybBody2Eff
hybBull2     = (close > open) and hybConvict2
hybBear2     = (close < open) and hybConvict2
hybMom2      = conf and (hybRegRatio > hybReg2Eff) and (hybCumRatio > hybCum2Eff)
sigAddLong2  = hybMom2 and hybBull2
sigAddShort2 = hybMom2 and hybBear2

hybConvict3  = hybBodyRat >= hybBody3Eff
hybBull3     = (close > open) and hybConvict3
hybMom3      = conf and (hybRegRatio > hybReg3Eff) and (hybCumRatio > hybCum3Eff)
sigAddLong3  = hybMom3 and hybBull3

hybConvict4  = hybBodyRat >= hybBody4Eff
hybBull4     = (close > open) and hybConvict4
hybMom4      = conf and (hybRegRatio > hybReg4Eff) and (hybCumRatio > hybCum4Eff)
sigAddLong4  = hybMom4 and hybBull4

hybConvict5  = hybBodyRat >= hybBody5Eff
hybBull5     = (close > open) and hybConvict5
hybMom5      = conf and (hybRegRatio > hybReg5Eff) and (hybCumRatio > hybCum5Eff)
sigAddLong5  = hybMom5 and hybBull5

// =============================================================================
// NAGASAKI
// =============================================================================
vol = volume
var float maxVol = 0.0
bool isNagasaki = false

if conf
    if bar_index == 0
        maxVol := vol
    else if vol > maxVol
        isNagasaki := true
        maxVol := vol

sigNagasaki = enableNagasaki and isNagasaki

// =============================================================================
// GATING HELPERS
// =============================================================================
anyLong  = sigAddLong1 or sigAddLong2 or sigAddLong3 or sigAddLong4 or sigAddLong5
anyShort = sigAddShort1 or sigAddShort2
anyMom   = anyLong or anyShort

anyLong_1 = sigAddLong1[1] or sigAddLong2[1] or sigAddLong3[1] or sigAddLong4[1] or sigAddLong5[1]

anyHV_cur = conf and (volume == ta.highest(volume, 150))

// =============================================================================
// HCT DISPLACEMENT ENGINE (verbatim from Heavy PENTAGON)
// =============================================================================
float hct_thresh     = hct_auto ? ta.cum((high - low) / low) / bar_index : hct_threshPct / 100
bool  hct_bFVG       = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > hct_thresh
bool  hct_sFVG       = high < low[2] and close[1] < low[2] and (low[2] - high) / high > hct_thresh
float hct_barRange   = high[1] - low[1]
float hct_rangeStdev = ta.stdev(high - low, hct_disp_lookback)
bool  hct_dispMet    = hct_barRange > hct_disp_strength * nz(hct_rangeStdev[1])

bool hct_dispBull = conf and hct_dispMet and (close[1] > open[1]) and hct_bFVG
bool hct_dispBear = conf and hct_dispMet and (close[1] < open[1]) and hct_sFVG
bool hct_noDisp   = not hct_dispBull and not hct_dispBear

// =============================================================================
// HCT COMBO BUILDING BLOCKS — 15 combos, neutral→directional
// =============================================================================
bool groupA_Bull = sigBullRVOL1x or sigGrandSlam
bool groupA_Bear = sigBearRVOL1x or sigMOAB
bool groupB      = sigPentagon or sigWTC or sigHiroshima

bool baseYinYang   = (groupA_Bull or groupA_Bear) and groupB
bool baseNagasaki  = sigNagasaki and (groupA_Bull or groupA_Bear)
bool baseNagasakiV = sigNagasaki and groupB
bool baseTrident   = sigNagasaki and (groupA_Bull or groupA_Bear) and groupB
bool baseNHx2      = (sigPentagon and sigWTC) or (sigPentagon and sigHiroshima) or (sigWTC and sigHiroshima)

// 10 displacement-directional combos
bool sigHYYBull  = baseYinYang   and hct_dispBull
bool sigHYYBear  = baseYinYang   and hct_dispBear
bool sigHNBull   = baseNagasaki  and hct_dispBull
bool sigHNBear   = baseNagasaki  and hct_dispBear
bool sigHNVBull  = baseNagasakiV and hct_dispBull
bool sigHNVBear  = baseNagasakiV and hct_dispBear
bool sigHTBull   = baseTrident   and hct_dispBull
bool sigHTBear   = baseTrident   and hct_dispBear
bool sigNHx2Bull = baseNHx2      and hct_dispBull
bool sigNHx2Bear = baseNHx2      and hct_dispBear

// 5 no-disp combos → routed bull/bear (groupA direction or candle direction)
bool sigHYYNDBull  = baseYinYang   and hct_noDisp and groupA_Bull
bool sigHYYNDBear  = baseYinYang   and hct_noDisp and groupA_Bear
bool sigHNNDBull   = baseNagasaki  and hct_noDisp and groupA_Bull
bool sigHNNDBear   = baseNagasaki  and hct_noDisp and groupA_Bear
bool sigHNVNDBull  = baseNagasakiV and hct_noDisp and (close > open)
bool sigHNVNDBear  = baseNagasakiV and hct_noDisp and (close < open)
bool sigHTNDBull   = baseTrident   and hct_noDisp and groupA_Bull
bool sigHTNDBear   = baseTrident   and hct_noDisp and groupA_Bear
bool sigNHx2NDBull = baseNHx2      and hct_noDisp and (close > open)
bool sigNHx2NDBear = baseNHx2      and hct_noDisp and (close < open)

// Per-combo fire booleans (toggle AND signal)
bool f_HYYBull  = en_HYYBull   and sigHYYBull
bool f_HYYBear  = en_HYYBear   and sigHYYBear
bool f_HNBull   = en_HNBull    and sigHNBull
bool f_HNBear   = en_HNBear    and sigHNBear
bool f_HNVBull  = en_HNVBull   and sigHNVBull
bool f_HNVBear  = en_HNVBear   and sigHNVBear
bool f_HTBull   = en_HTBull    and sigHTBull
bool f_HTBear   = en_HTBear    and sigHTBear
bool f_NHx2Bull = en_NHx2Bull  and sigNHx2Bull
bool f_NHx2Bear = en_NHx2Bear  and sigNHx2Bear
bool f_HYYNDBull  = en_HYYNoDisp  and sigHYYNDBull
bool f_HYYNDBear  = en_HYYNoDisp  and sigHYYNDBear
bool f_HNNDBull   = en_HNNoDisp   and sigHNNDBull
bool f_HNNDBear   = en_HNNoDisp   and sigHNNDBear
bool f_HNVNDBull  = en_HNVNoDisp  and sigHNVNDBull
bool f_HNVNDBear  = en_HNVNoDisp  and sigHNVNDBear
bool f_HTNDBull   = en_HTNoDisp   and sigHTNDBull
bool f_HTNDBear   = en_HTNoDisp   and sigHTNDBear
bool f_NHx2NDBull = en_NHx2NoDisp and sigNHx2NDBull
bool f_NHx2NDBear = en_NHx2NoDisp and sigNHx2NDBear

// HCT Master OR-gates: Bull + Bear only (no neutral)
bool hctMasterBull = f_HYYBull or f_HNBull or f_HNVBull or f_HTBull or f_NHx2Bull or f_HYYNDBull or f_HNNDBull or f_HNVNDBull or f_HTNDBull or f_NHx2NDBull
bool hctMasterBear = f_HYYBear or f_HNBear or f_HNVBear or f_HTBear or f_NHx2Bear or f_HYYNDBear or f_HNNDBear or f_HNVNDBear or f_HTNDBear or f_NHx2NDBear

// Gate HCT: must coincide with any Singles detection signal
bool anySinglesRaw = sigSAAB or sigKratos or sigBullRVOL1x or sigBearRVOL1x or sigGrandSlam or sigMOAB or sigWTC or sigHiroshima or sigNagasaki or anyLong or anyShort
bool hctGatedBull  = hct_ref and hctMasterBull and anySinglesRaw
bool hctGatedBear  = hct_ref and hctMasterBear and anySinglesRaw

// =============================================================================
// PENTAGON SPECIAL SIGNALS
// =============================================================================
bool pentDisp5       = (high - low) > nz(hct_rangeStdev) * 5.0
bool is4KNow         = volume == ta.highest(volume, hv4k_len)
bool sigPent4KD      = conf and sigPentagon and is4KNow and pentDisp5
bool sigPentNagaD    = conf and sigPentagon and sigNagasaki and pentDisp5

// =============================================================================
// DISPLACEMENT STRENGTH 9 STUDIES — SAME-CANDLE COMPOSITES
// =============================================================================
float d9_rangeStdev = ta.stdev(high - low, d9_disp_lookback)
bool  d9_dispMet    = (high - low) > nz(d9_rangeStdev) * d9_disp_strength
bool  d9_hv500      = volume == ta.highest(volume, 500)
bool  d9_hv1000     = volume == ta.highest(volume, 1000)
bool  d9_heavyVol   = d9_hv500 or d9_hv1000 or sigNagasaki
bool  d9_bullRvol   = sigBullRVOL1x or sigGrandSlam
bool  d9_bearRvol   = sigBearRVOL1x or sigMOAB
bool  sigD9BullStudy = conf and d9_dispMet and d9_bullRvol and d9_heavyVol
bool  sigD9BearStudy = conf and d9_dispMet and d9_bearRvol and d9_heavyVol

// =============================================================================
// DISPLACEMENT ENGINE — PER-CONSUMER THRESHOLDS (no max cap)
// =============================================================================
disp_isBullishFVG = low > high[2] and open[1] < close[1]
disp_isBearishFVG = high < low[2] and open[1] > close[1]

disp_candle_range = i_disp_type == "Open to Close" ? math.abs(open - close) : high - low
disp_std_dev = ta.stdev(disp_candle_range, i_std_len)

disp_th_standalone = disp_std_dev * i_disp_std_standalone
disp_th_cdisp2     = disp_std_dev * i_disp_std_cdisp2
disp_th_cdisp3     = disp_std_dev * i_disp_std_cdisp3
disp_th_seq        = disp_std_dev * i_disp_std_seq

disp_cur_seq = disp_candle_range > disp_th_seq
disp_cur_any = disp_cur_seq

b2b_gate = anyHV_cur or disp_cur_any

// =============================================================================
// DISPLACEMENT — STANDALONE BULL/BEAR (FVG pattern, threshold=7.5)
// =============================================================================
disp_prev_standalone = disp_candle_range[1] > disp_th_standalone[1]
sigDispBull = disp_prev_standalone and disp_isBullishFVG
sigDispBear = disp_prev_standalone and disp_isBearishFVG

// =============================================================================
// DISPLACEMENT — CONSECUTIVE 2+ (FVG pattern, threshold=5.0)
// =============================================================================
disp_prev_c2 = disp_candle_range[1] > disp_th_cdisp2[1]
sigDispBull_c2 = disp_prev_c2 and disp_isBullishFVG
sigDispBear_c2 = disp_prev_c2 and disp_isBearishFVG

var int disp_bullStreak_c2 = 0
var int disp_bearStreak_c2 = 0
disp_bullStreak_c2 := sigDispBull_c2 ? disp_bullStreak_c2 + 1 : 0
disp_bearStreak_c2 := sigDispBear_c2 ? disp_bearStreak_c2 + 1 : 0

sigCDispBull2 = sigDispBull_c2 and disp_bullStreak_c2 >= 2
sigCDispBear2 = sigDispBear_c2 and disp_bearStreak_c2 >= 2

// =============================================================================
// DISPLACEMENT — CONSECUTIVE 3+ (FVG pattern, threshold=3.0)
// =============================================================================
disp_prev_c3 = disp_candle_range[1] > disp_th_cdisp3[1]
sigDispBull_c3 = disp_prev_c3 and disp_isBullishFVG
sigDispBear_c3 = disp_prev_c3 and disp_isBearishFVG

var int disp_bullStreak_c3 = 0
var int disp_bearStreak_c3 = 0
disp_bullStreak_c3 := sigDispBull_c3 ? disp_bullStreak_c3 + 1 : 0
disp_bearStreak_c3 := sigDispBear_c3 ? disp_bearStreak_c3 + 1 : 0

sigCDispBull3 = sigDispBull_c3 and disp_bullStreak_c3 >= 3
sigCDispBear3 = sigDispBear_c3 and disp_bearStreak_c3 >= 3

// =============================================================================
// RVOL SEQUENCE — WITH DISPLACEMENT TRACKING
// Sum threshold hardcoded to th_saab_kratos. No upper bound on bar RVOL.
// Override: U3/D3 with 2+ displaced, U4/D4 with 2+ displaced = auto-fire.
// =============================================================================
is_u_bar_UU   = bb_baseBullish and bb_normalizedPrice > th_low_UU_DD
is_u_bar_UUU  = bb_baseBullish and bb_normalizedPrice > th_low_UUU_DDD
is_u_bar_UUUU = bb_baseBullish and bb_normalizedPrice > th_low_UUUU_DDDD

is_d_bar_DD   = bb_baseBearish and bb_normalizedPrice > th_low_UU_DD
is_d_bar_DDD  = bb_baseBearish and bb_normalizedPrice > th_low_UUU_DDD
is_d_bar_DDDD = bb_baseBearish and bb_normalizedPrice > th_low_UUUU_DDDD

// --- UU / DD ---
var float bull_seq_sum_UU = 0.0
var int   bull_seq_len_UU = 0
var int   bull_disp_UU    = 0
var float bear_seq_sum_DD = 0.0
var int   bear_seq_len_DD = 0
var int   bear_disp_DD    = 0
if conf
    if is_u_bar_UU
        bull_seq_len_UU += 1
        bull_seq_sum_UU += bb_normalizedPrice
        bull_disp_UU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UU := 0
        bull_seq_sum_UU := 0.0
        bull_disp_UU    := 0
    if is_d_bar_DD
        bear_seq_len_DD += 1
        bear_seq_sum_DD += bb_normalizedPrice
        bear_disp_DD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DD := 0
        bear_seq_sum_DD := 0.0
        bear_disp_DD    := 0

// --- UUU / DDD ---
var float bull_seq_sum_UUU = 0.0
var int   bull_seq_len_UUU = 0
var int   bull_disp_UUU    = 0
var float bear_seq_sum_DDD = 0.0
var int   bear_seq_len_DDD = 0
var int   bear_disp_DDD    = 0
if conf
    if is_u_bar_UUU
        bull_seq_len_UUU += 1
        bull_seq_sum_UUU += bb_normalizedPrice
        bull_disp_UUU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UUU := 0
        bull_seq_sum_UUU := 0.0
        bull_disp_UUU    := 0
    if is_d_bar_DDD
        bear_seq_len_DDD += 1
        bear_seq_sum_DDD += bb_normalizedPrice
        bear_disp_DDD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DDD := 0
        bear_seq_sum_DDD := 0.0
        bear_disp_DDD    := 0

// --- UUUU / DDDD ---
var float bull_seq_sum_UUUU = 0.0
var int   bull_seq_len_UUUU = 0
var int   bull_disp_UUUU    = 0
var float bear_seq_sum_DDDD = 0.0
var int   bear_seq_len_DDDD = 0
var int   bear_disp_DDDD    = 0
if conf
    if is_u_bar_UUUU
        bull_seq_len_UUUU += 1
        bull_seq_sum_UUUU += bb_normalizedPrice
        bull_disp_UUUU    += disp_cur_seq ? 1 : 0
    else
        bull_seq_len_UUUU := 0
        bull_seq_sum_UUUU := 0.0
        bull_disp_UUUU    := 0
    if is_d_bar_DDDD
        bear_seq_len_DDDD += 1
        bear_seq_sum_DDDD += bb_normalizedPrice
        bear_disp_DDDD    += disp_cur_seq ? 1 : 0
    else
        bear_seq_len_DDDD := 0
        bear_seq_sum_DDDD := 0.0
        bear_disp_DDDD    := 0

// UU/DD: needs 1 displaced + sum >= SAAB threshold
sig_bull_UU   = conf and bull_seq_len_UU == 2 and bull_seq_sum_UU >= th_saab_kratos and bull_disp_UU >= 1
sig_bear_DD   = conf and bear_seq_len_DD == 2 and bear_seq_sum_DD >= th_saab_kratos and bear_disp_DD >= 1

// UUU/DDD: override if 2+ displaced, otherwise 1 displaced + sum >= SAAB
bool uu3_base     = conf and bull_seq_len_UUU == 3
bool uu3_override = uu3_base and bull_disp_UUU >= 2
bool uu3_normal   = uu3_base and bull_disp_UUU >= 1 and bull_seq_sum_UUU >= th_saab_kratos
sig_bull_UUU = uu3_override or uu3_normal

bool dd3_base     = conf and bear_seq_len_DDD == 3
bool dd3_override = dd3_base and bear_disp_DDD >= 2
bool dd3_normal   = dd3_base and bear_disp_DDD >= 1 and bear_seq_sum_DDD >= th_saab_kratos
sig_bear_DDD = dd3_override or dd3_normal

// UUUU/DDDD: override if 2+ displaced, otherwise 1 displaced + sum >= SAAB
bool uu4_base     = conf and bull_seq_len_UUUU == 4
bool uu4_override = uu4_base and bull_disp_UUUU >= 2
bool uu4_normal   = uu4_base and bull_disp_UUUU >= 1 and bull_seq_sum_UUUU >= th_saab_kratos
sig_bull_UUUU = uu4_override or uu4_normal

bool dd4_base     = conf and bear_seq_len_DDDD == 4
bool dd4_override = dd4_base and bear_disp_DDDD >= 2
bool dd4_normal   = dd4_base and bear_disp_DDDD >= 1 and bear_seq_sum_DDDD >= th_saab_kratos
sig_bear_DDDD = dd4_override or dd4_normal

// =============================================================================
// BACK-TO-BACK — GATED BY HV OR DISPLACEMENT
// =============================================================================
sig_B2B_2xSAAB   = conf and sigSAAB[1]       and sigSAAB       and b2b_gate
sig_B2B_2xKratos = conf and sigKratos[1]      and sigKratos     and b2b_gate
sig_B2B_2xBull1x = conf and sigBullRVOL1x[1]  and sigBullRVOL1x and b2b_gate
sig_B2B_2xBear1x = conf and sigBearRVOL1x[1]  and sigBearRVOL1x and b2b_gate

sig_B2B_MidBull = conf and not sig_B2B_2xSAAB and not sig_B2B_2xBull1x and ((sigSAAB[1] and sigBullRVOL1x) or (sigBullRVOL1x[1] and sigSAAB)) and b2b_gate
sig_B2B_MidBear = conf and not sig_B2B_2xKratos and not sig_B2B_2xBear1x and ((sigKratos[1] and sigBearRVOL1x) or (sigBearRVOL1x[1] and sigKratos)) and b2b_gate

// =============================================================================
// FAUNA — CALCULATIONS (kept for alert text) + GATED BY DISP + LONG/SHORT
// =============================================================================
float fn_alpha_MB  = 1.6
float fn_beta_MB   = 0.70
float fn_delta_MB  = 1.8
int   fn_atr_MB    = 14
int   fn_vol_MB    = 20

float fn_gamma_RE   = 2.2
float fn_epsilon_RE = 0.15
float fn_delta_RE   = 1.8
int   fn_atr_RE     = 14

float fn_zeta_GG  = 0.9
float fn_delta_GG = 1.8
int   fn_atr_GG   = 14

float fn_theta_TA      = 1.6
float fn_delta_TA      = 1.8
int   fn_trend_ma_len  = 50
int   fn_avg_delta_len = 10
int   fn_atr_TA        = 14

float fn_alpha_SB   = 1.5
float fn_delta_SB   = 1.5
float fn_weak_ratio = 0.2
int   fn_body_avg   = 20
int   fn_range_avg  = 20

fn_ATR      = ta.atr(fn_atr_MB)
fn_AvgVol   = ta.sma(volume, fn_vol_MB)
fn_AvgBody  = ta.sma(math.abs(close - open), fn_body_avg)
fn_AvgRange = ta.sma(high - low, fn_range_avg)
fn_AvgDelta = ta.sma(math.abs(close - close[1]), fn_avg_delta_len)
fn_TrendMA  = ta.sma(close, fn_trend_ma_len)

fn_body        = close - open
fn_candleRange = high - low
fn_body_up     = fn_body > 0
fn_body_dn     = fn_body < 0
fn_body_size   = math.abs(fn_body)
fn_body_ratio  = fn_candleRange == 0 ? 0.0 : fn_body_size / fn_candleRange

fn_MB_bull = fn_body_up and fn_body_size > fn_alpha_MB * fn_ATR and fn_body_ratio > fn_beta_MB and volume > fn_delta_MB * fn_AvgVol
fn_MB_bear = fn_body_dn and fn_body_size > fn_alpha_MB * fn_ATR and fn_body_ratio > fn_beta_MB and volume > fn_delta_MB * fn_AvgVol

fn_wide    = fn_candleRange > fn_gamma_RE * ta.atr(fn_atr_RE)
fn_RE_bull = fn_body_up and fn_wide and (high - close) < fn_epsilon_RE * fn_candleRange and volume > fn_delta_RE * fn_AvgVol
fn_RE_bear = fn_body_dn and fn_wide and (close - low) < fn_epsilon_RE * fn_candleRange and volume > fn_delta_RE * fn_AvgVol

fn_GG_bull = (open - close[1]) > fn_zeta_GG * ta.atr(fn_atr_GG) and fn_body_up and low > close[1] and volume > fn_delta_GG * fn_AvgVol
fn_GG_bear = (close[1] - open) > fn_zeta_GG * ta.atr(fn_atr_GG) and fn_body_dn and high < close[1] and volume > fn_delta_GG * fn_AvgVol

fn_up_trend = fn_TrendMA > fn_TrendMA[1]
fn_dn_trend = fn_TrendMA < fn_TrendMA[1]
fn_TA_bull = fn_up_trend and fn_body_up and (close - close[1]) > fn_theta_TA * fn_AvgDelta and volume > fn_delta_TA * fn_AvgVol
fn_TA_bear = fn_dn_trend and fn_body_dn and (close[1] - close) > fn_theta_TA * fn_AvgDelta and volume > fn_delta_TA * fn_AvgVol

fn_prev_body  = close[1] - open[1]
fn_prev_range = high[1] - low[1]

fn_StrongBear_pre = close[1] < open[1] and math.abs(fn_prev_body) > fn_alpha_SB * fn_AvgBody[1] and volume[1] > fn_delta_SB * fn_AvgVol[1]
fn_WeakBear_pre   = close[1] < open[1] and (fn_prev_range == 0 ? 0.0 : math.abs(fn_prev_body) / fn_prev_range) <= fn_weak_ratio
fn_StrongBull_pre = close[1] > open[1] and math.abs(fn_prev_body) > fn_alpha_SB * fn_AvgBody[1] and volume[1] > fn_delta_SB * fn_AvgVol[1]
fn_WeakBull_pre   = close[1] > open[1] and (fn_prev_range == 0 ? 0.0 : math.abs(fn_prev_body) / fn_prev_range) <= fn_weak_ratio

fn_TR_bull  = fn_WeakBear_pre   and (fn_MB_bull or fn_RE_bull or fn_TA_bull)
fn_ES_bull  = fn_StrongBear_pre and (fn_MB_bull or fn_RE_bull or fn_TA_bull)
fn_GDR_bull = close[1] < open[1] and fn_GG_bull

fn_TR_bear  = fn_WeakBull_pre   and (fn_MB_bear or fn_RE_bear or fn_TA_bear)
fn_ES_bear  = fn_StrongBull_pre and (fn_MB_bear or fn_RE_bear or fn_TA_bear)
fn_GDR_bear = close[1] > open[1] and fn_GG_bear

var string fn_bullText = ""
fn_bullText := ""
if show_FaunaBull
    if   fn_GG_bull and fn_MB_bull and fn_RE_bull and fn_TA_bull
        fn_bullText := "GG+MB+RE+TA"
    else if fn_MB_bull and fn_TA_bull and fn_RE_bull
        fn_bullText := "MB+TA+RE"
    else if fn_GG_bull and fn_TA_bull and fn_MB_bull
        fn_bullText := "GG+TA+MB"
    else if fn_GG_bull and fn_TA_bull and fn_RE_bull
        fn_bullText := "GG+TA+RE"
    else if fn_GDR_bull and fn_RE_bull and fn_MB_bull
        fn_bullText := "GDR+RE+MB"
    else if fn_MB_bull and fn_RE_bull
        fn_bullText := "MB+RE"
    else if fn_MB_bull and fn_GG_bull
        fn_bullText := "MB+GG"
    else if fn_MB_bull and fn_TA_bull
        fn_bullText := "MB+TA"
    else if fn_MB_bull and fn_TR_bull
        fn_bullText := "MB+TR"
    else if fn_MB_bull and fn_ES_bull
        fn_bullText := "MB+ES"
    else if fn_MB_bull and fn_GDR_bull
        fn_bullText := "MB+GDR"
    else if fn_RE_bull and fn_GG_bull
        fn_bullText := "RE+GG"
    else if fn_RE_bull and fn_TA_bull
        fn_bullText := "RE+TA"
    else if fn_RE_bull and fn_TR_bull
        fn_bullText := "RE+TR"
    else if fn_RE_bull and fn_ES_bull
        fn_bullText := "RE+ES"
    else if fn_RE_bull and fn_GDR_bull
        fn_bullText := "RE+GDR"
    else if fn_GG_bull and fn_TA_bull
        fn_bullText := "GG+TA"
    else if fn_GG_bull and fn_TR_bull
        fn_bullText := "GG+TR"
    else if fn_GG_bull and fn_ES_bull
        fn_bullText := "GG+ES"
    else if fn_GG_bull and fn_GDR_bull
        fn_bullText := "GG+GDR"
    else if fn_TA_bull and fn_TR_bull
        fn_bullText := "TA+TR"
    else if fn_TA_bull and fn_ES_bull
        fn_bullText := "TA+ES"
    else if fn_TA_bull and fn_GDR_bull
        fn_bullText := "TA+GDR"
    else if fn_GDR_bull
        fn_bullText := "GDR"
    else if fn_ES_bull
        fn_bullText := "ES"
    else if fn_TR_bull
        fn_bullText := "TR"
    else if fn_MB_bull
        fn_bullText := "MB"
    else if fn_RE_bull
        fn_bullText := "RE"
    else if fn_GG_bull
        fn_bullText := "GG"
    else if fn_TA_bull
        fn_bullText := "TA"

var string fn_bearText = ""
fn_bearText := ""
if show_FaunaBear
    if   fn_GG_bear and fn_MB_bear and fn_RE_bear and fn_TA_bear
        fn_bearText := "GG+MB+RE+TA"
    else if fn_MB_bear and fn_TA_bear and fn_RE_bear
        fn_bearText := "MB+TA+RE"
    else if fn_GG_bear and fn_TA_bear and fn_MB_bear
        fn_bearText := "GG+TA+MB"
    else if fn_GG_bear and fn_TA_bear and fn_RE_bear
        fn_bearText := "GG+TA+RE"
    else if fn_GDR_bear and fn_RE_bear and fn_MB_bear
        fn_bearText := "GDR+RE+MB"
    else if fn_MB_bear and fn_RE_bear
        fn_bearText := "MB+RE"
    else if fn_MB_bear and fn_GG_bear
        fn_bearText := "MB+GG"
    else if fn_MB_bear and fn_TA_bear
        fn_bearText := "MB+TA"
    else if fn_MB_bear and fn_TR_bear
        fn_bearText := "MB+TR"
    else if fn_MB_bear and fn_ES_bear
        fn_bearText := "MB+ES"
    else if fn_MB_bear and fn_GDR_bear
        fn_bearText := "MB+GDR"
    else if fn_RE_bear and fn_GG_bear
        fn_bearText := "RE+GG"
    else if fn_RE_bear and fn_TA_bear
        fn_bearText := "RE+TA"
    else if fn_RE_bear and fn_TR_bear
        fn_bearText := "RE+TR"
    else if fn_RE_bear and fn_ES_bear
        fn_bearText := "RE+ES"
    else if fn_RE_bear and fn_GDR_bear
        fn_bearText := "RE+GDR"
    else if fn_GG_bear and fn_TA_bear
        fn_bearText := "GG+TA"
    else if fn_GG_bear and fn_TR_bear
        fn_bearText := "GG+TR"
    else if fn_GG_bear and fn_ES_bear
        fn_bearText := "GG+ES"
    else if fn_GG_bear and fn_GDR_bear
        fn_bearText := "GG+GDR"
    else if fn_TA_bear and fn_TR_bear
        fn_bearText := "TA+TR"
    else if fn_TA_bear and fn_ES_bear
        fn_bearText := "TA+ES"
    else if fn_TA_bear and fn_GDR_bear
        fn_bearText := "TA+GDR"
    else if fn_GDR_bear
        fn_bearText := "GDR"
    else if fn_ES_bear
        fn_bearText := "ES"
    else if fn_TR_bear
        fn_bearText := "TR"
    else if fn_MB_bear
        fn_bearText := "MB"
    else if fn_RE_bear
        fn_bearText := "RE"
    else if fn_GG_bear
        fn_bearText := "GG"
    else if fn_TA_bear
        fn_bearText := "TA"

fn_bullRaw    = fn_bullText != "" and conf and disp_cur_seq and anyLong
fn_bearRaw    = fn_bearText != "" and conf and disp_cur_seq and anyShort
fn_bullActive = show_FaunaBull and fn_bullRaw
fn_bearActive = show_FaunaBear and fn_bearRaw

// =============================================================================
// HV CALCULATIONS — 150/250/350/500/1000 — NRA via [1], GATED BY LONG[1]
// =============================================================================
bool is150Bar  = volume[1] == ta.highest(volume, 150)[1]
bool is250Bar  = volume[1] == ta.highest(volume, 250)[1]
bool is350Bar  = volume[1] == ta.highest(volume, 350)[1]
bool is500Bar  = volume[1] == ta.highest(volume, 500)[1]
bool is1000Bar = volume[1] == ta.highest(volume, 1000)[1]

bool raw_HV1000 = show_HV1000 and is1000Bar
bool raw_HV500  = show_HV500  and is500Bar  and not is1000Bar
bool raw_HV350  = show_HV350  and is350Bar  and not is500Bar  and not is1000Bar
bool raw_HV250  = show_HV250  and is250Bar  and not is350Bar  and not is500Bar  and not is1000Bar
bool raw_HV150  = show_HV150  and is150Bar  and not is250Bar  and not is350Bar  and not is500Bar  and not is1000Bar

bool plot_HV1000 = raw_HV1000 and anyLong_1
bool plot_HV500  = raw_HV500  and anyLong_1
bool plot_HV350  = raw_HV350  and anyLong_1
bool plot_HV250  = raw_HV250  and anyLong_1
bool plot_HV150  = raw_HV150  and anyLong_1

// =============================================================================
// NAGASAKI + ANY (v3.2, operator order 2026-08-18) — partner census at the DETECTION
// level (checkbox-independent), SAME candle as the Nagasaki bar. The alert line NAMES
// every partner (operator law: a "+ any" alert must say which detection plot fired).
// Partners = singles (+LONG/+SHORT gated exactly as they plot), WTC/Hiroshima routed by
// the coincident momentum side, LONG 1-5 / SHORT 1-2, sequences, B2B, FAUNA, D9 studies.
// NOT partners: HCT composites, Pentagon specials, and every offset −1 lane (HV 150-1000,
// Disp, Consec Disp) — those mark bar[1], not this candle.
// =============================================================================
f_pj(existing, addition) =>
    existing == "" ? addition : existing + ", " + addition

string naga_partnersBull = ""
string naga_partnersBear = ""
if sigNagasaki
    if sigSAAB and anyLong
        naga_partnersBull := f_pj(naga_partnersBull, "SAAB")
    if sigBullRVOL1x and anyLong
        naga_partnersBull := f_pj(naga_partnersBull, "BULL RVOL 1x")
    if sigGrandSlam and anyLong
        naga_partnersBull := f_pj(naga_partnersBull, "GRAND SLAM")
    if sigWTC and anyLong
        naga_partnersBull := f_pj(naga_partnersBull, "WTC")
    if sigHiroshima and anyLong
        naga_partnersBull := f_pj(naga_partnersBull, "HIROSHIMA")
    if sigAddLong1
        naga_partnersBull := f_pj(naga_partnersBull, "LONG 1")
    if sigAddLong2
        naga_partnersBull := f_pj(naga_partnersBull, "LONG 2")
    if sigAddLong3
        naga_partnersBull := f_pj(naga_partnersBull, "LONG 3")
    if sigAddLong4
        naga_partnersBull := f_pj(naga_partnersBull, "LONG 4")
    if sigAddLong5
        naga_partnersBull := f_pj(naga_partnersBull, "LONG 5")
    if sig_bull_UU
        naga_partnersBull := f_pj(naga_partnersBull, "UU")
    if sig_bull_UUU
        naga_partnersBull := f_pj(naga_partnersBull, "UUU")
    if sig_bull_UUUU
        naga_partnersBull := f_pj(naga_partnersBull, "UUUU")
    if sig_B2B_2xSAAB
        naga_partnersBull := f_pj(naga_partnersBull, "2x SAAB")
    if sig_B2B_2xBull1x
        naga_partnersBull := f_pj(naga_partnersBull, "2x BULL 1x")
    if sig_B2B_MidBull
        naga_partnersBull := f_pj(naga_partnersBull, "B2B MID BULL")
    if fn_bullRaw
        naga_partnersBull := f_pj(naga_partnersBull, "FAUNA BULL")
    if sigD9BullStudy
        naga_partnersBull := f_pj(naga_partnersBull, "D9 BULL STUDY")
    if sigKratos and anyShort
        naga_partnersBear := f_pj(naga_partnersBear, "KRATOS")
    if sigBearRVOL1x and anyShort
        naga_partnersBear := f_pj(naga_partnersBear, "BEAR RVOL 1x")
    if sigMOAB and anyShort
        naga_partnersBear := f_pj(naga_partnersBear, "MOAB")
    if sigWTC and anyShort
        naga_partnersBear := f_pj(naga_partnersBear, "WTC")
    if sigHiroshima and anyShort
        naga_partnersBear := f_pj(naga_partnersBear, "HIROSHIMA")
    if sigAddShort1
        naga_partnersBear := f_pj(naga_partnersBear, "SHORT 1")
    if sigAddShort2
        naga_partnersBear := f_pj(naga_partnersBear, "SHORT 2")
    if sig_bear_DD
        naga_partnersBear := f_pj(naga_partnersBear, "DD")
    if sig_bear_DDD
        naga_partnersBear := f_pj(naga_partnersBear, "DDD")
    if sig_bear_DDDD
        naga_partnersBear := f_pj(naga_partnersBear, "DDDD")
    if sig_B2B_2xKratos
        naga_partnersBear := f_pj(naga_partnersBear, "2x KRATOS")
    if sig_B2B_2xBear1x
        naga_partnersBear := f_pj(naga_partnersBear, "2x BEAR 1x")
    if sig_B2B_MidBear
        naga_partnersBear := f_pj(naga_partnersBear, "B2B MID BEAR")
    if fn_bearRaw
        naga_partnersBear := f_pj(naga_partnersBear, "FAUNA BEAR")
    if sigD9BearStudy
        naga_partnersBear := f_pj(naga_partnersBear, "D9 BEAR STUDY")
bool sigNagaAnyBull = sigNagasaki and naga_partnersBull != ""
bool sigNagaAnyBear = sigNagasaki and naga_partnersBear != ""

// =============================================================================
// PLOTS — RVOL 0.56 (GATED BY LONG/SHORT)
// =============================================================================
plotshape(show_SAAB       and sigSAAB       and anyLong,  title="SAAB +LONG",              style=shape.square,       location=location.belowbar, size=size.tiny,   color=color.lime,    text="SAAB +LONG")
plotshape(show_Kratos     and sigKratos     and anyShort, title="Kratos +SHORT",           style=shape.square,       location=location.abovebar, size=size.tiny,   color=color.orange,  text="Krat +SHORT")
plotshape(show_BullRVOL1x and sigBullRVOL1x and anyLong,  title="Bull RVOL 1x +LONG",      style=shape.xcross,      location=location.belowbar, size=size.small,  color=color.green,   text="RV1x+ +LONG")
plotshape(show_BearRVOL1x and sigBearRVOL1x and anyShort, title="Bear RVOL 1x +SHORT",     style=shape.xcross,      location=location.abovebar, size=size.small,  color=color.red,     text="RV1x- +SHORT")
plotshape(show_GrandSlam  and sigGrandSlam  and anyLong,  title="Grand Slam +LONG",        style=shape.triangleup,  location=location.belowbar, size=size.normal, color=color.aqua,    text="DINGER +LONG")
plotshape(show_MOAB       and sigMOAB       and anyShort, title="MOAB +SHORT",             style=shape.triangledown,location=location.abovebar, size=size.normal, color=color.fuchsia, text="MOAB +SHORT")
plotshape(show_WTC        and sigWTC        and anyMom,   title="WTC +LONG/+SHORT",        style=shape.diamond,     location=location.top,      size=size.normal, color=color.yellow,  text="WTC +L/+S")
plotshape(show_Hiroshima  and sigHiroshima  and anyMom,   title="Hiroshima +LONG/+SHORT",  style=shape.diamond,     location=location.top,      size=size.normal, color=color.white,   text="H +L/+S")
plotshape(show_Nagasaki   and sigNagasaki   and anyMom,   title="Nagasaki +LONG/+SHORT",   style=shape.flag,        location=location.top,      size=size.normal, color=color.purple,  text="N +L/+S")

// =============================================================================
// PLOTS — SEQUENCES
// =============================================================================
plotshape(show_UU   and sig_bull_UU,   title="UU +disp",   location=location.belowbar, style=shape.triangleup,   size=size.small, color=color.lime,   text="UU +disp")
plotshape(show_UUU  and sig_bull_UUU,  title="UUU +disp",  location=location.belowbar, style=shape.triangleup,   size=size.small, color=color.blue,   text="UUU +disp")
plotshape(show_UUUU and sig_bull_UUUU, title="UUUU +disp", location=location.belowbar, style=shape.triangleup,   size=size.small, color=color.orange, text="4U +disp")
plotshape(show_DD   and sig_bear_DD,   title="DD +disp",   location=location.abovebar, style=shape.triangledown, size=size.small, color=color.red,    text="DD +disp")
plotshape(show_DDD  and sig_bear_DDD,  title="DDD +disp",  location=location.abovebar, style=shape.triangledown, size=size.small, color=color.purple, text="DDD +disp")
plotshape(show_DDDD and sig_bear_DDDD, title="DDDD +disp", location=location.abovebar, style=shape.triangledown, size=size.small, color=color.maroon, text="4D +disp")

