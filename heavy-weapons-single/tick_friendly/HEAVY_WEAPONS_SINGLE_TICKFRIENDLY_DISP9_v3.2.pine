plotshape(show_B2B_2xSAAB   and sig_B2B_2xSAAB,   title="2x SAAB +HV/disp",      location=location.belowbar, style=shape.labelup,   size=size.small, color=color.new(color.lime, 0),   text="2xSAAB +HV/disp",   textcolor=color.black)
plotshape(show_B2B_2xKratos and sig_B2B_2xKratos,  title="2x Kratos +HV/disp",    location=location.abovebar, style=shape.labeldown, size=size.small, color=color.new(color.orange, 0), text="2xKrat +HV/disp",   textcolor=color.black)
plotshape(show_B2B_2xBull1x and sig_B2B_2xBull1x,  title="2x Bull 1x +HV/disp",   location=location.belowbar, style=shape.labelup,   size=size.small, color=color.new(color.green, 0),  text="2xRV1x+ +HV/disp",  textcolor=color.white)
plotshape(show_B2B_2xBear1x and sig_B2B_2xBear1x,  title="2x Bear 1x +HV/disp",   location=location.abovebar, style=shape.labeldown, size=size.small, color=color.new(color.red, 0),    text="2xRV1x- +HV/disp",  textcolor=color.white)
plotshape(show_B2B_MidBull  and sig_B2B_MidBull,    title="B2B Mid Bull +HV/disp", location=location.belowbar, style=shape.labelup,   size=size.small, color=color.new(color.teal, 0),   text="B2B Mid+ +HV/disp", textcolor=color.white)
plotshape(show_B2B_MidBear  and sig_B2B_MidBear,    title="B2B Mid Bear +HV/disp", location=location.abovebar, style=shape.labeldown, size=size.small, color=color.new(color.maroon, 0), text="B2B Mid- +HV/disp", textcolor=color.white)

