// #############################################################################
// ###  INDICATOR 1: WHITE FLAG (MBRETAseqx3x247)                             ###
// #############################################################################
group_wf_mb = "1. White Flag - Momentum Blast (MB)"
wf_alpha_MB = input.float(1.6, "Body Size × ATR", group=group_wf_mb)
wf_beta_MB = input.float(0.7, "Body / Range ≥", minval=0.5, maxval=0.99, step=0.01, group=group_wf_mb)
wf_delta_MB = input.float(1.8, "Volume × Avg", group=group_wf_mb)
wf_atr_len_MB = input.int(14, "ATR Lookback", group=group_wf_mb)
wf_vol_len_MB = input.int(20, "Volume Lookback", group=group_wf_mb)
group_wf_re = "1. White Flag - Range Expansion (RE)"
wf_gamma_RE = input.float(2.2, "Range × ATR", group=group_wf_re)
wf_epsilon_RE = input.float(0.15, "Close‑to‑Edge ≤", group=group_wf_re)
wf_delta_RE = input.float(1.8, "Volume × Avg", group=group_wf_re)
wf_atr_len_RE = input.int(14, "ATR Lookback", group=group_wf_re)
wf_vol_len_RE = input.int(20, "Volume Lookback", group=group_wf_re)
group_wf_ta = "1. White Flag - Trend Accelerant (TA)"
wf_theta_TA = input.float(1.6, "ΔPrice × AvgΔ", group=group_wf_ta)
wf_delta_TA = input.float(1.8, "Volume × Avg", group=group_wf_ta)
wf_trend_ma_len_TA = input.int(50, "Trend MA Len", group=group_wf_ta)
wf_avg_delta_len = input.int(10, "Avg Δ Len", group=group_wf_ta)
group_wf_seq = "1. White Flag - Sequence Config"
wf_useMB = input.bool(true, "Count MB as Event?", group=group_wf_seq)
wf_useRE = input.bool(true, "Count RE as Event?", group=group_wf_seq)
wf_useTA = input.bool(true, "Count TA as Event?", group=group_wf_seq)
wf_ATR = ta.atr(wf_atr_len_MB)
wf_AvgVol = ta.sma(volume, wf_vol_len_MB)
wf_AvgDelta = ta.sma(math.abs(close - close[1]), wf_avg_delta_len)
wf_TrendMA = ta.sma(close, wf_trend_ma_len_TA)
wf_body = close - open
wf_candleRange = high - low
wf_body_up = wf_body > 0
wf_body_size = math.abs(wf_body)
wf_body_ratio = wf_candleRange == 0 ? 0 : wf_body_size / wf_candleRange
wf_MB_bull = wf_body_up and wf_body_size > wf_alpha_MB * wf_ATR and wf_body_ratio > wf_beta_MB and volume > wf_delta_MB * wf_AvgVol
wf_wide = wf_candleRange > wf_gamma_RE * wf_ATR
wf_RE_bull = wf_body_up and wf_wide and (high - close) < wf_epsilon_RE * wf_candleRange and volume > wf_delta_RE * wf_AvgVol
wf_up_trend = wf_TrendMA > wf_TrendMA[1]
wf_TA_bull = wf_up_trend and (close - close[1]) > wf_theta_TA * wf_AvgDelta and wf_body_up and volume > wf_delta_TA * wf_AvgVol
wf_isEvent = (wf_useMB and wf_MB_bull) or (wf_useRE and wf_RE_bull) or (wf_useTA and wf_TA_bull)
var int wf_seqLen = 0
if ta.change(dayofmonth) != 0
	wf_seqLen := 0
else if not wf_isEvent
	wf_seqLen := 0
if wf_isEvent
	wf_seqLen += 1
bool sWhiteFlagMomentum_raw = wf_isEvent and wf_seqLen == 3
plotshape(sWhiteFlagMomentum_raw and show_wf_momentum_plots, "White Flag Momentum", location=location.abovebar, style=shape.cross, color=color.new(color.white, 0), size=size.huge)


// #############################################################################
// ###  INDICATOR 2: ORANGE CLUSTER WINDOW (OranWindow)                       ###
// #############################################################################
grp_ow_rvol = "2. Orange Window - RVOL"
ow_avglength = input.int(30, title="Look-back Length", group=grp_ow_rvol)
ow_smaLength = input.int(20, title="SMA Length (RVOL³)", group=grp_ow_rvol)
grp_ow_seq = "2. Orange Window - Sequence"
ow_th_low = input.float(0.0, step=0.1, title="Lower RVOL Price Threshold", group=grp_ow_seq)
ow_th_high = input.float(3000000.0, step=0.1, title="Upper RVOL Price Threshold", group=grp_ow_seq)
ow_seqTh = input.float(0.0, step=0.1, title="Sequence Sum Threshold", group=grp_ow_seq)
grp_ow_cluster = "2. Orange Window - Overlap Cluster"
ow_ote_windowLen = input.int(75, title="Overlap Lookback Bars", group=grp_ow_cluster)
ow_ote_minOverlap = input.int(3, title="Min Overlapping Events", minval=1, group=grp_ow_cluster)
grp_ow_primary_cluster = "2. Orange Window - Super Cluster (Primary)"
ow_primaryWindowLen = input.int(75, "Lookback Bars", group=grp_ow_primary_cluster)
ow_minPrimaryOverlap = input.int(2, "Min Overlapping Events", minval=2, group=grp_ow_primary_cluster)
ow_primaryPaddingMultiplier = input.float(0.5, "Padding Multiplier", step=0.1, group=grp_ow_primary_cluster)
grp_ow_super_cluster = "2. Orange Window - Super Cluster (Super)"
ow_superWindowLen = input.int(30, "Lookback Bars", group=grp_ow_super_cluster)
ow_minSuperClusterOverlap = input.int(2, "Min Overlapping Clusters", minval=2, group=grp_ow_super_cluster)
ow_superPaddingMultiplier = input.float(0.5, "Padding Multiplier", step=0.1, group=grp_ow_super_cluster)
grp_ow_combined = "2. Orange Window - Combined Signal"
ow_rollingWindow = input.int(20, title="Rolling Window Period (Candles)", group=grp_ow_combined, minval=1)
ow_requiredEvents = input.int(2, title="Number of Events in Window", group=grp_ow_combined, minval=1)
ow_spike = math.abs(close - open)
ow_avgSpikeDenom = ta.sma(ow_spike, ow_avglength)[1]
ow_rvol_price = ow_spike / nz(ow_avgSpikeDenom, 1)
ow_avgVolDenom = ta.sma(volume, ow_avglength)[1]
ow_rvol_volume = volume / nz(ow_avgVolDenom, 1)
ow_rvol_diff = ow_rvol_price - ow_rvol_volume
ow_rvol3_pos = ow_rvol_diff > 0 ? ow_rvol_diff : na
ow_sma_rvol3 = ta.sma(ow_rvol3_pos, ow_smaLength)
ow_baseBull = close > open and nz(ow_rvol3_pos) > nz(ow_sma_rvol3)
ow_inRange(v) => v > ow_th_low and v < ow_th_high
ow_uBar_ote = ow_baseBull and ow_inRange(ow_rvol_price)
ow_uBar_super = ow_baseBull
var float ow_seqSum_ote = 0.0, var int ow_seqLen_ote = 0, var float ow_seqStartLow_ote = na
if ow_uBar_ote
	ow_seqLen_ote += 1, ow_seqSum_ote += ow_rvol_price
	if ow_seqLen_ote == 1
		ow_seqStartLow_ote := low
else
	ow_seqLen_ote := 0, ow_seqSum_ote := 0.0, ow_seqStartLow_ote := na
var float ow_seqSum_super = 0.0, var int ow_seqLen_super = 0, var float ow_seqStartLow_super = na
if ow_uBar_super
	ow_seqLen_super += 1, ow_seqSum_super += ow_rvol_price
	if ow_seqLen_super == 1
		ow_seqStartLow_super := low
else
	ow_seqLen_super := 0, ow_seqSum_super := 0.0, ow_seqStartLow_super := na
ow_conf = barstate.isconfirmed
ow_sigUU_ote = ow_seqLen_ote == 2 and ow_seqSum_ote >= ow_seqTh and ow_conf
ow_sigUUU_ote = ow_seqLen_ote == 3 and ow_seqSum_ote >= ow_seqTh and ow_conf
ow_sigUUUU_ote = ow_seqLen_ote == 4 and ow_seqSum_ote >= ow_seqTh and ow_conf
ow_isEvent_ote = ow_sigUU_ote or ow_sigUUU_ote or ow_sigUUUU_ote
ow_sigUU_super = ow_seqLen_super == 2 and ow_seqSum_super >= ow_seqTh and ow_conf
ow_sigUUU_super = ow_seqLen_super == 3 and ow_seqSum_super >= ow_seqTh and ow_conf
ow_sigUUUU_super = ow_seqLen_super == 4 and ow_seqSum_super >= ow_seqTh and ow_conf
ow_isEvent_super = ow_sigUU_super or ow_sigUUU_super or ow_sigUUUU_super
var int[] ow_ote_evIdx = array.new_int(), var float[] ow_ote_evHi = array.new_float(), var float[] ow_ote_evLo = array.new_float()
bool sOW_Overlap_raw = false
if ow_isEvent_ote
	ow_currentEventHigh = high, ow_currentEventLow = ow_seqStartLow_ote, ow_overlapCount = 0
	if array.size(ow_ote_evIdx) > 0
		for i = 0 to array.size(ow_ote_evIdx) - 1
			if array.get(ow_ote_evLo, i) <= ow_currentEventHigh and array.get(ow_ote_evHi, i) >= ow_currentEventLow
				ow_overlapCount += 1
	if (ow_overlapCount + 1) >= ow_ote_minOverlap
		sOW_Overlap_raw := true
	array.unshift(ow_ote_evIdx, bar_index), array.unshift(ow_ote_evHi, ow_currentEventHigh), array.unshift(ow_ote_evLo, ow_currentEventLow)
while array.size(ow_ote_evIdx) > 0
	if bar_index - array.get(ow_ote_evIdx, array.size(ow_ote_evIdx) - 1) > ow_ote_windowLen
		array.pop(ow_ote_evIdx)
		array.pop(ow_ote_evHi)
		array.pop(ow_ote_evLo)
	else
		break
var int[] ow_evIdx = array.new_int(), var float[] ow_evHi = array.new_float(), var float[] ow_evLo = array.new_float(), var float[] ow_evRvolSum = array.new_float()
var int[] ow_primaryCluster_Idx = array.new_int(), var float[] ow_primaryCluster_Hi = array.new_float(), var float[] ow_primaryCluster_Lo = array.new_float(), var float[] ow_primaryCluster_RvolSum = array.new_float()
bool sOW_Super_raw = false
while array.size(ow_evIdx) > 0
	if bar_index - array.get(ow_evIdx, array.size(ow_evIdx) - 1) > ow_primaryWindowLen
		array.pop(ow_evIdx)
		array.pop(ow_evHi)
		array.pop(ow_evLo)
		array.pop(ow_evRvolSum)
	else
		break
while array.size(ow_primaryCluster_Idx) > 0
	if bar_index - array.get(ow_primaryCluster_Idx, array.size(ow_primaryCluster_Idx) - 1) > ow_superWindowLen
		array.pop(ow_primaryCluster_Idx)
		array.pop(ow_primaryCluster_Hi)
		array.pop(ow_primaryCluster_Lo)
		array.pop(ow_primaryCluster_RvolSum)
	else
		break
if ow_isEvent_super
	ow_eventRange = high - ow_seqStartLow_super, ow_padding = ow_eventRange * ow_primaryPaddingMultiplier
	array.unshift(ow_evIdx, bar_index), array.unshift(ow_evHi, high + ow_padding), array.unshift(ow_evLo, ow_seqStartLow_super - ow_padding), array.unshift(ow_evRvolSum, ow_seqSum_super)
	ow_numEvents = array.size(ow_evIdx)
	if ow_numEvents >= ow_minPrimaryOverlap
		array<bool> ow_visited = array.new_bool(ow_numEvents, false)
		if not array.get(ow_visited, 0)
			int[] ow_queue = array.new_int(), int[] ow_currentClusterMembers = array.new_int()
			array.push(ow_queue, 0), array.set(ow_visited, 0, true)
			while array.size(ow_queue) > 0
				u = array.shift(ow_queue), array.push(ow_currentClusterMembers, u)
				for v = 0 to ow_numEvents - 1
					if not array.get(ow_visited, v) and array.get(ow_evLo, u) <= array.get(ow_evHi, v) and array.get(ow_evLo, v) <= array.get(ow_evHi, u)
						array.set(ow_visited, v, true), array.push(ow_queue, v)
			if array.size(ow_currentClusterMembers) >= ow_minPrimaryOverlap
				float ow_clusterMaxHi = na, float ow_clusterMinLo = na, float ow_clusterRvolSum = 0.0
				for i = 0 to array.size(ow_currentClusterMembers) - 1
					memberIdx = array.get(ow_currentClusterMembers, i)
					ow_clusterMaxHi := na(ow_clusterMaxHi) ? array.get(ow_evHi, memberIdx) : math.max(ow_clusterMaxHi, array.get(ow_evHi, memberIdx))
					ow_clusterMinLo := na(ow_clusterMinLo) ? array.get(ow_evLo, memberIdx) : math.min(ow_clusterMinLo, array.get(ow_evLo, memberIdx))
					ow_clusterRvolSum += array.get(ow_evRvolSum, memberIdx)
				array.unshift(ow_primaryCluster_Idx, bar_index), array.unshift(ow_primaryCluster_Hi, ow_clusterMaxHi), array.unshift(ow_primaryCluster_Lo, ow_clusterMinLo), array.unshift(ow_primaryCluster_RvolSum, ow_clusterRvolSum)
				ow_numPrimaryClusters = array.size(ow_primaryCluster_Idx)
				if ow_numPrimaryClusters >= ow_minSuperClusterOverlap
					array<bool> ow_visitedClusters = array.new_bool(ow_numPrimaryClusters, false)
					if not array.get(ow_visitedClusters, 0)
						int[] ow_superClusterQueue = array.new_int(), int[] ow_superClusterMembers = array.new_int()
						array.push(ow_superClusterQueue, 0), array.set(ow_visitedClusters, 0, true)
						while(array.size(ow_superClusterQueue) > 0)
							u_sc = array.shift(ow_superClusterQueue), array.push(ow_superClusterMembers, u_sc)
							for v_sc = 1 to ow_numPrimaryClusters - 1
								if not array.get(ow_visitedClusters, v_sc)
									u_hi = array.get(ow_primaryCluster_Hi, u_sc), u_lo = array.get(ow_primaryCluster_Lo, u_sc), v_hi = array.get(ow_primaryCluster_Hi, v_sc), v_lo = array.get(ow_primaryCluster_Lo, v_sc)
									u_padding = (u_hi - u_lo) * ow_superPaddingMultiplier, v_padding = (v_hi - v_lo) * ow_superPaddingMultiplier
									if (u_lo - u_padding) <= (v_hi + v_padding) and (v_lo - v_padding) <= (u_hi + u_padding)
										array.set(ow_visitedClusters, v_sc, true), array.push(ow_superClusterQueue, v_sc)
						if array.size(ow_superClusterMembers) >= ow_minSuperClusterOverlap
							sOW_Super_raw := true
var int[] ow_eventBarIndices = array.new_int()
bool ow_isOverlapStart = sOW_Overlap_raw and not sOW_Overlap_raw[1]
bool ow_isSuperStart = sOW_Super_raw and not sOW_Super_raw[1]
bool ow_isCombinedEvent = ow_isOverlapStart or ow_isSuperStart
if ow_isCombinedEvent
	array.push(ow_eventBarIndices, bar_index)
while array.size(ow_eventBarIndices) > 0
	if bar_index - array.get(ow_eventBarIndices, 0) >= ow_rollingWindow
		array.shift(ow_eventBarIndices)
	else
		break
bool sOW_Combined_raw = false
if array.size(ow_eventBarIndices) >= ow_requiredEvents
	sOW_Combined_raw := true
	lastEventIndex = array.pop(ow_eventBarIndices)
	array.clear(ow_eventBarIndices)
	array.push(ow_eventBarIndices, lastEventIndex)
plotshape(sOW_Overlap_raw and show_ow_overlap_plots, title="OW Overlap", location=location.bottom, style=shape.cross, size=size.huge, color=color.new(color.red, 0), text="")
plotshape(sOW_Super_raw and show_ow_super_plots, title="OW Super", location=location.bottom, style=shape.xcross, size=size.huge, color=color.new(color.blue, 0), text="")
plotshape(sOW_Combined_raw and show_ow_combined_plots, title="OW Combined", location=location.bottom, style=shape.circle, size=size.large, color=color.new(color.aqua, 75), text="")

// #############################################################################
// ###  INDICATOR 3: FAUNAOVRLP CLUSTER (FROM 5X HUB)                         ###
// #############################################################################
grp_fc_final = "3. FaunaOVRLP Cluster - Final Signal"
fc_signal_text = input.string("CLUSTER", "Signal Text (Unused in Plot)", group=grp_fc_final)
fc_signal_color = input.color(color.new(color.yellow, 60), "Signal Color", group=grp_fc_final)
grp_fc_s1_mb = "3. FaunaOVRLP Cluster - 1.1 MB_Sequence"
fc_s1_alpha_MB = input.float(1.6, "Body Size × ATR", group=grp_fc_s1_mb)
fc_s1_beta_MB = input.float(0.7, "Body / Range ≥", minval=0.5, maxval=0.99, step=0.01, group=grp_fc_s1_mb)
fc_s1_delta_MB = input.float(1.8, "Volume × Avg", group=grp_fc_s1_mb)
fc_s1_atr_len_MB = input.int(14, "ATR Lookback", group=grp_fc_s1_mb)
fc_s1_vol_len_MB = input.int(20, "Volume Lookback", group=grp_fc_s1_mb)
fc_s1_ATR = ta.atr(fc_s1_atr_len_MB)
fc_s1_AvgVol = ta.sma(volume, fc_s1_vol_len_MB)
fc_s1_body = close - open
fc_s1_candleRange = high - low
fc_s1_body_up = fc_s1_body > 0
fc_s1_body_size = math.abs(fc_s1_body)
fc_s1_body_ratio = fc_s1_candleRange == 0 ? 0 : fc_s1_body_size / fc_s1_candleRange
fc_s1_MB_bull = fc_s1_body_up and fc_s1_body_size > fc_s1_alpha_MB * fc_s1_ATR and fc_s1_body_ratio > fc_s1_beta_MB and volume > fc_s1_delta_MB * fc_s1_AvgVol
fc_s1_isEvent = fc_s1_MB_bull
var int fc_s1_seqLen = 0
if fc_s1_isEvent
	fc_s1_seqLen += 1
else
	fc_s1_seqLen := 0
fc_signal_indicator1 = fc_s1_isEvent and fc_s1_seqLen >= 2
grp_fc_s2_mb = "3. FaunaOVRLP Cluster - 1.2 MBRETA - MB", grp_fc_s2_re = "3. FaunaOVRLP Cluster - 1.2 MBRETA - RE", grp_fc_s2_ta = "3. FaunaOVRLP Cluster - 1.2 MBRETA - TA", grp_fc_s2_seq = "3. FaunaOVRLP Cluster - 1.2 MBRETA - Events"
fc_s2_alpha_MB = input.float(1.6, "Body Size × ATR", group=grp_fc_s2_mb), fc_s2_beta_MB = input.float(0.7, "Body / Range ≥", minval=0.5, maxval=0.99, step=0.01, group=grp_fc_s2_mb)
fc_s2_delta_MB = input.float(1.8, "Volume × Avg", group=grp_fc_s2_mb), fc_s2_atr_len_MB = input.int(14, "ATR Lookback", group=grp_fc_s2_mb), fc_s2_vol_len_MB = input.int(20, "Volume Lookback", group=grp_fc_s2_mb)
fc_s2_gamma_RE = input.float(2.2, "Range × ATR", group=grp_fc_s2_re), fc_s2_epsilon_RE = input.float(0.15, "Close‑to‑Edge ≤", group=grp_fc_s2_re)
fc_s2_delta_RE = input.float(1.8, "Volume × Avg", group=grp_fc_s2_re), fc_s2_atr_len_RE = input.int(14, "ATR Lookback", group=grp_fc_s2_re), fc_s2_vol_len_RE = input.int(20, "Volume Lookback", group=grp_fc_s2_re)
fc_s2_theta_TA = input.float(1.6, "ΔPrice × AvgΔ", group=grp_fc_s2_ta), fc_s2_delta_TA = input.float(1.8, "Volume × Avg", group=grp_fc_s2_ta)
fc_s2_trend_ma_len_TA = input.int(50, "Trend MA Len", group=grp_fc_s2_ta), fc_s2_avg_delta_len = input.int(10, "Avg Δ Len", group=grp_fc_s2_ta)
fc_s2_useMB = input.bool(true, "Count MB?", group=grp_fc_s2_seq), fc_s2_useRE = input.bool(true, "Count RE?", group=grp_fc_s2_seq), fc_s2_useTA = input.bool(true, "Count TA?", group=grp_fc_s2_seq)
fc_s2_ATR = ta.atr(fc_s2_atr_len_MB), fc_s2_AvgVol = ta.sma(volume, fc_s2_vol_len_MB), fc_s2_AvgDelta = ta.sma(math.abs(close - close[1]), fc_s2_avg_delta_len), fc_s2_TrendMA = ta.sma(close, fc_s2_trend_ma_len_TA)
fc_s2_body = close - open, fc_s2_candleRange = high - low, fc_s2_body_up = fc_s2_body > 0, fc_s2_body_size = math.abs(fc_s2_body), fc_s2_body_ratio = fc_s2_candleRange == 0 ? 0 : fc_s2_body_size / fc_s2_candleRange
fc_s2_MB_bull = fc_s2_body_up and fc_s2_body_size > fc_s2_alpha_MB * fc_s2_ATR and fc_s2_body_ratio > fc_s2_beta_MB and volume > fc_s2_delta_MB * fc_s2_AvgVol
fc_s2_wide = fc_s2_candleRange > fc_s2_gamma_RE * fc_s2_ATR, fc_s2_RE_bull = fc_s2_body_up and fc_s2_wide and (high - close) < fc_s2_epsilon_RE * fc_s2_candleRange and volume > fc_s2_delta_RE * fc_s2_AvgVol
fc_s2_up_trend = fc_s2_TrendMA > fc_s2_TrendMA[1], fc_s2_TA_bull = fc_s2_up_trend and (close - close[1]) > fc_s2_theta_TA * fc_s2_AvgDelta and fc_s2_body_up and volume > fc_s2_delta_TA * fc_s2_AvgVol
fc_s2_isEvent = (fc_s2_useMB and fc_s2_MB_bull) or (fc_s2_useRE and fc_s2_RE_bull) or (fc_s2_useTA and fc_s2_TA_bull)
var int fc_s2_seqLen = 0
if ta.change(dayofmonth) != 0
	fc_s2_seqLen := 0
else if not fc_s2_isEvent
	fc_s2_seqLen := 0
if fc_s2_isEvent
	fc_s2_seqLen += 1
fc_signal_indicator2 = fc_s2_isEvent and fc_s2_seqLen >= 2
grp_fc_s3_mb = "3. FaunaOVRLP Cluster - 1.3 MB+RE - MB"
grp_fc_s3_re = "3. FaunaOVRLP Cluster - 1.3 MB+RE - RE"
grp_fc_s3_seq = "3. FaunaOVRLP Cluster - 1.3 MB+RE - Events"
grp_fc_s3_session = "3. FaunaOVRLP Cluster - 1.3 MB+RE - Session"
fc_s3_alpha_MB = input.float(1.6, "Body Size × ATR", group=grp_fc_s3_mb), fc_s3_beta_MB = input.float(0.7, "Body / Range ≥", minval=0.5, maxval=0.99, step=0.01, group=grp_fc_s3_mb)
fc_s3_delta_MB = input.float(1.8, "Volume × Avg", group=grp_fc_s3_mb), fc_s3_atr_len_MB = input.int(14, "ATR Lookback", group=grp_fc_s3_mb), fc_s3_vol_len_MB = input.int(20, "Volume Lookback", group=grp_fc_s3_mb)
fc_s3_gamma_RE = input.float(2.2, "Range × ATR", group=grp_fc_s3_re), fc_s3_epsilon_RE = input.float(0.15, "Close‑to‑Edge ≤", group=grp_fc_s3_re)
fc_s3_delta_RE = input.float(1.8, "Volume × Avg", group=grp_fc_s3_re), fc_s3_atr_len_RE = input.int(14, "ATR Lookback", group=grp_fc_s3_re), fc_s3_vol_len_RE = input.int(20, "Volume Lookback", group=grp_fc_s3_re)
fc_s3_useMB = input.bool(true, "Count MB?", group=grp_fc_s3_seq), fc_s3_useRE = input.bool(true, "Count RE?", group=grp_fc_s3_seq)
fc_s3_tradingSession = input.session("0930-1600", "Trading Session", group=grp_fc_s3_session), fc_s3_timeZone = input.string("America/New_York", "Time Zone", group=grp_fc_s3_session, options=["America/New_York", "America/Chicago", "UTC"])
fc_s3_ATR = ta.atr(fc_s3_atr_len_MB), fc_s3_AvgVol = ta.sma(volume, fc_s3_vol_len_MB), fc_s3_isWithinSession = not na(time((str.endswith(timeframe.period, "T") ? "1" : timeframe.period), fc_s3_tradingSession, fc_s3_timeZone))
fc_s3_body = close - open, fc_s3_candleRange = high - low, fc_s3_body_up = fc_s3_body > 0, fc_s3_body_size = math.abs(fc_s3_body), fc_s3_body_ratio = fc_s3_candleRange == 0 ? 0 : fc_s3_body_size / fc_s3_candleRange
fc_s3_MB_bull = fc_s3_body_up and fc_s3_body_size > fc_s3_alpha_MB * fc_s3_ATR and fc_s3_body_ratio > fc_s3_beta_MB and volume > fc_s3_delta_MB * fc_s3_AvgVol
fc_s3_wide = fc_s3_candleRange > fc_s3_gamma_RE * fc_s3_ATR, fc_s3_RE_bull = fc_s3_body_up and fc_s3_wide and (high - close) < fc_s3_epsilon_RE * fc_s3_candleRange and volume > fc_s3_delta_RE * fc_s3_AvgVol
fc_s3_isEvent = ((fc_s3_useMB and fc_s3_MB_bull) or (fc_s3_useRE and fc_s3_RE_bull)) and fc_s3_isWithinSession
var int fc_s3_seqLen = 0
if fc_s3_isEvent
	fc_s3_seqLen += 1
else
	fc_s3_seqLen := 0
fc_signal_indicator3 = fc_s3_isEvent and fc_s3_seqLen >= 2
fc_signal_count = (fc_signal_indicator1 ? 1 : 0) + (fc_signal_indicator2 ? 1 : 0) + (fc_signal_indicator3 ? 1 : 0)
bool sFC_2of3_raw = fc_signal_count >= 2
grp_fc_rvol = "3. FaunaOVRLP Cluster - 2.1 RVOL", grp_fc_th_event = "3. FaunaOVRLP Cluster - 2.2 Threshold", grp_fc_seq_event = "3. FaunaOVRLP Cluster - 2.3 Sequence", grp_fc_overlap = "3. FaunaOVRLP Cluster - 2.4 Overlap"
fc_avglength = input.int(30, title="Look-back", group=grp_fc_rvol), fc_smaLength = input.int(20, title="SMA Length", group=grp_fc_rvol)
fc_th_low = input.float(2.9, step=0.1, title="Lower Threshold", group=grp_fc_th_event), fc_th_high = input.float(1000000.0, step=0.1, title="Upper Threshold", group=grp_fc_th_event)
fc_seqTh = input.float(0.1, step=0.1, title="Sequence Sum Threshold", group=grp_fc_seq_event)
fc_overlapWindowLen = input.int(20, "Lookback Bars", group=grp_fc_overlap), fc_overlapPaddingMultiplier = input.float(0.0, "Padding Multiplier", step=0.1, minval=0, group=grp_fc_overlap)
fc_spike = math.abs(close - open), fc_avgSpikeDenom = ta.sma(fc_spike, fc_avglength)[1], fc_rvol_price = fc_spike / nz(fc_avgSpikeDenom, 1)
fc_avgVolDenom = ta.sma(volume, fc_avglength)[1], fc_rvol_volume = volume / nz(fc_avgVolDenom, 1), fc_rvol_diff = fc_rvol_price - fc_rvol_volume
fc_rvol3_pos = fc_rvol_diff > 0 ? fc_rvol_diff : na, fc_sma_rvol3 = ta.sma(fc_rvol3_pos, fc_smaLength), fc_baseBull_Th = close > open and nz(fc_rvol3_pos) > nz(fc_sma_rvol3)
fc_inRange_Th(v) => v > fc_th_low and v < fc_th_high
fc_isThresholdEvent = fc_baseBull_Th and fc_inRange_Th(fc_rvol_price) and barstate.isconfirmed
fc_uBar = fc_baseBull_Th and fc_inRange_Th(fc_rvol_price)
var float fc_seqSum = 0.0, var int fc_seqLen = 0
if fc_uBar
	fc_seqLen += 1, fc_seqSum += fc_rvol_price
else
	fc_seqLen := 0, fc_seqSum := 0.0
fc_sigUU = fc_seqLen == 2 and fc_seqSum >= fc_seqTh, fc_sigUUU = fc_seqLen == 3 and fc_seqSum >= fc_seqTh, fc_sigUUUU = fc_seqLen == 4 and fc_seqSum >= fc_seqTh
fc_isSequenceEvent = (fc_sigUU or fc_sigUUU or fc_sigUUUU) and barstate.isconfirmed
var int[] fc_thEvent_Idx = array.new_int(), var float[] fc_thEvent_Hi = array.new_float(), var float[] fc_thEvent_Lo = array.new_float()
var int[] fc_seqEvent_Idx = array.new_int(), var float[] fc_seqEvent_Hi = array.new_float(), var float[] fc_seqEvent_Lo = array.new_float()
bool sFC_Overlap_raw = false
if array.size(fc_thEvent_Idx) > 0
	while bar_index - array.get(fc_thEvent_Idx, 0) > fc_overlapWindowLen
		array.shift(fc_thEvent_Idx), array.shift(fc_thEvent_Hi), array.shift(fc_thEvent_Lo)
		if array.size(fc_thEvent_Idx) == 0
			break
if array.size(fc_seqEvent_Idx) > 0
	while bar_index - array.get(fc_seqEvent_Idx, 0) > fc_overlapWindowLen
		array.shift(fc_seqEvent_Idx), array.shift(fc_seqEvent_Hi), array.shift(fc_seqEvent_Lo)
		if array.size(fc_seqEvent_Idx) == 0
			break
fc_checkOverlap(loA, hiA, loB, hiB) => loA <= hiB and loB <= hiA
if fc_isThresholdEvent
	eventRange = high - low, padding = eventRange * fc_overlapPaddingMultiplier
	currentTh_Hi = high + padding, currentTh_Lo = low - padding
	array.push(fc_thEvent_Idx, bar_index), array.push(fc_thEvent_Hi, currentTh_Hi), array.push(fc_thEvent_Lo, currentTh_Lo)
	if array.size(fc_seqEvent_Idx) > 0
		for i = 0 to array.size(fc_seqEvent_Idx) - 1
			if fc_checkOverlap(currentTh_Lo, currentTh_Hi, array.get(fc_seqEvent_Lo, i), array.get(fc_seqEvent_Hi, i))
				sFC_Overlap_raw := true, break
if fc_isSequenceEvent and not sFC_Overlap_raw
	eventRange = high - low, padding = eventRange * fc_overlapPaddingMultiplier
	currentSeq_Hi = high + padding, currentSeq_Lo = low - padding
	array.push(fc_seqEvent_Idx, bar_index), array.push(fc_seqEvent_Hi, currentSeq_Hi), array.push(fc_seqEvent_Lo, currentSeq_Lo)
	if array.size(fc_thEvent_Idx) > 0
		for i = 0 to array.size(fc_thEvent_Idx) - 1
			if fc_checkOverlap(currentSeq_Lo, currentSeq_Hi, array.get(fc_thEvent_Lo, i), array.get(fc_thEvent_Hi, i))
				sFC_Overlap_raw := true, break
bool sFC_Cluster_raw = sFC_2of3_raw and sFC_Overlap_raw
plotshape(series=sFC_Cluster_raw and show_fc_cluster_plots, title="FC Cluster", location=location.belowbar, color=fc_signal_color, style=shape.labeldown, size=size.huge, text="CLUSTER")
plotshape(series=sFC_2of3_raw and show_fc_2of3_plots, title="FC 2/3 Fauna", style=shape.triangleup, location=location.abovebar, color=color.new(color.orange, 20), size=size.huge, text="")
plotshape(series=sFC_Overlap_raw and show_fc_overlap_plots, title="FC Overlap", location=location.abovebar, style=shape.diamond, size=size.large, color=color.new(color.red, 50), text="")

// #############################################################################
// ###  INDICATOR 4: E3 (Fauna Sequence First 3 RTH)                          ###
// #############################################################################
grp_e3_mb = "4. E3 - Momentum Blast (MB)", grp_e3_re = "4. E3 - Range Expansion (RE)", grp_e3_ta = "4. E3 - Trend Accelerant (TA)", grp_e3_config = "4. E3 - Session & Config"
e3_alpha_MB = input.float(1.6, "Body Size × ATR", group=grp_e3_mb), e3_beta_MB = input.float(0.7, "Body / Range ≥", minval=0.5, maxval=0.99, step=0.01, group=grp_e3_mb)
e3_delta_MB = input.float(1.8, "Volume × Avg", group=grp_e3_mb), e3_atr_len_MB = input.int(14, "ATR Lookback", group=grp_e3_mb), e3_vol_len_MB = input.int(20, "Volume Lookback", group=grp_e3_mb)
e3_gamma_RE = input.float(2.2, "Range × ATR", group=grp_e3_re), e3_epsilon_RE = input.float(0.15, "Close‑to‑Edge ≤", group=grp_e3_re)
e3_delta_RE = input.float(1.8, "Volume × Avg", group=grp_e3_re), e3_atr_len_RE = input.int(14, "ATR Lookback", group=grp_e3_re), e3_vol_len_RE = input.int(20, "Volume Lookback", group=grp_e3_re)
e3_theta_TA = input.float(1.6, "ΔPrice × AvgΔ", group=grp_e3_ta), e3_delta_TA = input.float(1.8, "Volume × Avg", group=grp_e3_ta)
e3_trend_ma_len_TA = input.int(50, "Trend MA Len", group=grp_e3_ta), e3_avg_delta_len = input.int(10, "Avg Δ Len", group=grp_e3_ta)
e3_tradingSession = input.session("0930-1600", "RTH Trading Session", group=grp_e3_config), e3_timeZone = input.string("America/New_York", "Time Zone", group=grp_e3_config, options=["America/New_York", "America/Chicago", "UTC"])
e3_useMB = input.bool(true, "Count MB?", group=grp_e3_config), e3_useRE = input.bool(true, "Count RE?", group=grp_e3_config), e3_useTA = input.bool(true, "Count TA?", group=grp_e3_config)
e3_ATR = ta.atr(e3_atr_len_MB), e3_AvgVol = ta.sma(volume, e3_vol_len_MB), e3_AvgDelta = ta.sma(math.abs(close - close[1]), e3_avg_delta_len), e3_TrendMA = ta.sma(close, e3_trend_ma_len_TA)
e3_body = close - open, e3_candleRange = high - low, e3_body_up = e3_body > 0, e3_body_size = math.abs(e3_body), e3_body_ratio = e3_candleRange == 0 ? 0 : e3_body_size / e3_candleRange
e3_MB_bull = e3_body_up and e3_body_size > e3_alpha_MB * e3_ATR and e3_body_ratio > e3_beta_MB and volume > e3_delta_MB * e3_AvgVol
e3_wide = e3_candleRange > e3_gamma_RE * e3_ATR, e3_RE_bull = e3_body_up and e3_wide and (high - close) < e3_epsilon_RE * e3_candleRange and volume > e3_delta_RE * e3_AvgVol
e3_up_trend = e3_TrendMA > e3_TrendMA[1], e3_TA_bull = e3_up_trend and (close - close[1]) > e3_theta_TA * e3_AvgDelta and e3_body_up and volume > e3_delta_TA * e3_AvgVol
e3_isEvent = (e3_useMB and e3_MB_bull) or (e3_useRE and e3_RE_bull) or (e3_useTA and e3_TA_bull)
e3_isWithinSession = not na(time((str.endswith(timeframe.period, "T") ? "1" : timeframe.period), e3_tradingSession, e3_timeZone))
var bool e3_isNewDay = false
if ta.change(dayofmonth) != 0
	e3_isNewDay := true
var int e3_sessionBarCounter = 0
if e3_isNewDay and e3_isWithinSession
	e3_sessionBarCounter := 1, e3_isNewDay := false
else if e3_isWithinSession and e3_sessionBarCounter > 0
	e3_sessionBarCounter += 1
else if not e3_isWithinSession
	e3_sessionBarCounter := 0
bool sE3_raw = e3_sessionBarCounter == 3 and e3_isEvent and e3_isEvent[1] and e3_isEvent[2]
plotshape(sE3_raw and show_e3_plots, "E3", location=location.top, style=shape.circle, color=color.new(color.white, 60), size=size.huge, text="E3")

// #############################################################################
// ###  INDICATOR 5: OoOC Overlap^2 Meta Pink Diamond                         ###
// #############################################################################
grp_oooc_rvol = "5. OoOC - RVOL", grp_oooc_bar = "5. OoOC - Bar Threshold", grp_oooc_seq = "5. OoOC - Sequence", grp_oooc_cluster = "5. OoOC - Primary Cluster", grp_oooc_meta = "5. OoOC - Meta-Cluster"
oooc_avglength = input.int(30, title="Look-back Length", group=grp_oooc_rvol), oooc_smaLength = input.int(20, title="SMA Length (RVOL³)", group=grp_oooc_rvol)
oooc_th_low = input.float(1.0, step=0.1, title="Lower Threshold", group=grp_oooc_bar), oooc_th_high = input.float(4000000.0, step=0.1, title="Upper Threshold", group=grp_oooc_bar)
oooc_seqTh = input.float(0.0, step=0.1, title="Sequence Sum Threshold", group=grp_oooc_seq)
oooc_windowLen = input.int(8, title="Overlap Lookback Bars", group=grp_oooc_cluster), oooc_minOverlap = input.int(2, title="Min Overlapping U-Sequences", minval=1, group=grp_oooc_cluster)
oooc_metaWindowLen = input.int(8, title="Meta-Cluster Lookback Bars", group=grp_oooc_meta), oooc_minMetaOverlap = input.int(2, title="Min Overlapping Clusters", minval=2, group=grp_oooc_meta)
oooc_spike = math.abs(close - open), oooc_avgSpikeDenom = ta.sma(oooc_spike, oooc_avglength)[1], oooc_rvol_price = oooc_spike / nz(oooc_avgSpikeDenom, 1)
oooc_avgVolDenom = ta.sma(volume, oooc_avglength)[1], oooc_rvol_volume = volume / nz(oooc_avgVolDenom, 1), oooc_rvol_diff = oooc_rvol_price - oooc_rvol_volume
oooc_rvol3_pos = oooc_rvol_diff > 0 ? oooc_rvol_diff : na, oooc_sma_rvol3 = ta.sma(oooc_rvol3_pos, oooc_smaLength)
oooc_baseBull = close > open and nz(oooc_rvol3_pos) > nz(oooc_sma_rvol3)
oooc_inRange(v) => v > oooc_th_low and v < oooc_th_high
oooc_uBar = oooc_baseBull and oooc_inRange(oooc_rvol_price)
var float oooc_seqSum = 0.0, var int oooc_seqLen = 0, var float oooc_seqStartLow = na
if oooc_uBar
	oooc_seqLen += 1, oooc_seqSum += oooc_rvol_price
	if oooc_seqLen == 1
		oooc_seqStartLow := low
else
	oooc_seqLen := 0, oooc_seqSum := 0.0, oooc_seqStartLow := na
oooc_conf = barstate.isconfirmed
oooc_sigUU = oooc_seqLen == 2 and oooc_seqSum >= oooc_seqTh and oooc_conf, oooc_sigUUU = oooc_seqLen == 3 and oooc_seqSum >= oooc_seqTh and oooc_conf, oooc_sigUUUU = oooc_seqLen == 4 and oooc_seqSum >= oooc_seqTh and oooc_conf
var int[] oooc_evIdx = array.new_int(), var float[] oooc_evHi = array.new_float(), var float[] oooc_evLo = array.new_float()
oooc_isEvent = oooc_sigUU or oooc_sigUUU or oooc_sigUUUU, oooc_primaryClusterTrigger = false
if oooc_isEvent
	currentEventHigh = high, currentEventLow = oooc_seqStartLow, overlapCount = 0
	if array.size(oooc_evIdx) > 0
		for i = 0 to array.size(oooc_evIdx) - 1
			if array.get(oooc_evLo, i) <= currentEventHigh and array.get(oooc_evHi, i) >= currentEventLow
				overlapCount += 1
	if (overlapCount + 1) >= oooc_minOverlap
		oooc_primaryClusterTrigger := true
	array.unshift(oooc_evIdx, bar_index), array.unshift(oooc_evHi, currentEventHigh), array.unshift(oooc_evLo, currentEventLow)
while array.size(oooc_evIdx) > 0
	if bar_index - array.get(oooc_evIdx, array.size(oooc_evIdx) - 1) > oooc_windowLen
		array.pop(oooc_evIdx)
		array.pop(oooc_evHi)
		array.pop(oooc_evLo)
	else
		break
var int[] oooc_meta_evIdx = array.new_int(), var int[] oooc_meta_evUCount = array.new_int(), var float[] oooc_meta_evStartLow = array.new_float()
bool sOoOC_raw = false
if oooc_primaryClusterTrigger
	uCount = oooc_sigUUUU ? 4 : oooc_sigUUU ? 3 : 2
	array.unshift(oooc_meta_evIdx, bar_index), array.unshift(oooc_meta_evUCount, uCount), array.unshift(oooc_meta_evStartLow, oooc_seqStartLow)
	metaOverlapCount = 0
	if array.size(oooc_meta_evIdx) > 1
		current_UCount = uCount, current_StartLow = oooc_seqStartLow
		for i = 1 to array.size(oooc_meta_evIdx) - 1
			past_Idx = array.get(oooc_meta_evIdx, i), past_UCount = array.get(oooc_meta_evUCount, i), past_StartLow = array.get(oooc_meta_evStartLow, i)
			masterUCount = math.max(current_UCount, past_UCount)
			currentHighBarLookahead = masterUCount - current_UCount
			pastHighBarOffset = bar_index - (past_Idx - (past_UCount - 1) + (masterUCount - 1))
			if bar_index >= currentHighBarLookahead and bar_index >= pastHighBarOffset
				currentRangeHigh = high[currentHighBarLookahead]
				currentRangeLow = current_StartLow
				pastRangeHigh = high[pastHighBarOffset]
				pastRangeLow = past_StartLow
				if pastRangeLow <= currentRangeHigh and pastRangeHigh >= currentRangeLow
					metaOverlapCount += 1
	if (metaOverlapCount + 1) >= oooc_minMetaOverlap
		sOoOC_raw := true
while array.size(oooc_meta_evIdx) > 0
	if bar_index - array.get(oooc_meta_evIdx, array.size(oooc_meta_evIdx) - 1) > oooc_metaWindowLen
		array.pop(oooc_meta_evIdx)
		array.pop(oooc_meta_evUCount)
		array.pop(oooc_meta_evStartLow)
	else
		break
plotshape(sOoOC_raw and show_oooc_plots, "OoOC", location=location.bottom, style=shape.diamond, size=size.large, color=color.new(color.fuchsia, 50), text="")

// #############################################################################
// ###  INDICATOR 6: RED PLUS SEQUENCE                                        ###
// #############################################################################
group_rp_mb = "6. Red Plus - Momentum Blast (MB)"
rp_alpha_MB = input.float(1.6, "Body Size × ATR", group=group_rp_mb)
rp_beta_MB = input.float(0.7, "Body / Range ≥", minval=0.5, maxval=0.99, step=0.01, group=group_rp_mb)
rp_delta_MB = input.float(1.8, "Volume × Avg", group=group_rp_mb)
rp_atr_len_MB = input.int(14, "ATR Lookback", group=group_rp_mb)
rp_vol_len_MB = input.int(20, "Volume Lookback", group=group_rp_mb)
group_rp_re = "6. Red Plus - Range Expansion (RE)"
rp_gamma_RE = input.float(2.2, "Range × ATR", group=group_rp_re)
rp_epsilon_RE = input.float(0.15, "Close‑to‑Edge ≤", group=group_rp_re)
rp_delta_RE = input.float(1.8, "Volume × Avg", group=group_rp_re)
rp_atr_len_RE = input.int(14, "ATR Lookback", group=group_rp_re)
rp_vol_len_RE = input.int(20, "Volume Lookback", group=group_rp_re)
group_rp_ta = "6. Red Plus - Trend Accelerant (TA)"
rp_theta_TA = input.float(1.6, "ΔPrice × AvgΔ", group=group_rp_ta)
rp_delta_TA = input.float(1.8, "Volume × Avg", group=group_rp_ta)
rp_trend_ma_len_TA = input.int(50, "Trend MA Len", group=group_rp_ta)
rp_avg_delta_len = input.int(10, "Avg Δ Len", group=group_rp_ta)
group_rp_seq = "6. Red Plus - Sequence Config"
rp_useMB = input.bool(true, "Count MB as Event?", group=group_rp_seq)
rp_useRE = input.bool(true, "Count RE as Event?", group=group_rp_seq)
rp_useTA = input.bool(true, "Count TA as Event?", group=group_rp_seq)
rp_ATR = ta.atr(rp_atr_len_MB)
rp_AvgVol = ta.sma(volume, rp_vol_len_MB)
rp_AvgDelta = ta.sma(math.abs(close - close[1]), rp_avg_delta_len)
rp_TrendMA = ta.sma(close, rp_trend_ma_len_TA)
rp_body = close - open
rp_candleRange = high - low
rp_body_up = rp_body > 0
rp_body_size = math.abs(rp_body)
rp_body_ratio = rp_candleRange == 0 ? 0 : rp_body_size / rp_candleRange
rp_MB_bull = rp_body_up and rp_body_size > rp_alpha_MB * rp_ATR and rp_body_ratio > rp_beta_MB and volume > rp_delta_MB * rp_AvgVol
rp_wide = rp_candleRange > rp_gamma_RE * rp_ATR
rp_RE_bull = rp_body_up and rp_wide and (high - close) < rp_epsilon_RE * rp_candleRange and volume > rp_delta_RE * rp_AvgVol
rp_up_trend = rp_TrendMA > rp_TrendMA[1]
rp_TA_bull = rp_up_trend and (close - close[1]) > rp_theta_TA * rp_AvgDelta and rp_body_up and volume > rp_delta_TA * rp_AvgVol
rp_isEvent = (rp_useMB and rp_MB_bull) or (rp_useRE and rp_RE_bull) or (rp_useTA and rp_TA_bull)
var int rp_seqLen = 0
if ta.change(dayofmonth) != 0
	rp_seqLen := 0
else if not rp_isEvent
	rp_seqLen := 0
if rp_isEvent
	rp_seqLen += 1
bool sRedPlus_raw = rp_isEvent and rp_seqLen >= 2
plotshape(sRedPlus_raw and show_rp_plots, "Red Plus", location=location.abovebar, style=shape.cross, color=color.new(color.fuchsia, 0), size=size.large)

// #############################################################################
// ###  INDICATOR 7: RVOL Bullish U>Th (Lucky #7)                             ###
// #############################################################################
grp_l7_rvol = "7. RVOL U>Th - RVOL Calculation"
l7_avglength = input.int(30, title="Look-back Length", group=grp_l7_rvol)
l7_smaLength = input.int(20, title="SMA Length (RVOL³)", group=grp_l7_rvol)
grp_l7_th = "7. RVOL U>Th - Bullish Threshold"
l7_th_low = input.float(19.0, step=0.1, title="Lower Threshold", group=grp_l7_th)
l7_th_high = input.float(1000000.0, step=0.1, title="Upper Threshold", group=grp_l7_th)
l7_spike = math.abs(close - open)
l7_avgSpikeDenom = ta.sma(l7_spike, l7_avglength)[1]
l7_rvol_price = l7_spike / nz(l7_avgSpikeDenom, 1)
l7_avgVolDenom = ta.sma(volume, l7_avglength)[1]
l7_rvol_volume = volume / nz(l7_avgVolDenom, 1)
l7_rvol_diff = l7_rvol_price - l7_rvol_volume
l7_rvol3_pos = l7_rvol_diff > 0 ? l7_rvol_diff : na
l7_sma_rvol3 = ta.sma(l7_rvol3_pos, l7_smaLength)
l7_baseBull = close > open and nz(l7_rvol3_pos) > nz(l7_sma_rvol3)
l7_inRange(v) => v > l7_th_low and v < l7_th_high
bool sRVOL_UgtTh_raw = l7_baseBull and l7_inRange(l7_rvol_price)
plotshape(sRVOL_UgtTh_raw and show_l7_plots, title="RVOL U>Th", location=location.bottom, style=shape.cross, size=size.small, color=color.new(color.lime, 0), text="RVOL")

// #############################################################################
// ###  INDICATOR 8: FAUNA X-IN-Y SIGNAL                                      ###
// #############################################################################
grp_fxy_win = "8. Fauna X-in-Y - Dynamic Window"
fxy_requiredEvents = input.int(4, "Required Events in Window (X)", group=grp_fxy_win, minval=1)
fxy_windowLength = input.int(12, "Window Length in Candles (Y)", group=grp_fxy_win, minval=1)
group_fxy_mb = "8. Fauna X-in-Y - Momentum Blast (MB)"
fxy_alpha_MB = input.float(1.6, "Body Size × ATR", group=group_fxy_mb)
fxy_beta_MB = input.float(0.7, "Body / Range ≥", minval=0.5, maxval=0.99, step=0.01, group=group_fxy_mb)
fxy_delta_MB = input.float(1.8, "Volume × Avg", group=group_fxy_mb)
fxy_atr_len_MB = input.int(14, "ATR Lookback", group=group_fxy_mb)
fxy_vol_len_MB = input.int(20, "Volume Lookback", group=group_fxy_mb)
group_fxy_re = "8. Fauna X-in-Y - Range Expansion (RE)"
fxy_gamma_RE = input.float(2.2, "Range × ATR", group=group_fxy_re)
fxy_epsilon_RE = input.float(0.15, "Close‑to‑Edge ≤", group=group_fxy_re)
fxy_delta_RE = input.float(1.8, "Volume × Avg", group=group_fxy_re)
fxy_atr_len_RE = input.int(14, "ATR Lookback", group=group_fxy_re)
fxy_vol_len_RE = input.int(20, "Volume Lookback", group=group_fxy_re)
group_fxy_ta = "8. Fauna X-in-Y - Trend Accelerant (TA)"
fxy_theta_TA = input.float(1.6, "ΔPrice × AvgΔ", group=group_fxy_ta)
fxy_delta_TA = input.float(1.8, "Volume × Avg", group=group_fxy_ta)
fxy_trend_ma_len_TA = input.int(50, "Trend MA Len", group=group_fxy_ta)
fxy_avg_delta_len = input.int(10, "Avg Δ Len", group=group_fxy_ta)
group_fxy_seq = "8. Fauna X-in-Y - Event Types"
fxy_useMB = input.bool(true, "Count MB as Event?", group=group_fxy_seq)
fxy_useRE = input.bool(true, "Count RE as Event?", group=group_fxy_seq)
fxy_useTA = input.bool(true, "Count TA as Event?", group=group_fxy_seq)
fxy_ATR = ta.atr(fxy_atr_len_MB)
fxy_AvgVol = ta.sma(volume, fxy_vol_len_MB)
fxy_AvgDelta = ta.sma(math.abs(close - close[1]), fxy_avg_delta_len)
fxy_TrendMA = ta.sma(close, fxy_trend_ma_len_TA)
fxy_body = close - open
fxy_candleRange = high - low
fxy_body_up = fxy_body > 0
fxy_body_size = math.abs(fxy_body)
fxy_body_ratio = fxy_candleRange == 0 ? 0 : fxy_body_size / fxy_candleRange
fxy_MB_bull = fxy_body_up and fxy_body_size > fxy_alpha_MB * fxy_ATR and fxy_body_ratio > fxy_beta_MB and volume > fxy_delta_MB * fxy_AvgVol
fxy_wide = fxy_candleRange > fxy_gamma_RE * fxy_ATR
fxy_RE_bull = fxy_body_up and fxy_wide and (high - close) < fxy_epsilon_RE * fxy_candleRange and volume > fxy_delta_RE * fxy_AvgVol
fxy_up_trend = fxy_TrendMA > fxy_TrendMA[1]
fxy_TA_bull = fxy_up_trend and (close - close[1]) > fxy_theta_TA * fxy_AvgDelta and fxy_body_up and volume > fxy_delta_TA * fxy_AvgVol
fxy_isEvent = (fxy_useMB and fxy_MB_bull) or (fxy_useRE and fxy_RE_bull) or (fxy_useTA and fxy_TA_bull)
fxy_eventAsNumber = fxy_isEvent ? 1 : 0
float fxy_eventsInWindow = 0.0
if fxy_windowLength >= 1
	for i = 0 to fxy_windowLength - 1
		fxy_eventsInWindow += fxy_eventAsNumber[i]
bool fxy_conditionMet = fxy_eventsInWindow >= fxy_requiredEvents
bool sFaunaXinY_raw = fxy_conditionMet and not fxy_conditionMet[1]
plotshape(sFaunaXinY_raw and show_fxy_plots, "Fauna X-in-Y", location=location.abovebar, style=shape.cross, color=color.new(color.lime, 0), size=size.huge, text="")

// #############################################################################
// ###  INDICATOR 9: RVOL ROLLING WINDOW                                      ###
// #############################################################################
grp_rw_rvol = "9. RVOL Window - RVOL Calculation"
rw_avglength = input.int(30, title="Look-back Length", group=grp_rw_rvol)
rw_smaLength = input.int(20, title="SMA Length (RVOL³)", group=grp_rw_rvol)
grp_rw_event_def = "9. RVOL Window - 1. Single Event Definition"
rw_th_low = input.float(8.0, step=0.1, title="Event Min RVOL Value", group=grp_rw_event_def)
rw_th_high = input.float(100000.0, step=0.1, title="Event Max RVOL Value", group=grp_rw_event_def)
grp_rw_window_cond = "9. RVOL Window - 2. Rolling Window Conditions"
rw_rollingWindowLen = input.int(60, "Lookback Bars (Window)", group=grp_rw_window_cond)
rw_minEventsInWindow = input.int(4, "Min Events in Window", minval=2, group=grp_rw_window_cond)
rw_minEventValue = input.float(8.0, title="Min Value of at least ONE Event", step=0.1, group=grp_rw_window_cond)
rw_minWindowSumValue = input.float(50.0, title="Min Total Sum of Window", step=0.1, group=grp_rw_window_cond)
rw_spike = math.abs(close - open)
rw_avgSpikeDenom = ta.sma(rw_spike, rw_avglength)[1]
rw_rvol_price = rw_spike / nz(rw_avgSpikeDenom, 1)
rw_avgVolDenom = ta.sma(volume, rw_avglength)[1]
rw_rvol_volume = volume / nz(rw_avgVolDenom, 1)
rw_rvol_diff = rw_rvol_price - rw_rvol_volume
rw_rvolPos = rw_rvol_diff > 0 ? rw_rvol_diff : na
rw_smaPos = ta.sma(rw_rvolPos, 20)[1]
rw_baseBull = close > open and rw_rvol_diff > 0 and nz(rw_rvolPos) > nz(rw_smaPos)
rw_inRange(v) => v > rw_th_low and v < rw_th_high
rw_isEvent = rw_baseBull and rw_inRange(rw_rvol_price) and barstate.isconfirmed

var int rw_windowStartBar = na
var int rw_eventCount = 0
var float[] rw_windowEventValues = array.new_float()
bool sRVOL_Window_raw = false

if rw_eventCount > 0 and bar_index - rw_windowStartBar >= rw_rollingWindowLen
	rw_eventCount := 0
	rw_windowStartBar := na
	array.clear(rw_windowEventValues)
if rw_isEvent
	if rw_eventCount == 0
		rw_windowStartBar := bar_index
		rw_eventCount := 1
		array.clear(rw_windowEventValues)
		array.push(rw_windowEventValues, rw_rvol_price)
	else
		rw_eventCount += 1
		array.push(rw_windowEventValues, rw_rvol_price)
	if rw_eventCount >= rw_minEventsInWindow
		bool hasHighValue = false
		for val in rw_windowEventValues
			if val >= rw_minEventValue
				hasHighValue := true
				break
		bool meetsSum = array.sum(rw_windowEventValues) >= rw_minWindowSumValue
		if hasHighValue and meetsSum
			sRVOL_Window_raw := true
			rw_windowStartBar := bar_index
			rw_eventCount := 1
			array.clear(rw_windowEventValues)
			array.push(rw_windowEventValues, rw_rvol_price)

plotshape(sRVOL_Window_raw and show_rw_plots, title="RVOL Window", location=location.abovebar, style=shape.cross, size=size.small, color=color.new(color.blue, 0), text="WIN")

// #############################################################################
// ###  INDICATOR 10: FAUNA SEQUENCE (FIRST 2 RTH) [NEW]                      ###
// #############################################################################
// Renumbered group from 11 to 10 based on HUB_Final_Cleaned source
ftmb_group_mb = "10. First Two MB - Momentum Blast (MB) Settings"
ftmb_alpha_MB = input.float(1.6, "Body Size × ATR", group=ftmb_group_mb)
ftmb_beta_MB = input.float(0.7, "Body / Range ≥", minval=0.5, maxval=0.99, step=0.01, group=ftmb_group_mb)
ftmb_delta_MB = input.float(1.8, "Volume × Avg", group=ftmb_group_mb)
ftmb_atr_len_MB = input.int(14, "ATR Lookback", group=ftmb_group_mb)
ftmb_vol_len_MB = input.int(20, "Volume Lookback", group=ftmb_group_mb)
ftmb_group_session = "10. First Two MB - Session Settings"
ftmb_tradingSession = input.session("0930-1600", "RTH Trading Session", group=ftmb_group_session)
ftmb_timeZone = input.string("America/New_York", "Time Zone", group=ftmb_group_session, options=["America/New_York", "America/Chicago", "UTC"])
ftmb_ATR = ta.atr(ftmb_atr_len_MB)
ftmb_AvgVol = ta.sma(volume, ftmb_vol_len_MB)
ftmb_body = close - open
ftmb_candleRange = high - low
ftmb_body_up = ftmb_body > 0
ftmb_body_size = math.abs(ftmb_body)
ftmb_body_ratio = ftmb_candleRange == 0 ? 0 : ftmb_body_size / ftmb_candleRange
ftmb_isEvent = ftmb_body_up and ftmb_body_size > ftmb_alpha_MB * ftmb_ATR and ftmb_body_ratio > ftmb_beta_MB and volume > ftmb_delta_MB * ftmb_AvgVol
ftmb_isWithinSession = not na(time((str.endswith(timeframe.period, "T") ? "1" : timeframe.period), ftmb_tradingSession, ftmb_timeZone))
var bool ftmb_isNewDay = false
if ta.change(dayofmonth) != 0
	ftmb_isNewDay := true
var int ftmb_sessionBarCounter = 0
if ftmb_isNewDay and ftmb_isWithinSession
	ftmb_sessionBarCounter := 1
	ftmb_isNewDay := false
else if ftmb_isWithinSession and ftmb_sessionBarCounter > 0
	ftmb_sessionBarCounter += 1
else if not ftmb_isWithinSession
	ftmb_sessionBarCounter := 0
bool sFirstTwoMB_raw = ftmb_sessionBarCounter == 2 and ftmb_isEvent and ftmb_isEvent[1]
plotshape(sFirstTwoMB_raw and show_ftmb_plots, "First Two MB", location=location.top, style=shape.triangleup, color=color.new(color.aqua, 0), size=size.huge, text="F2")


// #############################################################################
// ###  INDICATOR 11: MANGO SWINGS (Integrated & Fixed)                       ###
// #############################################################################
grp_ms = "11. Mango Swings"
// --- Pivot Settings ---
ms_leftBars = input.int(5, title="Pivot Left Strength", group=grp_ms, tooltip="Number of bars to the left of a pivot.")
ms_rightBars = input.int(5, title="Pivot Right Strength", group=grp_ms, tooltip="Number of bars to the right of a pivot. A pivot is only confirmed after this many bars have passed.")

// --- Internal Display Settings (Kept for full code inclusion) ---
grp_ms_internal = "11. Mango Swings - Internal Visualization (Debug/Advanced)"
ms_showInternalPlots = input.bool(false, title="⚠️ Enable Original Mango Swings Visuals", group=grp_ms_internal, tooltip="If enabled, the settings below control the original labels/lines from Mango Swings (HH/LL, Tops, Breaks, etc.). This is independent of the HUB Global Plot settings.")
ms_showHHLL = input.bool(true, title="Show HH/LH/HL/LL Labels", group=grp_ms_internal)
ms_showPairs = input.bool(true, title="Show Higher/Lower Pair Labels", group=grp_ms_internal)
ms_showTopsBottoms = input.bool(true, title="Show Swing Top/Bottom Labels", group=grp_ms_internal)
ms_showBreaks = input.bool(true, title="Show Breakout/Breakdown Lines & Labels", group=grp_ms_internal)
ms_showDivergences = input.bool(true, title="Show Swing Divergence Labels", group=grp_ms_internal)

// —————— VARIABLE DECLARATIONS (Prefixed with ms_) ——————
// Swing point tracking variables
var float ms_lastHighPrice = na
var int ms_lastHighBar = na
var float ms_prevHighPrice = na
var float ms_lastLowPrice = na
var int ms_lastLowBar = na
var float ms_prevLowPrice = na

// FIX: Variables specifically for storing the coordinates when the swing bottom event occurs for later visualization.
var int ms_swingBottomEventBar = na
var float ms_swingBottomEventPrice = na

// Market structure state
var int ms_marketStructure = 0

// Variables for tracking resistance/support lines
var line ms_resistanceLine = na
var float ms_resistanceLevel = na
var line ms_supportLine = na
var float ms_supportLevel = na

// --- Alert Event Flags (Internal) ---
var bool ms_hh_event = false
var bool ms_lh_event = false
var bool ms_hl_event = false
var bool ms_ll_event = false
var bool ms_higher_pair_event = false
var bool ms_lower_pair_event = false
var bool ms_swing_top_event = false
var bool ms_swing_bottom_event = false
var bool ms_breakout_event = false
var bool ms_breakdown_event = false
var bool ms_bear_div_event = false
var bool ms_bull_div_event = false

// --- Reset Alert Flags on Each Bar ---
ms_hh_event := false
ms_lh_event := false
ms_hl_event := false
ms_ll_event := false
ms_higher_pair_event := false
ms_lower_pair_event := false
ms_swing_top_event := false
ms_swing_bottom_event := false
ms_breakout_event := false
ms_breakdown_event := false
ms_bear_div_event := false
ms_bull_div_event := false

// —————— PIVOT DETECTION ——————
float ms_swingHigh = ta.pivothigh(high, ms_leftBars, ms_rightBars)
float ms_swingLow = ta.pivotlow(low, ms_leftBars, ms_rightBars)

// —————— CORE LOGIC ——————

// --- Swing High Analysis & Lower Pair Classification ---
if not na(ms_swingHigh)
    ms_isHigherHigh = not na(ms_lastHighPrice) and ms_swingHigh > ms_lastHighPrice
    ms_isLowerHigh = not na(ms_lastHighPrice) and ms_swingHigh < ms_lastHighPrice

    // INTEGRATION MODIFICATION: Decouple event triggering from display settings.
    if ms_isHigherHigh
        ms_hh_event := true
        if ms_showInternalPlots and ms_showHHLL
            label.new(bar_index[ms_rightBars], ms_swingHigh, "HH", color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_down)
    if ms_isLowerHigh
        ms_lh_event := true
        if ms_showInternalPlots and ms_showHHLL
            label.new(bar_index[ms_rightBars], ms_swingHigh, "LH", color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_down)

    // --- Bearish Swing Divergence ---
    if ms_marketStructure == -1 and not na(ms_lastHighPrice) and not na(ms_prevLowPrice)
        ms_isBearDivergence = ms_swingHigh > ms_lastHighPrice and ms_lastLowPrice < ms_prevLowPrice
        if ms_isBearDivergence
            ms_bear_div_event := true
            if ms_showInternalPlots and ms_showDivergences
                label.new(bar_index[ms_rightBars], ms_swingHigh, "Bear Swing Divergence", color=color.new(color.purple, 0), textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar)

    // --- Pair Analysis (Lower Pair: Low-High) ---
    if not na(ms_lastLowPrice) and not na(ms_prevLowPrice) and not na(ms_prevHighPrice) and ms_lastLowBar < bar_index[ms_rightBars]
        ms_isLowerPair = ms_swingHigh < ms_prevHighPrice and ms_lastLowPrice < ms_prevLowPrice

        if ms_isLowerPair
            ms_lower_pair_event := true
            if ms_showInternalPlots and ms_showPairs
                label.new(bar_index[ms_rightBars], ms_swingHigh, "Lower Pair", color=color.new(color.orange, 0), textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar, size=size.small)
            
            if ms_marketStructure == 1
                ms_swing_top_event := true
                if ms_showInternalPlots and ms_showTopsBottoms
                    label.new(ms_lastHighBar, ms_prevHighPrice, "Swing Top", color=color.new(color.fuchsia, 0), textcolor=color.black, style=label.style_label_down, yloc=yloc.abovebar, size=size.normal)

                // Manage resistance line display
                if not na(ms_resistanceLine)
                    line.delete(ms_resistanceLine)
                line_color = ms_showInternalPlots and ms_showBreaks ? color.red : na
                ms_resistanceLine := line.new(ms_lastHighBar, ms_prevHighPrice, bar_index, ms_prevHighPrice, extend=extend.right, color=line_color, style=line.style_dashed)
                ms_resistanceLevel := ms_prevHighPrice

            ms_marketStructure := -1

    // Variable updates for Swing Highs
    ms_prevHighPrice := ms_lastHighPrice
    ms_lastHighPrice := ms_swingHigh
    ms_lastHighBar := bar_index[ms_rightBars]


// --- Swing Low Analysis & Higher Pair Classification ---
if not na(ms_swingLow)
    ms_isHigherLow = not na(ms_lastLowPrice) and ms_swingLow > ms_lastLowPrice
    ms_isLowerLow = not na(ms_lastLowPrice) and ms_swingLow < ms_lastLowPrice

    // INTEGRATION MODIFICATION: Decouple event triggering from display settings.
    if ms_isHigherLow
        ms_hl_event := true
        if ms_showInternalPlots and ms_showHHLL
            label.new(bar_index[ms_rightBars], ms_swingLow, "HL", color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_up)
    if ms_isLowerLow
        ms_ll_event := true
        if ms_showInternalPlots and ms_showHHLL
            label.new(bar_index[ms_rightBars], ms_swingLow, "LL", color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_up)
    
    // --- Bullish Swing Divergence ---
    if ms_marketStructure == 1 and not na(ms_lastLowPrice) and not na(ms_prevHighPrice)
        ms_isBullDivergence = ms_swingLow < ms_lastLowPrice and ms_lastHighPrice > ms_prevHighPrice
        if ms_isBullDivergence
            ms_bull_div_event := true
            if ms_showInternalPlots and ms_showDivergences
                label.new(bar_index[ms_rightBars], ms_swingLow, "Bull Swing Divergence", color=color.new(color.teal, 0), textcolor=color.white, style=label.style_label_up, yloc=yloc.belowbar)

    // --- Pair Analysis (Higher Pair: High-Low) ---
    if not na(ms_lastHighPrice) and not na(ms_prevHighPrice) and not na(ms_prevLowPrice) and ms_lastHighBar < bar_index[ms_rightBars]
        ms_isHigherPair = ms_lastHighPrice > ms_prevHighPrice and ms_swingLow > ms_prevLowPrice

        if ms_isHigherPair
            ms_higher_pair_event := true
            if ms_showInternalPlots and ms_showPairs
                label.new(bar_index[ms_rightBars], ms_swingLow, "Higher Pair", color=color.new(color.blue, 0), textcolor=color.white, style=label.style_label_up, yloc=yloc.belowbar, size=size.small)
            
            if ms_marketStructure == -1
                // This is the crucial signal required by the user.
                ms_swing_bottom_event := true
                
                // FIX: Store the coordinates of the pivot (ms_lastLowBar and ms_prevLowPrice) when the event triggers.
                // These hold the correct values for the Swing Bottom *before* the updates at the end of this block.
                ms_swingBottomEventBar := ms_lastLowBar
                ms_swingBottomEventPrice := ms_prevLowPrice
                
                // Internal Visualization (if enabled)
                if ms_showInternalPlots and ms_showTopsBottoms
                    // Use a slightly different label/color to distinguish from the HUB visualization if both are active
                    label.new(ms_lastLowBar, ms_prevLowPrice, "Swing Bottom (Internal)", color=color.new(color.gray, 50), textcolor=color.black, style=label.style_label_up, yloc=yloc.belowbar, size=size.tiny)

                // Manage support line display
                if not na(ms_supportLine)
                    line.delete(ms_supportLine)
                line_color = ms_showInternalPlots and ms_showBreaks ? color.green : na
                ms_supportLine := line.new(ms_lastLowBar, ms_prevLowPrice, bar_index, ms_prevLowPrice, extend=extend.right, color=line_color, style=line.style_dashed)
                ms_supportLevel := ms_prevLowPrice
            
            ms_marketStructure := 1

    // Variable updates for Swing Lows
    ms_prevLowPrice := ms_lastLowPrice
    ms_lastLowPrice := ms_swingLow
    ms_lastLowBar := bar_index[ms_rightBars]


// —————— BREAKOUT & BREAKDOWN LOGIC ——————
// INTEGRATION MODIFICATION: Logic runs regardless of display, but visualization depends on settings.
if not na(ms_resistanceLine) and close > ms_resistanceLevel
    line.set_x2(ms_resistanceLine, bar_index)
    line.set_extend(ms_resistanceLine, extend.none)
    
    ms_breakout_event := true
    if ms_showInternalPlots and ms_showBreaks
        label.new(bar_index, close, "Swing Breakout", color=color.new(color.aqua, 20), textcolor=color.black, style=label.style_label_up)
        
    ms_resistanceLine := na
    ms_resistanceLevel := na

if not na(ms_supportLine) and close < ms_supportLevel
    line.set_x2(ms_supportLine, bar_index)
    line.set_extend(ms_supportLine, extend.none)

    ms_breakdown_event := true
    if ms_showInternalPlots and ms_showBreaks
        label.new(bar_index, close, "Swing Breakdown", color=color.new(color.maroon, 20), textcolor=color.white, style=label.style_label_down)
        
    ms_supportLine := na
    ms_supportLevel := na

// —————— FINAL SIGNAL EXPORT ——————
// We only export the signal requested by the user (Swing Bottom) to the HUB system.
bool sSwingBottom_raw = ms_swing_bottom_event

// —————— HUB VISUALIZATION (SWING BOTTOM) ——————
// Controlled by the HUB Global Plot Setting, placed correctly at the pivot using coordinates stored when the event fired.
if sSwingBottom_raw and show_swing_bottom_plots and barstate.isconfirmed
    // FIX: Ensured correct indentation (4 spaces) and use of stored coordinates.
    label.new(ms_swingBottomEventBar, ms_swingBottomEventPrice, "Swing Bottom", color=color.new(color.lime, 0), textcolor=color.black, style=label.style_label_up, yloc=yloc.belowbar, size=size.normal)


// #############################################################################
// ###  DERIVED & COINCIDENT SIGNALS                                          ###
// #############################################################################
bool sCoincidentCluster_raw = sOW_Overlap_raw and sOoOC_raw
plotshape(sCoincidentCluster_raw and not sCoincidentCluster_raw[1] and show_cc_plots, "Coincident Cluster", location=location.belowbar, style=shape.labeldown, color=color.new(color.yellow, 50), size=size.huge, text="CC")

