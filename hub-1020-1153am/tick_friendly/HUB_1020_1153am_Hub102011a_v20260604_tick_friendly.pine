float eventsOnBar_B = (use_B_wf_momentum and sWhiteFlagMomentum_raw ? 1:0) + (use_B_ow_overlap and sOW_Overlap_raw ? 1:0) + (use_B_ow_super and sOW_Super_raw ? 1:0) + (use_B_ow_combined and sOW_Combined_raw ? 1:0) + (use_B_fc_2of3 and sFC_2of3_raw ? 1:0) + (use_B_fc_overlap and sFC_Overlap_raw ? 1:0) + (use_B_fc_cluster and sFC_Cluster_raw ? 1:0) + (use_B_e3_open and sE3_raw ? 1:0) + (use_B_oooc_meta and sOoOC_raw ? 1:0) + (use_B_rp_sequence and sRedPlus_raw ? 1:0) + (use_B_l7_bullish_rvol and sRVOL_UgtTh_raw ? 1:0) + (use_B_fxy_signal and sFaunaXinY_raw ? 1:0) + (use_B_rw_signal and sRVOL_Window_raw ? 1:0) + (use_B_ftmb and sFirstTwoMB_raw ? 1:0) + (use_B_cc and sCoincidentCluster_raw ? 1:0) + (use_B_swing_bottom and sSwingBottom_raw ? 1:0) + (use_B_pbj_buy and sPBJFollowupBuy_raw ? 1:0) + (use_B_mb_ind and sMB_Individual_raw ? 1:0) + (use_B_re_ind and sRE_Individual_raw ? 1:0) + (use_B_ta_ind and sTA_Individual_raw ? 1:0) + (use_B_CustomA and sCustomA_raw ? 1:0) + (use_B_CustomC and sCustomC_raw ? 1:0) + (use_B_CustomD and sCustomD_raw ? 1:0) + (use_B_CustomE and sCustomE_raw ? 1:0) + (use_B_CustomF and sCustomF_raw ? 1:0) + (use_B_CustomG and sCustomG_raw ? 1:0) + (use_B_CustomH and sCustomH_raw ? 1:0) + (use_B_CustomI and sCustomI_raw ? 1:0) + (use_B_CustomJ and sCustomJ_raw ? 1:0)
var int csB_windowStartBar = na, var int csB_eventCount = 0
if csB_eventCount > 0 and bar_index - csB_windowStartBar >= window_B
	csB_eventCount := 0, csB_windowStartBar := na
if eventsOnBar_B > 0
