use_A_CustomG = input.bool(false, "Custom Signal G", group=grp_A_events, inline="a21")
use_A_CustomH = input.bool(false, "Custom Signal H", group=grp_A_events, inline="a22")
use_A_CustomI = input.bool(false, "Custom Signal I", group=grp_A_events, inline="a22")
use_A_CustomJ = input.bool(false, "Custom Signal J", group=grp_A_events, inline="a23")

float eventsOnBar_A = (use_A_wf_momentum and sWhiteFlagMomentum_raw ? 1:0) + (use_A_ow_overlap and sOW_Overlap_raw ? 1:0) + (use_A_ow_super and sOW_Super_raw ? 1:0) + (use_A_ow_combined and sOW_Combined_raw ? 1:0) + (use_A_fc_2of3 and sFC_2of3_raw ? 1:0) + (use_A_fc_overlap and sFC_Overlap_raw ? 1:0) + (use_A_fc_cluster and sFC_Cluster_raw ? 1:0) + (use_A_e3_open and sE3_raw ? 1:0) + (use_A_oooc_meta and sOoOC_raw ? 1:0) + (use_A_rp_sequence and sRedPlus_raw ? 1:0) + (use_A_l7_bullish_rvol and sRVOL_UgtTh_raw ? 1:0) + (use_A_fxy_signal and sFaunaXinY_raw ? 1:0) + (use_A_rw_signal and sRVOL_Window_raw ? 1:0) + (use_A_ftmb and sFirstTwoMB_raw ? 1:0) + (use_A_cc and sCoincidentCluster_raw ? 1:0) + (use_A_swing_bottom and sSwingBottom_raw ? 1:0) + (use_A_pbj_buy and sPBJFollowupBuy_raw ? 1:0) + (use_A_mb_ind and sMB_Individual_raw ? 1:0) + (use_A_re_ind and sRE_Individual_raw ? 1:0) + (use_A_ta_ind and sTA_Individual_raw ? 1:0) + (use_A_CustomB and sCustomB_raw ? 1:0) + (use_A_CustomC and sCustomC_raw ? 1:0) + (use_A_CustomD and sCustomD_raw ? 1:0) + (use_A_CustomE and sCustomE_raw ? 1:0) + (use_A_CustomF and sCustomF_raw ? 1:0) + (use_A_CustomG and sCustomG_raw ? 1:0) + (use_A_CustomH and sCustomH_raw ? 1:0) + (use_A_CustomI and sCustomI_raw ? 1:0) + (use_A_CustomJ and sCustomJ_raw ? 1:0)
var int csA_windowStartBar = na, var int csA_eventCount = 0
if csA_eventCount > 0 and bar_index - csA_windowStartBar >= window_A
	csA_eventCount := 0, csA_windowStartBar := na
if eventsOnBar_A > 0
	if csA_eventCount == 0
		csA_windowStartBar := bar_index, csA_eventCount := int(eventsOnBar_A)
	else
		csA_eventCount += int(eventsOnBar_A)
	if csA_eventCount >= required_A
		sCustomA_raw := true, csA_windowStartBar := bar_index, csA_eventCount := int(eventsOnBar_A)

