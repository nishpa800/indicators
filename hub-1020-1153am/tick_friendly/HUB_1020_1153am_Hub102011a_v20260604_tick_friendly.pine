			if ga_CustomI and sCustomI_fire
				alert("Custom Signal I " + alert_base_string, alert.freq_once_per_bar_close)
			if ga_CustomJ and sCustomJ_fire
				alert("Custom Signal J " + alert_base_string, alert.freq_once_per_bar_close)
		else
			alert("Signals: " + _galert_msg + " " + alert_base_string, alert.freq_once_per_bar_close)

