		csB_windowStartBar := bar_index, csB_eventCount := int(eventsOnBar_B)
	else
		csB_eventCount += int(eventsOnBar_B)
	if csB_eventCount >= required_B
		sCustomB_raw := true, csB_windowStartBar := bar_index, csB_eventCount := int(eventsOnBar_B)

