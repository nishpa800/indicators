// ###  MASTER ALERT LOGIC & FINAL PLOTS                                      ###
// #############################################################################
f_pulse(cond) => barstate.isconfirmed and cond and not cond[1]

// Base Signals
bool fire_wf_momentum = f_pulse(sWhiteFlagMomentum_raw)
bool fire_ow_overlap = f_pulse(sOW_Overlap_raw)
bool fire_ow_super = f_pulse(sOW_Super_raw)
bool fire_ow_combined = f_pulse(sOW_Combined_raw)
bool fire_fc_2of3 = f_pulse(sFC_2of3_raw)
bool fire_fc_overlap = f_pulse(sFC_Overlap_raw)
bool fire_fc_cluster = f_pulse(sFC_Cluster_raw)
bool fire_e3 = f_pulse(sE3_raw)
bool fire_oooc = f_pulse(sOoOC_raw)
bool fire_rp = f_pulse(sRedPlus_raw)
bool fire_rvol_ugtth = f_pulse(sRVOL_UgtTh_raw)
bool fire_fxy = f_pulse(sFaunaXinY_raw)
bool fire_rvol_window = f_pulse(sRVOL_Window_raw)
bool fire_ftmb = f_pulse(sFirstTwoMB_raw)
bool fire_cc = f_pulse(sCoincidentCluster_raw)
// Mango Integration. sSwingBottom_raw is inherently a pulse, we just ensure confirmation.
bool fire_swing_bottom = barstate.isconfirmed and sSwingBottom_raw

// New Integrated Signals
bool fire_pbj_buy = f_pulse(sPBJFollowupBuy_raw)

// Custom Signals
bool sCustomA_fire = f_pulse(sCustomA_raw)
bool sCustomB_fire = f_pulse(sCustomB_raw)
bool sCustomC_fire = f_pulse(sCustomC_raw)
bool sCustomD_fire = f_pulse(sCustomD_raw)
bool sCustomE_fire = f_pulse(sCustomE_raw)
bool sCustomF_fire = f_pulse(sCustomF_raw)
bool sCustomG_fire = f_pulse(sCustomG_raw)
bool sCustomH_fire = f_pulse(sCustomH_raw)
bool sCustomI_fire = f_pulse(sCustomI_raw)
bool sCustomJ_fire = f_pulse(sCustomJ_raw)

// Plot Custom Signals & New Signals
plotshape(sCustomA_fire and show_custom_A_plots, "Custom Signal A", location=location.abovebar, style=shape.circle, color=color.new(color.orange, 80), size=size.huge, text="A")
plotshape(sCustomB_fire and show_custom_B_plots, "Custom Signal B", location=location.belowbar, style=shape.triangleup, color=color.new(#CD853F, 25), size=size.huge, text="B")
plotshape(sCustomC_fire and show_custom_C_plots, "Custom Signal C", location=location.abovebar, style=shape.triangledown, color=color.new(color.purple, 25), size=size.huge, text="C")
plotshape(sCustomD_fire and show_custom_D_plots, "Custom Signal D", location=location.belowbar, style=shape.xcross, color=color.new(color.purple, 0), size=size.huge, text="D")
plotshape(sCustomE_fire and show_custom_E_plots, title="Custom Signal E", style=shape.circle, size=size.huge, location=location.belowbar, text="E", color=color.new(color.fuchsia, 60))
plotshape(sCustomF_fire and show_custom_F_plots, title="Custom Signal F", style=shape.triangleup, size=size.huge, location=location.abovebar, text="F", color=color.new(color.maroon, 25))
plotshape(sCustomG_fire and show_custom_G_plots, title="Custom Signal G", style=shape.triangledown, size=size.huge, location=location.belowbar, text="G", color=color.new(color.teal, 25))
plotshape(sCustomH_fire and show_custom_H_plots, title="Custom Signal H", style=shape.xcross, size=size.huge, location=location.abovebar, text="H", color=color.new(color.silver, 0))
plotshape(sCustomI_fire and show_custom_I_plots, title="Custom Signal I", style=shape.labeldown, size=size.huge, location=location.bottom, text="iii", color=color.new(color.white, 80), textcolor=color.white)
plotshape(sCustomJ_fire and show_custom_J_plots, title="Custom Signal J", style=shape.square, size=size.huge, location=location.bottom, text="J", color=color.new(color.gray, 50))

// --- Plot New Integrated Signals ---
// Note: Swing Bottom visualization is handled via label.new in Indicator 11 section for accurate placement.

plotchar(fire_pbj_buy and show_pbj_buy_plots, "PB&J Follow-up Buy", char='★', location=location.belowbar, color=color.new(color.green, 0), size=size.small)


// #############################################################################
// ###  GLOBAL ALERTS MULTIPLEXER                                             ###
// #############################################################################
var string _galert_msg = ""
var int _galert_cnt = 0
_galert_msg := ""
_galert_cnt := 0

string rvol_str = str.tostring(l7_rvol_price, "#.#")
string rvol_name_full = "RVOL U>Th (Value: " + rvol_str + ")"
string ohlc_string = " O={{open}} H={{high}} L={{low}} C={{close}}"

if barstate.isconfirmed
	// --- Aggregation Phase: Build the message string in registry order ---
	if enable_wf_momentum_alerts and fire_wf_momentum
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "White Flag Momentum"
		_galert_cnt += 1
	if enable_ow_overlap_alerts and fire_ow_overlap
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "OW Overlap"
		_galert_cnt += 1
	if enable_ow_super_alerts and fire_ow_super
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "OW Super"
		_galert_cnt += 1
	if enable_ow_combined_alerts and fire_ow_combined
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "OW Combined"
		_galert_cnt += 1
	if enable_fc_2of3_alerts and fire_fc_2of3
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "FC 2/3 Fauna"
		_galert_cnt += 1
	if enable_fc_overlap_alerts and fire_fc_overlap
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "FC Overlap"
		_galert_cnt += 1
	if enable_fc_cluster_alerts and fire_fc_cluster
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "FC Cluster"
		_galert_cnt += 1
	if enable_e3_alerts and fire_e3
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "E3"
		_galert_cnt += 1
	if enable_oooc_alerts and fire_oooc
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "OoOC"
		_galert_cnt += 1
	if enable_rp_alerts and fire_rp
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Red Plus"
		_galert_cnt += 1
	if enable_l7_alerts and fire_rvol_ugtth
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + rvol_name_full
		_galert_cnt += 1
	if enable_fxy_alerts and fire_fxy
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Fauna X-in-Y"
		_galert_cnt += 1
	if enable_rw_alerts and fire_rvol_window
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "RVOL Window"
		_galert_cnt += 1
	if enable_ftmb_alerts and fire_ftmb
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "First Two MB"
		_galert_cnt += 1
	if enable_cc_alerts and fire_cc
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Coincident Cluster"
		_galert_cnt += 1
	if enable_pbj_buy_alerts and fire_pbj_buy
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "PB&J Follow-up Buy"
		_galert_cnt += 1
	if enable_custom_A_alerts and sCustomA_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal A"
		_galert_cnt += 1
	if enable_custom_B_alerts and sCustomB_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal B"
		_galert_cnt += 1
	if ga_CustomC and sCustomC_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal C"
		_galert_cnt += 1
	if ga_CustomD and sCustomD_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal D"
		_galert_cnt += 1
	if ga_CustomE and sCustomE_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal E"
		_galert_cnt += 1
	if ga_CustomF and sCustomF_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal F"
		_galert_cnt += 1
	if ga_CustomG and sCustomG_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal G"
		_galert_cnt += 1
	if ga_CustomH and sCustomH_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal H"
		_galert_cnt += 1
	if ga_CustomI and sCustomI_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal I"
		_galert_cnt += 1
	if ga_CustomJ and sCustomJ_fire
		_galert_msg := _galert_msg + (str.length(_galert_msg) > 0 ? "|" : "") + "Custom Signal J"
		_galert_cnt += 1

	// --- Emission Phase: Fire alerts based on user settings ---
	if _galert_cnt > 0
		string alert_base_string = "| {{ticker}} {{interval}} {{time}}" + ohlc_string
		if ga_one_per_signal
			if enable_wf_momentum_alerts and fire_wf_momentum
				alert("White Flag Momentum " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_ow_overlap_alerts and fire_ow_overlap
				alert("OW Overlap " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_ow_super_alerts and fire_ow_super
				alert("OW Super " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_ow_combined_alerts and fire_ow_combined
				alert("OW Combined " + alert_base_string, alert.freq_once_per_bar_close)
