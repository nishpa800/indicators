			if enable_fc_overlap_alerts and fire_fc_overlap
				alert("FC Overlap " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_fc_cluster_alerts and fire_fc_cluster
				alert("FC Cluster " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_e3_alerts and fire_e3
				alert("E3 " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_oooc_alerts and fire_oooc
				alert("OoOC " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_rp_alerts and fire_rp
				alert("Red Plus " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_l7_alerts and fire_rvol_ugtth
				alert(rvol_name_full + " " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_fxy_alerts and fire_fxy
				alert("Fauna X-in-Y " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_rw_alerts and fire_rvol_window
				alert("RVOL Window " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_ftmb_alerts and fire_ftmb
				alert("First Two MB " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_cc_alerts and fire_cc
				alert("Coincident Cluster " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_pbj_buy_alerts and fire_pbj_buy
				alert("PB&J Follow-up Buy " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_custom_A_alerts and sCustomA_fire
				alert("Custom Signal A " + alert_base_string, alert.freq_once_per_bar_close)
			if enable_custom_B_alerts and sCustomB_fire
				alert("Custom Signal B " + alert_base_string, alert.freq_once_per_bar_close)
			if ga_CustomC and sCustomC_fire
				alert("Custom Signal C " + alert_base_string, alert.freq_once_per_bar_close)
			if ga_CustomD and sCustomD_fire
				alert("Custom Signal D " + alert_base_string, alert.freq_once_per_bar_close)
			if ga_CustomE and sCustomE_fire
				alert("Custom Signal E " + alert_base_string, alert.freq_once_per_bar_close)
			if ga_CustomF and sCustomF_fire
				alert("Custom Signal F " + alert_base_string, alert.freq_once_per_bar_close)
			if ga_CustomG and sCustomG_fire
				alert("Custom Signal G " + alert_base_string, alert.freq_once_per_bar_close)
			if ga_CustomH and sCustomH_fire
