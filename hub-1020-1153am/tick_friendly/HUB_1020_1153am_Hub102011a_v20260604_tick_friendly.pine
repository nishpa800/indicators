//@version=5
// Pine is a Pine Editor tick-friendly
// --- Signal Hub Final Version ---
// This script combines multiple distinct trading indicators into a single, unified study.
//
// REVISION 10 (Mango Integration Fix):
// R1) FIXED syntax error ("Syntax error at input 'label'") in the Mango Swings visualization section by correcting the indentation.
// R2) FIXED logical error in Mango Swings visualization. The label placement coordinates were incorrect because they were referenced after the underlying variables (ms_lastLowBar/Price) were updated.
// R3) IMPLEMENTED dedicated variables (ms_swingBottomEventBar/Price) to store the correct coordinates when the Swing Bottom event is triggered, ensuring accurate visualization placement.

indicator("HUB_1020_1153am", shorttitle="Hub102011a", overlay=true, max_labels_count=500, max_bars_back=5000)

// --- Utility function to count TRUE conditions over a lookback period.
f_sum_true(cond, len) =>
	float s = 0.0
	int L = math.max(0, len)
	for i = 0 to math.max(0, L - 1)
		s += (cond[i] ? 1.0 : 0.0)
	s

// --- Utility function to calculate rolling sum manually
f_rolling_sum(source, len) =>
	float s = 0.0
	int L = math.max(1, len)
	for i = 0 to L - 1
		s += nz(source[i])
	s

// --- Utility function for DEMA calculation (required by PB&J)
f_dema(src, len) =>
	_ema1 = ta.ema(src, len)
	_ema2 = ta.ema(_ema1, len)
	2 * _ema1 - _ema2

// --- Utility function for specific MA types (required by PB&J)
f_pbj_ma(type, src, len) =>
	result = 0.0
	if type == "SMA"
		result := ta.sma(src, len)
	else if type == "EMA"
		result := ta.ema(src, len)
	else if type == "DEMA"
		result := f_dema(src, len)
	result

