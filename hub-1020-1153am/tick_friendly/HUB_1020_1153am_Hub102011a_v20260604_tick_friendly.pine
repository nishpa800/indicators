// #############################################################################

// --- 1. PB&J Follow-up Buy (from BelugaLander - Hardcoded) ---
// --- Step 1.1: Lander Buy Signal Logic ---
var int pbj_supertrend_dir_val = 1
float pbj_base_ma_val = ta.vwma(ohlc4, 5)
float pbj_atr_supertrend = 2.0 * ta.atr(10)
float pbj_dynamic_longStop = pbj_base_ma_val - pbj_atr_supertrend
float pbj_dynamic_shortStop = pbj_base_ma_val + pbj_atr_supertrend
float pbj_current_long_ST = 0.0
pbj_current_long_ST := pbj_base_ma_val > nz(pbj_current_long_ST[1], pbj_dynamic_longStop) ? math.max(pbj_dynamic_longStop, nz(pbj_current_long_ST[1])) : pbj_dynamic_longStop
float pbj_current_short_ST = 0.0
pbj_current_short_ST := pbj_base_ma_val < nz(pbj_current_short_ST[1], pbj_dynamic_shortStop) ? math.min(pbj_dynamic_shortStop, nz(pbj_current_short_ST[1])) : pbj_dynamic_shortStop
if (pbj_supertrend_dir_val[1] == -1 and ohlc4 > nz(pbj_current_short_ST[1]))
	pbj_supertrend_dir_val := 1
else if (pbj_supertrend_dir_val[1] == 1 and ohlc4 < nz(pbj_current_long_ST[1]))
	pbj_supertrend_dir_val := -1
float pbj_ma_signal_line_val = pbj_supertrend_dir_val == 1 ? pbj_current_long_ST : pbj_current_short_ST
bool pbj_lander_buy_signal = ta.crossover(ohlc4, pbj_ma_signal_line_val)

// --- Step 1.2: Original PB&J Filter Logic ---
float pbj_ma_value = f_pbj_ma("EMA", close, 20)
float pbj_atr_value = ta.atr(14)
float pbj_buy_avg_volume = ta.sma(volume, 20)
float pbj_buy_threshold_perc = close == 0 ? 0 : (pbj_atr_value / close * 3.0)
bool pbj_price_cond_buy = low < pbj_ma_value * (1 - pbj_buy_threshold_perc)
bool pbj_ll_cond_buy = low == ta.lowest(low, 25)
bool pbj_vol_cond_buy = volume > pbj_buy_avg_volume * 0.1
bool pbj_buy_condition = pbj_price_cond_buy and pbj_ll_cond_buy and pbj_vol_cond_buy

// --- Step 1.3: State Management & Final Signal ---
var bool pbj_waiting_for_lander_buy = false
if pbj_buy_condition
	pbj_waiting_for_lander_buy := true
bool sPBJFollowupBuy_raw = pbj_lander_buy_signal and pbj_waiting_for_lander_buy
if sPBJFollowupBuy_raw
	pbj_waiting_for_lander_buy := false


// --- 2, 3, 4. Individual MB, RE, TA Signals ---
// NOTE: These signals use the parameters from the "1. White Flag" indicator section.
bool sMB_Individual_raw = wf_MB_bull
bool sRE_Individual_raw = wf_RE_bull
bool sTA_Individual_raw = wf_TA_bull


