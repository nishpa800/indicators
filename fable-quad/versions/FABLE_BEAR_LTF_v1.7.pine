// ══ ALERT ENGINE — canonical grammar v1.2 (T-ALERTMSG): SIDE n | [FIRST][ G>R] | tokens | RVr ══
int qn = (fire_qS2 ? 1 : 0) + (fire_qS4 ? 1 : 0) + (fire_qS6 ? 1 : 0) + (fire_qS8 ? 1 : 0) + (fire_qS9 ? 1 : 0) + (fire_qS12 ? 1 : 0) + (fire_qS14T ? 1 : 0) + (fire_qS14N ? 1 : 0) + (fire_qS17 ? 1 : 0) + (fire_qS19 ? 1 : 0) + (fire_qS21 ? 1 : 0) + (fire_qS23 ? 1 : 0) + (fire_qS25 ? 1 : 0) + (fire_qS27S ? 1 : 0) + (fire_qS27T ? 1 : 0) + (fire_qCOJ ? 1 : 0) + (fire_qCOB ? 1 : 0) + (fire_qB2BH ? 1 : 0) + (fire_qB2BJ ? 1 : 0) + (fire_qB2BP ? 1 : 0) + (fire_qMPPD ? 1 : 0) + (fire_qMRV ? 1 : 0) + (fire_qMCMB ? 1 : 0) + (fire_qMJPD ? 1 : 0) + (fire_qMJR ? 1 : 0) + (fire_qMJC ? 1 : 0) + (fire_qM23J ? 1 : 0) + (fire_qM33J ? 1 : 0) + (fire_qM23N ? 1 : 0) + (fire_qM33N ? 1 : 0) + (fire_qCC ? 1 : 0) + (fire_qS29 ? 1 : 0) + (fire_qS31 ? 1 : 0) + (fire_qS33 ? 1 : 0) + (fire_qS35 ? 1 : 0) + (fire_qRSA ? 1 : 0) + (fire_qRRA ? 1 : 0) + (fire_qHQ ? 1 : 0) + (fire_qPJR ? 1 : 0) + (fire_qPBR ? 1 : 0) + (fire_qMOA ? 1 : 0) + (fire_qROOF ? 1 : 0) + (fire_qPH ? 1 : 0)
string qhdr = "BEAR " + str.tostring(qn) + (tagBlock != "" ? " | " + tagBlock : "") + " | "
string qtail = " | RV" + f_i(rv_relVolRatio)
string qmsg = ""
if conf
    if alf_qS2
        qmsg := f_add(qmsg, "S2:" + (rv_normPrice >= th_gs ? "MOAB" : "1X") + f_i(rv_normPrice) + ",D" + f_d(d9_ach))
    if alf_qS4
        qmsg := f_add(qmsg, "S4:TYPHOON" + (true ? ",D" + f_d(nz(ltf_dstd[yy_rightBars]) > 0 ? nz(ltf_drng[yy_rightBars]) / nz(ltf_dstd[yy_rightBars]) : 0.0) : ""))
    if alf_qS6
        qmsg := f_add(qmsg, "S6:MUSASHI" + (gz_bearHV ? "," + f_i(f_hvDepth()) : "") + (true ? ",D" + f_d(nz(ltf_dstd[moff]) > 0 ? nz(ltf_drng[moff]) / nz(ltf_dstd[moff]) : 0.0) : ""))
    if alf_qS8
        qmsg := f_add(qmsg, "S8:WHALE+PPD," + f_i(f_hvDepth()) + (true ? ",D" + f_d(ltf_dstd > 0 ? ltf_drng / ltf_dstd : 0.0) : ""))
    if alf_qS9
        qmsg := f_add(qmsg, "S9:KRAT" + f_i(rv_normPrice) + "/" + f_i(nz(rv_normPrice[1])) + ",D" + f_d(d9_ach))
    if alf_qS12
        qmsg := f_add(qmsg, "S12:DYN,D" + f_d(dynAch1) + "/" + f_d(dynAch2))
    if alf_qS14T
        qmsg := f_add(qmsg, "S14:IGN-TNT")
