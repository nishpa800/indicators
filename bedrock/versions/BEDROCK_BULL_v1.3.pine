    if alf_qS28
        qmsg := f_add(qmsg, "S28:4K," + f_i(f_hvDepth()))
    if alf_qS30
        qmsg := f_add(qmsg, "S30:NAG" + str.tostring(bar_index))
    if alf_qS32
        qmsg := f_add(qmsg, "S32:OPEN1" + (gz_bullHV ? "," + f_i(f_hvDepth()) : ""))
    if alf_qS34
        qmsg := f_add(qmsg, "S34:DYN,D" + f_d(dynAch1) + "/" + f_d(dynAch2))
    if alf_qRSA
        qmsg := f_add(qmsg, "RS+ANY")
    if alf_qRRA
        qmsg := f_add(qmsg, "RS+RC+ANY")
    if alf_qHQ
        qmsg := f_add(qmsg, "HV:" + f_i(f_hvDepth()) + ",PBJ,D" + f_d(hq_dstd > 0 ? hq_drng / hq_dstd : 0.0))
    // BEDROCK v1.1 CUT#36: qPJR alert-row removed (slim-alert law, operator 2026-07-28)
    // BEDROCK v1.1 CUT#31: qPBR alert-row removed (D-06, operator 2026-07-28)
    if alf_qGSA
        qmsg := f_add(qmsg, "GS" + f_i(rv_normPrice) + "+ANY")
    if alf_qFLR
        qmsg := f_add(qmsg, "FLOOR+ANY")
    if alf_q2F
        qmsg := f_add(qmsg, "2F+ANY")
    if en_aggAlerts
        if qmsg != ""
            alert(qhdr + qmsg + qtail, alert.freq_once_per_bar_close)
// ══ BEDROCK v1.0 ALERTS — dynamic alert() only, ZERO plot-budget cost. One 🔔 per lane. ══
