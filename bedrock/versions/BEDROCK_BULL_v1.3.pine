// ══ ALERT ENGINE — canonical grammar v1.2 (T-ALERTMSG): SIDE n | [FIRST][ G>R] | tokens | RVr ══
int qn = ((en_qS1 and aok_qS1) ? 1 : 0) + ((en_qS3 and aok_qS3) ? 1 : 0) + ((en_qS5 and aok_qS5) ? 1 : 0) + ((en_qS7 and aok_qS7) ? 1 : 0) + ((en_qS10 and aok_qS10) ? 1 : 0) + ((en_qS11 and aok_qS11) ? 1 : 0) + ((en_qS13T and aok_qS13T) ? 1 : 0) + ((en_qS13N and aok_qS13N) ? 1 : 0) + ((en_qS15 and aok_qS15) ? 1 : 0) + ((en_qS16 and aok_qS16) ? 1 : 0) + ((en_qS18 and aok_qS18) ? 1 : 0) + ((en_qS20 and aok_qS20) ? 1 : 0) + ((en_qS22 and aok_qS22) ? 1 : 0) + ((en_qS24 and aok_qS24) ? 1 : 0) + ((en_qB2BH and aok_qB2BH) ? 1 : 0) + ((en_qB2BJ and aok_qB2BJ) ? 1 : 0) + ((en_qMPUP and aok_qMPUP) ? 1 : 0) + ((en_qMRV and aok_qMRV) ? 1 : 0) + ((en_qMCMB and aok_qMCMB) ? 1 : 0) + ((en_qMJP and aok_qMJP) ? 1 : 0) + ((en_qMJR and aok_qMJR) ? 1 : 0) + ((en_qMJC and aok_qMJC) ? 1 : 0) + ((en_qM23J and aok_qM23J) ? 1 : 0) + ((en_qM33J and aok_qM33J) ? 1 : 0) + ((en_qM23N and aok_qM23N) ? 1 : 0) + ((en_qM33N and aok_qM33N) ? 1 : 0) + ((en_qCC and aok_qCC) ? 1 : 0) + ((en_qS28 and aok_qS28) ? 1 : 0) + ((en_qS30 and aok_qS30) ? 1 : 0) + ((en_qS32 and aok_qS32) ? 1 : 0) + ((en_qS34 and aok_qS34) ? 1 : 0) + ((en_qRSA and aok_qRSA) ? 1 : 0) + ((en_qRRA and aok_qRRA) ? 1 : 0) + ((en_qHQ and aok_qHQ) ? 1 : 0) + ((en_qGSA and aok_qGSA) ? 1 : 0) + ((en_qFLR and aok_qFLR) ? 1 : 0) + ((en_q2F and aok_q2F) ? 1 : 0)
string qhdr = "BULL " + str.tostring(qn) + (tagBlock != "" ? " | " + tagBlock : "") + " | "
string qtail = " | RV" + f_i(rv_relVolRatio)
string qmsg = ""
if conf
    if alf_qS1
        qmsg := f_add(qmsg, "S1:" + (rv_normPrice >= th_gs ? "GS" : "1X") + f_i(rv_normPrice) + ",D" + f_d(d9_ach))
    if alf_qS3
        qmsg := f_add(qmsg, "S3:TYPHOON" + (true ? ",D" + f_d(nz(ltf_dstd[yy_rightBars]) > 0 ? nz(ltf_drng[yy_rightBars]) / nz(ltf_dstd[yy_rightBars]) : 0.0) : ""))
    if alf_qS5
        qmsg := f_add(qmsg, "S5:MUSASHI" + (gz_bullHV ? "," + f_i(f_hvDepth()) : "") + (true ? ",D" + f_d(nz(ltf_dstd[moff]) > 0 ? nz(ltf_drng[moff]) / nz(ltf_dstd[moff]) : 0.0) : ""))
    if alf_qS7
        qmsg := f_add(qmsg, "S7:WHALE+PUP," + f_i(f_hvDepth()) + (true ? ",D" + f_d(ltf_dstd > 0 ? ltf_drng / ltf_dstd : 0.0) : ""))
    if alf_qS10
        qmsg := f_add(qmsg, "S10:SAAB" + f_i(rv_normPrice) + "/" + f_i(nz(rv_normPrice[1])) + ",D" + f_d(d9_ach))
    if alf_qS11
        qmsg := f_add(qmsg, "S11:DYN,D" + f_d(dynAch1) + "/" + f_d(dynAch2))
    if alf_qS13T
        qmsg := f_add(qmsg, "S13:IGN-TNT")
    if alf_qS13N
        qmsg := f_add(qmsg, "S13:IGN-NPM")
    if alf_qS15
        qmsg := f_add(qmsg, "S15:NAG" + str.tostring(bar_index) + (d9_bull ? ",D" + f_d(d9_ach) : ""))
    if alf_qS16
        qmsg := f_add(qmsg, "S16:B2BNPM")
    if alf_qS18
        qmsg := f_add(qmsg, "S18:B2BPUP,D" + f_d(d9_ach))
    if alf_qS20
        qmsg := f_add(qmsg, "S20:B2BFC")
    if alf_qS22
        qmsg := f_add(qmsg, "S22:D9,D" + f_d(d9_ach))
    if alf_qS24
        qmsg := f_add(qmsg, "S24:UC,D" + f_d(d9_ach))
    // BEDROCK v1.1 CUT#16: qS26S alert-row removed (D-14, operator 2026-07-28)
    // BEDROCK v1.1 CUT#21: qS26T alert-row removed (D-14, operator 2026-07-28)
    // BEDROCK v1.1 CUT#05: qCOJ alert-row removed (D-13, operator 2026-07-28)
    // BEDROCK v1.1 CUT#11: qCOB alert-row removed (D-04, operator 2026-07-28)
    if alf_qB2BH
        qmsg := f_add(qmsg, "B2B-HVD:" + f_i(f_hvDepth()) + ",D" + f_d(hvd_ach) + "/" + f_d(nz(hvd_ach[1])))
    if alf_qB2BJ
        qmsg := f_add(qmsg, "B2B-HVD+PBJ:" + f_i(f_hvDepth()) + ",D" + f_d(hvd_ach) + "/" + f_d(nz(hvd_ach[1])))
    // BEDROCK v1.1 CUT#26: qB2BP alert-row removed (D-05, operator 2026-07-28)
    if alf_qMPUP
        qmsg := f_add(qmsg, "HVD+PUP:" + f_i(f_hvDepth()) + ",D" + f_d(hvd_ach))
    if alf_qMRV
        qmsg := f_add(qmsg, "HVD+RVOL:" + f_i(f_hvDepth()) + ",D" + f_d(hvd_ach) + ",1X" + f_i(nz(rv_normPrice[1])))
    if alf_qMCMB
        qmsg := f_add(qmsg, "HVD+CMB:" + f_i(f_hvDepth()) + ",D" + f_d(hvd_ach))
    if alf_qMJP
        qmsg := f_add(qmsg, "HVD+PBJ+PUP:" + f_i(f_hvDepth()) + ",D" + f_d(hvd_ach))
    if alf_qMJR
        qmsg := f_add(qmsg, "HVD+PBJ+RVOL:" + f_i(f_hvDepth()) + ",D" + f_d(hvd_ach) + ",1X" + f_i(nz(rv_normPrice[1])))
    if alf_qMJC
        qmsg := f_add(qmsg, "HVD+PBJ+CMB:" + f_i(f_hvDepth()) + ",D" + f_d(hvd_ach))
    if alf_qM23J
